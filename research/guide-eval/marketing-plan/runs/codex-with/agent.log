{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport csv, re\nfolder = Path('/private/tmp/mp-q4UzmU')\nlines = (folder / 'plan.md').read_text().splitlines()\nrows = []\nphase = None\nfor line in lines:\n    if line.startswith('| BEFORE'):\n        phase = 'BEFORE'\n    elif line.startswith('| DURING'):\n        phase = 'DURING'\n    elif line.startswith('| AFTER'):\n        phase = 'AFTER'\n    elif re.match(r'\"'^'\"\\\\| \\\\*\\\\*[147]\\\\. ', line):\n        cells = [re.sub(r'\\\\*\\\\*', '', cell.strip()) for cell in line.strip().strip('|').split('|')]\n        rows.append([f'{phase} — {cell}' for cell in cells])\nassert len(rows) == 3 and all(len(row) == 3 for row in rows)\nwith (folder / 'plan.csv').open('w', newline='', encoding='utf-8-sig') as file:\n    csv.writer(file).writerows(rows)\nprint('Created plan.csv: 3 rows × 3 columns')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
