{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JvFXN1L3reRYxd6yd5HXX3","type":"tool_result","content":"# storylib\n\nThe library behind the public story feed: publish a story, hide one (the\nauthor withdraws it), list the feed. One DynamoDB table, key `slug`.\n\nLayout:\n\n- `src/app.py` -- `StoryLibrary`, the only module that talks to DynamoDB.\n  The Lambda handlers (`api.py`, in the infra repo) call its methods; keep\n  the method names and signatures stable.\n- `tests/fake_dynamo.py` -- in-memory stand-in for the boto3 Table resource,\n  so the tests run without AWS. It follows DynamoDB's expression rules\n  (see its docstring).\n- `tests/test_feed.py` -- the tests.\n- `logs/` -- what came in this week: the production error on hide and a bug\n  report from staging.\n\nRun the tests (Python 3, no dependencies; on the servers `boto3` is\ninstalled and `STORIES_TABLE` names the table):\n\n    python3 -m unittest discover tests\n===APP\n     1\t\"\"\"storylib - the story library behind the public feed.\n     2\t\n     3\tThree operations: publish a story, hide one (the author withdraws it) and\n     4\tlist the public feed. Storage is a single DynamoDB table keyed by `slug`.\n     5\tThis module only talks to a boto3 Table resource; the tests hand it\n     6\ttests/fake_dynamo.FakeTable instead, and the HTTP handlers (api.py, in the\n     7\tinfra repo) hand it dynamo_table().\n     8\t\"\"\"\n     9\timport os\n    10\timport time\n    11\t\n    12\t\n    13\tdef dynamo_table():\n    14\t    \"\"\"The real table. boto3 is only installed on the servers.\"\"\"\n    15\t    import boto3\n    16\t    return boto3.resource(\"dynamodb\").Table(os.environ.get(\"STORIES_TABLE\", \"stories\"))\n    17\t\n    18\t\n    19\tclass StoryLibrary:\n    20\t    FEED_LIMIT = 50\n    21\t\n    22\t    def __init__(self, table, clock=time.time):\n    23\t        self.table = table\n    24\t        self.clock = clock\n    25\t\n    26\t    def publish(self, slug, title, body, author):\n    27\t        \"\"\"Create a story. Refuses to overwrite an existing slug.\"\"\"\n    28\t        self.table.put_item(\n    29\t            Item={\n    30\t                \"slug\": slug,\n    31\t                \"title\": title,\n    32\t                \"body\": body,\n    33\t                \"author\": author,\n    34\t                \"published_at\": int(self.clock()),\n    35\t                \"status\": \"published\",\n    36\t            },\n    37\t            ConditionExpression=\"attribute_not_exists(slug)\",\n    38\t        )\n    39\t\n    40\t    def get(self, slug):\n    41\t        return self.table.get_item(Key={\"slug\": slug}).get(\"Item\")\n    42\t\n    43\t    def rename(self, slug, title):\n    44\t        self.table.update_item(\n    45\t            Key={\"slug\": slug},\n    46\t            UpdateExpression=\"SET title = :t\",\n    47\t            ConditionExpression=\"attribute_exists(slug)\",\n    48\t            ExpressionAttributeValues={\":t\": title},\n    49\t        )\n    50\t\n    51\t    def hide(self, slug, by):\n    52\t        \"\"\"Author withdraws a story: it stays in the table but leaves the feed.\"\"\"\n    53\t        self.table.update_item(\n    54\t            Key={\"slug\": slug},\n    55\t            UpdateExpression=\"SET hidden = :h, hidden_by = :by, hidden_at = :t\",\n    56\t            ConditionExpression=\"attribute_exists(slug)\",\n    57\t            ExpressionAttributeValues={\":h\": True, \":by\": by, \":t\": int(self.clock())},\n    58\t        )\n    59\t\n    60\t    def feed(self, limit=FEED_LIMIT):\n    61\t        \"\"\"Public feed: newest first, hidden stories excluded, bodies left out.\"\"\"\n    62\t        resp = self.table.scan(ProjectionExpression=\"slug, title, hidden, published_at\")\n    63\t        items = [i for i in resp[\"Items\"] if not i.get(\"hidden\")]\n    64\t        items.sort(key=lambda i: i[\"published_at\"], reverse=True)\n    65\t        return [\n    66\t            {\"slug\": i[\"slug\"], \"title\": i[\"title\"], \"published_at\": i[\"published_at\"]}\n    67\t            for i in items[:limit]\n    68\t        ]\n    69\t\n    70\t    def archive(self, slug):\n    71\t        \"\"\"Editorial: take a published story out of circulation for good.\n    72\t        Not wired to the API yet (planned for the admin console).\"\"\"\n    73\t        self.table.update_item(\n    74\t            Key={\"slug\": slug},\n    75\t            UpdateExpression=\"SET archived_at = :t\",\n    76\t            ConditionExpression=\"status = :published\",\n    77\t            ExpressionAttributeValues={\":t\": int(self.clock()), \":published\": \"published\"},\n    78\t        )\n===TESTS\n     1\timport os\n     2\timport sys\n     3\timport unittest\n     4\t\n     5\tROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\n     6\tsys.path.insert(0, ROOT)\n     7\t\n     8\tfrom src.app import StoryLibrary  # noqa: E402\n     9\tfrom tests.fake_dynamo import ClientError, FakeTable  # noqa: E402\n    10\t\n    11\t\n    12\tclass FeedTests(unittest.TestCase):\n    13\t    def setUp(self):\n    14\t        self.now = 1_700_000_000\n    15\t        self.lib = StoryLibrary(FakeTable(), clock=lambda: self.now)\n    16\t\n    17\t    def test_publish_then_feed_lists_it(self):\n    18\t        self.lib.publish(\"hello\", \"Hello\", \"first post\", \"ann\")\n    19\t        self.assertEqual([s[\"slug\"] for s in self.lib.feed()], [\"hello\"])\n    20\t\n    21\t    def test_feed_is_newest_first(self):\n    22\t        self.lib.publish(\"old\", \"Old\", \"...\", \"ann\")\n    23\t        self.now += 60\n    24\t        self.lib.publish(\"new\", \"New\", \"...\", \"bob\")\n    25\t        self.assertEqual([s[\"slug\"] for s in self.lib.feed()], [\"new\", \"old\"])\n    26\t\n    27\t    def test_feed_leaves_bodies_out(self):\n    28\t        self.lib.publish(\"hello\", \"Hello\", \"a long body\", \"ann\")\n    29\t        self.assertEqual(set(self.lib.feed()[0]), {\"slug\", \"title\", \"published_at\"})\n    30\t\n    31\t    def test_publish_twice_is_rejected(self):\n    32\t        self.lib.publish(\"hello\", \"Hello\", \"...\", \"ann\")\n    33\t        with self.assertRaises(ClientError) as cm:\n    34\t            self.lib.publish(\"hello\", \"Hello again\", \"...\", \"ann\")\n    35\t        self.assertEqual(cm.exception.response[\"Error\"][\"Code\"], \"ConditionalCheckFailedException\")\n    36\t\n    37\t    def test_rename(self):\n    38\t        self.lib.publish(\"hello\", \"Hello\", \"...\", \"ann\")\n    39\t        self.lib.rename(\"hello\", \"Hello, world\")\n    40\t        self.assertEqual(self.lib.get(\"hello\")[\"title\"], \"Hello, world\")\n    41\t\n    42\t\n    43\tif __name__ == \"__main__\":\n    44\t    unittest.main()\n===FAKE\n     1\t\"\"\"In-memory stand-in for a boto3 DynamoDB Table resource, for the tests.\n     2\t\n     3\tCovers put_item, get_item, update_item and scan, with the expression rules\n     4\tthat matter for this service. It mirrors DynamoDB's documented behaviour\n     5\tfor reserved words (the real service keeps a list of ~570 of them; RESERVED\n     6\tbelow is the subset that comes up in practice):\n     7\t\n     8\t  * a bare reserved word in an UpdateExpression, ConditionExpression or\n     9\t    FilterExpression raises ValidationException\n    10\t    (\"Attribute name is a reserved keyword\"), exactly like the real service;\n    11\t  * a bare reserved word in a ProjectionExpression does NOT raise: the\n    12\t    attribute is simply absent from the returned item, as on the real\n    13\t    service, and nothing in the response says so;\n    14\t  * '#alias' placeholders resolved through ExpressionAttributeNames work in\n    15\t    every expression, which is how DynamoDB tells you to spell any name.\n    16\t\n    17\tGrammar supported: `SET a = :v [, ...]` and `REMOVE a [, ...]` in updates;\n    18\t`=`, `<>`, `<`, `<=`, `>`, `>=`, attribute_exists(), attribute_not_exists(),\n    19\tNOT, AND, OR and parentheses in conditions and filters.\n    20\t\"\"\"\n    21\timport copy\n    22\timport re\n    23\t\n    24\tRESERVED = frozenset(\"\"\"\n    25\tADD AND ATTRIBUTE BINARY BY COMMENT COUNT DATA DATE DAY DELETE FALSE FROM GROUP HIDDEN HOUR\n    26\tIN INDEX ITEM ITEMS KEY KEYS LEVEL LIST MAP MINUTE MONTH NAME NOT NULL NUMBER OF ON OR ORDER\n    27\tPRIVATE PUBLIC QUERY REMOVE ROLE SCAN SECOND SELECT SET SIMILAR SIZE STATE STATUS STRING TABLE\n    28\tTEXT TIMESTAMP TO TRUE TYPE UPDATE URL USER VALUE VALUES YEAR\n    29\t\"\"\".split())\n    30\t\n    31\t_KEYWORDS = {\"SET\", \"REMOVE\", \"ADD\", \"DELETE\", \"AND\", \"OR\", \"NOT\", \"BETWEEN\", \"IN\"}\n    32\t_OPERATORS = {\"=\", \"<>\", \"<\", \"<=\", \">\", \">=\", \"(\", \")\", \",\"}\n    33\t_TOKEN = re.compile(r\"\\s*(#?[A-Za-z_][A-Za-z0-9_]*|:[A-Za-z_][A-Za-z0-9_]*|<>|<=|>=|[=<>(),])\")\n    34\t\n    35\t\n    36\tclass ClientError(Exception):\n    37\t    \"\"\"Same shape as botocore.exceptions.ClientError (.response[\"Error\"][\"Code\"]).\"\"\"\n    38\t\n    39\t    def __init__(self, code, message, operation):\n    40\t        super().__init__(f\"An error occurred ({code}) when calling the {operation} operation: {message}\")\n    41\t        self.response = {\"Error\": {\"Code\": code, \"Message\": message}}\n    42\t\n    43\t\n    44\tdef _tokens(expr):\n    45\t    out, pos = [], 0\n    46\t    while pos < len(expr):\n    47\t        m = _TOKEN.match(expr, pos)\n    48\t        if not m:\n    49\t            if expr[pos:].strip():\n    50\t                raise ValueError(f\"fake_dynamo cannot parse expression near: {expr[pos:]!r}\")\n    51\t            break\n    52\t        out.append(m.group(1)); pos = m.end()\n    53\t    return out\n    54\t\n    55\t\n    56\tclass _Names:\n    57\t    \"\"\"Resolves attribute names in one API call and enforces the reserved-word rules.\"\"\"\n    58\t\n    59\t    def __init__(self, mapping, operation):\n    60\t        self.mapping, self.operation, self.used = dict(mapping or {}), operation, set()\n    61\t\n    62\t    def _invalid(self, kind, msg):\n    63\t        raise ClientError(\"ValidationException\", f\"Invalid {kind}: {msg}\", self.operation)\n    64\t\n    65\t    def alias(self, kind, tok):\n    66\t        if tok not in self.mapping:\n    67\t            self._invalid(kind, f\"An expression attribute name used in the document path is not defined; attribute name: {tok}\")\n    68\t        self.used.add(tok)\n    69\t        return self.mapping[tok]\n    70\t\n    71\t    def validate(self, kind, expr):\n    72\t        \"\"\"Raise like DynamoDB does for a bare reserved word or an unknown #alias.\"\"\"\n    73\t        toks = _tokens(expr)\n    74\t        for i, t in enumerate(toks):\n    75\t            if t.startswith(\"#\"):\n    76\t                self.alias(kind, t)\n    77\t            elif t.startswith(\":\") or t in _OPERATORS or t.upper() in _KEYWORDS:\n    78\t                continue\n    79\t            elif i + 1 < len(toks) and toks[i + 1] == \"(\":\n    80\t                continue  # function call: attribute_exists(...), size(...)\n    81\t            elif t.upper() in RESERVED:\n    82\t                self._invalid(kind, f\"Attribute name is a reserved keyword; reserved keyword: {t}\")\n    83\t        return toks\n    84\t\n    85\t    def resolve(self, tok):\n    86\t        return self.mapping[tok] if tok.startswith(\"#\") else tok\n    87\t\n    88\t    def finish(self):\n    89\t        unused = sorted(set(self.mapping) - self.used)\n    90\t        if unused:\n    91\t            raise ClientError(\"ValidationException\", \"Value provided in ExpressionAttributeNames unused in \"\n    92\t                              f\"expressions: keys: {{{', '.join(unused)}}}\", self.operation)\n    93\t\n    94\t\n    95\tdef _evaluate(toks, item, names, values):\n    96\t    \"\"\"Evaluate a validated condition/filter expression against one item.\"\"\"\n    97\t    pos = [0]\n    98\t    peek = lambda: toks[pos[0]] if pos[0] < len(toks) else None  # noqa: E731\n    99\t\n   100\t    def take():\n   101\t        pos[0] += 1\n   102\t        return toks[pos[0] - 1]\n   103\t\n   104\t    def operand():\n   105\t        t = take()\n   106\t        return values[t] if t.startswith(\":\") else item.get(names.resolve(t))\n   107\t\n   108\t    def primary():\n   109\t        t = peek()\n   110\t        if t == \"(\":\n   111\t            take(); v = binary(\"OR\"); take()\n   112\t            return v\n   113\t        if t.upper() == \"NOT\":\n   114\t            take()\n   115\t            return not primary()\n   116\t        if t in (\"attribute_exists\", \"attribute_not_exists\"):\n   117\t            take(); take(); present = names.resolve(take()) in item; take()\n   118\t            return present if t == \"attribute_exists\" else not present\n   119\t        left = operand(); op = take(); right = operand()\n   120\t        if op in (\"=\", \"<>\"):\n   121\t            return (left == right) if op == \"=\" else (left != right)\n   122\t        if left is None or right is None:\n   123\t            return False\n   124\t        return {\"<\": left < right, \"<=\": left <= right, \">\": left > right, \">=\": left >= right}[op]\n   125\t\n   126\t    def binary(word):\n   127\t        sub = (lambda: binary(\"AND\")) if word == \"OR\" else primary\n   128\t        v = sub()\n   129\t        while peek() and peek().upper() == word:\n   130\t            take(); r = sub(); v = (v or r) if word == \"OR\" else (v and r)\n   131\t        return v\n   132\t\n   133\t    return binary(\"OR\")\n   134\t\n   135\t\n   136\tclass FakeTable:\n   137\t    def __init__(self, key=\"slug\"):\n   138\t        self.key, self._items = key, {}\n   139\t\n   140\t    def _check(self, op, expr, current, names, values):\n   141\t        if expr is not None and not _evaluate(names.validate(\"ConditionExpression\", expr), current, names, values or {}):\n   142\t            raise ClientError(\"ConditionalCheckFailedException\", \"The conditional request failed\", op)\n   143\t\n   144\t    def put_item(self, Item, ConditionExpression=None, ExpressionAttributeNames=None,\n   145\t                 ExpressionAttributeValues=None, **_ignored):\n   146\t        names = _Names(ExpressionAttributeNames, \"PutItem\")\n   147\t        self._check(\"PutItem\", ConditionExpression, self._items.get(Item[self.key], {}), names, ExpressionAttributeValues)\n   148\t        names.finish()\n   149\t        self._items[Item[self.key]] = copy.deepcopy(Item)\n   150\t        return {}\n   151\t\n   152\t    def get_item(self, Key, ProjectionExpression=None, ExpressionAttributeNames=None, **_ignored):\n   153\t        names = _Names(ExpressionAttributeNames, \"GetItem\")\n   154\t        item = self._items.get(Key[self.key])\n   155\t        if item is None:\n   156\t            return {}\n   157\t        item = self._project(copy.deepcopy(item), ProjectionExpression, names)\n   158\t        names.finish()\n   159\t        return {\"Item\": item}\n   160\t\n   161\t    def update_item(self, Key, UpdateExpression, ConditionExpression=None, ExpressionAttributeNames=None,\n   162\t                    ExpressionAttributeValues=None, ReturnValues=None, **_ignored):\n   163\t        names, values = _Names(ExpressionAttributeNames, \"UpdateItem\"), ExpressionAttributeValues or {}\n   164\t        toks = names.validate(\"UpdateExpression\", UpdateExpression)\n   165\t        current = self._items.get(Key[self.key], {})\n   166\t        self._check(\"UpdateItem\", ConditionExpression, current, names, values)\n   167\t        names.finish()\n   168\t        item = copy.deepcopy(current) or dict(Key)\n   169\t        clause, i = None, 0\n   170\t        while i < len(toks):\n   171\t            t = toks[i]\n   172\t            if t.upper() in (\"SET\", \"REMOVE\"):\n   173\t                clause = t.upper(); i += 1\n   174\t            elif t == \",\":\n   175\t                i += 1\n   176\t            elif clause == \"SET\" and i + 2 < len(toks) and toks[i + 1] == \"=\" and toks[i + 2].startswith(\":\"):\n   177\t                item[names.resolve(t)] = values[toks[i + 2]]; i += 3\n   178\t            elif clause == \"REMOVE\":\n   179\t                item.pop(names.resolve(t), None); i += 1\n   180\t            else:\n   181\t                names._invalid(\"UpdateExpression\", f\"fake_dynamo does not support this syntax near {t!r}\")\n   182\t        self._items[Key[self.key]] = item\n   183\t        return {\"Attributes\": copy.deepcopy(item)} if ReturnValues else {}\n   184\t\n   185\t    def scan(self, ProjectionExpression=None, FilterExpression=None, ExpressionAttributeNames=None,\n   186\t             ExpressionAttributeValues=None, **_ignored):\n   187\t        names = _Names(ExpressionAttributeNames, \"Scan\")\n   188\t        items = [copy.deepcopy(v) for v in self._items.values()]\n   189\t        scanned = len(items)\n   190\t        if FilterExpression:\n   191\t            toks = names.validate(\"FilterExpression\", FilterExpression)\n   192\t            items = [i for i in items if _evaluate(toks, i, names, ExpressionAttributeValues or {})]\n   193\t        items = [self._project(i, ProjectionExpression, names) for i in items]\n   194\t        names.finish()\n   195\t        return {\"Items\": items, \"Count\": len(items), \"ScannedCount\": scanned}\n   196\t\n   197\t    def _project(self, item, expr, names):\n   198\t        \"\"\"Reserved words used bare are dropped from the result without any error.\"\"\"\n   199\t        if not expr:\n   200\t            return item\n   201\t        out = {}\n   202\t        for path in [p.strip() for p in expr.split(\",\") if p.strip()]:\n   203\t            if path.startswith(\"#\"):\n   204\t                attr = names.alias(\"ProjectionExpression\", path)\n   205\t            elif path.upper() in RESERVED:\n   206\t                continue\n   207\t            else:\n   208\t                attr = path\n   209\t            if attr in item:\n   210\t                out[attr] = item[attr]\n   211\t        return out\n===GITIGNORE\n__pycache__/\nsrc/app.py\ntests/test_feed.py\ntests/fake_dynamo.py","is_error":false}]},"parent_tool_use_id":null,"session_id":"fd166e8f-00a3-447a-bf2a-ff8085424637","uuid":"f6e1e32e-32af-499d-81f3-8950c128dec6","timestamp":"2026-10-20T23:36:11.050Z","tool_use_result":{"stdout":"# storylib\n\nThe library behind the public story feed: publish a story, hide one (the\nauthor withdraws it), list the feed. One DynamoDB table, key `slug`.\n\nLayout:\n\n- `src/app.py` -- `StoryLibrary`, the only module that talks to DynamoDB.\n  The Lambda handlers (`api.py`, in the infra repo) call its methods; keep\n  the method names and signatures stable.\n- `tests/fake_dynamo.py` -- in-memory stand-in for the boto3 Table resource,\n  so the tests run without AWS. It follows DynamoDB's expression rules\n  (see its docstring).\n- `tests/test_feed.py` -- the tests.\n- `logs/` -- what came in this week: the production error on hide and a bug\n  report from staging.\n\nRun the tests (Python 3, no dependencies; on the servers `boto3` is\ninstalled and `STORIES_TABLE` names the table):\n\n    python3 -m unittest discover tests\n===APP\n     1\t\"\"\"storylib - the story library behind the public feed.\n     2\t\n     3\tThree operations: publish a story, hide one (the author withdraws it) and\n     4\tlist the public feed. Storage is a single DynamoDB table keyed by `slug`.\n     5\tThis module only talks to a boto3 Table resource; the tests hand it\n     6\ttests/fake_dynamo.FakeTable instead, and the HTTP handlers (api.py, in the\n     7\tinfra repo) hand it dynamo_table().\n     8\t\"\"\"\n     9\timport os\n    10\timport time\n    11\t\n    12\t\n    13\tdef dynamo_table():\n    14\t    \"\"\"The real table. boto3 is only installed on the servers.\"\"\"\n    15\t    import boto3\n    16\t    return boto3.resource(\"dynamodb\").Table(os.environ.get(\"STORIES_TABLE\", \"stories\"))\n    17\t\n    18\t\n    19\tclass StoryLibrary:\n    20\t    FEED_LIMIT = 50\n    21\t\n    22\t    def __init__(self, table, clock=time.time):\n    23\t        self.table = table\n    24\t        self.clock = clock\n    25\t\n    26\t    def publish(self, slug, title, body, author):\n    27\t        \"\"\"Create a story. Refuses to overwrite an existing slug.\"\"\"\n    28\t        self.table.put_item(\n    29\t            Item={\n    30\t                \"slug\": slug,\n    31\t                \"title\": title,\n    32\t                \"body\": body,\n    33\t                \"author\": author,\n    34\t                \"published_at\": int(self.clock()),\n    35\t                \"status\": \"published\",\n    36\t            },\n    37\t            ConditionExpression=\"attribute_not_exists(slug)\",\n    38\t        )\n    39\t\n    40\t    def get(self, slug):\n    41\t        return self.table.get_item(Key={\"slug\": slug}).get(\"Item\")\n    42\t\n    43\t    def rename(self, slug, title):\n    44\t        self.table.update_item(\n    45\t            Key={\"slug\": slug},\n    46\t            UpdateExpression=\"SET title = :t\",\n    47\t            ConditionExpression=\"attribute_exists(slug)\",\n    48\t            ExpressionAttributeValues={\":t\": title},\n    49\t        )\n    50\t\n    51\t    def hide(self, slug, by):\n    52\t        \"\"\"Author withdraws a story: it stays in the table but leaves the feed.\"\"\"\n    53\t        self.table.update_item(\n    54\t            Key={\"slug\": slug},\n    55\t            UpdateExpression=\"SET hidden = :h, hidden_by = :by, hidden_at = :t\",\n    56\t            ConditionExpression=\"attribute_exists(slug)\",\n    57\t            ExpressionAttributeValues={\":h\": True, \":by\": by, \":t\": int(self.clock())},\n    58\t        )\n    59\t\n    60\t    def feed(self, limit=FEED_LIMIT):\n    61\t        \"\"\"Public feed: newest first, hidden stories excluded, bodies left out.\"\"\"\n    62\t        resp = self.table.scan(ProjectionExpression=\"slug, title, hidden, published_at\")\n    63\t        items = [i for i in resp[\"Items\"] if not i.get(\"hidden\")]\n    64\t        items.sort(key=lambda i: i[\"published_at\"], reverse=True)\n    65\t        return [\n    66\t            {\"slug\": i[\"slug\"], \"title\": i[\"title\"], \"published_at\": i[\"published_at\"]}\n    67\t            for i in items[:limit]\n    68\t        ]\n    69\t\n    70\t    def archive(self, slug):\n    71\t        \"\"\"Editorial: take a published story out of circulation for good.\n    72\t        Not wired to the API yet (planned for the admin console).\"\"\"\n    73\t        self.table.update_item(\n    74\t            Key={\"slug\": slug},\n    75\t            UpdateExpression=\"SET archived_at = :t\",\n    76\t            ConditionExpression=\"status = :published\",\n    77\t            ExpressionAttributeValues={\":t\": int(self.clock()), \":published\": \"published\"},\n    78\t        )\n===TESTS\n     1\timport os\n     2\timport sys\n     3\timport unittest\n     4\t\n     5\tROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\n     6\tsys.path.insert(0, ROOT)\n     7\t\n     8\tfrom src.app import StoryLibrary  # noqa: E402\n     9\tfrom tests.fake_dynamo import ClientError, FakeTable  # noqa: E402\n    10\t\n    11\t\n    12\tclass FeedTests(unittest.TestCase):\n    13\t    def setUp(self):\n    14\t        self.now = 1_700_000_000\n    15\t        self.lib = StoryLibrary(FakeTable(), clock=lambda: self.now)\n    16\t\n    17\t    def test_publish_then_feed_lists_it(self):\n    18\t        self.lib.publish(\"hello\", \"Hello\", \"first post\", \"ann\")\n    19\t        self.assertEqual([s[\"slug\"] for s in self.lib.feed()], [\"hello\"])\n    20\t\n    21\t    def test_feed_is_newest_first(self):\n    22\t        self.lib.publish(\"old\", \"Old\", \"...\", \"ann\")\n    23\t        self.now += 60\n    24\t        self.lib.publish(\"new\", \"New\", \"...\", \"bob\")\n    25\t        self.assertEqual([s[\"slug\"] for s in self.lib.feed()], [\"new\", \"old\"])\n    26\t\n    27\t    def test_feed_leaves_bodies_out(self):\n    28\t        self.lib.publish(\"hello\", \"Hello\", \"a long body\", \"ann\")\n    29\t        self.assertEqual(set(self.lib.feed()[0]), {\"slug\", \"title\", \"published_at\"})\n    30\t\n    31\t    def test_publish_twice_is_rejected(self):\n    32\t        self.lib.publish(\"hello\", \"Hello\", \"...\", \"ann\")\n    33\t        with self.assertRaises(ClientError) as cm:\n    34\t            self.lib.publish(\"hello\", \"Hello again\", \"...\", \"ann\")\n    35\t        self.assertEqual(cm.exception.response[\"Error\"][\"Code\"], \"ConditionalCheckFailedException\")\n    36\t\n    37\t    def test_rename(self):\n    38\t        self.lib.publish(\"hello\", \"Hello\", \"...\", \"ann\")\n    39\t        self.lib.rename(\"hello\", \"Hello, world\")\n    40\t        self.assertEqual(self.lib.get(\"hello\")[\"title\"], \"Hello, world\")\n    41\t\n    42\t\n    43\tif __name__ == \"__main__\":\n    44\t    unittest.main()\n===FAKE\n     1\t\"\"\"In-memory stand-in for a boto3 DynamoDB Table resource, for the tests.\n     2\t\n     3\tCovers put_item, get_item, update_item and scan, with the expression rules\n     4\tthat matter for this service. It mirrors DynamoDB's documented behaviour\n     5\tfor reserved words (the real service keeps a list of ~570 of them; RESERVED\n     6\tbelow is the subset that comes up in practice):\n     7\t\n     8\t  * a bare reserved word in an UpdateExpression, ConditionExpression or\n     9\t    FilterExpression raises ValidationException\n    10\t    (\"Attribute name is a reserved keyword\"), exactly like the real service;\n    11\t  * a bare reserved word in a ProjectionExpression does NOT raise: the\n    12\t    attribute is simply absent from the returned item, as on the real\n    13\t    service, and nothing in the response says so;\n    14\t  * '#alias' placeholders resolved through ExpressionAttributeNames work in\n    15\t    every expression, which is how DynamoDB tells you to spell any name.\n    16\t\n    17\tGrammar supported: `SET a = :v [, ...]` and `REMOVE a [, ...]` in updates;\n    18\t`=`, `<>`, `<`, `<=`, `>`, `>=`, attribute_exists(), attribute_not_exists(),\n    19\tNOT, AND, OR and parentheses in conditions and filters.\n    20\t\"\"\"\n    21\timport copy\n    22\timport re\n    23\t\n    24\tRESERVED = frozenset(\"\"\"\n    25\tADD AND ATTRIBUTE BINARY BY COMMENT COUNT DATA DATE DAY DELETE FALSE FROM GROUP HIDDEN HOUR\n    26\tIN INDEX ITEM ITEMS KEY KEYS LEVEL LIST MAP MINUTE MONTH NAME NOT NULL NUMBER OF ON OR ORDER\n    27\tPRIVATE PUBLIC QUERY REMOVE ROLE SCAN SECOND SELECT SET SIMILAR SIZE STATE STATUS STRING TABLE\n    28\tTEXT TIMESTAMP TO TRUE TYPE UPDATE URL USER VALUE VALUES YEAR\n    29\t\"\"\".split())\n    30\t\n    31\t_KEYWORDS = {\"SET\", \"REMOVE\", \"ADD\", \"DELETE\", \"AND\", \"OR\", \"NOT\", \"BETWEEN\", \"IN\"}\n    32\t_OPERATORS = {\"=\", \"<>\", \"<\", \"<=\", \">\", \">=\", \"(\", \")\", \",\"}\n    33\t_TOKEN = re.compile(r\"\\s*(#?[A-Za-z_][A-Za-z0-9_]*|:[A-Za-z_][A-Za-z0-9_]*|<>|<=|>=|[=<>(),])\")\n    34\t\n    35\t\n    36\tclass ClientError(Exception):\n    37\t    \"\"\"Same shape as botocore.exceptions.ClientError (.response[\"Error\"][\"Code\"]).\"\"\"\n    38\t\n    39\t    def __init__(self, code, message, operation):\n    40\t        super().__init__(f\"An error occurred ({code}) when calling the {operation} operation: {message}\")\n    41\t        self.response = {\"Error\": {\"Code\": code, \"Message\": message}}\n    42\t\n    43\t\n    44\tdef _tokens(expr):\n    45\t    out, pos = [], 0\n    46\t    while pos < len(expr):\n    47\t        m = _TOKEN.match(expr, pos)\n    48\t        if not m:\n    49\t            if expr[pos:].strip():\n    50\t                raise ValueError(f\"fake_dynamo cannot parse expression near: {expr[pos:]!r}\")\n    51\t            break\n    52\t        out.append(m.group(1)); pos = m.end()\n    53\t    return out\n    54\t\n    55\t\n    56\tclass _Names:\n    57\t    \"\"\"Resolves attribute names in one API call and enforces the reserved-word rules.\"\"\"\n    58\t\n    59\t    def __init__(self, mapping, operation):\n    60\t        self.mapping, self.operation, self.used = dict(mapping or {}), operation, set()\n    61\t\n    62\t    def _invalid(self, kind, msg):\n    63\t        raise ClientError(\"ValidationException\", f\"Invalid {kind}: {msg}\", self.operation)\n    64\t\n    65\t    def alias(self, kind, tok):\n    66\t        if tok not in self.mapping:\n    67\t            self._invalid(kind, f\"An expression attribute name used in the document path is not defined; attribute name: {tok}\")\n    68\t        self.used.add(tok)\n    69\t        return self.mapping[tok]\n    70\t\n    71\t    def validate(self, kind, expr):\n    72\t        \"\"\"Raise like DynamoDB does for a bare reserved word or an unknown #alias.\"\"\"\n    73\t        toks = _tokens(expr)\n    74\t        for i, t in enumerate(toks):\n    75\t            if t.startswith(\"#\"):\n    76\t                self.alias(kind, t)\n    77\t            elif t.startswith(\":\") or t in _OPERATORS or t.upper() in _KEYWORDS:\n    78\t                continue\n    79\t            elif i + 1 < len(toks) and toks[i + 1] == \"(\":\n    80\t                continue  # function call: attribute_exists(...), size(...)\n    81\t            elif t.upper() in RESERVED:\n    82\t                self._invalid(kind, f\"Attribute name is a reserved keyword; reserved keyword: {t}\")\n    83\t        return toks\n    84\t\n    85\t    def resolve(self, tok):\n    86\t        return self.mapping[tok] if tok.startswith(\"#\") else tok\n    87\t\n    88\t    def finish(self):\n    89\t        unused = sorted(set(self.mappin