= \"OR\" else (v and r)\n   131\t        return v\n   132\t\n   133\t    return binary(\"OR\")\n   134\t\n   135\t\n   136\tclass FakeTable:\n   137\t    def __init__(self, key=\"slug\"):\n   138\t        self.key, self._items = key, {}\n   139\t\n   140\t    def _check(self, op, expr, current, names, values):\n   141\t        if expr is not None and not _evaluate(names.validate(\"ConditionExpression\", expr), current, names, values or {}):\n   142\t            raise ClientError(\"ConditionalCheckFailedException\", \"The conditional request failed\", op)\n   143\t\n   144\t    def put_item(self, Item, ConditionExpression=None, ExpressionAttributeNames=None,\n   145\t                 ExpressionAttributeValues=None, **_ignored):\n   146\t        names = _Names(ExpressionAttributeNames, \"PutItem\")\n   147\t        self._check(\"PutItem\", ConditionExpression, self._items.get(Item[self.key], {}), names, ExpressionAttributeValues)\n   148\t        names.finish()\n   149\t        self._items[Item[self.key]] = copy.deepcopy(Item)\n   150\t        return {}\n   151\t\n   152\t    def get_item(self, Key, ProjectionExpression=None, ExpressionAttributeNames=None, **_ignored):\n   153\t        names = _Names(ExpressionAttributeNames, \"GetItem\")\n   154\t        item = self._items.get(Key[self.key])\n   155\t        if item is None:\n   156\t            return {}\n   157\t        item = self._project(copy.deepcopy(item), ProjectionExpression, names)\n   158\t        names.finish()\n   159\t        return {\"Item\": item}\n   160\t\n   161\t    def update_item(self, Key, UpdateExpression, ConditionExpression=None, ExpressionAttributeNames=None,\n   162\t                    ExpressionAttributeValues=None, ReturnValues=None, **_ignored):\n   163\t        names, values = _Names(ExpressionAttributeNames, \"UpdateItem\"), ExpressionAttributeValues or {}\n   164\t        toks = names.validate(\"UpdateExpression\", UpdateExpression)\n   165\t        current = self._items.get(Key[self.key], {})\n   166\t        self._check(\"UpdateItem\", ConditionExpression, current, names, values)\n   167\t        names.finish()\n   168\t        item = copy.deepcopy(current) or dict(Key)\n   169\t        clause, i = None, 0\n   170\t        while i < len(toks):\n   171\t            t = toks[i]\n   172\t            if t.upper() in (\"SET\", \"REMOVE\"):\n   173\t                clause = t.upper(); i += 1\n   174\t            elif t == \",\":\n   175\t                i += 1\n   176\t            elif clause == \"SET\" and i + 2 < len(toks) and toks[i + 1] == \"=\" and toks[i + 2].startswith(\":\"):\n   177\t                item[names.resolve(t)] = values[toks[i + 2]]; i += 3\n   178\t            elif clause == \"REMOVE\":\n   179\t                item.pop(names.resolve(t), None); i += 1\n   180\t            else:\n   181\t                names._invalid(\"UpdateExpression\", f\"fake_dynamo does not support this syntax near {t!r}\")\n   182\t        self._items[Key[self.key]] = item\n   183\t        return {\"Attributes\": copy.deepcopy(item)} if ReturnValues else {}\n   184\t\n   185\t    def scan(self, ProjectionExpression=None, FilterExpression=None, ExpressionAttributeNames=None,\n   186\t             ExpressionAttributeValues=None, **_ignored):\n   187\t        names = _Names(ExpressionAttributeNames, \"Scan\")\n   188\t        items = [copy.deepcopy(v) for v in self._items.values()]\n   189\t        scanned = len(items)\n   190\t        if FilterExpression:\n   191\t            toks = names.validate(\"FilterExpression\", FilterExpression)\n   192\t            items = [i for i in items if _evaluate(toks, i, names, ExpressionAttributeValues or {})]\n   193\t        items = [self._project(i, ProjectionExpression, names) for i in items]\n   194\t        names.finish()\n   195\t        return {\"Items\": items, \"Count\": len(items), \"ScannedCount\": scanned}\n   196\t\n   197\t    def _project(self, item, expr, names):\n   198\t        \"\"\"Reserved words used