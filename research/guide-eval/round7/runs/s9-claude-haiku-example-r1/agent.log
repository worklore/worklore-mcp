elf.table.put_item(\n            Item={\n                \"slug\": slug,\n                \"title\": title,\n                \"body\": body,\n                \"author\": author,\n                \"published_at\": int(self.clock()),\n                \"status\": \"published\",\n            },\n            ConditionExpression=\"attribute_not_exists(#slug)\",\n            ExpressionAttributeNames={\"#slug\": \"slug\"},\n        )\n\n    def get(self, slug):\n        return self.table.get_item(Key={\"slug\": slug}).get(\"Item\")\n\n    def rename(self, slug, title):\n        self.table.update_item(\n            Key={\"slug\": slug},\n            UpdateExpression=\"SET #title = :t\",\n            ConditionExpression=\"attribute_exists(#slug)\",\n            ExpressionAttributeNames={\"#title\": \"title\", \"#slug\": \"slug\"},\n            ExpressionAttributeValues={\":t\": title},\n        )\n\n    def hide(self, slug, by):\n        \"\"\"Author withdraws a story: it stays in the table but leaves the feed.\"\"\"\n        self.table.update_item(\n            Key={\"slug\": slug},\n            UpdateExpression=\"SET #hidden = :h, #hidden_by = :by, #hidden_at = :t\",\n            ConditionExpression=\"attribute_exists(#slug)\",\n            ExpressionAttributeNames={\n                \"#slug\": \"slug\",\n                \"#hidden\": \"hidden\",\n                \"#hidden_by\": \"hidden_by\",\n                \"#hidden_at\": \"hidden_at\",\n            },\n            ExpressionAttributeValues={\":h\": True, \":by\": by, \":t\": int(self.clock())},\n        )\n\n    def feed(self, limit=FEED_LIMIT):\n        \"\"\"Public feed: newest first, hidden stories excluded, bodies left out.\"\"\"\n        # `hidden` must be aliased: a bare reserved word in a ProjectionExpression\n        # is dropped from the result without an error, and the filter below\n        # would then never see the flag.\n        resp = self.table.scan(\n            ProjectionExpression=\"#slug, #title, #hidden, #published_at\",\n            ExpressionAttributeNames={\n                \"#slug\": \"slug\",\n                \"#title\": \"title\",\n                \"#hidden\": \"hidden\",\n                \"#published_at\": \"published_at\",\n            },\n        )\n        items = [i for i in resp[\"Items\"] if not i.get(\"hidden\")]\n        items.sort(key=lambda i: i[\"published_at\"], reverse=True)\n        return [\n            {\"slug\": i[\"slug\"], \"title\": i[\"title\"], \"published_at\": i[\"published_at\"]}\n            for i in items[:limit]\n        ]\n\n    def archive(self, slug):\n        \"\"\"Editorial: take a published story out of circulation for good.\n        Not wired to the API yet (planned for the admin console).\"\"\"\n        self.table.update_item(\n            Key={\"slug\": slug},\n            UpdateExpression=\"SET archived_at = :t\",\n            ConditionExpression=\"status = :published\",\n            ExpressionAttributeValues={\":t\": int(self.clock()), \":published\": \"published\"},\n        )\n","structuredPatch":[{"oldStart":91,"oldLines":7,"newStart":91,"newLines":8,"lines":["         Not wired to the API yet (planned for the admin console).\"\"\"","         self.table.update_item(","             Key={\"slug\": slug},","-            UpdateExpression=\"SET archived_at = :t\",","-            ConditionExpression=\"status = :published\",","+            UpdateExpression=\"SET #archived_at = :t\",","+            ConditionExpression=\"#status = :published\",","+            ExpressionAttributeNames={\"#archived_at\": \"archived_at\", \"#status\": \"status\"},","             ExpressionAttributeValues={\":t\": int(self.clock()), \":published\": \"published\"},","         )"]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_01M91JuY9j2nEA1kdp6CjRnX","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
