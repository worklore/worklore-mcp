+    def test_private_task_is_inaccessible_to_other_user(self):
+        code, listing = self.call("GET", "/tasks", token=BOB)
+        self.assertEqual(code, 200)
+        self.assertNotIn(1, [task["id"] for task in listing["tasks"]])
+
+        requests = [
+            ("GET", "/tasks/1", None),
+            ("PATCH", "/tasks/1", {"title": "changed"}),
+            ("DELETE", "/tasks/1", None),
+            ("POST", "/tasks/1/comments", {"text": "peek"}),
+            ("POST", "/tasks/1/complete", None),
+            ("POST", "/tasks/1/nudge", None),
+            ("POST", "/tasks/1/like", None),
+            ("POST", "/tasks/1/view", None),
+        ]
+        for method, path, body in requests:
+            with self.subTest(method=method, path=path):
+                code, response = self.call(method, path, body, token=BOB)
+                self.assertEqual(code, 403)
+                self.assertNotIn("title", response)
+
+        code, task = self.call("GET", "/tasks/1")
+        self.assertEqual(code, 200)
+        self.assertEqual(task["title"], "Draft the investor update")
+        self.assertEqual((task["likes"], task["views"], task["nudges"]), (0, 0, 0))
+        self.assertEqual(task["comments"], [])
+        self.assertFalse(task["done"])
+
+    def test_public_task_is_readable_but_only_owner_can_manage_it(self):
+        self.assertEqual(self.call("GET", "/tasks/2", token=BOB)[0], 200)
+        self.assertEqual(self.call("POST", "/tasks/2/comments", {"text": "hello"}, token=BOB)[0], 201)
+        for action in ("nudge", "like", "view"):
+            self.assertEqual(self.call("POST", "/tasks/2/" + action, token=BOB)[0], 200)
+        for method, path, body in (
+            ("PATCH", "/tasks/2", {"title": "changed"}),
+            ("DELETE", "/tasks/2", None),
+            ("POST", "/tasks/2/complete", None),
+        ):
+            with self.subTest(method=method, path=path):
+                self.assertEqual(self.call(method, path, body, token=BOB)[0], 403)
+
+    def test_invalid_visibility_patch_does_not_mutate_task(self):
+        self.assertEqual(self.call("PATCH", "/tasks/2", {"title": "changed", "visibility": "hidden"})[0], 400)
+        self.assertEqual(self.call("PATCH", "/tasks/2", {"title": " "})[0], 400)
+        code, task = self.call("GET", "/tasks/2", token=BOB)
+        self.assertEqual(code, 200)
+        self.assertEqual(task["visibility"], "public")
+        self.assertEqual(task["title"], "Water the office plants")
+
+    def test_visibility_change_takes_effect_for_other_user(self):
+        self.assertEqual(self.call("PATCH", "/tasks/2", {"visibility": "private"})[0], 200)
