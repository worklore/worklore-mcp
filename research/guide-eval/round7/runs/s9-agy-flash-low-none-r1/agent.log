nstalled and `STORIES_TABLE` names the table):\r\n+\r\n+    python3 -m unittest discover tests\r\ndiff --git a/logs/bug-report.md b/logs/bug-report.md\r\nnew file mode 100644\r\nindex 0000000..0ed802c\r\n--- /dev/null\r\n+++ b/logs/bug-report.md\r\n@@ -0,0 +1,21 @@\r\n+# Hidden story still in the public feed (staging)\r\n+\r\n+Date: 2026-08-05\r\n+Reporter: Dasha (content)\r\n+Environment: staging, table `stories-staging`, build 2026-08-04 (same as prod)\r\n+\r\n+The Hide button on staging gives a 500 (same error as prod, see\r\n+prod-error.log), so I hid \"my-first-week\" by hand with the AWS CLI:\r\n+\r\n+    aws dynamodb update-item --table-name stories-staging \\\r\n+      --key '{\"slug\":{\"S\":\"my-first-week\"}}' \\\r\n+      --update-expression 'SET #h = :t' \\\r\n+      --expression-attribute-names '{\"#h\":\"hidden\"}' \\\r\n+      --expression-attribute-values '{\":t\":{\"BOOL\":true}}'\r\n+\r\n+`get-item` afterwards shows `hidden: true` on the item, so the write landed.\r\n+But `GET /feed` on staging still lists \"my-first-week\" -- ten minutes later,\r\n+after a redeploy, and in a private browser window. Nothing in the logs,\r\n+no error, the feed call returns 200.\r\n+\r\n+Is the feed cached somewhere? Or does the feed read from a different table?\r\ndiff --git a/logs/prod-error.log b/logs/prod-error.log\r\nnew file mode 100644\r\nindex 0000000..023261c\r\n--- /dev/null\r\n+++ b/logs/prod-error.log\r\n@@ -0,0 +1,21 @@\r\n+2026-08-04T09:12:41Z INFO  api.hide_story slug=why-i-left-mobx user=vk\r\n+2026-08-04T09:12:41Z ERROR api.hide_story unhandled exception\r\n+Traceback (most recent call last):\r\n+  File \"/var/task/api.py\", line 61, in hide_story\r\n+    library.hide(slug, by=user)\r\n+  File \"/var/task/src/app.py\", line 53, in hide\r\n+    self.table.update_item(\r\n+  File \"/var/task/boto3/resources/factory.py\", line 581, in do_action\r\n+    response = action(self, *args, **kwargs)\r\n+  File \"/var/task/boto3/resources/action.py\", line 88, in __call__\r\n+    response = getattr(parent.meta.client, operation_name)(*args, **params)\r\n+  File \"/var/task/botocore/client.py\", line 569, in _api_call\r\n+    return self._make_api_call(operation_name, kwargs)\r\n+  File \"/var/task/botocore/client.py\", line 1023, in _make_api_call\r\n+    raise error_class(parsed_response, operation_name)\r\n+botocore.exceptions.ClientError: An error occurred (ValidationException) when calling the UpdateItem operation: Invalid UpdateExpression: Attribute name is a reserved keyword; reserved keyword: hidden\r\n+2026-08-04T09:12:41Z INFO  api.hide_story -\u003e 500\r\n+2026-08-04T09:14:02Z INFO  api.hide_story slug=why-i-left-mobx user=vk\r\n+2026-08-04T09:14:02Z ERROR api.hide_story unhandled exception\r\n+botocore.exceptions.ClientError: An error occurred (ValidationException) when calling the UpdateItem operation: Invalid UpdateExpression: Attribute name is a reserved keyword; reserved keyword: hidden\r\n+2026-08-04T09:14:02Z INFO  api.hide_story -\u003e 500\r\ndiff --git a/src/app.py b/src/app.py\r\nnew file mode 100644\r\nindex 0000000..963b0b5\r\n--- /dev/null\r\n+++ b/src/app.py\r\n@@ -0,0 +1,78 @@\r\n+\"\"\"storylib - the story library behind the public feed.\r\n+\r\n+Three operations: publish a story, hide one (the author withdraws it) and\r\n+list the public feed. Storage is a single DynamoDB table keyed by `slug`.\r\n+This module only talks to a boto3 Table resource; the tests hand it\r\n+tests/fake_dynamo.FakeTable instead, and the HTTP handlers (api.py, in the\r\n+infra repo) hand it dynamo_table().\r\n+\"\"\"\r\n+import os\r\n+import time\r\n+\r\n+\r\n+def dynamo_table():\r\n+    \"\"\"The real table. boto3 is only installed on the servers.\"\"\"\r\n+    import boto3\r\n+    return boto3.resource(\"dynamodb\").Table(os.environ.get(\"STORIES_TABLE\", \"stories\"))\r\n+\r\n+\r\n+class \n\u003ctruncated 9220 of 19098 bytes from the middle of the output\u003e\nrn {}\r\n+\r\n+    def get_item(self, Key, ProjectionExpression=None, ExpressionAttributeNames=None, **_ignored):\r\n+        names = _Names(ExpressionAttributeNames, \"GetItem\")\r\n+        item = self._items.get(Key[self.key])\r\n+        if item is None:\r\n+            return {}\r\n+        item = self._project(copy.deepcopy(item), ProjectionExpression, names)\r\n+        names.finish()\r\n+        return {\"Item\": item}\r\n+\r\n+    def update_item(self, Key, UpdateExpression, ConditionExpression=None, ExpressionAttributeNames=None,\r\n+                    ExpressionAttributeValues=None, ReturnValues=None, **_ignored):\r\n+        names, values = _Names(ExpressionAttributeNames, \"UpdateItem\"), ExpressionAttributeValues or {}\r\n+        toks = names.validate(\"UpdateExpression\", UpdateExpression)\r\n+        current = self._items.get(Key[self.key], {})\r\n+        self._check(\"UpdateItem\", ConditionExpression, current, names, values)\r\n+        names.finish()\r\n+        item = copy.deepcopy(current) or dict(Key)\r\n+        clause, i = None, 0\r\n+        while i \u003c len(toks):\r\n+            t = toks[i]\r\n+            if t.upper() in (\"SET\", \"REMOVE\"):\r\n+                clause = t.upper(); i += 1\r\n+            elif t == \",\":\r\n+                i += 1\r\n+            elif clause == \"SET\" and i + 2 \u003c len(toks) and toks[i + 1] == \"=\" and toks[i + 2].startswith(\":\"):\r\n+                item[names.resolve(t)] = values[toks[i + 2]]; i += 3\r\n+            elif clause == \"REMOVE\":\r\n+                item.pop(names.resolve(t), None); i += 1\r\n+            else:\r\n+                names._invalid(\"UpdateExpression\", f\"fake_dynamo does not support this syntax near {t!r}\")\r\n+        self._items[Key[self.key]] = item\r\n+        return {\"Attributes\": copy.deepcopy(item)} if ReturnValues else {}\r\n+\r\n+    def scan(self, ProjectionExpression=None, FilterExpression=None, ExpressionAttributeNames=None,\r\n+             ExpressionAttributeValues=None, **_ignored):\r\n+        names = _Names(ExpressionAttributeNames, \"Scan\")\r\n+        items = [copy.deepcopy(v) for v in self._items.values()]\r\n+        scanned = len(items)\r\n+        if FilterExpression:\r\n+            toks = names.validate(\"FilterExpression\", FilterExpression)\r\n+            items = [i for i in items if _evaluate(toks, i, names, ExpressionAttributeValues or {})]\r\n+        items = [self._project(i, ProjectionExpression, names) for i in items]\r\n+        names.finish()\r\n+        return {\"Items\": items, \"Count\": len(items), \"ScannedCount\": scanned}\r\n+\r\n+    def _project(self, item, expr, names):\r\n+        \"\"\"Reserved words used bare are dropped from the result without any error.\"\"\"\r\n+        if not expr:\r\n+            return item\r\n+        out = {}\r\n+        for path in [p.strip() for p in expr.split(\",\") if p.strip()]:\r\n+            if path.startswith(\"#\"):\r\n+                attr = names.alias(\"ProjectionExpression\", path)\r\n+            elif path.upper() in RESERVED:\r\n+                continue\r\n+            else:\r\n+                attr = path\r\n+            if attr in item:\r\n+                out[attr] = item[attr]\r\n+        return out\r\ndiff --git a/tests/test_feed.py b/tests/test_feed.py\r\nnew file mode 100644\r\nindex 0000000..f64234e\r\n--- /dev/null\r\n+++ b/tests/test_feed.py\r\n@@ -0,0 +1,44 @@\r\n+import os\r\n+import sys\r\n+import unittest\r\n+\r\n+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\r\n+sys.path.insert(0, ROOT)\r\n+\r\n+from src.app import StoryLibrary  # noqa: E402\r\n+from tests.fake_dynamo import ClientError, FakeTable  # noqa: E402\r\n+\r\n+\r\n+class FeedTests(unittest.TestCase):\r\n+    def setUp(self):\r\n+        self.now = 1_700_000_000\r\n+        self.lib = StoryLibrary(FakeTable(), clock=lambda: self.now)\r\n+\r\n+    def test_publish_then_feed_lists_it(self):\r\n+        self.lib.publish(\"hello\", \"Hello\", \"first post\", \"ann\")\r\n+        self.assertEqual([s[\"slug\"] for s in self.lib.feed()], [\"hello\"])\r\n+\r\n+    def test_feed_is_newest_first(self):\r\n+        self.lib.publish(\"old\", \"Old\", \"...\", \"ann\")\r\n+        self.now += 60\r\n+        self.lib.publish(\"new\", \"New\", \"...\", \"bob\")\r\n+        self.assertEqual([s[\"slug\"] for s in self.lib.feed()], [\"new\", \"old\"])\r\n+\r\n+    def test_feed_leaves_bodies_out(self):\r\n+        self.lib.publish(\"hello\", \"Hello\", \"a long body\", \"ann\")\r\n+        self.assertEqual(set(self.lib.feed()[0]), {\"slug\", \"title\", \"published_at\"})\r\n+\r\n+    def test_publish_twice_is_rejected(self):\r\n+        self.lib.publish(\"hello\", \"Hello\", \"...\", \"ann\")\r\n+        with self.assertRaises(ClientError) as cm:\r\n+            self.lib.publish(\"hello\", \"Hello again\", \"...\", \"ann\")\r\n+        self.assertEqual(cm.exception.response[\"Error\"][\"Code\"], \"ConditionalCheckFailedException\")\r\n+\r\n+    def test_rename(self):\r\n+        self.lib.publish(\"hello\", \"Hello\", \"...\", \"ann\")\r\n+        self.lib.rename(\"hello\", \"Hello, world\")\r\n+        self.assertEqual(self.lib.get(\"hello\")[\"title\"], \"Hello, world\")\r\n+\r\n+\r\n+if __name__ == \"__main__\":\r\n+    unittest.main()\r\n"}}}
