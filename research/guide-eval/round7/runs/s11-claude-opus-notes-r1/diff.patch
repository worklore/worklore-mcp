@@ -8,6 +8,7 @@ import json
 import logging
 import re
 import time
+from decimal import Decimal
 
 log = logging.getLogger("stories")
 
@@ -48,6 +49,22 @@ def validate(story):
         raise ValueError("bad slug")
 
 
+def to_dynamo(value):
+    """Return ``value`` with every float replaced by a Decimal.
+
+    boto3 rejects Python floats in items ("Float types are not supported"), and
+    any computed number (a ratio, an average, a rounded score) is a float. All
+    writes go through this so no float can reach put_item, whichever field it is in.
+    """
+    if isinstance(value, float):
+        return Decimal(str(value))
+    if isinstance(value, dict):
+        return {k: to_dynamo(v) for k, v in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [to_dynamo(v) for v in value]
+    return value
+
+
 def publish(table, story):
     """Store ``story`` with its related stories. Returns the stored item."""
     validate(story)
@@ -60,6 +77,7 @@ def publish(table, story):
         "published_at": int(time.time()),
         "similar": related(story, existing),
     }
+    item = to_dynamo(item)
     table.put_item(Item=item)
     log.info("publish slug=%s similar=%d stored", item["slug"], len(item["similar"]))
     return item
