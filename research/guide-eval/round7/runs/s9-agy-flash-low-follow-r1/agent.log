{"event":"step_update","step_update":{"conversation_id":"2d106b35-cba2-4cb0-8023-9ff464d95d45","step_index":24,"state":"DONE","step_type":"tool","tool_name":"run_command","duration_seconds":0.070688,"tool_info":{"name":"run_command","parameters":{"CommandLine":"git diff"},"output":"Command exited with code 0.\n\nCommand output:\ndiff --git a/src/app.py b/src/app.py\r\nindex 963b0b5..3ae1feb 100644\r\n--- a/src/app.py\r\n+++ b/src/app.py\r\n@@ -34,17 +34,21 @@ class StoryLibrary:\r\n                 \"published_at\": int(self.clock()),\r\n                 \"status\": \"published\",\r\n             },\r\n-            ConditionExpression=\"attribute_not_exists(slug)\",\r\n+            ConditionExpression=\"attribute_not_exists(#slug)\",\r\n+            ExpressionAttributeNames={\"#slug\": \"slug\"},\r\n         )\r\n \r\n     def get(self, slug):\r\n-        return self.table.get_item(Key={\"slug\": slug}).get(\"Item\")\r\n+        return self.table.get_item(\r\n+            Key={\"slug\": slug},\r\n+        ).get(\"Item\")\r\n \r\n     def rename(self, slug, title):\r\n         self.table.update_item(\r\n             Key={\"slug\": slug},\r\n-            UpdateExpression=\"SET title = :t\",\r\n-            ConditionExpression=\"attribute_exists(slug)\",\r\n+            UpdateExpression=\"SET #title = :t\",\r\n+            ConditionExpression=\"attribute_exists(#slug)\",\r\n+            ExpressionAttributeNames={\"#title\": \"title\", \"#slug\": \"slug\"},\r\n             ExpressionAttributeValues={\":t\": title},\r\n         )\r\n \r\n@@ -52,14 +56,28 @@ class StoryLibrary:\r\n         \"\"\"Author withdraws a story: it stays in the table but leaves the feed.\"\"\"\r\n         self.table.update_item(\r\n             Key={\"slug\": slug},\r\n-            UpdateExpression=\"SET hidden = :h, hidden_by = :by, hidden_at = :t\",\r\n-            ConditionExpression=\"attribute_exists(slug)\",\r\n+            UpdateExpression=\"SET #hidden = :h, #hidden_by = :by, #hidden_at = :t\",\r\n+            ConditionExpression=\"attribute_exists(#slug)\",\r\n+            ExpressionAttributeNames={\r\n+                \"#hidden\": \"hidden\",\r\n+                \"#hidden_by\": \"hidden_by\",\r\n+                \"#hidden_at\": \"hidden_at\",\r\n+                \"#slug\": \"slug\",\r\n+            },\r\n             ExpressionAttributeValues={\":h\": True, \":by\": by, \":t\": int(self.clock())},\r\n         )\r\n \r\n     def feed(self, limit=FEED_LIMIT):\r\n         \"\"\"Public feed: newest first, hidden stories excluded, bodies left out.\"\"\"\r\n-        resp = self.table.scan(ProjectionExpression=\"slug, title, hidden, published_at\")\r\n+        resp = self.table.scan(\r\n+            ProjectionExpression=\"#slug, #title, #hidden, #published_at\",\r\n+            ExpressionAttributeNames={\r\n+                \"#slug\": \"slug\",\r\n+                \"#title\": \"title\",\r\n+                \"#hidden\": \"hidden\",\r\n+                \"#published_at\": \"published_at\",\r\n+            },\r\n+        )\r\n         items = [i for i in resp[\"Items\"] if not i.get(\"hidden\")]\r\n         items.sort(key=lambda i: i[\"published_at\"], reverse=True)\r\n         return [\r\n@@ -72,7 +90,11 @@ class StoryLibrary:\r\n         Not wired to the API yet (planned for the admin console).\"\"\"\r\n         self.table.update_item(\r\n             Key={\"slug\": slug},\r\n-            UpdateExpression=\"SET archived_at = :t\",\r\n-            ConditionExpression=\"status = :published\",\r\n+            UpdateExpression=\"SET #archived_at = :t\",\r\n+            ConditionExpression=\"#status = :published\",\r\n+            ExpressionAttributeNames={\r\n+                \"#archived_at\": \"archived_at\",\r\n+                \"#status\": \"status\",\r\n+            },\r\n             ExpressionAttributeValues={\":t\": int(self.clock()), \":published\": \"published\"},\r\n         )\r\ndiff --git a/tests/test_feed.py b/tests/test_feed.py\r\nindex f64234e..70e0c50 100644\r\n--- a/tests/test_feed.py\r\n+++ b/tests/test_feed.py\r\n@@ -39,6 +39,38 @@ class FeedTests(unittest.TestCase):\r\n         self.lib.rename(\"hello\", \"Hello, world\")\r\n         self.assertEqual(self.lib.get(\"hello\")[\"title\"], \"Hello, world\")\r\n \r\n+    def test_hide_removes_story_from_feed(self):\r\n+        self.lib.publish(\"visible\", \"Visible Story\", \"...\", \"ann\")\r\n+        self.lib.publish(\"withdrawn\", \"Withdrawn Story\", \"...\", \"bob\")\r\n+        self.lib.hide(\"withdrawn\", by=\"bob\")\r\n+\r\n+        feed_slugs = [s[\"slug\"] for s in self.lib.feed()]\r\n+        self.assertIn(\"visible\", feed_slugs)\r\n+        self.assertNotIn(\"withdrawn\", feed_slugs)\r\n+\r\n+        withdrawn_item = self.lib.get(\"withdrawn\")\r\n+        self.assertTrue(withdrawn_item.get(\"hidden\"))\r\n+        self.assertEqual(withdrawn_item.get(\"hidden_by\"), \"bob\")\r\n+\r\n+    def test_feed_excludes_manually_hidden_story(self):\r\n+        self.lib.publish(\"post-1\", \"Post 1\", \"...\", \"ann\")\r\n+        self.lib.publish(\"post-2\", \"Post 2\", \"...\", \"bob\")\r\n+        # Simulate manually setting hidden: True in DynamoDB (e.g. via CLI)\r\n+        self.lib.table.update_item(\r\n+            Key={\"slug\": \"post-2\"},\r\n+            UpdateExpression=\"SET #h = :t\",\r\n+            ExpressionAttributeNames={\"#h\": \"hidden\"},\r\n+            ExpressionAttributeValues={\":t\": True},\r\n+        )\r\n+        feed_slugs = [s[\"slug\"] for s in self.lib.feed()]\r\n+        self.assertEqual(feed_slugs, [\"post-1\"])\r\n+\r\n+    def test_archive(self):\r\n+        self.lib.publish(\"hello\", \"Hello\", \"...\", \"ann\")\r\n+        self.lib.archive(\"hello\")\r\n+        item = self.lib.get(\"hello\")\r\n+        self.assertEqual(item.get(\"archived_at\"), self.now)\r\n+\r\n \r\n if __name__ == \"__main__\":\r\n     unittest.main()\r\n"}}}
