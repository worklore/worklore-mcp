"}]\n    blocks[-1][\"cache_control\"] = eph\n    return blocks\n\n'''\ns=s.replace(old,new)\nopen('bot.py','w').write(s)\nEOF\nsed -i '' 's/^Prompt caching is on: the system$/Prompt caching is on: the system/' README.md; grep -n \"cache_control\" README.md"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3265,"cache_read_input_tokens":29255,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3265},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"a254c063-5377-4a92-aa16-2e02db27e505","uuid":"537f610b-8df4-4481-8938-76eacb501cec","timestamp":"2026-10-20T23:34:53.636Z","request_id":"req_011CgEN6EyMVBvtLvM24GqyB","wire_tool_inputs":{"toolu_01GXUkGUjXsYkVaEs89C6fzV":{"command":"cd /private/tmp/h-53WSTB && python3 - <<'EOF'\nimport re\ns=open('bot.py').read()\nold=s[s.index(\"def athlete_context(a, today):\"):s.index(\"# --------------------------------------------------------------------------- tools\")]\nnew='''def athlete_profile(a, today):\n    # Changes at most once a day (date) or when the profile itself is edited.\n    return \"\\\\n\".join([\n        f\"Today: {today.isoformat()} ({today.strftime('%A')})\",\n        f\"Athlete: {a.name} (id {a.user_id}), sport: {a.sport}\",\n        \"Zones: \" + \", \".join(f\"{k} {v}\" for k, v in a.zones.items()),\n        f\"Goal: {a.goal}\",\n        f\"Language: {a.lang}\",\n        \"Long-term facts:\",\n    ]) + \"\\\\n\"\n\n\ndef build_system(a, today):\n    \"\"\"System prompt as blocks ordered from never-changing to most-changing.\n\n    The cache is a prefix hash, so a save_fact must only touch the end:\n      1. INSTRUCTIONS        - byte-identical for every athlete and day (marker)\n      2. profile + date      - per athlete, changes daily (marker)\n      3. one block per fact  - append-only; marker on the last one\n    A new fact is appended as a new block after the previous marker, so the\n    API's lookback finds the previous request's cache entry one block back and\n    only the new fact is written. Facts must stay append-only and in order;\n    never interpolate anything volatile into INSTRUCTIONS. 3 of 4 markers used.\n    \"\"\"\n    eph = {\"type\": \"ephemeral\"}\n    blocks = [{\"type\": \"text\", \"text\": INSTRUCTIONS, \"cache_control\": eph},\n              {\"type\": \"text\", \"text\": athlete_profile(a, today), \"cache_control\": eph}]\n    blocks += [{\"type\": \"text\", \"text\": f\"- {f}\\\\n\"} for f in a.facts] or [{\"type\": \"text\", \"text\": \"- (none yet)\\\\n\"}]\n    blocks[-1][\"cache_control\"] = eph\n    return blocks\n\n'''\ns=s.replace(old,new)\nopen('bot.py','w').write(s)\nEOF\nsed -i '' 's/^Prompt caching is on: the system$/Prompt caching is on: the system/' README.md; grep -n \"cache_control\" README.md"}},"wire_ingest_context":{"toolu_01GXUkGUjXsYkVaEs89C6fzV":{"cwd":"/private/tmp/h-53WSTB"}}}
