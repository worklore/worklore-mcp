\"ann\")\n        self.lib.archive(\"hello\")\n        self.assertEqual(self.lib.get(\"hello\")[\"archived_at\"], self.now)\n\n    def test_bare_reserved_word_in_projection_is_loud_in_tests(self):\n        # The real service drops it silently; the test table must not.\n        table = FakeTable()\n        table.put_item(Item={\"slug\": \"a\", \"hidden\": True})\n        with self.assertRaises(ClientError):\n            table.scan(ProjectionExpression=\"slug, hidden\")\n","originalFile":"import os\nimport sys\nimport unittest\n\nROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nsys.path.insert(0, ROOT)\n\nfrom src.app import StoryLibrary  # noqa: E402\nfrom tests.fake_dynamo import ClientError, FakeTable  # noqa: E402\n\n\nclass FeedTests(unittest.TestCase):\n    def setUp(self):\n        self.now = 1_700_000_000\n        self.lib = StoryLibrary(FakeTable(), clock=lambda: self.now)\n\n    def test_publish_then_feed_lists_it(self):\n        self.lib.publish(\"hello\", \"Hello\", \"first post\", \"ann\")\n        self.assertEqual([s[\"slug\"] for s in self.lib.feed()], [\"hello\"])\n\n    def test_feed_is_newest_first(self):\n        self.lib.publish(\"old\", \"Old\", \"...\", \"ann\")\n        self.now += 60\n        self.lib.publish(\"new\", \"New\", \"...\", \"bob\")\n        self.assertEqual([s[\"slug\"] for s in self.lib.feed()], [\"new\", \"old\"])\n\n    def test_feed_leaves_bodies_out(self):\n        self.lib.publish(\"hello\", \"Hello\", \"a long body\", \"ann\")\n        self.assertEqual(set(self.lib.feed()[0]), {\"slug\", \"title\", \"published_at\"})\n\n    def test_publish_twice_is_rejected(self):\n        self.lib.publish(\"hello\", \"Hello\", \"...\", \"ann\")\n        with self.assertRaises(ClientError) as cm:\n            self.lib.publish(\"hello\", \"Hello again\", \"...\", \"ann\")\n        self.assertEqual(cm.exception.response[\"Error\"][\"Code\"], \"ConditionalCheckFailedException\")\n\n    def test_rename(self):\n        self.lib.publish(\"hello\", \"Hello\", \"...\", \"ann\")\n        self.lib.rename(\"hello\", \"Hello, world\")\n        self.assertEqual(self.lib.get(\"hello\")[\"title\"], \"Hello, world\")\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n","structuredPatch":[{"oldStart":39,"oldLines":6,"newStart":39,"newLines":37,"lines":["         self.lib.rename(\"hello\", \"Hello, world\")","         self.assertEqual(self.lib.get(\"hello\")[\"title\"], \"Hello, world\")"," ","+    def test_hide_writes_the_flag(self):","+        self.lib.publish(\"hello\", \"Hello\", \"...\", \"ann\")","+        self.lib.hide(\"hello\", by=\"ann\")","+        item = self.lib.get(\"hello\")","+        self.assertIs(item[\"hidden\"], True)","+        self.assertEqual(item[\"hidden_by\"], \"ann\")"," ","+    def test_hidden_story_leaves_the_feed(self):","+        # The flag must be set on the record the feed reads, so the filter is exercised.","+        self.lib.publish(\"hello\", \"Hello\", \"...\", \"ann\")","+        self.lib.publish(\"other\", \"Other\", \"...\", \"bob\")","+        self.lib.hide(\"hello\", by=\"ann\")","+        self.assertEqual([s[\"slug\"] for s in self.lib.feed()], [\"other\"])","+","+    def test_hide_unknown_story_is_rejected(self):","+        with self.assertRaises(ClientError) as cm:","+            self.lib.hide(\"nope\", by=\"ann\")","+        self.assertEqual(cm.exception.response[\"Error\"][\"Code\"], \"ConditionalCheckFailedException\")","+","+    def test_archive_sets_archived_at(self):","+        self.lib.publish(\"hello\", \"Hello\", \"...\", \"ann\")","+        self.lib.archive(\"hello\")","+        self.assertEqual(self.lib.get(\"hello\")[\"archived_at\"], self.now)","+","+    def test_bare_reserved_word_in_projection_is_loud_in_tests(self):","+        # The real service drops it silently; the test table must not.","+        table = FakeTable()","+        table.put_item(Item={\"slug\": \"a\", \"hidden\": True})","+        with self.assertRaises(ClientError):","