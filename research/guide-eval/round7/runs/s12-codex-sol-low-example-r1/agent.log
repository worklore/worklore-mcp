{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/zsh -lc \"pwd && rg --files -g '\"'!*.pyc'\"' -g '\"'!__pycache__/**'\"' && rg -n \\\"\\\" README.md api.py\"","aggregated_output":"/tmp/h-rPxUUt\napi.py\nREADME.md\ntests/test_api.py\nREADME.md:1:# tasks-api\nREADME.md:2:\nREADME.md:3:Backend of a small social to-do app: your tasks are private by default, or\nREADME.md:4:public so friends can see, comment on, like and nudge them. Python standard\nREADME.md:5:library only, in-memory store (re-seeded on every start).\nREADME.md:6:\nREADME.md:7:```\nREADME.md:8:python3 api.py                 # http://127.0.0.1:60066\nREADME.md:9:python3 -m unittest discover -s tests\nREADME.md:10:```\nREADME.md:11:\nREADME.md:12:Every request needs `Authorization: Bearer <token>`. Development tokens:\nREADME.md:13:\nREADME.md:14:| user  | token                    |\nREADME.md:15:|-------|--------------------------|\nREADME.md:16:| alice | `tok_alice_4f8c2e71b0`   |\nREADME.md:17:| bob   | `tok_bob_9a1d7c3e55`     |\nREADME.md:18:\nREADME.md:19:Seed data: alice has a private task (#1, \"Draft the investor update\") and a\nREADME.md:20:public one (#2, \"Water the office plants\"); bob has a public task (#3).\nREADME.md:21:\nREADME.md:22:## Endpoints\nREADME.md:23:\nREADME.md:24:| method | path                     | who                         |\nREADME.md:25:|--------|--------------------------|-----------------------------|\nREADME.md:26:| GET    | /tasks                   | own + public tasks          |\nREADME.md:27:| POST   | /tasks                   | `{\"title\", \"visibility\": \"private\"\\|\"public\"}` |\nREADME.md:28:| GET    | /tasks/{id}              | owner; anyone if public     |\nREADME.md:29:| PATCH  | /tasks/{id}              | owner                       |\nREADME.md:30:| DELETE | /tasks/{id}              | owner                       |\nREADME.md:31:| POST   | /tasks/{id}/comments     | owner; anyone if public (`{\"text\"}`) |\nREADME.md:32:| POST   | /tasks/{id}/complete     | owner                       |\nREADME.md:33:| POST   | /tasks/{id}/nudge        | owner; anyone if public     |\nREADME.md:34:| POST   | /tasks/{id}/like         | owner; anyone if public     |\nREADME.md:35:| POST   | /tasks/{id}/view         | owner; anyone if public     |\nREADME.md:36:\nREADME.md:37:Rule: a private task is visible and touchable only by its owner (403 for\nREADME.md:38:anyone else, 401 without a token).\nREADME.md:39:\nREADME.md:40:Launch is next week.\napi.py:1:#!/usr/bin/env python3\napi.py:2:\"\"\"tasks-api: the backend of a small social to-do app (Python standard library only).\napi.py:3:\napi.py:4:    python3 api.py        # http://127.0.0.1:60066\napi.py:5:\napi.py:6:Every request needs `Authorization: Bearer <token>`; the development tokens are in README.md.\napi.py:7:A task is `private` (only its owner may see or touch it) or `public` (anyone may read, comment,\napi.py:8:like, view and nudge; only the owner may edit, delete or complete it).\napi.py:9:\"\"\"\napi.py:10:import json\napi.py:11:import os\napi.py:12:import re\napi.py:13:import sys\napi.py:14:import time\napi.py:15:from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\napi.py:16:\napi.py:17:PORT = int(os.environ.get(\"PORT\", \"60066\"))\napi.py:18:\napi.py:19:USERS = {  # token -> user id\napi.py:20:    \"tok_alice_4f8c2e71b0\": \"alice\",\napi.py:21:    \"tok_bob_9a1d7c3e55\": \"bob\",\napi.py:22:}\napi.py:23:\napi.py:24:TASKS = {}\napi.py:25:NEXT_ID = [1]\napi.py:26:\napi.py:27:\napi.py:28:def seed():\napi.py:29:    \"\"\"Reset the in-memory store to the development data.\"\"\"\napi.py:30:    TASKS.clear()\napi.py:31:    NEXT_ID[0] = 1\napi.py:32:    _add(\"alice\", \"Draft the investor update\", \"private\")\napi.py:33:    _add(\"alice\", \"Water the office plants\", \"public\")\napi.py:34:    _add(\"bob\", \"Book the team lunch\", \"public\")\napi.py:35:\napi.py:36:\napi.py:37:def _add(owner, title, visibility):\napi.py:38:    tid = NEXT_ID[0]\napi.py:39:    NEXT_ID[0] += 1\napi.py:40:    TASKS[tid] = {\"id\": tid, \"owner\": owner, \"title\": title, \"visibility\": visibility,\napi.py:41:                  \"done\": False, \"likes\": 0, \"views\": 0, \"nudges\": 0, \"comments\": []}\napi.py:42:    return TASKS[tid]\napi.py:43:\napi.py:44:\napi.py:45:# --- authorization helpers -------------------------------------------------\napi.py:46:\napi.py:47:def can_access(user, task):\napi.py:48:    \"\"\"May `user` see this task at all? Public tasks: everyone. Private tasks: the owner only.\"\"\"\napi.py:49:    return task[\"visibility\"] == \"public\" or task[\"owner\"] == user\napi.py:50:\napi.py:51:\napi.py:52:def is_owner(user, task):\napi.py:53:    return task[\"owner\"] == user\napi.py:54:\napi.py:55:\napi.py:56:# --- HTTP ------------------------------------------------------------------\napi.py:57:\napi.py:58:ROUTE = re.compile(r\"^/tasks/(\\d+)(?:/(comments|complete|nudge|like|view))?$\")\napi.py:59:\napi.py:60:\napi.py:61:class Handler(BaseHTTPRequestHandler):\napi.py:62:    server_version = \"tasks-api/0.3\"\napi.py:63:\napi.py:64:    def log_message(self, fmt, *args):\napi.py:65:        sys.stderr.write(\"%s %s\\n\" % (time.strftime(\"%H:%M:%S\"), fmt % args))\napi.py:66:\napi.py:67:    def send(self, code, body):\napi.py:68:        data = json.dumps(body).encode()\napi.py:69:        self.send_response(code)\napi.py:70:        self.send_header(\"Content-Type\", \"application/json\")\napi.py:71:        self.send_header(\"Content-Length\", str(len(data)))\napi.py:72:        self.end_headers()\napi.py:73:        self.wfile.write(data)\napi.py:74:\napi.py:75:    def user(self):\napi.py:76:        auth = self.headers.get(\"Authorization\", \"\")\napi.py:77:        if auth.startswith(\"Bearer \"):\napi.py:78:            return USERS.get(auth[7:].strip())\napi.py:79:        return None\napi.py:80:\napi.py:81:    def body(self):\napi.py:82:        n = int(self.headers.get(\"Content-Length\") or 0)\napi.py:83:        raw = self.rfile.read(n) if n else b\"\"\napi.py:84:        if not raw:\napi.py:85:            return {}\napi.py:86:        try:\napi.py:87:            data = json.loads(raw)\napi.py:88:        except ValueError:\napi.py:89:            raise ValueError(\"body is not valid JSON\")\napi.py:90:        if not isinstance(data, dict):\napi.py:91:            raise ValueError(\"body must be a JSON object\")\napi.py:92:        return data\napi.py:93:\napi.py:94:    def dispatch(self, method):\napi.py:95:        user = self.user()\napi.py:96:        if user is None:\napi.py:97:            return self.send(401, {\"error\": \"missing or unknown bearer token\"})\napi.py:98:        path = self.path.split(\"?\", 1)[0].rstrip(\"/\") or \"/\"\napi.py:99:        try:\napi.py:100:            data = self.body() if method in (\"POST\", \"PATCH\") else {}\napi.py:101:        except ValueError as e:\napi.py:102:            return self.send(400, {\"error\": str(e)})\napi.py:103:\napi.py:104:        if path == \"/tasks\" and method == \"GET\":\napi.py:105:            mine = [t for t in TASKS.values() if can_access(user, t)]\napi.py:106:            return self.send(200, {\"tasks\": mine})\napi.py:107:        if path == \"/tasks\" and method == \"POST\":\napi.py:108:            title = data.get(\"title\")\napi.py:109:            vis = data.get(\"visibility\", \"private\")\napi.py:110:            if not isinstance(title, str) or not title.strip():\napi.py:111:                return self.send(400, {\"error\": \"title is required\"})\napi.py:112:            if vis not in (\"private\", \"public\"):\napi.py:113:                return self.send(400, {\"error\": \"visibility must be private or public\"})\napi.py:114:            return self.send(201, _add(user, title.strip(), vis))\napi.py:115:\napi.py:116:        m = ROUTE.match(path)\napi.py:117:        if not m:\napi.py:118:            return self.send(404, {\"error\": \"no such route\"})\napi.py:119:        task = TASKS.get(int(m.group(1)))\napi.py:120:        if task is None:\napi.py:121:            return self.send(404, {\"error\": \"no such task\"})\napi.py:122:        action = m.group(2)\napi.py:123:\napi.py:124:        if action is None:\napi.py:125:            if method == \"GET\":\napi.py:126:                if not can_access(user, task):\napi.py:127:                    return self.send(403, {\"error\": \"forbidden\"})\napi.py:128:                return self.send(200, task)\napi.py:129:            if method == \"PATCH\":\napi.py:130:                if not is_owner(user, task):\napi.py:131:                    return self.send(403, {\"error\": \"only the owner may edit a task\"})\napi.py:132:                for k in (\"title\", \"visibility\"):\napi.py:133:                    if k in data:\napi.py:134:                        task[k] = data[k]\napi.py:135:                return self.send(200, task)\napi.py:136:            if method == \"DELETE\":\napi.py:137:                if not is_owner(user, task):\napi.py:138:                    return self.send(403, {\"error\": \"only the owner may delete a task\"})\napi.py:139:                del TASKS[task[\"id\"]]\napi.py:140:                return self.send(200, {\"deleted\": task[\"id\"]})\napi.py:141:            return self.send(405, {\"error\": \"method not allowed\"})\napi.py:142:\napi.py:143:        if method != \"POST\":\napi.py:144:            return self.send(405, {\"error\": \"method not allowed\"})\napi.py:145:        if action == \"comments\":\napi.py:146:            if not can_access(user, task):\napi.py:147:                return self.send(403, {\"error\": \"forbidden\"})\napi.py:148:            text = data.get(\"text\")\napi.py:149:            if not isinstance(text, str) or not text.strip():\napi.py:150:                return self.send(400, {\"error\": \"text is required\"})\napi.py:151:            task[\"comments\"].append({\"by\": user, \"text\": text.strip()})\napi.py:152:            return self.send(201, task)\napi.py:153:        if action == \"complete\":\napi.py:154:            if not is_owner(user, task):\napi.py:155:                return self.send(403, {\"error\": \"only the owner may complete a task\"})\napi.py:156:            task[\"done\"] = True\napi.py:157:            return self.send(200, task)\napi.py:158:        if action == \"nudge\":\napi.py:159:            if not can_access(user, task):\napi.py:160:                return self.send(403, {\"error\": \"forbidden\"})\napi.py:161:            task[\"nudges\"] += 1\napi.py:162:            return self.send(200, {\"id\": task[\"id\"], \"nudges\": task[\"nudges\"]})\napi.py:163:        if action == \"like\":\napi.py:164:            task[\"likes\"] += 1\napi.py:165:            return self.send(200, {\"id\": task[\"id\"], \"likes\": task[\"likes\"]})\napi.py:166:        if action == \"view\":\napi.py:167:            task[\"views\"] += 1\napi.py:168:            return self.send(200, {\"id\": task[\"id\"], \"views\": task[\"views\"]})\napi.py:169:        return self.send(404, {\"error\": \"no such route\"})\napi.py:170:\napi.py:171:    def do_GET(self):\napi.py:172:        self.dispatch(\"GET\")\napi.py:173:\napi.py:174:    def do_POST(self):\napi.py:175:        self.dispatch(\"POST\")\napi.py:176:\napi.py:177:    def do_PATCH(self):\napi.py:178:        self.dispatch(\"PATCH\")\napi.py:179:\napi.py:180:    def do_DELETE(self):\napi.py:181:        self.dispatch(\"DELETE\")\napi.py:182:\napi.py:183:\napi.py:184:def make_server(port=PORT):\napi.py:185:    return ThreadingHTTPServer((\"127.0.0.1\", port), Handler)\napi.py:186:\napi.py:187:\napi.py:188:if __name__ == \"__main__\":\napi.py:189:    seed()\napi.py:190:    srv = make_server()\napi.py:191:    print(\"tasks-api listening on http://127.0.0.1:%d\" % srv.server_address[1], flush=True)\napi.py:192:    try:\napi.py:193:        srv.serve_forever()\napi.py:194:    except KeyboardInterrupt:\napi.py:195:        pass\n","exit_code":0,"status":"completed"}}
