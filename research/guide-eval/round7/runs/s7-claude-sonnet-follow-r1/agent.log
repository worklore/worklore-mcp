; b=s.index(\"def intervals_get\")\ns=s[:a]+'''class AccountMismatch(Exception):\n    pass\n\n\ndef store_connection(user_id, tok):\n    \"\"\"Intervals tokens never expire and have no refresh_token; they die only on revocation.\"\"\"\n    athlete = tok.get(\"athlete\") or {}\n    with LOCK:\n        old = CONNECTIONS.get(user_id)\n        if old and old.get(\"athlete_id\") and old[\"athlete_id\"] != athlete.get(\"id\"):\n            raise AccountMismatch(f\"stored {old['athlete_id']}, got {athlete.get('id')}\")\n        # NOTE: perpetual credential - encrypt at rest in the real store.\n        CONNECTIONS[user_id] = {\n            \"athlete_id\": athlete.get(\"id\"), \"athlete_name\": athlete.get(\"name\"),\n            \"access_token\": tok[\"access_token\"], \"scope\": tok.get(\"scope\"), \"status\": \"connected\",\n        }\n    log(f\"{user_id}: connected as athlete {athlete.get('id')}\")\n\n\n'''+s[b:]\ns=s.replace(\"DEFAULT_TOKEN_TTL = 3600   # seconds; used when the provider does not say how long a token lives\\n\",\"\")\ns=s.replace(\"# user_id -> {athlete_id, athlete_name, access_token, refresh_token, scope, expires_at, status}\",\"# user_id -> {athlete_id, athlete_name, access_token, scope, status}\")\n# routes\ns=s.replace('''        if url.path == \"/api/intervals/auth/init\":\n            return self.auth_init()\n''','')\ns=s.replace('''    def do_POST(self):\n        url = urllib.parse.urlsplit(self.path)\n''','''    def do_POST(self):\n        url = urllib.parse.urlsplit(self.path)\n        if url.path == \"/api/intervals/auth/init\":\n            return self.auth_init()\n''')\ns=s.replace(\"        self.redirect(AUTHORIZE_URL + \\\"?\\\" + urllib.parse.urlencode(params, safe=\\\":,\\\"))\",\n\"        self.send_json(200, {\\\"authorize_url\\\": AUTHORIZE_URL + \\\"?\\\" + urllib.parse.urlencode(params, safe=\\\":,\\\")})\")\ns=s.replace(\"# Step 1: build the authorize URL and send the browser to Intervals.\",\"# Step 1 (authenticated POST/XHR): return the authorize URL for the SPA to navigate to.\")\ns=s.replace('''        except urllib.error.HTTPError as e:\n            log(f\"{user_id}: token exchange failed''','''        except AccountMismatch as e:\n            log(f\"{user_id}: reconnect rejected, account mismatch ({e})\")\n            return self.send_json(409, {\"error\": \"different Intervals.icu account than the one connected\"})\n        except urllib.error.HTTPError as e:\n            log(f\"{user_id}: token exchange failed''',1)\ns=s.replace('''        except urllib.error.HTTPError as e:\n            self.send_json(e.code''','''        except urllib.error.HTTPError as e:\n            if e.code == 401:  # revoked: clear token, prompt reconnect\n                with LOCK:\n                    c.update(status=\"expired, reconnect\", access_token=None)\n            self.send_json(e.code''')\ns=s.replace(\"    threading.Thread(target=refresh_tokens, daemon=True).start()\\n\",\"\")\nopen('server.py','w').write(s)\nc=open('config.py').read()\nc=c.replace(\"ACTIVITY:READ,ACTIVITY:WRITE,WELLNESS:READ,CALENDAR:READ,CALENDAR:WRITE\",\"ACTIVITY:WRITE,WELLNESS:READ,CALENDAR:WRITE\")\nc=c.replace(\"\\nREFRESH_INTERVAL = 60      # seconds between passes of the token refresher\\n\",\"\")\nopen('config.py','w').write(c)\nj=open('static/app.js').read()\nj=j.replace('<a class=\"btn\" href=\"/api/intervals/auth/init\">Connect Intervals.icu</a>','<button class=\"btn\" id=\"connect\">Connect Intervals.icu</button>')\nj=j.replace('    const d = document.getElementById(\"disconnect\");','''    const cb = document.getElementById(\"connect\");\n    if (cb) cb.onclick = async () => {\n      try {\n        const r = await api(\"/api/intervals/auth/init\", { method: \"POST\" });\n        window.location.assign(r.authorize_url);\n      } catch (e) { root.innerHTML = `<p class=\"card\">Error: ${esc(e.message)}</p>`; }\n    };\n    const d = document.getElementById(\"disconnect\");''')\nopen('static/app.js','w').write(j)\nEOF\ng