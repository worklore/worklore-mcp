{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport json, threading, urllib.request, urllib.parse\nfrom http.server import ThreadingHTTPServer\nimport server\nsrv = ThreadingHTTPServer(('127.0.0.1', 0), server.Handler)\nthreading.Thread(target=srv.serve_forever, daemon=True).start()\nbase = f'http://127.0.0.1:{srv.server_port}'\nreq = urllib.request.Request(base + '/api/intervals/auth/init', headers={'Authorization': 'Bearer tok-okafor'})\nwith urllib.request.urlopen(req) as response:\n    data = json.load(response)\n    assert response.status == 200\nquery = urllib.parse.parse_qs(urllib.parse.urlsplit(data['authorize_url']).query)\nassert query['scope'] == ['WELLNESS:READ,CALENDAR:WRITE']\nassert server.verify_state(query['state'][0]) == 'u_okafor'\nserver.store_connection('u_okafor', {'access_token': 'test-token', 'scope': query['scope'][0], 'athlete': {'id':'123','name':'Test'}})\nassert server.CONNECTIONS['u_okafor']['status'] == 'connected'\nassert server.CONNECTIONS['u_okafor']['access_token'] == 'test-token'\nprint('OAuth init and non-expiring token storage: OK')\nsrv.shutdown()\nPY\n git status --short\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
