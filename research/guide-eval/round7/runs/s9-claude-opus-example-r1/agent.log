{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DFC5vA5QgSZZruRKfdft2g","type":"tool_result","content":"# storylib\n\nThe library behind the public story feed: publish a story, hide one (the\nauthor withdraws it), list the feed. One DynamoDB table, key `slug`.\n\nLayout:\n\n- `src/app.py` -- `StoryLibrary`, the only module that talks to DynamoDB.\n  The Lambda handlers (`api.py`, in the infra repo) call its methods; keep\n  the method names and signatures stable.\n- `tests/fake_dynamo.py` -- in-memory stand-in for the boto3 Table resource,\n  so the tests run without AWS. It follows DynamoDB's expression rules\n  (see its docstring).\n- `tests/test_feed.py` -- the tests.\n- `logs/` -- what came in this week: the production error on hide and a bug\n  report from staging.\n\nRun the tests (Python 3, no dependencies; on the servers `boto3` is\ninstalled and `STORIES_TABLE` names the table):\n\n    python3 -m unittest discover tests\n\"\"\"storylib - the story library behind the public feed.\n\nThree operations: publish a story, hide one (the author withdraws it) and\nlist the public feed. Storage is a single DynamoDB table keyed by `slug`.\nThis module only talks to a boto3 Table resource; the tests hand it\ntests/fake_dynamo.FakeTable instead, and the HTTP handlers (api.py, in the\ninfra repo) hand it dynamo_table().\n\"\"\"\nimport os\nimport time\n\n\ndef dynamo_table():\n    \"\"\"The real table. boto3 is only installed on the servers.\"\"\"\n    import boto3\n    return boto3.resource(\"dynamodb\").Table(os.environ.get(\"STORIES_TABLE\", \"stories\"))\n\n\nclass StoryLibrary:\n    FEED_LIMIT = 50\n\n    def __init__(self, table, clock=time.time):\n        self.table = table\n        self.clock = clock\n\n    def publish(self, slug, title, body, author):\n        \"\"\"Create a story. Refuses to overwrite an existing slug.\"\"\"\n        self.table.put_item(\n            Item={\n                \"slug\": slug,\n                \"title\": title,\n                \"body\": body,\n                \"author\": author,\n                \"published_at\": int(self.clock()),\n                \"status\": \"published\",\n            },\n            ConditionExpression=\"attribute_not_exists(slug)\",\n        )\n\n    def get(self, slug):\n        return self.table.get_item(Key={\"slug\": slug}).get(\"Item\")\n\n    def rename(self, slug, title):\n        self.table.update_item(\n            Key={\"slug\": slug},\n            UpdateExpression=\"SET title = :t\",\n            ConditionExpression=\"attribute_exists(slug)\",\n            ExpressionAttributeValues={\":t\": title},\n        )\n\n    def hide(self, slug, by):\n        \"\"\"Author withdraws a story: it stays in the table but leaves the feed.\"\"\"\n        self.table.update_item(\n            Key={\"slug\": slug},\n            UpdateExpression=\"SET hidden = :h, hidden_by = :by, hidden_at = :t\",\n            ConditionExpression=\"attribute_exists(slug)\",\n            ExpressionAttributeValues={\":h\": True, \":by\": by, \":t\": int(self.clock())},\n        )\n\n    def feed(self, limit=FEED_LIMIT):\n        \"\"\"Public feed: newest first, hidden stories excluded, bodies left out.\"\"\"\n        resp = self.table.scan(ProjectionExpression=\"slug, title, hidden, published_at\")\n        items = [i for i in resp[\"Items\"] if not i.get(\"hidden\")]\n        items.sort(key=lambda i: i[\"published_at\"], reverse=True)\n        return [\n            {\"slug\": i[\"slug\"], \"title\": i[\"title\"], \"published_at\": i[\"published_at\"]}\n            for i in items[:limit]\n        ]\n\n    def archive(self, slug):\n        \"\"\"Editorial: take a published story out of circulation for good.\n        Not wired to the API yet (planned for the admin console).\"\"\"\n        self.table.update_item(\n            Key={\"slug\": slug},\n            UpdateExpression=\"SET archived_at = :t\",\n            ConditionExpression=\"status = :published\",\n            ExpressionAttributeValues={\":t\": int(self.clock()), \":published\": \"published\"},\n        )\n\"\"\"In-memory stand-in for a boto3 DynamoDB Table resource, for the tests.\n\nCovers put_item, get_item, update_item and scan, with the expression rules\nthat matter for this service. It mirrors DynamoDB's documented behaviour\nfor reserved words (the real service keeps a list of ~570 of them; RESERVED\nbelow is the subset that comes up in practice):\n\n  * a bare reserved word in an UpdateExpression, ConditionExpression or\n    FilterExpression raises ValidationException\n    (\"Attribute name is a reserved keyword\"), exactly like the real service;\n  * a bare reserved word in a ProjectionExpression does NOT raise: the\n    attribute is simply absent from the returned item, as on the real\n    service, and nothing in the response says so;\n  * '#alias' placeholders resolved through ExpressionAttributeNames work in\n    every expression, which is how DynamoDB tells you to spell any name.\n\nGrammar supported: `SET a = :v [, ...]` and `REMOVE a [, ...]` in updates;\n`=`, `<>`, `<`, `<=`, `>`, `>=`, attribute_exists(), attribute_not_exists(),\nNOT, AND, OR and parentheses in conditions and filters.\n\"\"\"\nimport copy\nimport re\n\nRESERVED = frozenset(\"\"\"\nADD AND ATTRIBUTE BINARY BY COMMENT COUNT DATA DATE DAY DELETE FALSE FROM GROUP HIDDEN HOUR\nIN INDEX ITEM ITEMS KEY KEYS LEVEL LIST MAP MINUTE MONTH NAME NOT NULL NUMBER OF ON OR ORDER\nPRIVATE PUBLIC QUERY REMOVE ROLE SCAN SECOND SELECT SET SIMILAR SIZE STATE STATUS STRING TABLE\nTEXT TIMESTAMP TO TRUE TYPE UPDATE URL USER VALUE VALUES YEAR\n\"\"\".split())\n\n_KEYWORDS = {\"SET\", \"REMOVE\", \"ADD\", \"DELETE\", \"AND\", \"OR\", \"NOT\", \"BETWEEN\", \"IN\"}\n_OPERATORS = {\"=\", \"<>\", \"<\", \"<=\", \">\", \">=\", \"(\", \")\", \",\"}\n_TOKEN = re.compile(r\"\\s*(#?[A-Za-z_][A-Za-z0-9_]*|:[A-Za-z_][A-Za-z0-9_]*|<>|<=|>=|[=<>(),])\")\n\n\nclass ClientError(Exception):\n    \"\"\"Same shape as botocore.exceptions.ClientError (.response[\"Error\"][\"Code\"]).\"\"\"\n\n    def __init__(self, code, message, operation):\n        super().__init__(f\"An error occurred ({code}) when calling the {operation} operation: {message}\")\n        self.response = {\"Error\": {\"Code\": code, \"Message\": message}}\n\n\ndef _tokens(expr):\n    out, pos = [], 0\n    while pos < len(expr):\n        m = _TOKEN.match(expr, pos)\n        if not m:\n            if expr[pos:].strip():\n                raise ValueError(f\"fake_dynamo cannot parse expression near: {expr[pos:]!r}\")\n            break\n        out.append(m.group(1)); pos = m.end()\n    return out\n\n\nclass _Names:\n    \"\"\"Resolves attribute names in one API call and enforces the reserved-word rules.\"\"\"\n\n    def __init__(self, mapping, operation):\n        self.mapping, self.operation, self.used = dict(mapping or {}), operation, set()\n\n    def _invalid(self, kind, msg):\n        raise ClientError(\"ValidationException\", f\"Invalid {kind}: {msg}\", self.operation)\n\n    def alias(self, kind, tok):\n        if tok not in self.mapping:\n            self._invalid(kind, f\"An expression attribute name used in the document path is not defined; attribute name: {tok}\")\n        self.used.add(tok)\n        return self.mapping[tok]\n\n    def validate(self, kind, expr):\n        \"\"\"Raise like DynamoDB does for a bare reserved word or an unknown #alias.\"\"\"\n        toks = _tokens(expr)\n        for i, t in enumerate(toks):\n            if t.startswith(\"#\"):\n                self.alias(kind, t)\n            elif t.startswith(\":\") or t in _OPERATORS or t.upper() in _KEYWORDS:\n                continue\n            elif i + 1 < len(toks) and toks[i + 1] == \"(\":\n                continue  # function call: attribute_exists(...), size(...)\n            elif t.upper() in RESERVED:\n                self._invalid(kind, f\"Attribute name is a reserved keyword; reserved keyword: {t}\")\n        return toks\n\n    def resolve(self, tok):\n        return self.mapping[tok] if tok.startswith(\"#\") else tok\n\n    def finish(self):\n        unused = sorted(set(self.mapping) - self.used)\n        if unused:\n            raise ClientError(\"ValidationException\", \"Value provided in ExpressionAttributeNames unused in \"\n                              f\"expressions: keys: {{{', '.join(unused)}}}\", self.operation)\n\n\ndef _evaluate(toks, item, names, values):\n    \"\"\"Evaluate a validated condition/filter expression against one item.\"\"\"\n    pos = [0]\n    peek = lambda: toks[pos[0]] if pos[0] < len(toks) else None  # noqa: E731\n\n    def take():\n        pos[0] += 1\n        return toks[pos[0] - 1]\n\n    def operand():\n        t = take()\n        return values[t] if t.startswith(\":\") else item.get(names.resolve(t))\n\n    def primary():\n        t = peek()\n        if t == \"(\":\n            take(); v = binary(\"OR\"); take()\n            return v\n        if t.upper() == \"NOT\":\n            take()\n            return not primary()\n        if t in (\"attribute_exists\", \"attribute_not_exists\"):\n            take(); take(); present = names.resolve(take()) in item; take()\n            return present if t == \"attribute_exists\" else not present\n        left = operand(); op = take(); right = operand()\n        if op in (\"=\", \"<>\"):\n            return (left == right) if op == \"=\" else (left != right)\n        if left is None or right is None:\n            return False\n        return {\"<\": left < right, \"<=\": left <= right, \">\": left > right, \">=\": left >= right}[op]\n\n    def binary(word):\n        sub = (lambda: binary(\"AND\")) if word == \"OR\" else primary\n        v = sub()\n        while peek() and peek().upper() == word:\n            take(); r = sub(); v = (v or r) if word == \"OR\" else (v and r)\n        return v\n\n    return binary(\"OR\")\n\n\nclass FakeTable:\n    def __init__(self, key=\"slug\"):\n        self.key, self._items = key, {}\n\n    def _check(self, op, expr, current, names, values):\n        if expr is not None and not _evaluate(names.validate(\"ConditionExpression\", expr), current, names, values or {}):\n            raise ClientError(\"ConditionalCheckFailedException\", \"The conditional request failed\", op)\n\n    def put_item(self, Item, ConditionExpression=None, ExpressionAttributeNames=None,\n                 ExpressionAttributeValues=None, **_ignored):\n        names = _Names(ExpressionAttributeNames, \"PutItem\")\n        self._check(\"PutItem\", ConditionExpression, self._items.get(Item[self.key], {}), names, ExpressionAttributeValues)\n        names.finish()\n        self._items[Item[self.key]] = copy.deepcopy(Item)\n        return {}\n\n    def get_item(self, Key, ProjectionExpression=None, ExpressionAttributeNames=None, **_ignored):\n        names = _Names(ExpressionAttributeNames, \"GetItem\")\n        item = self._items.get(Key[self.key])\n        if item is None:\n            return {}\n        item = self._project(copy.deepcopy(item), ProjectionExpression, names)\n        names.finish()\n        return {\"Item\": item}\n\n    def update_item(self, Key, UpdateExpression, ConditionExpression=None, ExpressionAttributeNames=None,\n                    ExpressionAttributeValues=None, ReturnValues=None, **_ignored):\n        names, values = _Names(ExpressionAttributeNames, \"UpdateItem\"), ExpressionAttributeValues or {}\n        toks = names.validate(\"UpdateExpression\", UpdateExpression)\n        current = self._items.get(Key[self.key], {})\n        self._check(\"UpdateItem\", ConditionExpression, current, names, values)\n        names.finish()\n        item = copy.deepcopy(current) or dict(Key)\n        clause, i = None, 0\n        while i < len(toks):\n            t = toks[i]\n            if t.upper() in (\"SET\", \"REMOVE\"):\n                clause = t.upper(); i += 1\n            elif t == \",\":\n                i += 1\n            elif clause == \"SET\" and i + 2 < len(toks) and toks[i + 1] == \"=\" and toks[i + 2].startswith(\":\"):\n                item[names.resolve(t)] = values[toks[i + 2]]; i += 3\n            elif clause == \"REMOVE\":\n                item.pop(names.resolve(t), None); i += 1\n            else:\n                names._invalid(\"UpdateExpression\", f\"fake_dynamo does not support this syntax near {t!r}\")\n        self._items[Key[self.key]] = item\n        return {\"Attributes\": copy.deepcopy(item)} if ReturnValues else {}\n\n    def scan(self, ProjectionExpression=None, FilterExpression=None, ExpressionAttributeNames=None,\n             ExpressionAttributeValues=None, **_ignored):\n        names = _Names(ExpressionAttributeNames, \"Scan\")\n        items = [copy.deepcopy(v) for v in self._items.values()]\n        scanned = len(items)\n        if FilterExpression:\n            toks = names.validate(\"FilterExpression\", FilterExpression)\n            items = [i for i in items if _evaluate(toks, i, names, ExpressionAttributeValues or {})]\n        items = [self._project(i, ProjectionExpression, names) for i in items]\n        names.finish()\n        return {\"Items\": items, \"Count\": len(items), \"ScannedCount\": scanned}\n\n    def _project(self, item, expr, names):\n        \"\"\"Reserved words used bare are dropped from the result without any error.\"\"\"\n        if not expr:\n            return item\n        out = {}\n        for path in [p.strip() for p in expr.split(\",\") if p.strip()]:\n            if path.startswith(\"#\"):\n                attr = names.alias(\"ProjectionExpression\", path)\n            elif path.upper() in RESERVED:\n                continue\n            else:\n                attr = path\n            if attr in item:\n                out[attr] = item[attr]\n        return out\nimport os\nimport sys\nimport unittest\n\nROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nsys.path.insert(0, ROOT)\n\nfrom src.app import StoryLibrary  # noqa: E402\nfrom tests.fake_dynamo import ClientError, FakeTable  # noqa: E402\n\n\nclass FeedTests(unittest.TestCase):\n    def setUp(self):\n        self.now = 1_700_000_000\n        self.lib = StoryLibrary(FakeTable(), clock=lambda: self.now)\n\n    def test_publish_then_feed_lists_it(self):\n        self.lib.publish(\"hello\", \"Hello\", \"first post\", \"ann\")\n        self.assertEqual([s[\"slug\"] for s in self.lib.feed()], [\"hello\"])\n\n    def test_feed_is_newest_first(self):\n        self.lib.publish(\"old\", \"Old\", \"...\", \"ann\")\n        self.now += 60\n        self.lib.publish(\"new\", \"New\", \"...\", \"bob\")\n        self.assertEqual([s[\"slug\"] for s in self.lib.feed()], [\"new\", \"old\"])\n\n    def test_feed_leaves_bodies_out(self):\n        self.lib.publish(\"hello\", \"Hello\", \"a long body\", \"ann\")\n        self.assertEqual(set(self.lib.feed()[0]), {\"slug\", \"title\", \"published_at\"})\n\n    def test_publish_twice_is_rejected(self):\n        self.lib.publish(\"hello\", \"Hello\", \"...\", \"ann\")\n        with self.assertRaises(ClientError) as cm:\n            self.lib.publish(\"hello\", \"Hello again\", \"...\", \"ann\")\n        self.assertEqual(cm.exception.response[\"Error\"][\"Code\"], \"ConditionalCheckFailedException\")\n\n    def test_rename(self):\n        self.lib.publish(\"hello\", \"Hello\", \"...\", \"ann\")\n        self.lib.rename(\"hello\", \"Hello, world\")\n        self.assertEqual(self.lib.get(\"hello\")[\"title\"], \"Hello, world\")\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n__pycache__/","is_error":false}]},"parent_tool_use_id":null,"session_id":"1a08a04c-3f1c-4797-98e7-f2dcbab8a0ac","uuid":"3ee99128-dc11-4bb1-8634-9052628733c1","timestamp":"2026-10-20T23:38:21.791Z","tool_use_result":{"stdout":"# storylib\n\nThe library behind the public story feed: publish a story, hide one (the\nauthor withdraws it), list the feed. One DynamoDB table, key `slug`.\n\nLayout:\n\n- `src/app.py` -- `StoryLibrary`, the only module that talks to DynamoDB.\n  The Lambda handlers (`api.py`, in the infra repo) call its methods; keep\n  the method names and signatures stable.\n- `tests/fake_dynamo.py` -- in-memory stand-in for the boto3 Table resource,\n  so the tests run without AWS. It follows DynamoDB's expression rules\n  (see its docstring).\n- `tests/test_feed.py` -- the tests.\n- `logs/` -- what came in this week: the production error on hide and a bug\n  report from staging.\n\nRun the tests (Python 3, no dependencies; on the servers `boto3` is\ninstalled and `STORIES_TABLE` names the table):\n\n    python3 -m unittest discover tests\n\"\"\"storylib - the story library behind the public feed.\n\nThree operations: publish a story, hide one (the author withdraws it) and\nlist the public feed. Storage is a single DynamoDB table keyed by `slug`.\nThis module only talks to a boto3 Table resource; the tests hand it\ntests/fake_dynamo.FakeTable instead, and the HTTP handlers (api.py, in the\ninfra repo) hand it dynamo_table().\n\"\"\"\nimport os\nimport time\n\n\ndef dynamo_table():\n    \"\"\"The real table. boto3 is only installed on the servers.\"\"\"\n    import boto3\n    return boto3.resource(\"dynamodb\").Table(os.environ.get(\"STORIES_TABLE\", \"stories\"))\n\n\nclass StoryLibrary:\n    FEED_LIMIT = 50\n\n    def __init__(self, table, clock=time.time):\n        self.table = table\n        self.clock = clock\n\n    def publish(self, slug, title, body, author):\n        \"\"\"Create a story. Refuses to overwrite an existing slug.\"\"\"\n        self.table.put_item(\n            Item={\n                \"slug\": slug,\n                \"title\": title,\n                \"body\": body,\n                \"author\": author,\n                \"published_at\": int(self.clock()),\n                \"status\": \"published\",\n            },\n            ConditionExpression=\"attribute_not_exists(slug)\",\n        )\n\n    def get(self, slug):\n        return self.table.get_item(Key={\"slug\": slug}).get(\"Item\")\n\n    def rename(self, slug, title):\n        self.table.update_item(\n            Key={\"slug\": slug},\n            UpdateExpression=\"SET title = :t\",\n            ConditionExpression=\"attribute_exists(slug)\",\n            ExpressionAttributeValues={\":t\": title},\n        )\n\n    def hide(self, slug, by):\n        \"\"\"Author withdraws a story: it stays in the table but leaves the feed.\"\"\"\n        self.table.update_item(\n            Key={\"slug\": slug},\n            UpdateExpression=\"SET hidden = :h, hidden_by = :by, hidden_at = :t\",\n            ConditionExpression=\"attribute_exists(slug)\",\n            ExpressionAttributeValues={\":h\": True, \":by\": by, \":t\": int(self.clock())},\n        )\n\n    def feed(self, limit=FEED_LIMIT):\n        \"\"\"Public feed: newest first, hidden stories excluded, bodies left out.\"\"\"\n        resp = self.table.scan(ProjectionExpression=\"slug, title, hidden, published_at\")\n        items = [i for i in resp[\"Items\"] if not i.get(\"hidden\")]\n        items.sort(key=lambda i: i[\"published_at\"], reverse=True)\n        return [\n            {\"slug\": i[\"slug\"], \"title\": i[\"title\"], \"published_at\": i[\"published_at\"]}\n            for i in items[:limit]\n        ]\n\n    def archive(self, slug):\n        \"\"\"Editorial: take a published story out of circulation for good.\n        Not wired to the API yet (planned for the admin console).\"\"\"\n        self.table.update_item(\n            Key={\"slug\": slug},\n            UpdateExpression=\"SET archived_at = :t\",\n            ConditionExpression=\"status = :published\",\n            ExpressionAttributeValues={\":t\": int(self.clock()), \":published\": \"published\"},\n        )\n\"\"\"In-memory stand-in for a boto3 DynamoDB Table resource, for the tests.\n\nCovers put_item, get_item, update_item and scan, with the expression rules\nthat matter for this service. It mirrors DynamoDB's documented behaviour\nfor reserved words (the real service keeps a list of ~570 of them; RESERVED\nbelow is the subset that comes up in practice):\n\n  * a bare reserved word in an UpdateExpression, ConditionExpression or\n    FilterExpression raises ValidationException\n    (\"Attribute name is a reserved keyword\"), exactly like the real service;\n  * a bare reserved word in a ProjectionExpression does NOT raise: the\n    attribute is simply absent from the returned item, as on the real\n    service, and nothing in the response says so;\n  * '#alias' placeholders resolved through ExpressionAttributeNames work in\n    every expression, which is how DynamoDB tells you to spell any name.\n\nGrammar supported: `SET a = :v [, ...]` and `REMOVE a [, ...]` in updates;\n`=`, `<>`, `<`, `<=`, `>`, `>=`, attribute_exists(), attribute_not_exists(),\nNOT, AND, OR and parentheses in conditions and filters.\n\"\"\"\nimport copy\nimport re\n\nRESERVED = frozenset(\"\"\"\nADD AND ATTRIBUTE BINARY BY COMMENT COUNT DATA DATE DAY DELETE FALSE FROM GROUP HIDDEN HOUR\nIN INDEX ITEM ITEMS KEY KEYS LEVEL LIST MAP MINUTE MONTH NAME NOT NULL NUMBER OF ON OR ORDER\nPRIVATE PUBLIC QUERY REMOVE ROLE SCAN SECOND SELECT SET SIMILAR SIZE STATE STATUS STRING TABLE\nTEXT TIMESTAMP TO TRUE TYPE UPDATE URL USER VALUE VALUES YEAR\n\"\"\".split())\n\n_KEYWORDS = {\"SET\", \"REMOVE\", \"ADD\", \"DELETE\", \"AND\", \"OR\", \"NOT\", \"BETWEEN\", \"IN\"}\n_OPERATORS = {\"=\", \"<>\", \"<\", \"<=\", \">\", \">=\", \"(\", \")\", \",\"}\n_TOKEN = re.compile(r\"\\s*(#?[A-Za-z_][A-Za-z0-9_]*|:[A-Za-z_][A-Za-z0-9_]*|<>|<=|>=|[=<>(),])\")\n\n\nclass ClientError(Exception):\n    \"\"\"Same shape as botocore.exceptions.ClientError (.response[\"Error\"][\"Code\"]).\"\"\"\n\n    def __init__(self, code, message, operation):\n        super().__init__(f\"An error occurred ({code}) when calling the {operation} operation: {message}\")\n        self.response = {\"Error\": {\"Code\": code, \"Message\": message}}\n\n\ndef _tokens(expr):\n    out, pos = [], 0\n    while pos < len(expr):\n        m = _TOKEN.match(expr, pos)\n        if not m:\n            if expr[pos:].strip():\n                raise ValueError(f\"fake_dynamo cannot parse expression near: {expr[pos:]!r}\")\n            break\n        out.append(m.group(1)); pos = m.end()\n    return out\n\n\nclass _Names:\n    \"\"\"Resolves attribute names in one API call and enforces the reserved-word rules.\"\"\"\n\n    def __init__(self, mapping, operation):\n        self.mapping, self.operation, self.used = dict(mapping or {}), operation, set()\n\n    def _invalid(self, kind, msg):\n        raise ClientError(\"ValidationException\", f\"Invalid {kind}: {msg}\", self.operation)\n\n    def alias(self, kind, tok):\n        if tok not in self.mapping:\n            self._invalid(kind, f\"An expression attribute name used in the document path is not defined; attribute name: {tok}\")\n        self.used.add(tok)\n        return self.mapping[tok]\n\n    def validate(self, kind, expr):\n        \"\"\"Raise like DynamoDB does for a bare reserved word or an unknown #alias.\"\"\"\n        toks = _tokens(expr)\n        for i, t in enumerate(toks):\n            if t.startswith(\"#\"):\n                self.alias(kind, t)\n            elif t.startswith(\":\") or t in _OPERATORS or t.upper() in _KEYWORDS:\n                continue\n            elif i + 1 < len(toks) and toks[i + 1] == \"(\":\n                continue  # function call: attribute_exists(...), size(...)\n            elif t.upper() in RESERVED:\n                self._invalid(kind, f\"Attribute name is a reserved keyword; reserved keyword: {t}\")\n        return toks\n\n    def resolve(self, tok):\n        return self.mapping[tok] if tok.startswith(\"#\") else tok\n\n    def finish(self):\n        unused = sorted(set(self.mapping) - self.used)\n        if unused:\n            raise ClientError(\"ValidationException\", \"Value provided in ExpressionAttributeNames unused in \"\n                              f\"expressions: keys: {{{', '.join(unused)}}}\", self.operation)\n\n\ndef _evaluate(toks, item, names, values):\n    \"\"\"Evaluate a validated condition/filter expression against one item.\"\"\"\n    pos = [0]\n    peek = lambda: toks[pos[0]] if pos[0] < len(toks) else None  # noqa: E731\n\n    def take():\n        pos[0] += 1\n        return toks[pos[0] - 1]\n\n    def operand():\n        t = take()\n        return values[t] if t.startswith(\":\") else item.get(names.resolve(t))\n\n    def primary():\n        t = peek()\n        if t == \"(\":\n            take(); v = binary(\"OR\"); take()\n            return v\n        if t.upper() == \"NOT\":\n            take()\n            return not primary()\n        if t in (\"attribute_exists\", \"attribute_not_exists\"):\n            take(); take(); present = names.resolve(take()) in item; take()\n            return present if t == \"attribute_exists\" else not present\n        left = operand(); op = take(); right = operand()\n        if op in (\"=\", \"<>\"):\n            return (left == right) if op == \"=\" else (left != right)\n        if left is None or right is None:\n            return False\n        return {\"<\": left < right, \"<=\": left <= right, \">\": left > right, \">=\": left >= right}[op]\n\n    def binary(word):\n        sub = (lambda: binary(\"AND\")) if word == \"OR\" else primary\n        v = sub()\n        while peek() and peek().upper() == word:\n            take(); r = sub(); v = (v or r) if word == \"OR\" else (v and r)\n        return v\n\n    return binary(\"OR\")\n\n\nclass FakeTable:\n    def __init__(self, key=\"slug\"):\n        self.key, self._items = key, {}\n\n    def _check(self, op, expr, current, names, values):\n        if expr is not None and not _evaluate(names.validate(\"ConditionExpression\", expr), current, names, values or {}):\n            raise ClientError(\"ConditionalCheckFailedException\", \"The conditional request failed\", op)\n\n    def put_item(self, Item, ConditionExpression=None, ExpressionAttributeNames=None,\n                 ExpressionAttributeValues=None, **_ignored):\n        names = _Names(ExpressionAttributeNames, \"PutItem\")\n        self._check(\"PutItem\", ConditionExpression, self._items.get(Item[self.key], {}), names, ExpressionAttributeValues)\n        names.finish()\n        self._items[Item[self.key]] = copy.deepcopy(Item)\n        return {}\n\n    def get_item(self, Key, ProjectionExpression=None, ExpressionAttributeNames=None, **_ignored):\n        names = _Names(ExpressionAttributeNames, \"GetItem\")\n        item = self._items.get(Key[self.key])\n        if item is None:\n            return {}\n        item = self._project(copy.deepcopy(item), ProjectionExpression, names)\n        names.finish()\n        return {\"Item\": item}\n\n    def update_item(self, Key, UpdateExpression, ConditionExpression=None, ExpressionAttributeNames=None,\n                    ExpressionAttributeValues=None, ReturnValues=None, **_ignored):\n        names, values = _Names(ExpressionAttributeNames, \"UpdateItem\"), ExpressionAttributeValues or {}\n        toks = names.validate(\"UpdateExpression\", UpdateExpression)\n        current = self._items.get(Key[self.key], {})\n        self._check(\"UpdateItem\", ConditionExpression, current, names, values)\n        names.finish()\n        item = copy.deepcopy(current) or dict(Key)\n        clause, i = None, 0\n        while i < len(toks):\n            t = toks[i]\n            if t.upper() in (\"SET\", \"REMOVE\"):\n                clause = t.upper(); i += 1\n            elif t == \",\":\n                i += 1\n            elif clause == \"SET\" and i + 2 < len(toks) and toks[i + 1] == \"=\" and toks[i + 2].startswith(\":\"):\n                item[names.resolve(t)] = values[toks[i + 2]]; i += 3\n            elif clause == \"REMOVE\":\n                item.pop(names.resolve(t), None); i += 1\n            else:\n                names._invalid(\"UpdateExpression\", f\"fake_dynamo does not support this syntax near {t!r}\")\n        self._items[Key[self.key]] = item\n        return {\"Attributes\": copy.deepcopy(item)} if ReturnValues else {}\n\n    def scan(self, ProjectionExpression=None, FilterExpression=None, ExpressionAttributeNames=None,\n             ExpressionAttributeValues=None, **_ignored):\n        names = _Names(ExpressionAttributeNames, \"Scan\")\n        items = [copy.deepcopy(v) for v in self._items.values()]\n        scanned = len(items)\n        if FilterExpression:\n            toks = names.validate(\"FilterExpression\", FilterExpression)\n            items = [i for i in items if _evaluate(toks, i, names, ExpressionAttributeValues or {})]\n        items = [self._project(i, ProjectionExpression, names) for i in items]\n        names.finish()\n        return {\"Items\": items, \"Count\": len(items), \"ScannedCount\": scanned}\n\n    def _project(self, item, expr, names):\n        \"\"\"Reserved words used bare are dropped from the result without any error.\"\"\"\n        if not expr:\n            return item\n        out = {}\n        for path in [p.strip() for p in expr.split(\",\") if p.strip()]:\n            if path.startswith(\"#\"):\n                attr = names.alias(\"ProjectionExpression\", path)\n            elif path.upper() in RESERVED:\n                continue\n            else:\n                attr = path\n            if attr in item:\n                out[attr] = item[attr]\n        return out\nimport os\nimport sys\nimport unittest\n\nROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nsys.path.insert(0, ROOT)\n\nfrom src.app import StoryLibrary  # noqa: E402\nfrom tests.fake_dynamo import ClientError, FakeTable  # noqa: E402\n\n\nclass FeedTests(unittest.TestCase):\n    def setUp(self):\n        self.now = 1_700_000_000\n        self.lib = StoryLibrary(FakeTable(), clock=lambda: self.now)\n\n    def test_publish_then_feed_lists_it(self):\n        self.lib.publish(\"hello\", \"Hello\", \"first post\", \"ann\")\n        self.assertEqual([s[\"slug\"] for s in self.lib.feed()], [\"hello\"])\n\n    def test_feed_is_newest_first(self):\n        self.lib.publish(\"old\", \"Old\", \"...\", \"ann\")\n        self.now += 60\n        self.lib.publish(\"new\", \"New\", \"...\", \"bob\")\n        self.assertEqual([s[\"slug\"] for s in self.lib.feed()], [\"new\", \"old\"])\n\n    def test_feed_leaves_bodies_out(self):\n        self.lib.publish(\"hello\", \"Hello\", \"a long body\", \"ann\")\n        self.assertEqual(set(self.lib.feed()[0]), {\"slug\", \"title\", \"published_at\"})\n\n    def test_publish_twice_is_rejected(self):\n        self.lib.publish(\"hello\", \"Hello\", \"...\", \"ann\")\n        with self.assertRaises(ClientError) as cm:\n            self.lib.publish(\"hello\", \"Hello again\", \"...\", \"ann\")\n        self.assertEqual(cm.exception.response[\"Error\"][\"Code\"], \"ConditionalCheckFailedException\")\n\n    def test_rename(self):\n        self.lib.publish(\"hello\", \"Hello\", \"...\", \"ann\")\n        self.lib.rename(\"hello\", \"Hello, world\")\n        self.assertEqual(self.lib.get(\"hello\")[\"title\"], \"Hello, world\")\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n__pycache__/","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01DFC5vA5QgSZZruRKfdft2g","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
