{"event":"step_update","step_update":{"conversation_id":"de06cd8b-0dc0-418e-8764-ae470f05f94c","step_index":26,"state":"DONE","step_type":"tool","tool_name":"run_command","duration_seconds":0.631056,"tool_info":{"name":"run_command","parameters":{"CommandLine":"git diff"},"output":"Command exited with code 0.\n\nCommand output:\ndiff --git a/src/app.py b/src/app.py\r\nindex db49c5e..5931a84 100644\r\n--- a/src/app.py\r\n+++ b/src/app.py\r\n@@ -4,6 +4,7 @@ Each story is stored in one DynamoDB item together with the three most similar\r\n stories already in the library (``similar``), so the reader page can show\r\n \"related\" without a query at read time.\r\n \"\"\"\r\n+from decimal import Decimal\r\n import json\r\n import logging\r\n import re\r\n@@ -27,7 +28,7 @@ def similarity(a, b):\r\n     tag_score = len(ta \u0026 tb) / len(ta | tb) if (ta | tb) else 0\r\n     wa, wb = words(a.get(\"body\")), words(b.get(\"body\"))\r\n     word_score = len(wa \u0026 wb) / len(wa | wb) if (wa | wb) else 0\r\n-    return round(0.7 * tag_score + 0.3 * word_score, 4)\r\n+    return Decimal(str(round(0.7 * tag_score + 0.3 * word_score, 4)))\r\n \r\n \r\n def related(story, existing):\r\ndiff --git a/tests/test_publish.py b/tests/test_publish.py\r\nindex 6c9ac44..53ad34b 100644\r\n--- a/tests/test_publish.py\r\n+++ b/tests/test_publish.py\r\n@@ -1,3 +1,5 @@\r\n+from decimal import Decimal\r\n+import json\r\n import os\r\n import sys\r\n import unittest\r\n@@ -23,6 +25,56 @@ class PublishTest(unittest.TestCase):\r\n         self.assertEqual(table.get_item(Key={\"slug\": \"why-my-cron-ran-twice\"})[\"Item\"][\"title\"], \"Why my cron ran twice\")\r\n         self.assertEqual(table.scan()[\"Count\"], 1)\r\n \r\n+    def test_second_publish_computes_similar_with_decimal_score(self):\r\n+        table = FakeTable()\r\n+        story1 = {\r\n+            \"slug\": \"why-my-cron-ran-twice\",\r\n+            \"title\": \"Why my cron ran twice\",\r\n+            \"tags\": [\"cron\", \"linux\"],\r\n+            \"body\": \"Two crontabs, one for root and one for me, both had the line.\",\r\n+        }\r\n+        story2 = {\r\n+            \"slug\": \"cron-in-docker\",\r\n+            \"title\": \"Cron in Docker\",\r\n+            \"tags\": [\"cron\", \"docker\"],\r\n+            \"body\": \"Running cron inside a docker container on linux.\",\r\n+        }\r\n+        app.publish(table, story1)\r\n+        stored2 = app.publish(table, story2)\r\n+\r\n+        self.assertEqual(table.scan()[\"Count\"], 2)\r\n+        self.assertEqual(len(stored2[\"similar\"]), 1)\r\n+        self.assertEqual(stored2[\"similar\"][0][\"slug\"], \"why-my-cron-ran-twice\")\r\n+        score = stored2[\"similar\"][0][\"score\"]\r\n+        self.assertIsInstance(score, Decimal)\r\n+        self.assertGreater(score, Decimal(0))\r\n+\r\n+        item2 = table.get_item(Key={\"slug\": \"cron-in-docker\"})[\"Item\"]\r\n+        self.assertEqual(item2[\"similar\"][0][\"slug\"], \"why-my-cron-ran-twice\")\r\n+        self.assertIsInstance(item2[\"similar\"][0][\"score\"], Decimal)\r\n+\r\n+    def test_handler_sequential_publishes_return_201(self):\r\n+        table = FakeTable()\r\n+        story1 = {\r\n+            \"slug\": \"why-my-cron-ran-twice\",\r\n+            \"title\": \"Why my cron ran twice\",\r\n+            \"tags\": [\"cron\", \"linux\"],\r\n+            \"body\": \"Two crontabs, one for root and one for me, both had the line.\",\r\n+        }\r\n+        story2 = {\r\n+            \"slug\": \"another-story\",\r\n+            \"title\": \"Another Story\",\r\n+            \"tags\": [\"cron\"],\r\n+            \"body\": \"Another cron story.\",\r\n+        }\r\n+\r\n+        resp1 = app.handler({\"body\": json.dumps(story1)}, table)\r\n+        self.assertEqual(resp1[\"statusCode\"], 201)\r\n+\r\n+        resp2 = app.handler({\"body\": json.dumps(story2)}, table)\r\n+        self.assertEqual(resp2[\"statusCode\"], 201)\r\n+        self.assertEqual(json.loads(resp2[\"body\"]), {\"slug\": \"another-story\"})\r\n+\r\n \r\n if __name__ == \"__main__\":\r\n     unittest.main()\r\n"}}}
