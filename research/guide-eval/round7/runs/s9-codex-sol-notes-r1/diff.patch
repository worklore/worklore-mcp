+    def test_hide_withdraws_story_and_records_who_hid_it(self):
+        self.lib.publish("hello", "Hello", "...", "ann")
+        self.lib.hide("hello", by="ann")
+
+        self.assertEqual(self.lib.feed(), [])
+        self.assertEqual(self.lib.get("hello")["hidden"], True)
+        self.assertEqual(self.lib.get("hello")["hidden_by"], "ann")
+        self.assertEqual(self.lib.get("hello")["hidden_at"], self.now)
+
+    def test_feed_excludes_story_hidden_outside_library(self):
+        self.lib.publish("visible", "Visible", "...", "ann")
+        self.now += 60
+        self.lib.publish("hidden", "Hidden", "...", "bob")
+        self.lib.table.update_item(
+            Key={"slug": "hidden"},
+            UpdateExpression="SET #h = :true",
+            ExpressionAttributeNames={"#h": "hidden"},
+            ExpressionAttributeValues={":true": True},
+        )
+
+        self.assertEqual([s["slug"] for s in self.lib.feed()], ["visible"])
+
+    def test_archive_accepts_published_story(self):
+        self.lib.publish("hello", "Hello", "...", "ann")
+        self.lib.archive("hello")
+        self.assertEqual(self.lib.get("hello")["archived_at"], self.now)
