{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc 'cat README.md && cat src/app.py && rg -n . tests'","aggregated_output":"# stories-api\n\nA small story library behind `POST /stories` (Lambda + DynamoDB table `stories`,\npartition key `slug`). `src/app.py` is the whole service: `handler()` parses\nthe request and `publish()` stores the story together with its three most\nsimilar existing stories (`similar: [{slug, score}]`), so the reader page can\nshow \"related\" without any query at read time. `logs/error.log` is the\nproduction log from the first two publishes after the deploy.\n\nTests use an in-memory table (`tests/fake_dynamo.py`) that validates items the\nway boto3 does, so no AWS account is needed. Run them with\n`python3 -m unittest discover tests` from the repo root.\n\"\"\"Story library: the publish handler.\n\nEach story is stored in one DynamoDB item together with the three most similar\nstories already in the library (``similar``), so the reader page can show\n\"related\" without a query at read time.\n\"\"\"\nimport json\nimport logging\nimport re\nimport time\n\nlog = logging.getLogger(\"stories\")\n\nTABLE_NAME = \"stories\"\nTOP_N = 3\n\n_WORD = re.compile(r\"[a-z0-9]+\")\n\n\ndef words(text):\n    return set(_WORD.findall((text or \"\").lower()))\n\n\ndef similarity(a, b):\n    \"\"\"Shared-tag ratio (Jaccard), blended with shared words of the two bodies.\"\"\"\n    ta, tb = set(a.get(\"tags\", [])), set(b.get(\"tags\", []))\n    tag_score = len(ta & tb) / len(ta | tb) if (ta | tb) else 0\n    wa, wb = words(a.get(\"body\")), words(b.get(\"body\"))\n    word_score = len(wa & wb) / len(wa | wb) if (wa | wb) else 0\n    return round(0.7 * tag_score + 0.3 * word_score, 4)\n\n\ndef related(story, existing):\n    scored = []\n    for other in existing:\n        if other[\"slug\"] == story[\"slug\"]:\n            continue\n        scored.append({\"slug\": other[\"slug\"], \"score\": similarity(story, other)})\n    scored.sort(key=lambda s: s[\"score\"], reverse=True)\n    return scored[:TOP_N]\n\n\ndef validate(story):\n    for k in (\"slug\", \"title\", \"body\"):\n        if not story.get(k):\n            raise ValueError(f\"missing field: {k}\")\n    if not re.fullmatch(r\"[a-z0-9-]{3,80}\", story[\"slug\"]):\n        raise ValueError(\"bad slug\")\n\n\ndef publish(table, story):\n    \"\"\"Store ``story`` with its related stories. Returns the stored item.\"\"\"\n    validate(story)\n    existing = table.scan(TableName=TABLE_NAME).get(\"Items\", [])\n    item = {\n        \"slug\": story[\"slug\"],\n        \"title\": story[\"title\"],\n        \"tags\": sorted(set(story.get(\"tags\", []))),\n        \"body\": story[\"body\"],\n        \"published_at\": int(time.time()),\n        \"similar\": related(story, existing),\n    }\n    table.put_item(Item=item)\n    log.info(\"publish slug=%s similar=%d stored\", item[\"slug\"], len(item[\"similar\"]))\n    return item\n\n\ndef handler(event, table):\n    \"\"\"Lambda-style entry point for POST /stories. Body is the story as JSON.\"\"\"\n    try:\n        story = json.loads(event.get(\"body\") or \"{}\")\n        stored = publish(table, story)\n        return {\"statusCode\": 201, \"body\": json.dumps({\"slug\": stored[\"slug\"]})}\n    except ValueError as e:\n        return {\"statusCode\": 400, \"body\": json.dumps({\"error\": str(e)})}\n    except Exception:\n        log.exception(\"publish failed\")\n        return {\"statusCode\": 500, \"body\": json.dumps({\"error\": \"Internal Server Error\"})}\ntests/test_publish.py:1:import os\ntests/test_publish.py:2:import sys\ntests/test_publish.py:3:import unittest\ntests/test_publish.py:5:sys.path.insert(0, os.path.join(os.path.dirname(__file__), \"..\", \"src\"))\ntests/test_publish.py:6:sys.path.insert(0, os.path.dirname(__file__))\ntests/test_publish.py:8:import app  # noqa: E402\ntests/test_publish.py:9:from fake_dynamo import FakeTable  # noqa: E402\ntests/test_publish.py:12:class PublishTest(unittest.TestCase):\ntests/test_publish.py:13:    def test_publish_stores_story(self):\ntests/test_publish.py:14:        table = FakeTable()\ntests/test_publish.py:15:        story = {\ntests/test_publish.py:16:            \"slug\": \"why-my-cron-ran-twice\",\ntests/test_publish.py:17:            \"title\": \"Why my cron ran twice\",\ntests/test_publish.py:18:            \"tags\": [\"cron\", \"linux\"],\ntests/test_publish.py:19:            \"body\": \"Two crontabs, one for root and one for me, both had the line.\",\ntests/test_publish.py:20:        }\ntests/test_publish.py:21:        stored = app.publish(table, story)\ntests/test_publish.py:22:        self.assertEqual(stored[\"slug\"], \"why-my-cron-ran-twice\")\ntests/test_publish.py:23:        self.assertEqual(table.get_item(Key={\"slug\": \"why-my-cron-ran-twice\"})[\"Item\"][\"title\"], \"Why my cron ran twice\")\ntests/test_publish.py:24:        self.assertEqual(table.scan()[\"Count\"], 1)\ntests/test_publish.py:27:if __name__ == \"__main__\":\ntests/test_publish.py:28:    unittest.main()\ntests/fake_dynamo.py:1:\"\"\"In-memory stand-in for a boto3 DynamoDB Table resource.\ntests/fake_dynamo.py:3:It stores items in a dict and validates values the way boto3's TypeSerializer\ntests/fake_dynamo.py:4:does, so a test fails on the same inputs a real table would reject.\ntests/fake_dynamo.py:5:\"\"\"\ntests/fake_dynamo.py:6:from decimal import Decimal\ntests/fake_dynamo.py:9:def _check(value, path=\"Item\"):\ntests/fake_dynamo.py:10:    if isinstance(value, bool) or value is None or isinstance(value, (int, str, bytes, Decimal)):\ntests/fake_dynamo.py:11:        return\ntests/fake_dynamo.py:12:    if isinstance(value, float):\ntests/fake_dynamo.py:13:        raise TypeError(\"Float types are not supported. Use Decimal types instead.\")\ntests/fake_dynamo.py:14:    if isinstance(value, dict):\ntests/fake_dynamo.py:15:        for k, v in value.items():\ntests/fake_dynamo.py:16:            _check(v, f\"{path}.{k}\")\ntests/fake_dynamo.py:17:        return\ntests/fake_dynamo.py:18:    if isinstance(value, (list, tuple, set, frozenset)):\ntests/fake_dynamo.py:19:        for i, v in enumerate(value):\ntests/fake_dynamo.py:20:            _check(v, f\"{path}[{i}]\")\ntests/fake_dynamo.py:21:        return\ntests/fake_dynamo.py:22:    raise TypeError(f\"Unsupported type {type(value)!r} for value at {path}\")\ntests/fake_dynamo.py:25:class FakeTable:\ntests/fake_dynamo.py:26:    def __init__(self, key=\"slug\"):\ntests/fake_dynamo.py:27:        self.key = key\ntests/fake_dynamo.py:28:        self.items = {}\ntests/fake_dynamo.py:30:    def put_item(self, Item, **kwargs):\ntests/fake_dynamo.py:31:        _check(Item)\ntests/fake_dynamo.py:32:        if self.key not in Item:\ntests/fake_dynamo.py:33:            raise ValueError(f\"item is missing the key attribute {self.key!r}\")\ntests/fake_dynamo.py:34:        self.items[Item[self.key]] = dict(Item)\ntests/fake_dynamo.py:35:        return {\"ResponseMetadata\": {\"HTTPStatusCode\": 200}}\ntests/fake_dynamo.py:37:    def get_item(self, Key, **kwargs):\ntests/fake_dynamo.py:38:        item = self.items.get(Key[self.key])\ntests/fake_dynamo.py:39:        return {\"Item\": dict(item)} if item is not None else {}\ntests/fake_dynamo.py:41:    def scan(self, **kwargs):\ntests/fake_dynamo.py:42:        return {\"Items\": [dict(v) for v in self.items.values()], \"Count\": len(self.items)}\n","exit_code":0,"status":"completed"}}
