{"event":"step_update","step_update":{"conversation_id":"4a756549-e055-4e9c-9194-e8ba51d26c34","step_index":33,"state":"DONE","step_type":"tool","tool_name":"run_command","duration_seconds":0.107413,"tool_info":{"name":"run_command","parameters":{"CommandLine":"git diff tests/test_api.py"},"output":"Command exited with code 0.\n\nCommand output:\ndiff --git a/tests/test_api.py b/tests/test_api.py\r\nindex 1380af5..1548938 100644\r\n--- a/tests/test_api.py\r\n+++ b/tests/test_api.py\r\n@@ -10,6 +10,7 @@ sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))\r\n import api  # noqa: E402\r\n \r\n ALICE = \"tok_alice_4f8c2e71b0\"\r\n+BOB = \"tok_bob_9a1d7c3e55\"\r\n \r\n \r\n class ApiTest(unittest.TestCase):\r\n@@ -67,6 +68,38 @@ class ApiTest(unittest.TestCase):\r\n         self.assertEqual(self.call(\"POST\", \"/tasks\", {\"visibility\": \"public\"})[0], 400)\r\n         self.assertEqual(self.call(\"GET\", \"/nope\")[0], 404)\r\n \r\n+    def test_private_task_authorization(self):\r\n+        # Alice's private task #1 should not appear in Bob's task list\r\n+        code, bob_tasks = self.call(\"GET\", \"/tasks\", token=BOB)\r\n+        self.assertEqual(code, 200)\r\n+        self.assertNotIn(1, [t[\"id\"] for t in bob_tasks[\"tasks\"]])\r\n+\r\n+        # Bob attempts all actions on Alice's private task #1\r\n+        self.assertEqual(self.call(\"GET\", \"/tasks/1\", token=BOB)[0], 403)\r\n+        self.assertEqual(self.call(\"PATCH\", \"/tasks/1\", {\"title\": \"Hacked\"}, token=BOB)[0], 403)\r\n+        self.assertEqual(self.call(\"DELETE\", \"/tasks/1\", token=BOB)[0], 403)\r\n+        self.assertEqual(self.call(\"POST\", \"/tasks/1/comments\", {\"text\": \"hello\"}, token=BOB)[0], 403)\r\n+        self.assertEqual(self.call(\"POST\", \"/tasks/1/complete\", token=BOB)[0], 403)\r\n+        self.assertEqual(self.call(\"POST\", \"/tasks/1/nudge\", token=BOB)[0], 403)\r\n+        self.assertEqual(self.call(\"POST\", \"/tasks/1/like\", token=BOB)[0], 403)\r\n+        self.assertEqual(self.call(\"POST\", \"/tasks/1/view\", token=BOB)[0], 403)\r\n+\r\n+        # Confirm Alice's private task was untouched\r\n+        code, alice_task = self.call(\"GET\", \"/tasks/1\", token=ALICE)\r\n+        self.assertEqual(code, 200)\r\n+        self.assertEqual(alice_task[\"likes\"], 0)\r\n+        self.assertEqual(alice_task[\"views\"], 0)\r\n+        self.assertEqual(alice_task[\"nudges\"], 0)\r\n+        self.assertFalse(alice_task[\"done\"])\r\n+        self.assertEqual(len(alice_task[\"comments\"]), 0)\r\n+\r\n+        # Owner Alice can still like and view her private task\r\n+        self.assertEqual(self.call(\"POST\", \"/tasks/1/like\", token=ALICE)[0], 200)\r\n+        self.assertEqual(self.call(\"POST\", \"/tasks/1/view\", token=ALICE)[0], 200)\r\n+        code, alice_task = self.call(\"GET\", \"/tasks/1\", token=ALICE)\r\n+        self.assertEqual(alice_task[\"likes\"], 1)\r\n+        self.assertEqual(alice_task[\"views\"], 1)\r\n+\r\n \r\n if __name__ == \"__main__\":\r\n     unittest.main()\r\n"}}}
