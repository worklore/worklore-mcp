          \"author\": author,\n                \"published_at\": int(self.clock()),\n                \"status\": \"published\",\n            },\n            ConditionExpression=\"attribute_not_exists(slug)\",\n        )\n\n    def get(self, slug):\n        return self.table.get_item(Key={\"slug\": slug}).get(\"Item\")\n\n    def rename(self, slug, title):\n        self.table.update_item(\n            Key={\"slug\": slug},\n            UpdateExpression=\"SET title = :t\",\n            ConditionExpression=\"attribute_exists(slug)\",\n            ExpressionAttributeValues={\":t\": title},\n        )\n\n    def hide(self, slug, by):\n        \"\"\"Author withdraws a story: it stays in the table but leaves the feed.\"\"\"\n        self.table.update_item(\n            Key={\"slug\": slug},\n            UpdateExpression=\"SET hidden = :h, hidden_by = :by, hidden_at = :t\",\n            ConditionExpression=\"attribute_exists(slug)\",\n            ExpressionAttributeValues={\":h\": True, \":by\": by, \":t\": int(self.clock())},\n        )\n\n    def feed(self, limit=FEED_LIMIT):\n        \"\"\"Public feed: newest first, hidden stories excluded, bodies left out.\"\"\"\n        resp = self.table.scan(ProjectionExpression=\"slug, title, hidden, published_at\")\n        items = [i for i in resp[\"Items\"] if not i.get(\"hidden\")]\n        items.sort(key=lambda i: i[\"published_at\"], reverse=True)\n        return [\n            {\"slug\": i[\"slug\"], \"title\": i[\"title\"], \"published_at\": i[\"published_at\"]}\n            for i in items[:limit]\n        ]\n\n    def archive(self, slug):\n        \"\"\"Editorial: take a published story out of circulation for good.\n        Not wired to the API yet (planned for the admin console).\"\"\"\n        self.table.update_item(\n            Key={\"slug\": slug},\n            UpdateExpression=\"SET archived_at = :t\",\n            ConditionExpression=\"status = :published\",\n            ExpressionAttributeValues={\":t\": int(self.clock()), \":published\": \"published\"},\n        )\nimport os\nimport sys\nimport unittest\n\nROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nsys.path.insert(0, ROOT)\n\nfrom src.app import StoryLibrary  # noqa: E402\nfrom tests.fake_dynamo import ClientError, FakeTable  # noqa: E402\n\n\nclass FeedTests(unittest.TestCase):\n    def setUp(self):\n        self.now = 1_700_000_000\n        self.lib = StoryLibrary(FakeTable(), clock=lambda: self.now)\n\n    def test_publish_then_feed_lists_it(self):\n        self.lib.publish(\"hello\", \"Hello\", \"first post\", \"ann\")\n        self.assertEqual([s[\"slug\"] for s in self.lib.feed()], [\"hello\"])\n\n    def test_feed_is_newest_first(self):\n        self.lib.publish(\"old\", \"Old\", \"...\", \"ann\")\n        self.now += 60\n        self.lib.publish(\"new\", \"New\", \"...\", \"bob\")\n        self.assertEqual([s[\"slug\"] for s in self.lib.feed()], [\"new\", \"old\"])\n\n    def test_feed_leaves_bodies_out(self):\n        self.lib.publish(\"hello\", \"Hello\", \"a long body\", \"ann\")\n        self.assertEqual(set(self.lib.feed()[0]), {\"slug\", \"title\", \"published_at\"})\n\n    def test_publish_twice_is_rejected(self):\n        self.lib.publish(\"hello\", \"Hello\", \"...\", \"ann\")\n        with self.assertRaises(ClientError) as cm:\n            self.lib.publish(\"hello\", \"Hello again\", \"...\", \"ann\")\n        self.assertEqual(cm.exception.response[\"Error\"][\"Code\"], \"ConditionalCheckFailedException\")\n\n    def test_rename(self):\n        self.lib.publish(\"hello\", \"Hello\", \"...\", \"ann\")\n        self.lib.rename(\"hello\", \"Hello, world\")\n        self.assertEqual(self.lib.get(\"hello\")[\"title\"], \"Hello, world\")\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n211 tests/fake_dynamo.py","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01UV52gvQ5Fg4tzTDuMFAyYS","permission_decision":{"decision":"accept"