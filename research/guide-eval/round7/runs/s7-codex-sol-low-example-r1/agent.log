{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport io, json, threading, urllib.error, urllib.parse, urllib.request\nfrom http.server import ThreadingHTTPServer\nimport config, server\n\nhttpd = ThreadingHTTPServer(('127.0.0.1', 0), server.Handler)\nthread = threading.Thread(target=httpd.serve_forever, daemon=True)\nthread.start()\nbase = f'http://127.0.0.1:{httpd.server_port}'\ntry:\n    try:\n        urllib.request.urlopen(base + '/api/intervals/auth/init')\n        raise AssertionError('GET init should fail')\n    except urllib.error.HTTPError as e:\n        assert e.code == 404\n    req = urllib.request.Request(base + '/api/intervals/auth/init', data=b'', headers={'Authorization':'Bearer tok-okafor'}, method='POST')\n    with urllib.request.urlopen(req) as r:\n        url = json.load(r)['authorize_url']\n    params = urllib.parse.parse_qs(urllib.parse.urlsplit(url).query)\n    assert params['scope'] == ['ACTIVITY:WRITE,WELLNESS:READ,CALENDAR:WRITE']\n    assert server.verify_state(params['state'][0]) == 'u_okafor'\n    assert server.verify_state(params['state'][0] + 'x') is None\n    server.store_connection('u_okafor', {'access_token':'test', 'athlete':{'id':'i1','name':'A'},'scope':config.SCOPES})\n    assert server.CONNECTIONS['u_okafor']['status'] == 'connected'\n    assert 'expires_at' not in server.CONNECTIONS['u_okafor']\n    try:\n        server.store_connection('u_okafor', {'access_token':'other', 'athlete':{'id':'i2'}})\n        raise AssertionError('mismatch should fail')\n    except ValueError:\n        pass\n    assert server.CONNECTIONS['u_okafor']['access_token'] == 'test'\n    print('local flow checks passed')\nfinally:\n    httpd.shutdown()\n    httpd.server_close()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
