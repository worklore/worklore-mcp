{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc 'git diff --check && git status --short && git diff -- src/app.py tests/test_publish.py && cat ANSWER.md'","aggregated_output":" M src/app.py\n M tests/test_publish.py\n?? ANSWER.md\ndiff --git a/src/app.py b/src/app.py\nindex db49c5e..d2efa93 100644\n--- a/src/app.py\n+++ b/src/app.py\n@@ -8,6 +8,7 @@ import json\n import logging\n import re\n import time\n+from decimal import Decimal\n \n log = logging.getLogger(\"stories\")\n \n@@ -35,7 +36,8 @@ def related(story, existing):\n     for other in existing:\n         if other[\"slug\"] == story[\"slug\"]:\n             continue\n-        scored.append({\"slug\": other[\"slug\"], \"score\": similarity(story, other)})\n+        # DynamoDB rejects Python floats, including floats nested inside lists.\n+        scored.append({\"slug\": other[\"slug\"], \"score\": Decimal(str(similarity(story, other)))})\n     scored.sort(key=lambda s: s[\"score\"], reverse=True)\n     return scored[:TOP_N]\n \ndiff --git a/tests/test_publish.py b/tests/test_publish.py\nindex 6c9ac44..19729fe 100644\n--- a/tests/test_publish.py\n+++ b/tests/test_publish.py\n@@ -1,6 +1,8 @@\n+import json\n import os\n import sys\n import unittest\n+from decimal import Decimal\n \n sys.path.insert(0, os.path.join(os.path.dirname(__file__), \"..\", \"src\"))\n sys.path.insert(0, os.path.dirname(__file__))\n@@ -23,6 +25,31 @@ class PublishTest(unittest.TestCase):\n         self.assertEqual(table.get_item(Key={\"slug\": \"why-my-cron-ran-twice\"})[\"Item\"][\"title\"], \"Why my cron ran twice\")\n         self.assertEqual(table.scan()[\"Count\"], 1)\n \n+    def test_publish_into_populated_table_stores_dynamodb_compatible_scores(self):\n+        table = FakeTable()\n+        first = {\n+            \"slug\": \"why-my-cron-ran-twice\",\n+            \"title\": \"Why my cron ran twice\",\n+            \"tags\": [\"cron\", \"linux\"],\n+            \"body\": \"Two crontabs ran the same job.\",\n+        }\n+        second = {\n+            \"slug\": \"debugging-a-cron-job\",\n+            \"title\": \"Debugging a cron job\",\n+            \"tags\": [\"cron\", \"debugging\"],\n+            \"body\": \"The same job ran twice.\",\n+        }\n+\n+        self.assertEqual(app.handler({\"body\": json.dumps(first)}, table)[\"statusCode\"], 201)\n+        self.assertEqual(app.handler({\"body\": json.dumps(second)}, table)[\"statusCode\"], 201)\n+\n+        stored = table.get_item(Key={\"slug\": second[\"slug\"]})[\"Item\"]\n+        self.assertEqual(table.scan()[\"Count\"], 2)\n+        self.assertEqual(stored[\"similar\"][0][\"slug\"], first[\"slug\"])\n+        self.assertIsInstance(stored[\"similar\"][0][\"score\"], Decimal)\n+        self.assertGreater(stored[\"similar\"][0][\"score\"], 0)\n+        self.assertLessEqual(stored[\"similar\"][0][\"score\"], 1)\n+\n \n if __name__ == \"__main__\":\n     unittest.main()\n# Cause\n\nThe first publish finds no existing stories, so `similar` is empty and the item contains no similarity scores. On the second publish, `related()` adds a score returned by `similarity()`. That score is a Python `float` nested in `similar`. Boto3's DynamoDB serializer rejects floats, so `put_item` raises `TypeError` and the handler returns 500.\n\n# Fix\n\nConvert each computed score to `Decimal` before adding it to the item. This preserves the existing 0–1 score and four-decimal-place rounding while giving DynamoDB a supported numeric type. A regression test publishes two stories through the handler against the validating fake table, checks that both requests return 201, and confirms the second item's stored score is a `Decimal`. The test reproduced the 500 before the fix.\n","exit_code":0,"status":"completed"}}
