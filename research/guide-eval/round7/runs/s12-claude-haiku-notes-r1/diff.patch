+    def test_stranger_cannot_touch_private_task(self):
+        bob = "tok_bob_9a1d7c3e55"
+        self.assertEqual(self.call("GET", "/tasks/1", token=bob)[0], 403)
+        self.assertEqual(self.call("PATCH", "/tasks/1", {"title": "x"}, token=bob)[0], 403)
+        self.assertEqual(self.call("DELETE", "/tasks/1", token=bob)[0], 403)
+        self.assertEqual(self.call("POST", "/tasks/1/comments", {"text": "hi"}, token=bob)[0], 403)
+        self.assertEqual(self.call("POST", "/tasks/1/complete", token=bob)[0], 403)
+        self.assertEqual(self.call("POST", "/tasks/1/nudge", token=bob)[0], 403)
+        self.assertEqual(self.call("POST", "/tasks/1/like", token=bob)[0], 403)
+        self.assertEqual(self.call("POST", "/tasks/1/view", token=bob)[0], 403)
+        # the owner's counters were not touched by the stranger's attempts
+        code, task = self.call("GET", "/tasks/1")
+        self.assertEqual((code, task["likes"], task["views"], task["nudges"]), (200, 0, 0, 0))
+
+    def test_stranger_can_like_and_view_public_task(self):
+        bob = "tok_bob_9a1d7c3e55"
+        self.assertEqual(self.call("POST", "/tasks/2/like", token=bob)[1]["likes"], 1)
+        self.assertEqual(self.call("POST", "/tasks/2/view", token=bob)[1]["views"], 1)
