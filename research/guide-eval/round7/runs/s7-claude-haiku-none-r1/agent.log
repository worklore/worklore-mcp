ow + int(tok[\"expires_in\"]))\n                    log(f\"{uid}: token refreshed\")\n                except Exception as e:\n                    log(f\"{uid}: refresh failed ({e}) -> expired, reconnect\")\n                    c.update(status=\"expired, reconnect\", access_token=None)","new_string":"def store_connection(user_id, tok):\n    # Intervals only sends expires_in / refresh_token when the grant has them. A missing\n    # expires_in means \"no stated lifetime\", not \"one hour\"; the old default expired\n    # the onboarding connection an hour in.\n    expires_in = tok.get(\"expires_in\")\n    expires_at = time.time() + int(expires_in) if expires_in else None\n    refresh = tok.get(\"refresh_token\")\n    athlete = tok.get(\"athlete\") or {}\n    with LOCK:\n        CONNECTIONS[user_id] = {\n            \"athlete_id\": athlete.get(\"id\"), \"athlete_name\": athlete.get(\"name\"),\n            \"access_token\": tok[\"access_token\"], \"refresh_token\": refresh,\n            \"scope\": tok.get(\"scope\"), \"expires_at\": expires_at, \"status\": \"connected\",\n        }\n    lifetime = f\"expires in {expires_in}s\" if expires_at else \"no expiry given\"\n    log(f\"{user_id}: connected as athlete {athlete.get('id')} ({lifetime}, refresh_token={'yes' if refresh else 'no'})\")\n\n\ndef refresh_tokens():\n    \"\"\"Background pass: renew access tokens shortly before they expire.\"\"\"\n    while True:\n        time.sleep(config.REFRESH_INTERVAL)\n        now = time.time()\n        # Pick the work under the lock, then do the network calls outside it so a slow\n        # Intervals response does not block every request handler.\n        with LOCK:\n            due = [(uid, dict(c)) for uid, c in CONNECTIONS.items()\n                   if c[\"status\"] == \"connected\" and c[\"expires_at\"] is not None\n                   and c[\"expires_at\"] - now <= 300]\n        for uid, c in due:\n            if not c[\"refresh_token\"]:\n                log(f\"{uid}: token expiry passed and no refresh token on file -> expired, reconnect\")\n                _set_status(uid, \"expired, reconnect\", access_token=None)\n                continue\n            try:\n                tok = post_form(TOKEN_URL, {\n                    \"grant_type\": \"refresh_token\", \"refresh_token\": c[\"refresh_token\"],\n                    \"client_id\": config.CLIENT_ID, \"client_secret\": config.CLIENT_SECRET,\n                })\n                expires_in = tok.get(\"expires_in\")\n                _set_status(uid, \"connected\", access_token=tok[\"access_token\"],\n                            refresh_token=tok.get(\"refresh_token\", c[\"refresh_token\"]),\n                            expires_at=now + int(expires_in) if expires_in else None)\n                log(f\"{uid}: token refreshed\")\n            except Exception as e:\n                log(f\"{uid}: refresh failed ({e}) -> expired, reconnect\")\n                _set_status(uid, \"expired, reconnect\", access_token=None)\n\n\ndef _set_status(uid, status, **fields):\n    with LOCK:\n        if uid in CONNECTIONS:\n            CONNECTIONS[uid].update(status=status, **fields)"}}}
