           tok = post_form(TOKEN_URL, {","+                    \"grant_type\": \"refresh_token\", \"refresh_token\": c[\"refresh_token\"],","+                    \"client_id\": config.CLIENT_ID, \"client_secret\": config.CLIENT_SECRET,","+                })","+                expires_in = tok.get(\"expires_in\")","+                _set_status(uid, \"connected\", access_token=tok[\"access_token\"],","+                            refresh_token=tok.get(\"refresh_token\", c[\"refresh_token\"]),","+                            expires_at=now + int(expires_in) if expires_in else None)","+                log(f\"{uid}: token refreshed\")","+            except Exception as e:","+                log(f\"{uid}: refresh failed ({e}) -> expired, reconnect\")","+                _set_status(uid, \"expired, reconnect\", access_token=None)"," "," ","+def _set_status(uid, status, **fields):","+    with LOCK:","+        if uid in CONNECTIONS:","+            CONNECTIONS[uid].update(status=status, **fields)","+","+"," def intervals_get(conn, path):","     req = urllib.request.Request(f\"{config.INTERVALS_BASE}/api/v1/athlete/{conn['athlete_id']}{path}\",","                                  headers={\"Authorization\": \"Bearer \" + conn[\"access_token\"]})"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"tool_result_meta":[{"id":"toolu_013WnykdQPmmL1VEeBkgXHMA","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
