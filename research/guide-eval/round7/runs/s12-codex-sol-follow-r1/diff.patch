+    def test_other_user_cannot_access_or_change_private_task(self):
+        _, before = self.call("GET", "/tasks/1", token=ALICE)
+        bob_tasks = self.call("GET", "/tasks", token=BOB)[1]["tasks"]
+        self.assertNotIn(1, [task["id"] for task in bob_tasks])
+
+        attempts = [
+            ("GET", "/tasks/1", None),
+            ("PATCH", "/tasks/1", {"title": "Changed", "visibility": "public"}),
+            ("DELETE", "/tasks/1", None),
+            ("POST", "/tasks/1/comments", {"text": "Hello"}),
+            ("POST", "/tasks/1/complete", None),
+            ("POST", "/tasks/1/nudge", None),
+            ("POST", "/tasks/1/like", None),
+            ("POST", "/tasks/1/view", None),
+        ]
+        for method, path, body in attempts:
+            with self.subTest(method=method, path=path):
+                self.assertEqual(self.call(method, path, body, token=BOB)[0], 403)
+
+        self.assertEqual(self.call("GET", "/tasks/1", token=ALICE), (200, before))
+
+    def test_other_user_can_use_public_social_actions(self):
+        self.assertEqual(self.call("GET", "/tasks/2", token=BOB)[0], 200)
+        self.assertEqual(self.call("POST", "/tasks/2/comments", {"text": "Hello"}, token=BOB)[0], 201)
+        for action, field in (("nudge", "nudges"), ("like", "likes"), ("view", "views")):
+            with self.subTest(action=action):
+                code, body = self.call("POST", "/tasks/2/" + action, token=BOB)
+                self.assertEqual((code, body[field]), (200, 1))
+        self.assertEqual(self.call("PATCH", "/tasks/2", {"title": "Changed"}, token=BOB)[0], 403)
+        self.assertEqual(self.call("POST", "/tasks/2/complete", token=BOB)[0], 403)
+        self.assertEqual(self.call("DELETE", "/tasks/2", token=BOB)[0], 403)
+
