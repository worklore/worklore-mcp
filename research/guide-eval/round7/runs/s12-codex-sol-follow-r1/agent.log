alice','GET',path))\nprint('alice cleanup',*call('alice','DELETE',path))\nprint('cleanup confirmed',*call('alice','GET',path))\nPY\"","aggregated_output":"unknown route 404 {'error': 'no such route'}\nmissing token 401 {'error': 'missing or unknown bearer token'}\nmalformed JSON 400 {'error': 'body is not valid JSON'}\ninjection path 404 {'error': 'no such route'}\ninjection query 200 {'tasks': [{'id': 1, 'owner': 'alice', 'title': 'Draft the investor update', 'visibility': 'private', 'done': False, 'likes': 0, 'views': 0, 'nudges': 0, 'comments': []}, {'id': 2, 'owner': 'alice', 'title': 'Water the office plants', 'visibility': 'public', 'done': False, 'likes': 0, 'views': 0, 'nudges': 0, 'comments': []}, {'id': 3, 'owner': 'bob', 'title': 'Book the team lunch', 'visibility': 'public', 'done': False, 'likes': 0, 'views': 0, 'nudges': 0, 'comments': []}]}\ncreate with forbidden fields 201 {'id': 4, 'owner': 'alice', 'title': 'Authorization probe', 'visibility': 'private', 'done': False, 'likes': 0, 'views': 0, 'nudges': 0, 'comments': []}\nbob list contains private task False\nbob read 403 {'error': 'forbidden'}\nbob edit 403 {'error': 'only the owner may edit a task'}\nbob delete 403 {'error': 'only the owner may delete a task'}\nbob comment 403 {'error': 'forbidden'}\nbob complete 403 {'error': 'only the owner may complete a task'}\nbob nudge 403 {'error': 'forbidden'}\nbob like 200 {'id': 4, 'likes': 1}\nbob view 200 {'id': 4, 'views': 1}\nalice after bob actions 200 {'id': 4, 'owner': 'alice', 'title': 'Authorization probe', 'visibility': 'private', 'done': False, 'likes': 1, 'views': 1, 'nudges': 0, 'comments': []}\nalice cleanup 200 {'deleted': 4}\ncleanup confirmed 404 {'error': 'no such task'}\n","exit_code":0,"status":"completed"}}
