{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport json, urllib.request, urllib.error\nbase='http://127.0.0.1:62540'\ntokens={'alice':'tok_alice_4f8c2e71b0','bob':'tok_bob_9a1d7c3e55'}\ndef call(who, method, path, payload=None, raw=None):\n    data=raw if raw is not None else (json.dumps(payload).encode() if payload is not None else None)\n    req=urllib.request.Request(base+path,data=data,method=method)\n    if who: req.add_header('Authorization','Bearer '+tokens[who])\n    if data is not None: req.add_header('Content-Type','application/json')\n    try:\n        with urllib.request.urlopen(req) as resp: return resp.status,json.loads(resp.read())\n    except urllib.error.HTTPError as err: return err.code,json.loads(err.read())\nfor label,who,method,path,kw in [\n    ('unknown route','alice','GET','/nope',{}),\n    ('missing token',None,'GET','/tasks',{}),\n    ('malformed JSON','alice','POST','/tasks',{'raw':b'{bad'}),\n    ('injection path','alice','GET','/tasks/1%20OR%201=1',{}),\n    ('injection query','alice','GET',\\\"/tasks?id=1%20OR%201=1\\\",{}),\n]: print(label,*call(who,method,path,**kw))\ncode,t=call('alice','POST','/tasks',{'title':'Authorization probe','visibility':'private','owner':'bob','done':True,'likes':99,'views':99})\nprint('create with forbidden fields',code,t)\ntid=t['id']; path=f'/tasks/{tid}'\nprint('bob list contains private task',any(x['id']==tid for x in call('bob','GET','/tasks')[1]['tasks']))\nfor label,method,suffix,payload in [\n    ('read','GET','',None),('edit','PATCH','',{'title':'Changed by Bob','owner':'bob','visibility':'public'}),\n    ('delete','DELETE','',None),('comment','POST','/comments',{'text':'Bob was here'}),\n    ('complete','POST','/complete',None),('nudge','POST','/nudge',None),\n    ('like','POST','/like',None),('view','POST','/view',None),\n]: print('bob '+label,*call('bob',method,path+suffix,payload))\nprint('alice after bob actions',*call('alice','GET',path))\nprint('alice cleanup',*call('alice','DELETE',path))\nprint('cleanup confirmed',*call('alice','GET',path))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
