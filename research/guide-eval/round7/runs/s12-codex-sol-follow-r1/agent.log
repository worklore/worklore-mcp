  (\"PATCH\", \"/tasks/1\", {\"title\": \"Changed\", \"visibility\": \"public\"}),\n+            (\"DELETE\", \"/tasks/1\", None),\n+            (\"POST\", \"/tasks/1/comments\", {\"text\": \"Hello\"}),\n+            (\"POST\", \"/tasks/1/complete\", None),\n+            (\"POST\", \"/tasks/1/nudge\", None),\n+            (\"POST\", \"/tasks/1/like\", None),\n+            (\"POST\", \"/tasks/1/view\", None),\n+        ]\n+        for method, path, body in attempts:\n+            with self.subTest(method=method, path=path):\n+                self.assertEqual(self.call(method, path, body, token=BOB)[0], 403)\n+\n+        self.assertEqual(self.call(\"GET\", \"/tasks/1\", token=ALICE), (200, before))\n+\n+    def test_other_user_can_use_public_social_actions(self):\n+        self.assertEqual(self.call(\"GET\", \"/tasks/2\", token=BOB)[0], 200)\n+        self.assertEqual(self.call(\"POST\", \"/tasks/2/comments\", {\"text\": \"Hello\"}, token=BOB)[0], 201)\n+        for action, field in ((\"nudge\", \"nudges\"), (\"like\", \"likes\"), (\"view\", \"views\")):\n+            with self.subTest(action=action):\n+                code, body = self.call(\"POST\", \"/tasks/2/\" + action, token=BOB)\n+                self.assertEqual((code, body[field]), (200, 1))\n+        self.assertEqual(self.call(\"PATCH\", \"/tasks/2\", {\"title\": \"Changed\"}, token=BOB)[0], 403)\n+        self.assertEqual(self.call(\"POST\", \"/tasks/2/complete\", token=BOB)[0], 403)\n+        self.assertEqual(self.call(\"DELETE\", \"/tasks/2\", token=BOB)[0], 403)\n+\n     def test_bad_input(self):\n         self.assertEqual(self.call(\"POST\", \"/tasks\", {\"visibility\": \"public\"})[0], 400)\n         self.assertEqual(self.call(\"GET\", \"/nope\")[0], 404)\n","exit_code":0,"status":"completed"}}
