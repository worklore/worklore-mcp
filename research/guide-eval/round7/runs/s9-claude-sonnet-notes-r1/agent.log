{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CgENBNiLGWHTckHeuJTn8","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01RstVQnVDgcJxF5NZuJp1Kf","name":"Bash","input":{"command":"cd /private/tmp/h-lTauJ0; cat src/app.py tests/test_feed.py README.md notes/dynamodb*; grep -n -i \"hidden\\|reserved\" tests/fake_dynamo.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1362,"cache_read_input_tokens":20391,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1362},"output_tokens":16,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"78fac348-c6ac-44b4-b333-35e870923888","uuid":"e5e121d2-109a-4478-8765-670149b1fc7b","timestamp":"2026-10-20T23:35:21.500Z","request_id":"req_011CgENBNSxpMz2tLiC96KnX","wire_tool_inputs":{"toolu_01RstVQnVDgcJxF5NZuJp1Kf":{"command":"cd /private/tmp/h-lTauJ0; cat src/app.py tests/test_feed.py README.md notes/dynamodb*; grep -n -i \"hidden\\|reserved\" tests/fake_dynamo.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RstVQnVDgcJxF5NZuJp1Kf","type":"tool_result","content":"\"\"\"storylib - the story library behind the public feed.\n\nThree operations: publish a story, hide one (the author withdraws it) and\nlist the public feed. Storage is a single DynamoDB table keyed by `slug`.\nThis module only talks to a boto3 Table resource; the tests hand it\ntests/fake_dynamo.FakeTable instead, and the HTTP handlers (api.py, in the\ninfra repo) hand it dynamo_table().\n\"\"\"\nimport os\nimport time\n\n\ndef dynamo_table():\n    \"\"\"The real table. boto3 is only installed on the servers.\"\"\"\n    import boto3\n    return boto3.resource(\"dynamodb\").Table(os.environ.get(\"STORIES_TABLE\", \"stories\"))\n\n\nclass StoryLibrary:\n    FEED_LIMIT = 50\n\n    def __init__(self, table, clock=time.time):\n        self.table = table\n        self.clock = clock\n\n    def publish(self, slug, title, body, author):\n        \"\"\"Create a story. Refuses to overwrite an existing slug.\"\"\"\n        self.table.put_item(\n            Item={\n                \"slug\": slug,\n                \"title\": title,\n                \"body\": body,\n                \"author\": author,\n                \"published_at\": int(self.clock()),\n                \"status\": \"published\",\n            },\n            ConditionExpression=\"attribute_not_exists(slug)\",\n        )\n\n    def get(self, slug):\n        return self.table.get_item(Key={\"slug\": slug}).get(\"Item\")\n\n    def rename(self, slug, title):\n        self.table.update_item(\n            Key={\"slug\": slug},\n            UpdateExpression=\"SET title = :t\",\n            ConditionExpression=\"attribute_exists(slug)\",\n            ExpressionAttributeValues={\":t\": title},\n        )\n\n    def hide(self, slug, by):\n        \"\"\"Author withdraws a story: it stays in the table but leaves the feed.\"\"\"\n        self.table.update_item(\n            Key={\"slug\": slug},\n            UpdateExpression=\"SET hidden = :h, hidden_by = :by, hidden_at = :t\",\n            ConditionExpression=\"attribute_exists(slug)\",\n            ExpressionAttributeValues={\":h\": True, \":by\": by, \":t\": int(self.clock())},\n        )\n\n    def feed(self, limit=FEED_LIMIT):\n        \"\"\"Public feed: newest first, hidden stories excluded, bodies left out.\"\"\"\n        resp = self.table.scan(ProjectionExpression=\"slug, title, hidden, published_at\")\n        items = [i for i in resp[\"Items\"] if not i.get(\"hidden\")]\n        items.sort(key=lambda i: i[\"published_at\"], reverse=True)\n        return [\n            {\"slug\": i[\"slug\"], \"title\": i[\"title\"], \"published_at\": i[\"published_at\"]}\n            for i in items[:limit]\n        ]\n\n    def archive(self, slug):\n        \"\"\"Editorial: take a published story out of circulation for good.\n        Not wired to the API yet (planned for the admin console).\"\"\"\n        self.table.update_item(\n            Key={\"slug\": slug},\n            UpdateExpression=\"SET archived_at = :t\",\n            ConditionExpression=\"status = :published\",\n            ExpressionAttributeValues={\":t\": int(self.clock()), \":published\": \"published\"},\n        )\nimport os\nimport sys\nimport unittest\n\nROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nsys.path.insert(0, ROOT)\n\nfrom src.app import StoryLibrary  # noqa: E402\nfrom tests.fake_dynamo import ClientError, FakeTable  # noqa: E402\n\n\nclass FeedTests(unittest.TestCase):\n    def setUp(self):\n        self.now = 1_700_000_000\n        self.lib = StoryLibrary(FakeTable(), clock=lambda: self.now)\n\n    def test_publish_then_feed_lists_it(self):\n        self.lib.publish(\"hello\", \"Hello\", \"first post\", \"ann\")\n        self.assertEqual([s[\"slug\"] for s in self.lib.feed()], [\"hello\"])\n\n    def test_feed_is_newest_first(self):\n        self.lib.publish(\"old\", \"Old\", \"...\", \"ann\")\n        self.now += 60\n        self.lib.publish(\"new\", \"New\", \"...\", \"bob\")\n        self.assertEqual([s[\"slug\"] for s in self.lib.feed()], [\"new\", \"old\"])\n\n    def test_feed_leaves_bodies_out(self):\n        self.lib.publish(\"hello\", \"Hello\", \"a long body\", \"ann\")\n        self.assertEqual(set(self.lib.feed()[0]), {\"slug\", \"title\", \"published_at\"})\n\n    def test_publish_twice_is_rejected(self):\n        self.lib.publish(\"hello\", \"Hello\", \"...\", \"ann\")\n        with self.assertRaises(ClientError) as cm:\n            self.lib.publish(\"hello\", \"Hello again\", \"...\", \"ann\")\n        self.assertEqual(cm.exception.response[\"Error\"][\"Code\"], \"ConditionalCheckFailedException\")\n\n    def test_rename(self):\n        self.lib.publish(\"hello\", \"Hello\", \"...\", \"ann\")\n        self.lib.rename(\"hello\", \"Hello, world\")\n        self.assertEqual(self.lib.get(\"hello\")[\"title\"], \"Hello, world\")\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n# storylib\n\nThe library behind the public story feed: publish a story, hide one (the\nauthor withdraws it), list the feed. One DynamoDB table, key `slug`.\n\nLayout:\n\n- `src/app.py` -- `StoryLibrary`, the only module that talks to DynamoDB.\n  The Lambda handlers (`api.py`, in the infra repo) call its methods; keep\n  the method names and signatures stable.\n- `tests/fake_dynamo.py` -- in-memory stand-in for the boto3 Table resource,\n  so the tests run without AWS. It follows DynamoDB's expression rules\n  (see its docstring).\n- `tests/test_feed.py` -- the tests.\n- `logs/` -- what came in this week: the production error on hide and a bug\n  report from staging.\n\nRun the tests (Python 3, no dependencies; on the servers `boto3` is\ninstalled and `STORIES_TABLE` names the table):\n\n    python3 -m unittest discover tests\n---\ntitle: DynamoDB reserved words — the crash, and the silent filter that shipped nothing\ndate: 2026-08-04\ntags: [dynamodb, aws, python, boto3, expressionattributenames, debugging]\ntype: success\nreproducible: true\n---\n\n# DynamoDB reserved words — the crash, and the silent filter that shipped nothing\n\nIn plain words: DynamoDB keeps a list of 573 words you cannot use as plain\nattribute names in its query expressions. Ordinary words, the ones you would\nnaturally name fields after. Cross the list and you get either a loud crash —or,\nin one spot, nothing at all, which is worse.\n\nIt bit me three times in one week, twice today. First `similar` (a list of\nrelated items): \"Invalid UpdateExpression: Attribute name is a reserved\nkeyword\" — loud, clear, fixed with an alias. Today it was `hidden` (an\nauthor-withdraws-story flag), and the same loud crash in the update. Fine,\nalias again, deploy, test — and the end-to-end check still failed: hidden\nstories kept appearing in the public feed.\n\nThat was the sneaky one. `hidden` was also sitting bare in a\n**ProjectionExpression** — the list of fields a scan returns. Reserved words\nthere did not throw in my read path; the field just came back absent, my\n`not item.get(\"hidden\")` filter never saw a value, and the \"hidden\" filter\nsilently filtered nothing. No error, no log line — only a test asserting\n\"withdrawn story must NOT be in the index\" caught it.\n\nThe fix is boring and total: stop playing whack-a-mole with the list. Alias\nevery attribute name in every expression, always — `#hid` for `hidden`, `#sim`\nfor `similar` — even names that are safe today, because DynamoDB's list is\nlong, surprising (`status`, `date`, `name`, `type` are all on it), and your\nfuture field names are chosen by product needs, not by the list.\n\nThe transferable lesson is the second failure mode: when a filter depends on a\nfield, test with data where the field is actually set. An empty-field path\nthat \"passes\" proves nothing — I wrote about the same shape of bug crashing on\nthe second write; this one is its quiet sibling.\n\n## Reproduce this\n\nPrerequisites: any service using DynamoDB expressions via boto3 or the CLI.\n\nYour agent will need from you: the locations of your update_item, scan, and\nquery calls.\n\nSteps: grep every UpdateExpression, ProjectionExpression, ConditionExpression,\nand KeyConditionExpression for bare attribute names; replace each with a #alias\nplus ExpressionAttributeNames, as a blanket convention rather than a per-word\ncheck; then add one integration test per filtered field that writes a record\nWITH the field set and asserts the filter actually excludes or returns it.\n\nVerify: intentionally use a reserved word bare in an UpdateExpression — expect\nthe loud ValidationException; then use one bare in a ProjectionExpression —\nobserve the silent missing-field behavior that no error will ever report.\n5:for reserved words (the real service keeps a list of ~570 of them; RESERVED\n8:  * a bare reserved word in an UpdateExpression, ConditionExpression or\n10:    (\"Attribute name is a reserved keyword\"), exactly like the real service;\n11:  * a bare reserved word in a ProjectionExpression does NOT raise: the\n24:RESERVED = frozenset(\"\"\"\n25:ADD AND ATTRIBUTE BINARY BY COMMENT COUNT DATA DATE DAY DELETE FALSE FROM GROUP HIDDEN HOUR\n57:    \"\"\"Resolves attribute names in one API call and enforces the reserved-word rules.\"\"\"\n72:        \"\"\"Raise like DynamoDB does for a bare reserved word or an unknown #alias.\"\"\"\n81:            elif t.upper() in RESERVED:\n82:                self._invalid(kind, f\"Attribute name is a reserved keyword; reserved keyword: {t}\")\n198:        \"\"\"Reserved words used bare are dropped from the result without any error.\"\"\"\n205:            elif path.upper() in RESERVED:","is_error":false}]},"parent_tool_use_id":null,"session_id":"78fac348-c6ac-44b4-b333-35e870923888","uuid":"d9ad796d-b57f-4367-a81c-6777cb13e453","timestamp":"2026-10-20T23:35:21.556Z","tool_use_result":{"stdout":"\"\"\"storylib - the story library behind the public feed.\n\nThree operations: publish a story, hide one (the author withdraws it) and\nlist the public feed. Storage is a single DynamoDB table keyed by `slug`.\nThis module only talks to a boto3 Table resource; the tests hand it\ntests/fake_dynamo.FakeTable instead, and the HTTP handlers (api.py, in the\ninfra repo) hand it dynamo_table().\n\"\"\"\nimport os\nimport time\n\n\ndef dynamo_table():\n    \"\"\"The real table. boto3 is only installed on the servers.\"\"\"\n    import boto3\n    return boto3.resource(\"dynamodb\").Table(os.environ.get(\"STORIES_TABLE\", \"stories\"))\n\n\nclass StoryLibrary:\n    FEED_LIMIT = 50\n\n    def __init__(self, table, clock=time.time):\n        self.table = table\n        self.clock = clock\n\n    def publish(self, slug, title, body, author):\n        \"\"\"Create a story. Refuses to overwrite an existing slug.\"\"\"\n        self.table.put_item(\n            Item={\n                \"slug\": slug,\n                \"title\": title,\n                \"body\": body,\n                \"author\": author,\n                \"published_at\": int(self.clock()),\n                \"status\": \"published\",\n            },\n            ConditionExpression=\"attribute_not_exists(slug)\",\n        )\n\n    def get(self, slug):\n        return self.table.get_item(Key={\"slug\": slug}).get(\"Item\")\n\n    def rename(self, slug, title):\n        self.table.update_item(\n            Key={\"slug\": slug},\n            UpdateExpression=\"SET title = :t\",\n            ConditionExpression=\"attribute_exists(slug)\",\n            ExpressionAttributeValues={\":t\": title},\n        )\n\n    def hide(self, slug, by):\n        \"\"\"Author withdraws a story: it stays in the table but leaves the feed.\"\"\"\n        self.table.update_item(\n            Key={\"slug\": slug},\n            UpdateExpression=\"SET hidden = :h, hidden_by = :by, hidden_at = :t\",\n            ConditionExpression=\"attribute_exists(slug)\",\n            ExpressionAttributeValues={\":h\": True, \":by\": by, \":t\": int(self.clock())},\n        )\n\n    def feed(self, limit=FEED_LIMIT):\n        \"\"\"Public feed: newest first, hidden stories excluded, bodies left out.\"\"\"\n        resp = self.table.scan(ProjectionExpression=\"slug, title, hidden, published_at\")\n        items = [i for i in resp[\"Items\"] if not i.get(\"hidden\")]\n        items.sort(key=lambda i: i[\"published_at\"], reverse=True)\n        return [\n            {\"slug\": i[\"slug\"], \"title\": i[\"title\"], \"published_at\": i[\"published_at\"]}\n            for i in items[:limit]\n        ]\n\n    def archive(self, slug):\n        \"\"\"Editorial: take a published story out of circulation for good.\n        Not wired to the API yet (planned for the admin console).\"\"\"\n        self.table.update_item(\n            Key={\"slug\": slug},\n            UpdateExpression=\"SET archived_at = :t\",\n            ConditionExpression=\"status = :published\",\n            ExpressionAttributeValues={\":t\": int(self.clock()), \":published\": \"published\"},\n        )\nimport os\nimport sys\nimport unittest\n\nROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nsys.path.insert(0, ROOT)\n\nfrom src.app import StoryLibrary  # noqa: E402\nfrom tests.fake_dynamo import ClientError, FakeTable  # noqa: E402\n\n\nclass FeedTests(unittest.TestCase):\n    def setUp(self):\n        self.now = 1_700_000_000\n        self.lib = StoryLibrary(FakeTable(), clock=lambda: self.now)\n\n    def test_publish_then_feed_lists_it(self):\n        self.lib.publish(\"hello\", \"Hello\", \"first post\", \"ann\")\n        self.assertEqual([s[\"slug\"] for s in self.lib.feed()], [\"hello\"])\n\n    def test_feed_is_newest_first(self):\n        self.lib.publish(\"old\", \"Old\", \"...\", \"ann\")\n        self.now += 60\n        self.lib.publish(\"new\", \"New\", \"...\", \"bob\")\n        self.assertEqual([s[\"slug\"] for s in self.lib.feed()], [\"new\", \"old\"])\n\n    def test_feed_leaves_bodies_out(self):\n        self.lib.publish(\"hello\", \"Hello\", \"a long body\", \"ann\")\n        self.assertEqual(set(self.lib.feed()[0]), {\"slug\", \"title\", \"published_at\"})\n\n    def test_publish_twice_is_rejected(self):\n        self.lib.publish(\"hello\", \"Hello\", \"...\", \"ann\")\n        with self.assertRaises(ClientError) as cm:\n            self.lib.publish(\"hello\", \"Hello again\", \"...\", \"ann\")\n        self.assertEqual(cm.exception.response[\"Error\"][\"Code\"], \"ConditionalCheckFailedException\")\n\n    def test_rename(self):\n        self.lib.publish(\"hello\", \"Hello\", \"...\", \"ann\")\n        self.lib.rename(\"hello\", \"Hello, world\")\n        self.assertEqual(self.lib.get(\"hello\")[\"title\"], \"Hello, world\")\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n# storylib\n\nThe library behind the public story feed: publish a story, hide one (the\nauthor withdraws it), list the feed. One DynamoDB table, key `slug`.\n\nLayout:\n\n- `src/app.py` -- `StoryLibrary`, the only module that talks to DynamoDB.\n  The Lambda handlers (`api.py`, in the infra repo) call its methods; keep\n  the method names and signatures stable.\n- `tests/fake_dynamo.py` -- in-memory stand-in for the boto3 Table resource,\n  so the tests run without AWS. It follows DynamoDB's expression rules\n  (see its docstring).\n- `tests/test_feed.py` -- the tests.\n- `logs/` -- what came in this week: the production error on hide and a bug\n  report from staging.\n\nRun the tests (Python 3, no dependencies; on the servers `boto3` is\ninstalled and `STORIES_TABLE` names the table):\n\n    python3 -m unittest discover tests\n---\ntitle: DynamoDB reserved words — the crash, and the silent filter that shipped nothing\ndate: 2026-08-04\ntags: [dynamodb, aws, python, boto3, expressionattributenames, debugging]\ntype: success\nreproducible: true\n---\n\n# DynamoDB reserved words — the crash, and the silent filter that shipped nothing\n\nIn plain words: DynamoDB keeps a list of 573 words you cannot use as plain\nattribute names in its query expressions. Ordinary words, the ones you would\nnaturally name fields after. Cross the list and you get either a loud crash —or,\nin one spot, nothing at all, which is worse.\n\nIt bit me three times in one week, twice today. First `similar` (a list of\nrelated items): \"Invalid UpdateExpression: Attribute name is a reserved\nkeyword\" — loud, clear, fixed with an alias. Today it was `hidden` (an\nauthor-withdraws-story flag), and the same loud crash in the update. Fine,\nalias again, deploy, test — and the end-to-end check still failed: hidden\nstories kept appearing in the public feed.\n\nThat was the sneaky one. `hidden` was also sitting bare in a\n**ProjectionExpression** — the list of fields a scan returns. Reserved words\nthere did not throw in my read path; the field just came back absent, my\n`not item.get(\"hidden\")` filter never saw a value, and the \"hidden\" filter\nsilently filtered nothing. No error, no log line — only a test asserting\n\"withdrawn story must NOT be in the index\" caught it.\n\nThe fix is boring and total: stop playing whack-a-mole with the list. Alias\nevery attribute name in every expression, always — `#hid` for `hidden`, `#sim`\nfor `similar` — even names that are safe today, because DynamoDB's list is\nlong, surprising (`status`, `date`, `name`, `type` are all on it), and your\nfuture field names are chosen by product needs, not by the list.\n\nThe transferable lesson is the second failure mode: when a filter depends on a\nfield, test with data where the field is actually set. An empty-field path\nthat \"passes\" proves nothing — I wrote about the same shape of bug crashing on\nthe second write; this one is its quiet sibling.\n\n## Reproduce this\n\nPrerequisites: any service using DynamoDB expressions via boto3 or the CLI.\n\nYour agent will need from you: the locations of your update_item, scan, and\nquery calls.\n\nSteps: grep every UpdateExpression, ProjectionExpression, ConditionExpression,\nand KeyConditionExpression for bare attribute names; replace each with a #alias\nplus ExpressionAttributeNames, as a blanket convention rather than a per-word\ncheck; then add one integration test per filtered field that writes a record\nWITH the field set and asserts the filter actually excludes or returns it.\n\nVerify: intentionally use a reserved word bare in an UpdateExpression — expect\nthe loud ValidationException; then use one bare in a ProjectionExpression —\nobserve the silent missing-field behavior that no error will ever report.\n5:for reserved words (the real service keeps a list of ~570 of them; RESERVED\n8:  * a bare reserved word in an UpdateExpression, ConditionExpression or\n10:    (\"Attribute name is a reserved keyword\"), exactly like the real service;\n11:  * a bare reserved word in a ProjectionExpression does NOT raise: the\n24:RESERVED = frozenset(\"\"\"\n25:ADD AND ATTRIBUTE BINARY BY COMMENT COUNT DATA DATE DAY DELETE FALSE FROM GROUP HIDDEN HOUR\n57:    \"\"\"Resolves attribute names in one API call and enforces the reserved-word rules.\"\"\"\n72:        \"\"\"Raise like DynamoDB does for a bare reserved word or an unknown #alias.\"\"\"\n81:            elif t.upper() in RESERVED:\n82:                self._invalid(kind, f\"Attribute name is a reserved keyword; reserved keyword: {t}\")\n198:        \"\"\"Reserved words used bare are dropped from the result without any error.\"\"\"\n205:            elif path.upper() in RESERVED:","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01RstVQnVDgcJxF5NZuJp1Kf","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
