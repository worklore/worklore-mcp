 def related(story, existing):
+    """Return up to TOP_N related stories with Decimal scores.
+
+    DynamoDB does not support native float types, so we convert the similarity
+    score to :class:`decimal.Decimal` before returning it. The conversion is done
+    via ``Decimal(str(score))`` to preserve the rounded representation.
+    """
+    from decimal import Decimal
     scored = []
     for other in existing:
         if other["slug"] == story["slug"]:
             continue
-        scored.append({"slug": other["slug"], "score": similarity(story, other)})
+        # similarity returns a float (rounded to 4 decimals). Convert to Decimal.
+        score = similarity(story, other)
+        scored.append({"slug": other["slug"], "score": Decimal(str(score))})
     scored.sort(key=lambda s: s["score"], reverse=True)
     return scored[:TOP_N]
 
