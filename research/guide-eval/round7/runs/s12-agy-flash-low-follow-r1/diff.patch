+    def test_cross_user_private_task_access(self):
+        # Alice's task 1 is private
+        # Bob should not be able to read or mutate Alice's private task
+        self.assertEqual(self.call("GET", "/tasks/1", token=BOB)[0], 403)
+        self.assertEqual(self.call("PATCH", "/tasks/1", {"title": "Hacked"}, token=BOB)[0], 403)
+        self.assertEqual(self.call("DELETE", "/tasks/1", token=BOB)[0], 403)
+        self.assertEqual(self.call("POST", "/tasks/1/comments", {"text": "Unauthorized"}, token=BOB)[0], 403)
+        self.assertEqual(self.call("POST", "/tasks/1/complete", token=BOB)[0], 403)
+        self.assertEqual(self.call("POST", "/tasks/1/nudge", token=BOB)[0], 403)
+        self.assertEqual(self.call("POST", "/tasks/1/like", token=BOB)[0], 403)
+        self.assertEqual(self.call("POST", "/tasks/1/view", token=BOB)[0], 403)
+
+        # Alice's task 1 remains unchanged
+        code, task = self.call("GET", "/tasks/1", token=ALICE)
+        self.assertEqual(code, 200)
+        self.assertEqual(task["likes"], 0)
+        self.assertEqual(task["views"], 0)
+        self.assertEqual(task["nudges"], 0)
+        self.assertEqual(task["comments"], [])
+        self.assertFalse(task["done"])
+
+    def test_owner_can_access_private_task(self):
+        # Alice can like and view her own private task
+        self.assertEqual(self.call("POST", "/tasks/1/like", token=ALICE)[0], 200)
+        self.assertEqual(self.call("POST", "/tasks/1/view", token=ALICE)[0], 200)
+        code, task = self.call("GET", "/tasks/1", token=ALICE)
+        self.assertEqual(code, 200)
+        self.assertEqual(task["likes"], 1)
+        self.assertEqual(task["views"], 1)
+
 
