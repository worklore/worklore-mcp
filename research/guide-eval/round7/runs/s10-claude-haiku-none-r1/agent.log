;\n    10\t  await Analytics.init();\n    11\t  runApp(const KreditoApp());\n    12\t}\n    13\t\n    14\tclass KreditoApp extends StatelessWidget {\n    15\t  const KreditoApp({super.key});\n    16\t\n    17\t  @override\n    18\t  Widget build(BuildContext context) {\n    19\t    return PostHogWidget(\n    20\t      child: MaterialApp(\n    21\t        title: 'Kredito',\n    22\t        theme: ThemeData(colorSchemeSeed: Colors.green, useMaterial3: true),\n    23\t        navigatorObservers: [PosthogObserver()],\n    24\t        routes: {\n    25\t          '/': (_) => const RegistrationScreen(),\n    26\t          '/offers': (_) => const OfferScreen(),\n    27\t        },\n    28\t      ),\n    29\t    );\n    30\t  }\n    31\t}\n=== lib/analytics.dart\n     1\timport 'package:posthog_flutter/posthog_flutter.dart';\n     2\t\n     3\t/// Thin wrapper around PostHog so the key and host live in one place.\n     4\tclass Analytics {\n     5\t  static Future<void> init() async {\n     6\t    final config = PostHogConfig('phc_REPLACE_ME_IN_CI');\n     7\t    config.host = 'https://eu.i.posthog.com';\n     8\t    config.captureApplicationLifecycleEvents = true;\n     9\t    await Posthog().setup(config);\n    10\t  }\n    11\t\n    12\t  /// Sends one event. [props] is optional.\n    13\t  static Future<void> capture(String event, [Map<String, Object>? props]) =>\n    14\t      Posthog().capture(eventName: event, properties: props);\n    15\t}\n=== lib/screens/registration_screen.dart\n     1\timport 'package:flutter/material.dart';\n     2\t\n     3\tclass RegistrationScreen extends StatefulWidget {\n     4\t  const RegistrationScreen({super.key});\n     5\t\n     6\t  @override\n     7\t  State<RegistrationScreen> createState() => _RegistrationScreenState();\n     8\t}\n     9\t\n    10\tclass _RegistrationScreenState extends State<RegistrationScreen> {\n    11\t  final _email = TextEditingController();\n    12\t  final _phone = TextEditingController();\n    13\t  double _amount = 50000;\n    14\t  bool _terms = false;\n    15\t\n    16\t  @override\n    17\t  void dispose() {\n    18\t    _email.dispose();\n    19\t    _phone.dispose();\n    20\t    super.dispose();\n    21\t  }\n    22\t\n    23\t  bool get _canContinue =>\n    24\t      _terms && _email.text.contains('@') && _phone.text.length >= 10;\n    25\t\n    26\t  @override\n    27\t  Widget build(BuildContext context) {\n    28\t    return Scaffold(\n    29\t      appBar: AppBar(title: const Text('Register')),\n    30\t      body: Padding(\n    31\t        padding: const EdgeInsets.all(16),\n    32\t        child: Column(\n    33\t          crossAxisAlignment: CrossAxisAlignment.stretch,\n    34\t          children: [\n    35\t            TextField(\n    36\t              controller: _email,\n    37\t              keyboardType: TextInputType.emailAddress,\n    38\t              decoration: const InputDecoration(labelText: 'Email'),\n    39\t              onChanged: (_) => setState(() {}),\n    40\t            ),\n    41\t            const SizedBox(height: 12),\n    42\t            TextField(\n    43\t              controller: _phone,\n    44\t              keyboardType: TextInputType.phone,\n    45\t              decoration: const InputDecoration(labelText: 'Phone'),\n    46\t              onChanged: (_) => setState(() {}),\n    47\t            ),\n    48\t            const SizedBox(height: 24),\n    49\t            Text('Loan amount: ${_amount.round()}'),\n    50\t            Slider(\n    51\t              min: 10000,\n    52\t              max: 500000,\n    53\t              divisions: 49,\n    54\t              value: _amount,\n    55\t              label: _amount.round().toString(),\n    56\t              onChanged: (v) => setState(() => _amount = v),\n    57\t            ),\n    58\t            CheckboxListTile(\n    59\t              value: _terms,\n    60\t              title: const Text('I accept the terms and conditions'),\n    61\t              controlAffini