{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SKYXRpWWwG6Js4VP4uUr2Y","type":"tool_result","content":"1\t\"\"\"storylib - the story library behind the public feed.\n2\t\n3\tThree operations: publish a story, hide one (the author withdraws it) and\n4\tlist the public feed. Storage is a single DynamoDB table keyed by `slug`.\n5\tThis module only talks to a boto3 Table resource; the tests hand it\n6\ttests/fake_dynamo.FakeTable instead, and the HTTP handlers (api.py, in the\n7\tinfra repo) hand it dynamo_table().\n8\t\"\"\"\n9\timport os\n10\timport time\n11\t\n12\t\n13\tdef dynamo_table():\n14\t    \"\"\"The real table. boto3 is only installed on the servers.\"\"\"\n15\t    import boto3\n16\t    return boto3.resource(\"dynamodb\").Table(os.environ.get(\"STORIES_TABLE\", \"stories\"))\n17\t\n18\t\n19\tclass StoryLibrary:\n20\t    FEED_LIMIT = 50\n21\t\n22\t    def __init__(self, table, clock=time.time):\n23\t        self.table = table\n24\t        self.clock = clock\n25\t\n26\t    def publish(self, slug, title, body, author):\n27\t        \"\"\"Create a story. Refuses to overwrite an existing slug.\"\"\"\n28\t        self.table.put_item(\n29\t            Item={\n30\t                \"slug\": slug,\n31\t                \"title\": title,\n32\t                \"body\": body,\n33\t                \"author\": author,\n34\t                \"published_at\": int(self.clock()),\n35\t                \"status\": \"published\",\n36\t            },\n37\t            ConditionExpression=\"attribute_not_exists(slug)\",\n38\t        )\n39\t\n40\t    def get(self, slug):\n41\t        return self.table.get_item(Key={\"slug\": slug}).get(\"Item\")\n42\t\n43\t    def rename(self, slug, title):\n44\t        self.table.update_item(\n45\t            Key={\"slug\": slug},\n46\t            UpdateExpression=\"SET title = :t\",\n47\t            ConditionExpression=\"attribute_exists(slug)\",\n48\t            ExpressionAttributeValues={\":t\": title},\n49\t        )\n50\t\n51\t    def hide(self, slug, by):\n52\t        \"\"\"Author withdraws a story: it stays in the table but leaves the feed.\"\"\"\n53\t        self.table.update_item(\n54\t            Key={\"slug\": slug},\n55\t            UpdateExpression=\"SET hidden = :h, hidden_by = :by, hidden_at = :t\",\n56\t            ConditionExpression=\"attribute_exists(slug)\",\n57\t            ExpressionAttributeValues={\":h\": True, \":by\": by, \":t\": int(self.clock())},\n58\t        )\n59\t\n60\t    def feed(self, limit=FEED_LIMIT):\n61\t        \"\"\"Public feed: newest first, hidden stories excluded, bodies left out.\"\"\"\n62\t        resp = self.table.scan(ProjectionExpression=\"slug, title, hidden, published_at\")\n63\t        items = [i for i in resp[\"Items\"] if not i.get(\"hidden\")]\n64\t        items.sort(key=lambda i: i[\"published_at\"], reverse=True)\n65\t        return [\n66\t            {\"slug\": i[\"slug\"], \"title\": i[\"title\"], \"published_at\": i[\"published_at\"]}\n67\t            for i in items[:limit]\n68\t        ]\n69\t\n70\t    def archive(self, slug):\n71\t        \"\"\"Editorial: take a published story out of circulation for good.\n72\t        Not wired to the API yet (planned for the admin console).\"\"\"\n73\t        self.table.update_item(\n74\t            Key={\"slug\": slug},\n75\t            UpdateExpression=\"SET archived_at = :t\",\n76\t            ConditionExpression=\"status = :published\",\n77\t            ExpressionAttributeValues={\":t\": int(self.clock()), \":published\": \"published\"},\n78\t        )\n79\t"}]},"parent_tool_use_id":null,"session_id":"6dfef90c-63c0-49c1-9adc-810466a7393f","uuid":"25ddb1e3-ea1f-4a1f-8e47-ccb08caae59c","timestamp":"2026-10-20T23:45:18.720Z","tool_use_result":{"type":"text","file":{"filePath":"/private/tmp/h-0ROauN/src/app.py","content":"\"\"\"storylib - the story library behind the public feed.\n\nThree operations: publish a story, hide one (the author withdraws it) and\nlist the public feed. Storage is a single DynamoDB table keyed by `slug`.\nThis module only talks to a boto3 Table resource; the tests hand it\ntests/fake_dynamo.FakeTable instead, and the HTTP handlers (api.py, in the\ninfra repo) hand it dynamo_table().\n\"\"\"\nimport os\nimport time\n\n\ndef dynamo_table():\n    \"\"\"The real table. boto3 is only installed on the servers.\"\"\"\n    import boto3\n    return boto3.resource(\"dynamodb\").Table(os.environ.get(\"STORIES_TABLE\", \"stories\"))\n\n\nclass StoryLibrary:\n    FEED_LIMIT = 50\n\n    def __init__(self, table, clock=time.time):\n        self.table = table\n        self.clock = clock\n\n    def publish(self, slug, title, body, author):\n        \"\"\"Create a story. Refuses to overwrite an existing slug.\"\"\"\n        self.table.put_item(\n            Item={\n                \"slug\": slug,\n                \"title\": title,\n                \"body\": body,\n                \"author\": author,\n                \"published_at\": int(self.clock()),\n                \"status\": \"published\",\n            },\n            ConditionExpression=\"attribute_not_exists(slug)\",\n        )\n\n    def get(self, slug):\n        return self.table.get_item(Key={\"slug\": slug}).get(\"Item\")\n\n    def rename(self, slug, title):\n        self.table.update_item(\n            Key={\"slug\": slug},\n            UpdateExpression=\"SET title = :t\",\n            ConditionExpression=\"attribute_exists(slug)\",\n            ExpressionAttributeValues={\":t\": title},\n        )\n\n    def hide(self, slug, by):\n        \"\"\"Author withdraws a story: it stays in the table but leaves the feed.\"\"\"\n        self.table.update_item(\n            Key={\"slug\": slug},\n            UpdateExpression=\"SET hidden = :h, hidden_by = :by, hidden_at = :t\",\n            ConditionExpression=\"attribute_exists(slug)\",\n            ExpressionAttributeValues={\":h\": True, \":by\": by, \":t\": int(self.clock())},\n        )\n\n    def feed(self, limit=FEED_LIMIT):\n        \"\"\"Public feed: newest first, hidden stories excluded, bodies left out.\"\"\"\n        resp = self.table.scan(ProjectionExpression=\"slug, title, hidden, published_at\")\n        items = [i for i in resp[\"Items\"] if not i.get(\"hidden\")]\n        items.sort(key=lambda i: i[\"published_at\"], reverse=True)\n        return [\n            {\"slug\": i[\"slug\"], \"title\": i[\"title\"], \"published_at\": i[\"published_at\"]}\n            for i in items[:limit]\n        ]\n\n    def archive(self, slug):\n        \"\"\"Editorial: take a published story out of circulation for good.\n        Not wired to the API yet (planned for the admin console).\"\"\"\n        self.table.update_item(\n            Key={\"slug\": slug},\n            UpdateExpression=\"SET archived_at = :t\",\n            ConditionExpression=\"status = :published\",\n            ExpressionAttributeValues={\":t\": int(self.clock()), \":published\": \"published\"},\n        )\n","numLines":79,"startLine":1,"totalLines":79}},"tool_result_meta":[{"id":"toolu_01SKYXRpWWwG6Js4VP4uUr2Y","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
