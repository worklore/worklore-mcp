 log = logging.getLogger("stories")
 
@@ -40,6 +42,25 @@ def related(story, existing):
     return scored[:TOP_N]
 
 
+def to_dynamo(value):
+    """Make ``value`` storable by boto3: DynamoDB numbers must be int or Decimal.
+
+    Python arithmetic (``/``, ``round()``, averages) produces floats, which boto3
+    rejects with "Float types are not supported". Every item goes through this
+    right before it is written, so a computed float anywhere in the item can't
+    turn into a 500 again.
+    """
+    if isinstance(value, float):
+        if not math.isfinite(value):
+            raise TypeError(f"cannot store non-finite number {value!r}")
+        return Decimal(str(value))
+    if isinstance(value, dict):
+        return {k: to_dynamo(v) for k, v in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [to_dynamo(v) for v in value]
+    return value
+
