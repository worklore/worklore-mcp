{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013ddNxBzzHptYJRvUQFvCiw","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"tricoach backend: sign-in, Intervals.icu OAuth connection, wellness proxy.\n3\t\n4\tStdlib only. State is in memory (same shape as the prod tables).\n5\t\"\"\"\n6\timport base64, hashlib, hmac, json, os, threading, time\n7\timport urllib.error, urllib.parse, urllib.request\n8\tfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\n9\t\n10\timport config\n11\t\n12\tSTATIC = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"static\")\n13\tTOKEN_URL = config.INTERVALS_BASE + \"/api/oauth/token\"\n14\tAUTHORIZE_URL = config.INTERVALS_BASE + \"/oauth/authorize\"\n15\tDEFAULT_TOKEN_TTL = 3600   # seconds; used when the provider does not say how long a token lives\n16\t\n17\t# --- in-memory store -------------------------------------------------------\n18\tUSERS = {\n19\t    \"tok-okafor\": {\"id\": \"u_okafor\", \"name\": \"C. Okafor\"},\n20\t    \"tok-rivera\": {\"id\": \"u_rivera\", \"name\": \"T. Rivera\"},\n21\t}\n22\t# user_id -> {athlete_id, athlete_name, access_token, refresh_token, scope, expires_at, status}\n23\tCONNECTIONS = {}\n24\tLOCK = threading.Lock()\n25\t\n26\t\n27\tdef log(msg):\n28\t    print(time.strftime(\"%Y-%m-%d %H:%M:%S\"), \"[intervals]\", msg, flush=True)\n29\t\n30\t\n31\t# --- state parameter: carries the user through the redirect -----------------\n32\tdef sign_state(user_id):\n33\t    payload = f\"{user_id}:{int(time.time())}\"\n34\t    sig = hmac.new(config.APP_SECRET.encode(), payload.encode(), hashlib.sha256).hexdigest()[:32]\n35\t    return base64.urlsafe_b64encode(f\"{payload}:{sig}\".encode()).decode()\n36\t\n37\t\n38\tdef verify_state(state, max_age=900):\n39\t    try:\n40\t        user_id, ts, sig = base64.urlsafe_b64decode(state.encode()).decode().split(\":\")\n41\t    except Exception:\n42\t        return None\n43\t    payload = f\"{user_id}:{ts}\"\n44\t    good = hmac.new(config.APP_SECRET.encode(), payload.encode(), hashlib.sha256).hexdigest()[:32]\n45\t    if not hmac.compare_digest(good, sig) or time.time() - int(ts) > max_age:\n46\t        return None\n47\t    return user_id\n48\t\n49\t\n50\t# --- Intervals.icu calls ----------------------------------------------------\n51\tdef post_form(url, fields):\n52\t    data = urllib.parse.urlencode(fields).encode()\n53\t    req = urllib.request.Request(url, data=data, headers={\"Accept\": \"application/json\"})\n54\t    with urllib.request.urlopen(req, timeout=15) as r:\n55\t        return json.loads(r.read().decode())\n56\t\n57\t\n58\tdef exchange_code(code):\n59\t    return post_form(TOKEN_URL, {\n60\t        \"grant_type\": \"authorization_code\", \"client_id\": config.CLIENT_ID,\n61\t        \"client_secret\": config.CLIENT_SECRET, \"code\": code, \"redirect_uri\": config.REDIRECT_URI,\n62\t    })\n63\t\n64\t\n65\tdef store_connection(user_id, tok):\n66\t    expires_in = int(tok.get(\"expires_in\") or DEFAULT_TOKEN_TTL)\n67\t    refresh = tok.get(\"refresh_token\")\n68\t    if not refresh:\n69\t        log(f\"{user_id}: no refresh_token in response, scheduling expiry in {expires_in}s\")\n70\t    athlete = tok.get(\"athlete\") or {}\n71\t    with LOCK:\n72\t        CONNECTIONS[user_id] = {\n73\t            \"athlete_id\": athlete.get(\"id\"), \"athlete_name\": athlete.get(\"name\"),\n74\t            \"access_token\": tok[\"access_token\"], \"refresh_token\": refresh,\n75\t            \"scope\": tok.get(\"scope\"), \"expires_at\": time.time() + expires_in, \"status\": \"connected\",\n76\t        }\n77\t    log(f\"{user_id}: connected as athlete {athlete.get('id')} (expires in {expires_in}s)\")\n78\t\n79\t\n80\tdef refresh_tokens():\n81\t    \"\"\"Background pass: renew access tokens shortly before they expire.\"\"\"\n82\t    while True:\n83\t        time.sleep(config.REFRESH_INTERVAL)\n84\t        now = time.time()\n85\t        with LOCK:\n86\t            for uid, c in CONNECTIONS.items():\n87\t                if c[\"status\"] != \"connected\" or c[\"expires_at\"] - now > 300:\n88\t                    continue\n89\t                if not c[\"refresh_token\"]:\n90\t                    log(f\"{uid}: token expiry passed and no refresh token on file -> expired, reconnect\")\n91\t                    c.update(status=\"expired, reconnect\", access_token=None)\n92\t                    continue\n93\t                try:\n94\t                    tok = post_form(TOKEN_URL, {\n95\t                        \"grant_type\": \"refresh_token\", \"refresh_token\": c[\"refresh_token\"],\n96\t                        \"client_id\": config.CLIENT_ID, \"client_secret\": config.CLIENT_SECRET,\n97\t                    })\n98\t                    c.update(access_token=tok[\"access_token\"],\n99\t                             refresh_token=tok.get(\"refresh_token\", c[\"refresh_token\"]),\n100\t                             expires_at=now + int(tok[\"expires_in\"]))\n101\t                    log(f\"{uid}: token refreshed\")\n102\t                except Exception as e:\n103\t                    log(f\"{uid}: refresh failed ({e}) -> expired, reconnect\")\n104\t                    c.update(status=\"expired, reconnect\", access_token=None)\n105\t\n106\t\n107\tdef intervals_get(conn, path):\n108\t    req = urllib.request.Request(f\"{config.INTERVALS_BASE}/api/v1/athlete/{conn['athlete_id']}{path}\",\n109\t                                 headers={\"Authorization\": \"Bearer \" + conn[\"access_token\"]})\n110\t    with urllib.request.urlopen(req, timeout=15) as r:\n111\t        return r.status, json.loads(r.read().decode())\n112\t\n113\t\n114\t# --- HTTP ---------------------------------------------------------------------\n115\tclass Handler(BaseHTTPRequestHandler):\n116\t    def log_message(self, fmt, *args):\n117\t        print(time.strftime(\"%Y-%m-%d %H:%M:%S\"), \"[http]\", fmt % args, flush=True)\n118\t\n119\t    def send_json(self, code, obj):\n120\t        body = json.dumps(obj).encode()\n121\t        self.send_response(code)\n122\t        self.send_header(\"Content-Type\", \"application/json\")\n123\t        self.send_header(\"Content-Length\", str(len(body)))\n124\t        self.end_headers()\n125\t        self.wfile.write(body)\n126\t\n127\t    def send_file(self, name, ctype):\n128\t        p = os.path.join(STATIC, name)\n129\t        if not os.path.isfile(p):\n130\t            return self.send_json(404, {\"error\": \"not found\"})\n131\t        with open(p, \"rb\") as f:\n132\t            body = f.read()\n133\t        self.send_response(200)\n134\t        self.send_header(\"Content-Type\", ctype)\n135\t        self.send_header(\"Content-Length\", str(len(body)))\n136\t        self.end_headers()\n137\t        self.wfile.write(body)\n138\t\n139\t    def redirect(self, url):\n140\t        self.send_response(302)\n141\t        self.send_header(\"Location\", url)\n142\t        self.end_headers()\n143\t\n144\t    def current_user(self):\n145\t        auth = self.headers.get(\"Authorization\", \"\")\n146\t        if not auth.startswith(\"Bearer \"):\n147\t            return None\n148\t        return USERS.get(auth[7:].strip())\n149\t\n150\t    def require_user(self):\n151\t        user = self.current_user()\n152\t        if user is None:\n153\t            self.log_message(\"%s %s 401 (no Authorization header)\", self.command, self.path)\n154\t            self.send_json(401, {\"error\": \"unauthorized\"})\n155\t        return user\n156\t\n157\t    def do_GET(self):\n158\t        url = urllib.parse.urlsplit(self.path)\n159\t        q = dict(urllib.parse.parse_qsl(url.query))\n160\t        if url.path == \"/\":\n161\t            return self.send_file(\"index.html\", \"text/html; charset=utf-8\")\n162\t        if url.path.startswith(\"/static/\"):\n163\t            return self.send_file(os.path.basename(url.path), \"application/javascript\" if url.path.endswith(\".js\") else \"text/plain\")\n164\t        if url.path == \"/api/me\":\n165\t            user = self.require_user()\n166\t            return user and self.send_json(200, user)\n167\t        if url.path == \"/api/intervals/auth/init\":\n168\t            return self.auth_init()\n169\t        if url.path == \"/api/intervals/callback\":\n170\t            return self.callback(q)\n171\t        if url.path == \"/api/intervals/status\":\n172\t            return self.status()\n173\t        if url.path == \"/api/intervals/wellness\":\n174\t            return self.wellness()\n175\t        self.send_json(404, {\"error\": \"not found\"})\n176\t\n177\t    def do_POST(self):\n178\t        url = urllib.parse.urlsplit(self.path)\n179\t        if url.path == \"/api/intervals/disconnect\":\n180\t            user = self.require_user()\n181\t            if user:\n182\t                with LOCK:\n183\t                    CONNECTIONS.pop(user[\"id\"], None)\n184\t                self.send_json(200, {\"ok\": True})\n185\t            return\n186\t        self.send_json(404, {\"error\": \"not found\"})\n187\t\n188\t    # Step 1: build the authorize URL and send the browser to Intervals.\n189\t    def auth_init(self):\n190\t        user = self.require_user()\n191\t        if not user:\n192\t            return\n193\t        params = {\"client_id\": config.CLIENT_ID, \"redirect_uri\": config.REDIRECT_URI,\n194\t                  \"scope\": config.SCOPES, \"state\": sign_state(user[\"id\"])}\n195\t        self.redirect(AUTHORIZE_URL + \"?\" + urllib.parse.urlencode(params, safe=\":,\"))\n196\t\n197\t    # Step 2: Intervals redirects back here with ?code=&state=.\n198\t    def callback(self, q):\n199\t        user_id = verify_state(q.get(\"state\", \"\"))\n200\t        if not user_id or not q.get(\"code\"):\n201\t            return self.send_json(400, {\"error\": \"bad state or code\"})\n202\t        try:\n203\t            tok = exchange_code(q[\"code\"])\n204\t            store_connection(user_id, tok)\n205\t        except urllib.error.HTTPError as e:\n206\t            log(f\"{user_id}: token exchange failed: HTTP {e.code} {e.read()[:200]!r}\")\n207\t            return self.send_json(502, {\"error\": \"token exchange failed\"})\n208\t        except Exception as e:\n209\t            log(f\"{user_id}: token exchange failed: {e}\")\n210\t            return self.send_json(502, {\"error\": \"token exchange failed\"})\n211\t        self.redirect(\"/?connected=1\")\n212\t\n213\t    def status(self):\n214\t        user = self.require_user()\n215\t        if not user:\n216\t            return\n217\t        with LOCK:\n218\t            c = CONNECTIONS.get(user[\"id\"])\n219\t        if not c or c[\"status\"] != \"connected\":\n220\t            return self.send_json(200, {\"connected\": False, \"status\": c[\"status\"] if c else \"disconnected\"})\n221\t        self.send_json(200, {\"connected\": True, \"status\": \"connected\", \"scope\": c[\"scope\"],\n222\t                             \"athlete\": {\"id\": c[\"athlete_id\"], \"name\": c[\"athlete_name\"]}})\n223\t\n224\t    def wellness(self):\n225\t        user = self.require_user()\n226\t        if not user:\n227\t            return\n228\t        with LOCK:\n229\t            c = CONNECTIONS.get(user[\"id\"])\n230\t        if not c or c[\"status\"] != \"connected\":\n231\t            return self.send_json(409, {\"error\": \"intervals not connected\"})\n232\t        try:\n233\t            code, data = intervals_get(c, \"/wellness\")\n234\t            self.send_json(code, data)\n235\t        except urllib.error.HTTPError as e:\n236\t            self.send_json(e.code, {\"error\": f\"intervals returned {e.code}\"})\n237\t        except Exception as e:\n238\t            self.send_json(502, {\"error\": str(e)})\n239\t\n240\t\n241\tif __name__ == \"__main__\":\n242\t    threading.Thread(target=refresh_tokens, daemon=True).start()\n243\t    log(f\"serving on http://localhost:{config.PORT} (intervals: {config.INTERVALS_BASE})\")\n244\t    ThreadingHTTPServer((\"127.0.0.1\", config.PORT), Handler).serve_forever()\n245\t"}]},"parent_tool_use_id":null,"session_id":"53486c41-56ea-427e-b915-5d911e46ecfb","uuid":"3e78f918-7609-49b8-9ba9-7b22249ff881","timestamp":"2026-10-20T23:42:32.956Z","tool_use_result":{"type":"text","file":{"filePath":"/private/tmp/h-6600rJ/server.py","content":"#!/usr/bin/env python3\n\"\"\"tricoach backend: sign-in, Intervals.icu OAuth connection, wellness proxy.\n\nStdlib only. State is in memory (same shape as the prod tables).\n\"\"\"\nimport base64, hashlib, hmac, json, os, threading, time\nimport urllib.error, urllib.parse, urllib.request\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\n\nimport config\n\nSTATIC = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"static\")\nTOKEN_URL = config.INTERVALS_BASE + \"/api/oauth/token\"\nAUTHORIZE_URL = config.INTERVALS_BASE + \"/oauth/authorize\"\nDEFAULT_TOKEN_TTL = 3600   # seconds; used when the provider does not say how long a token lives\n\n# --- in-memory store -------------------------------------------------------\nUSERS = {\n    \"tok-okafor\": {\"id\": \"u_okafor\", \"name\": \"C. Okafor\"},\n    \"tok-rivera\": {\"id\": \"u_rivera\", \"name\": \"T. Rivera\"},\n}\n# user_id -> {athlete_id, athlete_name, access_token, refresh_token, scope, expires_at, status}\nCONNECTIONS = {}\nLOCK = threading.Lock()\n\n\ndef log(msg):\n    print(time.strftime(\"%Y-%m-%d %H:%M:%S\"), \"[intervals]\", msg, flush=True)\n\n\n# --- state parameter: carries the user through the redirect -----------------\ndef sign_state(user_id):\n    payload = f\"{user_id}:{int(time.time())}\"\n    sig = hmac.new(config.APP_SECRET.encode(), payload.encode(), hashlib.sha256).hexdigest()[:32]\n    return base64.urlsafe_b64encode(f\"{payload}:{sig}\".encode()).decode()\n\n\ndef verify_state(state, max_age=900):\n    try:\n        user_id, ts, sig = base64.urlsafe_b64decode(state.encode()).decode().split(\":\")\n    except Exception:\n        return None\n    payload = f\"{user_id}:{ts}\"\n    good = hmac.new(config.APP_SECRET.encode(), payload.encode(), hashlib.sha256).hexdigest()[:32]\n    if not hmac.compare_digest(good, sig) or time.time() - int(ts) > max_age:\n        return None\n    return user_id\n\n\n# --- Intervals.icu calls ----------------------------------------------------\ndef post_form(url, fields):\n    data = urllib.parse.urlencode(fields).encode()\n    req = urllib.request.Request(url, data=data, headers={\"Accept\": \"application/json\"})\n    with urllib.request.urlopen(req, timeout=15) as r:\n        return json.loads(r.read().decode())\n\n\ndef exchange_code(code):\n    return post_form(TOKEN_URL, {\n        \"grant_type\": \"authorization_code\", \"client_id\": config.CLIENT_ID,\n        \"client_secret\": config.CLIENT_SECRET, \"code\": code, \"redirect_uri\": config.REDIRECT_URI,\n    })\n\n\ndef store_connection(user_id, tok):\n    expires_in = int(tok.get(\"expires_in\") or DEFAULT_TOKEN_TTL)\n    refresh = tok.get(\"refresh_token\")\n    if not refresh:\n        log(f\"{user_id}: no refresh_token in response, scheduling expiry in {expires_in}s\")\n    athlete = tok.get(\"athlete\") or {}\n    with LOCK:\n        CONNECTIONS[user_id] = {\n            \"athlete_id\": athlete.get(\"id\"), \"athlete_name\": athlete.get(\"name\"),\n            \"access_token\": tok[\"access_token\"], \"refresh_token\": refresh,\n            \"scope\": tok.get(\"scope\"), \"expires_at\": time.time() + expires_in, \"status\": \"connected\",\n        }\n    log(f\"{user_id}: connected as athlete {athlete.get('id')} (expires in {expires_in}s)\")\n\n\ndef refresh_tokens():\n    \"\"\"Background pass: renew access tokens shortly before they expire.\"\"\"\n    while True:\n        time.sleep(config.REFRESH_INTERVAL)\n        now = time.time()\n        with LOCK:\n            for uid, c in CONNECTIONS.items():\n                if c[\"status\"] != \"connected\" or c[\"expires_at\"] - now > 300:\n                    continue\n                if not c[\"refresh_token\"]:\n                    log(f\"{uid}: token expiry passed and no refresh token on file -> expired, reconnect\")\n                    c.update(status=\"expired, reconnect\", access_token=None)\n                    continue\n                try:\n                    tok = post_form(TOKEN_URL, {\n                        \"grant_type\": \"refresh_token\", \"refresh_token\": c[\"refresh_token\"],\n                        \"client_id\": config.CLIENT_ID, \"client_secret\": config.CLIENT_SECRET,\n                    })\n                    c.update(access_token=tok[\"access_token\"],\n                             refresh_token=tok.get(\"refresh_token\", c[\"refresh_token\"]),\n                             expires_at=now + int(tok[\"expires_in\"]))\n                    log(f\"{uid}: token refreshed\")\n                except Exception as e:\n                    log(f\"{uid}: refresh failed ({e}) -> expired, reconnect\")\n                    c.update(status=\"expired, reconnect\", access_token=None)\n\n\ndef intervals_get(conn, path):\n    req = urllib.request.Request(f\"{config.INTERVALS_BASE}/api/v1/athlete/{conn['athlete_id']}{path}\",\n                                 headers={\"Authorization\": \"Bearer \" + conn[\"access_token\"]})\n    with urllib.request.urlopen(req, timeout=15) as r:\n        return r.status, json.loads(r.read().decode())\n\n\n# --- HTTP ---------------------------------------------------------------------\nclass Handler(BaseHTTPRequestHandler):\n    def log_message(self, fmt, *args):\n        print(time.strftime(\"%Y-%m-%d %H:%M:%S\"), \"[http]\", fmt % args, flush=True)\n\n    def send_json(self, code, obj):\n        body = json.dumps(obj).encode()\n        self.send_response(code)\n        self.send_header(\"Content-Type\", \"application/json\")\n        self.send_header(\"Content-Length\", str(len(body)))\n        self.end_headers()\n        self.wfile.write(body)\n\n    def send_file(self, name, ctype):\n        p = os.path.join(STATIC, name)\n        if not os.path.isfile(p):\n            return self.send_json(404, {\"error\": \"not found\"})\n        with open(p, \"rb\") as f:\n            body = f.read()\n        self.send_response(200)\n        self.send_header(\"Content-Type\", ctype)\n        self.send_header(\"Content-Length\", str(len(body)))\n        self.end_headers()\n        self.wfile.write(body)\n\n    def redirect(self, url):\n        self.send_response(302)\n        self.send_header(\"Location\", url)\n        self.end_headers()\n\n    def current_user(self):\n        auth = self.headers.get(\"Authorization\", \"\")\n        if not auth.startswith(\"Bearer \"):\n            return None\n        return USERS.get(auth[7:].strip())\n\n    def require_user(self):\n        user = self.current_user()\n        if user is None:\n            self.log_message(\"%s %s 401 (no Authorization header)\", self.command, self.path)\n            self.send_json(401, {\"error\": \"unauthorized\"})\n        return user\n\n    def do_GET(self):\n        url = urllib.parse.urlsplit(self.path)\n        q = dict(urllib.parse.parse_qsl(url.query))\n        if url.path == \"/\":\n            return self.send_file(\"index.html\", \"text/html; charset=utf-8\")\n        if url.path.startswith(\"/static/\"):\n            return self.send_file(os.path.basename(url.path), \"application/javascript\" if url.path.endswith(\".js\") else \"text/plain\")\n        if url.path == \"/api/me\":\n            user = self.require_user()\n            return user and self.send_json(200, user)\n        if url.path == \"/api/intervals/auth/init\":\n            return self.auth_init()\n        if url.path == \"/api/intervals/callback\":\n            return self.callback(q)\n        if url.path == \"/api/intervals/status\":\n            return self.status()\n        if url.path == \"/api/intervals/wellness\":\n            return self.wellness()\n        self.send_json(404, {\"error\": \"not found\"})\n\n    def do_POST(self):\n        url = urllib.parse.urlsplit(self.path)\n        if url.path == \"/api/intervals/disconnect\":\n            user = self.require_user()\n            if user:\n                with LOCK:\n                    CONNECTIONS.pop(user[\"id\"], None)\n                self.send_json(200, {\"ok\": True})\n            return\n        self.send_json(404, {\"error\": \"not found\"})\n\n    # Step 1: build the authorize URL and send the browser to Intervals.\n    def auth_init(self):\n        user = self.require_user()\n        if not user:\n            return\n        params = {\"client_id\": config.CLIENT_ID, \"redirect_uri\": config.REDIRECT_URI,\n                  \"scope\": config.SCOPES, \"state\": sign_state(user[\"id\"])}\n        self.redirect(AUTHORIZE_URL + \"?\" + urllib.parse.urlencode(params, safe=\":,\"))\n\n    # Step 2: Intervals redirects back here with ?code=&state=.\n    def callback(self, q):\n        user_id = verify_state(q.get(\"state\", \"\"))\n        if not user_id or not q.get(\"code\"):\n            return self.send_json(400, {\"error\": \"bad state or code\"})\n        try:\n            tok = exchange_code(q[\"code\"])\n            store_connection(user_id, tok)\n        except urllib.error.HTTPError as e:\n            log(f\"{user_id}: token exchange failed: HTTP {e.code} {e.read()[:200]!r}\")\n            return self.send_json(502, {\"error\": \"token exchange failed\"})\n        except Exception as e:\n            log(f\"{user_id}: token exchange failed: {e}\")\n            return self.send_json(502, {\"error\": \"token exchange failed\"})\n        self.redirect(\"/?connected=1\")\n\n    def status(self):\n        user = self.require_user()\n        if not user:\n            return\n        with LOCK:\n            c = CONNECTIONS.get(user[\"id\"])\n        if not c or c[\"status\"] != \"connected\":\n            return self.send_json(200, {\"connected\": False, \"status\": c[\"status\"] if c else \"disconnected\"})\n        self.send_json(200, {\"connected\": True, \"status\": \"connected\", \"scope\": c[\"scope\"],\n                             \"athlete\": {\"id\": c[\"athlete_id\"], \"name\": c[\"athlete_name\"]}})\n\n    def wellness(self):\n        user = self.require_user()\n        if not user:\n            return\n        with LOCK:\n            c = CONNECTIONS.get(user[\"id\"])\n        if not c or c[\"status\"] != \"connected\":\n            return self.send_json(409, {\"error\": \"intervals not connected\"})\n        try:\n            code, data = intervals_get(c, \"/wellness\")\n            self.send_json(code, data)\n        except urllib.error.HTTPError as e:\n            self.send_json(e.code, {\"error\": f\"intervals returned {e.code}\"})\n        except Exception as e:\n            self.send_json(502, {\"error\": str(e)})\n\n\nif __name__ == \"__main__\":\n    threading.Thread(target=refresh_tokens, daemon=True).start()\n    log(f\"serving on http://localhost:{config.PORT} (intervals: {config.INTERVALS_BASE})\")\n    ThreadingHTTPServer((\"127.0.0.1\", config.PORT), Handler).serve_forever()\n","numLines":245,"startLine":1,"totalLines":245}},"tool_result_meta":[{"id":"toolu_013ddNxBzzHptYJRvUQFvCiw","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
