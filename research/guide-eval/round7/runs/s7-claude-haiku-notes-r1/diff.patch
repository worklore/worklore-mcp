+// The init call must be an XHR so the Authorization header goes out; then the browser
+// navigates to Intervals' authorize page with the signed state.
+async function connect() {
+  try {
+    const { authorize_url } = await api("/api/intervals/auth/init", { method: "POST" });
+    window.location.assign(authorize_url);
+  } catch (e) {
+    alert("Could not start the Intervals.icu connection: " + e.message);
+  }
+}
+
 render();
