@@ -48,18 +49,35 @@ def validate(story):
         raise ValueError("bad slug")
 
 
+def to_dynamo(value):
+    """Make ``value`` storable in DynamoDB: boto3 rejects Python floats.
+
+    Floats become Decimals (via ``str`` so 0.1 stays 0.1, not its binary
+    expansion); dicts and lists are converted recursively. Every item goes
+    through this right before ``put_item``, so a new computed field can't
+    reintroduce the crash.
+    """
+    if isinstance(value, float):
+        return Decimal(str(value))
+    if isinstance(value, dict):
+        return {k: to_dynamo(v) for k, v in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [to_dynamo(v) for v in value]
+    return value
+
+
 def publish(table, story):
     """Store ``story`` with its related stories. Returns the stored item."""
     validate(story)
     existing = table.scan(TableName=TABLE_NAME).get("Items", [])
-    item = {
+    item = to_dynamo({
         "slug": story["slug"],
         "title": story["title"],
         "tags": sorted(set(story.get("tags", []))),
         "body": story["body"],
         "published_at": int(time.time()),
         "similar": related(story, existing),
-    }
+    })
     table.put_item(Item=item)
     log.info("publish slug=%s similar=%d stored", item["slug"], len(item["similar"]))
     return item
