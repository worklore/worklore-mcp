\"state\"]}),tok=None); print(\"callback:\",c,h.get(\"Location\"),\"fields\",SEEN[\"token_fields\"])\nprint(\"bad state:\",call(\"/api/intervals/callback?code=C&state=\"+q[\"state\"][:-2]+\"xx\",tok=None)[0])\nprint(\"status:\",call(\"/api/intervals/status\")[1])\nserver.CONNECTIONS[\"u_okafor\"]  # no expiry fields\nprint(\"wellness:\",call(\"/api/intervals/wellness\")[:2])\nSEEN[\"aid\"]=\"i2\"; st=json.loads(call(\"/api/intervals/auth/init\",\"POST\")[1])[\"authorize_url\"].split(\"state=\")[1]\nprint(\"mismatch:\",call(\"/api/intervals/callback?code=C&state=\"+st,tok=None)[:2])\nREVOKED[\"v\"]=True\nprint(\"revoked wellness:\",call(\"/api/intervals/wellness\")[:2])\nprint(\"status:\",call(\"/api/intervals/status\")[1])\nEOF"}},"wire_ingest_context":{"toolu_01JcQgeoZwwSg8uXU2dc2ZiF":{"cwd":"/private/tmp/h-n0Z0Ar"}}}
