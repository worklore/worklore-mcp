{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CgENLnz5h8buLQW4ahYwJ","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01KkiGTQgSBM4dfoJYdwubHR","name":"Bash","input":{"command":"cat bot.py NOTES.md notes/two-cache*; tail -3 logs/usage.jsonl"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":255,"cache_read_input_tokens":20387,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":255},"output_tokens":16,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"0f647aab-6423-415f-8571-9d11c0fb7725","uuid":"7d40bda0-66a9-46eb-a4bf-c7c363ebb551","timestamp":"2026-10-20T23:37:29.579Z","request_id":"req_011CgENLniToXAUtWmJzJpMu","wire_tool_inputs":{"toolu_01KkiGTQgSBM4dfoJYdwubHR":{"command":"cd /private/tmp/h-7rxceK && cat bot.py NOTES.md notes/two-cache*; tail -3 logs/usage.jsonl"}},"wire_ingest_context":{"toolu_01KkiGTQgSBM4dfoJYdwubHR":{"cwd":"/private/tmp/h-7rxceK"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KkiGTQgSBM4dfoJYdwubHR","type":"tool_result","content":"\"\"\"Coach bot: a stateless endurance-coaching chat on Claude.\n\nEvery incoming message is a fresh request: we rebuild the system prompt from\nthe athlete record, pick the tools the message might need, and run a short\ntool-use loop. Nothing is kept between messages except what is written to\ndata/athletes.json (the athlete's profile and long-term facts).\n\"\"\"\nimport json\nimport os\nimport sys\nimport datetime as dt\nfrom dataclasses import dataclass, field, asdict\n\nMODEL = \"claude-sonnet-4-5\"\nMAX_TOKENS = 700\nMAX_TOOL_ROUNDS = 5\nATHLETES_FILE = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"data\", \"athletes.json\")\nUSAGE_LOG = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"logs\", \"usage.jsonl\")\n\n# --------------------------------------------------------------------------- LLM\ntry:\n    import anthropic\n\n    class LLM:\n        \"\"\"Thin wrapper so the rest of the file reads the same with or without the SDK.\"\"\"\n        def __init__(self):\n            self._client = anthropic.Anthropic(api_key=os.environ[\"COACH_ANTHROPIC_KEY\"])\n\n        def create(self, **kw):\n            return self._client.messages.create(**kw)\nexcept ImportError:  # the code is readable and importable without the SDK\n    class LLM:\n        def __init__(self):\n            raise RuntimeError(\"anthropic SDK not installed: pip install anthropic\")\n\n        def create(self, **kw):\n            raise RuntimeError(\"anthropic SDK not installed\")\n\n# --------------------------------------------------------------------------- athlete record\n@dataclass\nclass Athlete:\n    user_id: str\n    name: str\n    lang: str = \"en\"\n    sport: str = \"running\"\n    goal: str = \"finish a half marathon\"\n    zones: dict = field(default_factory=lambda: {\"Z1\": \"<135\", \"Z2\": \"135-150\", \"Z3\": \"150-162\", \"Z4\": \"162-172\", \"Z5\": \">172\"})\n    facts: list = field(default_factory=list)   # long-term memory, grows via save_fact\n\n\ndef _load_all():\n    try:\n        with open(ATHLETES_FILE) as f:\n            return json.load(f)\n    except FileNotFoundError:\n        return {}\n\n\ndef load_athlete(user_id):\n    raw = _load_all().get(str(user_id))\n    if raw is None:\n        return Athlete(user_id=str(user_id), name=\"athlete\")\n    return Athlete(**raw)\n\n\ndef save_athlete(a):\n    allrec = _load_all()\n    allrec[a.user_id] = asdict(a)\n    os.makedirs(os.path.dirname(ATHLETES_FILE), exist_ok=True)\n    with open(ATHLETES_FILE, \"w\") as f:\n        json.dump(allrec, f, indent=1, ensure_ascii=False)\n\n# --------------------------------------------------------------------------- system prompt\nINSTRUCTIONS = \"\"\"You are Pace, an endurance coach for recreational runners and cyclists.\n\nCoaching rules:\n1. Answer the question that was asked before adding anything else.\n2. Keep replies short: a chat message, not an article. Three paragraphs at most.\n3. Prescribe training by heart-rate zone or RPE, never by pace, unless the athlete asks for pace.\n4. Use the athlete's own zones from the profile below; never invent zone boundaries.\n5. Easy days are easy: anything labelled recovery or Z1/Z2 must stay there.\n6. Never add more than 10% weekly volume over the previous week.\n7. One hard session per week for beginners, two for athletes with 3+ years of training.\n8. A rest day is a session. Do not fill it.\n9. If the athlete reports pain (not soreness) lasting more than two days, stop the plan and say to see a physio.\n10. Do not diagnose injuries or illness. Do not give medication advice.\n11. Fuelling: 30-60 g carbs per hour for sessions over 75 minutes; mention it only when relevant.\n12. Sleep and stress count as training load. Ask about them when the athlete looks flat.\n13. Before a goal race, the last hard session is 7-10 days out. Taper means less volume, same intensity.\n14. Do not change the athlete's goal unless they ask. Mention the goal when a question is clearly off-plan.\n15. When the athlete tells you something durable about themselves (injury history, schedule, preferences,\n    equipment, races booked), call save_fact once with a single sentence. Do not save moods or one-off plans.\n16. Do not save a fact that is already in the list below.\n17. Use the plan_week tool for any weekly structure; do not write a week by hand.\n18. Use log_session when the athlete reports a completed workout, then comment on it.\n19. If asked for numbers you do not have (recent volume, last race), ask one question, do not guess.\n20. Metric units unless the profile says otherwise.\n\nTone:\n- Warm, direct, no exclamation marks.\n- No motivational quotes.\n- Address the athlete by first name at most once per reply.\n- Reply in the athlete's language from the profile below, even if they write in another language.\n\nSafety:\n- Never advise training through chest pain, dizziness or fever.\n- Minors: refer to a coach in person.\n- If someone asks for weight-loss plans below 1500 kcal per day, decline and suggest a dietitian.\n\nFormatting:\n- Plain text. No markdown headings, no tables.\n- Lists only for a session structure (warm-up / main / cool-down).\n- Numbers with units: 45 min, 12 km, 150 bpm.\n\"\"\"\n\n\ndef athlete_context(a, today):\n    lines = [\n        f\"Today: {today.isoformat()} ({today.strftime('%A')})\",\n        f\"Athlete: {a.name} (id {a.user_id}), sport: {a.sport}\",\n        \"Zones: \" + \", \".join(f\"{k} {v}\" for k, v in a.zones.items()),\n        f\"Goal: {a.goal}\",\n        \"Long-term facts:\",\n    ]\n    lines += [f\"- {f}\" for f in a.facts] or [\"- (none yet)\"]\n    lines.append(f\"Language: {a.lang}\")\n    return \"\\n\".join(lines)\n\n\ndef build_system(a, today):\n    # One block, cached as a whole: instructions + per-athlete context.\n    text = INSTRUCTIONS + \"\\n\\n\" + athlete_context(a, today)\n    return [{\"type\": \"text\", \"text\": text, \"cache_control\": {\"type\": \"ephemeral\"}}]\n\n# --------------------------------------------------------------------------- tools\nCORE_TOOLS = [\n    {\"name\": \"save_fact\", \"description\": \"Remember one durable fact about the athlete.\",\n     \"input_schema\": {\"type\": \"object\", \"properties\": {\"fact\": {\"type\": \"string\"}}, \"required\": [\"fact\"]}},\n    {\"name\": \"log_session\", \"description\": \"Record a completed workout.\",\n     \"input_schema\": {\"type\": \"object\", \"properties\": {\"minutes\": {\"type\": \"integer\"}, \"rpe\": {\"type\": \"integer\"},\n                                                       \"note\": {\"type\": \"string\"}}, \"required\": [\"minutes\"]}},\n]\nTOOL_GROUPS = {\n    \"plan\": ((\"plan\", \"week\", \"schedule\", \"taper\", \"build\"), [\n        {\"name\": \"plan_week\", \"description\": \"Draft a week of sessions.\",\n         \"input_schema\": {\"type\": \"object\", \"properties\": {\"hours\": {\"type\": \"number\"}, \"hard_days\": {\"type\": \"integer\"}},\n                          \"required\": [\"hours\"]}}]),\n    \"race\": ((\"race\", \"pace\", \"predict\", \"finish time\"), [\n        {\"name\": \"predict_race\", \"description\": \"Estimate a finish time from a recent effort.\",\n         \"input_schema\": {\"type\": \"object\", \"properties\": {\"distance_km\": {\"type\": \"number\"}, \"recent_minutes\": {\"type\": \"number\"}},\n                          \"required\": [\"distance_km\"]}}]),\n}\n\n\ndef select_tools(text):\n    \"\"\"Core tools always; a group is added only when the message mentions its keywords.\"\"\"\n    tools = list(CORE_TOOLS)\n    low = text.lower()\n    for _, (keys, group) in TOOL_GROUPS.items():\n        if any(k in low for k in keys):\n            tools += group\n    return tools\n\n\ndef run_tool(a, name, args):\n    if name == \"save_fact\":\n        a.facts.append(args[\"fact\"].strip())\n        save_athlete(a)\n        return \"saved\"\n    if name == \"log_session\":\n        return f\"logged {args.get('minutes')} min\"\n    if name == \"plan_week\":\n        return json.dumps({\"hours\": args[\"hours\"], \"hard_days\": args.get(\"hard_days\", 1), \"sessions\": [\"Mon rest\", \"Tue Z2 45 min\", \"...\"]})\n    if name == \"predict_race\":\n        return json.dumps({\"distance_km\": args[\"distance_km\"], \"estimate_min\": round(args.get(\"recent_minutes\", 50) * 2.1)})\n    return f\"unknown tool {name}\"\n\n# --------------------------------------------------------------------------- the per-message loop\ndef log_usage(usage, user_id, round_no, tool=None):\n    rec = {\"ts\": dt.datetime.now(dt.timezone.utc).isoformat(timespec=\"seconds\"), \"user\": user_id, \"round\": round_no,\n           \"input_tokens\": usage.input_tokens, \"cache_creation_input_tokens\": usage.cache_creation_input_tokens,\n           \"cache_read_input_tokens\": usage.cache_read_input_tokens, \"output_tokens\": usage.output_tokens}\n    if tool:\n        rec[\"tool\"] = tool\n    os.makedirs(os.path.dirname(USAGE_LOG), exist_ok=True)\n    with open(USAGE_LOG, \"a\") as f:\n        f.write(json.dumps(rec) + \"\\n\")\n\n\ndef build_request(a, messages, tools, today):\n    return {\"model\": MODEL, \"max_tokens\": MAX_TOKENS, \"system\": build_system(a, today), \"tools\": tools, \"messages\": messages}\n\n\ndef reply(user_id, text, llm=None):\n    llm = llm or LLM()\n    a = load_athlete(user_id)\n    today = dt.date.today()\n    tools = select_tools(text)\n    messages = [{\"role\": \"user\", \"content\": text}]\n    for round_no in range(1, MAX_TOOL_ROUNDS + 1):\n        resp = llm.create(**build_request(a, messages, tools, today))\n        used_tools = [b.name for b in resp.content if b.type == \"tool_use\"]\n        log_usage(resp.usage, a.user_id, round_no, tool=\",\".join(used_tools) or None)\n        if resp.stop_reason != \"tool_use\":\n            return \"\".join(b.text for b in resp.content if b.type == \"text\")\n        messages.append({\"role\": \"assistant\", \"content\": [b.model_dump() for b in resp.content]})\n        results = [{\"type\": \"tool_result\", \"tool_use_id\": b.id, \"content\": run_tool(a, b.name, b.input)}\n                   for b in resp.content if b.type == \"tool_use\"]\n        messages.append({\"role\": \"user\", \"content\": results})\n    return \"Sorry, I lost the thread. Ask me again?\"\n\n\nif __name__ == \"__main__\":\n    # Local chat: python3 bot.py <user_id>; Telegram long-polling lives in telegram.py (not in this repo).\n    uid = sys.argv[1] if len(sys.argv) > 1 else \"42\"\n    for line in sys.stdin:\n        print(reply(uid, line.strip()))\n# Notes\n\n## 2026-04-20 — bill doubled since memory shipped\n\nInput spend roughly doubled in the week after `save_fact` went live (2026-04-13),\nwith the same number of messages per day. `logs/usage.jsonl` shows it: on a normal\nmessage the loop rounds and the next message read ~1000 tokens from cache, but\nevery call right after a `save_fact` has `cache_read_input_tokens: 0` and\n`cache_creation_input_tokens` ~1000 again. Athletes tell the bot things about\nthemselves a lot in their first week, so this happens several times per chat.\n\nTried: shorter facts (no change), capping facts at 20 (no change, the number of\nfacts is not the problem). Tool filtering by keyword is from March and was a clear\nwin (~75% fewer tool tokens on short messages); leave it.\n---\ntitle: Two cache_control segments so agent memory writes don't evict the whole Claude system prompt\ndate: 2026-04-24\ntags: [claude, prompt-caching, llm-agents, token-costs, mcp, telegram-bot]\ntype: success\nstatus: n/a\nreproducible: true\n---\n\n# Two cache_control segments so agent memory writes don't evict the whole Claude system prompt\n\nA chat agent pays for its whole system prompt on every message — and on every\niteration of every tool-use loop. Anthropic's prompt cache cuts cached reads\nto ~10% of the input price, but it works as a **prefix hash**: change one\nbyte, and everything from that byte to the end of the cached block is a miss.\nThat interacts badly with agent memory — the moment your agent learns\nsomething new about the user, it rewrites its own prompt.\n\nMy Telegram coach bot is stateless: each message is a fresh Claude call with\ninstructions, the athlete's profile, zones, goal, long-term facts, and a set\nof MCP tools; a tool-use loop re-sends all of it 3–5 times per answer.\n\nFirst win was unrelated to caching: sending all ~55 tool schemas with every\n\"thanks!\" was silly, so tools are filtered by message keywords into groups\n(a core set always included) — about 75% fewer tokens on simple messages.\n\nThen long-term memory arrived and broke caching. With a single cache marker\nat the end of the system prompt, every `save_fact` call rewrote the facts\nblock, changed the prefix hash, and evicted **everything** — including the\ninstruction text that never changes.\n\nThe fix is embarrassingly small: two `cache_control: ephemeral` markers\ninstead of one. Segment one is the static instructions (~780 tokens,\nbyte-identical across users and days). Segment two is the per-user tail\n(~240 tokens: date, profile, zones, goal, facts, language). A memory write\nnow invalidates only the tail; the static prefix stays hot. Anthropic allows\n4 markers per request — we use 2.\n\nThe non-obvious part was what we had to *refuse* to build:\n\n- **Top-N fact selection per message** (only inject facts relevant to the\n  current question) — rejected. Any per-message selection makes the tail\n  differ per message, so the tail cache never hits. Loading *all* facts every\n  time is cheaper than loading fewer, differently each time.\n- **Aggressive tool filtering** has the same tension: tools sit *above* the\n  system prompt in the cached prefix, so a message that pulls in an extra\n  tool group re-reads everything once. Liveable because the default group set\n  covers most messages, and within one message's tool loop the list is\n  constant — and the loop iterations are where the cache pays most.\n\nNet effect: within the 5-minute TTL, loop iterations and follow-up messages\nread the prompt at ~10% price, and frequent memory writes re-cache ~240\ntokens instead of the ~1000+ of the whole prompt.\n\n## Reproduce this\n\nPrerequisites: an app calling the Claude API directly with the\n[Anthropic SDK](https://docs.claude.com/en/api/client-sdks) and using\n[prompt caching](https://docs.claude.com/en/docs/build-with-claude/prompt-caching);\na system prompt with a distinguishable invariant part (instructions) and a\nvolatile part (per-user / per-day data, agent memory). Works for any\nprovider with prefix-based caching — the marker syntax below is\nAnthropic-specific.\n\nYour agent will need from you: your current system-prompt assembly code, and\na list of which parts change per user, per day, or per memory write.\n\nSteps:\n\n1. Split `system` into an array of two text blocks, each with\n   `cache_control: {\"type\": \"ephemeral\"}`: block one = instructions,\n   guaranteed byte-stable (no interpolated dates, names, or counters);\n   block two = everything volatile (date, profile, memory), ordered\n   rarest-changing first for readability — after the marker it's one hash\n   anyway.\n2. Keep everything *above* the system prompt in the request — the tools\n   array most of all — byte-stable across calls; if you must vary tools per\n   message, make the default selection cover the common case, and never\n   reorder or reword tool schemas casually.\n3. Resist per-message personalization inside cached blocks (top-N memory\n   selection, \"relevant context only\") — selection defeats the cache;\n   include-everything usually costs less.\n4. Read `usage` in every response: `cache_creation_input_tokens` and\n   `cache_read_input_tokens` tell you exactly what happened.\n\nVerify: send two messages within 5 minutes — the second must show\n`cache_read_input_tokens` covering roughly the whole prompt. Then trigger a\nmemory write and send a third message: `cache_read` must still cover the\nstatic block, and `cache_creation` must be roughly the size of your volatile\ntail only. If a memory write causes `cache_creation` the size of the full\nprompt, your static block isn't byte-stable — hunt the interpolated value.\n{\"ts\": \"2026-04-18T08:04:56+00:00\", \"user\": \"42\", \"round\": 1, \"input_tokens\": 61, \"cache_creation_input_tokens\": 0, \"cache_read_input_tokens\": 1090, \"output_tokens\": 41, \"tool\": \"save_fact\"}\n{\"ts\": \"2026-04-18T08:05:39+00:00\", \"user\": \"42\", \"round\": 2, \"input_tokens\": 139, \"cache_creation_input_tokens\": 1104, \"cache_read_input_tokens\": 0, \"output_tokens\": 155}\n{\"ts\": \"2026-04-18T08:05:54+00:00\", \"user\": \"42\", \"round\": 1, \"input_tokens\": 26, \"cache_creation_input_tokens\": 0, \"cache_read_input_tokens\": 1104, \"output_tokens\": 93}","is_error":false}]},"parent_tool_use_id":null,"session_id":"0f647aab-6423-415f-8571-9d11c0fb7725","uuid":"0c21a65b-14d9-44aa-ac14-9d46d5eb8559","timestamp":"2026-10-20T23:37:29.782Z","tool_use_result":{"stdout":"\"\"\"Coach bot: a stateless endurance-coaching chat on Claude.\n\nEvery incoming message is a fresh request: we rebuild the system prompt from\nthe athlete record, pick the tools the message might need, and run a short\ntool-use loop. Nothing is kept between messages except what is written to\ndata/athletes.json (the athlete's profile and long-term facts).\n\"\"\"\nimport json\nimport os\nimport sys\nimport datetime as dt\nfrom dataclasses import dataclass, field, asdict\n\nMODEL = \"claude-sonnet-4-5\"\nMAX_TOKENS = 700\nMAX_TOOL_ROUNDS = 5\nATHLETES_FILE = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"data\", \"athletes.json\")\nUSAGE_LOG = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"logs\", \"usage.jsonl\")\n\n# --------------------------------------------------------------------------- LLM\ntry:\n    import anthropic\n\n    class LLM:\n        \"\"\"Thin wrapper so the rest of the file reads the same with or without the SDK.\"\"\"\n        def __init__(self):\n            self._client = anthropic.Anthropic(api_key=os.environ[\"COACH_ANTHROPIC_KEY\"])\n\n        def create(self, **kw):\n            return self._client.messages.create(**kw)\nexcept ImportError:  # the code is readable and importable without the SDK\n    class LLM:\n        def __init__(self):\n            raise RuntimeError(\"anthropic SDK not installed: pip install anthropic\")\n\n        def create(self, **kw):\n            raise RuntimeError(\"anthropic SDK not installed\")\n\n# --------------------------------------------------------------------------- athlete record\n@dataclass\nclass Athlete:\n    user_id: str\n    name: str\n    lang: str = \"en\"\n    sport: str = \"running\"\n    goal: str = \"finish a half marathon\"\n    zones: dict = field(default_factory=lambda: {\"Z1\": \"<135\", \"Z2\": \"135-150\", \"Z3\": \"150-162\", \"Z4\": \"162-172\", \"Z5\": \">172\"})\n    facts: list = field(default_factory=list)   # long-term memory, grows via save_fact\n\n\ndef _load_all():\n    try:\n        with open(ATHLETES_FILE) as f:\n            return json.load(f)\n    except FileNotFoundError:\n        return {}\n\n\ndef load_athlete(user_id):\n    raw = _load_all().get(str(user_id))\n    if raw is None:\n        return Athlete(user_id=str(user_id), name=\"athlete\")\n    return Athlete(**raw)\n\n\ndef save_athlete(a):\n    allrec = _load_all()\n    allrec[a.user_id] = asdict(a)\n    os.makedirs(os.path.dirname(ATHLETES_FILE), exist_ok=True)\n    with open(ATHLETES_FILE, \"w\") as f:\n        json.dump(allrec, f, indent=1, ensure_ascii=False)\n\n# --------------------------------------------------------------------------- system prompt\nINSTRUCTIONS = \"\"\"You are Pace, an endurance coach for recreational runners and cyclists.\n\nCoaching rules:\n1. Answer the question that was asked before adding anything else.\n2. Keep replies short: a chat message, not an article. Three paragraphs at most.\n3. Prescribe training by heart-rate zone or RPE, never by pace, unless the athlete asks for pace.\n4. Use the athlete's own zones from the profile below; never invent zone boundaries.\n5. Easy days are easy: anything labelled recovery or Z1/Z2 must stay there.\n6. Never add more than 10% weekly volume over the previous week.\n7. One hard session per week for beginners, two for athletes with 3+ years of training.\n8. A rest day is a session. Do not fill it.\n9. If the athlete reports pain (not soreness) lasting more than two days, stop the plan and say to see a physio.\n10. Do not diagnose injuries or illness. Do not give medication advice.\n11. Fuelling: 30-60 g carbs per hour for sessions over 75 minutes; mention it only when relevant.\n12. Sleep and stress count as training load. Ask about them when the athlete looks flat.\n13. Before a goal race, the last hard session is 7-10 days out. Taper means less volume, same intensity.\n14. Do not change the athlete's goal unless they ask. Mention the goal when a question is clearly off-plan.\n15. When the athlete tells you something durable about themselves (injury history, schedule, preferences,\n    equipment, races booked), call save_fact once with a single sentence. Do not save moods or one-off plans.\n16. Do not save a fact that is already in the list below.\n17. Use the plan_week tool for any weekly structure; do not write a week by hand.\n18. Use log_session when the athlete reports a completed workout, then comment on it.\n19. If asked for numbers you do not have (recent volume, last race), ask one question, do not guess.\n20. Metric units unless the profile says otherwise.\n\nTone:\n- Warm, direct, no exclamation marks.\n- No motivational quotes.\n- Address the athlete by first name at most once per reply.\n- Reply in the athlete's language from the profile below, even if they write in another language.\n\nSafety:\n- Never advise training through chest pain, dizziness or fever.\n- Minors: refer to a coach in person.\n- If someone asks for weight-loss plans below 1500 kcal per day, decline and suggest a dietitian.\n\nFormatting:\n- Plain text. No markdown headings, no tables.\n- Lists only for a session structure (warm-up / main / cool-down).\n- Numbers with units: 45 min, 12 km, 150 bpm.\n\"\"\"\n\n\ndef athlete_context(a, today):\n    lines = [\n        f\"Today: {today.isoformat()} ({today.strftime('%A')})\",\n        f\"Athlete: {a.name} (id {a.user_id}), sport: {a.sport}\",\n        \"Zones: \" + \", \".join(f\"{k} {v}\" for k, v in a.zones.items()),\n        f\"Goal: {a.goal}\",\n        \"Long-term facts:\",\n    ]\n    lines += [f\"- {f}\" for f in a.facts] or [\"- (none yet)\"]\n    lines.append(f\"Language: {a.lang}\")\n    return \"\\n\".join(lines)\n\n\ndef build_system(a, today):\n    # One block, cached as a whole: instructions + per-athlete context.\n    text = INSTRUCTIONS + \"\\n\\n\" + athlete_context(a, today)\n    return [{\"type\": \"text\", \"text\": text, \"cache_control\": {\"type\": \"ephemeral\"}}]\n\n# --------------------------------------------------------------------------- tools\nCORE_TOOLS = [\n    {\"name\": \"save_fact\", \"description\": \"Remember one durable fact about the athlete.\",\n     \"input_schema\": {\"type\": \"object\", \"properties\": {\"fact\": {\"type\": \"string\"}}, \"required\": [\"fact\"]}},\n    {\"name\": \"log_session\", \"description\": \"Record a completed workout.\",\n     \"input_schema\": {\"type\": \"object\", \"properties\": {\"minutes\": {\"type\": \"integer\"}, \"rpe\": {\"type\": \"integer\"},\n                                                       \"note\": {\"type\": \"string\"}}, \"required\": [\"minutes\"]}},\n]\nTOOL_GROUPS = {\n    \"plan\": ((\"plan\", \"week\", \"schedule\", \"taper\", \"build\"), [\n        {\"name\": \"plan_week\", \"description\": \"Draft a week of sessions.\",\n         \"input_schema\": {\"type\": \"object\", \"properties\": {\"hours\": {\"type\": \"number\"}, \"hard_days\": {\"type\": \"integer\"}},\n                          \"required\": [\"hours\"]}}]),\n    \"race\": ((\"race\", \"pace\", \"predict\", \"finish time\"), [\n        {\"name\": \"predict_race\", \"description\": \"Estimate a finish time from a recent effort.\",\n         \"input_schema\": {\"type\": \"object\", \"properties\": {\"distance_km\": {\"type\": \"number\"}, \"recent_minutes\": {\"type\": \"number\"}},\n                          \"required\": [\"distance_km\"]}}]),\n}\n\n\ndef select_tools(text):\n    \"\"\"Core tools always; a group is added only when the message mentions its keywords.\"\"\"\n    tools = list(CORE_TOOLS)\n    low = text.lower()\n    for _, (keys, group) in TOOL_GROUPS.items():\n        if any(k in low for k in keys):\n            tools += group\n    return tools\n\n\ndef run_tool(a, name, args):\n    if name == \"save_fact\":\n        a.facts.append(args[\"fact\"].strip())\n        save_athlete(a)\n        return \"saved\"\n    if name == \"log_session\":\n        return f\"logged {args.get('minutes')} min\"\n    if name == \"plan_week\":\n        return json.dumps({\"hours\": args[\"hours\"], \"hard_days\": args.get(\"hard_days\", 1), \"sessions\": [\"Mon rest\", \"Tue Z2 45 min\", \"...\"]})\n    if name == \"predict_race\":\n        return json.dumps({\"distance_km\": args[\"distance_km\"], \"estimate_min\": round(args.get(\"recent_minutes\", 50) * 2.1)})\n    return f\"unknown tool {name}\"\n\n# --------------------------------------------------------------------------- the per-message loop\ndef log_usage(usage, user_id, round_no, tool=None):\n    rec = {\"ts\": dt.datetime.now(dt.timezone.utc).isoformat(timespec=\"seconds\"), \"user\": user_id, \"round\": round_no,\n           \"input_tokens\": usage.input_tokens, \"cache_creation_input_tokens\": usage.cache_creation_input_tokens,\n           \"cache_read_input_tokens\": usage.cache_read_input_tokens, \"output_tokens\": usage.output_tokens}\n    if tool:\n        rec[\"tool\"] = tool\n    os.makedirs(os.path.dirname(USAGE_LOG), exist_ok=True)\n    with open(USAGE_LOG, \"a\") as f:\n        f.write(json.dumps(rec) + \"\\n\")\n\n\ndef build_request(a, messages, tools, today):\n    return {\"model\": MODEL, \"max_tokens\": MAX_TOKENS, \"system\": build_system(a, today), \"tools\": tools, \"messages\": messages}\n\n\ndef reply(user_id, text, llm=None):\n    llm = llm or LLM()\n    a = load_athlete(user_id)\n    today = dt.date.today()\n    tools = select_tools(text)\n    messages = [{\"role\": \"user\", \"content\": text}]\n    for round_no in range(1, MAX_TOOL_ROUNDS + 1):\n        resp = llm.create(**build_request(a, messages, tools, today))\n        used_tools = [b.name for b in resp.content if b.type == \"tool_use\"]\n        log_usage(resp.usage, a.user_id, round_no, tool=\",\".join(used_tools) or None)\n        if resp.stop_reason != \"tool_use\":\n            return \"\".join(b.text for b in resp.content if b.type == \"text\")\n        messages.append({\"role\": \"assistant\", \"content\": [b.model_dump() for b in resp.content]})\n        results = [{\"type\": \"tool_result\", \"tool_use_id\": b.id, \"content\": run_tool(a, b.name, b.input)}\n                   for b in resp.content if b.type == \"tool_use\"]\n        messages.append({\"role\": \"user\", \"content\": results})\n    return \"Sorry, I lost the thread. Ask me again?\"\n\n\nif __name__ == \"__main__\":\n    # Local chat: python3 bot.py <user_id>; Telegram long-polling lives in telegram.py (not in this repo).\n    uid = sys.argv[1] if len(sys.argv) > 1 else \"42\"\n    for line in sys.stdin:\n        print(reply(uid, line.strip()))\n# Notes\n\n## 2026-04-20 — bill doubled since memory shipped\n\nInput spend roughly doubled in the week after `save_fact` went live (2026-04-13),\nwith the same number of messages per day. `logs/usage.jsonl` shows it: on a normal\nmessage the loop rounds and the next message read ~1000 tokens from cache, but\nevery call right after a `save_fact` has `cache_read_input_tokens: 0` and\n`cache_creation_input_tokens` ~1000 again. Athletes tell the bot things about\nthemselves a lot in their first week, so this happens several times per chat.\n\nTried: shorter facts (no change), capping facts at 20 (no change, the number of\nfacts is not the problem). Tool filtering by keyword is from March and was a clear\nwin (~75% fewer tool tokens on short messages); leave it.\n---\ntitle: Two cache_control segments so agent memory writes don't evict the whole Claude system prompt\ndate: 2026-04-24\ntags: [claude, prompt-caching, llm-agents, token-costs, mcp, telegram-bot]\ntype: success\nstatus: n/a\nreproducible: true\n---\n\n# Two cache_control segments so agent memory writes don't evict the whole Claude system prompt\n\nA chat agent pays for its whole system prompt on every message — and on every\niteration of every tool-use loop. Anthropic's prompt cache cuts cached reads\nto ~10% of the input price, but it works as a **prefix hash**: change one\nbyte, and everything from that byte to the end of the cached block is a miss.\nThat interacts badly with agent memory — the moment your agent learns\nsomething new about the user, it rewrites its own prompt.\n\nMy Telegram coach bot is stateless: each message is a fresh Claude call with\ninstructions, the athlete's profile, zones, goal, long-term facts, and a set\nof MCP tools; a tool-use loop re-sends all of it 3–5 times per answer.\n\nFirst win was unrelated to caching: sending all ~55 tool schemas with every\n\"thanks!\" was silly, so tools are filtered by message keywords into groups\n(a core set always included) — about 75% fewer tokens on simple messages.\n\nThen long-term memory arrived and broke caching. With a single cache marker\nat the end of the system prompt, every `save_fact` call rewrote the facts\nblock, changed the prefix hash, and evicted **everything** — including the\ninstruction text that never changes.\n\nThe fix is embarrassingly small: two `cache_control: ephemeral` markers\ninstead of one. Segment one is the static instructions (~780 tokens,\nbyte-identical across users and days). Segment two is the per-user tail\n(~240 tokens: date, profile, zones, goal, facts, language). A memory write\nnow invalidates only the tail; the static prefix stays hot. Anthropic allows\n4 markers per request — we use 2.\n\nThe non-obvious part was what we had to *refuse* to build:\n\n- **Top-N fact selection per message** (only inject facts relevant to the\n  current question) — rejected. Any per-message selection makes the tail\n  differ per message, so the tail cache never hits. Loading *all* facts every\n  time is cheaper than loading fewer, differently each time.\n- **Aggressive tool filtering** has the same tension: tools sit *above* the\n  system prompt in the cached prefix, so a message that pulls in an extra\n  tool group re-reads everything once. Liveable because the default group set\n  covers most messages, and within one message's tool loop the list is\n  constant — and the loop iterations are where the cache pays most.\n\nNet effect: within the 5-minute TTL, loop iterations and follow-up messages\nread the prompt at ~10% price, and frequent memory writes re-cache ~240\ntokens instead of the ~1000+ of the whole prompt.\n\n## Reproduce this\n\nPrerequisites: an app calling the Claude API directly with the\n[Anthropic SDK](https://docs.claude.com/en/api/client-sdks) and using\n[prompt caching](https://docs.claude.com/en/docs/build-with-claude/prompt-caching);\na system prompt with a distinguishable invariant part (instructions) and a\nvolatile part (per-user / per-day data, agent memory). Works for any\nprovider with prefix-based caching — the marker syntax below is\nAnthropic-specific.\n\nYour agent will need from you: your current system-prompt assembly code, and\na list of which parts change per user, per day, or per memory write.\n\nSteps:\n\n1. Split `system` into an array of two text blocks, each with\n   `cache_control: {\"type\": \"ephemeral\"}`: block one = instructions,\n   guaranteed byte-stable (no interpolated dates, names, or counters);\n   block two = everything volatile (date, profile, memory), ordered\n   rarest-changing first for readability — after the marker it's one hash\n   anyway.\n2. Keep everything *above* the system prompt in the request — the tools\n   array most of all — byte-stable across calls; if you must vary tools per\n   message, make the default selection cover the common case, and never\n   reorder or reword tool schemas casually.\n3. Resist per-message personalization inside cached blocks (top-N memory\n   selection, \"relevant context only\") — selection defeats the cache;\n   include-everything usually costs less.\n4. Read `usage` in every response: `cache_creation_input_tokens` and\n   `cache_read_input_tokens` tell you exactly what happened.\n\nVerify: send two messages within 5 minutes — the second must show\n`cache_read_input_tokens` covering roughly the whole prompt. Then trigger a\nmemory write and send a third message: `cache_read` must still cover the\nstatic block, and `cache_creation` must be roughly the size of your volatile\ntail only. If a memory write causes `cache_creation` the size of the full\nprompt, your static block isn't byte-stable — hunt the interpolated value.\n{\"ts\": \"2026-04-18T08:04:56+00:00\", \"user\": \"42\", \"round\": 1, \"input_tokens\": 61, \"cache_creation_input_tokens\": 0, \"cache_read_input_tokens\": 1090, \"output_tokens\": 41, \"tool\": \"save_fact\"}\n{\"ts\": \"2026-04-18T08:05:39+00:00\", \"user\": \"42\", \"round\": 2, \"input_tokens\": 139, \"cache_creation_input_tokens\": 1104, \"cache_read_input_tokens\": 0, \"output_tokens\": 155}\n{\"ts\": \"2026-04-18T08:05:54+00:00\", \"user\": \"42\", \"round\": 1, \"input_tokens\": 26, \"cache_creation_input_tokens\": 0, \"cache_read_input_tokens\": 1104, \"output_tokens\": 93}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01KkiGTQgSBM4dfoJYdwubHR","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
