{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc 'cat tests/test_api.py'","aggregated_output":"import json\nimport os\nimport sys\nimport threading\nimport unittest\nimport urllib.error\nimport urllib.request\n\nsys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))\nimport api  # noqa: E402\n\nALICE = \"tok_alice_4f8c2e71b0\"\n\n\nclass ApiTest(unittest.TestCase):\n    @classmethod\n    def setUpClass(cls):\n        cls.srv = api.make_server(0)\n        cls.base = \"http://127.0.0.1:%d\" % cls.srv.server_address[1]\n        threading.Thread(target=cls.srv.serve_forever, daemon=True).start()\n\n    @classmethod\n    def tearDownClass(cls):\n        cls.srv.shutdown()\n        cls.srv.server_close()\n\n    def setUp(self):\n        api.seed()\n\n    def call(self, method, path, body=None, token=ALICE):\n        data = json.dumps(body).encode() if body is not None else None\n        req = urllib.request.Request(self.base + path, data=data, method=method)\n        if token:\n            req.add_header(\"Authorization\", \"Bearer \" + token)\n        req.add_header(\"Content-Type\", \"application/json\")\n        try:\n            with urllib.request.urlopen(req) as r:\n                return r.status, json.loads(r.read())\n        except urllib.error.HTTPError as e:\n            return e.code, json.loads(e.read() or b\"{}\")\n\n    def test_needs_token(self):\n        self.assertEqual(self.call(\"GET\", \"/tasks\", token=None)[0], 401)\n\n    def test_list_and_read_public(self):\n        code, body = self.call(\"GET\", \"/tasks\")\n        self.assertEqual(code, 200)\n        self.assertIn(\"Water the office plants\", [t[\"title\"] for t in body[\"tasks\"]])\n        self.assertEqual(self.call(\"GET\", \"/tasks/2\")[0], 200)\n\n    def test_create_edit_delete(self):\n        code, t = self.call(\"POST\", \"/tasks\", {\"title\": \"Order coffee beans\", \"visibility\": \"public\"})\n        self.assertEqual(code, 201)\n        code, t = self.call(\"PATCH\", \"/tasks/%d\" % t[\"id\"], {\"title\": \"Order more coffee beans\"})\n        self.assertEqual((code, t[\"title\"]), (200, \"Order more coffee beans\"))\n        self.assertEqual(self.call(\"DELETE\", \"/tasks/%d\" % t[\"id\"])[0], 200)\n        self.assertEqual(self.call(\"GET\", \"/tasks/%d\" % t[\"id\"])[0], 404)\n\n    def test_social_actions_on_public_task(self):\n        self.assertEqual(self.call(\"POST\", \"/tasks/2/comments\", {\"text\": \"on it\"})[0], 201)\n        self.assertEqual(self.call(\"POST\", \"/tasks/2/like\")[1][\"likes\"], 1)\n        self.assertEqual(self.call(\"POST\", \"/tasks/2/view\")[1][\"views\"], 1)\n        self.assertEqual(self.call(\"POST\", \"/tasks/2/nudge\")[1][\"nudges\"], 1)\n        self.assertTrue(self.call(\"POST\", \"/tasks/2/complete\")[1][\"done\"])\n\n    def test_bad_input(self):\n        self.assertEqual(self.call(\"POST\", \"/tasks\", {\"visibility\": \"public\"})[0], 400)\n        self.assertEqual(self.call(\"GET\", \"/nope\")[0], 404)\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc 'cat api.py'","aggregated_output":"#!/usr/bin/env python3\n\"\"\"tasks-api: the backend of a small social to-do app (Python standard library only).\n\n    python3 api.py        # http://127.0.0.1:63869\n\nEvery request needs `Authorization: Bearer <token>`; the development tokens are in README.md.\nA task is `private` (only its owner may see or touch it) or `public` (anyone may read, comment,\nlike, view and nudge; only the owner may edit, delete or complete it).\n\"\"\"\nimport json\nimport os\nimport re\nimport sys\nimport time\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\n\nPORT = int(os.environ.get(\"PORT\", \"63869\"))\n\nUSERS = {  # token -> user id\n    \"tok_alice_4f8c2e71b0\": \"alice\",\n    \"tok_bob_9a1d7c3e55\": \"bob\",\n}\n\nTASKS = {}\nNEXT_ID = [1]\n\n\ndef seed():\n    \"\"\"Reset the in-memory store to the development data.\"\"\"\n    TASKS.clear()\n    NEXT_ID[0] = 1\n    _add(\"alice\", \"Draft the investor update\", \"private\")\n    _add(\"alice\", \"Water the office plants\", \"public\")\n    _add(\"bob\", \"Book the team lunch\", \"public\")\n\n\ndef _add(owner, title, visibility):\n    tid = NEXT_ID[0]\n    NEXT_ID[0] += 1\n    TASKS[tid] = {\"id\": tid, \"owner\": owner, \"title\": title, \"visibility\": visibility,\n                  \"done\": False, \"likes\": 0, \"views\": 0, \"nudges\": 0, \"comments\": []}\n    return TASKS[tid]\n\n\n# --- authorization helpers -------------------------------------------------\n\ndef can_access(user, task):\n    \"\"\"May `user` see this task at all? Public tasks: everyone. Private tasks: the owner only.\"\"\"\n    return task[\"visibility\"] == \"public\" or task[\"owner\"] == user\n\n\ndef is_owner(user, task):\n    return task[\"owner\"] == user\n\n\n# --- HTTP ------------------------------------------------------------------\n\nROUTE = re.compile(r\"^/tasks/(\\d+)(?:/(comments|complete|nudge|like|view))?$\")\n\n\nclass Handler(BaseHTTPRequestHandler):\n    server_version = \"tasks-api/0.3\"\n\n    def log_message(self, fmt, *args):\n        sys.stderr.write(\"%s %s\\n\" % (time.strftime(\"%H:%M:%S\"), fmt % args))\n\n    def send(self, code, body):\n        data = json.dumps(body).encode()\n        self.send_response(code)\n        self.send_header(\"Content-Type\", \"application/json\")\n        self.send_header(\"Content-Length\", str(len(data)))\n        self.end_headers()\n        self.wfile.write(data)\n\n    def user(self):\n        auth = self.headers.get(\"Authorization\", \"\")\n        if auth.startswith(\"Bearer \"):\n            return USERS.get(auth[7:].strip())\n        return None\n\n    def body(self):\n        n = int(self.headers.get(\"Content-Length\") or 0)\n        raw = self.rfile.read(n) if n else b\"\"\n        if not raw:\n            return {}\n        try:\n            data = json.loads(raw)\n        except ValueError:\n            raise ValueError(\"body is not valid JSON\")\n        if not isinstance(data, dict):\n            raise ValueError(\"body must be a JSON object\")\n        return data\n\n    def dispatch(self, method):\n        user = self.user()\n        if user is None:\n            return self.send(401, {\"error\": \"missing or unknown bearer token\"})\n        path = self.path.split(\"?\", 1)[0].rstrip(\"/\") or \"/\"\n        try:\n            data = self.body() if method in (\"POST\", \"PATCH\") else {}\n        except ValueError as e:\n            return self.send(400, {\"error\": str(e)})\n\n        if path == \"/tasks\" and method == \"GET\":\n            mine = [t for t in TASKS.values() if can_access(user, t)]\n            return self.send(200, {\"tasks\": mine})\n        if path == \"/tasks\" and method == \"POST\":\n            title = data.get(\"title\")\n            vis = data.get(\"visibility\", \"private\")\n            if not isinstance(title, str) or not title.strip():\n                return self.send(400, {\"error\": \"title is required\"})\n            if vis not in (\"private\", \"public\"):\n                return self.send(400, {\"error\": \"visibility must be private or public\"})\n            return self.send(201, _add(user, title.strip(), vis))\n\n        m = ROUTE.match(path)\n        if not m:\n            return self.send(404, {\"error\": \"no such route\"})\n        task = TASKS.get(int(m.group(1)))\n        if task is None:\n            return self.send(404, {\"error\": \"no such task\"})\n        action = m.group(2)\n\n        if action is None:\n            if method == \"GET\":\n                if not can_access(user, task):\n                    return self.send(403, {\"error\": \"forbidden\"})\n                return self.send(200, task)\n            if method == \"PATCH\":\n                if not is_owner(user, task):\n                    return self.send(403, {\"error\": \"only the owner may edit a task\"})\n                for k in (\"title\", \"visibility\"):\n                    if k in data:\n                        task[k] = data[k]\n                return self.send(200, task)\n            if method == \"DELETE\":\n                if not is_owner(user, task):\n                    return self.send(403, {\"error\": \"only the owner may delete a task\"})\n                del TASKS[task[\"id\"]]\n                return self.send(200, {\"deleted\": task[\"id\"]})\n            return self.send(405, {\"error\": \"method not allowed\"})\n\n        if method != \"POST\":\n            return self.send(405, {\"error\": \"method not allowed\"})\n        if action == \"comments\":\n            if not can_access(user, task):\n                return self.send(403, {\"error\": \"forbidden\"})\n            text = data.get(\"text\")\n            if not isinstance(text, str) or not text.strip():\n                return self.send(400, {\"error\": \"text is required\"})\n            task[\"comments\"].append({\"by\": user, \"text\": text.strip()})\n            return self.send(201, task)\n        if action == \"complete\":\n            if not is_owner(user, task):\n                return self.send(403, {\"error\": \"only the owner may complete a task\"})\n            task[\"done\"] = True\n            return self.send(200, task)\n        if action == \"nudge\":\n            if not can_access(user, task):\n                return self.send(403, {\"error\": \"forbidden\"})\n            task[\"nudges\"] += 1\n            return self.send(200, {\"id\": task[\"id\"], \"nudges\": task[\"nudges\"]})\n        if action == \"like\":\n            task[\"likes\"] += 1\n            return self.send(200, {\"id\": task[\"id\"], \"likes\": task[\"likes\"]})\n        if action == \"view\":\n            task[\"views\"] += 1\n            return self.send(200, {\"id\": task[\"id\"], \"views\": task[\"views\"]})\n        return self.send(404, {\"error\": \"no such route\"})\n\n    def do_GET(self):\n        self.dispatch(\"GET\")\n\n    def do_POST(self):\n        self.dispatch(\"POST\")\n\n    def do_PATCH(self):\n        self.dispatch(\"PATCH\")\n\n    def do_DELETE(self):\n        self.dispatch(\"DELETE\")\n\n\ndef make_server(port=PORT):\n    return ThreadingHTTPServer((\"127.0.0.1\", port), Handler)\n\n\nif __name__ == \"__main__\":\n    seed()\n    srv = make_server()\n    print(\"tasks-api listening on http://127.0.0.1:%d\" % srv.server_address[1], flush=True)\n    try:\n        srv.serve_forever()\n    except KeyboardInterrupt:\n        pass\n","exit_code":0,"status":"completed"}}
