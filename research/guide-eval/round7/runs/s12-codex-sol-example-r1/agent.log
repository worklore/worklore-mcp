s': []}]})\nbob read (403, {'error': 'forbidden'})\nbob PATCH / (403, {'error': 'only the owner may edit a task'})\nbob DELETE / (403, {'error': 'only the owner may delete a task'})\nbob POST /comments (403, {'error': 'forbidden'})\nbob POST /complete (403, {'error': 'only the owner may complete a task'})\nbob POST /nudge (403, {'error': 'forbidden'})\nbob POST /like (200, {'id': 4, 'likes': 1})\nbob POST /view (200, {'id': 4, 'views': 1})\nalice read after (200, {'id': 4, 'owner': 'alice', 'title': 'authorization probe', 'visibility': 'private', 'done': False, 'likes': 1, 'views': 1, 'nudges': 0, 'comments': []})\nunauthenticated read (401, {'error': 'missing or unknown bearer token'})\ncleanup (200, {'deleted': 4})\n","exit_code":0,"status":"completed"}}
