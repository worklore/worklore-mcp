{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport json, urllib.request, urllib.error\nbase='http://127.0.0.1:63869'\ntokens={'alice':'tok_alice_4f8c2e71b0','bob':'tok_bob_9a1d7c3e55'}\ndef call(who, method, path, body=None):\n    data=json.dumps(body).encode() if body is not None else None\n    req=urllib.request.Request(base+path, data=data, method=method)\n    if who: req.add_header('Authorization','Bearer '+tokens[who])\n    if data is not None: req.add_header('Content-Type','application/json')\n    try:\n        with urllib.request.urlopen(req) as res: return res.status, json.load(res)\n    except urllib.error.HTTPError as err: return err.code, json.load(err)\ncode, task=call('alice','POST','/tasks',{'title':'authorization probe','visibility':'private'})\nprint('create', code, task)\npath='/tasks/'+str(task['id'])\ntry:\n    print('bob list',call('bob','GET','/tasks'))\n    print('bob read',call('bob','GET',path))\n    for method,suffix,body in [('PATCH','',{'title':'intrusion'}),('DELETE','',None),('POST','/comments',{'text':'intrusion'}),('POST','/complete',None),('POST','/nudge',None),('POST','/like',None),('POST','/view',None)]:\n        print('bob',method,suffix or '/',call('bob',method,path+suffix,body))\n    print('alice read after',call('alice','GET',path))\n    print('unauthenticated read',call(None,'GET',path))\nfinally:\n    print('cleanup',call('alice','DELETE',path))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
