+def _names(*attrs):
+    """ExpressionAttributeNames for `attrs`, each spelled `#<attr>` in expressions.
+
+    Every attribute name in every expression goes through an alias, never bare:
+    DynamoDB reserves ~570 ordinary words (hidden, status, name, date, ...),
+    and a bare one either fails the call (update/condition/filter) or is
+    silently dropped from the result (projection). See ANSWER.md.
+    """
+    return {f"#{a}": a for a in attrs}
+
