{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc 'cat README.md'","aggregated_output":"# tasks-api\n\nBackend of a small social to-do app: your tasks are private by default, or\npublic so friends can see, comment on, like and nudge them. Python standard\nlibrary only, in-memory store (re-seeded on every start).\n\n```\npython3 api.py                 # http://127.0.0.1:59178\npython3 -m unittest discover -s tests\n```\n\nEvery request needs `Authorization: Bearer <token>`. Development tokens:\n\n| user  | token                    |\n|-------|--------------------------|\n| alice | `tok_alice_4f8c2e71b0`   |\n| bob   | `tok_bob_9a1d7c3e55`     |\n\nSeed data: alice has a private task (#1, \"Draft the investor update\") and a\npublic one (#2, \"Water the office plants\"); bob has a public task (#3).\n\n## Endpoints\n\n| method | path                     | who                         |\n|--------|--------------------------|-----------------------------|\n| GET    | /tasks                   | own + public tasks          |\n| POST   | /tasks                   | `{\"title\", \"visibility\": \"private\"\\|\"public\"}` |\n| GET    | /tasks/{id}              | owner; anyone if public     |\n| PATCH  | /tasks/{id}              | owner                       |\n| DELETE | /tasks/{id}              | owner                       |\n| POST   | /tasks/{id}/comments     | owner; anyone if public (`{\"text\"}`) |\n| POST   | /tasks/{id}/complete     | owner                       |\n| POST   | /tasks/{id}/nudge        | owner; anyone if public     |\n| POST   | /tasks/{id}/like         | owner; anyone if public     |\n| POST   | /tasks/{id}/view         | owner; anyone if public     |\n\nRule: a private task is visible and touchable only by its owner (403 for\nanyone else, 401 without a token).\n\nLaunch is next week.\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc 'cat tests/test_api.py'","aggregated_output":"import json\nimport os\nimport sys\nimport threading\nimport unittest\nimport urllib.error\nimport urllib.request\n\nsys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))\nimport api  # noqa: E402\n\nALICE = \"tok_alice_4f8c2e71b0\"\n\n\nclass ApiTest(unittest.TestCase):\n    @classmethod\n    def setUpClass(cls):\n        cls.srv = api.make_server(0)\n        cls.base = \"http://127.0.0.1:%d\" % cls.srv.server_address[1]\n        threading.Thread(target=cls.srv.serve_forever, daemon=True).start()\n\n    @classmethod\n    def tearDownClass(cls):\n        cls.srv.shutdown()\n        cls.srv.server_close()\n\n    def setUp(self):\n        api.seed()\n\n    def call(self, method, path, body=None, token=ALICE):\n        data = json.dumps(body).encode() if body is not None else None\n        req = urllib.request.Request(self.base + path, data=data, method=method)\n        if token:\n            req.add_header(\"Authorization\", \"Bearer \" + token)\n        req.add_header(\"Content-Type\", \"application/json\")\n        try:\n            with urllib.request.urlopen(req) as r:\n                return r.status, json.loads(r.read())\n        except urllib.error.HTTPError as e:\n            return e.code, json.loads(e.read() or b\"{}\")\n\n    def test_needs_token(self):\n        self.assertEqual(self.call(\"GET\", \"/tasks\", token=None)[0], 401)\n\n    def test_list_and_read_public(self):\n        code, body = self.call(\"GET\", \"/tasks\")\n        self.assertEqual(code, 200)\n        self.assertIn(\"Water the office plants\", [t[\"title\"] for t in body[\"tasks\"]])\n        self.assertEqual(self.call(\"GET\", \"/tasks/2\")[0], 200)\n\n    def test_create_edit_delete(self):\n        code, t = self.call(\"POST\", \"/tasks\", {\"title\": \"Order coffee beans\", \"visibility\": \"public\"})\n        self.assertEqual(code, 201)\n        code, t = self.call(\"PATCH\", \"/tasks/%d\" % t[\"id\"], {\"title\": \"Order more coffee beans\"})\n        self.assertEqual((code, t[\"title\"]), (200, \"Order more coffee beans\"))\n        self.assertEqual(self.call(\"DELETE\", \"/tasks/%d\" % t[\"id\"])[0], 200)\n        self.assertEqual(self.call(\"GET\", \"/tasks/%d\" % t[\"id\"])[0], 404)\n\n    def test_social_actions_on_public_task(self):\n        self.assertEqual(self.call(\"POST\", \"/tasks/2/comments\", {\"text\": \"on it\"})[0], 201)\n        self.assertEqual(self.call(\"POST\", \"/tasks/2/like\")[1][\"likes\"], 1)\n        self.assertEqual(self.call(\"POST\", \"/tasks/2/view\")[1][\"views\"], 1)\n        self.assertEqual(self.call(\"POST\", \"/tasks/2/nudge\")[1][\"nudges\"], 1)\n        self.assertTrue(self.call(\"POST\", \"/tasks/2/complete\")[1][\"done\"])\n\n    def test_bad_input(self):\n        self.assertEqual(self.call(\"POST\", \"/tasks\", {\"visibility\": \"public\"})[0], 400)\n        self.assertEqual(self.call(\"GET\", \"/nope\")[0], 404)\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n","exit_code":0,"status":"completed"}}
