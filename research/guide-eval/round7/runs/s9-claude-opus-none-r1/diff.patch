+def _names(*attrs):
+    """ExpressionAttributeNames for `attrs`, each spelled `#attr` in expressions.
+
+    Every attribute name in every expression in this module goes through a
+    `#alias`. DynamoDB reserves ~570 words (hidden, status, name, data, ...);
+    a bare reserved word fails UpdateExpression/ConditionExpression with a
+    ValidationException and, worse, is silently dropped from a
+    ProjectionExpression. tests/test_feed.py enforces that no name is bare.
+    """
+    return {"#" + a: a for a in attrs}
+
