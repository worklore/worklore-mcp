       TextField(\n              controller: _email,\n              keyboardType: TextInputType.emailAddress,\n              decoration: const InputDecoration(labelText: 'Email'),\n              onChanged: (_) => setState(() {}),\n            ),\n            const SizedBox(height: 12),\n            TextField(\n              controller: _phone,\n              keyboardType: TextInputType.phone,\n              decoration: const InputDecoration(labelText: 'Phone'),\n              onChanged: (_) => setState(() {}),\n            ),\n            const SizedBox(height: 24),\n            Text('Loan amount: ${_amount.round()}'),\n            Slider(\n              min: 10000,\n              max: 500000,\n              divisions: 49,\n              value: _amount,\n              label: _amount.round().toString(),\n              onChanged: (v) => setState(() => _amount = v),\n            ),\n            CheckboxListTile(\n              value: _terms,\n              title: const Text('I accept the terms and conditions'),\n              controlAffinity: ListTileControlAffinity.leading,\n              onChanged: (v) => setState(() => _terms = v ?? false),\n            ),\n            const Spacer(),\n            FilledButton(\n              onPressed: _canContinue\n                  ? () => Navigator.of(context).pushNamed('/offers')\n                  : null,\n              child: const Text('Continue'),\n            ),\n          ],\n        ),\n      ),\n    );\n  }\n}\n=== offer\nimport 'package:flutter/material.dart';\n\nclass Offer {\n  const Offer(this.bank, this.months, this.rate);\n  final String bank;\n  final int months;\n  final double rate;\n}\n\nconst _offers = [\n  Offer('Norbank', 12, 9.9),\n  Offer('Norbank', 24, 10.4),\n  Offer('Fjordcredit', 12, 8.7),\n  Offer('Fjordcredit', 36, 11.2),\n  Offer('Vestkapital', 24, 9.5),\n  Offer('Vestkapital', 48, 12.0),\n  Offer('Sparbank', 12, 10.9),\n  Offer('Sparbank', 60, 12.8),\n  Offer('Nordlån', 36, 10.1),\n  Offer('Nordlån', 60, 12.3),\n];\n\nclass OfferScreen extends StatelessWidget {\n  const OfferScreen({super.key});\n\n  @override\n  Widget build(BuildContext context) {\n    return Scaffold(\n      appBar: AppBar(title: const Text('Offers')),\n      body: ListView.builder(\n        itemCount: _offers.length,\n        itemBuilder: (context, i) {\n          final o = _offers[i];\n          return ListTile(\n            leading: const Icon(Icons.account_balance),\n            title: Text('${o.bank}, ${o.months} months'),\n            subtitle: Text('${o.rate.toStringAsFixed(1)}% APR'),\n            trailing: const Icon(Icons.chevron_right),\n            onTap: () {},\n          );\n        },\n      ),\n    );\n  }\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_019nTcqQtA86nn7BA8QPnJ9j","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011CgENyxqwoNEYJXYRPuBDA","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01AJ5VWTKVVCmx7MoJXGRFho","name":"Bash","input":{"command":"cd /tmp/h-N3iKvW && cat notes/posthog-free-tier-gone-in-days-an-event-per-keystroke.md; echo \"=== other notes\"; head -30 notes/collecting-leads-with-apps-script.md; head -30 notes/badges-for-your-users-achievements.md","description":"Read notes directory files"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1132,"cache_read_input_tokens":21136,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1132},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"8c28dfe9-c50e-47a3-a21e-593abbb971ae","uuid":"3dc4cdfd-f148-489c-8f1f-2f87ba1c07f3","timestamp":"2026-10-20T23:45:55.229Z","request_id":"req_011CgENyxbpTKnn5skT6FoJR","wire_tool_inputs":{"toolu_01AJ5VWTKVVCmx7MoJXGRFho":{"command":"cd /tmp/h-N3iKvW && cat notes/posthog-free-tier-gone-in-days-an-event-per-keystroke.md; echo \"=== other notes\"; head -30 notes/collecting-leads-with-apps-script.md; head -30 notes/badges-for-your-users-achievements.md","description":"Read notes directory files"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AJ5VWTKVVCmx7MoJXGRFho","type":"tool_result","content":"---\ntitle: PostHog free tier gone in days? Flutter sent an event per keystroke\ndate: 2026-10-07\ntags: [posthog, flutter, analytics, event-quota, pricing]\ntype: success\nstatus: n/a\nreproducible: true\nvisibility: public\nstack: Flutter / Dart, posthog_flutter 5.x\nagent: Claude Code\nmodel: claude-opus-5-5\n---\n\n# PostHog free tier gone in days? Flutter sent an event per keystroke\n\nAnalytics tools like PostHog charge by the number of events. The free tier is\ngenerous, so a small app should never run out. Ours used up the free monthly\nevent quota within a few days.\n\nThe cause was in our own code. Our product spec listed events like \"user\nstarted typing their email\" and \"user moved the loan amount slider\". We hooked\nthem up in the obvious place: `onChanged`. In Flutter, a text field's\n`onChanged` runs on every keystroke, and a slider's `onChanged` runs on every\nstep it crosses while the user drags. An email address became twenty events.\nOne drag across the slider became dozens. Multiply that by every field on\nevery registration screen, then by every user, and the quota was gone.\n\nYou can't see this in the PostHog dashboard. The event names were exactly\nwhat the spec asked for and the funnels looked right. There were just far too\nmany of them.\n\nThe fix kept every event name and property the same. It only changed when\nthey fire:\n- **Text fields:** fire once per screen visit, on the first edit. A\n  `bool _emailInputFired` flag on the screen state does it. If you need the\n  final value (only as a non-sensitive property, like \"is valid\"), fire when\n  the field loses focus instead.\n- **Sliders:** move the event from `onChanged` to `onChangeEnd`, so it fires\n  once per drag, when the user lets go.\n- **Scrolls:** the same idea. Listen for `ScrollEndNotification` rather than\n  every scroll update.\n\n## Check if this applies to you\nApplies if: a Flutter app that sends events to PostHog (or any analytics\nservice billed per event).\nRead-only steps:\n1. `grep -rn \"onChanged\\|addListener\\|NotificationListener<ScrollNotification>\\|ScrollUpdateNotification\" lib/`\n2. For each hit, read the callback (and any method it calls) for\n   `Posthog().capture`, your own capture wrapper, or an analytics `log` call.\nHas the problem: a capture call runs inside an `onChanged`, a\n`TextEditingController` / `ScrollController` listener, or a scroll-update\nhandler, without a once-only flag or debounce in front of it.\nDoesn't have it: every capture inside those callbacks sits behind a\nonce-per-visit flag, or is in `onChangeEnd` / a focus-lost handler /\n`ScrollEndNotification` instead.\n\n## Reproduce this\nPrerequisites: a Flutter app using\n[posthog_flutter](https://pub.dev/packages/posthog_flutter) (or another\nper-event-billed analytics SDK) with capture calls in widget callbacks.\n\nYour agent will need from you: which of the events are allowed to stay\nper-change (usually none); whether any event must carry the field's final\nvalue.\n\nSteps:\n1. Run the check above and list every capture inside `onChanged`, a\n   controller listener, or a scroll-update handler.\n2. Text fields: add a `bool _<field>InputFired = false;` to the screen state.\n   In `onChanged`, capture only `if (!_<field>InputFired)` and set the flag.\n   If the state object survives navigation between steps, put the flag there\n   and decide whether \"once\" means per visit or per flow.\n3. Tap/focus events: capture in a `FocusNode` listener only when\n   `hasFocus && !_tapFired`.\n4. Events that need the final value: capture in the `FocusNode` listener when\n   focus is lost (`!hasFocus`), not in `onChanged`.\n5. Sliders: move the capture from `onChanged` to `onChangeEnd`. Keep\n   `onChanged` for updating the UI only.\n6. Scrolls: capture from `NotificationListener<ScrollEndNotification>`,\n   never from `ScrollUpdateNotification` or a `ScrollController` listener.\n7. Keep event names and properties unchanged, so existing dashboards and\n   funnels keep working.\n\nVerify: run a debug build with `PostHogConfig.debug = true`. Type a 20-letter\nvalue into a fixed field: the log shows one `*_input` capture, not twenty.\nDrag a slider end to end: one event when you let go. In PostHog → Activity,\nthe event count per session for these events drops to 1.\n=== other notes\n---\n\n# Collecting leads from a static site with Apps Script and a honeypot\n\nI keep a small site for our family kennel. It is a static page: no server, no\ndatabase, no build step.\n\nThis year's litter sold out in August and the next one is a year or more away,\nso the site had nothing left to sell while people kept arriving from search and\nfrom Instagram and asking anyway. I wanted a waiting list.\n\nThe reflex at that point is to reach for infrastructure. An AWS account with a\nLambda and a table behind it. A Supabase project. A form service with a monthly\nbill. I have used all three, and each one is a thing you then own: credentials\nto rotate, a free tier that quietly changes, a dashboard to log into a year\nlater when you have forgotten how you wired it. For a kennel that produces a\nlitter every two years, that is not engineering. It is a subscription to future\nconfusion.\n\nThe answer was a spreadsheet, and I already had one. Google Apps Script turns\nit into an endpoint: Extensions, Apps Script, about twenty lines with a\n`doPost`, deploy it as a web app, and the sheet accepts POSTs, appends rows and\nemails me. Nothing to create, nothing to pay, no credentials in the page. The\ndata and the endpoint live in the same place, which is what I actually care\nabout in eighteen months when someone from that list writes back.\n\nTwo practical notes. A hidden field catches bots without a captcha. And the\nbrowser will not POST JSON to Apps Script directly, because it never answers the\nCORS preflight; sending it as `text/plain` with `no-cors` makes it a simple\nrequest and it goes through, at the cost of an opaque response. The sheet and\n---\n\n# Badges for your users' achievements — a self-updating SVG for any app\n\nYou know the little colored pills on GitHub READMEs — `build: passing`,\n`coverage: 98%`? That format is a tiny, perfect growth loop, and it works for\n*any* app that keeps a public stat per item. My site gives each developer story\na count of how many times a real person's agent reproduced it. That number is\nthe whole point — but it was trapped on my site. I wanted authors to be able to\npaste their proof onto their GitHub profile, where it does two jobs at once:\nshows off *their* achievement, and quietly links back to *my* site.\n\nSo I built an embeddable, self-updating SVG badge — one for a single item, one\nthat sums an author's whole profile. The nice surprise: **it needs no auth at\nall.** A badge has to be public to embed anywhere, and I only ever put already-\npublic numbers in it — so \"no login\" isn't a shortcut, it's the feature. That's\nwhat lets a user drop it in a README and lets that README render it for\neveryone.\n\nTwo things bit me, and they're the whole craft of this:\n\n- **Don't put a real ✓ (or ★, or ×) as a text glyph.** It renders fine for you\n  and shows up as a tofu box `□` for anyone whose renderer lacks that font\n  glyph. I drew the checkmark as an inline SVG `<path>` instead — guaranteed\n  everywhere.\n- **GitHub proxies and caches your image** (its \"camo\" layer). The count is\n  live at the source, but on a README it refreshes within the cache window, not\n  instantly — so send a sane `Cache-Control` and don't promise real-time.\n\nThe result: every item and every author now has a badge. I surfaced a","is_error":false}]},"parent_tool_use_id":null,"session_id":"8c28dfe9-c50e-47a3-a21e-593abbb971ae","uuid":"cb8fdbd4-9898-4a7a-b1e8-f4ae37beb1de","timestamp":"2026-10-20T23:45:55.286Z","tool_use_result":{"stdout