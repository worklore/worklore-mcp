oot and one for me, both had the line.\",\n        })\n        stored = app.publish(table, {\n            \"slug\": \"second-story\",\n            \"title\": \"Second\",\n            \"tags\": [\"cron\"],\n            \"body\": \"The cron line ran twice because two crontabs had it.\",\n        })\n        self.assertEqual([s[\"slug\"] for s in stored[\"similar\"]], [\"first-story\"])\n        self.assertIsInstance(stored[\"similar\"][0][\"score\"], Decimal)\n        self.assertEqual(table.scan()[\"Count\"], 2)\n\n    def test_related_scores_are_never_float(self):\n        existing = [\n            {\"slug\": f\"story-{i}\", \"tags\": [\"cron\"], \"body\": f\"cron words {i}\"}\n            for i in range(5)\n        ]\n        scored = app.related({\"slug\": \"new-story\", \"tags\": [\"cron\"], \"body\": \"cron words\"}, existing)\n        self.assertEqual(len(scored), app.TOP_N)\n        for s in scored:\n            self.assertIsInstance(s[\"score\"], Decimal)\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n","structuredPatch":[{"oldStart":1,"oldLines":6,"newStart":1,"newLines":7,"lines":[" import os"," import sys"," import unittest","+from decimal import Decimal"," "," sys.path.insert(0, os.path.join(os.path.dirname(__file__), \"..\", \"src\"))"," sys.path.insert(0, os.path.dirname(__file__))"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"tool_result_meta":[{"id":"toolu_01NkAu3CV7Js7DJDYujNgCej","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
