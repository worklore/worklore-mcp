iled ({e}) -> expired, reconnect\")\n                    c.update(status=\"expired, reconnect\", access_token=None)","new_string":"def store_connection(user_id, tok):\n    athlete = tok.get(\"athlete\") or {}\n    with LOCK:\n        CONNECTIONS[user_id] = {\n            \"athlete_id\": athlete.get(\"id\"), \"athlete_name\": athlete.get(\"name\"),\n            \"access_token\": tok[\"access_token\"], \"scope\": tok.get(\"scope\"), \"status\": \"connected\",\n        }\n    log(f\"{user_id}: connected as athlete {athlete.get('id')} (no expiry; valid until revoked)\")\n\n\ndef drop_connection(user_id, reason):\n    with LOCK:\n        c = CONNECTIONS.get(user_id)\n        if c:\n            c.update(access_token=None, status=\"reconnect required\")\n    log(f\"{user_id}: {reason} -> reconnect required\")"}}}
