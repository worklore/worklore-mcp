  ConditionExpression=\"attribute_exists(#slug)\",\n            ExpressionAttributeNames={\"#title\": \"title\", \"#slug\": \"slug\"},\n            ExpressionAttributeValues={\":t\": title},\n        )\n\n    def hide(self, slug, by):\n        \"\"\"Author withdraws a story: it stays in the table but leaves the feed.\"\"\"\n        self.table.update_item(\n            Key={\"slug\": slug},\n            UpdateExpression=\"SET #hidden = :h, hidden_by = :by, hidden_at = :t\",\n            ConditionExpression=\"attribute_exists(#slug)\",\n            ExpressionAttributeNames={\"#hidden\": \"hidden\", \"#slug\": \"slug\"},\n            ExpressionAttributeValues={\":h\": True, \":by\": by, \":t\": int(self.clock())},\n        )\n\n    def feed(self, limit=FEED_LIMIT):\n        \"\"\"Public feed: newest first, hidden stories excluded, bodies left out.\"\"\"\n        resp = self.table.scan(\n            ProjectionExpression=\"#slug, #title, #hidden, published_at\",\n            ExpressionAttributeNames={\"#slug\": \"slug\", \"#title\": \"title\", \"#hidden\": \"hidden\"},\n        )\n        items = [i for i in resp[\"Items\"] if not i.get(\"hidden\")]","originalFile":"\"\"\"storylib - the story library behind the public feed.\n\nThree operations: publish a story, hide one (the author withdraws it) and\nlist the public feed. Storage is a single DynamoDB table keyed by `slug`.\nThis module only talks to a boto3 Table resource; the tests hand it\ntests/fake_dynamo.FakeTable instead, and the HTTP handlers (api.py, in the\ninfra repo) hand it dynamo_table().\n\"\"\"\nimport os\nimport time\n\n\ndef dynamo_table():\n    \"\"\"The real table. boto3 is only installed on the servers.\"\"\"\n    import boto3\n    return boto3.resource(\"dynamodb\").Table(os.environ.get(\"STORIES_TABLE\", \"stories\"))\n\n\nclass StoryLibrary:\n    FEED_LIMIT = 50\n\n    def __init__(self, table, clock=time.time):\n        self.table = table\n        self.clock = clock\n\n    def publish(self, slug, title, body, author):\n        \"\"\"Create a story. Refuses to overwrite an existing slug.\"\"\"\n        self.table.put_item(\n            Item={\n                \"slug\": slug,\n                \"title\": title,\n                \"body\": body,\n                \"author\": author,\n                \"published_at\": int(self.clock()),\n                \"status\": \"published\",\n            },\n            ConditionExpression=\"attribute_not_exists(slug)\",\n        )\n\n    def get(self, slug):\n        return self.table.get_item(Key={\"slug\": slug}).get(\"Item\")\n\n    def rename(self, slug, title):\n        self.table.update_item(\n            Key={\"slug\": slug},\n            UpdateExpression=\"SET title = :t\",\n            ConditionExpression=\"attribute_exists(slug)\",\n            ExpressionAttributeValues={\":t\": title},\n        )\n\n    def hide(self, slug, by):\n        \"\"\"Author withdraws a story: it stays in the table but leaves the feed.\"\"\"\n        self.table.update_item(\n            Key={\"slug\": slug},\n            UpdateExpression=\"SET hidden = :h, hidden_by = :by, hidden_at = :t\",\n            ConditionExpression=\"attribute_exists(slug)\",\n            ExpressionAttributeValues={\":h\": True, \":by\": by, \":t\": int(self.clock())},\n        )\n\n    def feed(self, limit=FEED_LIMIT):\n        \"\"\"Public feed: newest first, hidden stories excluded, bodies left out.\"\"\"\n        resp = self.table.scan(ProjectionExpression=\"slug, title, hidden, published_at\")\n        items = [i for i in resp[\"Items\"] if not i.get(\"hidden\")]\n        items.sort(key=lambda i: i[\"published_at\"], reverse=True)\n        return [\n            {\"slug\": i[\"slug\"], \"title\": i[\"title\"], \"published_at\": i[\"published_at\"]}\n            for i in items[:limit]\n        ]\n\n    def archive(self, slug):\n        \"\"\"Editorial: take a published story out of circulation for good.\n        Not wired to the API yet (planned for the admin console).\"\"\"\n        self.table.update_item(\n            Key={\"slug\": slug},\n            UpdateExpression=\"SET archived_at = :t\",\n            ConditionExpression=\"status = :published\",\n            ExpressionAttributeValues={\":t\": int(self.clock()), \":published\": \"published\"},\n        )\n","structuredPatch":[{"oldStart":40,"oldLines":11,"newStart":40,"newLines":18,"lines":["     def get(self, slug):","         return self.table.get_item(Key={\"slug\": slug}).get(\"Item\")"," ","+    # Every attribute name in an expression goes through ExpressionAttributeNames","+    # (#alias), never bare. Several plain-looking names are DynamoDB reserved","+    # words (hidden, status, ...). A bare one makes UpdateItem/ConditionExpression","+    # fail with ValidationException, and makes a ProjectionExpression silently","+    # drop the attribute.","+","     def rename(self, slug, title):","         self.table.update_item(","             Key={\"slug\": slug},","-            UpdateExpression=\"SET title = :t\",","-            ConditionExpression=\"attribute_exists(slug)\",","+            UpdateExpression=\"SET #title = :t\",","+            ConditionExpression=\"attribute_exists(#slug)\",","+            ExpressionAttributeNames={\"#title\": \"title\", \"#slug\": \"slug\"},","             ExpressionAttributeValues={\":t\": title},","         )"," "]},{"oldStart":52,"oldLines":14,"newStart":59,"newLines":18,"lines":["         \"\"\"Author withdraws a story: it stays in the table but leaves the feed.\"\"\"","         self.table.update_item(","             Key={\"slug\": slug},","-            UpdateExpression=\"SET hidden = :h, hidden_by = :by, hidden_at = :t\",","-            ConditionExpression=\"attribute_exists(slug)\",","+            UpdateExpression=\"SET #hidden = :h, hidden_by = :by, hidden_at = :t\",","+            ConditionExpression=\"attribute_exists(#slug)\",","+            ExpressionAttributeNames={\"#hidden\": \"hidden\", \"#slug\": \"slug\"},","             ExpressionAttributeValues={\":h\": True, \":by\": by, \":t\": int(self.clock())},","         )"," ","     def feed(self, limit=FEED_LIMIT):","         \"\"\"Public feed: newest first, hidden stories excluded, bodies left out.\"\"\"","-        resp = self.table.scan(ProjectionExpression=\"slug, title, hidden, published_at\")","+        resp = self.table.scan(","+            ProjectionExpression=\"#slug, #title, #hidden, published_at\",","+            ExpressionAttributeNames={\"#slug\": \"slug\", \"#title\": \"title\", \"#hidden\": \"hidden\"},","+        )","         items = [i for i in resp[\"Items\"] if not i.get(\"hidden\")]","         items.sort(key=lambda i: i[\"published_at\"], reverse=True)","         return ["]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"tool_result_meta":[{"id":"toolu_01V2jQm5GgaUSpKcoBKM81Rs","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
