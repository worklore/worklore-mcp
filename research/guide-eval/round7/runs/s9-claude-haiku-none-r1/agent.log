,\n        )\n        self.assertEqual(self.lib.feed(), [])\n\n    def test_archive_sets_archived_at(self):\n        # Regression: `status` is reserved too; the condition used to be rejected.\n        self.lib.publish(\"hello\", \"Hello\", \"...\", \"ann\")\n        self.lib.archive(\"hello\")\n        self.assertEqual(self.lib.get(\"hello\")[\"archived_at\"], self.now)\n","originalFile":"import os\nimport sys\nimport unittest\n\nROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nsys.path.insert(0, ROOT)\n\nfrom src.app import StoryLibrary  # noqa: E402\nfrom tests.fake_dynamo import ClientError, FakeTable  # noqa: E402\n\n\nclass FeedTests(unittest.TestCase):\n    def setUp(self):\n        self.now = 1_700_000_000\n        self.lib = StoryLibrary(FakeTable(), clock=lambda: self.now)\n\n    def test_publish_then_feed_lists_it(self):\n        self.lib.publish(\"hello\", \"Hello\", \"first post\", \"ann\")\n        self.assertEqual([s[\"slug\"] for s in self.lib.feed()], [\"hello\"])\n\n    def test_feed_is_newest_first(self):\n        self.lib.publish(\"old\", \"Old\", \"...\", \"ann\")\n        self.now += 60\n        self.lib.publish(\"new\", \"New\", \"...\", \"bob\")\n        self.assertEqual([s[\"slug\"] for s in self.lib.feed()], [\"new\", \"old\"])\n\n    def test_feed_leaves_bodies_out(self):\n        self.lib.publish(\"hello\", \"Hello\", \"a long body\", \"ann\")\n        self.assertEqual(set(self.lib.feed()[0]), {\"slug\", \"title\", \"published_at\"})\n\n    def test_publish_twice_is_rejected(self):\n        self.lib.publish(\"hello\", \"Hello\", \"...\", \"ann\")\n        with self.assertRaises(ClientError) as cm:\n            self.lib.publish(\"hello\", \"Hello again\", \"...\", \"ann\")\n        self.assertEqual(cm.exception.response[\"Error\"][\"Code\"], \"ConditionalCheckFailedException\")\n\n    def test_rename(self):\n        self.lib.publish(\"hello\", \"Hello\", \"...\", \"ann\")\n        self.lib.rename(\"hello\", \"Hello, world\")\n        self.assertEqual(self.lib.get(\"hello\")[\"title\"], \"Hello, world\")\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n","structuredPatch":[{"oldStart":39,"oldLines":6,"newStart":39,"newLines":33,"lines":["         self.lib.rename(\"hello\", \"Hello, world\")","         self.assertEqual(self.lib.get(\"hello\")[\"title\"], \"Hello, world\")"," ","+    def test_hide_removes_story_from_feed(self):","+        # Regression: `hidden` is a DynamoDB reserved word; hide() used to 500 on it.","+        self.lib.publish(\"old\", \"Old\", \"...\", \"ann\")","+        self.lib.publish(\"hello\", \"Hello\", \"...\", \"ann\")","+        self.lib.hide(\"hello\", by=\"ann\")","+        self.assertEqual([s[\"slug\"] for s in self.lib.feed()], [\"old\"])","+        self.assertTrue(self.lib.get(\"hello\")[\"hidden\"])","+        self.assertEqual(self.lib.get(\"hello\")[\"hidden_by\"], \"ann\")"," ","+    def test_story_hidden_outside_the_library_leaves_feed(self):","+        # Regression: feed() projected `hidden` bare, which DynamoDB (and the fake)","+        # silently drops, so a story hidden with the AWS CLI stayed in the feed.","+        self.lib.publish(\"hello\", \"Hello\", \"...\", \"ann\")","+        self.lib.table.update_item(","+            Key={\"slug\": \"hello\"},","+            UpdateExpression=\"SET #h = :t\",","+            ExpressionAttributeNames={\"#h\": \"hidden\"},","+            ExpressionAttributeValues={\":t\": True},","+        )","+        self.assertEqual(self.lib.feed(), [])","+","+    def test_archive_sets_archived_at(self):","+        # Regression: `status` is reserved too; the condition used to be rejected.","+        self.lib.publish(\"hello\", \"Hello\", \"...\", \"ann\")","+        self.lib.archive(\"hello\")","+        self.assertEqual(self.lib.get(\"hello\")[\"archived_at\"], self.now)","+","+"," if __name__ == \"__main__\":","     unittest.main()"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"tool