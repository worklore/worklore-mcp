{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NRd6A8fsg1ke2Z7ZMbaPL5","type":"tool_result","content":"diff --git a/src/app.py b/src/app.py\nindex 963b0b5..f3fc4af 100644\n--- a/src/app.py\n+++ b/src/app.py\n@@ -40,11 +40,18 @@ class StoryLibrary:\n     def get(self, slug):\n         return self.table.get_item(Key={\"slug\": slug}).get(\"Item\")\n \n+    # Every attribute name in an expression goes through ExpressionAttributeNames\n+    # (#alias), never bare. Several plain-looking names are DynamoDB reserved\n+    # words (hidden, status, ...). A bare one makes UpdateItem/ConditionExpression\n+    # fail with ValidationException, and makes a ProjectionExpression silently\n+    # drop the attribute.\n+\n     def rename(self, slug, title):\n         self.table.update_item(\n             Key={\"slug\": slug},\n-            UpdateExpression=\"SET title = :t\",\n-            ConditionExpression=\"attribute_exists(slug)\",\n+            UpdateExpression=\"SET #title = :t\",\n+            ConditionExpression=\"attribute_exists(#slug)\",\n+            ExpressionAttributeNames={\"#title\": \"title\", \"#slug\": \"slug\"},\n             ExpressionAttributeValues={\":t\": title},\n         )\n \n@@ -52,14 +59,18 @@ class StoryLibrary:\n         \"\"\"Author withdraws a story: it stays in the table but leaves the feed.\"\"\"\n         self.table.update_item(\n             Key={\"slug\": slug},\n-            UpdateExpression=\"SET hidden = :h, hidden_by = :by, hidden_at = :t\",\n-            ConditionExpression=\"attribute_exists(slug)\",\n+            UpdateExpression=\"SET #hidden = :h, #by = :by, #at = :t\",\n+            ConditionExpression=\"attribute_exists(#slug)\",\n+            ExpressionAttributeNames={\"#hidden\": \"hidden\", \"#by\": \"hidden_by\", \"#at\": \"hidden_at\", \"#slug\": \"slug\"},\n             ExpressionAttributeValues={\":h\": True, \":by\": by, \":t\": int(self.clock())},\n         )\n \n     def feed(self, limit=FEED_LIMIT):\n         \"\"\"Public feed: newest first, hidden stories excluded, bodies left out.\"\"\"\n-        resp = self.table.scan(ProjectionExpression=\"slug, title, hidden, published_at\")\n+        resp = self.table.scan(\n+            ProjectionExpression=\"#slug, #title, #hidden, published_at\",\n+            ExpressionAttributeNames={\"#slug\": \"slug\", \"#title\": \"title\", \"#hidden\": \"hidden\"},\n+        )\n         items = [i for i in resp[\"Items\"] if not i.get(\"hidden\")]\n         items.sort(key=lambda i: i[\"published_at\"], reverse=True)\n         return [\n@@ -72,7 +83,8 @@ class StoryLibrary:\n         Not wired to the API yet (planned for the admin console).\"\"\"\n         self.table.update_item(\n             Key={\"slug\": slug},\n-            UpdateExpression=\"SET archived_at = :t\",\n-            ConditionExpression=\"status = :published\",\n+            UpdateExpression=\"SET #archived = :t\",\n+            ConditionExpression=\"#status = :published\",\n+            ExpressionAttributeNames={\"#archived\": \"archived_at\", \"#status\": \"status\"},\n             ExpressionAttributeValues={\":t\": int(self.clock()), \":published\": \"published\"},\n         )\n M src/app.py\n M tests/test_feed.py","is_error":false}]},"parent_tool_use_id":null,"session_id":"50e533c2-7a37-477b-ae04-6be871ff3d2a","uuid":"61608b72-23ff-491e-a946-93d6c50e415b","timestamp":"2026-10-20T23:24:07.461Z","tool_use_result":{"stdout":"diff --git a/src/app.py b/src/app.py\nindex 963b0b5..f3fc4af 100644\n--- a/src/app.py\n+++ b/src/app.py\n@@ -40,11 +40,18 @@ class StoryLibrary:\n     def get(self, slug):\n         return self.table.get_item(Key={\"slug\": slug}).get(\"Item\")\n \n+    # Every attribute name in an expression goes through ExpressionAttributeNames\n+    # (#alias), never bare. Several plain-looking names are DynamoDB reserved\n+    # words (hidden, status, ...). A bare one makes UpdateItem/ConditionExpression\n+    # fail with ValidationException, and mak