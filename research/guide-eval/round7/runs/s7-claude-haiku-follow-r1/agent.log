{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013YQcSeRHtYwTzXCr1yNV9p","type":"tool_result","content":"# tricoach\n\nBackend + single-page app for a small triathlon coaching practice. Coaches\nplan the week; athletes see it and connect their Intervals.icu account so the\napp can read wellness data and push planned workouts to their calendar. The\nathlete signs in to tricoach (token in `localStorage`, sent as\n`Authorization: Bearer` by the SPA's fetch wrapper), then clicks\n\"Connect Intervals.icu\", which runs the OAuth flow against Intervals.\n\n`server.py` is stdlib only (`python3 server.py`, port 8766) and keeps\neverything in memory; the shape is the same as the Postgres tables in prod.\nDev sign-in tokens: `tok-okafor` (default in the SPA) and `tok-rivera`.\n`config.py` holds the OAuth client placeholders. `logs/` has what we captured\nwhile looking into the connection problems.\n---CONFIG\nimport os\n\nPORT = 8766\nAPP_SECRET = \"dev-only-change-me-7c1f0a\"          # signs the OAuth state parameter\n\n# Intervals.icu OAuth client (placeholders; the real pair is in the deploy env)\nINTERVALS_BASE = os.environ.get(\"INTERVALS_BASE\", \"https://intervals.icu\")\nCLIENT_ID = \"tricoach-dev\"\nCLIENT_SECRET = \"s3cr3t-placeholder-0000\"\nREDIRECT_URI = f\"http://localhost:{PORT}/api/intervals/callback\"\nSCOPES = \"ACTIVITY:READ,ACTIVITY:WRITE,WELLNESS:READ,CALENDAR:READ,CALENDAR:WRITE\"\n\nREFRESH_INTERVAL = 60      # seconds between passes of the token refresher\n---SERVER\n     1\t#!/usr/bin/env python3\n     2\t\"\"\"tricoach backend: sign-in, Intervals.icu OAuth connection, wellness proxy.\n     3\t\n     4\tStdlib only. State is in memory (same shape as the prod tables).\n     5\t\"\"\"\n     6\timport base64, hashlib, hmac, json, os, threading, time\n     7\timport urllib.error, urllib.parse, urllib.request\n     8\tfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\n     9\t\n    10\timport config\n    11\t\n    12\tSTATIC = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"static\")\n    13\tTOKEN_URL = config.INTERVALS_BASE + \"/api/oauth/token\"\n    14\tAUTHORIZE_URL = config.INTERVALS_BASE + \"/oauth/authorize\"\n    15\tDEFAULT_TOKEN_TTL = 3600   # seconds; used when the provider does not say how long a token lives\n    16\t\n    17\t# --- in-memory store -------------------------------------------------------\n    18\tUSERS = {\n    19\t    \"tok-okafor\": {\"id\": \"u_okafor\", \"name\": \"C. Okafor\"},\n    20\t    \"tok-rivera\": {\"id\": \"u_rivera\", \"name\": \"T. Rivera\"},\n    21\t}\n    22\t# user_id -> {athlete_id, athlete_name, access_token, refresh_token, scope, expires_at, status}\n    23\tCONNECTIONS = {}\n    24\tLOCK = threading.Lock()\n    25\t\n    26\t\n    27\tdef log(msg):\n    28\t    print(time.strftime(\"%Y-%m-%d %H:%M:%S\"), \"[intervals]\", msg, flush=True)\n    29\t\n    30\t\n    31\t# --- state parameter: carries the user through the redirect -----------------\n    32\tdef sign_state(user_id):\n    33\t    payload = f\"{user_id}:{int(time.time())}\"\n    34\t    sig = hmac.new(config.APP_SECRET.encode(), payload.encode(), hashlib.sha256).hexdigest()[:32]\n    35\t    return base64.urlsafe_b64encode(f\"{payload}:{sig}\".encode()).decode()\n    36\t\n    37\t\n    38\tdef verify_state(state, max_age=900):\n    39\t    try:\n    40\t        user_id, ts, sig = base64.urlsafe_b64decode(state.encode()).decode().split(\":\")\n    41\t    except Exception:\n    42\t        return None\n    43\t    payload = f\"{user_id}:{ts}\"\n    44\t    good = hmac.new(config.APP_SECRET.encode(), payload.encode(), hashlib.sha256).hexdigest()[:32]\n    45\t    if not hmac.compare_digest(good, sig) or time.time() - int(ts) > max_age:\n    46\t        return None\n    47\t    return user_id\n    48\t\n    49\t\n    50\t# --- Intervals.icu calls ----------------------------------------------------\n    51\tdef post_form(url, fields):\n    52\t    data = urllib.parse.urlencode(fields).encode()\n    53\t    req = urllib.request.Request(url, data=data, headers={\"Accept\": \"application/json\"})\n    54\t    with urllib.request.urlopen(req, timeout=15) as r:\n    55\t        return json.loads(r.read().decode())\n    56\t\n    57\t\n    58\tdef exchange_code(code):\n    59\t    return post_form(TOKEN_URL, {\n    60\t        \"grant_type\": \"authorization_code\", \"client_id\": config.CLIENT_ID,\n    61\t        \"client_secret\": config.CLIENT_SECRET, \"code\": code, \"redirect_uri\": config.REDIRECT_URI,\n    62\t    })\n    63\t\n    64\t\n    65\tdef store_connection(user_id, tok):\n    66\t    expires_in = int(tok.get(\"expires_in\") or DEFAULT_TOKEN_TTL)\n    67\t    refresh = tok.get(\"refresh_token\")\n    68\t    if not refresh:\n    69\t        log(f\"{user_id}: no refresh_token in response, scheduling expiry in {expires_in}s\")\n    70\t    athlete = tok.get(\"athlete\") or {}\n    71\t    with LOCK:\n    72\t        CONNECTIONS[user_id] = {\n    73\t            \"athlete_id\": athlete.get(\"id\"), \"athlete_name\": athlete.get(\"name\"),\n    74\t            \"access_token\": tok[\"access_token\"], \"refresh_token\": refresh,\n    75\t            \"scope\": tok.get(\"scope\"), \"expires_at\": time.time() + expires_in, \"status\": \"connected\",\n    76\t        }\n    77\t    log(f\"{user_id}: connected as athlete {athlete.get('id')} (expires in {expires_in}s)\")\n    78\t\n    79\t\n    80\tdef refresh_tokens():\n    81\t    \"\"\"Background pass: renew access tokens shortly before they expire.\"\"\"\n    82\t    while True:\n    83\t        time.sleep(config.REFRESH_INTERVAL)\n    84\t        now = time.time()\n    85\t        with LOCK:\n    86\t            for uid, c in CONNECTIONS.items():\n    87\t                if c[\"status\"] != \"connected\" or c[\"expires_at\"] - now > 300:\n    88\t                    continue\n    89\t                if not c[\"refresh_token\"]:\n    90\t                    log(f\"{uid}: token expiry passed and no refresh token on file -> expired, reconnect\")\n    91\t                    c.update(status=\"expired, reconnect\", access_token=None)\n    92\t                    continue\n    93\t                try:\n    94\t                    tok = post_form(TOKEN_URL, {\n    95\t                        \"grant_type\": \"refresh_token\", \"refresh_token\": c[\"refresh_token\"],\n    96\t                        \"client_id\": config.CLIENT_ID, \"client_secret\": config.CLIENT_SECRET,\n    97\t                    })\n    98\t                    c.update(access_token=tok[\"access_token\"],\n    99\t                             refresh_token=tok.get(\"refresh_token\", c[\"refresh_token\"]),\n   100\t                             expires_at=now + int(tok[\"expires_in\"]))\n   101\t                    log(f\"{uid}: token refreshed\")\n   102\t                except Exception as e:\n   103\t                    log(f\"{uid}: refresh failed ({e}) -> expired, reconnect\")\n   104\t                    c.update(status=\"expired, reconnect\", access_token=None)\n   105\t\n   106\t\n   107\tdef intervals_get(conn, path):\n   108\t    req = urllib.request.Request(f\"{config.INTERVALS_BASE}/api/v1/athlete/{conn['athlete_id']}{path}\",\n   109\t                                 headers={\"Authorization\": \"Bearer \" + conn[\"access_token\"]})\n   110\t    with urllib.request.urlopen(req, timeout=15) as r:\n   111\t        return r.status, json.loads(r.read().decode())\n   112\t\n   113\t\n   114\t# --- HTTP ---------------------------------------------------------------------\n   115\tclass Handler(BaseHTTPRequestHandler):\n   116\t    def log_message(self, fmt, *args):\n   117\t        print(time.strftime(\"%Y-%m-%d %H:%M:%S\"), \"[http]\", fmt % args, flush=True)\n   118\t\n   119\t    def send_json(self, code, obj):\n   120\t        body = json.dumps(obj).encode()\n   121\t        self.send_response(code)\n   122\t        self.send_header(\"Content-Type\", \"application/json\")\n   123\t        self.send_header(\"Content-Length\", str(len(body)))\n   124\t        self.end_headers()\n   125\t        self.wfile.write(body)\n   126\t\n   127\t    def send_file(self, name, ctype):\n   128\t        p = os.path.join(STATIC, name)\n   129\t        if not os.path.isfile(p):\n   130\t            return self.send_json(404, {\"error\": \"not found\"})\n   131\t        with open(p, \"rb\") as f:\n   132\t            body = f.read()\n   133\t        self.send_response(200)\n   134\t        self.send_header(\"Content-Type\", ctype)\n   135\t        self.send_header(\"Content-Length\", str(len(body)))\n   136\t        self.end_headers()\n   137\t        self.wfile.write(body)\n   138\t\n   139\t    def redirect(self, url):\n   140\t        self.send_response(302)\n   141\t        self.send_header(\"Location\", url)\n   142\t        self.end_headers()\n   143\t\n   144\t    def current_user(self):\n   145\t        auth = self.headers.get(\"Authorization\", \"\")\n   146\t        if not auth.startswith(\"Bearer \"):\n   147\t            return None\n   148\t        return USERS.get(auth[7:].strip())\n   149\t\n   150\t    def require_user(self):\n   151\t        user = self.current_user()\n   152\t        if user is None:\n   153\t            self.log_message(\"%s %s 401 (no Authorization header)\", self.command, self.path)\n   154\t            self.send_json(401, {\"error\": \"unauthorized\"})\n   155\t        return user\n   156\t\n   157\t    def do_GET(self):\n   158\t        url = urllib.parse.urlsplit(self.path)\n   159\t        q = dict(urllib.parse.parse_qsl(url.query))\n   160\t        if url.path == \"/\":\n   161\t            return self.send_file(\"index.html\", \"text/html; charset=utf-8\")\n   162\t        if url.path.startswith(\"/static/\"):\n   163\t            return self.send_file(os.path.basename(url.path), \"application/javascript\" if url.path.endswith(\".js\") else \"text/plain\")\n   164\t        if url.path == \"/api/me\":\n   165\t            user = self.require_user()\n   166\t            return user and self.send_json(200, user)\n   167\t        if url.path == \"/api/intervals/auth/init\":\n   168\t            return self.auth_init()\n   169\t        if url.path == \"/api/intervals/callback\":\n   170\t            return self.callback(q)\n   171\t        if url.path == \"/api/intervals/status\":\n   172\t            return self.status()\n   173\t        if url.path == \"/api/intervals/wellness\":\n   174\t            return self.wellness()\n   175\t        self.send_json(404, {\"error\": \"not found\"})\n   176\t\n   177\t    def do_POST(self):\n   178\t        url = urllib.parse.urlsplit(self.path)\n   179\t        if url.path == \"/api/intervals/disconnect\":\n   180\t            user = self.require_user()\n   181\t            if user:\n   182\t                with LOCK:\n   183\t                    CONNECTIONS.pop(user[\"id\"], None)\n   184\t                self.send_json(200, {\"ok\": True})\n   185\t            return\n   186\t        self.send_json(404, {\"error\": \"not found\"})\n   187\t\n   188\t    # Step 1: build the authorize URL and send the browser to Intervals.\n   189\t    def auth_init(self):\n   190\t        user = self.require_user()\n   191\t        if not user:\n   192\t            return\n   193\t        params = {\"client_id\": config.CLIENT_ID, \"redirect_uri\": config.REDIRECT_URI,\n   194\t                  \"scope\": config.SCOPES, \"state\": sign_state(user[\"id\"])}\n   195\t        self.redirect(AUTHORIZE_URL + \"?\" + urllib.parse.urlencode(params, safe=\":,\"))\n   196\t\n   197\t    # Step 2: Intervals redirects back here with ?code=&state=.\n   198\t    def callback(self, q):\n   199\t        user_id = verify_state(q.get(\"state\", \"\"))\n   200\t        if not user_id or not q.get(\"code\"):\n   201\t            return self.send_json(400, {\"error\": \"bad state or code\"})\n   202\t        try:\n   203\t            tok = exchange_code(q[\"code\"])\n   204\t            store_connection(user_id, tok)\n   205\t        except urllib.error.HTTPError as e:\n   206\t            log(f\"{user_id}: token exchange failed: HTTP {e.code} {e.read()[:200]!r}\")\n   207\t            return self.send_json(502, {\"error\": \"token exchange failed\"})\n   208\t        except Exception as e:\n   209\t            log(f\"{user_id}: token exchange failed: {e}\")\n   210\t            return self.send_json(502, {\"error\": \"token exchange failed\"})\n   211\t        self.redirect(\"/?connected=1\")\n   212\t\n   213\t    def status(self):\n   214\t        user = self.require_user()\n   215\t        if not user:\n   216\t            return\n   217\t        with LOCK:\n   218\t            c = CONNECTIONS.get(user[\"id\"])\n   219\t        if not c or c[\"status\"] != \"connected\":\n   220\t            return self.send_json(200, {\"connected\": False, \"status\": c[\"status\"] if c else \"disconnected\"})\n   221\t        self.send_json(200, {\"connected\": True, \"status\": \"connected\", \"scope\": c[\"scope\"],\n   222\t                             \"athlete\": {\"id\": c[\"athlete_id\"], \"name\": c[\"athlete_name\"]}})\n   223\t\n   224\t    def wellness(self):\n   225\t        user = self.require_user()\n   226\t        if not user:\n   227\t            return\n   228\t        with LOCK:\n   229\t            c = CONNECTIONS.get(user[\"id\"])\n   230\t        if not c or c[\"status\"] != \"connected\":\n   231\t            return self.send_json(409, {\"error\": \"intervals not connected\"})\n   232\t        try:\n   233\t            code, data = intervals_get(c, \"/wellness\")\n   234\t            self.send_json(code, data)\n   235\t        except urllib.error.HTTPError as e:\n   236\t            self.send_json(e.code, {\"error\": f\"intervals returned {e.code}\"})\n   237\t        except Exception as e:\n   238\t            self.send_json(502, {\"error\": str(e)})\n   239\t\n   240\t\n   241\tif __name__ == \"__main__\":\n   242\t    threading.Thread(target=refresh_tokens, daemon=True).start()\n   243\t    log(f\"serving on http://localhost:{config.PORT} (intervals: {config.INTERVALS_BASE})\")\n   244\t    ThreadingHTTPServer((\"127.0.0.1\", config.PORT), Handler).serve_forever()","is_error":false}]},"parent_tool_use_id":null,"session_id":"41dddc1f-8fb6-4204-aee7-77c938fb5338","uuid":"3646c85d-ea0c-40a0-9cfe-0ac6a2a0c7b3","timestamp":"2026-10-20T23:28:53.990Z","tool_use_result":{"stdout":"# tricoach\n\nBackend + single-page app for a small triathlon coaching practice. Coaches\nplan the week; athletes see it and connect their Intervals.icu account so the\napp can read wellness data and push planned workouts to their calendar. The\nathlete signs in to tricoach (token in `localStorage`, sent as\n`Authorization: Bearer` by the SPA's fetch wrapper), then clicks\n\"Connect Intervals.icu\", which runs the OAuth flow against Intervals.\n\n`server.py` is stdlib only (`python3 server.py`, port 8766) and keeps\neverything in memory; the shape is the same as the Postgres tables in prod.\nDev sign-in tokens: `tok-okafor` (default in the SPA) and `tok-rivera`.\n`config.py` holds the OAuth client placeholders. `logs/` has what we captured\nwhile looking into the connection problems.\n---CONFIG\nimport os\n\nPORT = 8766\nAPP_SECRET = \"dev-only-change-me-7c1f0a\"          # signs the OAuth state parameter\n\n# Intervals.icu OAuth client (placeholders; the real pair is in the deploy env)\nINTERVALS_BASE = os.environ.get(\"INTERVALS_BASE\", \"https://intervals.icu\")\nCLIENT_ID = \"tricoach-dev\"\nCLIENT_SECRET = \"s3cr3t-placeholder-0000\"\nREDIRECT_URI = f\"http://localhost:{PORT}/api/intervals/callback\"\nSCOPES = \"ACTIVITY:READ,ACTIVITY:WRITE,WELLNESS:READ,CALENDAR:READ,CALENDAR:WRITE\"\n\nREFRESH_INTERVAL = 60      # seconds between passes of the token refresher\n---SERVER\n     1\t#!/usr/bin/env python3\n     2\t\"\"\"tricoach backend: sign-in, Intervals.icu OAuth connection, wellness proxy.\n     3\t\n     4\tStdlib only. State is in memory (same shape as the prod tables).\n     5\t\"\"\"\n     6\timport base64, hashlib, hmac, json, os, threading, time\n     7\timport urllib.error, urllib.parse, urllib.request\n     8\tfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\n     9\t\n    10\timport config\n    11\t\n    12\tSTATIC = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"static\")\n    13\tTOKEN_URL = config.INTERVALS_BASE + \"/api/oauth/token\"\n    14\tAUTHORIZE_URL = config.INTERVALS_BASE + \"/oauth/authorize\"\n    15\tDEFAULT_TOKEN_TTL = 3600   # seconds; used when the provider does not say how long a token lives\n    16\t\n    17\t# --- in-memory store -------------------------------------------------------\n    18\tUSERS = {\n    19\t    \"tok-okafor\": {\"id\": \"u_okafor\", \"name\": \"C. Okafor\"},\n    20\t    \"tok-rivera\": {\"id\": \"u_rivera\", \"name\": \"T. Rivera\"},\n    21\t}\n    22\t# user_id -> {athlete_id, athlete_name, access_token, refresh_token, scope, expires_at, status}\n    23\tCONNECTIONS = {}\n    24\tLOCK = threading.Lock()\n    25\t\n    26\t\n    27\tdef log(msg):\n    28\t    print(time.strftime(\"%Y-%m-%d %H:%M:%S\"), \"[intervals]\", msg, flush=True)\n    29\t\n    30\t\n    31\t# --- state parameter: carries the user through the redirect -----------------\n    32\tdef sign_state(user_id):\n    33\t    payload = f\"{user_id}:{int(time.time())}\"\n    34\t    sig = hmac.new(config.APP_SECRET.encode(), payload.encode(), hashlib.sha256).hexdigest()[:32]\n    35\t    return base64.urlsafe_b64encode(f\"{payload}:{sig}\".encode()).decode()\n    36\t\n    37\t\n    38\tdef verify_state(state, max_age=900):\n    39\t    try:\n    40\t        user_id, ts, sig = base64.urlsafe_b64decode(state.encode()).decode().split(\":\")\n    41\t    except Exception:\n    42\t        return None\n    43\t    payload = f\"{user_id}:{ts}\"\n    44\t    good = hmac.new(config.APP_SECRET.encode(), payload.encode(), hashlib.sha256).hexdigest()[:32]\n    45\t    if not hmac.compare_digest(good, sig) or time.time() - int(ts) > max_age:\n    46\t        return None\n    47\t    return user_id\n    48\t\n    49\t\n    50\t# --- Intervals.icu calls ----------------------------------------------------\n    51\tdef post_form(url, fields):\n    52\t    data = urllib.parse.urlencode(fields).encode()\n    53\t    req = urllib.request.Request(url, data=data, headers={\"Accept\": \"application/json\"})\n    54\t    with urllib.request.urlopen(req, timeout=15) as r:\n    55\t        return json.loads(r.read().decode())\n    56\t\n    57\t\n    58\tdef exchange_code(code):\n    59\t    return post_form(TOKEN_URL, {\n    60\t        \"grant_type\": \"authorization_code\", \"client_id\": config.CLIENT_ID,\n    61\t        \"client_secret\": config.CLIENT_SECRET, \"code\": code, \"redirect_uri\": config.REDIRECT_URI,\n    62\t    })\n    63\t\n    64\t\n    65\tdef store_connection(user_id, tok):\n    66\t    expires_in = int(tok.get(\"expires_in\") or DEFAULT_TOKEN_TTL)\n    67\t    refresh = tok.get(\"refresh_token\")\n    68\t    if not refresh:\n    69\t        log(f\"{user_id}: no refresh_token in response, scheduling expiry in {expires_in}s\")\n    70\t    athlete = tok.get(\"athlete\") or {}\n    71\t    with LOCK:\n    72\t        CONNECTIONS[user_id] = {\n    73\t            \"athlete_id\": athlete.get(\"id\"), \"athlete_name\": athlete.get(\"name\"),\n    74\t            \"access_token\": tok[\"access_token\"], \"refresh_token\": refresh,\n    75\t            \"scope\": tok.get(\"scope\"), \"expires_at\": time.time() + expires_in, \"status\": \"connected\",\n    76\t        }\n    77\t    log(f\"{user_id}: connected as athlete {athlete.get('id')} (expires in {expires_in}s)\")\n    78\t\n    79\t\n    80\tdef refresh_tokens():\n    81\t    \"\"\"Background pass: renew access tokens shortly before they expire.\"\"\"\n    82\t    while True:\n    83\t        time.sleep(config.REFRESH_INTERVAL)\n    84\t        now = time.time()\n    85\t        with LOCK:\n    86\t            for uid, c in CONNECTIONS.items():\n    87\t                if c[\"status\"] != \"connected\" or c[\"expires_at\"] - now > 300:\n    88\t                    continue\n    89\t                if not c[\"refresh_token\"]:\n    90\t                    log(f\"{uid}: token expiry passed and no refresh token on file -> expired, reconnect\")\n    91\t                    c.update(status=\"expired, reconnect\", access_token=None)\n    92\t                    continue\n    93\t                try:\n    94\t                    tok = post_form(TOKEN_URL, {\n    95\t                        \"grant_type\": \"refresh_token\", \"refresh_token\": c[\"refresh_token\"],\n    96\t                        \"client_id\": config.CLIENT_ID, \"client_secret\": config.CLIENT_SECRET,\n    97\t                    })\n    98\t                    c.update(access_token=tok[\"access_token\"],\n    99\t                             refresh_token=tok.get(\"refresh_token\", c[\"refresh_token\"]),\n   100\t                             expires_at=now + int(tok[\"expires_in\"]))\n   101\t                    log(f\"{uid}: token refreshed\")\n   102\t                except Exception as e:\n   103\t                    log(f\"{uid}: refresh failed ({e}) -> expired, reconnect\")\n   104\t                    c.update(status=\"expired, reconnect\", access_token=None)\n   105\t\n   106\t\n   107\tdef intervals_get(conn, path):\n   108\t    req = urllib.request.Request(f\"{config.INTERVALS_BASE}/api/v1/athlete/{conn['athlete_id']}{path}\",\n   109\t                                 headers={\"Authorization\": \"Bearer \" + conn[\"access_token\"]})\n   110\t    with urllib.request.urlopen(req, timeout=15) as r:\n   111\t        return r.status, json.loads(r.read().decode())\n   112\t\n   113\t\n   114\t# --- HTTP ---------------------------------------------------------------------\n   115\tclass Handler(BaseHTTPRequestHandler):\n   116\t    def log_message(self, fmt, *args):\n   117\t        print(time.strftime(\"%Y-%m-%d %H:%M:%S\"), \"[http]\", fmt % args, flush=True)\n   118\t\n   119\t    def send_json(self, code, obj):\n   120\t        body = json.dumps(obj).encode()\n   121\t        self.send_response(code)\n   122\t        self.send_header(\"Content-Type\", \"application/json\")\n   123\t        self.send_header(\"Content-Length\", str(len(body)))\n   124\t        self.end_headers()\n   125\t        self.wfile.write(body)\n   126\t\n   127\t    def send_file(self, name, ctype):\n   128\t        p = os.path.join(STATIC, name)\n   129\t        if not os.path.isfile(p):\n   130\t            return self.send_json(404, {\"error\": \"not found\"})\n   131\t        with open(p, \"rb\") as f:\n   132\t            body = f.read()\n   133\t        self.send_response(200)\n   134\t        self.send_header(\"Content-Type\", ctype)\n   135\t        self.send_header(\"Content-Length\", str(len(body)))\n   136\t        self.end_headers()\n   137\t        self.wfile.write(body)\n   138\t\n   139\t    def redirect(self, url):\n   140\t        self.send_response(302)\n   141\t        self.send_header(\"Location\", url)\n   142\t        self.end_headers()\n   143\t\n   144\t    def current_user(self):\n   145\t        auth = self.headers.get(\"Authorization\", \"\")\n   146\t        if not auth.startswith(\"Bearer \"):\n   147\t            return None\n   148\t        return USERS.get(auth[7:].strip())\n   149\t\n   150\t    def require_user(self):\n   151\t        user = self.current_user()\n   152\t        if user is None:\n   153\t            self.log_message(\"%s %s 401 (no Authorization header)\", self.command, self.path)\n   154\t            self.send_json(401, {\"error\": \"unauthorized\"})\n   155\t        return user\n   156\t\n   157\t    def do_GET(self):\n   158\t        url = urllib.parse.urlsplit(self.path)\n   159\t        q = dict(urllib.parse.parse_qsl(url.query))\n   160\t        if url.path == \"/\":\n   161\t            return self.send_file(\"index.html\", \"text/html; charset=utf-8\")\n   162\t        if url.path.startswith(\"/static/\"):\n   163\t            return self.send_file(os.path.basename(url.path), \"application/javascript\" if url.path.endswith(\".js\") else \"text/plain\")\n   164\t        if url.path == \"/api/me\":\n   165\t            user = self.require_user()\n   166\t            return user and self.send_json(200, user)\n   167\t        if url.path == \"/api/intervals/auth/init\":\n   168\t            return self.auth_init()\n   169\t        if url.path == \"/api/intervals/callback\":\n   170\t            return self.callback(q)\n   171\t        if url.path == \"/api/intervals/status\":\n   172\t            return self.status()\n   173\t        if url.path == \"/api/intervals/wellness\":\n   174\t            return self.wellness()\n   175\t        self.send_json(404, {\"error\": \"not found\"})\n   176\t\n   177\t    def do_POST(self):\n   178\t        url = urllib.parse.urlsplit(self.path)\n   179\t        if url.path == \"/api/intervals/disconnect\":\n   180\t            user = self.require_user()\n   181\t            if user:\n   182\t                with LOCK:\n   183\t                    CONNECTIONS.pop(user[\"id\"], None)\n   184\t                self.send_json(200, {\"ok\": True})\n   185\t            return\n   186\t        self.send_json(404, {\"error\": \"not found\"})\n   187\t\n   188\t    # Step 1: build the authorize URL and send the browser to Intervals.\n   189\t    def auth_init(self):\n   190\t        user = self.require_user()\n   191\t        if not user:\n   192\t            return\n   193\t        params = {\"client_id\": config.CLIENT_ID, \"redirect_uri\": config.REDIRECT_URI,\n   194\t                  \"scope\": config.SCOPES, \"state\": sign_state(user[\"id\"])}\n   195\t        self.redirect(AUTHORIZE_URL + \"?\" + urllib.parse.urlencode(params, safe=\":,\"))\n   196\t\n   197\t    # Step 2: Intervals redirects back here with ?code=&state=.\n   198\t    def callback(self, q):\n   199\t        user_id = verify_state(q.get(\"state\", \"\"))\n   200\t        if not user_id or not q.get(\"code\"):\n   201\t            return self.send_json(400, {\"error\": \"bad state or code\"})\n   202\t        try:\n   203\t            tok = exchange_code(q[\"code\"])\n   204\t            store_connection(user_id, tok)\n   205\t        except urllib.error.HTTPError as e:\n   206\t            log(f\"{user_id}: token exchange failed: HTTP {e.code} {e.read()[:200]!r}\")\n   207\t            return self.send_json(502, {\"error\": \"token exchange failed\"})\n   208\t        except Exception as e:\n   209\t            log(f\"{user_id}: token exchange failed: {e}\")\n   210\t            return self.send_json(502, {\"error\": \"token exchange failed\"})\n   211\t        self.redirect(\"/?connected=1\")\n   212\t\n   213\t    def status(self):\n   214\t        user = self.require_user()\n   215\t        if not user:\n   216\t            return\n   217\t        with LOCK:\n   218\t            c = CONNECTIONS.get(user[\"id\"])\n   219\t        if not c or c[\"status\"] != \"connected\":\n   220\t            return self.send_json(200, {\"connected\": False, \"status\": c[\"status\"] if c else \"disconnected\"})\n   221\t        self.send_json(200, {\"connected\": True, \"status\": \"connected\", \"scope\": c[\"scope\"],\n   222\t                             \"athlete\": {\"id\": c[\"athlete_id\"], \"name\": c[\"athlete_name\"]}})\n   223\t\n   224\t    def wellness(self):\n   225\t        user = self.require_user()\n   226\t        if not user:\n   227\t            return\n   228\t        with LOCK:\n   229\t            c = CONNECTIONS.get(user[\"id\"])\n   230\t        if not c or c[\"status\"] != \"connected\":\n   231\t            return self.send_json(409, {\"error\": \"intervals not connected\"})\n   232\t        try:\n   233\t            code, data = intervals_get(c, \"/wellness\")\n   234\t            self.send_json(code, data)\n   235\t        except urllib.error.HTTPError as e:\n   236\t            self.send_json(e.code, {\"error\": f\"intervals returned {e.code}\"})\n   237\t        except Exception as e:\n   238\t            self.send_json(502, {\"error\": str(e)})\n   239\t\n   240\t\n   241\tif __name__ == \"__main__\":\n   242\t    threading.Thread(target=refresh_tokens, daemon=True).start()\n   243\t    log(f\"serving on http://localhost:{config.PORT} (intervals: {config.INTERVALS_BASE})\")\n   244\t    ThreadingHTTPServer((\"127.0.0.1\", config.PORT), Handler).serve_forever()","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_013YQcSeRHtYwTzXCr1yNV9p","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
