+class HiddenTests(unittest.TestCase):
+    def setUp(self):
+        self.lib = StoryLibrary(FakeTable(), clock=lambda: 1_700_000_000)
+        self.lib.publish("a", "A", "...", "ann")
+        self.lib.publish("b", "B", "...", "bob")
+
+    def test_hide_removes_from_feed(self):
+        self.lib.hide("a", by="vk")
+        self.assertEqual([s["slug"] for s in self.lib.feed()], ["b"])
+        self.assertIs(self.lib.get("a")["hidden"], True)
+
+    def test_hand_hidden_story_is_excluded(self):
+        self.lib.table.update_item(
+            Key={"slug": "a"}, UpdateExpression="SET #h = :t",
+            ExpressionAttributeNames={"#h": "hidden"}, ExpressionAttributeValues={":t": True})
+        self.assertEqual([s["slug"] for s in self.lib.feed()], ["b"])
+
+    def test_archive_works(self):
+        self.lib.archive("a")
+        self.assertIn("archived_at", self.lib.get("a"))
+
+
