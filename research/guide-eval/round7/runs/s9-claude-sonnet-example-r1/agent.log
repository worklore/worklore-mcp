e item.\"\"\"\ntests/fake_dynamo.py:141:        if expr is not None and not _evaluate(names.validate(\"ConditionExpression\", expr), current, names, values or {}):\ntests/fake_dynamo.py:144:    def put_item(self, Item, ConditionExpression=None, ExpressionAttributeNames=None,\ntests/fake_dynamo.py:145:                 ExpressionAttributeValues=None, **_ignored):\ntests/fake_dynamo.py:146:        names = _Names(ExpressionAttributeNames, \"PutItem\")\ntests/fake_dynamo.py:147:        self._check(\"PutItem\", ConditionExpression, self._items.get(Item[self.key], {}), names, ExpressionAttributeValues)\ntests/fake_dynamo.py:152:    def get_item(self, Key, ProjectionExpression=None, ExpressionAttributeNames=None, **_ignored):\ntests/fake_dynamo.py:153:        names = _Names(ExpressionAttributeNames, \"GetItem\")\ntests/fake_dynamo.py:157:        item = self._project(copy.deepcopy(item), ProjectionExpression, names)\ntests/fake_dynamo.py:161:    def update_item(self, Key, UpdateExpression, ConditionExpression=None, ExpressionAttributeNames=None,\ntests/fake_dynamo.py:162:                    ExpressionAttributeValues=None, ReturnValues=None, **_ignored):\ntests/fake_dynamo.py:163:        names, values = _Names(ExpressionAttributeNames, \"UpdateItem\"), ExpressionAttributeValues or {}\ntests/fake_dynamo.py:164:        toks = names.validate(\"UpdateExpression\", UpdateExpression)\ntests/fake_dynamo.py:166:        self._check(\"UpdateItem\", ConditionExpression, current, names, values)\ntests/fake_dynamo.py:181:                names._invalid(\"UpdateExpression\", f\"fake_dynamo does not support this syntax near {t!r}\")\ntests/fake_dynamo.py:185:    def scan(self, ProjectionExpression=None, FilterExpression=None, ExpressionAttributeNames=None,\ntests/fake_dynamo.py:186:             ExpressionAttributeValues=None, **_ignored):\ntests/fake_dynamo.py:187:        names = _Names(ExpressionAttributeNames, \"Scan\")\ntests/fake_dynamo.py:190:        if FilterExpression:\ntests/fake_dyn