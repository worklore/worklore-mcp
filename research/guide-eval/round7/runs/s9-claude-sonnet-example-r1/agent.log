{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01N2g2dumK5oMtcVy8VLEWvJ","type":"tool_result","content":"\"\"\"storylib - the story library behind the public feed.\n\nThree operations: publish a story, hide one (the author withdraws it) and\nlist the public feed. Storage is a single DynamoDB table keyed by `slug`.\nThis module only talks to a boto3 Table resource; the tests hand it\ntests/fake_dynamo.FakeTable instead, and the HTTP handlers (api.py, in the\ninfra repo) hand it dynamo_table().\n\"\"\"\nimport os\nimport time\n\n\ndef dynamo_table():\n    \"\"\"The real table. boto3 is only installed on the servers.\"\"\"\n    import boto3\n    return boto3.resource(\"dynamodb\").Table(os.environ.get(\"STORIES_TABLE\", \"stories\"))\n\n\nclass StoryLibrary:\n    FEED_LIMIT = 50\n\n    def __init__(self, table, clock=time.time):\n        self.table = table\n        self.clock = clock\n\n    def publish(self, slug, title, body, author):\n        \"\"\"Create a story. Refuses to overwrite an existing slug.\"\"\"\n        self.table.put_item(\n            Item={\n                \"slug\": slug,\n                \"title\": title,\n                \"body\": body,\n                \"author\": author,\n                \"published_at\": int(self.clock()),\n                \"status\": \"published\",\n            },\n            ConditionExpression=\"attribute_not_exists(slug)\",\n        )\n\n    def get(self, slug):\n        return self.table.get_item(Key={\"slug\": slug}).get(\"Item\")\n\n    def rename(self, slug, title):\n        self.table.update_item(\n            Key={\"slug\": slug},\n            UpdateExpression=\"SET title = :t\",\n            ConditionExpression=\"attribute_exists(slug)\",\n            ExpressionAttributeValues={\":t\": title},\n        )\n\n    def hide(self, slug, by):\n        \"\"\"Author withdraws a story: it stays in the table but leaves the feed.\"\"\"\n        self.table.update_item(\n            Key={\"slug\": slug},\n            UpdateExpression=\"SET hidden = :h, hidden_by = :by, hidden_at = :t\",\n            ConditionExpression=\"attribute_exists(slug)\",\n            ExpressionAttributeValues={\":h\": True, \":by\": by, \":t\": int(self.clock())},\n        )\n\n    def feed(self, limit=FEED_LIMIT):\n        \"\"\"Public feed: newest first, hidden stories excluded, bodies left out.\"\"\"\n        resp = self.table.scan(ProjectionExpression=\"slug, title, hidden, published_at\")\n        items = [i for i in resp[\"Items\"] if not i.get(\"hidden\")]\n        items.sort(key=lambda i: i[\"published_at\"], reverse=True)\n        return [\n            {\"slug\": i[\"slug\"], \"title\": i[\"title\"], \"published_at\": i[\"published_at\"]}\n            for i in items[:limit]\n        ]\n\n    def archive(self, slug):\n        \"\"\"Editorial: take a published story out of circulation for good.\n        Not wired to the API yet (planned for the admin console).\"\"\"\n        self.table.update_item(\n            Key={\"slug\": slug},\n            UpdateExpression=\"SET archived_at = :t\",\n            ConditionExpression=\"status = :published\",\n            ExpressionAttributeValues={\":t\": int(self.clock()), \":published\": \"published\"},\n        )\n\"\"\"\nimport copy\nimport re\n\nRESERVED = frozenset(\"\"\"\nADD AND ATTRIBUTE BINARY BY COMMENT COUNT DATA DATE DAY DELETE FALSE FROM GROUP HIDDEN HOUR\nIN INDEX ITEM ITEMS KEY KEYS LEVEL LIST MAP MINUTE MONTH NAME NOT NULL NUMBER OF ON OR ORDER\nPRIVATE PUBLIC QUERY REMOVE ROLE SCAN SECOND SELECT SET SIMILAR SIZE STATE STATUS STRING TABLE\nTEXT TIMESTAMP TO TRUE TYPE UPDATE URL USER VALUE VALUES YEAR\n\"\"\".split())\n\n_KEYWORDS = {\"SET\", \"REMOVE\", \"ADD\", \"DELETE\", \"AND\", \"OR\", \"NOT\", \"BETWEEN\", \"IN\"}\n_OPERATORS = {\"=\", \"<>\", \"<\", \"<=\", \">\", \">=\", \"(\", \")\", \",\"}\nimport os\nimport sys\nimport unittest\n\nROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nsys.path.insert(0, ROOT)\n\nfrom src.app import StoryLibrary  # noqa: E402\nfrom tests.fake_dynamo import ClientError, FakeTable  # noqa: E402\n\n\nclass FeedTests(unittest.TestCase):\n    def setUp(self):\n        self.now = 1_700_000_000\n        self.lib = StoryLibrary(FakeTable(), clock=lambda: self.now)\n\n    def test_publish_then_feed_lists_it(self):\n        self.lib.publish(\"hello\", \"Hello\", \"first post\", \"ann\")\n        self.assertEqual([s[\"slug\"] for s in self.lib.feed()], [\"hello\"])\n\n    def test_feed_is_newest_first(self):\n        self.lib.publish(\"old\", \"Old\", \"...\", \"ann\")\n        self.now += 60\n        self.lib.publish(\"new\", \"New\", \"...\", \"bob\")\n        self.assertEqual([s[\"slug\"] for s in self.lib.feed()], [\"new\", \"old\"])\n\n    def test_feed_leaves_bodies_out(self):\n        self.lib.publish(\"hello\", \"Hello\", \"a long body\", \"ann\")\n        self.assertEqual(set(self.lib.feed()[0]), {\"slug\", \"title\", \"published_at\"})\n\n    def test_publish_twice_is_rejected(self):\n        self.lib.publish(\"hello\", \"Hello\", \"...\", \"ann\")\n        with self.assertRaises(ClientError) as cm:\n            self.lib.publish(\"hello\", \"Hello again\", \"...\", \"ann\")\n        self.assertEqual(cm.exception.response[\"Error\"][\"Code\"], \"ConditionalCheckFailedException\")\n\n    def test_rename(self):\n        self.lib.publish(\"hello\", \"Hello\", \"...\", \"ann\")\n        self.lib.rename(\"hello\", \"Hello, world\")\n        self.assertEqual(self.lib.get(\"hello\")[\"title\"], \"Hello, world\")","is_error":false}]},"parent_tool_use_id":null,"session_id":"880341ae-d94c-4f99-8525-f62773e6b5fa","uuid":"67b52a77-22a9-44d4-98f2-f1b84694a1e5","timestamp":"2026-10-20T23:26:12.945Z","tool_use_result":{"stdout":"\"\"\"storylib - the story library behind the public feed.\n\nThree operations: publish a story, hide one (the author withdraws it) and\nlist the public feed. Storage is a single DynamoDB table keyed by `slug`.\nThis module o