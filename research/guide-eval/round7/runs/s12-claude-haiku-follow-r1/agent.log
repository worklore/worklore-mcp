{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012QxPMyXXWPt2W9aogvRhRG","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"tasks-api: the backend of a small social to-do app (Python standard library only).\n3\t\n4\t    python3 api.py        # http://127.0.0.1:58246\n5\t\n6\tEvery request needs `Authorization: Bearer <token>`; the development tokens are in README.md.\n7\tA task is `private` (only its owner may see or touch it) or `public` (anyone may read, comment,\n8\tlike, view and nudge; only the owner may edit, delete or complete it).\n9\t\"\"\"\n10\timport json\n11\timport os\n12\timport re\n13\timport sys\n14\timport time\n15\tfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\n16\t\n17\tPORT = int(os.environ.get(\"PORT\", \"58246\"))\n18\t\n19\tUSERS = {  # token -> user id\n20\t    \"tok_alice_4f8c2e71b0\": \"alice\",\n21\t    \"tok_bob_9a1d7c3e55\": \"bob\",\n22\t}\n23\t\n24\tTASKS = {}\n25\tNEXT_ID = [1]\n26\t\n27\t\n28\tdef seed():\n29\t    \"\"\"Reset the in-memory store to the development data.\"\"\"\n30\t    TASKS.clear()\n31\t    NEXT_ID[0] = 1\n32\t    _add(\"alice\", \"Draft the investor update\", \"private\")\n33\t    _add(\"alice\", \"Water the office plants\", \"public\")\n34\t    _add(\"bob\", \"Book the team lunch\", \"public\")\n35\t\n36\t\n37\tdef _add(owner, title, visibility):\n38\t    tid = NEXT_ID[0]\n39\t    NEXT_ID[0] += 1\n40\t    TASKS[tid] = {\"id\": tid, \"owner\": owner, \"title\": title, \"visibility\": visibility,\n41\t                  \"done\": False, \"likes\": 0, \"views\": 0, \"nudges\": 0, \"comments\": []}\n42\t    return TASKS[tid]\n43\t\n44\t\n45\t# --- authorization helpers -------------------------------------------------\n46\t\n47\tdef can_access(user, task):\n48\t    \"\"\"May `user` see this task at all? Public tasks: everyone. Private tasks: the owner only.\"\"\"\n49\t    return task[\"visibility\"] == \"public\" or task[\"owner\"] == user\n50\t\n51\t\n52\tdef is_owner(user, task):\n53\t    return task[\"owner\"] == user\n54\t\n55\t\n56\t# --- HTTP ------------------------------------------------------------------\n57\t\n58\tROUTE = re.compile(r\"^/tasks/(\\d+)(?:/(comments|complete|nudge|like|view))?$\")\n59\t\n60\t\n61\tclass Handler(BaseHTTPRequestHandler):\n62\t    server_version = \"tasks-api/0.3\"\n63\t\n64\t    def log_message(self, fmt, *args):\n65\t        sys.stderr.write(\"%s %s\\n\" % (time.strftime(\"%H:%M:%S\"), fmt % args))\n66\t\n67\t    def send(self, code, body):\n68\t        data = json.dumps(body).encode()\n69\t        self.send_response(code)\n70\t        self.send_header(\"Content-Type\", \"application/json\")\n71\t        self.send_header(\"Content-Length\", str(len(data)))\n72\t        self.end_headers()\n73\t        self.wfile.write(data)\n74\t\n75\t    def user(self):\n76\t        auth = self.headers.get(\"Authorization\", \"\")\n77\t        if auth.startswith(\"Bearer \"):\n78\t            return USERS.get(auth[7:].strip())\n79\t        return None\n80\t\n81\t    def body(self):\n82\t        n = int(self.headers.get(\"Content-Length\") or 0)\n83\t        raw = self.rfile.read(n) if n else b\"\"\n84\t        if not raw:\n85\t            return {}\n86\t        try:\n87\t            data = json.loads(raw)\n88\t        except ValueError:\n89\t            raise ValueError(\"body is not valid JSON\")\n90\t        if not isinstance(data, dict):\n91\t            raise ValueError(\"body must be a JSON object\")\n92\t        return data\n93\t\n94\t    def dispatch(self, method):\n95\t        user = self.user()\n96\t        if user is None:\n97\t            return self.send(401, {\"error\": \"missing or unknown bearer token\"})\n98\t        path = self.path.split(\"?\", 1)[0].rstrip(\"/\") or \"/\"\n99\t        try:\n100\t            data = self.body() if method in (\"POST\", \"PATCH\") else {}\n101\t        except ValueError as e:\n102\t            return self.send(400, {\"error\": str(e)})\n103\t\n104\t        if path == \"/tasks\" and method == \"GET\":\n105\t            mine = [t for t in TASKS.values() if can_access(user, t)]\n106\t            return self.send(200, {\"tasks\": mine})\n107\t        if path == \"/tasks\" and method == \"POST\":\n108\t            title = data.get(\"title\")\n109\t            vis = data.get(\"visibility\", \"private\")\n110\t            if not isinstance(title, str) or not title.strip():\n111\t                return self.send(400, {\"error\": \"title is required\"})\n112\t            if vis not in (\"private\", \"public\"):\n113\t                return self.send(400, {\"error\": \"visibility must be private or public\"})\n114\t            return self.send(201, _add(user, title.strip(), vis))\n115\t\n116\t        m = ROUTE.match(path)\n117\t        if not m:\n118\t            return self.send(404, {\"error\": \"no such route\"})\n119\t        task = TASKS.get(int(m.group(1)))\n120\t        if task is None:\n121\t            return self.send(404, {\"error\": \"no such task\"})\n122\t        action = m.group(2)\n123\t\n124\t        if action is None:\n125\t            if method == \"GET\":\n126\t                if not can_access(user, task):\n127\t                    return self.send(403, {\"error\": \"forbidden\"})\n128\t                return self.send(200, task)\n129\t            if method == \"PATCH\":\n130\t                if not is_owner(user, task):\n131\t                    return self.send(403, {\"error\": \"only the owner may edit a task\"})\n132\t                for k in (\"title\", \"visibility\"):\n133\t                    if k in data:\n134\t                        task[k] = data[k]\n135\t                return self.send(200, task)\n136\t            if method == \"DELETE\":\n137\t                if not is_owner(user, task):\n138\t                    return self.send(403, {\"error\": \"only the owner may delete a task\"})\n139\t                del TASKS[task[\"id\"]]\n140\t                return self.send(200, {\"deleted\": task[\"id\"]})\n141\t            return self.send(405, {\"error\": \"method not allowed\"})\n142\t\n143\t        if method != \"POST\":\n144\t            return self.send(405, {\"error\": \"method not allowed\"})\n145\t        if action == \"comments\":\n146\t            if not can_access(user, task):\n147\t                return self.send(403, {\"error\": \"forbidden\"})\n148\t            text = data.get(\"text\")\n149\t            if not isinstance(text, str) or not text.strip():\n150\t                return self.send(400, {\"error\": \"text is required\"})\n151\t            task[\"comments\"].append({\"by\": user, \"text\": text.strip()})\n152\t            return self.send(201, task)\n153\t        if action == \"complete\":\n154\t            if not is_owner(user, task):\n155\t                return self.send(403, {\"error\": \"only the owner may complete a task\"})\n156\t            task[\"done\"] = True\n157\t            return self.send(200, task)\n158\t        if action == \"nudge\":\n159\t            if not can_access(user, task):\n160\t                return self.send(403, {\"error\": \"forbidden\"})\n161\t            task[\"nudges\"] += 1\n162\t            return self.send(200, {\"id\": task[\"id\"], \"nudges\": task[\"nudges\"]})\n163\t        if action == \"like\":\n164\t            task[\"likes\"] += 1\n165\t            return self.send(200, {\"id\": task[\"id\"], \"likes\": task[\"likes\"]})\n166\t        if action == \"view\":\n167\t            task[\"views\"] += 1\n168\t            return self.send(200, {\"id\": task[\"id\"], \"views\": task[\"views\"]})\n169\t        return self.send(404, {\"error\": \"no such route\"})\n170\t\n171\t    def do_GET(self):\n172\t        self.dispatch(\"GET\")\n173\t\n174\t    def do_POST(self):\n175\t        self.dispatch(\"POST\")\n176\t\n177\t    def do_PATCH(self):\n178\t        self.dispatch(\"PATCH\")\n179\t\n180\t    def do_DELETE(self):\n181\t        self.dispatch(\"DELETE\")\n182\t\n183\t\n184\tdef make_