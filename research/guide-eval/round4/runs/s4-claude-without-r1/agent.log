{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019LkdV7tiDJhUvmgecxJgSe","type":"tool_result","content":"<persisted-output>\nOutput too large (31.9KB). Full output saved to: /Users/valentinakoniukhova/.claude/projects/-private-tmp-h-15NWzU/12758654-5564-441d-a699-220d2405b2b5/tool-results/bk7ayr1t5.txt\n\nPreview (first 2KB):\n=== supabase/migrations/20261010040000_normal_forms.sql\n-- Normal forms, 2026-10-10. The schema checked against 1NF–3NF (Codd 1970/71),\n-- BCNF and 4NF/5NF (Fagin 1977/79); in Kent's words (CACM 26(2), 1983), every\n-- non-key field is a fact about the key, the whole key, and nothing but the key.\n--\n-- Mixed approach, not textbook 3NF:\n--   * redundancy that buys nothing is removed, or computed by Postgres\n--     (generated columns, triggers) so it can't drift;\n--   * the project_id copies on child tables stay (RLS policies and the hot\n--     indexes filter on them), but composite foreign keys now make a copy that\n--     disagrees with its parent impossible.\n-- Every constraint below was checked against the live data first (no\n-- violations). Left as they are, on purpose:\n--   * ideas.github_issue_url: holds either the issue's URL or a pre-filled\n--     github.com \"new issue\" link (app), so it isn't derivable from repo + number;\n--   * source_syncs.source ('devto:writing:<handle>', 'github:<repo>'): an\n--     opaque key the app shows and parses; the database only compares it;\n--   * voice_samples.text_sha256: the server dedupes on it before inserting,\n--     with JavaScript's whitespace rule; a generated column could disagree;\n--   * themes.position vs project_memory kind 'position': both unused so far.\n\nset search_path = public, extensions;\n\n-- ------------------------------------------------------------------ 3NF: project_id copies\n-- Parents expose (id, project_id[, …]) so children can reference the pair.\nalter table people   add constraint people_id_project unique (id, project_id);\nalter table accounts add constraint accounts_id_project_platform unique (id, project_id, platform);\nalter table items    add constraint items_id_project unique (id, project_id),\n                     add constraint items_id_project_person unique (id, project_id, person_id);\nalter table documents add constraint documents_id_project unique (id, project_id);\n...\n</persisted-output>","is_error":false}]},"parent_tool_use_id":null,"session_id":"12758654-5564-441d-a699-220d2405b2b5","uuid":"27bbfa8c-af7c-435d-bbc1-79f61317feeb","timestamp":"2026-10-18T01:45:51.898Z","tool_use_result":{"stdout":"=== supabase/migrations/20261010040000_normal_forms.sql\n-- Normal forms, 2026-10-10. The schema checked against 1NF–3NF (Codd 1970/71),\n-- BCNF and 4NF/5NF (Fagin 1977/79); in Kent's words (CACM 26(2), 1983), every\n-- non-key field is a fact about the key, the whole key, and nothing but the key.\n--\n-- Mixed approach, not textbook 3NF:\n--   * redundancy that buys nothing is removed, or computed by Postgres\n--     (generated columns, triggers) so it can't drift;\n--   * the project_id copies on child tables stay (RLS policies and the hot\n--     indexes filter on them), but composite foreign keys now make a copy that\n--     disagrees with its parent impossible.\n-- Every constraint below was checked against the live data first (no\n-- violations). Left as they are, on purpose:\n--   * ideas.github_issue_url: holds either the issue's URL or a pre-filled\n--     github.com \"new issue\" link (app), so it isn't derivable from repo + number;\n--   * source_syncs.source ('devto:writing:<handle>', 'github:<repo>'): an\n--     opaque key the app shows and parses; the database only compares it;\n--   * voice_samples.text_sha256: the server dedupes on it before inserting,\n--     with JavaScript's whitespace rule; a generated column could disagree;\n--   * themes.position vs project_memory kind 'position': both unused so far.\n\nset search_path = public, extensions;\n\n-- ------------------------------------------------------------------ 3NF: project_id copies\n-- Parents expose (id, project_id[, …]) so children can reference the pair.\nalter table people   add constraint people_id_project unique (id, project_id);\nalter table accounts add constraint accounts_id_project_platform unique (id, project_id, platform);\nalter table items    add constraint items_id_project unique (id, project_id),\n                     add constraint items_id_project_person unique (id, project_id, person_id);\nalter table documents add constraint documents_id_project unique (id, project_id);\nalter table ideas    add constraint ideas_id_project unique (id, project_id);\nalter table themes   add constraint themes_id_project unique (id, project_id);\n\n-- An item's person and account are in the item's project; the account is on\n-- the item's platform. (Discover items have no account: MATCH SIMPLE skips it.)\nalter table items\n  drop constraint items_person_id_fkey,\n  add constraint items_person_fkey foreign key (person_id, project_id) references people (id, project_id) on delete cascade,\n  drop constraint items_account_id_fkey,\n  add constraint items_account_fkey foreign key (account_id, project_id, platform)\n    references accounts (id, project_id, platform) on delete cascade;\n\nalter table identities\n  drop constraint identities_person_id_fkey,\n  add constraint identities_person_fkey foreign key (person_id, project_id) references people (id, project_id) on delete cascade;\n\n-- A touch about an item is with that item's person; if the item moves to\n-- another person (people merged), its touches follow.\nalter table touches\n  drop constraint touches_person_id_fkey,\n  add constraint touches_person_fkey foreign key (person_id, project_id) references people (id, project_id) on delete cascade,\n  drop constraint touches_item_id_fkey,\n  add constraint touches_item_fkey foreign key (item_id, project_id, person_id)\n    references items (id, project_id, person_id) on delete cascade on update cascade;\n\nalter table document_chunks\n  drop constraint document_chunks_document_id_fkey,\n  add constraint document_chunks_document_fkey foreign key (document_id, project_id) references documents (id, project_id) on delete cascade;\n\nalter table idea_items\n  drop constraint idea_items_idea_id_fkey,\n  add constraint idea_items_idea_fkey foreign key (idea_id, project_id) references ideas (id, project_id) on delete cascade,\n  drop constraint idea_items_item_id_fkey,\n  add constraint idea_items_item_fkey foreign key (item_id, project_id) references items (id, project_id) on delete cascade;\n\n-- A theme from another project can't be attached.\nalter table documents\n  drop constraint documents_theme_id_fkey,\n  add constraint documents_theme_fkey foreign key (theme_id, project_id) references themes (id, project_id) on delete set null (theme_id);\nalter table project_memory\n  drop constraint project_memory_theme_id_fkey,\n  add constraint project_memory_theme_fkey foreign key (theme_id, project_id) references themes (id, project_id) on delete cascade;\n\n-- ------------------------------------------------------------------ 2NF: idea_items.person_id\n-- idea_items is keyed by (idea_id, item_id), but person_id depended on item_id\n-- alone (it is items.person_id). Who asked is now read through the item.\ncreate or replace function ideas_recount() returns trigger language plpgsql security definer set search_path = public as $$\ndeclare x uuid := coalesce(new.idea_id, old.idea_id);\nbegin\n  update ideas set asked_by = (\n      select count(distinct i.person_id) from idea_items ii join items i on i.id = ii.item_id where ii.idea_id = x),\n    updated_at = now()\n  where id = x;\n  return null;\nend $$;\n\n-- asked_by stays a cached count: recount when an item changes hands.\ncreate function items_person_recount() returns trigger language plpgsql security definer set search_path = public as $$\nbegin\n  update ideas d set asked_by = (\n      select count(distinct i.person_id) from idea_items ii join items i on i.id = ii.item_id where ii.idea_id = d.id)\n  where d.id in (select idea_id from idea_items where item_id = new.id);\n  return null;\nend $$;\ncreate trigger items_person_recount after update of person_id on items\n  for each row when (old.person_id is distinct from new.person_id) execute function items_person_recount();\nrevoke execute on function items_person_recount() from public, anon, authenticated;\n\n-- The inbox view read idea_items.person_id; same columns, through items.\ncreate or replace view inbox_by_person with (security_invoker = true) as\nwith w as (\n  select i.*, row_number() over (partition by i.person_id order by i.posted_at desc) rn\n  from items i\n  where i.origin = 'inbox' and i.status in ('new', 'draft_ready')\n)\nselect\n  w.project_id, w.person_id, p.display_name, p.avatar_url, p.stage,\n  count(*)::int as waiting,\n  count(*) filter (where w.status = 'new')::int as needs_you,\n  count(*) filter (where w.status = 'draft_ready')::int as draft_ready,\n  array_agg(distinct w.platform::text) as platforms,\n  max(w.id::text) filter (where w.rn = 1)::uuid as last_item_id,\n  max(w.text) filter (where w.rn = 1) as last_item_text,\n  max(w.kind::text) filter (where w.rn = 1) as last_item_kind,\n  max(w.platform::text) filter (where w.rn = 1) as last_item_platform,\n  max(w.posted_at) as last_posted_at,\n  max(w.status::text) filter (where w.rn = 1) as last_status,\n  (select d.text from drafts d where d.item_id = max(w.id::text) filter (where w.rn = 1)::uuid and d.outcome is null\n     order by d.version desc limit 1) as last_draft_text,\n  exists (select 1 from idea_items ii join items ai on ai.id = ii.item_id where ai.person_id = w.person_id) as has_idea\nfrom w join people p on p.id = w.person_id\ngroup by w.project_id, w.person_id, p.display_name, p.avatar_url, p.stage;\n\nalter table idea_items drop column person_id;\n\n-- ------------------------------------------------------------------ 3NF: document_chunks\n-- kind, source_url, source_ref and label were copies of the chunk's document\n-- (written from it in knowledge.ts; identical on every live row). They live on\n-- documents only. published_at / published_precision stay per chunk (a section\n-- is as new as its newest line), and so does lang.\nalter table documents add constraint documents_kind_check\n  check (kind in ('article', 'story', 'research', 'changelog', 'readme', 'faq', 'fact', 'page'));\n\n-- is_public was label = 'quotable' written twice; Postgres computes it now.\nalter table documents drop column is_public;\nalter table documents add column is_public boolean generated always as (label = 'quotable') stored;\n\n-- Same signature and result as before; the document's fields come through the join.\ncreate or replace function match_document_chunks(\n  p_project uuid,\n  p_query vector(768),\n  p_before timestamptz default now(),\n  p_count int default 40,\n  p_kinds text[] default null,\n  p_min_similarity float default 0.68,\n  p_labels text[] default array['quotable']\n) returns table (\n  id uuid, kind text, title text, source_url text, source_ref text,\n  published_at timestamptz, published_precision text, content text, tokens int, lang text,\n  similarity float, embedding vector(768), label text\n)\nlanguage sql stable security invoker\nset search_path = public, extensions\nset hnsw.ef_search = 100\nset hnsw.iterative_scan = relaxed_order\nas $$\n  select c.id, d.kind, c.title,\n         case when d.label = 'quotable' then d.url end as source_url,\n         case when d.label <> 'quotable' then coalesce(d.source_ref, d.url) end as source_ref,\n         c.published_at, c.published_precision, c.content, c.tokens, c.lang,\n         1 - (c.embedding <=> p_query) as similarity, c.embedding, d.label\n  from document_chunks c\n  join documents d on d.id = c.document_id\n  where c.project_id = p_project\n    and c.embedding is not null\n    and (p_kinds is null or d.kind = any (p_kinds))\n    and d.label = any (p_labels)\n    and case c.published_precision\n          when 'day' then (c.published_at at time zone 'utc')::date < (p_before at time zone 'utc')::date\n          else c.published_at < p_before\n        end\n    and 1 - (c.embedding <=> p_query) >= p_min_similarity\n  order by c.embedding <=> p_query\n  limit greatest(1, least(p_count, 200));\n$$;\n\nalter table document_chunks drop column kind, drop column source_url, drop column source_ref, drop column label;\n\n-- ------------------------------------------------------------------ 3NF: drafts.tokens_in / tokens_out\n-- The totals are functions of the usage breakdown in drafts.tokens (Anthropic's\n-- input excludes cache reads and writes; the total includes them). Drafts that\n-- only had totals (Gemini) get them as the breakdown, then Postgres computes\n-- the totals.\nupdate drafts set tokens = jsonb_build_object('input', tokens_in, 'output', tokens_out)\n  where tokens is null and (tokens_in is not null or tokens_out is not null);\n\ndo $$ begin\n  if exists (select 1 from drafts where\n      tokens_in is distinct from (tokens->>'input')::int + coalesce((tokens->>'cache_read')::int, 0) + coalesce((tokens->>'cache_write')::int, 0)\n      or tokens_out is distinct from (tokens->>'output')::int) then\n    raise exception 'drafts: tokens_in/tokens_out disagree with drafts.tokens; not converting';\n  end if;\nend $$;\n\nalter table drafts drop column tokens_in, drop column tokens_out;\nalter table drafts\n  add column tokens_in int generated always as\n    ((tokens->>'input')::int + coalesce((tokens->>'cache_read')::int, 0) + coalesce((tokens->>'cache_write')::int, 0)) stored,\n  add column tokens_out int generated always as ((tokens->>'output')::int) stored;\n\n-- ------------------------------------------------------------------ derived: people.first/last_touch_at\n-- Kept as a cache of min/max(touches.occurred_at), now by the database for\n-- every writer (the collector did read-then-write; issue touches didn't update\n-- it at all). greatest/least on insert is safe under concurrent inserts.\ncreate function touches_person_span() returns trigger language plpgsql security definer set search_path = public as $$\nbegin\n  if tg_op = 'INSERT' then\n    update people set first_touch_at = least(first_touch_at, new.occurred_at),\n                      last_touch_at = greatest(last_touch_at, new.occurred_at)\n    where id = new.person_id\n      and (first_touch_at is null or last_touch_at is null or new.occurred_at < first_touch_at or new.occurred_at > last_touch_at);\n  else\n    update people p set first_touch_at = s.lo, last_touch_at = s.hi\n    from (select x.id, (select min(occurred_at) from touches where person_id = x.id) lo,\n                       (select max(occurred_at) from touches where person_id = x.id) hi\n          from (select old.person_id as id union select new.person_id) x where x.id is not null) s\n    where p.id = s.id;\n  end if;\n  return null;\nend $$;\ncreate trigger touches_person_span after insert or delete or update of person_id, occurred_at on touches\n  for each row execute function touches_person_span();\nrevoke execute on function touches_person_span() from public, anon, authenticated;\n\n-- The decision RPC no longer sets last_touch_at itself: its touch does.\ncreate or replace function record_draft_outcome(\n  p_draft_id uuid,\n  p_outcome draft_outcome,\n  p_final_text text default null,\n  p_posted_url text default null,\n  p_move_stage person_stage default null\n) returns drafts\nlanguage plpgsql security definer set search_path = public as $$\ndeclare\n  d drafts;\n  it items;\n  uid uuid := auth.uid();\n  posted boolean := p_outcome in ('posted_as_is', 'posted_edited');\nbegin\n  if p_outcome not in ('posted_as_is', 'posted_edited', 'skipped') then raise exception 'bad_outcome'; end if;\n  if posted and coalesce(btrim(p_final_text), '') = '' then raise exception 'final_text_required'; end if;\n  select * into d from drafts where id = p_draft_id for update;\n  if not found then raise exception 'not_found'; end if;\n  select * into it from items where id = d.item_id for update;\n  if uid is null or not is_member(it.project_id) then raise exception 'not_found'; end if;\n  if d.outcome is not null then raise exception 'already_decided'; end if;\n\n  update drafts set\n    outcome = p_outcome,\n    final_text = case when posted then p_final_text else final_text end,\n    posted_url = case when posted then p_posted_url else posted_url end,\n    posted_at = case when posted then now() else posted_at end,\n    posted_by = case when posted then uid else posted_by end,\n    decided_by = uid, decided_at = now()\n  where id = p_draft_id returning * into d;\n\n  update drafts set outcome = 'superseded', decided_at = now()\n  where item_id = it.id and id <> p_draft_id and outcome is null;\n\n  update items set status = case when posted then 'answered'::item_status else 'skipped'::item_status end,\n                   skip_reason = null\n  where id = it.id;\n\n  if posted then\n    insert into touches (project_id, person_id, direction, platform, kind, occurred_at, url, text, item_id, by_founder, source)\n    values (it.project_id, it.person_id, 'out', it.platform, 'reply', now(), p_posted_url, p_final_text, it.id, uid, 'app');\n    update people set\n      stage = coalesce(p_move_stage, case when stage = 'noticed' then 'talking'::person_stage else stage end)\n    where id = it.person_id;\n  elsif p_move_stage is not null then\n    update people set stage = p_move_stage where id = it.person_id;\n  end if;\n  return d;\nend $$;\n\n-- ------------------------------------------------------------------ 1NF: plans.allowed_models\n-- The array was a relation in disguise (searched with = any in three\n-- functions). One row per (plan, model); ord keeps the order the app lists.\ncreate table plan_models (\n  plan_id text not null,\n  model text not null,\n  ord smallint not null default 0,\n  primary key (plan_id, model),\n  constraint plan_models_plan_fkey foreign key (plan_id) references plans (id) on delete cascade\n);\ninsert into plan_models (plan_id, model, ord)\n  select p.id, m.model, m.n from plans p, unnest(p.allowed_models) with ordinality as m(model, n);\n\n-- The default is one of the plan's models (deferred: a plan and its models are\n-- inserted in one transaction).\nalter table plans drop constraint plans_default_allowed;\nalter table plans add constraint plans_default_model_fkey foreign key (id, default_model)\n  references plan_models (plan_id, model) deferrable initially deferred;\n\nalter table plan_models enable row level security;\ncreate policy signed_in_read on plan_models for select to authenticated using (true);\nrevoke all on plan_models from anon, authenticated;\ngrant select on plan_models to authenticated;\n\n-- Same rule as before: an override is checked when it is set; if the plan later\n-- drops the model (or the founder changes plan), the server falls back to the\n-- plan default instead. That's why this stays a trigger, not a foreign key.\ncreate or replace function check_founder_draft_model() returns trigger\n  language plpgsql set search_path = public as $$\nbegin\n  if new.draft_model is not null\n     and (tg_op = 'INSERT' or new.draft_model is distinct from old.draft_model)\n     and not exists (select 1 from plan_models m where m.plan_id = new.plan_id and m.model = new.draft_model) then\n    raise exception 'model_not_allowed' using errcode = '23514', detail = format('%s is not in plan %s', new.draft_model, new.plan_id);\n  end if;\n  return new;\nend $$;\n\ncreate or replace function my_draft_model() returns jsonb\n  language sql stable security definer set search_path = public as $$\n  select jsonb_build_object(\n    'plan_id', p.id, 'plan_name', p.name, 'default_model', p.default_model,\n    'allowed_models', coalesce((select jsonb_agg(m.model order by m.ord, m.model) from plan_models m where m.plan_id = p.id), '[]'::jsonb),\n    'draft_model', f.draft_model,\n    'effective_model', case when exists (select 1 from plan_models m where m.plan_id = p.id and m.model = f.draft_model)\n                            then f.draft_model else p.default_model end)\n  from founders f join plans p on p.id = f.plan_id\n  where f.id = auth.uid()\n$$;\n\ncreate or replace function set_draft_model(model text) returns jsonb\n  language plpgsql security definer set search_path = public as $$\ndeclare\n  m text := nullif(btrim(model), '');\nbegin\n  if auth.uid() is null then raise exception 'not_found'; end if;\n  if m is not null and not exists (\n    select 1 from founders f join plan_models pm on pm.plan_id = f.plan_id\n    where f.id = auth.uid() and pm.model = m) then\n    raise exception 'model_not_allowed' using errcode = '23514';\n  end if;\n  update founders set draft_model = m where id = auth.uid();\n  if not found then raise exception 'not_found'; end if;\n  return my_draft_model();\nend $$;\n\nalter table plans drop column allowed_models;\n=== supabase/migrations/20261011010000_draft_checks.sql\n-- [check: …] gaps she can resolve (docs/API.md › Changes 2026-10-11).\n--\n-- * drafts.variant 'resolve': a version made by answering or dropping gaps of\n--   the version before it (draft function, `resolve`). Nothing else changes in\n--   how versions work: the older undecided one is superseded.\n-- * drafts.meta: what made this version beyond the model call. For 'resolve':\n--   {based_on: {draft_id, version}, edited_before, resolved: [{check_id,\n--   question, action: answer|drop, answer?, method: model|fallback, reason?,\n--   by, at}]}. Her answers stay here as a fact / voice signal for later drafts.\n-- * A posted reply never contains a gap: record_draft_outcome refuses\n--   final_text with \"[check\" (any case), and a constraint makes it a rule for\n--   every writer.\n\nalter table drafts drop constraint drafts_variant_check;\nalter table drafts add constraint drafts_variant_check check (variant in ('first', 'shorter', 'redraft', 'resolve'));\n\nalter table drafts add column meta jsonb not null default '{}'::jsonb;\n\nalter table drafts add constraint drafts_posted_without_checks\n  check (outcome is null or outcome not in ('posted_as_is', 'posted_edited') or final_text is null or final_text !~* '\\[check');\n\ncreate or replace function record_draft_outcome(\n  p_draft_id uuid,\n  p_outcome draft_outcome,\n  p_final_text text default null,\n  p_posted_url text default null,\n  p_move_stage person_stage default null\n) returns drafts\nlanguage plpgsql security definer set search_path = public as $$\ndeclare\n  d drafts;\n  it items;\n  uid uuid := auth.uid();\n  posted boolean := p_outcome in ('posted_as_is', 'posted_edited');\nbegin\n  if p_outcome not in ('posted_as_is', 'posted_edited', 'skipped') then raise exception 'bad_outcome'; end if;\n  if posted and coalesce(btrim(p_final_text), '') = '' then raise exception 'final_text_required'; end if;\n  if posted and p_final_text ~* '\\[check' then raise exception 'unfilled_check'; end if;\n  select * into d from drafts where id = p_draft_id for update;\n  if not found then raise exception 'not_found'; end if;\n  select * into it from items where id = d.item_id for update;\n  if uid is null or not is_member(it.project_id) then raise exception 'not_found'; end if;\n  if d.outcome is not null then raise exception 'already_decided'; end if;\n\n  update drafts set\n    outcome = p_outcome,\n    final_text = case when posted then p_final_text else final_text end,\n    posted_url = case when posted then p_posted_url else posted_url end,\n    posted_at = case when posted then now() else posted_at end,\n    posted_by = case when posted then uid else posted_by end,\n    decided_by = uid, decided_at = now()\n  where id = p_draft_id returning * into d;\n\n  update drafts set outcome = 'superseded', decided_at = now()\n  where item_id = it.id and id <> p_draft_id and outcome is null;\n\n  update items set status = case when posted then 'answered'::item_status else 'skipped'::item_status end,\n                   skip_reason = null\n  where id = it.id;\n\n  if posted then\n    insert into touches (project_id, person_id, direction, platform, kind, occurred_at, url, text, item_id, by_founder, source)\n    values (it.project_id, it.person_id, 'out', it.platform, 'reply', now(), p_posted_url, p_final_text, it.id, uid, 'app');\n    update people set\n      stage = coalesce(p_move_stage, case when stage = 'noticed' then 'talking'::person_stage else stage end)\n    where id = it.person_id;\n  elsif p_move_stage is not null then\n    update people set stage = p_move_stage where id = it.person_id;\n  end if;\n  return d;\nend $$;\n=== supabase/migrations/20261011120000_tokens_generated_safe.sql\n-- drafts.tokens_in / tokens_out are generated from the drafts.tokens JSON.\n-- Review by Arhan Canli (dev.to, 2026-10-11): the first term had no coalesce,\n-- so a row whose JSON lacked \"input\" got tokens_in = NULL instead of the cache\n-- sum, and a value like \"12.0\" made the int cast raise and failed the whole\n-- insert. A generated column can't be written around, so the expression must\n-- never raise: numbers are parsed leniently (\"12\", \"12.0\", 12) and anything\n-- else counts as missing.\n\ncreate or replace function hb_json_int(v text) returns int\n  language sql immutable parallel safe\nas $$\n  select case when v ~ '^\\s*-?\\d+(\\.\\d+)?\\s*$' then round(v::numeric)::int end\n$$;\n\n-- NULL only when there is no token count at all; otherwise the sum of what's there.\nalter table drafts alter column tokens_in set expression as (\n  case when coalesce(hb_json_int(tokens->>'input'), hb_json_int(tokens->>'cache_read'),\n                     hb_json_int(tokens->>'cache_write')) is null then null\n       else coalesce(hb_json_int(tokens->>'input'), 0)\n          + coalesce(hb_json_int(tokens->>'cache_read'), 0)\n          + coalesce(hb_json_int(tokens->>'cache_write'), 0) end);\nalter table drafts alter column tokens_out set expression as (hb_json_int(tokens->>'output'));\n=== supabase/migrations/20261012010000_intent_discuss.sql\n-- Intent chips: \"Discuss\" (her view + one question that keeps the discussion\n-- going, normal length) becomes the default chip. ask_feedback / ask_price\n-- are no longer offered in the app but stay valid for existing drafts.\nalter table drafts drop constraint drafts_intent_check;\nalter table drafts add constraint drafts_intent_check\n  check (intent in ('discuss', 'just_answer', 'invite_to_try', 'ask_feedback', 'ask_price', 'auto'));\n=== supabase/migrations/20261012020000_item_liked.sql\n-- Like from the thread screen: the phone likes the comment on the network\n-- (dev.to POST /reactions, with her session) and records it here so the\n-- button shows it. null = not liked from Hearback.\nalter table items add column liked_at timestamptz;\n=== supabase/migrations/20261012030000_item_spam_verdict.sql\n-- Spam check (triage route spam_check: the comment looks like a plug). Her\n-- answer: 'spam' (hidden on the network from the app, item skipped) or\n-- 'not_spam' (treated as a usual comment). null = not asked / not answered.\nalter table items add column spam_verdict text check (spam_verdict in ('spam', 'not_spam'));\n=== supabase/migrations/20261012040000_documents_kind_docs.sql\n-- Documentation pages (a site's /docs, /guide, /help, a repo's docs/ folder)\n-- get their own kind, so a draft can point to them as \"the docs\" (Invite to\n-- try: draft/materials.ts).\nalter table documents drop constraint documents_kind_check;\nalter table documents add constraint documents_kind_check\n  check (kind in ('article', 'story', 'research', 'changelog', 'readme', 'faq', 'docs', 'fact', 'page'));\n=== supabase/migrations/20261014010000_github_board_results.sql\n-- GitHub Projects board + what happened to an idea's issue.\n-- docs/ARCHITECTURE.md › GitHub App, docs/API.md › Changes 2026-10-14.\n--\n-- A project may link one organization board (Projects v2). Hearback only\n-- reads it: the duplicate check looks at its items (any repo, drafts too) and\n-- the results sweep reads an issue's Status there. Needs the app's\n-- \"Organization permissions › Projects: read-only\".\n--\n-- The sweep (function github-results, every 20 min) notices an idea's issue\n-- closing as completed (or its board Status reaching Done), reads the result\n-- (closing PRs, the last maintainer comment, its links) and drafts a follow-up\n-- reply to everyone who asked. Nothing is posted without her tap.\n\n-- ------------------------------------------------------------------ projects › board\n-- owner + number is the board's address (github.com/orgs/<owner>/projects/<number>);\n-- id is its GraphQL node id; title is GitHub's, cached for display.\nalter table projects\n  add column github_board_owner text check (github_board_owner is null or github_board_owner ~ '^[A-Za-z0-9-]+$'),\n  add column github_board_number int check (github_board_number is null or github_board_number > 0),\n  add column github_board_id text,\n  add column github_board_title text,\n  add constraint projects_github_board_whole check (\n    (github_board_owner is null) = (github_board_number is null)\n    and (github_board_owner is null) = (github_board_id is null));\n\n-- ------------------------------------------------------------------ ideas › issue result\nalter table ideas\n  -- GitHub's view of the issue, as last read.\n  add column github_issue_state text check (github_issue_state in ('open', 'closed')),\n  add column github_issue_state_reason text,          -- completed | not_planned | duplicate | reopened\n  add column github_issue_closed_at timestamptz,\n  add column github_board_status text,                -- the board's Status option, if the issue is on the linked board\n  add column github_checked_at timestamptz,\n  -- What was done, in words she can edit before replies are drafted.\n  add column result_note text,\n  add column result_note_url text,                    -- the comment it came from\n  add column result_links jsonb not null default '[]',-- [{title, url, kind: pr|commit|link}]\n  add column result_drafted_at timestamptz;           -- follow-up drafts were made (once per result)\n\n-- The sweep's queue: ideas with a real issue that are not settled yet.\ncreate index ideas_issue_watch on ideas (github_checked_at nulls first)\n  where github_issue_number is not null and result_drafted_at is null;\n\n-- ------------------------------------------------------------------ drafts › intent\n-- share_result: the follow-up \"what you asked for is done\" reply.\nalter table drafts drop constraint drafts_intent_check;\nalter table drafts add constraint drafts_intent_check\n  check (intent in ('discuss', 'just_answer', 'invite_to_try', 'ask_feedback', 'ask_price', 'share_result', 'auto'));\n\n-- ------------------------------------------------------------------ cron\nselect cron.schedule('hb-github-results', '11-59/20 * * * *', $$select hb_call_function('github-results', '{}')$$);\n=== supabase/migrations/20261015010000_ask_code_model_calls.sql\n-- Ask the code (docs/ARCHITECTURE.md › Ask the code) and the model-call log.\n--\n-- model_calls: every model call the functions make (drafts, resolves,\n-- points, triage summaries, decider, discover, landing reads, ask-code steps)\n-- with tokens and list-price cost. Service role only; read it with SQL or\n-- model_spend_daily. Drafts written before this log are copied in once\n-- (purpose 'draft', fn 'backfill') from drafts.tokens.\n--\n-- code_questions: a question about the project's code (usually a draft's\n-- [check: …] gap) and its answer with cited lines. answered_by 'cloud' is\n-- the ask-code agent; 'local' is kept for a founder's own agent answering\n-- from her machine (backlog). Members read their project's rows; only the\n-- function writes them.\n\ncreate table model_calls (\n  id bigint generated always as identity primary key,\n  at timestamptz not null default now(),\n  fn text,                     -- the edge function (draft, triage, ask-code, …)\n  purpose text not null,       -- draft / resolve / points / triage_summary / decide / discover_why / landing / ask_code\n  project_id uuid references projects(id) on delete set null,\n  founder_id uuid,             -- the signed-in founder (no FK: a log row must never fail to insert)\n  item_id uuid references items(id) on delete set null,\n  run_id uuid,                 -- the steps of one multi-step run (code_questions.id)\n  provider text not null,\n  model text not null,\n  ok boolean not null,\n  error text,\n  tokens_in int,               -- all prompt tokens (uncached + cache reads + cache writes)\n  tokens_out int,\n  usage jsonb,                 -- {input, output, cache_read, cache_write, cost_usd}\n  cost_usd numeric(12, 6),     -- list price (pricing.ts); null: unknown or free (Gemini free key)\n  latency_ms int\n);\ncreate index model_calls_at on model_calls (at desc);\ncreate index model_calls_project on model_calls (project_id, at desc);\ncreate index model_calls_run on model_c","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"persistedOutputPath":"/Users/valentinakoniukhova/.claude/projects/-private-tmp-h-15NWzU/12758654-5564-441d-a699-220d2405b2b5/tool-results/bk7ayr1t5.txt","persistedOutputSize":32623},"tool_result_meta":[{"id":"toolu_019LkdV7tiDJhUvmgecxJgSe","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cg8rhwQRVKzJEMF4w2yCH","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01V48FRH4LDgoVXDdat32vKD","name":"Read","input":{"file_path":"/Users/valentinakoniukhova/.claude/projects/-private-tmp-h-15NWzU/12758654-5564-441d-a699-220d2405b2b5/tool-results/brfmh4krh.txt"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":11467,"cache_read_input_tokens":22884,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":11467},"output_tokens":16,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"12758654-5564-441d-a699-220d2405b2b5","uuid":"9a2cf5c3-bd97-4c98-be20-79d71eb820dc","timestamp":"2026-10-18T01:45:54.660Z","request_id":"req_011Cg8rhw949HV3CemYeNJrt","wire_tool_inputs":{"toolu_01V48FRH4LDgoVXDdat32vKD":{"file_path":"/Users/valentinakoniukhova/.claude/projects/-private-tmp-h-15NWzU/12758654-5564-441d-a699-220d2405b2b5/tool-results/brfmh4krh.txt"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01V48FRH4LDgoVXDdat32vKD","type":"tool_result","content":"1\t# hearback backend\n2\t\n3\tSupabase project behind Hearback (drafts replies to comments on a founder's posts).\n4\t\n5\t- `supabase/migrations/` — the schema, in the order it was applied\n6\t- `supabase/functions/` — Deno edge functions (the server code that reads and writes it)\n7\t=== supabase/migrations/20261008170000_init.sql\n8\t-- Hearback schema v1 (draft 2, 2026-10-08). Not applied until reviewed.\n9\t--\n10\t-- Founders (users) sign in with Supabase Auth. A project can have several\n11\t-- founders, and a founder can be in several projects (project_members). A\n12\t-- project listens on accounts (Bluesky, dev.to…), turns what needs an answer\n13\t-- into items, files them under themes (\"MCP servers\"), drafts replies with the\n14\t-- theme's knowledge, and keeps every person's public profile and full history\n15\t-- of touches. Row-level security from day one: a row is visible only to members\n16\t-- of its project. Platform credentials never leave the database unencrypted:\n17\t-- they live in Supabase Vault, readable only by the service role (the collector\n18\t-- and the draft engine), never by the app.\n19\t\n20\tcreate extension if not exists \"pgcrypto\";\n21\t\n22\tcreate type platform as enum ('bluesky', 'devto', 'github', 'threads', 'habr', 'reddit', 'x', 'email', 'other');\n23\tcreate type member_role as enum ('owner', 'member');\n24\tcreate type item_kind as enum ('reply', 'mention', 'quote', 'comment');\n25\tcreate type item_status as enum ('new', 'draft_ready', 'answered', 'skipped');\n26\tcreate type person_stage as enum ('noticed', 'talking', 'engaged', 'supporter', 'would_try', 'customer', 'not_a_fit');\n27\tcreate type touch_direction as enum ('in', 'out');\n28\tcreate type draft_outcome as enum ('posted_as_is', 'posted_edited', 'skipped', 'superseded');\n29\tcreate type memory_kind as enum ('voice_sample', 'preference', 'need', 'faq', 'fact', 'position');\n30\tcreate type auth_kind as enum ('none', 'oauth', 'app_password', 'api_key');\n31\t\n32\t-- ------------------------------------------------------------------ founders\n33\t-- auth.users holds the login; this is the founder's own profile.\n34\tcreate table founders (\n35\t  id uuid primary key references auth.users(id) on delete cascade,\n36\t  display_name text,\n37\t  avatar_url text,\n38\t  voice_notes text,               -- how this founder writes (tone, habits), used in their drafts\n39\t  languages text[] not null default '{en}',\n40\t  created_at timestamptz not null default now()\n41\t);\n42\t\n43\t-- ------------------------------------------------------------------ projects\n44\tcreate table projects (\n45\t  id uuid primary key default gen_random_uuid(),\n46\t  name text not null,\n47\t  one_liner text,                 -- the product in one sentence\n48\t  audience text,                  -- who it's for\n49\t  views text,                     -- what the team believes\n50\t  red_lines text,                 -- never promise / never say\n51\t  tone text,\n52\t  languages text[] not null default '{en}',\n53\t  links jsonb not null default '[]',   -- [{title, url}] landing, repo, key articles\n54\t  created_by uuid references founders(id) on delete set null,\n55\t  created_at timestamptz not null default now()\n56\t);\n57\t\n58\tcreate table project_members (\n59\t  project_id uuid not null references projects(id) on delete cascade,\n60\t  founder_id uuid not null references founders(id) on delete cascade,\n61\t  role member_role not null default 'member',\n62\t  joined_at timestamptz not null default now(),\n63\t  primary key (project_id, founder_id)\n64\t);\n65\t\n66\t-- Pending invitations by email; accepted on first sign-in with that email.\n67\tcreate table project_invites (\n68\t  id uuid primary key default gen_random_uuid(),\n69\t  project_id uuid not null references projects(id) on delete cascade,\n70\t  email text not null,\n71\t  role member_role not null default 'member',\n72\t  invited_by uuid references founders(id) on delete set null,\n73\t  created_at timestamptz not null default now(),\n74\t  accepted_at timestamptz,\n75\t  unique (project_id, email)\n76\t);\n77\t\n78\t-- ------------------------------------------------------------------ accounts\n79\t-- A listened-to account of the project on a platform. The credential (an OAuth\n80\t-- token set, an app password or an API key) is a Vault secret referenced by id;\n81\t-- dev.to needs none for reading (auth = 'none').\n82\tcreate table accounts (\n83\t  id uuid primary key default gen_random_uuid(),\n84\t  project_id uuid not null references projects(id) on delete cascade,\n85\t  platform platform not null,\n86\t  handle text not null,\n87\t  external_id text,               -- e.g. Bluesky DID\n88\t  auth auth_kind not null default 'none',\n89\t  secret_id uuid,                 -- vault.secrets.id; null when auth = 'none'\n90\t  connected_by uuid references founders(id) on delete set null,\n91\t  cursor text,                    -- platform paging cursor of the last poll\n92\t  last_polled_at timestamptz,\n93\t  active boolean not null default true,\n94\t  unique (project_id, platform, handle)\n95\t);\n96\t\n97\t-- ------------------------------------------------------------------ themes\n98\t-- A topic conversations come back to (\"MCP servers\", \"agent skills\"). Items are\n99\t-- filed under themes, and a theme carries its own positions, facts and sources,\n100\t-- so drafts inside one theme stay consistent.\n101\tcreate table themes (\n102\t  id uuid primary key default gen_random_uuid(),\n103\t  project_id uuid not null references projects(id) on delete cascade,\n104\t  name text not null,\n105\t  description text,               -- what belongs here (used to auto-file items)\n106\t  position text,                  -- the team's stance on this theme\n107\t  created_at timestamptz not null default now(),\n108\t  unique (project_id, name)\n109\t);\n110\t\n111\t-- ------------------------------------------------------------------ people\n112\t-- A person the project talks to, however many platforms they're on.\n113\t-- Deleting a person deletes everything about them: identities, their items\n114\t-- (and the drafts under them), touches.\n115\tcreate table people (\n116\t  id uuid primary key default gen_random_uuid(),\n117\t  project_id uuid not null references projects(id) on delete cascade,\n118\t  display_name text,\n119\t  avatar_url text,\n120\t  summary text,                   -- who they are, written from public profile + touches\n121\t  builds text,                    -- what they build\n122\t  cares_about text,               -- what they ask for / complain about / want\n123\t  stage person_stage not null default 'noticed',\n124\t  notes text,                     -- the founders' own notes\n125\t  first_touch_at timestamptz,\n126\t  last_touch_at timestamptz,\n127\t  created_at timestamptz not null default now(),\n128\t  updated_at timestamptz not null default now()\n129\t);\n130\t\n131\t-- A person's account on one platform, with a snapshot of the public profile\n132\t-- (bio, links, location, counts, join date — whatever the platform shows).\n133\tcreate table identities (\n134\t  id uuid primary key default gen_random_uuid(),\n135\t  project_id uuid not null references projects(id) on delete cascade,\n136\t  person_id uuid not null references people(id) on delete cascade,\n137\t  platform platform not null,\n138\t  handle text not null,\n139\t  external_id text,\n140\t  profile_url text,\n141\t  public_profile jsonb,           -- raw public profile as fetched\n142\t  profile_fetched_at timestamptz,\n143\t  unique (project_id, platform, handle)\n144\t);\n145\t\n146\t-- ------------------------------------------------------------------ items\n147\t-- Something that may need an answer: a reply, mention, quote, comment.\n148\tcreate table items (\n149\t  id uuid primary key default gen_random_uuid(),\n150\t  project_id uuid not null references projects(id) on delete cascade,\n151\t  account_id uuid not null references accounts(id) on delete cascade,\n152\t  person_id uuid not null references people(id) on delete cascade,\n153\t  platform platform not null,\n154\t  kind item_kind not null,\n155\t  external_id text not null,      -- the platform's id/uri for this post or comment\n156\t  url text,\n157\t  text text not null,\n158\t  posted_at timestamptz not null,\n159\t  root_ref jsonb,                 -- what a reply must point at (Bluesky root/parent uri+cid; dev.to comment id)\n160\t  parent_ref jsonb,\n161\t  my_post jsonb,                  -- {url, title, text} snapshot of the project's post/article it's under\n162\t  thread jsonb,                   -- [{author, text, posted_at}] snapshot of the thread above\n163\t  status item_status not null default 'new',\n164\t  assigned_to uuid references founders(id) on delete set null,   -- who answers it\n165\t  fetched_at timestamptz not null default now(),\n166\t  unique (project_id, platform, external_id)\n167\t);\n168\tcreate index items_waiting on items (project_id, status, posted_at desc);\n169\t\n170\tcreate table item_themes (\n171\t  item_id uuid not null references items(id) on delete cascade,\n172\t  theme_id uuid not null references themes(id) on delete cascade,\n173\t  auto boolean not null default true,   -- filed by the model (true) or by a founder\n174\t  primary key (item_id, theme_id)\n175\t);\n176\t\n177\t-- Every draft version, so models can be compared on real outcomes.\n178\tcreate table drafts (\n179\t  id uuid primary key default gen_random_uuid(),\n180\t  item_id uuid not null references items(id) on delete cascade,\n181\t  version int not null,\n182\t  instruction text,               -- null for the first; 'shorter' / a redraft note\n183\t  text text not null,\n184\t  provider text not null,         -- gemini / anthropic / …\n185\t  model text not null,\n186\t  tokens_in int,\n187\t  tokens_out int,\n188\t  latency_ms int,\n189\t  outcome draft_outcome,\n190\t  final_text text,                -- what was actually posted (after edits)\n191\t  posted_by uuid references founders(id) on delete set null,\n192\t  posted_url text,\n193\t  posted_at timestamptz,\n194\t  created_at timestamptz not null default now(),\n195\t  unique (item_id, version)\n196\t);\n197\t\n198\t-- ------------------------------------------------------------------ touches\n199\t-- Every touch with a person, both directions, any channel (comments, replies,\n200\t-- emails, outreach), including imports from the outreach sheet.\n201\tcreate table touches (\n202\t  id uuid primary key default gen_random_uuid(),\n203\t  project_id uuid not null references projects(id) on delete cascade,\n204\t  person_id uuid not null references people(id) on delete cascade,\n205\t  direction touch_direction not null,\n206\t  platform platform not null,\n207\t  kind text not null,             -- comment / reply / mention / email / outreach / dm\n208\t  occurred_at timestamptz not null,\n209\t  url text,\n210\t  text text,\n211\t  item_id uuid references items(id) on delete cascade,\n212\t  by_founder uuid references founders(id) on delete set null,   -- for outgoing touches\n213\t  source text not null default 'collector',   -- collector / import:outreach-sheet / manual\n214\t  meta jsonb not null default '{}'\n215\t);\n216\tcreate index touches_by_person on touches (person_id, occurred_at desc);\n217\t\n218\t-- ------------------------------------------------------------------ knowledge\n219\t-- What drafts know beyond the thread, for the whole project or one theme.\n220\tcreate table project_memory (\n221\t  id uuid primary key default gen_random_uuid(),\n222\t  project_id uuid not null references projects(id) on delete cascade,\n223\t  theme_id uuid references themes(id) on delete cascade,   -- null = whole project\n224\t  kind memory_kind not null,\n225\t  text text not null,\n226\t  source_url text,\n227\t  active boolean not null default true,\n228\t  created_at timestamptz not null default now()\n229\t);\n230\t\n231\t-- The project's own material (landing, articles, stories) for retrieval.\n232\tcreate table documents (\n233\t  id uuid primary key default gen_random_uuid(),\n234\t  project_id uuid not null references projects(id) on delete cascade,\n235\t  theme_id uuid references themes(id) on delete set null,\n236\t  kind text not null,             -- landing / article / story / doc\n237\t  url text not null,\n238\t  title text,\n239\t  content text not null,\n240\t  fetched_at timestamptz not null default now(),\n241\t  unique (project_id, url)\n242\t);\n243\t\n244\t-- ------------------------------------------------------------------ security\n245\t-- Membership check used by every policy; security definer so policies don't\n246\t-- recurse through project_members' own policy.\n247\tcreate function is_member(p uuid) returns boolean\n248\t  language sql stable security definer set search_path = public as\n249\t  $$ select exists (select 1 from project_members where project_id = p and founder_id = auth.uid()) $$;\n250\t\n251\tcreate function is_owner(p uuid) returns boolean\n252\t  language sql stable security definer set search_path = public as\n253\t  $$ select exists (select 1 from project_members where project_id = p and founder_id = auth.uid() and role = 'owner') $$;\n254\t\n255\talter table founders enable row level security;\n256\tcreate policy self on founders for all using (id = auth.uid()) with check (id = auth.uid());\n257\t-- teammates can see each other's name and avatar\n258\tcreate policy teammates on founders for select using (\n259\t  id in (select m.founder_id from project_members m where is_member(m.project_id)));\n260\t\n261\talter table projects enable row level security;\n262\tcreate policy members_read on projects for select using (is_member(id));\n263\tcreate policy owners_write on projects for update using (is_owner(id)) with check (is_owner(id));\n264\tcreate policy owners_delete on projects for delete using (is_owner(id));\n265\tcreate policy anyone_creates on projects for insert with check (created_by = auth.uid());\n266\t\n267\talter table project_members enable row level security;\n268\tcreate policy members_read on project_members for select using (is_member(project_id));\n269\tcreate policy owners_manage on project_members for all using (is_owner(project_id)) with check (is_owner(project_id));\n270\t\n271\talter table project_invites enable row level security;\n272\tcreate policy owners_manage on project_invites for all using (is_owner(project_id)) with check (is_owner(project_id));\n273\t\n274\tdo $$\n275\tdeclare t text;\n276\tbegin\n277\t  foreach t in array array['accounts','themes','people','identities','items','touches','project_memory','documents'] loop\n278\t    execute format('alter table %I enable row level security', t);\n279\t    execute format($p$create policy members_all on %I for all\n280\t      using (is_member(project_id)) with check (is_member(project_id))$p$, t);\n281\t  end loop;\n282\tend $$;\n283\t\n284\talter table item_themes enable row level security;\n285\tcreate policy members_all on item_themes for all\n286\t  using (exists (select 1 from items i where i.id = item_id and is_member(i.project_id)))\n287\t  with check (exists (select 1 from items i where i.id = item_id and is_member(i.project_id)));\n288\t\n289\talter table drafts enable row level security;\n290\tcreate policy members_all on drafts for all\n291\t  using (exists (select 1 from items i where i.id = item_id and is_member(i.project_id)))\n292\t  with check (exists (select 1 from items i where i.id = item_id and is_member(i.project_id)));\n293\t\n294\t-- The creator of a project becomes its owner.\n295\tcreate function add_creator_as_owner() returns trigger\n296\t  language plpgsql security definer set search_path = public as $$\n297\tbegin\n298\t  if new.created_by is not null then\n299\t    insert into project_members (project_id, founder_id, role) values (new.id, new.created_by, 'owner')\n300\t    on conflict do nothing;\n301\t  end if;\n302\t  return new;\n303\tend $$;\n304\tcreate trigger project_owner after insert on projects for each row execute function add_creator_as_owner();\n305\t\n306\t-- A founder row for every new login, and pending invites accepted by email.\n307\tcreate function on_new_user() returns trigger\n308\t  language plpgsql security definer set search_path = public as $$\n309\tbegin\n310\t  insert into founders (id, display_name, avatar_url)\n311\t  values (new.id, coalesce(new.raw_user_meta_data->>'full_name', new.raw_user_meta_data->>'name'),\n312\t          new.raw_user_meta_data->>'avatar_url')\n313\t  on conflict do nothing;\n314\t  insert into project_members (project_id, founder_id, role)\n315\t    select project_id, new.id, role from project_invites\n316\t    where lower(email) = lower(new.email) and accepted_at is null\n317\t  on conflict do nothing;\n318\t  update project_invites set accepted_at = now()\n319\t    where lower(email) = lower(new.email) and accepted_at is null;\n320\t  return new;\n321\tend $$;\n322\tcreate trigger founder_on_signup after insert on auth.users for each row execute function on_new_user();\n323\t=== supabase/migrations/20261008180000_no_anon.sql\n324\t-- Defence in depth: the app is always signed in, so anonymous callers (the\n325\t-- public anon key without a session) get no table access at all, not just\n326\t-- empty results from row-level security. Future tables too.\n327\trevoke all on all tables in schema public from anon;\n328\trevoke all on all sequences in schema public from anon;\n329\trevoke execute on all functions in schema public from anon;\n330\talter default privileges in schema public revoke all on tables from anon;\n331\talter default privileges in schema public revoke all on sequences from anon;\n332\talter default privileges in schema public revoke execute on functions from anon;\n333\t=== supabase/migrations/20261008190000_waitlist.sql\n334\t-- The landing page's waitlist. Anonymous visitors can ADD an email, nothing\n335\t-- else: no read, no update, no delete (the table is otherwise closed to anon,\n336\t-- see 20261008180000_no_anon). Founders read it with the service role.\n337\tcreate table waitlist (\n338\t  id uuid primary key default gen_random_uuid(),\n339\t  email text not null check (email ~* '^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$' and length(email) <= 254),\n340\t  role text check (length(role) <= 120),          -- optional: \"founder\", \"devrel\", ...\n341\t  note text check (length(note) <= 1000),          -- optional: what they'd want from it\n342\t  source text check (length(source) <= 200),       -- utm / referrer\n343\t  created_at timestamptz not null default now()\n344\t);\n345\tcreate unique index waitlist_email on waitlist (lower(email));\n346\talter table waitlist enable row level security;\n347\tcreate policy anyone_can_join on waitlist for insert to anon, authenticated with check (true);\n348\tgrant insert (email, role, note, source) on waitlist to anon, authenticated;\n349\t=== supabase/migrations/20261008230000_enum_values.sql\n350\t-- New enum values for the v1 screens (docs/API.md). Own migration: a value\n351\t-- added by ALTER TYPE can't be used in the same transaction.\n352\t--   person_stage: the design's four people tabs are Talked (talking),\n353\t--   Gave feedback, Wants to try (would_try), Would pay.\n354\t--   item_kind: a post found by Discover, not addressed to the founder.\n355\talter type person_stage add value if not exists 'gave_feedback' after 'talking';\n356\talter type person_stage add value if not exists 'would_pay' after 'would_try';\n357\talter type item_kind add value if not exists 'post';\n358\t=== supabase/migrations/20261008230100_knowledge_chunks.sql\n359\t-- Knowledge base for drafts (eval/REPORT-v2.md) and triage results on items\n360\t-- (Yahhi/hearback#5). Was 20261015120000 (draft); applied as part of backend v1.\n361\t-- Change from the draft: every chunk carries a label. 'quotable' = her\n362\t-- published work (may be quoted and linked); 'background' = unpublished\n363\t-- material, context only, never quoted (REPORT-v2: private research leaked\n364\t-- into public drafts).\n365\t--\n366\t-- What drafts know beyond the thread is the founder's published body of work\n367\t-- (articles, stories, research, release notes, README, FAQ), cut into\n368\t-- ~300–600-token chunks, each with a date, a kind and, when public, a URL the\n369\t-- draft may cite. Retrieval per item: the top ~40 chunks by cosine published\n370\t-- BEFORE the item, then MMR + per-source cap in the engine (retrieve.ts).\n371\t--\n372\t-- Requires pgvector >= 0.8 (iterative index scans, so the project filter\n373\t-- doesn't starve the HNSW result).\n374\t\n375\tcreate extension if not exists vector with schema extensions;\n376\tset search_path = public, extensions;\n377\t\n378\t-- ------------------------------------------------------------------ documents\n379\t-- documents (init migration) holds whole sources; it gains what retrieval needs.\n380\talter table documents\n381\t  add column published_at timestamptz,          -- when it became public (null = unknown → never retrieved)\n382\t  add column published_precision text not null default 'instant'\n383\t    check (published_precision in ('instant', 'day')),\n384\t  add column is_public boolean not null default true, -- false: a private source (e.g. a private repo); never linked in a draft\n385\t  add column source_ref text;                     -- where it came from when there's no public URL\n386\t\n387\t-- ------------------------------------------------------------------ chunks\n388\tcreate table document_chunks (\n389\t  id uuid primary key default gen_random_uuid(),\n390\t  project_id uuid not null references projects(id) on delete cascade,\n391\t  document_id uuid not null references documents(id) on delete cascade,\n392\t  ord int not null,                               -- position in the document\n393\t  kind text not null check (kind in ('article', 'story', 'research', 'changelog', 'readme', 'faq', 'fact')),\n394\t  title text not null,                            -- \"Doc title › Section\"\n395\t  source_url text,                                -- public link a draft may cite; null when not public\n396\t  source_ref text,\n397\t  -- A chunk is as new as its newest line (git blame for files): a README\n398\t  -- section written yesterday is not visible to a comment from last week.\n399\t  published_at timestamptz not null,\n400\t  published_precision text not null default 'instant' check (published_precision in ('instant', 'day')),\n401\t  content text not null,\n402\t  content_sha256 text not null,                   -- skip re-embedding unchanged chunks\n403\t  tokens int not null,\n404\t  lang text not null default 'en',\n405\t  embedding vector(768),                          -- gemini-embedding-001, outputDimensionality 768, L2-normalised\n406\t  embedding_model text,\n407\t  label text not null default 'quotable' check (label in ('quotable', 'background')),\n408\t  created_at timestamptz not null default now(),\n409\t  unique (document_id, ord)\n410\t);\n411\tcreate index document_chunks_project on document_chunks (project_id, published_at);\n412\tcreate index document_chunks_embedding on document_chunks\n413\t  using hnsw (embedding vector_cosine_ops) with (m = 16, ef_construction = 64);\n414\t\n415\talter table document_chunks enable row level security;\n416\tcreate policy members_all on document_chunks for all\n417\t  using (is_member(project_id)) with check (is_member(project_id));\n418\t\n419\t-- ------------------------------------------------------------------ retrieval\n420\t-- Candidates for one item: published strictly before p_before (a day-precision\n421\t-- chunk only if its day is earlier: a same-day commit may be the answer to the\n422\t-- comment), optionally limited to kinds, nearest first. The engine re-ranks\n423\t-- (MMR, at most 2 per source) and keeps ~6. security invoker: RLS applies, so\n424\t-- a founder only ever retrieves her own projects' chunks.\n425\tcreate function match_document_chunks(\n426\t  p_project uuid,\n427\t  p_query vector(768),\n428\t  p_before timestamptz default now(),\n429\t  p_count int default 40,\n430\t  p_kinds text[] default null,\n431\t  p_min_similarity float default 0.68,\n432\t  p_labels text[] default array['quotable']\n433\t) returns table (\n434\t  id uuid, kind text, title text, source_url text, source_ref text,\n435\t  published_at timestamptz, published_precision text, content text, tokens int, lang text,\n436\t  similarity float, embedding vector(768), label text\n437\t)\n438\tlanguage sql stable security invoker\n439\tset search_path = public, extensions\n440\tset hnsw.ef_search = 100\n441\tset hnsw.iterative_scan = relaxed_order\n442\tas $$\n443\t  select c.id, c.kind, c.title, c.source_url, c.source_ref,\n444\t         c.published_at, c.published_precision, c.content, c.tokens, c.lang,\n445\t         1 - (c.embedding <=> p_query) as similarity, c.embedding, c.label\n446\t  from document_chunks c\n447\t  where c.project_id = p_project\n448\t    and c.embedding is not null\n449\t    and (p_kinds is null or c.kind = any (p_kinds))\n450\t    and c.label = any (p_labels)\n451\t    and case c.published_precision\n452\t          when 'day' then (c.published_at at time zone 'utc')::date < (p_before at time zone 'utc')::date\n453\t          else c.published_at < p_before\n454\t        end\n455\t    and 1 - (c.embedding <=> p_query) >= p_min_similarity\n456\t  order by c.embedding <=> p_query\n457\t  limit greatest(1, least(p_count, 200));\n458\t$$;\n459\t\n460\t-- ------------------------------------------------------------------ triage on items\n461\t-- triage.ts › TriageResult, as the app shows it: kind, route (decide_queue /\n462\t-- draft / short_draft / skip), not_sure, one-line summary, suggested action,\n463\t-- probabilities, and which decider answered (gemini / typesafe + model).\n464\t-- (generated columns for the app: see 20261008230200_backend_v1.sql)\n465\talter table items\n466\t  add column triage jsonb,\n467\t  add column triage_route text generated always as (triage->>'route') stored;\n468\tcreate index items_triage_route on items (project_id, triage_route, posted_at desc);\n469\t=== supabase/migrations/20261008230200_backend_v1.sql\n470\t-- Backend v1 (docs/API.md): what the MVP screens need on top of the init\n471\t-- schema. Onboarding (project from a landing page), triage on items, drafts by\n472\t-- intent, ideas from feedback, the draft decision as one transaction, Vault\n473\t-- for Bluesky app passwords, an inbox view grouped by person, realtime.\n474\t\n475\t-- ------------------------------------------------------------------ projects\n476\talter table projects\n477\t  add column url text,\n478\t  add column description text,\n479\t  add column topics text[] not null default '{}',\n480\t  add column competitors text[] not null default '{}',\n481\t  add column aims text,\n482\t  add column landing jsonb,\n483\t  add column landing_read_at timestamptz,\n484\t  add column github_repo text check (github_repo is null or github_repo ~ '^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$'),\n485\t  add column knowledge_sources jsonb not null default '{}';\n486\talter table projects alter column audience type text[]\n487\t  using case when audience is null or audience = '' then '{}'::text[] else array[audience] end;\n488\talter table projects alter column audience set default '{}';\n489\talter table projects alter column audience set not null;\n490\t\n491\t-- ------------------------------------------------------------------ accounts\n492\talter table accounts\n493\t  add column last_error text,\n494\t  add column settings jsonb not null default '{}';\n495\t\n496\t-- The app may create a dev.to account row and switch accounts on/off, but\n497\t-- never set secret_id, external_id or the poll cursor: those belong to the\n498\t-- server (a forged secret_id could point the poller at another project's secret).\n499\trevoke insert, update on accounts from authenticated;\n500\tgrant insert (project_id, platform, handle, auth, connected_by, active, settings) on accounts to authenticated;\n501\tgrant update (project_id, platform, handle, auth, connected_by, active, settings) on accounts to authenticated;\n502\talter table accounts add constraint accounts_app_no_secret check (auth <> 'none' or secret_id is null);\n503\t\n504\t-- ------------------------------------------------------------------ people\n505\talter table people add column stage_changed_at timestamptz;\n506\t\n507\tcreate function people_touch_updated() returns trigger language plpgsql as $$\n508\tbegin\n509\t  new.updated_at := now();\n510\t  if new.stage is distinct from old.stage then new.stage_changed_at := now(); end if;\n511\t  return new;\n512\tend $$;\n513\tcreate trigger people_updated before update on people for each row execute function people_touch_updated();\n514\t\n515\t-- ------------------------------------------------------------------ items\n516\talter table items alter column account_id drop not null;\n517\talter table items\n518\t  add column origin text not null default 'inbox' check (origin in ('inbox', 'discover')),\n519\t  add column triaged_at timestamptz,\n520\t  add column skip_reason text,\n521\t  add column discovery jsonb,\n522\t  add column triage_kind text generated always as (triage->>'kind') stored,\n523\t  add column triage_action text generated always as (triage->>'suggested_action') stored,\n524\t  add column triage_confidence real generated always as ((triage->>'confidence')::real) stored,\n525\t  add column triage_summary text generated always as (triage->>'summary') stored;\n526\tcreate index items_inbox on items (project_id, origin, status, posted_at desc);\n527\tcreate index items_untriaged on items (fetched_at) where triaged_at is null and origin = 'inbox';\n528\tcreate index items_person on items (person_id, posted_at desc);\n529\t\n530\t-- ------------------------------------------------------------------ drafts\n531\talter table drafts\n532\t  add column intent text check (intent in ('just_answer', 'invite_to_try', 'ask_feedback', 'ask_price', 'auto')),\n533\t  add column variant text not null default 'first' check (variant in ('first', 'shorter', 'redraft')),\n534\t  add column checks text[] not null default '{}',\n535\t  add column sources jsonb not null default '[]',\n536\t  add column lint jsonb,\n537\t  add column decided_by uuid references founders(id) on delete set null,\n538\t  add column decided_at timestamptz;\n539\t\n540\t-- ------------------------------------------------------------------ ideas\n541\t-- Feedback turned into something to build. Similar asks from different\n542\t-- people are grouped into one idea; asked_by counts distinct people.\n543\tcreate table ideas (\n544\t  id uuid primary key default gen_random_uuid(),\n545\t  project_id uuid not null references projects(id) on delete cascade,\n546\t  title text not null,\n547\t  summary text,\n548\t  quote text,                       -- the exact phrase heard (first ask)\n549\t  kind text not null default 'feature' check (kind in ('feature', 'bug', 'pain', 'would_pay', 'other')),\n550\t  asked_by int not null default 0,  -- distinct people, kept by trigger\n551\t  status text not null default 'new' check (status in ('new', 'planned', 'issue_open', 'not_now', 'done')),\n552\t  github_issue_url text,\n553\t  github_issue_number int,\n554\t  created_at timestamptz not null default now(),\n555\t  updated_at timestamptz not null default now()\n556\t);\n557\tcreate index ideas_project on ideas (project_id, status, updated_at desc);\n558\t\n559\tcreate table idea_items (\n560\t  idea_id uuid not null references ideas(id) on delete cascade,\n561\t  item_id uuid not null references items(id) on delete cascade,\n562\t  person_id uuid not null references people(id) on delete cascade,\n563\t  project_id uuid not null references projects(id) on delete cascade,\n564\t  quote text,\n565\t  created_at timestamptz not null default now(),\n566\t  primary key (idea_id, item_id)\n567\t);\n568\tcreate index idea_items_item on idea_items (item_id);\n569\t\n570\talter table ideas enable row level security;\n571\tcreate policy members_all on ideas for all using (is_member(project_id)) with check (is_member(project_id));\n572\talter table idea_items enable row level security;\n573\tcreate policy members_all on idea_items for all using (is_member(project_id)) with check (is_member(project_id));\n574\t\n575\tcreate function ideas_recount() returns trigger language plpgsql security definer set search_path = public as $$\n576\tdeclare i uuid := coalesce(new.idea_id, old.idea_id);\n577\tbegin\n578\t  update ideas set asked_by = (select count(distinct person_id) from idea_items where idea_id = i), updated_at = now()\n579\t  where id = i;\n580\t  return null;\n581\tend $$;\n582\tcreate trigger idea_items_count after insert or delete on idea_items for each row execute function ideas_recount();\n583\t\n584\t-- ------------------------------------------------------------------ decision RPC\n585\t-- The founder's decision on a draft, atomically (app/README.md asked for it).\n586\t-- security definer with an explicit membership check: the caller must be a\n587\t-- member of the draft's project.\n588\tcreate function record_draft_outcome(\n589\t  p_draft_id uuid,\n590\t  p_outcome draft_outcome,\n591\t  p_final_text text default null,\n592\t  p_posted_url text default null,\n593\t  p_move_stage person_stage default null\n594\t) returns drafts\n595\tlanguage plpgsql security definer set search_path = public as $$\n596\tdeclare\n597\t  d drafts;\n598\t  it items;\n599\t  uid uuid := auth.uid();\n600\t  posted boolean := p_outcome in ('posted_as_is', 'posted_edited');\n601\tbegin\n602\t  if p_outcome not in ('posted_as_is', 'posted_edited', 'skipped') then raise exception 'bad_outcome'; end if;\n603\t  if posted and coalesce(btrim(p_final_text), '') = '' then raise exception 'final_text_required'; end if;\n604\t  select * into d from drafts where id = p_draft_id for update;\n605\t  if not found then raise exception 'not_found'; end if;\n606\t  select * into it from items where id = d.item_id for update;\n607\t  if uid is null or not is_member(it.project_id) then raise exception 'not_found'; end if;\n608\t  if d.outcome is not null then raise exception 'already_decided'; end if;\n609\t\n610\t  update drafts set\n611\t    outcome = p_outcome,\n612\t    final_text = case when posted then p_final_text else final_text end,\n613\t    posted_url = case when posted then p_posted_url else posted_url end,\n614\t    posted_at = case when posted then now() else posted_at end,\n615\t    posted_by = case when posted then uid else posted_by end,\n616\t    decided_by = uid, decided_at = now()\n617\t  where id = p_draft_id returning * into d;\n618\t\n619\t  update drafts set outcome = 'superseded', decided_at = now()\n620\t  where item_id = it.id and id <> p_draft_id and outcome is null;\n621\t\n622\t  update items set status = case when posted then 'answered'::item_status else 'skipped'::item_status end,\n623\t                   skip_reason = null\n624\t  where id = it.id;\n625\t\n626\t  if posted then\n627\t    insert into touches (project_id, person_id, direction, platform, kind, occurred_at, url, text, item_id, by_founder, source)\n628\t    values (it.project_id, it.person_id, 'out', it.platform, 'reply', now(), p_posted_url, p_final_text, it.id, uid, 'app');\n629\t    update people set\n630\t      last_touch_at = now(),\n631\t      stage = coalesce(p_move_stage, case when stage = 'noticed' then 'talking'::person_stage else stage end)\n632\t    where id = it.person_id;\n633\t  elsif p_move_stage is not null then\n634\t    update people set stage = p_move_stage where id = it.person_id;\n635\t  end if;\n636\t  return d;\n637\tend $$;\n638\trevoke execute on function record_draft_outcome(uuid, draft_outcome, text, text, person_stage) from public, anon;\n639\tgrant execute on function record_draft_outcome(uuid, draft_outcome, text, text, person_stage) to authenticated, service_role;\n640\t\n641\t-- ------------------------------------------------------------------ Vault\n642\t-- Bluesky app passwords live in Vault; only the service role (Edge Functions)\n643\t-- can store or read them. The secret's name binds it to its account.\n644\tcreate function store_account_secret(p_account uuid, p_secret text) returns uuid\n645\tlanguage plpgsql security definer set search_path = public, vault as $$\n646\tdeclare sid uuid;\n647\tbegin\n648\t  select secret_id into sid from accounts where id = p_account;\n649\t  if not found then raise exception 'not_found'; end if;\n650\t  if sid is not null and exists (select 1 from vault.secrets where id = sid) then\n651\t    perform vault.update_secret(sid, p_secret);\n652\t  else\n653\t    sid := vault.create_secret(p_secret, 'account:' || p_account::text || ':' || gen_random_uuid()::text, 'hearback account credential');\n654\t    update accounts set secret_id = sid where id = p_account;\n655\t  end if;\n656\t  return sid;\n657\tend $$;\n658\t\n659\tcreate function read_account_secret(p_account uuid) returns text\n660\tlanguage sql stable security definer set search_path = public, vault as $$\n661\t  select s.decrypted_secret\n662\t  from accounts a join vault.decrypted_secrets s on s.id = a.secret_id\n663\t  where a.id = p_account and s.name like 'account:' || p_account::text || ':%';\n664\t$$;\n665\t\n666\tcreate function delete_account_secret(p_account uuid) returns void\n667\tlanguage plpgsql security definer set search_path = public, vault as $$\n668\tdeclare sid uuid;\n669\tbegin\n670\t  select secret_id into sid from accounts where id = p_account;\n671\t  if sid is not null then\n672\t    delete from vault.secrets where id = sid;\n673\t    update accounts set secret_id = null where id = p_account;\n674\t  end if;\n675\tend $$;\n676\t\n677\trevoke execute on function store_account_secret(uuid, text) from public, anon, authenticated;\n678\trevoke execute on function read_account_secret(uuid) from public, anon, authenticated;\n679\trevoke execute on function delete_account_secret(uuid) from public, anon, authenticated;\n680\tgrant execute on function store_account_secret(uuid, text) to service_role;\n681\tgrant execute on function read_account_secret(uuid) to service_role;\n682\tgrant execute on function delete_account_secret(uuid) to service_role;\n683\t\n684\t-- ------------------------------------------------------------------ inbox view\n685\t-- One row per person with something waiting (design 1g: grouped by person).\n686\tcreate view inbox_by_person with (security_invoker = true) as\n687\twith w as (\n688\t  select i.*, row_number() over (partition by i.person_id order by i.posted_at desc) rn\n689\t  from items i\n690\t  where i.origin = 'inbox' and i.status in ('new', 'draft_ready')\n691\t)\n692\tselect\n693\t  w.project_id, w.person_id, p.display_name, p.avatar_url, p.stage,\n694\t  count(*)::int as waiting,\n695\t  count(*) filter (where w.status = 'new')::int as needs_you,\n696\t  count(*) filter (where w.status = 'draft_ready')::int as draft_ready,\n697\t  array_agg(distinct w.platform::text) as platforms,\n698\t  max(w.id::text) filter (where w.rn = 1)::uuid as last_item_id,\n699\t  max(w.text) filter (where w.rn = 1) as last_item_text,\n700\t  max(w.kind::text) filter (where w.rn = 1) as last_item_kind,\n701\t  max(w.platform::text) filter (where w.rn = 1) as last_item_platform,\n702\t  max(w.posted_at) as last_posted_at,\n703\t  max(w.status::text) filter (where w.rn = 1) as last_status,\n704\t  (select d.text from drafts d where d.item_id = max(w.id::text) filter (where w.rn = 1)::uuid and d.outcome is null\n705\t     order by d.version desc limit 1) as last_draft_text,\n706\t  exists (select 1 from idea_items ii where ii.person_id = w.person_id) as has_idea\n707\tfrom w join people p on p.id = w.person_id\n708\tgroup by w.project_id, w.person_id, p.display_name, p.avatar_url, p.stage;\n709\trevoke all on inbox_by_person from anon;\n710\tgrant select on inbox_by_person to authenticated;\n711\t\n712\t-- ------------------------------------------------------------------ realtime\n713\tdo $$ begin\n714\t  if exists (select 1 from pg_publication where pubname = 'supabase_realtime') then\n715\t    alter publication supabase_realtime add table items, drafts, ideas;\n716\t  end if;\n717\tend $$;\n718\t\n719\t-- anon stays closed (20261008180000_no_anon) for everything created here.\n720\trevoke all on ideas, idea_items from anon;\n721\t=== supabase/migrations/20261008230300_cron.sql\n722\t-- Background polling: pg_cron calls the Edge Functions through pg_net with the\n723\t-- service role. The URL and key are read from Vault at run time (secrets\n724\t-- 'hb_project_url' and 'hb_service_role', set by scripts/set-cron-secrets.sh),\n725\t-- so nothing secret is in this file or in cron.job.\n726\tcreate extension if not exists pg_cron with schema pg_catalog;\n727\tcreate extension if not exists pg_net with schema extensions;\n728\t\n729\tcreate or replace function hb_call_function(p_name text, p_body jsonb default '{}') returns bigint\n730\tlanguage plpgsql security definer set search_path = public, extensions, vault as $$\n731\tdeclare\n732\t  base text := (select decrypted_secret from vault.decrypted_secrets where name = 'hb_project_url');\n733\t  key text := (select decrypted_secret from vault.decrypted_secrets where name = 'hb_service_role');\n734\tbegin\n735\t  if base is null or key is null then\n736\t    raise warning 'hb_call_function: vault secrets hb_project_url / hb_service_role are missing';\n737\t    return null;\n738\t  end if;\n739\t  return net.http_post(\n740\t    url := base || '/functions/v1/' || p_name,\n741\t    headers := jsonb_build_object('content-type', 'application/json', 'authorization', 'Bearer ' || key),\n742\t    body := p_body,\n743\t    timeout_milliseconds := 150000);\n744\tend $$;\n745\trevoke execute on function hb_call_function(text, jsonb) from public, anon, authenticated;\n746\t\n747\tselect cron.schedule('hb-poll-bluesky', '*/5 * * * *', $$select hb_call_function('poll-bluesky')$$);\n748\tselect cron.schedule('hb-poll-devto-public', '*/15 * * * *', $$select hb_call_function('poll-devto-public')$$);\n749\t-- Items that arrived but weren't triaged inline (caps, model errors).\n750\tselect cron.schedule('hb-triage-pending', '2-59/5 * * * *', $$select hb_call_function('triage', '{\"pending\": true}')$$);\n751\t=== supabase/migrations/20261008230400_server_state.sql\n752\t-- Server-side state for the collectors.\n753\t--  * Bluesky sessions: createSession is limited (30 per 5 min, 300 per day per\n754\t--    account), so the poller keeps the session (access + refresh JWT) in Vault\n755\t--    and refreshes it instead of logging in every 5 minutes.\n756\t--  * usage_counters: a per-day request cap for paid/free-tier model calls, so a\n757\t--    cron loop can't burn the day's quota.\n758\t\n759\tcreate function store_account_session(p_account uuid, p_session text) returns void\n760\tlanguage plpgsql security definer set search_path = public, vault as $$\n761\tdeclare sid uuid; nm text := 'account-session:' || p_account::text;\n762\tbegin\n763\t  select id into sid from vault.secrets where name = nm;\n764\t  if sid is null then perform vault.create_secret(p_session, nm, 'hearback bluesky session');\n765\t  else perform vault.update_secret(sid, p_session); end if;\n766\tend $$;\n767\t\n768\tcreate function read_account_session(p_account uuid) returns text\n769\tlanguage sql stable security definer set search_path = public, vault as $$\n770\t  select decrypted_secret from vault.decrypted_secrets where name = 'account-session:' || p_account::text;\n771\t$$;\n772\t\n773\tcreate or replace function delete_account_secret(p_account uuid) returns void\n774\tlanguage plpgsql security definer set search_path = public, vault as $$\n775\tdeclare sid uuid;\n776\tbegin\n777\t  select secret_id into sid from accounts where id = p_account;\n778\t  if sid is not null then\n779\t    delete from vault.secrets where id = sid;\n780\t    update accounts set secret_id = null where id = p_account;\n781\t  end if;\n782\t  delete from vault.secrets where name = 'account-session:' || p_account::text;\n783\tend $$;\n784\t\n785\trevoke execute on function store_account_session(uuid, text) from public, anon, authenticated;\n786\trevoke execute on function read_account_session(uuid) from public, anon, authenticated;\n787\tgrant execute on function store_account_session(uuid, text) to service_role;\n788\tgrant execute on function read_account_session(uuid) to service_role;\n789\t\n790\tcreate table usage_counters (\n791\t  day date not null default (now() at time zone 'utc')::date,\n792\t  key text not null,\n793\t  n int not null default 0,\n794\t  primary key (day, key)\n795\t);\n796\talter table usage_counters enable row level security;  -- no policies: service role only\n797\trevoke all on usage_counters from anon, authenticated;\n798\t\n799\t-- Adds one request under p_key for today; false (and no increment) when the cap is reached.\n800\tcreate function bump_usage(p_key text, p_cap int) returns boolean\n801\tlanguage plpgsql security definer set search_path = public as $$\n802\tdeclare cur int;\n803\tbegin\n804\t  insert into usage_counters (key, n) values (p_key, 0) on conflict do nothing;\n805\t  select n into cur from usage_counters where day = (now() at time zone 'utc')::date and key = p_key for update;\n806\t  if cur >= p_cap then return false; end if;\n807\t  update usage_counters set n = n + 1 where day = (now() at time zone 'utc')::date and key = p_key;\n808\t  return true;\n809\tend $$;\n810\trevoke execute on function bump_usage(text, int) from public, anon, authenticated;\n811\tgrant execute on function bump_usage(text, int) to service_role;\n812\t=== supabase/migrations/20261008230500_project_creator_read.sql\n813\t-- Fix: the app creates a project with insert(...).select(). RETURNING checks\n814\t-- the select policy, and is_member() (a stable function) can't yet see the\n815\t-- owner row the after-insert trigger adds in the same statement, so the insert\n816\t-- failed with \"new row violates row-level security policy\". The creator may\n817\t-- always read the projects she created.\n818\tcreate policy creator_reads on projects for select using (created_by = auth.uid());\n819\t"}]},"parent_tool_use_id":null,"session_id":"12758654-5564-441d-a699-220d2405b2b5","uuid":"c409af55-7a1e-48b6-8d44-0fa435661bcd","timestamp":"2026-10-18T01:45:55.045Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/valentinakoniukhova/.claude/projects/-private-tmp-h-15NWzU/12758654-5564-441d-a699-220d2405b2b5/tool-results/brfmh4krh.txt","content":"# hearback backend\n\nSupabase project behind Hearback (drafts replies to comments on a founder's posts).\n\n- `supabase/migrations/` — the schema, in the order it was applied\n- `supabase/functions/` — Deno edge functions (the server code that reads and writes it)\n=== supabase/migrations/20261008170000_init.sql\n-- Hearback schema v1 (draft 2, 2026-10-08). Not applied until reviewed.\n--\n-- Founders (users) sign in with Supabase Auth. A project can have several\n-- founders, and a founder can be in several projects (project_members). A\n-- project listens on accounts (Bluesky, dev.to…), turns what needs an answer\n-- into items, files them under themes (\"MCP servers\"), drafts replies with the\n-- theme's knowledge, and keeps every person's public profile and full history\n-- of touches. Row-level security from day one: a row is visible only to members\n-- of its project. Platform credentials never leave the database unencrypted:\n-- they live in Supabase Vault, readable only by the service role (the collector\n-- and the draft engine), never by the app.\n\ncreate extension if not exists \"pgcrypto\";\n\ncreate type platform as enum ('bluesky', 'devto', 'github', 'threads', 'habr', 'reddit', 'x', 'email', 'other');\ncreate type member_role as enum ('owner', 'member');\ncreate type item_kind as enum ('reply', 'mention', 'quote', 'comment');\ncreate type item_status as enum ('new', 'draft_ready', 'answered', 'skipped');\ncreate type person_stage as enum ('noticed', 'talking', 'engaged', 'supporter', 'would_try', 'customer', 'not_a_fit');\ncreate type touch_direction as enum ('in', 'out');\ncreate type draft_outcome as enum ('posted_as_is', 'posted_edited', 'skipped', 'superseded');\ncreate type memory_kind as enum ('voice_sample', 'preference', 'need', 'faq', 'fact', 'position');\ncreate type auth_kind as enum ('none', 'oauth', 'app_password', 'api_key');\n\n-- ------------------------------------------------------------------ founders\n-- auth.users holds the login; this is the founder's own profile.\ncreate table founders (\n  id uuid primary key references auth.users(id) on delete cascade,\n  display_name text,\n  avatar_url text,\n  voice_notes text,               -- how this founder writes (tone, habits), used in their drafts\n  languages text[] not null default '{en}',\n  created_at timestamptz not null default now()\n);\n\n-- ------------------------------------------------------------------ projects\ncreate table projects (\n  id uuid primary key default gen_random_uuid(),\n  name text not null,\n  one_liner text,                 -- the product in one sentence\n  audience text,                  -- who it's for\n  views text,                     -- what the team believes\n  red_lines text,                 -- never promise / never say\n  tone text,\n  languages text[] not null default '{en}',\n  links jsonb not null default '[]',   -- [{title, url}] landing, repo, key articles\n  created_by uuid references founders(id) on delete set null,\n  created_at timestamptz not null default now()\n);\n\ncreate table project_members (\n  project_id uuid not null references projects(id) on delete cascade,\n  founder_id uuid not null references founders(id) on delete cascade,\n  role member_role not null default 'member',\n  joined_at timestamptz not null default now(),\n  primary key (project_id, founder_id)\n);\n\n-- Pending invitations by email; accepted on first sign-in with that email.\ncreate table project_invites (\n  id uuid primary key default gen_random_uuid(),\n  project_id uuid not null references projects(id) on delete cascade,\n  email text not null,\n  role member_role not null default 'member',\n  invited_by uuid references founders(id) on delete set null,\n  created_at timestamptz not null default now(),\n  accepted_at timestamptz,\n  unique (project_id, email)\n);\n\n-- ------------------------------------------------------------------ accounts\n-- A listened-to account of the project on a platform. The credential (an OAuth\n-- token set, an app password or an API key) is a Vault secret referenced by id;\n-- dev.to needs none for reading (auth = 'none').\ncreate table accounts (\n  id uuid primary key default gen_random_uuid(),\n  project_id uuid not null references projects(id) on delete cascade,\n  platform platform not null,\n  handle text not null,\n  external_id text,               -- e.g. Bluesky DID\n  auth auth_kind not null default 'none',\n  secret_id uuid,                 -- vault.secrets.id; null when auth = 'none'\n  connected_by uuid references founders(id) on delete set null,\n  cursor text,                    -- platform paging cursor of the last poll\n  last_polled_at timestamptz,\n  active boolean not null default true,\n  unique (project_id, platform, handle)\n);\n\n-- ------------------------------------------------------------------ themes\n-- A topic conversations come back to (\"MCP servers\", \"agent skills\"). Items are\n-- filed under themes, and a theme carries its own positions, facts and sources,\n-- so drafts inside one theme stay consistent.\ncreate table themes (\n  id uuid primary key default gen_random_uuid(),\n  project_id uuid not null references projects(id) on delete cascade,\n  name text not null,\n  description text,               -- what belongs here (used to auto-file items)\n  position text,                  -- the team's stance on this theme\n  created_at timestamptz not null default now(),\n  unique (project_id, name)\n);\n\n-- ------------------------------------------------------------------ people\n-- A person the project talks to, however many platforms they're on.\n-- Deleting a person deletes everything about them: identities, their items\n-- (and the drafts under them), touches.\ncreate table people (\n  id uuid primary key default gen_random_uuid(),\n  project_id uuid not null references projects(id) on delete cascade,\n  display_name text,\n  avatar_url text,\n  summary text,                   -- who they are, written from public profile + touches\n  builds text,                    -- what they build\n  cares_about text,               -- what they ask for / complain about / want\n  stage person_stage not null default 'noticed',\n  notes text,                     -- the founders' own notes\n  first_touch_at timestamptz,\n  last_touch_at timestamptz,\n  created_at timestamptz not null default now(),\n  updated_at timestamptz not null default now()\n);\n\n-- A person's account on one platform, with a snapshot of the public profile\n-- (bio, links, location, counts, join date — whatever the platform shows).\ncreate table identities (\n  id uuid primary key default gen_random_uuid(),\n  project_id uuid not null references projects(id) on delete cascade,\n  person_id uuid not null references people(id) on delete cascade,\n  platform platform not null,\n  handle text not null,\n  external_id text,\n  profile_url text,\n  public_profile jsonb,           -- raw public profile as fetched\n  profile_fetched_at timestamptz,\n  unique (project_id, platform, handle)\n);\n\n-- ------------------------------------------------------------------ items\n-- Something that may need an answer: a reply, mention, quote, comment.\ncreate table items (\n  id uuid primary key default gen_random_uuid(),\n  project_id uuid not null references projects(id) on delete cascade,\n  account_id uuid not null references accounts(id) on delete cascade,\n  person_id uuid not null references people(id) on delete cascade,\n  platform platform not null,\n  kind item_kind not null,\n  external_id text not null,      -- the platform's id/uri for this post or comment\n  url text,\n  text text not null,\n  posted_at timestamptz not null,\n  root_ref jsonb,                 -- what a reply must point at (Bluesky root/parent uri+cid; dev.to comment id)\n  parent_ref jsonb,\n  my_post jsonb,                  -- {url, title, text} snapshot of the project's post/article it's under\n  thread jsonb,                   -- [{author, text, posted_at}] snapshot of the thread above\n  status item_status not null default 'new',\n  assigned_to uuid references founders(id) on delete set null,   -- who answers it\n  fetched_at timestamptz not null default now(),\n  unique (project_id, platform, external_id)\n);\ncreate index items_waiting on items (project_id, status, posted_at desc);\n\ncreate table item_themes (\n  item_id uuid not null references items(id) on delete cascade,\n  theme_id uuid not null references themes(id) on delete cascade,\n  auto boolean not null default true,   -- filed by the model (true) or by a founder\n  primary key (item_id, theme_id)\n);\n\n-- Every draft version, so models can be compared on real outcomes.\ncreate table drafts (\n  id uuid primary key default gen_random_uuid(),\n  item_id uuid not null references items(id) on delete cascade,\n  version int not null,\n  instruction text,               -- null for the first; 'shorter' / a redraft note\n  text text not null,\n  provider text not null,         -- gemini / anthropic / …\n  model text not null,\n  tokens_in int,\n  tokens_out int,\n  latency_ms int,\n  outcome draft_outcome,\n  final_text text,                -- what was actually posted (after edits)\n  posted_by uuid references founders(id) on delete set null,\n  posted_url text,\n  posted_at timestamptz,\n  created_at timestamptz not null default now(),\n  unique (item_id, version)\n);\n\n-- ------------------------------------------------------------------ touches\n-- Every touch with a person, both directions, any channel (comments, replies,\n-- emails, outreach), including imports from the outreach sheet.\ncreate table touches (\n  id uuid primary key default gen_random_uuid(),\n  project_id uuid not null references projects(id) on delete cascade,\n  person_id uuid not null references people(id) on delete cascade,\n  direction touch_direction not null,\n  platform platform not null,\n  kind text not null,             -- comment / reply / mention / email / outreach / dm\n  occurred_at timestamptz not null,\n  url text,\n  text text,\n  item_id uuid references items(id) on delete cascade,\n  by_founder uuid references founders(id) on delete set null,   -- for outgoing touches\n  source text not null default 'collector',   -- collector / import:outreach-sheet / manual\n  meta jsonb not null default '{}'\n);\ncreate index touches_by_person on touches (person_id, occurred_at desc);\n\n-- ------------------------------------------------------------------ knowledge\n-- What drafts know beyond the thread, for the whole project or one theme.\ncreate table project_memory (\n  id uuid primary key default gen_random_uuid(),\n  project_id uuid not null references projects(id) on delete cascade,\n  theme_id uuid references themes(id) on delete cascade,   -- null = whole project\n  kind memory_kind not null,\n  text text not null,\n  source_url text,\n  active boolean not null default true,\n  created_at timestamptz not null default now()\n);\n\n-- The project's own material (landing, articles, stories) for retrieval.\ncreate table documents (\n  id uuid primary key default gen_random_uuid(),\n  project_id uuid not null references projects(id) on delete cascade,\n  theme_id uuid references themes(id) on delete set null,\n  kind text not null,             -- landing / article / story / doc\n  url text not null,\n  title text,\n  content text not null,\n  fetched_at timestamptz not null default now(),\n  unique (project_id, url)\n);\n\n-- ------------------------------------------------------------------ security\n-- Membership check used by every policy; security definer so policies don't\n-- recurse through project_members' own policy.\ncreate function is_member(p uuid) returns boolean\n  language sql stable security definer set search_path = public as\n  $$ select exists (select 1 from project_members where project_id = p and founder_id = auth.uid()) $$;\n\ncreate function is_owner(p uuid) returns boolean\n  language sql stable security definer set search_path = public as\n  $$ select exists (select 1 from project_members where project_id = p and founder_id = auth.uid() and role = 'owner') $$;\n\nalter table founders enable row level security;\ncreate policy self on founders for all using (id = auth.uid()) with check (id = auth.uid());\n-- teammates can see each other's name and avatar\ncreate policy teammates on founders for select using (\n  id in (select m.founder_id from project_members m where is_member(m.project_id)));\n\nalter table projects enable row level security;\ncreate policy members_read on projects for select using (is_member(id));\ncreate policy owners_write on projects for update using (is_owner(id)) with check (is_owner(id));\ncreate policy owners_delete on projects for delete using (is_owner(id));\ncreate policy anyone_creates on projects for insert with check (created_by = auth.uid());\n\nalter table project_members enable row level security;\ncreate policy members_read on project_members for select using (is_member(project_id));\ncreate policy owners_manage on project_members for all using (is_owner(project_id)) with check (is_owner(project_id));\n\nalter table project_invites enable row level security;\ncreate policy owners_manage on project_invites for all using (is_owner(project_id)) with check (is_owner(project_id));\n\ndo $$\ndeclare t text;\nbegin\n  foreach t in array array['accounts','themes','people','identities','items','touches','project_memory','documents'] loop\n    execute format('alter table %I enable row level security', t);\n    execute format($p$create policy members_all on %I for all\n      using (is_member(project_id)) with check (is_member(project_id))$p$, t);\n  end loop;\nend $$;\n\nalter table item_themes enable row level security;\ncreate policy members_all on item_themes for all\n  using (exists (select 1 from items i where i.id = item_id and is_member(i.project_id)))\n  with check (exists (select 1 from items i where i.id = item_id and is_member(i.project_id)));\n\nalter table drafts enable row level security;\ncreate policy members_all on drafts for all\n  using (exists (select 1 from items i where i.id = item_id and is_member(i.project_id)))\n  with check (exists (select 1 from items i where i.id = item_id and is_member(i.project_id)));\n\n-- The creator of a project becomes its owner.\ncreate function add_creator_as_owner() returns trigger\n  language plpgsql security definer set search_path = public as $$\nbegin\n  if new.created_by is not null then\n    insert into project_members (project_id, founder_id, role) values (new.id, new.created_by, 'owner')\n    on conflict do nothing;\n  end if;\n  return new;\nend $$;\ncreate trigger project_owner after insert on projects for each row execute function add_creator_as_owner();\n\n-- A founder row for every new login, and pending invites accepted by email.\ncreate function on_new_user() returns trigger\n  language plpgsql security definer set search_path = public as $$\nbegin\n  insert into founders (id, display_name, avatar_url)\n  values (new.id, coalesce(new.raw_user_meta_data->>'full_name', new.raw_user_meta_data->>'name'),\n          new.raw_user_meta_data->>'avatar_url')\n  on conflict do nothing;\n  insert into project_members (project_id, founder_id, role)\n    select project_id, new.id, role from project_invites\n    where lower(email) = lower(new.email) and accepted_at is null\n  on conflict do nothing;\n  update project_invites set accepted_at = now()\n    where lower(email) = lower(new.email) and accepted_at is null;\n  return new;\nend $$;\ncreate trigger founder_on_signup after insert on auth.users for each row execute function on_new_user();\n=== supabase/migrations/20261008180000_no_anon.sql\n-- Defence in depth: the app is always signed in, so anonymous callers (the\n-- public anon key without a session) get no table access at all, not just\n-- empty results from row-level security. Future tables too.\nrevoke all on all tables in schema public from anon;\nrevoke all on all sequences in schema public from anon;\nrevoke execute on all functions in schema public from anon;\nalter default privileges in schema public revoke all on tables from anon;\nalter default privileges in schema public revoke all on sequences from anon;\nalter default privileges in schema public revoke execute on functions from anon;\n=== supabase/migrations/20261008190000_waitlist.sql\n-- The landing page's waitlist. Anonymous visitors can ADD an email, nothing\n-- else: no read, no update, no delete (the table is otherwise closed to anon,\n-- see 20261008180000_no_anon). Founders read it with the service role.\ncreate table waitlist (\n  id uuid primary key default gen_random_uuid(),\n  email text not null check (email ~* '^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$' and length(email) <= 254),\n  role text check (length(role) <= 120),          -- optional: \"founder\", \"devrel\", ...\n  note text check (length(note) <= 1000),          -- optional: what they'd want from it\n  source text check (length(source) <= 200),       -- utm / referrer\n  created_at timestamptz not null default now()\n);\ncreate unique index waitlist_email on waitlist (lower(email));\nalter table waitlist enable row level security;\ncreate policy anyone_can_join on waitlist for insert to anon, authenticated with check (true);\ngrant insert (email, role, note, source) on waitlist to anon, authenticated;\n=== supabase/migrations/20261008230000_enum_values.sql\n-- New enum values for the v1 screens (docs/API.md). Own migration: a value\n-- added by ALTER TYPE can't be used in the same transaction.\n--   person_stage: the design's four people tabs are Talked (talking),\n--   Gave feedback, Wants to try (would_try), Would pay.\n--   item_kind: a post found by Discover, not addressed to the founder.\nalter type person_stage add value if not exists 'gave_feedback' after 'talking';\nalter type person_stage add value if not exists 'would_pay' after 'would_try';\nalter type item_kind add value if not exists 'post';\n=== supabase/migrations/20261008230100_knowledge_chunks.sql\n-- Knowledge base for drafts (eval/REPORT-v2.md) and triage results on items\n-- (Yahhi/hearback#5). Was 20261015120000 (draft); applied as part of backend v1.\n-- Change from the draft: every chunk carries a label. 'quotable' = her\n-- published work (may be quoted and linked); 'background' = unpublished\n-- material, context only, never quoted (REPORT-v2: private research leaked\n-- into public drafts).\n--\n-- What drafts know beyond the thread is the founder's published body of work\n-- (articles, stories, research, release notes, README, FAQ), cut into\n-- ~300–600-token chunks, each with a date, a kind and, when public, a URL the\n-- draft may cite. Retrieval per item: the top ~40 chunks by cosine published\n-- BEFORE the item, then MMR + per-source cap in the engine (retrieve.ts).\n--\n-- Requires pgvector >= 0.8 (iterative index scans, so the project filter\n-- doesn't starve the HNSW result).\n\ncreate extension if not exists vector with schema extensions;\nset search_path = public, extensions;\n\n-- ------------------------------------------------------------------ documents\n-- documents (init migration) holds whole sources; it gains what retrieval needs.\nalter table documents\n  add column published_at timestamptz,          -- when it became public (null = unknown → never retrieved)\n  add column published_precision text not null default 'instant'\n    check (published_precision in ('instant', 'day')),\n  add column is_public boolean not null default true, -- false: a private source (e.g. a private repo); never linked in a draft\n  add column source_ref text;                     -- where it came from when there's no public URL\n\n-- ------------------------------------------------------------------ chunks\ncreate table document_chunks (\n  id uuid primary key default gen_random_uuid(),\n  project_id uuid not null references projects(id) on delete cascade,\n  document_id uuid not null references documents(id) on delete cascade,\n  ord int not null,                               -- position in the document\n  kind text not null check (kind in ('article', 'story', 'research', 'changelog', 'readme', 'faq', 'fact')),\n  title text not null,                            -- \"Doc title › Section\"\n  source_url text,                                -- public link a draft may cite; null when not public\n  source_ref text,\n  -- A chunk is as new as its newest line (git blame for files): a README\n  -- section written yesterday is not visible to a comment from last week.\n  published_at timestamptz not null,\n  published_precision text not null default 'instant' check (published_precision in ('instant', 'day')),\n  content text not null,\n  content_sha256 text not null,                   -- skip re-embedding unchanged chunks\n  tokens int not null,\n  lang text not null default 'en',\n  embedding vector(768),                          -- gemini-embedding-001, outputDimensionality 768, L2-normalised\n  embedding_model text,\n  label text not null default 'quotable' check (label in ('quotable', 'background')),\n  created_at timestamptz not null default now(),\n  unique (document_id, ord)\n);\ncreate index document_chunks_project on document_chunks (project_id, published_at);\ncreate index document_chunks_embedding on document_chunks\n  using hnsw (embedding vector_cosine_ops) with (m = 16, ef_construction = 64);\n\nalter table document_chunks enable row level security;\ncreate policy members_all on document_chunks for all\n  using (is_member(project_id)) with check (is_member(project_id));\n\n-- ------------------------------------------------------------------ retrieval\n-- Candidates for one item: published strictly before p_before (a day-precision\n-- chunk only if its day is earlier: a same-day commit may be the answer to the\n-- comment), optionally limited to kinds, nearest first. The engine re-ranks\n-- (MMR, at most 2 per source) and keeps ~6. security invoker: RLS applies, so\n-- a founder only ever retrieves her own projects' chunks.\ncreate function match_document_chunks(\n  p_project uuid,\n  p_query vector(768),\n  p_before timestamptz default now(),\n  p_count int default 40,\n  p_kinds text[] default null,\n  p_min_similarity float default 0.68,\n  p_labels text[] default array['quotable']\n) returns table (\n  id uuid, kind text, title text, source_url text, source_ref text,\n  published_at timestamptz, published_precision text, content text, tokens int, lang text,\n  similarity float, embedding vector(768), label text\n)\nlanguage sql stable security invoker\nset search_path = public, extensions\nset hnsw.ef_search = 100\nset hnsw.iterative_scan = relaxed_order\nas $$\n  select c.id, c.kind, c.title, c.source_url, c.source_ref,\n         c.published_at, c.published_precision, c.content, c.tokens, c.lang,\n         1 - (c.embedding <=> p_query) as similarity, c.embedding, c.label\n  from document_chunks c\n  where c.project_id = p_project\n    and c.embedding is not null\n    and (p_kinds is null or c.kind = any (p_kinds))\n    and c.label = any (p_labels)\n    and case c.published_precision\n          when 'day' then (c.published_at at time zone 'utc')::date < (p_before at time zone 'utc')::date\n          else c.published_at < p_before\n        end\n    and 1 - (c.embedding <=> p_query) >= p_min_similarity\n  order by c.embedding <=> p_query\n  limit greatest(1, least(p_count, 200));\n$$;\n\n-- ------------------------------------------------------------------ triage on items\n-- triage.ts › TriageResult, as the app shows it: kind, route (decide_queue /\n-- draft / short_draft / skip), not_sure, one-line summary, suggested action,\n-- probabilities, and which decider answered (gemini / typesafe + model).\n-- (generated columns for the app: see 20261008230200_backend_v1.sql)\nalter table items\n  add column triage jsonb,\n  add column triage_route text generated always as (triage->>'route') stored;\ncreate index items_triage_route on items (project_id, triage_route, posted_at desc);\n=== supabase/migrations/20261008230200_backend_v1.sql\n-- Backend v1 (docs/API.md): what the MVP screens need on top of the init\n-- schema. Onboarding (project from a landing page), triage on items, drafts by\n-- intent, ideas from feedback, the draft decision as one transaction, Vault\n-- for Bluesky app passwords, an inbox view grouped by person, realtime.\n\n-- ------------------------------------------------------------------ projects\nalter table projects\n  add column url text,\n  add column description text,\n  add column topics text[] not null default '{}',\n  add column competitors text[] not null default '{}',\n  add column aims text,\n  add column landing jsonb,\n  add column landing_read_at timestamptz,\n  add column github_repo text check (github_repo is null or github_repo ~ '^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$'),\n  add column knowledge_sources jsonb not null default '{}';\nalter table projects alter column audience type text[]\n  using case when audience is null or audience = '' then '{}'::text[] else array[audience] end;\nalter table projects alter column audience set default '{}';\nalter table projects alter column audience set not null;\n\n-- ------------------------------------------------------------------ accounts\nalter table accounts\n  add column last_error text,\n  add column settings jsonb not null default '{}';\n\n-- The app may create a dev.to account row and switch accounts on/off, but\n-- never set secret_id, external_id or the poll cursor: those belong to the\n-- server (a forged secret_id could point the poller at another project's secret).\nrevoke insert, update on accounts from authenticated;\ngrant insert (project_id, platform, handle, auth, connected_by, active, settings) on accounts to authenticated;\ngrant update (project_id, platform, handle, auth, connected_by, active, settings) on accounts to authenticated;\nalter table accounts add constraint accounts_app_no_secret check (auth <> 'none' or secret_id is null);\n\n-- ------------------------------------------------------------------ people\nalter table people add column stage_changed_at timestamptz;\n\ncreate function people_touch_updated() returns trigger language plpgsql as $$\nbegin\n  new.updated_at := now();\n  if new.stage is distinct from old.stage then new.stage_changed_at := now(); end if;\n  return new;\nend $$;\ncreate trigger people_updated before update on people for each row execute function people_touch_updated();\n\n-- ------------------------------------------------------------------ items\nalter table items alter column account_id drop not null;\nalter table items\n  add column origin text not null default 'inbox' check (origin in ('inbox', 'discover')),\n  add column triaged_at timestamptz,\n  add column skip_reason text,\n  add column discovery jsonb,\n  add column triage_kind text generated always as (triage->>'kind') stored,\n  add column triage_action text generated always as (triage->>'suggested_action') stored,\n  add column triage_confidence real generated always as ((triage->>'confidence')::real) stored,\n  add column triage_summary text generated always as (triage->>'summary') stored;\ncreate index items_inbox on items (project_id, origin, status, posted_at desc);\ncreate index items_untriaged on items (fetched_at) where triaged_at is null and origin = 'inbox';\ncreate index items_person on items (person_id, posted_at desc);\n\n-- ------------------------------------------------------------------ drafts\nalter table drafts\n  add column intent text check (intent in ('just_answer', 'invite_to_try', 'ask_feedback', 'ask_price', 'auto')),\n  add column variant text not null default 'first' check (variant in ('first', 'shorter', 'redraft')),\n  add column checks text[] not null default '{}',\n  add column sources jsonb not null default '[]',\n  add column lint jsonb,\n  add column decided_by uuid references founders(id) on delete set null,\n  add column decided_at timestamptz;\n\n-- ------------------------------------------------------------------ ideas\n-- Feedback turned into something to build. Similar asks from different\n-- people are grouped into one idea; asked_by counts distinct people.\ncreate table ideas (\n  id uuid primary key default gen_random_uuid(),\n  project_id uuid not null references projects(id) on delete cascade,\n  title text not null,\n  summary text,\n  quote text,                       -- the exact phrase heard (first ask)\n  kind text not null default 'feature' check (kind in ('feature', 'bug', 'pain', 'would_pay', 'other')),\n  asked_by int not null default 0,  -- distinct people, kept by trigger\n  status text not null default 'new' check (status in ('new', 'planned', 'issue_open', 'not_now', 'done')),\n  github_issue_url text,\n  github_issue_number int,\n  created_at timestamptz not null default now(),\n  updated_at timestamptz not null default now()\n);\ncreate index ideas_project on ideas (project_id, status, updated_at desc);\n\ncreate table idea_items (\n  idea_id uuid not null references ideas(id) on delete cascade,\n  item_id uuid not null references items(id) on delete cascade,\n  person_id uuid not null references people(id) on delete cascade,\n  project_id uuid not null references projects(id) on delete cascade,\n  quote text,\n  created_at timestamptz not null default now(),\n  primary key (idea_id, item_id)\n);\ncreate index idea_items_item on idea_items (item_id);\n\nalter table ideas enable row level security;\ncreate policy members_all on ideas for all using (is_member(project_id)) with check (is_member(project_id));\nalter table idea_items enable row level security;\ncreate policy members_all on idea_items for all using (is_member(project_id)) with check (is_member(project_id));\n\ncreate function ideas_recount() returns trigger language plpgsql security definer set search_path = public as $$\ndeclare i uuid := coalesce(new.idea_id, old.idea_id);\nbegin\n  update ideas set asked_by = (select count(distinct person_id) from idea_items where idea_id = i), updated_at = now()\n  where id = i;\n  return null;\nend $$;\ncreate trigger idea_items_count after insert or delete on idea_items for each row execute function ideas_recount();\n\n-- ------------------------------------------------------------------ decision RPC\n-- The founder's decision on a draft, atomically (app/README.md asked for it).\n-- security definer with an explicit membership check: the caller must be a\n-- member of the draft's project.\ncreate function record_draft_outcome(\n  p_draft_id uuid,\n  p_outcome draft_outcome,\n  p_final_text text default null,\n  p_posted_url text default null,\n  p_move_stage person_stage default null\n) returns drafts\nlanguage plpgsql security definer set search_path = public as $$\ndeclare\n  d drafts;\n  it items;\n  uid uuid := auth.uid();\n  posted boolean := p_outcome in ('posted_as_is', 'posted_edited');\nbegin\n  if p_outcome not in ('posted_as_is', 'posted_edited', 'skipped') then raise exception 'bad_outcome'; end if;\n  if posted and coalesce(btrim(p_final_text), '') = '' then raise exception 'final_text_required'; end if;\n  select * into d from drafts where id = p_draft_id for update;\n  if not found then raise exception 'not_found'; end if;\n  select * into it from items where id = d.item_id for update;\n  if uid is null or not is_member(it.project_id) then raise exception 'not_found'; end if;\n  if d.outcome is not null then raise exception 'already_decided'; end if;\n\n  update drafts set\n    outcome = p_outcome,\n    final_text = case when posted then p_final_text else final_text end,\n    posted_url = case when posted then p_posted_url else posted_url end,\n    posted_at = case when posted then now() else posted_at end,\n    posted_by = case when posted then uid else posted_by end,\n    decided_by = uid, decided_at = now()\n  where id = p_draft_id returning * into d;\n\n  update drafts set outcome = 'superseded', decided_at = now()\n  where item_id = it.id and id <> p_draft_id and outcome is null;\n\n  update items set status = case when posted then 'answered'::item_status else 'skipped'::item_status end,\n                   skip_reason = null\n  where id = it.id;\n\n  if posted then\n    insert into touches (project_id, person_id, direction, platform, kind, occurred_at, url, text, item_id, by_founder, source)\n    values (it.project_id, it.person_id, 'out', it.platform, 'reply', now(), p_posted_url, p_final_text, it.id, uid, 'app');\n    update people set\n      last_touch_at = now(),\n      stage = coalesce(p_move_stage, case when stage = 'noticed' then 'talking'::person_stage else stage end)\n    where id = it.person_id;\n  elsif p_move_stage is not null then\n    update people set stage = p_move_stage where id = it.person_id;\n  end if;\n  return d;\nend $$;\nrevoke execute on function record_draft_outcome(uuid, draft_outcome, text, text, person_stage) from public, anon;\ngrant execute on function record_draft_outcome(uuid, draft_outcome, text, text, person_stage) to authenticated, service_role;\n\n-- ------------------------------------------------------------------ Vault\n-- Bluesky app passwords live in Vault; only the service role (Edge Functions)\n-- can store or read them. The secret's name binds it to its account.\ncreate function store_account_secret(p_account uuid, p_secret text) returns uuid\nlanguage plpgsql security definer set search_path = public, vault as $$\ndeclare sid uuid;\nbegin\n  select secret_id into sid from accounts where id = p_account;\n  if not found then raise exception 'not_found'; end if;\n  if sid is not null and exists (select 1 from vault.secrets where id = sid) then\n    perform vault.update_secret(sid, p_secret);\n  else\n    sid := vault.create_secret(p_secret, 'account:' || p_account::text || ':' || gen_random_uuid()::text, 'hearback account credential');\n    update accounts set secret_id = sid where id = p_account;\n  end if;\n  return sid;\nend $$;\n\ncreate function read_account_secret(p_account uuid) returns text\nlanguage sql stable security definer set search_path = public, vault as $$\n  select s.decrypted_secret\n  from accounts a join vault.decrypted_secrets s on s.id = a.secret_id\n  where a.id = p_account and s.name like 'account:' || p_account::text || ':%';\n$$;\n\ncreate function delete_account_secret(p_account uuid) returns void\nlanguage plpgsql security definer set search_path = public, vault as $$\ndeclare sid uuid;\nbegin\n  select secret_id into sid from accounts where id = p_account;\n  if sid is not null then\n    delete from vault.secrets where id = sid;\n    update accounts set secret_id = null where id = p_account;\n  end if;\nend $$;\n\nrevoke execute on function store_account_secret(uuid, text) from public, anon, authenticated;\nrevoke execute on function read_account_secret(uuid) from public, anon, authenticated;\nrevoke execute on function delete_account_secret(uuid) from public, anon, authenticated;\ngrant execute on function store_account_secret(uuid, text) to service_role;\ngrant execute on function read_account_secret(uuid) to service_role;\ngrant execute on function delete_account_secret(uuid) to service_role;\n\n-- ------------------------------------------------------------------ inbox view\n-- One row per person with something waiting (design 1g: grouped by person).\ncreate view inbox_by_person with (security_invoker = true) as\nwith w as (\n  select i.*, row_number() over (partition by i.person_id order by i.posted_at desc) rn\n  from items i\n  where i.origin = 'inbox' and i.status in ('new', 'draft_ready')\n)\nselect\n  w.project_id, w.person_id, p.display_name, p.avatar_url, p.stage,\n  count(*)::int as waiting,\n  count(*) filter (where w.status = 'new')::int as needs_you,\n  count(*) filter (where w.status = 'draft_ready')::int as draft_ready,\n  array_agg(distinct w.platform::text) as platforms,\n  max(w.id::text) filter (where w.rn = 1)::uuid as last_item_id,\n  max(w.text) filter (where w.rn = 1) as last_item_text,\n  max(w.kind::text) filter (where w.rn = 1) as last_item_kind,\n  max(w.platform::text) filter (where w.rn = 1) as last_item_platform,\n  max(w.posted_at) as last_posted_at,\n  max(w.status::text) filter (where w.rn = 1) as last_status,\n  (select d.text from drafts d where d.item_id = max(w.id::text) filter (where w.rn = 1)::uuid and d.outcome is null\n     order by d.version desc limit 1) as last_draft_text,\n  exists (select 1 from idea_items ii where ii.person_id = w.person_id) as has_idea\nfrom w join people p on p.id = w.person_id\ngroup by w.project_id, w.person_id, p.display_name, p.avatar_url, p.stage;\nrevoke all on inbox_by_person from anon;\ngrant select on inbox_by_person to authenticated;\n\n-- ------------------------------------------------------------------ realtime\ndo $$ begin\n  if exists (select 1 from pg_publication where pubname = 'supabase_realtime') then\n    alter publication supabase_realtime add table items, drafts, ideas;\n  end if;\nend $$;\n\n-- anon stays closed (20261008180000_no_anon) for everything created here.\nrevoke all on ideas, idea_items from anon;\n=== supabase/migrations/20261008230300_cron.sql\n-- Background polling: pg_cron calls the Edge Functions through pg_net with the\n-- service role. The URL and key are read from Vault at run time (secrets\n-- 'hb_project_url' and 'hb_service_role', set by scripts/set-cron-secrets.sh),\n-- so nothing secret is in this file or in cron.job.\ncreate extension if not exists pg_cron with schema pg_catalog;\ncreate extension if not exists pg_net with schema extensions;\n\ncreate or replace function hb_call_function(p_name text, p_body jsonb default '{}') returns bigint\nlanguage plpgsql security definer set search_path = public, extensions, vault as $$\ndeclare\n  base text := (select decrypted_secret from vault.decrypted_secrets where name = 'hb_project_url');\n  key text := (select decrypted_secret from vault.decrypted_secrets where name = 'hb_service_role');\nbegin\n  if base is null or key is null then\n    raise warning 'hb_call_function: vault secrets hb_project_url / hb_service_role are missing';\n    return null;\n  end if;\n  return net.http_post(\n    url := base || '/functions/v1/' || p_name,\n    headers := jsonb_build_object('content-type', 'application/json', 'authorization', 'Bearer ' || key),\n    body := p_body,\n    timeout_milliseconds := 150000);\nend $$;\nrevoke execute on function hb_call_function(text, jsonb) from public, anon, authenticated;\n\nselect cron.schedule('hb-poll-bluesky', '*/5 * * * *', $$select hb_call_function('poll-bluesky')$$);\nselect cron.schedule('hb-poll-devto-public', '*/15 * * * *', $$select hb_call_function('poll-devto-public')$$);\n-- Items that arrived but weren't triaged inline (caps, model errors).\nselect cron.schedule('hb-triage-pending', '2-59/5 * * * *', $$select hb_call_function('triage', '{\"pending\": true}')$$);\n=== supabase/migrations/20261008230400_server_state.sql\n-- Server-side state for the collectors.\n--  * Bluesky sessions: createSession is limited (30 per 5 min, 300 per day per\n--    account), so the poller keeps the session (access + refresh JWT) in Vault\n--    and refreshes it instead of logging in every 5 minutes.\n--  * usage_counters: a per-day request cap for paid/free-tier model calls, so a\n--    cron loop can't burn the day's quota.\n\ncreate function store_account_session(p_account uuid, p_session text) returns void\nlanguage plpgsql security definer set search_path = public, vault as $$\ndeclare sid uuid; nm text := 'account-session:' || p_account::text;\nbegin\n  select id into sid from vault.secrets where name = nm;\n  if sid is null then perform vault.create_secret(p_session, nm, 'hearback bluesky session');\n  else perform vault.update_secret(sid, p_session); end if;\nend $$;\n\ncreate function read_account_session(p_account uuid) returns text\nlanguage sql stable security definer set search_path = public, vault as $$\n  select decrypted_secret from vault.decrypted_secrets where name = 'account-session:' || p_account::text;\n$$;\n\ncreate or replace function delete_account_secret(p_account uuid) returns void\nlanguage plpgsql security definer set search_path = public, vault as $$\ndeclare sid uuid;\nbegin\n  select secret_id into sid from accounts where id = p_account;\n  if sid is not null then\n    delete from vault.secrets where id = sid;\n    update accounts set secret_id = null where id = p_account;\n  end if;\n  delete from vault.secrets where name = 'account-session:' || p_account::text;\nend $$;\n\nrevoke execute on function store_account_session(uuid, text) from public, anon, authenticated;\nrevoke execute on function read_account_session(uuid) from public, anon, authenticated;\ngrant execute on function store_account_session(uuid, text) to service_role;\ngrant execute on function read_account_session(uuid) to service_role;\n\ncreate table usage_counters (\n  day date not null default (now() at time zone 'utc')::date,\n  key text not null,\n  n int not null default 0,\n  primary key (day, key)\n);\nalter table usage_counters enable row level security;  -- no policies: service role only\nrevoke all on usage_counters from anon, authenticated;\n\n-- Adds one request under p_key for today; false (and no increment) when the cap is reached.\ncreate function bump_usage(p_key text, p_cap int) returns boolean\nlanguage plpgsql security definer set search_path = public as $$\ndeclare cur int;\nbegin\n  insert into usage_counters (key, n) values (p_key, 0) on conflict do nothing;\n  select n into cur from usage_counters where day = (now() at time zone 'utc')::date and key = p_key for update;\n  if cur >= p_cap then return false; end if;\n  update usage_counters set n = n + 1 where day = (now() at time zone 'utc')::date and key = p_key;\n  return true;\nend $$;\nrevoke execute on function bump_usage(text, int) from public, anon, authenticated;\ngrant execute on function bump_usage(text, int) to service_role;\n=== supabase/migrations/20261008230500_project_creator_read.sql\n-- Fix: the app creates a project with insert(...).select(). RETURNING checks\n-- the select policy, and is_member() (a stable function) can't yet see the\n-- owner row the after-insert trigger adds in the same statement, so the insert\n-- failed with \"new row violates row-level security policy\". The creator may\n-- always read the projects she created.\ncreate policy creator_reads on projects for select using (created_by = auth.uid());\n","numLines":819,"startLine":1,"totalLines":819}},"tool_result_meta":[{"id":"toolu_01V48FRH4LDgoVXDdat32vKD","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
