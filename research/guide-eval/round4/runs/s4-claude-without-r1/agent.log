{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AGU3JpF5DAVGkbxoyJ8o7G","type":"tool_result","content":"1\t=== supabase/migrations/20261010040000_normal_forms.sql\n2\t-- Normal forms, 2026-10-10. The schema checked against 1NF–3NF (Codd 1970/71),\n3\t-- BCNF and 4NF/5NF (Fagin 1977/79); in Kent's words (CACM 26(2), 1983), every\n4\t-- non-key field is a fact about the key, the whole key, and nothing but the key.\n5\t--\n6\t-- Mixed approach, not textbook 3NF:\n7\t--   * redundancy that buys nothing is removed, or computed by Postgres\n8\t--     (generated columns, triggers) so it can't drift;\n9\t--   * the project_id copies on child tables stay (RLS policies and the hot\n10\t--     indexes filter on them), but composite foreign keys now make a copy that\n11\t--     disagrees with its parent impossible.\n12\t-- Every constraint below was checked against the live data first (no\n13\t-- violations). Left as they are, on purpose:\n14\t--   * ideas.github_issue_url: holds either the issue's URL or a pre-filled\n15\t--     github.com \"new issue\" link (app), so it isn't derivable from repo + number;\n16\t--   * source_syncs.source ('devto:writing:<handle>', 'github:<repo>'): an\n17\t--     opaque key the app shows and parses; the database only compares it;\n18\t--   * voice_samples.text_sha256: the server dedupes on it before inserting,\n19\t--     with JavaScript's whitespace rule; a generated column could disagree;\n20\t--   * themes.position vs project_memory kind 'position': both unused so far.\n21\t\n22\tset search_path = public, extensions;\n23\t\n24\t-- ------------------------------------------------------------------ 3NF: project_id copies\n25\t-- Parents expose (id, project_id[, …]) so children can reference the pair.\n26\talter table people   add constraint people_id_project unique (id, project_id);\n27\talter table accounts add constraint accounts_id_project_platform unique (id, project_id, platform);\n28\talter table items    add constraint items_id_project unique (id, project_id),\n29\t                     add constraint items_id_project_person unique (id, project_id, person_id);\n30\talter table documents add constraint documents_id_project unique (id, project_id);\n31\talter table ideas    add constraint ideas_id_project unique (id, project_id);\n32\talter table themes   add constraint themes_id_project unique (id, project_id);\n33\t\n34\t-- An item's person and account are in the item's project; the account is on\n35\t-- the item's platform. (Discover items have no account: MATCH SIMPLE skips it.)\n36\talter table items\n37\t  drop constraint items_person_id_fkey,\n38\t  add constraint items_person_fkey foreign key (person_id, project_id) references people (id, project_id) on delete cascade,\n39\t  drop constraint items_account_id_fkey,\n40\t  add constraint items_account_fkey foreign key (account_id, project_id, platform)\n41\t    references accounts (id, project_id, platform) on delete cascade;\n42\t\n43\talter table identities\n44\t  drop constraint identities_person_id_fkey,\n45\t  add constraint identities_person_fkey foreign key (person_id, project_id) references people (id, project_id) on delete cascade;\n46\t\n47\t-- A touch about an item is with that item's person; if the item moves to\n48\t-- another person (people merged), its touches follow.\n49\talter table touches\n50\t  drop constraint touches_person_id_fkey,\n51\t  add constraint touches_person_fkey foreign key (person_id, project_id) references people (id, project_id) on delete cascade,\n52\t  drop constraint touches_item_id_fkey,\n53\t  add constraint touches_item_fkey foreign key (item_id, project_id, person_id)\n54\t    references items (id, project_id, person_id) on delete cascade on update cascade;\n55\t\n56\talter table document_chunks\n57\t  drop constraint document_chunks_document_id_fkey,\n58\t  add constraint document_chunks_document_fkey foreign key (document_id, project_id) references documents (id, project_id) on delete cascade;\n59\t\n60\talter table idea_items\n61\t  drop constraint idea_items_idea_id_fkey,\n62\t  add constraint idea_items_idea_fkey foreign key (idea_id, project_id) references ideas (id, project_id) on delete cascade,\n63\t  drop constraint idea_items_item_id_fkey,\n64\t  add constraint idea_items_item_fkey foreign key (item_id, project_id) references items (id, project_id) on delete cascade;\n65\t\n66\t-- A theme from another project can't be attached.\n67\talter table documents\n68\t  drop constraint documents_theme_id_fkey,\n69\t  add constraint documents_theme_fkey foreign key (theme_id, project_id) references themes (id, project_id) on delete set null (theme_id);\n70\talter table project_memory\n71\t  drop constraint project_memory_theme_id_fkey,\n72\t  add constraint project_memory_theme_fkey foreign key (theme_id, project_id) references themes (id, project_id) on delete cascade;\n73\t\n74\t-- ------------------------------------------------------------------ 2NF: idea_items.person_id\n75\t-- idea_items is keyed by (idea_id, item_id), but person_id depended on item_id\n76\t-- alone (it is items.person_id). Who asked is now read through the item.\n77\tcreate or replace function ideas_recount() returns trigger language plpgsql security definer set search_path = public as $$\n78\tdeclare x uuid := coalesce(new.idea_id, old.idea_id);\n79\tbegin\n80\t  update ideas set asked_by = (\n81\t      select count(distinct i.person_id) from idea_items ii join items i on i.id = ii.item_id where ii.idea_id = x),\n82\t    updated_at = now()\n83\t  where id = x;\n84\t  return null;\n85\tend $$;\n86\t\n87\t-- asked_by stays a cached count: recount when an item changes hands.\n88\tcreate function items_person_recount() returns trigger language plpgsql security definer set search_path = public as $$\n89\tbegin\n90\t  update ideas d set asked_by = (\n91\t      select count(distinct i.person_id) from idea_items ii join items i on i.id = ii.item_id where ii.idea_id = d.id)\n92\t  where d.id in (select idea_id from idea_items where item_id = new.id);\n93\t  return null;\n94\tend $$;\n95\tcreate trigger items_person_recount after update of person_id on items\n96\t  for each row when (old.person_id is distinct from new.person_id) execute function items_person_recount();\n97\trevoke execute on function items_person_recount() from public, anon, authenticated;\n98\t\n99\t-- The inbox view read idea_items.person_id; same columns, through items.\n100\tcreate or replace view inbox_by_person with (security_invoker = true) as\n101\twith w as (\n102\t  select i.*, row_number() over (partition by i.person_id order by i.posted_at desc) rn\n103\t  from items i\n104\t  where i.origin = 'inbox' and i.status in ('new', 'draft_ready')\n105\t)\n106\tselect\n107\t  w.project_id, w.person_id, p.display_name, p.avatar_url, p.stage,\n108\t  count(*)::int as waiting,\n109\t  count(*) filter (where w.status = 'new')::int as needs_you,\n110\t  count(*) filter (where w.status = 'draft_ready')::int as draft_ready,\n111\t  array_agg(distinct w.platform::text) as platforms,\n112\t  max(w.id::text) filter (where w.rn = 1)::uuid as last_item_id,\n113\t  max(w.text) filter (where w.rn = 1) as last_item_text,\n114\t  max(w.kind::text) filter (where w.rn = 1) as last_item_kind,\n115\t  max(w.platform::text) filter (where w.rn = 1) as last_item_platform,\n116\t  max(w.posted_at) as last_posted_at,\n117\t  max(w.status::text) filter (where w.rn = 1) as last_status,\n118\t  (select d.text from drafts d where d.item_id = max(w.id::text) filter (where w.rn = 1)::uuid and d.outcome is null\n119\t     order by d.version desc limit 1) as last_draft_text,\n120\t  exists (select 1 from idea_items ii join items ai on ai.id = ii.item_id where ai.person_id = w.person_id) as has_idea\n121\tfrom w join people p on p.id = w.person_id\n122\tgroup by w.project_id, w.person_id, p.display_name, p.avatar_url, p.stage;\n123\t\n124\talter table idea_items drop column person_id;\n125\t\n126\t-- ------------------------------------------------------------------ 3NF: document_chunks\n127\t-- kind, source_url, source_ref and label were copies of the chunk's document\n128\t-- (written from it in knowledge.ts; identical on every live row). They live on\n129\t-- documents only. published_at / published_precision stay per chunk (a section\n130\t-- is as new as its newest line), and so does lang.\n131\talter table documents add constraint documents_kind_check\n132\t  check (kind in ('article', 'story', 'research', 'changelog', 'readme', 'faq', 'fact', 'page'));\n133\t\n134\t-- is_public was label = 'quotable' written twice; Postgres computes it now.\n135\talter table documents drop column is_public;\n136\talter table documents add column is_public boolean generated always as (label = 'quotable') stored;\n137\t\n138\t-- Same signature and result as before; the document's fields come through the join.\n139\tcreate or replace function match_document_chunks(\n140\t  p_project uuid,\n141\t  p_query vector(768),\n142\t  p_before timestamptz default now(),\n143\t  p_count int default 40,\n144\t  p_kinds text[] default null,\n145\t  p_min_similarity float default 0.68,\n146\t  p_labels text[] default array['quotable']\n147\t) returns table (\n148\t  id uuid, kind text, title text, source_url text, source_ref text,\n149\t  published_at timestamptz, published_precision text, content text, tokens int, lang text,\n150\t  similarity float, embedding vector(768), label text\n151\t)\n152\tlanguage sql stable security invoker\n153\tset search_path = public, extensions\n154\tset hnsw.ef_search = 100\n155\tset hnsw.iterative_scan = relaxed_order\n156\tas $$\n157\t  select c.id, d.kind, c.title,\n158\t         case when d.label = 'quotable' then d.url end as source_url,\n159\t         case when d.label <> 'quotable' then coalesce(d.source_ref, d.url) end as source_ref,\n160\t         c.published_at, c.published_precision, c.content, c.tokens, c.lang,\n161\t         1 - (c.embedding <=> p_query) as similarity, c.embedding, d.label\n162\t  from document_chunks c\n163\t  join documents d on d.id = c.document_id\n164\t  where c.project_id = p_project\n165\t    and c.embedding is not null\n166\t    and (p_kinds is null or d.kind = any (p_kinds))\n167\t    and d.label = any (p_labels)\n168\t    and case c.published_precision\n169\t          when 'day' then (c.published_at at time zone 'utc')::date < (p_before at time zone 'utc')::date\n170\t          else c.published_at < p_before\n171\t        end\n172\t    and 1 - (c.embedding <=> p_query) >= p_min_similarity\n173\t  order by c.embedding <=> p_query\n174\t  limit greatest(1, least(p_count, 200));\n175\t$$;\n176\t\n177\talter table document_chunks drop column kind, drop column source_url, drop column source_ref, drop column label;\n178\t\n179\t-- ------------------------------------------------------------------ 3NF: drafts.tokens_in / tokens_out\n180\t-- The totals are functions of the usage breakdown in drafts.tokens (Anthropic's\n181\t-- input excludes cache reads and writes; the total includes them). Drafts that\n182\t-- only had totals (Gemini) get them as the breakdown, then Postgres computes\n183\t-- the totals.\n184\tupdate drafts set tokens = jsonb_build_object('input', tokens_in, 'output', tokens_out)\n185\t  where tokens is null and (tokens_in is not null or tokens_out is not null);\n186\t\n187\tdo $$ begin\n188\t  if exists (select 1 from drafts where\n189\t      tokens_in is distinct from (tokens->>'input')::int + coalesce((tokens->>'cache_read')::int, 0) + coalesce((tokens->>'cache_write')::int, 0)\n190\t      or tokens_out is distinct from (tokens->>'output')::int) then\n191\t    raise exception 'drafts: tokens_in/tokens_out disagree with drafts.tokens; not converting';\n192\t  end if;\n193\tend $$;\n194\t\n195\talter table drafts drop column tokens_in, drop column tokens_out;\n196\talter table drafts\n197\t  add column tokens_in int generated always as\n198\t    ((tokens->>'input')::int + coalesce((tokens->>'cache_read')::int, 0) + coalesce((tokens->>'cache_write')::int, 0)) stored,\n199\t  add column tokens_out int generated always as ((tokens->>'output')::int) stored;\n200\t\n201\t-- ------------------------------------------------------------------ derived: people.first/last_touch_at\n202\t-- Kept as a cache of min/max(touches.occurred_at), now by the database for\n203\t-- every writer (the collector did read-then-write; issue touches didn't update\n204\t-- it at all). greatest/least on insert is safe under concurrent inserts.\n205\tcreate function touches_person_span() returns trigger language plpgsql security definer set search_path = public as $$\n206\tbegin\n207\t  if tg_op = 'INSERT' then\n208\t    update people set first_touch_at = least(first_touch_at, new.occurred_at),\n209\t                      last_touch_at = greatest(last_touch_at, new.occurred_at)\n210\t    where id = new.person_id\n211\t      and (first_touch_at is null or last_touch_at is null or new.occurred_at < first_touch_at or new.occurred_at > last_touch_at);\n212\t  else\n213\t    update people p set first_touch_at = s.lo, last_touch_at = s.hi\n214\t    from (select x.id, (select min(occurred_at) from touches where person_id = x.id) lo,\n215\t                       (select max(occurred_at) from touches where person_id = x.id) hi\n216\t          from (select old.person_id as id union select new.person_id) x where x.id is not null) s\n217\t    where p.id = s.id;\n218\t  end if;\n219\t  return null;\n220\tend $$;\n221\tcreate trigger touches_person_span after insert or delete or update of person_id, occurred_at on touches\n222\t  for each row execute function touches_person_span();\n223\trevoke execute on function touches_person_span() from public, anon, authenticated;\n224\t\n225\t-- The decision RPC no longer sets last_touch_at itself: its touch does.\n226\tcreate or replace function record_draft_outcome(\n227\t  p_draft_id uuid,\n228\t  p_outcome draft_outcome,\n229\t  p_final_text text default null,\n230\t  p_posted_url text default null,\n231\t  p_move_stage person_stage default null\n232\t) returns drafts\n233\tlanguage plpgsql security definer set search_path = public as $$\n234\tdeclare\n235\t  d drafts;\n236\t  it items;\n237\t  uid uuid := auth.uid();\n238\t  posted boolean := p_outcome in ('posted_as_is', 'posted_edited');\n239\tbegin\n240\t  if p_outcome not in ('posted_as_is', 'posted_edited', 'skipped') then raise exception 'bad_outcome'; end if;\n241\t  if posted and coalesce(btrim(p_final_text), '') = '' then raise exception 'final_text_required'; end if;\n242\t  select * into d from drafts where id = p_draft_id for update;\n243\t  if not found then raise exception 'not_found'; end if;\n244\t  select * into it from items where id = d.item_id for update;\n245\t  if uid is null or not is_member(it.project_id) then raise exception 'not_found'; end if;\n246\t  if d.outcome is not null then raise exception 'already_decided'; end if;\n247\t\n248\t  update drafts set\n249\t    outcome = p_outcome,\n250\t    final_text = case when posted then p_final_text else final_text end,\n251\t    posted_url = case when posted then p_posted_url else posted_url end,\n252\t    posted_at = case when posted then now() else posted_at end,\n253\t    posted_by = case when posted then uid else posted_by end,\n254\t    decided_by = uid, decided_at = now()\n255\t  where id = p_draft_id returning * into d;\n256\t\n257\t  update drafts set outcome = 'superseded', decided_at = now()\n258\t  where item_id = it.id and id <> p_draft_id and outcome is null;\n259\t\n260\t  update items set status = case when posted then 'answered'::item_status else 'skipped'::item_status end,\n261\t                   skip_reason = null\n262\t  where id = it.id;\n263\t\n264\t  if posted then\n265\t    insert into touches (project_id, person_id, direction, platform, kind, occurred_at, url, text, item_id, by_founder, source)\n266\t    values (it.project_id, it.person_id, 'out', it.platform, 'reply', now(), p_posted_url, p_final_text, it.id, uid, 'app');\n267\t    update people set\n268\t      stage = coalesce(p_move_stage, case when stage = 'noticed' then 'talking'::person_stage else stage end)\n269\t    where id = it.person_id;\n270\t  elsif p_move_stage is not null then\n271\t    update people set stage = p_move_stage where id = it.person_id;\n272\t  end if;\n273\t  return d;\n274\tend $$;\n275\t\n276\t-- ------------------------------------------------------------------ 1NF: plans.allowed_models\n277\t-- The array was a relation in disguise (searched with = any in three\n278\t-- functions). One row per (plan, model); ord keeps the order the app lists.\n279\tcreate table plan_models (\n280\t  plan_id text not null,\n281\t  model text not null,\n282\t  ord smallint not null default 0,\n283\t  primary key (plan_id, model),\n284\t  constraint plan_models_plan_fkey foreign key (plan_id) references plans (id) on delete cascade\n285\t);\n286\tinsert into plan_models (plan_id, model, ord)\n287\t  select p.id, m.model, m.n from plans p, unnest(p.allowed_models) with ordinality as m(model, n);\n288\t\n289\t-- The default is one of the plan's models (deferred: a plan and its models are\n290\t-- inserted in one transaction).\n291\talter table plans drop constraint plans_default_allowed;\n292\talter table plans add constraint plans_default_model_fkey foreign key (id, default_model)\n293\t  references plan_models (plan_id, model) deferrable initially deferred;\n294\t\n295\talter table plan_models enable row level security;\n296\tcreate policy signed_in_read on plan_models for select to authenticated using (true);\n297\trevoke all on plan_models from anon, authenticated;\n298\tgrant select on plan_models to authenticated;\n299\t\n300\t-- Same rule as before: an override is checked when it is set; if the plan later\n301\t-- drops the model (or the founder changes plan), the server falls back to the\n302\t-- plan default instead. That's why this stays a trigger, not a foreign key.\n303\tcreate or replace function check_founder_draft_model() returns trigger\n304\t  language plpgsql set search_path = public as $$\n305\tbegin\n306\t  if new.draft_model is not null\n307\t     and (tg_op = 'INSERT' or new.draft_model is distinct from old.draft_model)\n308\t     and not exists (select 1 from plan_models m where m.plan_id = new.plan_id and m.model = new.draft_model) then\n309\t    raise exception 'model_not_allowed' using errcode = '23514', detail = format('%s is not in plan %s', new.draft_model, new.plan_id);\n310\t  end if;\n311\t  return new;\n312\tend $$;\n313\t\n314\tcreate or replace function my_draft_model() returns jsonb\n315\t  language sql stable security definer set search_path = public as $$\n316\t  select jsonb_build_object(\n317\t    'plan_id', p.id, 'plan_name', p.name, 'default_model', p.default_model,\n318\t    'allowed_models', coalesce((select jsonb_agg(m.model order by m.ord, m.model) from plan_models m where m.plan_id = p.id), '[]'::jsonb),\n319\t    'draft_model', f.draft_model,\n320\t    'effective_model', case when exists (select 1 from plan_models m where m.plan_id = p.id and m.model = f.draft_model)\n321\t                            then f.draft_model else p.default_model end)\n322\t  from founders f join plans p on p.id = f.plan_id\n323\t  where f.id = auth.uid()\n324\t$$;\n325\t\n326\tcreate or replace function set_draft_model(model text) returns jsonb\n327\t  language plpgsql security definer set search_path = public as $$\n328\tdeclare\n329\t  m text := nullif(btrim(model), '');\n330\tbegin\n331\t  if auth.uid() is null then raise exception 'not_found'; end if;\n332\t  if m is not null and not exists (\n333\t    select 1 from founders f join plan_models pm on pm.plan_id = f.plan_id\n334\t    where f.id = auth.uid() and pm.model = m) then\n335\t    raise exception 'model_not_allowed' using errcode = '23514';\n336\t  end if;\n337\t  update founders set draft_model = m where id = auth.uid();\n338\t  if not found then raise exception 'not_found'; end if;\n339\t  return my_draft_model();\n340\tend $$;\n341\t\n342\talter table plans drop column allowed_models;\n343\t=== supabase/migrations/20261011010000_draft_checks.sql\n344\t-- [check: …] gaps she can resolve (docs/API.md › Changes 2026-10-11).\n345\t--\n346\t-- * drafts.variant 'resolve': a version made by answering or dropping gaps of\n347\t--   the version before it (draft function, `resolve`). Nothing else changes in\n348\t--   how versions work: the older undecided one is superseded.\n349\t-- * drafts.meta: what made this version beyond the model call. For 'resolve':\n350\t--   {based_on: {draft_id, version}, edited_before, resolved: [{check_id,\n351\t--   question, action: answer|drop, answer?, method: model|fallback, reason?,\n352\t--   by, at}]}. Her answers stay here as a fact / voice signal for later drafts.\n353\t-- * A posted reply never contains a gap: record_draft_outcome refuses\n354\t--   final_text with \"[check\" (any case), and a constraint makes it a rule for\n355\t--   every writer.\n356\t\n357\talter table drafts drop constraint drafts_variant_check;\n358\talter table drafts add constraint drafts_variant_check check (variant in ('first', 'shorter', 'redraft', 'resolve'));\n359\t\n360\talter table drafts add column meta jsonb not null default '{}'::jsonb;\n361\t\n362\talter table drafts add constraint drafts_posted_without_checks\n363\t  check (outcome is null or outcome not in ('posted_as_is', 'posted_edited') or final_text is null or final_text !~* '\\[check');\n364\t\n365\tcreate or replace function record_draft_outcome(\n366\t  p_draft_id uuid,\n367\t  p_outcome draft_outcome,\n368\t  p_final_text text default null,\n369\t  p_posted_url text default null,\n370\t  p_move_stage person_stage default null\n371\t) returns drafts\n372\tlanguage plpgsql security definer set search_path = public as $$\n373\tdeclare\n374\t  d drafts;\n375\t  it items;\n376\t  uid uuid := auth.uid();\n377\t  posted boolean := p_outcome in ('posted_as_is', 'posted_edited');\n378\tbegin\n379\t  if p_outcome not in ('posted_as_is', 'posted_edited', 'skipped') then raise exception 'bad_outcome'; end if;\n380\t  if posted and coalesce(btrim(p_final_text), '') = '' then raise exception 'final_text_required'; end if;\n381\t  if posted and p_final_text ~* '\\[check' then raise exception 'unfilled_check'; end if;\n382\t  select * into d from drafts where id = p_draft_id for update;\n383\t  if not found then raise exception 'not_found'; end if;\n384\t  select * into it from items where id = d.item_id for update;\n385\t  if uid is null or not is_member(it.project_id) then raise exception 'not_found'; end if;\n386\t  if d.outcome is not null then raise exception 'already_decided'; end if;\n387\t\n388\t  update drafts set\n389\t    outcome = p_outcome,\n390\t    final_text = case when posted then p_final_text else final_text end,\n391\t    posted_url = case when posted then p_posted_url else posted_url end,\n392\t    posted_at = case when posted then now() else posted_at end,\n393\t    posted_by = case when posted then uid else posted_by end,\n394\t    decided_by = uid, decided_at = now()\n395\t  where id = p_draft_id returning * into d;\n396\t\n397\t  update drafts set outcome = 'superseded', decided_at = now()\n398\t  where item_id = it.id and id <> p_draft_id and outcome is null;\n399\t\n400\t  update items set status = case when posted then 'answered'::item_status else 'skipped'::item_status end,\n401\t                   skip_reason = null\n402\t  where id = it.id;\n403\t\n404\t  if posted then\n405\t    insert into touches (project_id, person_id, direction, platform, kind, occurred_at, url, text, item_id, by_founder, source)\n406\t    values (it.project_id, it.person_id, 'out', it.platform, 'reply', now(), p_posted_url, p_final_text, it.id, uid, 'app');\n407\t    update people set\n408\t      stage = coalesce(p_move_stage, case when stage = 'noticed' then 'talking'::person_stage else stage end)\n409\t    where id = it.person_id;\n410\t  elsif p_move_stage is not null then\n411\t    update people set stage = p_move_stage where id = it.person_id;\n412\t  end if;\n413\t  return d;\n414\tend $$;\n415\t=== supabase/migrations/20261011120000_tokens_generated_safe.sql\n416\t-- drafts.tokens_in / tokens_out are generated from the drafts.tokens JSON.\n417\t-- Review by Arhan Canli (dev.to, 2026-10-11): the first term had no coalesce,\n418\t-- so a row whose JSON lacked \"input\" got tokens_in = NULL instead of the cache\n419\t-- sum, and a value like \"12.0\" made the int cast raise and failed the whole\n420\t-- insert. A generated column can't be written around, so the expression must\n421\t-- never raise: numbers are parsed leniently (\"12\", \"12.0\", 12) and anything\n422\t-- else counts as missing.\n423\t\n424\tcreate or replace function hb_json_int(v text) returns int\n425\t  language sql immutable parallel safe\n426\tas $$\n427\t  select case when v ~ '^\\s*-?\\d+(\\.\\d+)?\\s*$' then round(v::numeric)::int end\n428\t$$;\n429\t\n430\t-- NULL only when there is no token count at all; otherwise the sum of what's there.\n431\talter table drafts alter column tokens_in set expression as (\n432\t  case when coalesce(hb_json_int(tokens->>'input'), hb_json_int(tokens->>'cache_read'),\n433\t                     hb_json_int(tokens->>'cache_write')) is null then null\n434\t       else coalesce(hb_json_int(tokens->>'input'), 0)\n435\t          + coalesce(hb_json_int(tokens->>'cache_read'), 0)\n436\t          + coalesce(hb_json_int(tokens->>'cache_write'), 0) end);\n437\talter table drafts alter column tokens_out set expression as (hb_json_int(tokens->>'output'));\n438\t=== supabase/migrations/20261012010000_intent_discuss.sql\n439\t-- Intent chips: \"Discuss\" (her view + one question that keeps the discussion\n440\t-- going, normal length) becomes the default chip. ask_feedback / ask_price\n441\t-- are no longer offered in the app but stay valid for existing drafts.\n442\talter table drafts drop constraint drafts_intent_check;\n443\talter table drafts add constraint drafts_intent_check\n444\t  check (intent in ('discuss', 'just_answer', 'invite_to_try', 'ask_feedback', 'ask_price', 'auto'));\n445\t=== supabase/migrations/20261012020000_item_liked.sql\n446\t-- Like from the thread screen: the phone likes the comment on the network\n447\t-- (dev.to POST /reactions, with her session) and records it here so the\n448\t-- button shows it. null = not liked from Hearback.\n449\talter table items add column liked_at timestamptz;\n450\t=== supabase/migrations/20261012030000_item_spam_verdict.sql\n451\t-- Spam check (triage route spam_check: the comment looks like a plug). Her\n452\t-- answer: 'spam' (hidden on the network from the app, item skipped) or\n453\t-- 'not_spam' (treated as a usual comment). null = not asked / not answered.\n454\talter table items add column spam_verdict text check (spam_verdict in ('spam', 'not_spam'));\n455\t=== supabase/migrations/20261012040000_documents_kind_docs.sql\n456\t-- Documentation pages (a site's /docs, /guide, /help, a repo's docs/ folder)\n457\t-- get their own kind, so a draft can point to them as \"the docs\" (Invite to\n458\t-- try: draft/materials.ts).\n459\talter table documents drop constraint documents_kind_check;\n460\talter table documents add constraint documents_kind_check\n461\t  check (kind in ('article', 'story', 'research', 'changelog', 'readme', 'faq', 'docs', 'fact', 'page'));\n462\t=== supabase/migrations/20261014010000_github_board_results.sql\n463\t-- GitHub Projects board + what happened to an idea's issue.\n464\t-- docs/ARCHITECTURE.md › GitHub App, docs/API.md › Changes 2026-10-14.\n465\t--\n466\t-- A project may link one organization board (Projects v2). Hearback only\n467\t-- reads it: the duplicate check looks at its items (any repo, drafts too) and\n468\t-- the results sweep reads an issue's Status there. Needs the app's\n469\t-- \"Organization permissions › Projects: read-only\".\n470\t--\n471\t-- The sweep (function github-results, every 20 min) notices an idea's issue\n472\t-- closing as completed (or its board Status reaching Done), reads the result\n473\t-- (closing PRs, the last maintainer comment, its links) and drafts a follow-up\n474\t-- reply to everyone who asked. Nothing is posted without her tap.\n475\t\n476\t-- ------------------------------------------------------------------ projects › board\n477\t-- owner + number is the board's address (github.com/orgs/<owner>/projects/<number>);\n478\t-- id is its GraphQL node id; title is GitHub's, cached for display.\n479\talter table projects\n480\t  add column github_board_owner text check (github_board_owner is null or github_board_owner ~ '^[A-Za-z0-9-]+$'),\n481\t  add column github_board_number int check (github_board_number is null or github_board_number > 0),\n482\t  add column github_board_id text,\n483\t  add column github_board_title text,\n484\t  add constraint projects_github_board_whole check (\n485\t    (github_board_owner is null) = (github_board_number is null)\n486\t    and (github_board_owner is null) = (github_board_id is null));\n487\t\n488\t-- ------------------------------------------------------------------ ideas › issue result\n489\talter table ideas\n490\t  -- GitHub's view of the issue, as last read.\n491\t  add column github_issue_state text check (github_issue_state in ('open', 'closed')),\n492\t  add column github_issue_state_reason text,          -- completed | not_planned | duplicate | reopened\n493\t  add column github_issue_closed_at timestamptz,\n494\t  add column github_board_status text,                -- the board's Status option, if the issue is on the linked board\n495\t  add column github_checked_at timestamptz,\n496\t  -- What was done, in words she can edit before replies are drafted.\n497\t  add column result_note text,\n498\t  add column result_note_url text,                    -- the comment it came from\n499\t  add column result_links jsonb not null default '[]',-- [{title, url, kind: pr|commit|link}]\n500\t  add column result_drafted_at timestamptz;           -- follow-up drafts were made (once per result)\n501\t\n502\t-- The sweep's queue: ideas with a real issue that are not settled yet.\n503\tcreate index ideas_issue_watch on ideas (github_checked_at nulls first)\n504\t  where github_issue_number is not null and result_drafted_at is null;\n505\t\n506\t-- ------------------------------------------------------------------ drafts › intent\n507\t-- share_result: the follow-up \"what you asked for is done\" reply.\n508\talter table drafts drop constraint drafts_intent_check;\n509\talter table drafts add constraint drafts_intent_check\n510\t  check (intent in ('discuss', 'just_answer', 'invite_to_try', 'ask_feedback', 'ask_price', 'share_result', 'auto'));\n511\t\n512\t-- ------------------------------------------------------------------ cron\n513\tselect cron.schedule('hb-github-results', '11-59/20 * * * *', $$select hb_call_function('github-results', '{}')$$);\n514\t=== supabase/migrations/20261015010000_ask_code_model_calls.sql\n515\t-- Ask the code (docs/ARCHITECTURE.md › Ask the code) and the model-call log.\n516\t--\n517\t-- model_calls: every model call the functions make (drafts, resolves,\n518\t-- points, triage summaries, decider, discover, landing reads, ask-code steps)\n519\t-- with tokens and list-price cost. Service role only; read it with SQL or\n520\t-- model_spend_daily. Drafts written before this log are copied in once\n521\t-- (purpose 'draft', fn 'backfill') from drafts.tokens.\n522\t--\n523\t-- code_questions: a question about the project's code (usually a draft's\n524\t-- [check: …] gap) and its answer with cited lines. answered_by 'cloud' is\n525\t-- the ask-code agent; 'local' is kept for a founder's own agent answering\n526\t-- from her machine (backlog). Members read their project's rows; only the\n527\t-- function writes them.\n528\t\n529\tcreate table model_calls (\n530\t  id bigint generated always as identity primary key,\n531\t  at timestamptz not null default now(),\n532\t  fn text,                     -- the edge function (draft, triage, ask-code, …)\n533\t  purpose text not null,       -- draft / resolve / points / triage_summary / decide / discover_why / landing / ask_code\n534\t  project_id uuid references projects(id) on delete set null,\n535\t  founder_id uuid,             -- the signed-in founder (no FK: a log row must never fail to insert)\n536\t  item_id uuid references items(id) on delete set null,\n537\t  run_id uuid,                 -- the steps of one multi-step run (code_questions.id)\n538\t  provider text not null,\n539\t  model text not null,\n540\t  ok boolean not null,\n541\t  error text,\n542\t  tokens_in int,               -- all prompt tokens (uncached + cache reads + cache writes)\n543\t  tokens_out int,\n544\t  usage jsonb,                 -- {input, output, cache_read, cache_write, cost_usd}\n545\t  cost_usd numeric(12, 6),     -- list price (pricing.ts); null: unknown or free (Gemini free key)\n546\t  latency_ms int\n547\t);\n548\tcreate index model_calls_at on model_calls (at desc);\n549\tcreate index model_calls_project on model_calls (project_id, at desc);\n550\tcreate index model_calls_run on model_calls (run_id) where run_id is not null;\n551\talter table model_calls enable row level security;  -- no policies: service role only\n552\trevoke all on model_calls from anon, authenticated;\n553\t\n554\tinsert into model_calls (at, fn, purpose, project_id, item_id, provider, model, ok, tokens_in, tokens_out, usage, cost_usd, latency_ms)\n555\tselect d.created_at, 'backfill', 'draft', i.project_id, d.item_id, d.provider, d.model, true,\n556\t       d.tokens_in, d.tokens_out, d.tokens, nullif(d.tokens->>'cost_usd', '')::numeric, d.latency_ms\n557\tfrom drafts d join items i on i.id = d.item_id;\n558\t\n559\tcreate view model_spend_daily with (security_invoker = true) as\n560\tselect (at at time zone 'utc')::date as day, purpose, provider, model,\n561\t       count(*) as calls,\n562\t       count(*) filter (where not ok) as failed,\n563\t       sum(tokens_in) as tokens_in,\n564\t       sum(tokens_out) as tokens_out,\n565\t       round(sum(coalesce(cost_usd, 0)), 4) as cost_usd\n566\tfrom model_calls\n567\tgroup by 1, 2, 3, 4;\n568\trevoke all on model_spend_daily from anon, authenticated;\n569\t\n570\tcreate table code_questions (\n571\t  id uuid primary key default gen_random_uuid(),\n572\t  project_id uuid not null references projects(id) on delete cascade,\n573\t  item_id uuid references items(id) on delete set null,\n574\t  asked_by uuid references founders(id) on delete set null,\n575\t  question text not null check (length(question) between 3 and 2000),\n576\t  check_question text,         -- the [check: …] gap it answers, if any\n577\t  repo text not null,\n578\t  commit_sha text,             -- the code the answer was read at\n579\t  status text not null default 'running' check (status in ('running', 'answered', 'failed', 'waiting_local')),\n580\t  answered_by text not null default 'cloud' check (answered_by in ('cloud', 'local')),\n581\t  answer text,\n582\t  details text,\n583\t  sources jsonb not null default '[]',   -- [{path, start_line, end_line, note, url}]\n584\t  confidence text check (confidence in ('high', 'medium', 'low')),\n585\t  model text,\n586\t  steps int,\n587\t  usage jsonb,                 -- run totals: {input, output, cache_read, cache_write, cost_usd, tool_calls, github_requests}\n588\t  cost_usd numeric(12, 6),\n589\t  error text,\n590\t  created_at timestamptz not null default now(),\n591\t  answered_at timestamptz,\n592\t  used_at timestamptz          -- she used the answer (it was saved to the project's knowledge)\n593\t);\n594\tcreate index code_questions_item on code_questions (item_id, created_at desc);\n595\tcreate index code_questions_project on code_questions (project_id, created_at desc);\n596\talter table code_questions enable row level security;\n597\tcreate policy members_read on code_questions for select using (is_member(project_id));\n598\trevoke insert, update, delete on code_questions from anon, authenticated;\n599\t"}]},"parent_tool_use_id":null,"session_id":"12758654-5564-441d-a699-220d2405b2b5","uuid":"ce69e638-84c4-43d3-9053-0917b8c05deb","timestamp":"2026-10-18T01:45:55.556Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/valentinakoniukhova/.claude/projects/-private-tmp-h-15NWzU/12758654-5564-441d-a699-220d2405b2b5/tool-results/bk7ayr1t5.txt","content":"=== supabase/migrations/20261010040000_normal_forms.sql\n-- Normal forms, 2026-10-10. The schema checked against 1NF–3NF (Codd 1970/71),\n-- BCNF and 4NF/5NF (Fagin 1977/79); in Kent's words (CACM 26(2), 1983), every\n-- non-key field is a fact about the key, the whole key, and nothing but the key.\n--\n-- Mixed approach, not textbook 3NF:\n--   * redundancy that buys nothing is removed, or computed by Postgres\n--     (generated columns, triggers) so it can't drift;\n--   * the project_id copies on child tables stay (RLS policies and the hot\n--     indexes filter on them), but composite foreign keys now make a copy that\n--     disagrees with its parent impossible.\n-- Every constraint below was checked against the live data first (no\n-- violations). Left as they are, on purpose:\n--   * ideas.github_issue_url: holds either the issue's URL or a pre-filled\n--     github.com \"new issue\" link (app), so it isn't derivable from repo + number;\n--   * source_syncs.source ('devto:writing:<handle>', 'github:<repo>'): an\n--     opaque key the app shows and parses; the database only compares it;\n--   * voice_samples.text_sha256: the server dedupes on it before inserting,\n--     with JavaScript's whitespace rule; a generated column could disagree;\n--   * themes.position vs project_memory kind 'position': both unused so far.\n\nset search_path = public, extensions;\n\n-- ------------------------------------------------------------------ 3NF: project_id copies\n-- Parents expose (id, project_id[, …]) so children can reference the pair.\nalter table people   add constraint people_id_project unique (id, project_id);\nalter table accounts add constraint accounts_id_project_platform unique (id, project_id, platform);\nalter table items    add constraint items_id_project unique (id, project_id),\n                     add constraint items_id_project_person unique (id, project_id, person_id);\nalter table documents add constraint documents_id_project unique (id, project_id);\nalter table ideas    add constraint ideas_id_project unique (id, project_id);\nalter table themes   add constraint themes_id_project unique (id, project_id);\n\n-- An item's person and account are in the item's project; the account is on\n-- the item's platform. (Discover items have no account: MATCH SIMPLE skips it.)\nalter table items\n  drop constraint items_person_id_fkey,\n  add constraint items_person_fkey foreign key (person_id, project_id) references people (id, project_id) on delete cascade,\n  drop constraint items_account_id_fkey,\n  add constraint items_account_fkey foreign key (account_id, project_id, platform)\n    references accounts (id, project_id, platform) on delete cascade;\n\nalter table identities\n  drop constraint identities_person_id_fkey,\n  add constraint identities_person_fkey foreign key (person_id, project_id) references people (id, project_id) on delete cascade;\n\n-- A touch about an item is with that item's person; if the item moves to\n-- another person (people merged), its touches follow.\nalter table touches\n  drop constraint touches_person_id_fkey,\n  add constraint touches_person_fkey foreign key (person_id, project_id) references people (id, project_id) on delete cascade,\n  drop constraint touches_item_id_fkey,\n  add constraint touches_item_fkey foreign key (item_id, project_id, person_id)\n    references items (id, project_id, person_id) on delete cascade on update cascade;\n\nalter table document_chunks\n  drop constraint document_chunks_document_id_fkey,\n  add constraint document_chunks_document_fkey foreign key (document_id, project_id) references documents (id, project_id) on delete cascade;\n\nalter table idea_items\n  drop constraint idea_items_idea_id_fkey,\n  add constraint idea_items_idea_fkey foreign key (idea_id, project_id) references ideas (id, project_id) on delete cascade,\n  drop constraint idea_items_item_id_fkey,\n  add constraint idea_items_item_fkey foreign key (item_id, project_id) references items (id, project_id) on delete cascade;\n\n-- A theme from another project can't be attached.\nalter table documents\n  drop constraint documents_theme_id_fkey,\n  add constraint documents_theme_fkey foreign key (theme_id, project_id) references themes (id, project_id) on delete set null (theme_id);\nalter table project_memory\n  drop constraint project_memory_theme_id_fkey,\n  add constraint project_memory_theme_fkey foreign key (theme_id, project_id) references themes (id, project_id) on delete cascade;\n\n-- ------------------------------------------------------------------ 2NF: idea_items.person_id\n-- idea_items is keyed by (idea_id, item_id), but person_id depended on item_id\n-- alone (it is items.person_id). Who asked is now read through the item.\ncreate or replace function ideas_recount() returns trigger language plpgsql security definer set search_path = public as $$\ndeclare x uuid := coalesce(new.idea_id, old.idea_id);\nbegin\n  update ideas set asked_by = (\n      select count(distinct i.person_id) from idea_items ii join items i on i.id = ii.item_id where ii.idea_id = x),\n    updated_at = now()\n  where id = x;\n  return null;\nend $$;\n\n-- asked_by stays a cached count: recount when an item changes hands.\ncreate function items_person_recount() returns trigger language plpgsql security definer set search_path = public as $$\nbegin\n  update ideas d set asked_by = (\n      select count(distinct i.person_id) from idea_items ii join items i on i.id = ii.item_id where ii.idea_id = d.id)\n  where d.id in (select idea_id from idea_items where item_id = new.id);\n  return null;\nend $$;\ncreate trigger items_person_recount after update of person_id on items\n  for each row when (old.person_id is distinct from new.person_id) execute function items_person_recount();\nrevoke execute on function items_person_recount() from public, anon, authenticated;\n\n-- The inbox view read idea_items.person_id; same columns, through items.\ncreate or replace view inbox_by_person with (security_invoker = true) as\nwith w as (\n  select i.*, row_number() over (partition by i.person_id order by i.posted_at desc) rn\n  from items i\n  where i.origin = 'inbox' and i.status in ('new', 'draft_ready')\n)\nselect\n  w.project_id, w.person_id, p.display_name, p.avatar_url, p.stage,\n  count(*)::int as waiting,\n  count(*) filter (where w.status = 'new')::int as needs_you,\n  count(*) filter (where w.status = 'draft_ready')::int as draft_ready,\n  array_agg(distinct w.platform::text) as platforms,\n  max(w.id::text) filter (where w.rn = 1)::uuid as last_item_id,\n  max(w.text) filter (where w.rn = 1) as last_item_text,\n  max(w.kind::text) filter (where w.rn = 1) as last_item_kind,\n  max(w.platform::text) filter (where w.rn = 1) as last_item_platform,\n  max(w.posted_at) as last_posted_at,\n  max(w.status::text) filter (where w.rn = 1) as last_status,\n  (select d.text from drafts d where d.item_id = max(w.id::text) filter (where w.rn = 1)::uuid and d.outcome is null\n     order by d.version desc limit 1) as last_draft_text,\n  exists (select 1 from idea_items ii join items ai on ai.id = ii.item_id where ai.person_id = w.person_id) as has_idea\nfrom w join people p on p.id = w.person_id\ngroup by w.project_id, w.person_id, p.display_name, p.avatar_url, p.stage;\n\nalter table idea_items drop column person_id;\n\n-- ------------------------------------------------------------------ 3NF: document_chunks\n-- kind, source_url, source_ref and label were copies of the chunk's document\n-- (written from it in knowledge.ts; identical on every live row). They live on\n-- documents only. published_at / published_precision stay per chunk (a section\n-- is as new as its newest line), and so does lang.\nalter table documents add constraint documents_kind_check\n  check (kind in ('article', 'story', 'research', 'changelog', 'readme', 'faq', 'fact', 'page'));\n\n-- is_public was label = 'quotable' written twice; Postgres computes it now.\nalter table documents drop column is_public;\nalter table documents add column is_public boolean generated always as (label = 'quotable') stored;\n\n-- Same signature and result as before; the document's fields come through the join.\ncreate or replace function match_document_chunks(\n  p_project uuid,\n  p_query vector(768),\n  p_before timestamptz default now(),\n  p_count int default 40,\n  p_kinds text[] default null,\n  p_min_similarity float default 0.68,\n  p_labels text[] default array['quotable']\n) returns table (\n  id uuid, kind text, title text, source_url text, source_ref text,\n  published_at timestamptz, published_precision text, content text, tokens int, lang text,\n  similarity float, embedding vector(768), label text\n)\nlanguage sql stable security invoker\nset search_path = public, extensions\nset hnsw.ef_search = 100\nset hnsw.iterative_scan = relaxed_order\nas $$\n  select c.id, d.kind, c.title,\n         case when d.label = 'quotable' then d.url end as source_url,\n         case when d.label <> 'quotable' then coalesce(d.source_ref, d.url) end as source_ref,\n         c.published_at, c.published_precision, c.content, c.tokens, c.lang,\n         1 - (c.embedding <=> p_query) as similarity, c.embedding, d.label\n  from document_chunks c\n  join documents d on d.id = c.document_id\n  where c.project_id = p_project\n    and c.embedding is not null\n    and (p_kinds is null or d.kind = any (p_kinds))\n    and d.label = any (p_labels)\n    and case c.published_precision\n          when 'day' then (c.published_at at time zone 'utc')::date < (p_before at time zone 'utc')::date\n          else c.published_at < p_before\n        end\n    and 1 - (c.embedding <=> p_query) >= p_min_similarity\n  order by c.embedding <=> p_query\n  limit greatest(1, least(p_count, 200));\n$$;\n\nalter table document_chunks drop column kind, drop column source_url, drop column source_ref, drop column label;\n\n-- ------------------------------------------------------------------ 3NF: drafts.tokens_in / tokens_out\n-- The totals are functions of the usage breakdown in drafts.tokens (Anthropic's\n-- input excludes cache reads and writes; the total includes them). Drafts that\n-- only had totals (Gemini) get them as the breakdown, then Postgres computes\n-- the totals.\nupdate drafts set tokens = jsonb_build_object('input', tokens_in, 'output', tokens_out)\n  where tokens is null and (tokens_in is not null or tokens_out is not null);\n\ndo $$ begin\n  if exists (select 1 from drafts where\n      tokens_in is distinct from (tokens->>'input')::int + coalesce((tokens->>'cache_read')::int, 0) + coalesce((tokens->>'cache_write')::int, 0)\n      or tokens_out is distinct from (tokens->>'output')::int) then\n    raise exception 'drafts: tokens_in/tokens_out disagree with drafts.tokens; not converting';\n  end if;\nend $$;\n\nalter table drafts drop column tokens_in, drop column tokens_out;\nalter table drafts\n  add column tokens_in int generated always as\n    ((tokens->>'input')::int + coalesce((tokens->>'cache_read')::int, 0) + coalesce((tokens->>'cache_write')::int, 0)) stored,\n  add column tokens_out int generated always as ((tokens->>'output')::int) stored;\n\n-- ------------------------------------------------------------------ derived: people.first/last_touch_at\n-- Kept as a cache of min/max(touches.occurred_at), now by the database for\n-- every writer (the collector did read-then-write; issue touches didn't update\n-- it at all). greatest/least on insert is safe under concurrent inserts.\ncreate function touches_person_span() returns trigger language plpgsql security definer set search_path = public as $$\nbegin\n  if tg_op = 'INSERT' then\n    update people set first_touch_at = least(first_touch_at, new.occurred_at),\n                      last_touch_at = greatest(last_touch_at, new.occurred_at)\n    where id = new.person_id\n      and (first_touch_at is null or last_touch_at is null or new.occurred_at < first_touch_at or new.occurred_at > last_touch_at);\n  else\n    update people p set first_touch_at = s.lo, last_touch_at = s.hi\n    from (select x.id, (select min(occurred_at) from touches where person_id = x.id) lo,\n                       (select max(occurred_at) from touches where person_id = x.id) hi\n          from (select old.person_id as id union select new.person_id) x where x.id is not null) s\n    where p.id = s.id;\n  end if;\n  return null;\nend $$;\ncreate trigger touches_person_span after insert or delete or update of person_id, occurred_at on touches\n  for each row execute function touches_person_span();\nrevoke execute on function touches_person_span() from public, anon, authenticated;\n\n-- The decision RPC no longer sets last_touch_at itself: its touch does.\ncreate or replace function record_draft_outcome(\n  p_draft_id uuid,\n  p_outcome draft_outcome,\n  p_final_text text default null,\n  p_posted_url text default null,\n  p_move_stage person_stage default null\n) returns drafts\nlanguage plpgsql security definer set search_path = public as $$\ndeclare\n  d drafts;\n  it items;\n  uid uuid := auth.uid();\n  posted boolean := p_outcome in ('posted_as_is', 'posted_edited');\nbegin\n  if p_outcome not in ('posted_as_is', 'posted_edited', 'skipped') then raise exception 'bad_outcome'; end if;\n  if posted and coalesce(btrim(p_final_text), '') = '' then raise exception 'final_text_required'; end if;\n  select * into d from drafts where id = p_draft_id for update;\n  if not found then raise exception 'not_found'; end if;\n  select * into it from items where id = d.item_id for update;\n  if uid is null or not is_member(it.project_id) then raise exception 'not_found'; end if;\n  if d.outcome is not null then raise exception 'already_decided'; end if;\n\n  update drafts set\n    outcome = p_outcome,\n    final_text = case when posted then p_final_text else final_text end,\n    posted_url = case when posted then p_posted_url else posted_url end,\n    posted_at = case when posted then now() else posted_at end,\n    posted_by = case when posted then uid else posted_by end,\n    decided_by = uid, decided_at = now()\n  where id = p_draft_id returning * into d;\n\n  update drafts set outcome = 'superseded', decided_at = now()\n  where item_id = it.id and id <> p_draft_id and outcome is null;\n\n  update items set status = case when posted then 'answered'::item_status else 'skipped'::item_status end,\n                   skip_reason = null\n  where id = it.id;\n\n  if posted then\n    insert into touches (project_id, person_id, direction, platform, kind, occurred_at, url, text, item_id, by_founder, source)\n    values (it.project_id, it.person_id, 'out', it.platform, 'reply', now(), p_posted_url, p_final_text, it.id, uid, 'app');\n    update people set\n      stage = coalesce(p_move_stage, case when stage = 'noticed' then 'talking'::person_stage else stage end)\n    where id = it.person_id;\n  elsif p_move_stage is not null then\n    update people set stage = p_move_stage where id = it.person_id;\n  end if;\n  return d;\nend $$;\n\n-- ------------------------------------------------------------------ 1NF: plans.allowed_models\n-- The array was a relation in disguise (searched with = any in three\n-- functions). One row per (plan, model); ord keeps the order the app lists.\ncreate table plan_models (\n  plan_id text not null,\n  model text not null,\n  ord smallint not null default 0,\n  primary key (plan_id, model),\n  constraint plan_models_plan_fkey foreign key (plan_id) references plans (id) on delete cascade\n);\ninsert into plan_models (plan_id, model, ord)\n  select p.id, m.model, m.n from plans p, unnest(p.allowed_models) with ordinality as m(model, n);\n\n-- The default is one of the plan's models (deferred: a plan and its models are\n-- inserted in one transaction).\nalter table plans drop constraint plans_default_allowed;\nalter table plans add constraint plans_default_model_fkey foreign key (id, default_model)\n  references plan_models (plan_id, model) deferrable initially deferred;\n\nalter table plan_models enable row level security;\ncreate policy signed_in_read on plan_models for select to authenticated using (true);\nrevoke all on plan_models from anon, authenticated;\ngrant select on plan_models to authenticated;\n\n-- Same rule as before: an override is checked when it is set; if the plan later\n-- drops the model (or the founder changes plan), the server falls back to the\n-- plan default instead. That's why this stays a trigger, not a foreign key.\ncreate or replace function check_founder_draft_model() returns trigger\n  language plpgsql set search_path = public as $$\nbegin\n  if new.draft_model is not null\n     and (tg_op = 'INSERT' or new.draft_model is distinct from old.draft_model)\n     and not exists (select 1 from plan_models m where m.plan_id = new.plan_id and m.model = new.draft_model) then\n    raise exception 'model_not_allowed' using errcode = '23514', detail = format('%s is not in plan %s', new.draft_model, new.plan_id);\n  end if;\n  return new;\nend $$;\n\ncreate or replace function my_draft_model() returns jsonb\n  language sql stable security definer set search_path = public as $$\n  select jsonb_build_object(\n    'plan_id', p.id, 'plan_name', p.name, 'default_model', p.default_model,\n    'allowed_models', coalesce((select jsonb_agg(m.model order by m.ord, m.model) from plan_models m where m.plan_id = p.id), '[]'::jsonb),\n    'draft_model', f.draft_model,\n    'effective_model', case when exists (select 1 from plan_models m where m.plan_id = p.id and m.model = f.draft_model)\n                            then f.draft_model else p.default_model end)\n  from founders f join plans p on p.id = f.plan_id\n  where f.id = auth.uid()\n$$;\n\ncreate or replace function set_draft_model(model text) returns jsonb\n  language plpgsql security definer set search_path = public as $$\ndeclare\n  m text := nullif(btrim(model), '');\nbegin\n  if auth.uid() is null then raise exception 'not_found'; end if;\n  if m is not null and not exists (\n    select 1 from founders f join plan_models pm on pm.plan_id = f.plan_id\n    where f.id = auth.uid() and pm.model = m) then\n    raise exception 'model_not_allowed' using errcode = '23514';\n  end if;\n  update founders set draft_model = m where id = auth.uid();\n  if not found then raise exception 'not_found'; end if;\n  return my_draft_model();\nend $$;\n\nalter table plans drop column allowed_models;\n=== supabase/migrations/20261011010000_draft_checks.sql\n-- [check: …] gaps she can resolve (docs/API.md › Changes 2026-10-11).\n--\n-- * drafts.variant 'resolve': a version made by answering or dropping gaps of\n--   the version before it (draft function, `resolve`). Nothing else changes in\n--   how versions work: the older undecided one is superseded.\n-- * drafts.meta: what made this version beyond the model call. For 'resolve':\n--   {based_on: {draft_id, version}, edited_before, resolved: [{check_id,\n--   question, action: answer|drop, answer?, method: model|fallback, reason?,\n--   by, at}]}. Her answers stay here as a fact / voice signal for later drafts.\n-- * A posted reply never contains a gap: record_draft_outcome refuses\n--   final_text with \"[check\" (any case), and a constraint makes it a rule for\n--   every writer.\n\nalter table drafts drop constraint drafts_variant_check;\nalter table drafts add constraint drafts_variant_check check (variant in ('first', 'shorter', 'redraft', 'resolve'));\n\nalter table drafts add column meta jsonb not null default '{}'::jsonb;\n\nalter table drafts add constraint drafts_posted_without_checks\n  check (outcome is null or outcome not in ('posted_as_is', 'posted_edited') or final_text is null or final_text !~* '\\[check');\n\ncreate or replace function record_draft_outcome(\n  p_draft_id uuid,\n  p_outcome draft_outcome,\n  p_final_text text default null,\n  p_posted_url text default null,\n  p_move_stage person_stage default null\n) returns drafts\nlanguage plpgsql security definer set search_path = public as $$\ndeclare\n  d drafts;\n  it items;\n  uid uuid := auth.uid();\n  posted boolean := p_outcome in ('posted_as_is', 'posted_edited');\nbegin\n  if p_outcome not in ('posted_as_is', 'posted_edited', 'skipped') then raise exception 'bad_outcome'; end if;\n  if posted and coalesce(btrim(p_final_text), '') = '' then raise exception 'final_text_required'; end if;\n  if posted and p_final_text ~* '\\[check' then raise exception 'unfilled_check'; end if;\n  select * into d from drafts where id = p_draft_id for update;\n  if not found then raise exception 'not_found'; end if;\n  select * into it from items where id = d.item_id for update;\n  if uid is null or not is_member(it.project_id) then raise exception 'not_found'; end if;\n  if d.outcome is not null then raise exception 'already_decided'; end if;\n\n  update drafts set\n    outcome = p_outcome,\n    final_text = case when posted then p_final_text else final_text end,\n    posted_url = case when posted then p_posted_url else posted_url end,\n    posted_at = case when posted then now() else posted_at end,\n    posted_by = case when posted then uid else posted_by end,\n    decided_by = uid, decided_at = now()\n  where id = p_draft_id returning * into d;\n\n  update drafts set outcome = 'superseded', decided_at = now()\n  where item_id = it.id and id <> p_draft_id and outcome is null;\n\n  update items set status = case when posted then 'answered'::item_status else 'skipped'::item_status end,\n                   skip_reason = null\n  where id = it.id;\n\n  if posted then\n    insert into touches (project_id, person_id, direction, platform, kind, occurred_at, url, text, item_id, by_founder, source)\n    values (it.project_id, it.person_id, 'out', it.platform, 'reply', now(), p_posted_url, p_final_text, it.id, uid, 'app');\n    update people set\n      stage = coalesce(p_move_stage, case when stage = 'noticed' then 'talking'::person_stage else stage end)\n    where id = it.person_id;\n  elsif p_move_stage is not null then\n    update people set stage = p_move_stage where id = it.person_id;\n  end if;\n  return d;\nend $$;\n=== supabase/migrations/20261011120000_tokens_generated_safe.sql\n-- drafts.tokens_in / tokens_out are generated from the drafts.tokens JSON.\n-- Review by Arhan Canli (dev.to, 2026-10-11): the first term had no coalesce,\n-- so a row whose JSON lacked \"input\" got tokens_in = NULL instead of the cache\n-- sum, and a value like \"12.0\" made the int cast raise and failed the whole\n-- insert. A generated column can't be written around, so the expression must\n-- never raise: numbers are parsed leniently (\"12\", \"12.0\", 12) and anything\n-- else counts as missing.\n\ncreate or replace function hb_json_int(v text) returns int\n  language sql immutable parallel safe\nas $$\n  select case when v ~ '^\\s*-?\\d+(\\.\\d+)?\\s*$' then round(v::numeric)::int end\n$$;\n\n-- NULL only when there is no token count at all; otherwise the sum of what's there.\nalter table drafts alter column tokens_in set expression as (\n  case when coalesce(hb_json_int(tokens->>'input'), hb_json_int(tokens->>'cache_read'),\n                     hb_json_int(tokens->>'cache_write')) is null then null\n       else coalesce(hb_json_int(tokens->>'input'), 0)\n          + coalesce(hb_json_int(tokens->>'cache_read'), 0)\n          + coalesce(hb_json_int(tokens->>'cache_write'), 0) end);\nalter table drafts alter column tokens_out set expression as (hb_json_int(tokens->>'output'));\n=== supabase/migrations/20261012010000_intent_discuss.sql\n-- Intent chips: \"Discuss\" (her view + one question that keeps the discussion\n-- going, normal length) becomes the default chip. ask_feedback / ask_price\n-- are no longer offered in the app but stay valid for existing drafts.\nalter table drafts drop constraint drafts_intent_check;\nalter table drafts add constraint drafts_intent_check\n  check (intent in ('discuss', 'just_answer', 'invite_to_try', 'ask_feedback', 'ask_price', 'auto'));\n=== supabase/migrations/20261012020000_item_liked.sql\n-- Like from the thread screen: the phone likes the comment on the network\n-- (dev.to POST /reactions, with her session) and records it here so the\n-- button shows it. null = not liked from Hearback.\nalter table items add column liked_at timestamptz;\n=== supabase/migrations/20261012030000_item_spam_verdict.sql\n-- Spam check (triage route spam_check: the comment looks like a plug). Her\n-- answer: 'spam' (hidden on the network from the app, item skipped) or\n-- 'not_spam' (treated as a usual comment). null = not asked / not answered.\nalter table items add column spam_verdict text check (spam_verdict in ('spam', 'not_spam'));\n=== supabase/migrations/20261012040000_documents_kind_docs.sql\n-- Documentation pages (a site's /docs, /guide, /help, a repo's docs/ folder)\n-- get their own kind, so a draft can point to them as \"the docs\" (Invite to\n-- try: draft/materials.ts).\nalter table documents drop constraint documents_kind_check;\nalter table documents add constraint documents_kind_check\n  check (kind in ('article', 'story', 'research', 'changelog', 'readme', 'faq', 'docs', 'fact', 'page'));\n=== supabase/migrations/20261014010000_github_board_results.sql\n-- GitHub Projects board + what happened to an idea's issue.\n-- docs/ARCHITECTURE.md › GitHub App, docs/API.md › Changes 2026-10-14.\n--\n-- A project may link one organization board (Projects v2). Hearback only\n-- reads it: the duplicate check looks at its items (any repo, drafts too) and\n-- the results sweep reads an issue's Status there. Needs the app's\n-- \"Organization permissions › Projects: read-only\".\n--\n-- The sweep (function github-results, every 20 min) notices an idea's issue\n-- closing as completed (or its board Status reaching Done), reads the result\n-- (closing PRs, the last maintainer comment, its links) and drafts a follow-up\n-- reply to everyone who asked. Nothing is posted without her tap.\n\n-- ------------------------------------------------------------------ projects › board\n-- owner + number is the board's address (github.com/orgs/<owner>/projects/<number>);\n-- id is its GraphQL node id; title is GitHub's, cached for display.\nalter table projects\n  add column github_board_owner text check (github_board_owner is null or github_board_owner ~ '^[A-Za-z0-9-]+$'),\n  add column github_board_number int check (github_board_number is null or github_board_number > 0),\n  add column github_board_id text,\n  add column github_board_title text,\n  add constraint projects_github_board_whole check (\n    (github_board_owner is null) = (github_board_number is null)\n    and (github_board_owner is null) = (github_board_id is null));\n\n-- ------------------------------------------------------------------ ideas › issue result\nalter table ideas\n  -- GitHub's view of the issue, as last read.\n  add column github_issue_state text check (github_issue_state in ('open', 'closed')),\n  add column github_issue_state_reason text,          -- completed | not_planned | duplicate | reopened\n  add column github_issue_closed_at timestamptz,\n  add column github_board_status text,                -- the board's Status option, if the issue is on the linked board\n  add column github_checked_at timestamptz,\n  -- What was done, in words she can edit before replies are drafted.\n  add column result_note text,\n  add column result_note_url text,                    -- the comment it came from\n  add column result_links jsonb not null default '[]',-- [{title, url, kind: pr|commit|link}]\n  add column result_drafted_at timestamptz;           -- follow-up drafts were made (once per result)\n\n-- The sweep's queue: ideas with a real issue that are not settled yet.\ncreate index ideas_issue_watch on ideas (github_checked_at nulls first)\n  where github_issue_number is not null and result_drafted_at is null;\n\n-- ------------------------------------------------------------------ drafts › intent\n-- share_result: the follow-up \"what you asked for is done\" reply.\nalter table drafts drop constraint drafts_intent_check;\nalter table drafts add constraint drafts_intent_check\n  check (intent in ('discuss', 'just_answer', 'invite_to_try', 'ask_feedback', 'ask_price', 'share_result', 'auto'));\n\n-- ------------------------------------------------------------------ cron\nselect cron.schedule('hb-github-results', '11-59/20 * * * *', $$select hb_call_function('github-results', '{}')$$);\n=== supabase/migrations/20261015010000_ask_code_model_calls.sql\n-- Ask the code (docs/ARCHITECTURE.md › Ask the code) and the model-call log.\n--\n-- model_calls: every model call the functions make (drafts, resolves,\n-- points, triage summaries, decider, discover, landing reads, ask-code steps)\n-- with tokens and list-price cost. Service role only; read it with SQL or\n-- model_spend_daily. Drafts written before this log are copied in once\n-- (purpose 'draft', fn 'backfill') from drafts.tokens.\n--\n-- code_questions: a question about the project's code (usually a draft's\n-- [check: …] gap) and its answer with cited lines. answered_by 'cloud' is\n-- the ask-code agent; 'local' is kept for a founder's own agent answering\n-- from her machine (backlog). Members read their project's rows; only the\n-- function writes them.\n\ncreate table model_calls (\n  id bigint generated always as identity primary key,\n  at timestamptz not null default now(),\n  fn text,                     -- the edge function (draft, triage, ask-code, …)\n  purpose text not null,       -- draft / resolve / points / triage_summary / decide / discover_why / landing / ask_code\n  project_id uuid references projects(id) on delete set null,\n  founder_id uuid,             -- the signed-in founder (no FK: a log row must never fail to insert)\n  item_id uuid references items(id) on delete set null,\n  run_id uuid,                 -- the steps of one multi-step run (code_questions.id)\n  provider text not null,\n  model text not null,\n  ok boolean not null,\n  error text,\n  tokens_in int,               -- all prompt tokens (uncached + cache reads + cache writes)\n  tokens_out int,\n  usage jsonb,                 -- {input, output, cache_read, cache_write, cost_usd}\n  cost_usd numeric(12, 6),     -- list price (pricing.ts); null: unknown or free (Gemini free key)\n  latency_ms int\n);\ncreate index model_calls_at on model_calls (at desc);\ncreate index model_calls_project on model_calls (project_id, at desc);\ncreate index model_calls_run on model_calls (run_id) where run_id is not null;\nalter table model_calls enable row level security;  -- no policies: service role only\nrevoke all on model_calls from anon, authenticated;\n\ninsert into model_calls (at, fn, purpose, project_id, item_id, provider, model, ok, tokens_in, tokens_out, usage, cost_usd, latency_ms)\nselect d.created_at, 'backfill', 'draft', i.project_id, d.item_id, d.provider, d.model, true,\n       d.tokens_in, d.tokens_out, d.tokens, nullif(d.tokens->>'cost_usd', '')::numeric, d.latency_ms\nfrom drafts d join items i on i.id = d.item_id;\n\ncreate view model_spend_daily with (security_invoker = true) as\nselect (at at time zone 'utc')::date as day, purpose, provider, model,\n       count(*) as calls,\n       count(*) filter (where not ok) as failed,\n       sum(tokens_in) as tokens_in,\n       sum(tokens_out) as tokens_out,\n       round(sum(coalesce(cost_usd, 0)), 4) as cost_usd\nfrom model_calls\ngroup by 1, 2, 3, 4;\nrevoke all on model_spend_daily from anon, authenticated;\n\ncreate table code_questions (\n  id uuid primary key default gen_random_uuid(),\n  project_id uuid not null references projects(id) on delete cascade,\n  item_id uuid references items(id) on delete set null,\n  asked_by uuid references founders(id) on delete set null,\n  question text not null check (length(question) between 3 and 2000),\n  check_question text,         -- the [check: …] gap it answers, if any\n  repo text not null,\n  commit_sha text,             -- the code the answer was read at\n  status text not null default 'running' check (status in ('running', 'answered', 'failed', 'waiting_local')),\n  answered_by text not null default 'cloud' check (answered_by in ('cloud', 'local')),\n  answer text,\n  details text,\n  sources jsonb not null default '[]',   -- [{path, start_line, end_line, note, url}]\n  confidence text check (confidence in ('high', 'medium', 'low')),\n  model text,\n  steps int,\n  usage jsonb,                 -- run totals: {input, output, cache_read, cache_write, cost_usd, tool_calls, github_requests}\n  cost_usd numeric(12, 6),\n  error text,\n  created_at timestamptz not null default now(),\n  answered_at timestamptz,\n  used_at timestamptz          -- she used the answer (it was saved to the project's knowledge)\n);\ncreate index code_questions_item on code_questions (item_id, created_at desc);\ncreate index code_questions_project on code_questions (project_id, created_at desc);\nalter table code_questions enable row level security;\ncreate policy members_read on code_questions for select using (is_member(project_id));\nrevoke insert, update, delete on code_questions from anon, authenticated;\n","numLines":599,"startLine":1,"totalLines":599}},"tool_result_meta":[{"id":"toolu_01AGU3JpF5DAVGkbxoyJ8o7G","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
