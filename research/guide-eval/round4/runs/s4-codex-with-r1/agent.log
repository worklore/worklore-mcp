tions/20261015010000_ask_code_model_calls.sql:56:create table code_questions (\nsupabase/migrations/20261015010000_ask_code_model_calls.sql:82:alter table code_questions enable row level security;\nsupabase/migrations/20261009190000_draft_model_settings.sql:14:alter table projects add column if not exists settings jsonb not null default '{}';\nsupabase/migrations/20261009190000_draft_model_settings.sql:15:alter table drafts add column if not exists tokens jsonb;\nsupabase/migrations/20261010030000_github_app.sql:9:create table github_installations (\nsupabase/migrations/20261010030000_github_app.sql:23:create table github_installation_projects (\nsupabase/migrations/20261010030000_github_app.sql:33:create table github_install_states (\nsupabase/migrations/20261010030000_github_app.sql:45:alter table github_installations enable row level security;\nsupabase/migrations/20261010030000_github_app.sql:46:alter table github_installation_projects enable row level security;\nsupabase/migrations/20261010030000_github_app.sql:47:alter table github_install_states enable row level security;\nsupabase/migrations/20261010030000_github_app.sql:64:alter table ideas add column github_issue_repo text;\nsupabase/migrations/20261014010000_github_board_results.sql:17:alter table projects\nsupabase/migrations/20261014010000_github_board_results.sql:22:  add constraint projects_github_board_whole check (\nsupabase/migrations/20261014010000_github_board_results.sql:27:alter table ideas\nsupabase/migrations/20261014010000_github_board_results.sql:46:alter table drafts drop constraint drafts_intent_check;\nsupabase/migrations/20261014010000_github_board_results.sql:47:alter table drafts add constraint drafts_intent_check\nsupabase/migrations/20261012040000_documents_kind_docs.sql:4:alter table documents drop constraint documents_kind_check;\nsupabase/migrations/20261012040000_documents_kind_docs.sql:5:alter table documents add constraint documents_kind_check\nsupabase/migrations/20261010040000_normal_forms.sql:25:alter table people   add constraint people_id_project unique (id, project_id);\nsupabase/migrations/20261010040000_normal_forms.sql:26:alter table accounts add constraint accounts_id_project_platform unique (id, project_id, platform);\nsupabase/migrations/20261010040000_normal_forms.sql:27:alter table items    add constraint items_id_project unique (id, project_id),\nsupabase/migrations/20261010040000_normal_forms.sql:28:                     add constraint items_id_project_person unique (id, project_id, person_id);\nsupabase/migrations/20261010040000_normal_forms.sql:29:alter table documents add constraint documents_id_project unique (id, project_id);\nsupabase/migrations/20261010040000_normal_forms.sql:30:alter table ideas    add constraint ideas_id_project unique (id, project_id);\nsupabase/migrations/20261010040000_normal_forms.sql:31:alter table themes   add constraint themes_id_project unique (id, project_id);\nsupabase/migrations/20261010040000_normal_forms.sql:35:alter table items\nsupabase/migrations/20261010040000_normal_forms.sql:37:  add constraint items_person_fkey foreign key (person_id, project_id) references people (id, project_id) on delete cascade,\nsupabase/migrations/20261010040000_normal_forms.sql:39:  add constraint items_account_fkey foreign key (account_id, project_id, platform)\nsupabase/migrations/20261010040000_normal_forms.sql:42:alter table identities\nsupabase/migrations/20261010040000_normal_forms.sql:44:  add constraint identities_person_fkey foreign key (person_id, project_id) references people (id, project_id) on delete cascade;\nsupabase/migrations/20261010040000_normal_forms.sql:48:alter table touches\nsupabase/migrations/20261010040000_normal_forms.sql:50:  add constraint touches_person_fkey foreign key (person_id, project_id) references people (id, project_id) on delete cascade,\nsupabase/migrations/20261010040000_normal_forms.sql:52:  add constraint touches_item_fkey foreign key (item_id, project_id, person_id)\nsupabase/migrations/20261010040000_normal_forms.sql:55:alter table document_chunks\nsupabase/migrations/20261010040000_normal_forms.sql:57:  add constraint document_chunks_document_fkey foreign key (document_id, project_id) references documents (id, project_id) on delete cascade;\nsupabase/migrations/20261010040000_normal_forms.sql:59:alter table idea_items\nsupabase/migrations/20261010040000_normal_forms.sql:61:  add constraint idea_items_idea_fkey foreign key (idea_id, project_id) references ideas (id, project_id) on delete cascade,\nsupabase/migrations/20261010040000_normal_forms.sql:63:  add constraint idea_items_item_fkey foreign key (item_id, project_id) references items (id, project_id) on delete cascade;\nsupabase/migrations/20261010040000_normal_forms.sql:66:alter table documents\nsupabase/migrations/20261010040000_normal_forms.sql:68:  add constraint documents_theme_fkey foreign key (theme_id, project_id) references themes (id, project_id) on delete set null (theme_id);\nsupabase/migrations/20261010040000_normal_forms.sql:69:alter table project_memory\nsupabase/migrations/20261010040000_normal_forms.sql:71:  add constraint project_memory_theme_fkey foreign key (theme_id, project_id) references themes (id, project_id) on delete cascade;\nsupabase/migrations/20261010040000_normal_forms.sql:94:create trigger items_person_recount after update of person_id on items\nsupabase/migrations/20261010040000_normal_forms.sql:123:alter table idea_items drop column person_id;\nsupabase/migrations/20261010040000_normal_forms.sql:130:alter table documents add constraint documents_kind_check\nsupabase/migrations/20261010040000_normal_forms.sql:134:alter table documents drop column is_public;\nsupabase/migrations/20261010040000_normal_forms.sql:135:alter table documents add column is_public boolean generated always as (label = 'quotable') stored;\nsupabase/migrations/20261010040000_normal_forms.sql:176:alter table document_chunks drop column kind, drop column source_url, drop column source_ref, drop column label;\nsupabase/migrations/20261010040000_normal_forms.sql:194:alter table drafts drop column tokens_in, drop column tokens_out;\nsupabase/migrations/20261010040000_normal_forms.sql:195:alter table drafts\nsupabase/migrations/20261010040000_normal_forms.sql:196:  add column tokens_in int generated always as\nsupabase/migrations/20261010040000_normal_forms.sql:198:  add column tokens_out int generated always as ((tokens->>'output')::int) stored;\nsupabase/migrations/20261010040000_normal_forms.sql:220:create trigger touches_person_span after insert or delete or update of person_id, occurred_at on touches\nsupabase/migrations/20261010040000_normal_forms.sql:278:create table plan_models (\nsupabase/migrations/20261010040000_normal_forms.sql:290:alter table plans drop constraint plans_default_allowed;\nsupabase/migrations/20261010040000_normal_forms.sql:291:alter table plans add constraint plans_default_model_fkey foreign key (id, default_model)\nsupabase/migrations/20261010040000_normal_forms.sql:294:alter table plan_models enable row level security;\nsupabase/migrations/20261010040000_normal_forms.sql:341:alter table plans drop column allowed_models;\nsupabase/migrations/20261009150000_project_url_key.sql:29:alter table projects add column url_key text generated always as (hb_url_key(url)) stored;\nsupabase/migrations/20261009150000_project_url_key.sql:34:alter table projects add column duplicate_of uuid references projects(id) on delete set null;\nsupabase/migrations/20261009150000_project_url_key.sql:50:create unique index projects_creator_url_key on projects (created_by, url_key)\nsupabase/migrations/20261008190000_waitlist.sql:4:create table waitlist (\nsupabase/migrations/20261008190000_waitlist.sql:12:create unique index waitlist_email on waitlist (lower(email));\nsupabase/migrations/20261008190000_waitlist.sql:13:alter table waitlist enable row level security;\nsupabase/migrations/20261008230100_knowledge_chunks.sql:22:alter table documents\nsupabase/migrations/20261008230100_knowledge_chunks.sql:30:create table document_chunks (\nsupabase/migrations/20261008230100_knowledge_chunks.sql:57:alter table document_chunks enable row level security;\nsupabase/migrations/20261008230100_knowledge_chunks.sql:107:alter table items\nsupabase/migrations/20261008230100_knowledge_chunks.sql:109:  add column triage_route text generated always as (triage->>'route') stored;\nsupabase/migrations/20261008230400_server_state.sql:39:create table usage_counters (\nsupabase/migrations/20261008230400_server_state.sql:45:alter table usage_counters enable row level security;  -- no policies: service role only\n","exit_code":0,"status":"completed"}}
