{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/zsh -lc \"sed -n '55,115p' supabase/functions/_shared/core/sources/voice.ts; sed -n '1,105p' supabase/functions/_shared/core/store.ts; sed -n '1,110p' supabase/functions/_shared/core/sources/run.ts\"","aggregated_output":"export function voiceQuestions(): Questions {\n  return {\n    meaningful: {\n      type: \"boolean\",\n      instructions: \"Is this a meaningful sample of how this person writes in her own words, worth imitating when drafting her future replies?\",\n      criteria: {\n        true: \"Her own prose: at least one full sentence she wrote herself, with her own point, experience, tone or reasoning (a reply, an opinion, an explanation, a question back).\",\n        false: \"Not her prose, or too empty to show a voice: emoji or bare thanks, mostly a quote of someone else, a code or log dump, a bare link or list of links, a template or auto-generated text.\",\n      },\n    },\n    quality: {\n      type: \"score\",\n      instructions: \"How well does this show her personal writing voice?\",\n      criteria: [\n        \"no voice at all\",\n        \"short and generic: anyone could have written it\",\n        \"a plain, real message with some content\",\n        \"substantive: her own point or experience, clearly in her words\",\n        \"distinctive: shows how she argues, explains or jokes; a great example to imitate\",\n      ],\n    },\n  };\n}\n\nexport interface Candidate {\n  text: string;\n  context?: string | null;\n  platform: string;\n}\n\nexport interface Verdict {\n  status: \"accepted\" | \"rejected\";\n  reason: string;\n  quality: number | null;\n  scores: Record<string, unknown> | null;\n}\n\n/** Pure. The decider's answers → accepted / rejected. */\nexport function verdictFrom(d: Pick<Decision, \"answers\" | \"decider\" | \"model\">): Verdict {\n  const m = d.answers.meaningful, q = d.answers.quality;\n  const pMeaningful = Number(m?.probabilities?.true ?? (m?.answer === true ? 1 : 0));\n  const quality = Math.round(Number(q?.answer ?? 0) * 100) / 100;\n  const scores = { p_meaningful: pMeaningful, quality, decider: d.decider, model: d.model };\n  if (pMeaningful < MEANINGFUL_P) return { status: \"rejected\", reason: `decider: not a meaningful sample (p=${pMeaningful.toFixed(2)})`, quality, scores };\n  if (quality < QUALITY_MIN) return { status: \"rejected\", reason: `decider: quality ${quality} < ${QUALITY_MIN}`, quality, scores };\n  return { status: \"accepted\", reason: `decider: meaningful (p=${pMeaningful.toFixed(2)}), quality ${quality}`, quality, scores };\n}\n\n/** Rules first; the decider only for what the rules let through. */\nexport async function judgeCandidate(decider: Decider, c: Candidate): Promise<Verdict> {\n  const rule = ruleReject(c.text);\n  if (rule) return { status: \"rejected\", reason: `rule: ${rule}`, quality: 0, scores: null };\n  const state = [\n    `Platform: ${c.platform}`,\n    c.context ? `What it answered (or where it sits):\\n${c.context.slice(0, 600)}` : \"\",\n    `What she wrote:\\n${c.text.slice(0, 3000)}`,\n  ].filter(Boolean).join(\"\\n\\n\");\n  return verdictFrom(await decider.decide(state, voiceQuestions()));\n}\n\nexport interface AcceptedSample {\n// Core storage: people (one per person, many identities), items (deduped by\n// platform id), touches (the person's timeline). Platform-free: the platform\n// is just the connector id. All writes use the service role after the\n// caller's membership was checked.\n\nimport { admin } from \"../server/ctx.ts\";\n\n\nexport interface IdentityIn {\n  handle: string;\n  external_id?: string | null;\n  display_name?: string | null;\n  avatar_url?: string | null;\n  profile_url?: string | null;\n  public_profile?: Record<string, unknown> | null;\n}\n\n/** Person for (project, platform, handle): found by identity, else created. Returns person_id. */\nexport async function upsertPerson(projectId: string, platform: string, who: IdentityIn): Promise<string> {\n  const db = admin();\n  const handle = who.handle.replace(/^@/, \"\");\n  const find = async () => (await db.from(\"identities\").select(\"id, person_id\")\n    .eq(\"project_id\", projectId).eq(\"platform\", platform).eq(\"handle\", handle).maybeSingle()).data;\n  const found = await find();\n  if (found) {\n    const patch: Record<string, unknown> = { profile_fetched_at: new Date().toISOString() };\n    if (who.external_id) patch.external_id = who.external_id;\n    if (who.profile_url) patch.profile_url = who.profile_url;\n    if (who.public_profile) patch.public_profile = who.public_profile;\n    await db.from(\"identities\").update(patch).eq(\"id\", found.id);\n    const pp: Record<string, unknown> = {};\n    if (who.display_name) pp.display_name = who.display_name;\n    if (who.avatar_url) pp.avatar_url = who.avatar_url;\n    if (Object.keys(pp).length) {\n      // Only fill blanks: the founder may have renamed the person.\n      const { data: p } = await db.from(\"people\").select(\"display_name, avatar_url\").eq(\"id\", found.person_id).single();\n      const fill: Record<string, unknown> = {};\n      if (!p?.display_name && pp.display_name) fill.display_name = pp.display_name;\n      if (pp.avatar_url && p?.avatar_url !== pp.avatar_url) fill.avatar_url = pp.avatar_url;\n      if (Object.keys(fill).length) await db.from(\"people\").update(fill).eq(\"id\", found.person_id);\n    }\n    return found.person_id;\n  }\n  const { data: person, error } = await db.from(\"people\").insert({\n    project_id: projectId, display_name: who.display_name || handle, avatar_url: who.avatar_url ?? null,\n  }).select(\"id\").single();\n  if (error) throw error;\n  const { error: e2 } = await db.from(\"identities\").insert({\n    project_id: projectId, person_id: person.id, platform, handle, external_id: who.external_id ?? null,\n    profile_url: who.profile_url ?? null, public_profile: who.public_profile ?? null, profile_fetched_at: new Date().toISOString(),\n  });\n  if (e2) {\n    // Lost a race with another collector: use the winner's person.\n    await db.from(\"people\").delete().eq(\"id\", person.id);\n    const again = await find();\n    if (again) return again.person_id;\n    throw e2;\n  }\n  return person.id;\n}\n\nexport interface ItemIn {\n  project_id: string;\n  account_id: string | null;\n  person_id: string;\n  platform: string;\n  kind: \"reply\" | \"mention\" | \"quote\" | \"comment\" | \"post\";\n  external_id: string;\n  url: string | null;\n  text: string;\n  posted_at: string;\n  root_ref?: unknown;\n  parent_ref?: unknown;\n  my_post?: unknown;\n  thread?: unknown;\n  status?: \"new\" | \"draft_ready\" | \"answered\" | \"skipped\";\n  origin?: \"inbox\" | \"discover\";\n  discovery?: unknown;\n  triaged_at?: string | null;\n}\n\n/** Inserts unless (project, platform, external_id) exists. Returns the id and whether it is new. */\nexport async function insertItem(row: ItemIn): Promise<{ id: string; inserted: boolean }> {\n  const db = admin();\n  const { data, error } = await db.from(\"items\").upsert(row, { onConflict: \"project_id,platform,external_id\", ignoreDuplicates: true })\n    .select(\"id\");\n  if (error) throw error;\n  if (data && data.length) {\n    if ((row.origin ?? \"inbox\") === \"inbox\") {\n      await addTouch({\n        project_id: row.project_id, person_id: row.person_id, direction: \"in\", platform: row.platform, kind: row.kind,\n        occurred_at: row.posted_at, url: row.url, text: row.text, item_id: data[0].id,\n      });\n    }\n    return { id: data[0].id, inserted: true };\n  }\n  const { data: ex, error: e2 } = await db.from(\"items\").select(\"id, thread, my_post\").eq(\"project_id\", row.project_id)\n    .eq(\"platform\", row.platform).eq(\"external_id\", row.external_id).single();\n  if (e2) throw e2;\n  // Seen before, maybe with less context (the phone's cut parent comment, no\n  // article body): keep whichever thread and post say more.\n  const patch = richerContext(ex, row);\n  if (patch) await db.from(\"items\").update(patch).eq(\"id\", ex.id);\n  return { id: ex.id, inserted: false };\n}\n// The sources pipeline for one project (docs/ARCHITECTURE.md › Sources: voice\n// and knowledge). Platform-free: it asks the registry's connectors for\n//   ownWriting(account)      → voice-sample candidates of the account's founder\n//   publishedWork(account)   → knowledge documents\n//   projectSource(project)   → both (GitHub: the linked repo's folder)\n// plus the product's site (site.ts) and the replies she posted through\n// Hearback, then judges candidates (voice.ts) and refreshes each founder's\n// active set. Every run is idempotent: candidates dedupe by (founder,\n// platform, external_id) and by text hash; documents by URL + content hash.\n// Runs: on account connect (the app), daily (cron), after each posted draft\n// (trigger → candidate; the judge cron decides within minutes), \"Sync now\".\n\nimport { admin } from \"../../server/ctx.ts\";\nimport { tagUsage } from \"../../server/usage.ts\";\nimport { embedPending, markSeed, storeDocs, StoreReport } from \"../../server/knowledge.ts\";\nimport { decider } from \"../../server/models.ts\";\nimport { connector, connectors } from \"../registry.ts\";\nimport type { AccountRow, Connector, OwnWriting, ProjectSourceRow, SourceBatch, SourceContext, SourceDocument } from \"../types.ts\";\nimport { readSite } from \"./site.ts\";\nimport { judgeCandidate, normalizeText, selectActive, textSha } from \"./voice.ts\";\n\nexport type Phase = \"all\" | \"voice\" | \"knowledge\" | \"judge\";\n\nexport interface SourceStatus { source: string; status: string; message?: string | null; stats?: Record<string, number> }\n\nexport interface ProjectSyncReport {\n  project_id: string;\n  voice: { found: number; new: number };\n  judged: { judged: number; accepted: number; rejected: number; pending: number };\n  active: Record<string, number>;\n  knowledge: (StoreReport & { by_source: Record<string, number>; seed_marked: number }) | null;\n  embedded: number;\n  pending_chunks: number | null;\n  sources: SourceStatus[];\n}\n\ninterface ProjectRow extends ProjectSourceRow { created_by: string | null }\n\nconst MAX_TEXT = 5000;\n\nasync function loadStates(projectId: string): Promise<Map<string, Record<string, unknown>>> {\n  const { data, error } = await admin().from(\"source_syncs\").select(\"source, state\").eq(\"project_id\", projectId);\n  if (error) throw error;\n  return new Map((data ?? []).map((r) => [r.source as string, (r.state ?? {}) as Record<string, unknown>]));\n}\n\nasync function saveState(projectId: string, source: string, b: SourceBatch, extra: Record<string, number> = {}) {\n  const row = {\n    project_id: projectId, source, status: b.status ?? \"ok\", message: b.message ?? null,\n    stats: { ...(b.stats ?? {}), ...extra }, last_synced_at: new Date().toISOString(),\n    ...(b.state ? { state: b.state } : {}),\n  };\n  const { error } = await admin().from(\"source_syncs\").upsert(row, { onConflict: \"project_id,source\" });\n  if (error) console.error(`source_syncs ${source}: ${error.message}`);\n}\n\n/** Which of these external ids a founder already has as voice samples. */\nexport async function knownWriting(founderId: string, platform: string, ids: string[]): Promise<Set<string>> {\n  if (!ids.length) return new Set();\n  const { data } = await admin().from(\"voice_samples\").select(\"external_id\").eq(\"founder_id\", founderId).eq(\"platform\", platform).in(\"external_id\", ids);\n  return new Set((data ?? []).map((r) => r.external_id as string));\n}\n\n/** Stores new candidates; skips ones the founder already has (same id or same text). Returns how many were new. */\nexport async function addCandidates(founderId: string, projectId: string | null, source: \"own_writing\" | \"github\" | \"hearback\", items: OwnWriting[]): Promise<number> {\n  const rows = [];\n  const seen = new Set<string>();\n  for (const w of items) {\n    const text = w.text.trim().slice(0, MAX_TEXT);\n    if (!text) continue;\n    const sha = await textSha(text);\n    const key = `${w.platform}:${w.external_id}`;\n    if (seen.has(sha) || seen.has(key)) continue;\n    seen.add(sha); seen.add(key);\n    rows.push({\n      founder_id: founderId, project_id: projectId, platform: w.platform, source, external_id: w.external_id,\n      source_url: w.url, text, context: w.context?.slice(0, 1000) ?? null, posted_at: w.posted_at, text_sha256: sha,\n    });\n  }\n  if (!rows.length) return 0;\n  const db = admin();\n  const fresh = [];\n  for (let i = 0; i < rows.length; i += 100) {\n    const part = rows.slice(i, i + 100);\n    const [{ data: byId }, { data: bySha }] = await Promise.all([\n      db.from(\"voice_samples\").select(\"platform, external_id\").eq(\"founder_id\", founderId).in(\"external_id\", part.map((r) => r.external_id)),\n      db.from(\"voice_samples\").select(\"text_sha256\").eq(\"founder_id\", founderId).in(\"text_sha256\", part.map((r) => r.text_sha256)),\n    ]);\n    const ids = new Set((byId ?? []).map((r) => `${r.platform}:${r.external_id}`));\n    const shas = new Set((bySha ?? []).map((r) => r.text_sha256));\n    fresh.push(...part.filter((r) => !ids.has(`${r.platform}:${r.external_id}`) && !shas.has(r.text_sha256)));\n  }\n  if (!fresh.length) return 0;\n  const { error } = await db.from(\"voice_samples\").upsert(fresh, { onConflict: \"founder_id,platform,external_id\", ignoreDuplicates: true });\n  if (error) throw error;\n  return fresh.length;\n}\n\n/** Replies she posted through Hearback that have no sample yet (the trigger covers new ones; this backfills). */\nasync function backfillPosted(projectId: string): Promise<number> {\n  const { data, error } = await admin().from(\"drafts\")\n    .select(\"id, final_text, posted_at, posted_url, posted_by, decided_by, items!inner(project_id, platform, text)\")\n    .eq(\"items.project_id\", projectId).in(\"outcome\", [\"posted_as_is\", \"posted_edited\"]).not(\"final_text\", \"is\", null).limit(500);\n  if (error) throw error;\n  let n = 0;\n  const byFounder = new Map<string, OwnWriting[]>();\n  for (const d of data ?? []) {\n    const f = (d.posted_by ?? d.decided_by) as string | null;\n    if (!f) continue;\n    // deno-lint-ignore no-explicit-any\n","exit_code":0,"status":"completed"}}
