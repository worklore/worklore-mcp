{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/zsh -lc \"nl -ba supabase/migrations/20261015010000_ask_code_model_calls.sql | sed -n '15,82p'; nl -ba supabase/migrations/20261010040000_normal_forms.sql | sed -n '15,75p'\"","aggregated_output":"    15\tcreate table model_calls (\n    16\t  id bigint generated always as identity primary key,\n    17\t  at timestamptz not null default now(),\n    18\t  fn text,                     -- the edge function (draft, triage, ask-code, …)\n    19\t  purpose text not null,       -- draft / resolve / points / triage_summary / decide / discover_why / landing / ask_code\n    20\t  project_id uuid references projects(id) on delete set null,\n    21\t  founder_id uuid,             -- the signed-in founder (no FK: a log row must never fail to insert)\n    22\t  item_id uuid references items(id) on delete set null,\n    23\t  run_id uuid,                 -- the steps of one multi-step run (code_questions.id)\n    24\t  provider text not null,\n    25\t  model text not null,\n    26\t  ok boolean not null,\n    27\t  error text,\n    28\t  tokens_in int,               -- all prompt tokens (uncached + cache reads + cache writes)\n    29\t  tokens_out int,\n    30\t  usage jsonb,                 -- {input, output, cache_read, cache_write, cost_usd}\n    31\t  cost_usd numeric(12, 6),     -- list price (pricing.ts); null: unknown or free (Gemini free key)\n    32\t  latency_ms int\n    33\t);\n    34\tcreate index model_calls_at on model_calls (at desc);\n    35\tcreate index model_calls_project on model_calls (project_id, at desc);\n    36\tcreate index model_calls_run on model_calls (run_id) where run_id is not null;\n    37\talter table model_calls enable row level security;  -- no policies: service role only\n    38\trevoke all on model_calls from anon, authenticated;\n    39\t\n    40\tinsert into model_calls (at, fn, purpose, project_id, item_id, provider, model, ok, tokens_in, tokens_out, usage, cost_usd, latency_ms)\n    41\tselect d.created_at, 'backfill', 'draft', i.project_id, d.item_id, d.provider, d.model, true,\n    42\t       d.tokens_in, d.tokens_out, d.tokens, nullif(d.tokens->>'cost_usd', '')::numeric, d.latency_ms\n    43\tfrom drafts d join items i on i.id = d.item_id;\n    44\t\n    45\tcreate view model_spend_daily with (security_invoker = true) as\n    46\tselect (at at time zone 'utc')::date as day, purpose, provider, model,\n    47\t       count(*) as calls,\n    48\t       count(*) filter (where not ok) as failed,\n    49\t       sum(tokens_in) as tokens_in,\n    50\t       sum(tokens_out) as tokens_out,\n    51\t       round(sum(coalesce(cost_usd, 0)), 4) as cost_usd\n    52\tfrom model_calls\n    53\tgroup by 1, 2, 3, 4;\n    54\trevoke all on model_spend_daily from anon, authenticated;\n    55\t\n    56\tcreate table code_questions (\n    57\t  id uuid primary key default gen_random_uuid(),\n    58\t  project_id uuid not null references projects(id) on delete cascade,\n    59\t  item_id uuid references items(id) on delete set null,\n    60\t  asked_by uuid references founders(id) on delete set null,\n    61\t  question text not null check (length(question) between 3 and 2000),\n    62\t  check_question text,         -- the [check: …] gap it answers, if any\n    63\t  repo text not null,\n    64\t  commit_sha text,             -- the code the answer was read at\n    65\t  status text not null default 'running' check (status in ('running', 'answered', 'failed', 'waiting_local')),\n    66\t  answered_by text not null default 'cloud' check (answered_by in ('cloud', 'local')),\n    67\t  answer text,\n    68\t  details text,\n    69\t  sources jsonb not null default '[]',   -- [{path, start_line, end_line, note, url}]\n    70\t  confidence text check (confidence in ('high', 'medium', 'low')),\n    71\t  model text,\n    72\t  steps int,\n    73\t  usage jsonb,                 -- run totals: {input, output, cache_read, cache_write, cost_usd, tool_calls, github_requests}\n    74\t  cost_usd numeric(12, 6),\n    75\t  error text,\n    76\t  created_at timestamptz not null default now(),\n    77\t  answered_at timestamptz,\n    78\t  used_at timestamptz          -- she used the answer (it was saved to the project's knowledge)\n    79\t);\n    80\tcreate index code_questions_item on code_questions (item_id, created_at desc);\n    81\tcreate index code_questions_project on code_questions (project_id, created_at desc);\n    82\talter table code_questions enable row level security;\n    15\t--   * source_syncs.source ('devto:writing:<handle>', 'github:<repo>'): an\n    16\t--     opaque key the app shows and parses; the database only compares it;\n    17\t--   * voice_samples.text_sha256: the server dedupes on it before inserting,\n    18\t--     with JavaScript's whitespace rule; a generated column could disagree;\n    19\t--   * themes.position vs project_memory kind 'position': both unused so far.\n    20\t\n    21\tset search_path = public, extensions;\n    22\t\n    23\t-- ------------------------------------------------------------------ 3NF: project_id copies\n    24\t-- Parents expose (id, project_id[, …]) so children can reference the pair.\n    25\talter table people   add constraint people_id_project unique (id, project_id);\n    26\talter table accounts add constraint accounts_id_project_platform unique (id, project_id, platform);\n    27\talter table items    add constraint items_id_project unique (id, project_id),\n    28\t                     add constraint items_id_project_person unique (id, project_id, person_id);\n    29\talter table documents add constraint documents_id_project unique (id, project_id);\n    30\talter table ideas    add constraint ideas_id_project unique (id, project_id);\n    31\talter table themes   add constraint themes_id_project unique (id, project_id);\n    32\t\n    33\t-- An item's person and account are in the item's project; the account is on\n    34\t-- the item's platform. (Discover items have no account: MATCH SIMPLE skips it.)\n    35\talter table items\n    36\t  drop constraint items_person_id_fkey,\n    37\t  add constraint items_person_fkey foreign key (person_id, project_id) references people (id, project_id) on delete cascade,\n    38\t  drop constraint items_account_id_fkey,\n    39\t  add constraint items_account_fkey foreign key (account_id, project_id, platform)\n    40\t    references accounts (id, project_id, platform) on delete cascade;\n    41\t\n    42\talter table identities\n    43\t  drop constraint identities_person_id_fkey,\n    44\t  add constraint identities_person_fkey foreign key (person_id, project_id) references people (id, project_id) on delete cascade;\n    45\t\n    46\t-- A touch about an item is with that item's person; if the item moves to\n    47\t-- another person (people merged), its touches follow.\n    48\talter table touches\n    49\t  drop constraint touches_person_id_fkey,\n    50\t  add constraint touches_person_fkey foreign key (person_id, project_id) references people (id, project_id) on delete cascade,\n    51\t  drop constraint touches_item_id_fkey,\n    52\t  add constraint touches_item_fkey foreign key (item_id, project_id, person_id)\n    53\t    references items (id, project_id, person_id) on delete cascade on update cascade;\n    54\t\n    55\talter table document_chunks\n    56\t  drop constraint document_chunks_document_id_fkey,\n    57\t  add constraint document_chunks_document_fkey foreign key (document_id, project_id) references documents (id, project_id) on delete cascade;\n    58\t\n    59\talter table idea_items\n    60\t  drop constraint idea_items_idea_id_fkey,\n    61\t  add constraint idea_items_idea_fkey foreign key (idea_id, project_id) references ideas (id, project_id) on delete cascade,\n    62\t  drop constraint idea_items_item_id_fkey,\n    63\t  add constraint idea_items_item_fkey foreign key (item_id, project_id) references items (id, project_id) on delete cascade;\n    64\t\n    65\t-- A theme from another project can't be attached.\n    66\talter table documents\n    67\t  drop constraint documents_theme_id_fkey,\n    68\t  add constraint documents_theme_fkey foreign key (theme_id, project_id) references themes (id, project_id) on delete set null (theme_id);\n    69\talter table project_memory\n    70\t  drop constraint project_memory_theme_id_fkey,\n    71\t  add constraint project_memory_theme_fkey foreign key (theme_id, project_id) references themes (id, project_id) on delete cascade;\n    72\t\n    73\t-- ------------------------------------------------------------------ 2NF: idea_items.person_id\n    74\t-- idea_items is keyed by (idea_id, item_id), but person_id depended on item_id\n    75\t-- alone (it is items.person_id). Who asked is now read through the item.\n","exit_code":0,"status":"completed"}}
