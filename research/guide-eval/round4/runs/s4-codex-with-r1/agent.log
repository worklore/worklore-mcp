{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,125p' supabase/functions/_shared/server/usage.ts; sed -n '120,195p' supabase/functions/_shared/askcode/agent.ts; sed -n '100,160p' supabase/functions/_shared/core/sources/run.ts; rg -n 'quality:|scores:|quality =|scores =' supabase/functions/_shared/core/sources\"","aggregated_output":"// Every model call, logged (model_calls): which function and purpose, which\n// project, the model, tokens and cost at list price (pricing.ts). Spend is\n// read with SQL over model_calls / model_spend_daily (docs/API.md › Spend).\n//\n// The function, project and item travel in a per-request scope, so a call\n// deep in the engine is tagged without passing ids around: serve() opens the\n// scope with the function's name, a handler adds the project once it knows\n// it (tagUsage). Work handed to background() keeps the scope it started in.\n// Logging never fails the call it logs.\n\nimport { AsyncLocalStorage } from \"node:async_hooks\";\nimport { admin } from \"./ctx.ts\";\n\nexport interface UsageScope {\n  fn?: string;\n  project_id?: string | null;\n  founder_id?: string | null;\n  item_id?: string | null;\n  /** Groups the calls of one multi-step run (an ask-code agent run). */\n  run_id?: string | null;\n}\n\nconst scope = new AsyncLocalStorage<UsageScope>();\n\n/** Runs [f] with a fresh scope (serve() does this per request). */\nexport function withUsage<T>(s: UsageScope, f: () => T): T {\n  return scope.run({ ...s }, f);\n}\n\n/** Adds what the handler learned (project, item) to the current scope. */\nexport function tagUsage(s: UsageScope) {\n  const cur = scope.getStore();\n  if (cur) Object.assign(cur, s);\n}\n\nexport const currentUsage = (): UsageScope => ({ ...(scope.getStore() ?? {}) });\n\nexport interface ModelCall {\n  purpose: string;\n  provider: string;\n  model: string;\n  ok: boolean;\n  error?: string | null;\n  tokens_in?: number | null;\n  tokens_out?: number | null;\n  usage?: Record<string, unknown> | null;\n  cost_usd?: number | null;\n  latency_ms?: number | null;\n}\n\n/** Pure: the model_calls row for a call in a scope. */\nexport function modelCallRow(c: ModelCall, s: UsageScope) {\n  return {\n    fn: s.fn ?? null,\n    purpose: c.purpose,\n    project_id: s.project_id ?? null,\n    founder_id: s.founder_id ?? null,\n    item_id: s.item_id ?? null,\n    run_id: s.run_id ?? null,\n    provider: c.provider,\n    model: c.model,\n    ok: c.ok,\n    error: c.error ? c.error.slice(0, 300) : null,\n    tokens_in: c.tokens_in ?? null,\n    tokens_out: c.tokens_out ?? null,\n    usage: c.usage ?? null,\n    cost_usd: c.cost_usd ?? null,\n    latency_ms: c.latency_ms ?? null,\n  };\n}\n\n/** Test seam: where rows go. */\nexport let sinkModelCall = async (row: ReturnType<typeof modelCallRow>) => {\n  const { error } = await admin().from(\"model_calls\").insert(row);\n  if (error) throw error;\n};\nexport function setModelCallSink(f: typeof sinkModelCall) { sinkModelCall = f; }\n\n/** Logs one call; a failed insert is a console line, never an error. */\nexport async function logModelCall(c: ModelCall, s: UsageScope = currentUsage()): Promise<void> {\n  try {\n    await sinkModelCall(modelCallRow(c, s));\n  } catch (e) {\n    console.error(\"model_calls insert failed:\", (e as Error).message?.slice(0, 160));\n  }\n}\n      const a = Number(s.start_line) || null, b = Number(s.end_line) || null;\n      return { path, start_line: a, end_line: b, note: typeof s.note === \"string\" ? s.note : null, url: blobUrl(repo, sha, path, a, b) };\n    });\n  return {\n    answer: String(raw.answer ?? \"\").trim(),\n    details: typeof raw.details === \"string\" && raw.details.trim() ? raw.details.trim() : null,\n    sources,\n    confidence: conf,\n  };\n}\n\nexport async function askCode(input: AskInput, tools: RepoTools, opts: AgentOptions): Promise<AskRun> {\n  const now = opts.now ?? Date.now;\n  const t0 = now();\n  const maxSteps = opts.maxSteps ?? 12;\n  const deadline = t0 + (opts.deadlineMs ?? 120_000);\n  const maxUsd = opts.maxUsd ?? 1;\n  const total = { input: 0, output: 0, cache_read: 0, cache_write: 0, cost_usd: 0 };\n  const messages: Message[] = [{ role: \"user\", content: firstTurn(input) }];\n  let toolCalls = 0;\n  let toldToStop = false;\n\n  for (let step = 1; step <= maxSteps + 1; step++) {\n    const body = {\n      model: opts.model,\n      max_tokens: 16000,\n      system: [{ type: \"text\", text: systemPrompt(tools.repo, tools.sha) }],\n      tools: [...REPO_TOOLS, ANSWER_TOOL],\n      messages: withCacheBreakpoint(messages),\n      thinking: { type: \"adaptive\" },\n      output_config: { effort: opts.effort ?? \"medium\" },\n    };\n    const s0 = now();\n    let res: Record<string, unknown>;\n    try {\n      res = await opts.send(body);\n    } catch (e) {\n      await opts.onStep?.({ model: opts.model, input: 0, output: 0, cache_read: 0, cache_write: 0, cost_usd: null, latency_ms: now() - s0, ok: false, error: (e as Error).message });\n      throw e;\n    }\n    const u = (res.usage ?? {}) as Record<string, number>;\n    const usage = { input: u.input_tokens ?? 0, output: u.output_tokens ?? 0, cache_read: u.cache_read_input_tokens ?? 0, cache_write: u.cache_creation_input_tokens ?? 0 };\n    const model = String(res.model ?? opts.model);\n    const cost = costUsd(model, usage) ?? null;\n    for (const k of [\"input\", \"output\", \"cache_read\", \"cache_write\"] as const) total[k] += usage[k];\n    total.cost_usd += cost ?? 0;\n    await opts.onStep?.({ model, ...usage, cost_usd: cost, latency_ms: now() - s0, ok: true });\n\n    const content = (res.content ?? []) as Block[];\n    const finish = (a: AskAnswer): AskRun => ({\n      ...a, model, steps: step, tool_calls: toolCalls, github_requests: tools.requests,\n      usage: { ...total, cost_usd: Math.round(total.cost_usd * 1e6) / 1e6 },\n    });\n    const answer = content.find((b) => b.type === \"tool_use\" && b.name === \"answer\");\n    if (answer) return finish(parseAnswer(answer.input as Record<string, unknown>, tools.repo, tools.sha));\n    const uses = content.filter((b) => b.type === \"tool_use\");\n    if (!uses.length || res.stop_reason !== \"tool_use\") {\n      const text = content.filter((b) => b.type === \"text\").map((b) => String(b.text)).join(\"\").trim();\n      if (res.stop_reason === \"refusal\") throw new Error(\"the model declined to answer\");\n      if (!text) throw new Error(`no answer (stop_reason=${res.stop_reason ?? \"?\"})`);\n      return finish(parseAnswer(text, tools.repo, tools.sha));\n    }\n\n    messages.push({ role: \"assistant\", content });\n    const results: Block[] = [];\n    for (const b of uses) {\n      toolCalls++;\n      const out = await tools.run(String(b.name), (b.input ?? {}) as Record<string, unknown>);\n      results.push({ type: \"tool_result\", tool_use_id: b.id, content: out.slice(0, 40_000) });\n    }\n    const overSteps = step >= maxSteps;\n    const overTime = now() > deadline - 25_000;\n    const overCost = total.cost_usd >= maxUsd;\n    if ((overSteps || overTime || overCost) && !toldToStop) {\n      toldToStop = true;\n      results.push({ type: \"text\", text: \"Stop searching now: call `answer` with what you found. If it isn't enough, say what is still unknown and set confidence low.\" });\nasync function backfillPosted(projectId: string): Promise<number> {\n  const { data, error } = await admin().from(\"drafts\")\n    .select(\"id, final_text, posted_at, posted_url, posted_by, decided_by, items!inner(project_id, platform, text)\")\n    .eq(\"items.project_id\", projectId).in(\"outcome\", [\"posted_as_is\", \"posted_edited\"]).not(\"final_text\", \"is\", null).limit(500);\n  if (error) throw error;\n  let n = 0;\n  const byFounder = new Map<string, OwnWriting[]>();\n  for (const d of data ?? []) {\n    const f = (d.posted_by ?? d.decided_by) as string | null;\n    if (!f) continue;\n    // deno-lint-ignore no-explicit-any\n    const it = d.items as any;\n    byFounder.set(f, [...(byFounder.get(f) ?? []), {\n      platform: it.platform, external_id: `draft:${d.id}`, url: d.posted_url, text: d.final_text, posted_at: d.posted_at,\n      context: String(it.text ?? \"\").slice(0, 600),\n    }]);\n  }\n  for (const [f, items] of byFounder) n += await addCandidates(f, projectId, \"hearback\", items);\n  return n;\n}\n\n/** Judges up to `limit` pending candidates (optionally only these founders') until the deadline; refreshes active sets. */\nexport async function judgePending(opts: { founderIds?: string[]; limit?: number; deadline: number }) {\n  let q = admin().from(\"voice_samples\").select(\"id, founder_id, platform, text, context\").eq(\"status\", \"candidate\")\n    .order(\"created_at\", { ascending: true }).limit(opts.limit ?? 40);\n  if (opts.founderIds?.length) q = q.in(\"founder_id\", opts.founderIds);\n  const { data, error } = await q;\n  if (error) throw error;\n  const d = decider();\n  let judged = 0, accepted = 0, rejected = 0;\n  const touched = new Set<string>();\n  for (const c of data ?? []) {\n    if (Date.now() > opts.deadline) break;\n    try {\n      const v = await judgeCandidate(d, { text: c.text, context: c.context, platform: c.platform });\n      await admin().from(\"voice_samples\").update({\n        status: v.status, reason: v.reason, quality: v.quality, scores: v.scores, decided_at: new Date().toISOString(), updated_at: new Date().toISOString(),\n      }).eq(\"id\", c.id);\n      judged++;\n      if (v.status === \"accepted\") accepted++; else rejected++;\n      touched.add(c.founder_id);\n    } catch (e) {\n      console.error(`judge ${c.id}: ${(e as Error).message.slice(0, 200)}`);\n      break; // the decider is down; the next run retries\n    }\n  }\n  const active: Record<string, number> = {};\n  for (const f of touched) active[f] = await refreshActive(f);\n  let pq = admin().from(\"voice_samples\").select(\"id\", { count: \"exact\", head: true }).eq(\"status\", \"candidate\");\n  if (opts.founderIds?.length) pq = pq.in(\"founder_id\", opts.founderIds);\n  const { count } = await pq;\n  return { judged, accepted, rejected, pending: count ?? 0, active };\n}\n\n/** Recomputes a founder's active set (selectActive over her accepted samples). Returns its size. */\nexport async function refreshActive(founderId: string): Promise<number> {\n  const db = admin();\n  const { data, error } = await db.from(\"voice_samples\").select(\"id, text, platform, source, quality, posted_at, active\")\n    .eq(\"founder_id\", founderId).eq(\"status\", \"accepted\");\n  if (error) throw error;\n  const chosen = new Set(selectActive(data ?? []));\nsupabase/functions/_shared/core/sources/run.ts:136:        status: v.status, reason: v.reason, quality: v.quality, scores: v.scores, decided_at: new Date().toISOString(), updated_at: new Date().toISOString(),\nsupabase/functions/_shared/core/sources/sources_test.ts:27:function fakeDecider(pMeaningful: number, quality: number) {\nsupabase/functions/_shared/core/sources/sources_test.ts:36:          quality: { answer: quality, probabilities: {}, confidence: 0.8 },\nsupabase/functions/_shared/core/sources/sources_test.ts:117:    id, text: Array.from({ length: words }, (_, i) => `${id}w${i}`).join(\" \"), platform: \"devto\", source: \"own_writing\", quality: q,\nsupabase/functions/_shared/core/sources/voice.ts:65:    quality: {\nsupabase/functions/_shared/core/sources/voice.ts:88:  quality: number | null;\nsupabase/functions/_shared/core/sources/voice.ts:89:  scores: Record<string, unknown> | null;\nsupabase/functions/_shared/core/sources/voice.ts:96:  const quality = Math.round(Number(q?.answer ?? 0) * 100) / 100;\nsupabase/functions/_shared/core/sources/voice.ts:97:  const scores = { p_meaningful: pMeaningful, quality, decider: d.decider, model: d.model };\nsupabase/functions/_shared/core/sources/voice.ts:106:  if (rule) return { status: \"rejected\", reason: `rule: ${rule}`, quality: 0, scores: null };\nsupabase/functions/_shared/core/sources/voice.ts:120:  quality: number | null;\n","exit_code":0,"status":"completed"}}
