{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,250p' supabase/migrations/20261010040000_normal_forms.sql\"","aggregated_output":"-- Normal forms, 2026-10-10. The schema checked against 1NF–3NF (Codd 1970/71),\n-- BCNF and 4NF/5NF (Fagin 1977/79); in Kent's words (CACM 26(2), 1983), every\n-- non-key field is a fact about the key, the whole key, and nothing but the key.\n--\n-- Mixed approach, not textbook 3NF:\n--   * redundancy that buys nothing is removed, or computed by Postgres\n--     (generated columns, triggers) so it can't drift;\n--   * the project_id copies on child tables stay (RLS policies and the hot\n--     indexes filter on them), but composite foreign keys now make a copy that\n--     disagrees with its parent impossible.\n-- Every constraint below was checked against the live data first (no\n-- violations). Left as they are, on purpose:\n--   * ideas.github_issue_url: holds either the issue's URL or a pre-filled\n--     github.com \"new issue\" link (app), so it isn't derivable from repo + number;\n--   * source_syncs.source ('devto:writing:<handle>', 'github:<repo>'): an\n--     opaque key the app shows and parses; the database only compares it;\n--   * voice_samples.text_sha256: the server dedupes on it before inserting,\n--     with JavaScript's whitespace rule; a generated column could disagree;\n--   * themes.position vs project_memory kind 'position': both unused so far.\n\nset search_path = public, extensions;\n\n-- ------------------------------------------------------------------ 3NF: project_id copies\n-- Parents expose (id, project_id[, …]) so children can reference the pair.\nalter table people   add constraint people_id_project unique (id, project_id);\nalter table accounts add constraint accounts_id_project_platform unique (id, project_id, platform);\nalter table items    add constraint items_id_project unique (id, project_id),\n                     add constraint items_id_project_person unique (id, project_id, person_id);\nalter table documents add constraint documents_id_project unique (id, project_id);\nalter table ideas    add constraint ideas_id_project unique (id, project_id);\nalter table themes   add constraint themes_id_project unique (id, project_id);\n\n-- An item's person and account are in the item's project; the account is on\n-- the item's platform. (Discover items have no account: MATCH SIMPLE skips it.)\nalter table items\n  drop constraint items_person_id_fkey,\n  add constraint items_person_fkey foreign key (person_id, project_id) references people (id, project_id) on delete cascade,\n  drop constraint items_account_id_fkey,\n  add constraint items_account_fkey foreign key (account_id, project_id, platform)\n    references accounts (id, project_id, platform) on delete cascade;\n\nalter table identities\n  drop constraint identities_person_id_fkey,\n  add constraint identities_person_fkey foreign key (person_id, project_id) references people (id, project_id) on delete cascade;\n\n-- A touch about an item is with that item's person; if the item moves to\n-- another person (people merged), its touches follow.\nalter table touches\n  drop constraint touches_person_id_fkey,\n  add constraint touches_person_fkey foreign key (person_id, project_id) references people (id, project_id) on delete cascade,\n  drop constraint touches_item_id_fkey,\n  add constraint touches_item_fkey foreign key (item_id, project_id, person_id)\n    references items (id, project_id, person_id) on delete cascade on update cascade;\n\nalter table document_chunks\n  drop constraint document_chunks_document_id_fkey,\n  add constraint document_chunks_document_fkey foreign key (document_id, project_id) references documents (id, project_id) on delete cascade;\n\nalter table idea_items\n  drop constraint idea_items_idea_id_fkey,\n  add constraint idea_items_idea_fkey foreign key (idea_id, project_id) references ideas (id, project_id) on delete cascade,\n  drop constraint idea_items_item_id_fkey,\n  add constraint idea_items_item_fkey foreign key (item_id, project_id) references items (id, project_id) on delete cascade;\n\n-- A theme from another project can't be attached.\nalter table documents\n  drop constraint documents_theme_id_fkey,\n  add constraint documents_theme_fkey foreign key (theme_id, project_id) references themes (id, project_id) on delete set null (theme_id);\nalter table project_memory\n  drop constraint project_memory_theme_id_fkey,\n  add constraint project_memory_theme_fkey foreign key (theme_id, project_id) references themes (id, project_id) on delete cascade;\n\n-- ------------------------------------------------------------------ 2NF: idea_items.person_id\n-- idea_items is keyed by (idea_id, item_id), but person_id depended on item_id\n-- alone (it is items.person_id). Who asked is now read through the item.\ncreate or replace function ideas_recount() returns trigger language plpgsql security definer set search_path = public as $$\ndeclare x uuid := coalesce(new.idea_id, old.idea_id);\nbegin\n  update ideas set asked_by = (\n      select count(distinct i.person_id) from idea_items ii join items i on i.id = ii.item_id where ii.idea_id = x),\n    updated_at = now()\n  where id = x;\n  return null;\nend $$;\n\n-- asked_by stays a cached count: recount when an item changes hands.\ncreate function items_person_recount() returns trigger language plpgsql security definer set search_path = public as $$\nbegin\n  update ideas d set asked_by = (\n      select count(distinct i.person_id) from idea_items ii join items i on i.id = ii.item_id where ii.idea_id = d.id)\n  where d.id in (select idea_id from idea_items where item_id = new.id);\n  return null;\nend $$;\ncreate trigger items_person_recount after update of person_id on items\n  for each row when (old.person_id is distinct from new.person_id) execute function items_person_recount();\nrevoke execute on function items_person_recount() from public, anon, authenticated;\n\n-- The inbox view read idea_items.person_id; same columns, through items.\ncreate or replace view inbox_by_person with (security_invoker = true) as\nwith w as (\n  select i.*, row_number() over (partition by i.person_id order by i.posted_at desc) rn\n  from items i\n  where i.origin = 'inbox' and i.status in ('new', 'draft_ready')\n)\nselect\n  w.project_id, w.person_id, p.display_name, p.avatar_url, p.stage,\n  count(*)::int as waiting,\n  count(*) filter (where w.status = 'new')::int as needs_you,\n  count(*) filter (where w.status = 'draft_ready')::int as draft_ready,\n  array_agg(distinct w.platform::text) as platforms,\n  max(w.id::text) filter (where w.rn = 1)::uuid as last_item_id,\n  max(w.text) filter (where w.rn = 1) as last_item_text,\n  max(w.kind::text) filter (where w.rn = 1) as last_item_kind,\n  max(w.platform::text) filter (where w.rn = 1) as last_item_platform,\n  max(w.posted_at) as last_posted_at,\n  max(w.status::text) filter (where w.rn = 1) as last_status,\n  (select d.text from drafts d where d.item_id = max(w.id::text) filter (where w.rn = 1)::uuid and d.outcome is null\n     order by d.version desc limit 1) as last_draft_text,\n  exists (select 1 from idea_items ii join items ai on ai.id = ii.item_id where ai.person_id = w.person_id) as has_idea\nfrom w join people p on p.id = w.person_id\ngroup by w.project_id, w.person_id, p.display_name, p.avatar_url, p.stage;\n\nalter table idea_items drop column person_id;\n\n-- ------------------------------------------------------------------ 3NF: document_chunks\n-- kind, source_url, source_ref and label were copies of the chunk's document\n-- (written from it in knowledge.ts; identical on every live row). They live on\n-- documents only. published_at / published_precision stay per chunk (a section\n-- is as new as its newest line), and so does lang.\nalter table documents add constraint documents_kind_check\n  check (kind in ('article', 'story', 'research', 'changelog', 'readme', 'faq', 'fact', 'page'));\n\n-- is_public was label = 'quotable' written twice; Postgres computes it now.\nalter table documents drop column is_public;\nalter table documents add column is_public boolean generated always as (label = 'quotable') stored;\n\n-- Same signature and result as before; the document's fields come through the join.\ncreate or replace function match_document_chunks(\n  p_project uuid,\n  p_query vector(768),\n  p_before timestamptz default now(),\n  p_count int default 40,\n  p_kinds text[] default null,\n  p_min_similarity float default 0.68,\n  p_labels text[] default array['quotable']\n) returns table (\n  id uuid, kind text, title text, source_url text, source_ref text,\n  published_at timestamptz, published_precision text, content text, tokens int, lang text,\n  similarity float, embedding vector(768), label text\n)\nlanguage sql stable security invoker\nset search_path = public, extensions\nset hnsw.ef_search = 100\nset hnsw.iterative_scan = relaxed_order\nas $$\n  select c.id, d.kind, c.title,\n         case when d.label = 'quotable' then d.url end as source_url,\n         case when d.label <> 'quotable' then coalesce(d.source_ref, d.url) end as source_ref,\n         c.published_at, c.published_precision, c.content, c.tokens, c.lang,\n         1 - (c.embedding <=> p_query) as similarity, c.embedding, d.label\n  from document_chunks c\n  join documents d on d.id = c.document_id\n  where c.project_id = p_project\n    and c.embedding is not null\n    and (p_kinds is null or d.kind = any (p_kinds))\n    and d.label = any (p_labels)\n    and case c.published_precision\n          when 'day' then (c.published_at at time zone 'utc')::date < (p_before at time zone 'utc')::date\n          else c.published_at < p_before\n        end\n    and 1 - (c.embedding <=> p_query) >= p_min_similarity\n  order by c.embedding <=> p_query\n  limit greatest(1, least(p_count, 200));\n$$;\n\nalter table document_chunks drop column kind, drop column source_url, drop column source_ref, drop column label;\n\n-- ------------------------------------------------------------------ 3NF: drafts.tokens_in / tokens_out\n-- The totals are functions of the usage breakdown in drafts.tokens (Anthropic's\n-- input excludes cache reads and writes; the total includes them). Drafts that\n-- only had totals (Gemini) get them as the breakdown, then Postgres computes\n-- the totals.\nupdate drafts set tokens = jsonb_build_object('input', tokens_in, 'output', tokens_out)\n  where tokens is null and (tokens_in is not null or tokens_out is not null);\n\ndo $$ begin\n  if exists (select 1 from drafts where\n      tokens_in is distinct from (tokens->>'input')::int + coalesce((tokens->>'cache_read')::int, 0) + coalesce((tokens->>'cache_write')::int, 0)\n      or tokens_out is distinct from (tokens->>'output')::int) then\n    raise exception 'drafts: tokens_in/tokens_out disagree with drafts.tokens; not converting';\n  end if;\nend $$;\n\nalter table drafts drop column tokens_in, drop column tokens_out;\nalter table drafts\n  add column tokens_in int generated always as\n    ((tokens->>'input')::int + coalesce((tokens->>'cache_read')::int, 0) + coalesce((tokens->>'cache_write')::int, 0)) stored,\n  add column tokens_out int generated always as ((tokens->>'output')::int) stored;\n\n-- ------------------------------------------------------------------ derived: people.first/last_touch_at\n-- Kept as a cache of min/max(touches.occurred_at), now by the database for\n-- every writer (the collector did read-then-write; issue touches didn't update\n-- it at all). greatest/least on insert is safe under concurrent inserts.\ncreate function touches_person_span() returns trigger language plpgsql security definer set search_path = public as $$\nbegin\n  if tg_op = 'INSERT' then\n    update people set first_touch_at = least(first_touch_at, new.occurred_at),\n                      last_touch_at = greatest(last_touch_at, new.occurred_at)\n    where id = new.person_id\n      and (first_touch_at is null or last_touch_at is null or new.occurred_at < first_touch_at or new.occurred_at > last_touch_at);\n  else\n    update people p set first_touch_at = s.lo, last_touch_at = s.hi\n    from (select x.id, (select min(occurred_at) from touches where person_id = x.id) lo,\n                       (select max(occurred_at) from touches where person_id = x.id) hi\n          from (select old.person_id as id union select new.person_id) x where x.id is not null) s\n    where p.id = s.id;\n  end if;\n  return null;\nend $$;\ncreate trigger touches_person_span after insert or delete or update of person_id, occurred_at on touches\n  for each row execute function touches_person_span();\nrevoke execute on function touches_person_span() from public, anon, authenticated;\n\n-- The decision RPC no longer sets last_touch_at itself: its touch does.\ncreate or replace function record_draft_outcome(\n  p_draft_id uuid,\n  p_outcome draft_outcome,\n  p_final_text text default null,\n  p_posted_url text default null,\n  p_move_stage person_stage default null\n) returns drafts\nlanguage plpgsql security definer set search_path = public as $$\ndeclare\n  d drafts;\n  it items;\n  uid uuid := auth.uid();\n  posted boolean := p_outcome in ('posted_as_is', 'posted_edited');\nbegin\n  if p_outcome not in ('posted_as_is', 'posted_edited', 'skipped') then raise exception 'bad_outcome'; end if;\n  if posted and coalesce(btrim(p_final_text), '') = '' then raise exception 'final_text_required'; end if;\n  select * into d from drafts where id = p_draft_id for update;\n  if not found then raise exception 'not_found'; end if;\n  select * into it from items where id = d.item_id for update;\n  if uid is null or not is_member(it.project_id) then raise exception 'not_found'; end if;\n  if d.outcome is not null then raise exception 'already_decided'; end if;\n\n  update drafts set\n    outcome = p_outcome,\n    final_text = case when posted then p_final_text else final_text end,\n    posted_url = case when posted then p_posted_url else posted_url end,\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc 'cat supabase/migrations/20261014010000_github_board_results.sql supabase/migrations/20261015010000_ask_code_model_calls.sql supabase/migrations/20261010010000_sources_voice_knowledge.sql'","aggregated_output":"-- GitHub Projects board + what happened to an idea's issue.\n-- docs/ARCHITECTURE.md › GitHub App, docs/API.md › Changes 2026-10-14.\n--\n-- A project may link one organization board (Projects v2). Hearback only\n-- reads it: the duplicate check looks at its items (any repo, drafts too) and\n-- the results sweep reads an issue's Status there. Needs the app's\n-- \"Organization permissions › Projects: read-only\".\n--\n-- The sweep (function github-results, every 20 min) notices an idea's issue\n-- closing as completed (or its board Status reaching Done), reads the result\n-- (closing PRs, the last maintainer comment, its links) and drafts a follow-up\n-- reply to everyone who asked. Nothing is posted without her tap.\n\n-- ------------------------------------------------------------------ projects › board\n-- owner + number is the board's address (github.com/orgs/<owner>/projects/<number>);\n-- id is its GraphQL node id; title is GitHub's, cached for display.\nalter table projects\n  add column github_board_owner text check (github_board_owner is null or github_board_owner ~ '^[A-Za-z0-9-]+$'),\n  add column github_board_number int check (github_board_number is null or github_board_number > 0),\n  add column github_board_id text,\n  add column github_board_title text,\n  add constraint projects_github_board_whole check (\n    (github_board_owner is null) = (github_board_number is null)\n    and (github_board_owner is null) = (github_board_id is null));\n\n-- ------------------------------------------------------------------ ideas › issue result\nalter table ideas\n  -- GitHub's view of the issue, as last read.\n  add column github_issue_state text check (github_issue_state in ('open', 'closed')),\n  add column github_issue_state_reason text,          -- completed | not_planned | duplicate | reopened\n  add column github_issue_closed_at timestamptz,\n  add column github_board_status text,                -- the board's Status option, if the issue is on the linked board\n  add column github_checked_at timestamptz,\n  -- What was done, in words she can edit before replies are drafted.\n  add column result_note text,\n  add column result_note_url text,                    -- the comment it came from\n  add column result_links jsonb not null default '[]',-- [{title, url, kind: pr|commit|link}]\n  add column result_drafted_at timestamptz;           -- follow-up drafts were made (once per result)\n\n-- The sweep's queue: ideas with a real issue that are not settled yet.\ncreate index ideas_issue_watch on ideas (github_checked_at nulls first)\n  where github_issue_number is not null and result_drafted_at is null;\n\n-- ------------------------------------------------------------------ drafts › intent\n-- share_result: the follow-up \"what you asked for is done\" reply.\nalter table drafts drop constraint drafts_intent_check;\nalter table drafts add constraint drafts_intent_check\n  check (intent in ('discuss', 'just_answer', 'invite_to_try', 'ask_feedback', 'ask_price', 'share_result', 'auto'));\n\n-- ------------------------------------------------------------------ cron\nselect cron.schedule('hb-github-results', '11-59/20 * * * *', $$select hb_call_function('github-results', '{}')$$);\n-- Ask the code (docs/ARCHITECTURE.md › Ask the code) and the model-call log.\n--\n-- model_calls: every model call the functions make (drafts, resolves,\n-- points, triage summaries, decider, discover, landing reads, ask-code steps)\n-- with tokens and list-price cost. Service role only; read it with SQL or\n-- model_spend_daily. Drafts written before this log are copied in once\n-- (purpose 'draft', fn 'backfill') from drafts.tokens.\n--\n-- code_questions: a question about the project's code (usually a draft's\n-- [check: …] gap) and its answer with cited lines. answered_by 'cloud' is\n-- the ask-code agent; 'local' is kept for a founder's own agent answering\n-- from her machine (backlog). Members read their project's rows; only the\n-- function writes them.\n\ncreate table model_calls (\n  id bigint generated always as identity primary key,\n  at timestamptz not null default now(),\n  fn text,                     -- the edge function (draft, triage, ask-code, …)\n  purpose text not null,       -- draft / resolve / points / triage_summary / decide / discover_why / landing / ask_code\n  project_id uuid references projects(id) on delete set null,\n  founder_id uuid,             -- the signed-in founder (no FK: a log row must never fail to insert)\n  item_id uuid references items(id) on delete set null,\n  run_id uuid,                 -- the steps of one multi-step run (code_questions.id)\n  provider text not null,\n  model text not null,\n  ok boolean not null,\n  error text,\n  tokens_in int,               -- all prompt tokens (uncached + cache reads + cache writes)\n  tokens_out int,\n  usage jsonb,                 -- {input, output, cache_read, cache_write, cost_usd}\n  cost_usd numeric(12, 6),     -- list price (pricing.ts); null: unknown or free (Gemini free key)\n  latency_ms int\n);\ncreate index model_calls_at on model_calls (at desc);\ncreate index model_calls_project on model_calls (project_id, at desc);\ncreate index model_calls_run on model_calls (run_id) where run_id is not null;\nalter table model_calls enable row level security;  -- no policies: service role only\nrevoke all on model_calls from anon, authenticated;\n\ninsert into model_calls (at, fn, purpose, project_id, item_id, provider, model, ok, tokens_in, tokens_out, usage, cost_usd, latency_ms)\nselect d.created_at, 'backfill', 'draft', i.project_id, d.item_id, d.provider, d.model, true,\n       d.tokens_in, d.tokens_out, d.tokens, nullif(d.tokens->>'cost_usd', '')::numeric, d.latency_ms\nfrom drafts d join items i on i.id = d.item_id;\n\ncreate view model_spend_daily with (security_invoker = true) as\nselect (at at time zone 'utc')::date as day, purpose, provider, model,\n       count(*) as calls,\n       count(*) filter (where not ok) as failed,\n       sum(tokens_in) as tokens_in,\n       sum(tokens_out) as tokens_out,\n       round(sum(coalesce(cost_usd, 0)), 4) as cost_usd\nfrom model_calls\ngroup by 1, 2, 3, 4;\nrevoke all on model_spend_daily from anon, authenticated;\n\ncreate table code_questions (\n  id uuid primary key default gen_random_uuid(),\n  project_id uuid not null references projects(id) on delete cascade,\n  item_id uuid references items(id) on delete set null,\n  asked_by uuid references founders(id) on delete set null,\n  question text not null check (length(question) between 3 and 2000),\n  check_question text,         -- the [check: …] gap it answers, if any\n  repo text not null,\n  commit_sha text,             -- the code the answer was read at\n  status text not null default 'running' check (status in ('running', 'answered', 'failed', 'waiting_local')),\n  answered_by text not null default 'cloud' check (answered_by in ('cloud', 'local')),\n  answer text,\n  details text,\n  sources jsonb not null default '[]',   -- [{path, start_line, end_line, note, url}]\n  confidence text check (confidence in ('high', 'medium', 'low')),\n  model text,\n  steps int,\n  usage jsonb,                 -- run totals: {input, output, cache_read, cache_write, cost_usd, tool_calls, github_requests}\n  cost_usd numeric(12, 6),\n  error text,\n  created_at timestamptz not null default now(),\n  answered_at timestamptz,\n  used_at timestamptz          -- she used the answer (it was saved to the project's knowledge)\n);\ncreate index code_questions_item on code_questions (item_id, created_at desc);\ncreate index code_questions_project on code_questions (project_id, created_at desc);\nalter table code_questions enable row level security;\ncreate policy members_read on code_questions for select using (is_member(project_id));\nrevoke insert, update, delete on code_questions from anon, authenticated;\n-- Sources: voice samples and the knowledge base, built by one reproducible\n-- pipeline for every founder (docs/ARCHITECTURE.md › Sources: voice and\n-- knowledge). Nothing per-user is hand-made: connectors bring the founder's\n-- own writing (ownWriting) and published work (publishedWork), GitHub brings\n-- the project's `hearback/` folder, the landing page brings the site; the core\n-- stores, judges (TypeSafe Jev) and selects.\n\n-- ------------------------------------------------------------------ voice samples\n-- Voice is personal: rows belong to a founder, not to a project. project_id\n-- only says where the sample was found.\ncreate table voice_samples (\n  id uuid primary key default gen_random_uuid(),\n  founder_id uuid not null references founders(id) on delete cascade,\n  project_id uuid references projects(id) on delete set null,\n  platform text not null,                 -- connector id (devto, github, …) or the platform a Hearback reply went to\n  source text not null check (source in ('own_writing', 'hearback', 'github')),\n  external_id text not null,              -- platform id: dev.to id_code, 'draft:<uuid>', '<repo>:<path>#<n>'\n  source_url text,\n  text text not null,\n  context text,                           -- what it answered (or the article / file it sits in)\n  posted_at timestamptz,                  -- when she wrote it (real date; evals exclude samples written after an item)\n  text_sha256 text not null,              -- of the whitespace-normalised text: dedupe across sources\n  status text not null default 'candidate' check (status in ('candidate', 'accepted', 'rejected')),\n  reason text,                            -- why rejected / accepted ('rule: emoji_only', 'decider: …')\n  scores jsonb,                           -- decider answers {meaningful, quality, decider, model}\n  quality real,                           -- 0–4 (decider's expected level)\n  active boolean not null default false,  -- in the capped set drafts draw from\n  decided_at timestamptz,\n  created_at timestamptz not null default now(),\n  updated_at timestamptz not null default now(),\n  unique (founder_id, platform, external_id),\n  unique (founder_id, text_sha256)\n);\ncreate index voice_samples_pending on voice_samples (created_at) where status = 'candidate';\ncreate index voice_samples_active on voice_samples (founder_id) where active;\n\nalter table voice_samples enable row level security;\n-- Only the founder herself reads her samples; the server writes them.\ncreate policy self_read on voice_samples for select using (founder_id = auth.uid());\nrevoke insert, update, delete on voice_samples from anon, authenticated;\n\n-- ------------------------------------------------------------------ sync state\n-- One row per project and source: ETags, file SHAs, per-article counts, and\n-- what the app shows (status, message, last sync).\ncreate table source_syncs (\n  id uuid primary key default gen_random_uuid(),\n  project_id uuid not null references projects(id) on delete cascade,\n  source text not null,                   -- 'devto:writing:yahhi', 'devto:articles:yahhi', 'github:owner/repo', 'landing'\n  state jsonb not null default '{}',\n  status text not null default 'ok' check (status in ('ok', 'error', 'needs_auth', 'rate_limited', 'empty')),\n  message text,\n  stats jsonb,\n  last_synced_at timestamptz,\n  unique (project_id, source)\n);\nalter table source_syncs enable row level security;\ncreate policy members_read on source_syncs for select using (is_member(project_id));\nrevoke insert, update, delete on source_syncs from anon, authenticated;\n\n-- ------------------------------------------------------------------ knowledge\n-- Which pipeline source produced a document, and a hash of it so a re-run\n-- skips unchanged documents. 'seed' = written by the one-off seed script and\n-- not (yet) reproduced by the pipeline; kept, still retrieved.\nalter table documents\n  add column source text,\n  add column content_sha256 text,\n  add column label text not null default 'quotable' check (label in ('quotable', 'background'));\ncreate index documents_source on documents (project_id, source);\n\n-- Pages of the product's own site (landing + linked pages).\nalter table document_chunks drop constraint document_chunks_kind_check;\nalter table document_chunks add constraint document_chunks_kind_check\n  check (kind in ('article', 'story', 'research', 'changelog', 'readme', 'faq', 'fact', 'page'));\n\n-- The folder in the linked GitHub repo whose .md/.txt files are synced.\nalter table projects add column github_folder text not null default 'hearback'\n  check (github_folder ~ '^[A-Za-z0-9_. -]+(/[A-Za-z0-9_. -]+)*$' and github_folder !~ '(^|/)\\.\\.(/|$)');\n\n-- ------------------------------------------------------------------ posted replies\n-- A reply she posted through Hearback is the best voice sample: it becomes a\n-- candidate at once; the judge cron decides within minutes.\ncreate or replace function hb_voice_from_draft() returns trigger\nlanguage plpgsql security definer set search_path = public, extensions as $$\ndeclare\n  it record;\n  norm text;\nbegin\n  if new.outcome not in ('posted_as_is', 'posted_edited') or coalesce(trim(new.final_text), '') = '' then return new; end if;\n  if old.outcome is not distinct from new.outcome then return new; end if;\n  select i.project_id, i.platform::text as platform, left(i.text, 600) as text into it from items i where i.id = new.item_id;\n  norm := regexp_replace(trim(new.final_text), '\\s+', ' ', 'g');\n  insert into voice_samples (founder_id, project_id, platform, source, external_id, source_url, text, context, posted_at, text_sha256)\n  values (coalesce(new.posted_by, new.decided_by), it.project_id, it.platform, 'hearback', 'draft:' || new.id, new.posted_url,\n          new.final_text, it.text, coalesce(new.posted_at, now()), encode(digest(norm, 'sha256'), 'hex'))\n  on conflict do nothing;\n  return new;\nexception when others then\n  raise warning 'hb_voice_from_draft: %', sqlerrm;\n  return new;\nend $$;\n\ncreate trigger drafts_voice_sample after update of outcome on drafts\n  for each row when (new.outcome in ('posted_as_is', 'posted_edited'))\n  execute function hb_voice_from_draft();\n\n-- ------------------------------------------------------------------ app summary\n-- What the Project tab shows: the signed-in founder's voice samples, the\n-- project's documents by source, and the last sync per source.\ncreate or replace function source_summary(p_project uuid) returns jsonb\nlanguage sql stable security invoker set search_path = public as $$\n  select jsonb_build_object(\n    'voice', (select jsonb_build_object(\n        'accepted', count(*) filter (where status = 'accepted'),\n        'active', count(*) filter (where active),\n        'candidates', count(*) filter (where status = 'candidate'),\n        'rejected', count(*) filter (where status = 'rejected'))\n      from voice_samples where founder_id = auth.uid()),\n    'knowledge', (select coalesce(jsonb_object_agg(src, n), '{}'::jsonb)\n      from (select coalesce(source, 'other') as src, count(*) as n from documents where project_id = p_project group by 1) s),\n    'syncs', (select coalesce(jsonb_agg(jsonb_build_object('source', source, 'status', status, 'message', message,\n        'last_synced_at', last_synced_at, 'stats', stats) order by source), '[]'::jsonb)\n      from source_syncs where project_id = p_project),\n    'last_synced_at', (select max(last_synced_at) from source_syncs where project_id = p_project),\n    'github', (select jsonb_build_object('repo', github_repo, 'folder', github_folder) from projects where id = p_project)\n  )\n$$;\nrevoke execute on function source_summary(uuid) from public, anon;\ngrant execute on function source_summary(uuid) to authenticated;\n\n-- ------------------------------------------------------------------ schedule\n-- Daily: every project's sources (own writing, articles, GitHub folder, site).\nselect cron.schedule('hb-sources-daily', '17 4 * * *', $$select hb_call_function('sources-sync', '{}')$$);\n-- Every 10 min: judge new candidates (e.g. a reply she just posted) and embed new chunks. A no-op when idle.\nselect cron.schedule('hb-sources-judge', '7-59/10 * * * *', $$select hb_call_function('sources-sync', '{\"phase\": \"judge\"}')$$);\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc 'cat supabase/migrations/20261008230100_knowledge_chunks.sql supabase/migrations/20261008230200_backend_v1.sql'","aggregated_output":"-- Knowledge base for drafts (eval/REPORT-v2.md) and triage results on items\n-- (Yahhi/hearback#5). Was 20261015120000 (draft); applied as part of backend v1.\n-- Change from the draft: every chunk carries a label. 'quotable' = her\n-- published work (may be quoted and linked); 'background' = unpublished\n-- material, context only, never quoted (REPORT-v2: private research leaked\n-- into public drafts).\n--\n-- What drafts know beyond the thread is the founder's published body of work\n-- (articles, stories, research, release notes, README, FAQ), cut into\n-- ~300–600-token chunks, each with a date, a kind and, when public, a URL the\n-- draft may cite. Retrieval per item: the top ~40 chunks by cosine published\n-- BEFORE the item, then MMR + per-source cap in the engine (retrieve.ts).\n--\n-- Requires pgvector >= 0.8 (iterative index scans, so the project filter\n-- doesn't starve the HNSW result).\n\ncreate extension if not exists vector with schema extensions;\nset search_path = public, extensions;\n\n-- ------------------------------------------------------------------ documents\n-- documents (init migration) holds whole sources; it gains what retrieval needs.\nalter table documents\n  add column published_at timestamptz,          -- when it became public (null = unknown → never retrieved)\n  add column published_precision text not null default 'instant'\n    check (published_precision in ('instant', 'day')),\n  add column is_public boolean not null default true, -- false: a private source (e.g. a private repo); never linked in a draft\n  add column source_ref text;                     -- where it came from when there's no public URL\n\n-- ------------------------------------------------------------------ chunks\ncreate table document_chunks (\n  id uuid primary key default gen_random_uuid(),\n  project_id uuid not null references projects(id) on delete cascade,\n  document_id uuid not null references documents(id) on delete cascade,\n  ord int not null,                               -- position in the document\n  kind text not null check (kind in ('article', 'story', 'research', 'changelog', 'readme', 'faq', 'fact')),\n  title text not null,                            -- \"Doc title › Section\"\n  source_url text,                                -- public link a draft may cite; null when not public\n  source_ref text,\n  -- A chunk is as new as its newest line (git blame for files): a README\n  -- section written yesterday is not visible to a comment from last week.\n  published_at timestamptz not null,\n  published_precision text not null default 'instant' check (published_precision in ('instant', 'day')),\n  content text not null,\n  content_sha256 text not null,                   -- skip re-embedding unchanged chunks\n  tokens int not null,\n  lang text not null default 'en',\n  embedding vector(768),                          -- gemini-embedding-001, outputDimensionality 768, L2-normalised\n  embedding_model text,\n  label text not null default 'quotable' check (label in ('quotable', 'background')),\n  created_at timestamptz not null default now(),\n  unique (document_id, ord)\n);\ncreate index document_chunks_project on document_chunks (project_id, published_at);\ncreate index document_chunks_embedding on document_chunks\n  using hnsw (embedding vector_cosine_ops) with (m = 16, ef_construction = 64);\n\nalter table document_chunks enable row level security;\ncreate policy members_all on document_chunks for all\n  using (is_member(project_id)) with check (is_member(project_id));\n\n-- ------------------------------------------------------------------ retrieval\n-- Candidates for one item: published strictly before p_before (a day-precision\n-- chunk only if its day is earlier: a same-day commit may be the answer to the\n-- comment), optionally limited to kinds, nearest first. The engine re-ranks\n-- (MMR, at most 2 per source) and keeps ~6. security invoker: RLS applies, so\n-- a founder only ever retrieves her own projects' chunks.\ncreate function match_document_chunks(\n  p_project uuid,\n  p_query vector(768),\n  p_before timestamptz default now(),\n  p_count int default 40,\n  p_kinds text[] default null,\n  p_min_similarity float default 0.68,\n  p_labels text[] default array['quotable']\n) returns table (\n  id uuid, kind text, title text, source_url text, source_ref text,\n  published_at timestamptz, published_precision text, content text, tokens int, lang text,\n  similarity float, embedding vector(768), label text\n)\nlanguage sql stable security invoker\nset search_path = public, extensions\nset hnsw.ef_search = 100\nset hnsw.iterative_scan = relaxed_order\nas $$\n  select c.id, c.kind, c.title, c.source_url, c.source_ref,\n         c.published_at, c.published_precision, c.content, c.tokens, c.lang,\n         1 - (c.embedding <=> p_query) as similarity, c.embedding, c.label\n  from document_chunks c\n  where c.project_id = p_project\n    and c.embedding is not null\n    and (p_kinds is null or c.kind = any (p_kinds))\n    and c.label = any (p_labels)\n    and case c.published_precision\n          when 'day' then (c.published_at at time zone 'utc')::date < (p_before at time zone 'utc')::date\n          else c.published_at < p_before\n        end\n    and 1 - (c.embedding <=> p_query) >= p_min_similarity\n  order by c.embedding <=> p_query\n  limit greatest(1, least(p_count, 200));\n$$;\n\n-- ------------------------------------------------------------------ triage on items\n-- triage.ts › TriageResult, as the app shows it: kind, route (decide_queue /\n-- draft / short_draft / skip), not_sure, one-line summary, suggested action,\n-- probabilities, and which decider answered (gemini / typesafe + model).\n-- (generated columns for the app: see 20261008230200_backend_v1.sql)\nalter table items\n  add column triage jsonb,\n  add column triage_route text generated always as (triage->>'route') stored;\ncreate index items_triage_route on items (project_id, triage_route, posted_at desc);\n-- Backend v1 (docs/API.md): what the MVP screens need on top of the init\n-- schema. Onboarding (project from a landing page), triage on items, drafts by\n-- intent, ideas from feedback, the draft decision as one transaction, Vault\n-- for Bluesky app passwords, an inbox view grouped by person, realtime.\n\n-- ------------------------------------------------------------------ projects\nalter table projects\n  add column url text,\n  add column description text,\n  add column topics text[] not null default '{}',\n  add column competitors text[] not null default '{}',\n  add column aims text,\n  add column landing jsonb,\n  add column landing_read_at timestamptz,\n  add column github_repo text check (github_repo is null or github_repo ~ '^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$'),\n  add column knowledge_sources jsonb not null default '{}';\nalter table projects alter column audience type text[]\n  using case when audience is null or audience = '' then '{}'::text[] else array[audience] end;\nalter table projects alter column audience set default '{}';\nalter table projects alter column audience set not null;\n\n-- ------------------------------------------------------------------ accounts\nalter table accounts\n  add column last_error text,\n  add column settings jsonb not null default '{}';\n\n-- The app may create a dev.to account row and switch accounts on/off, but\n-- never set secret_id, external_id or the poll cursor: those belong to the\n-- server (a forged secret_id could point the poller at another project's secret).\nrevoke insert, update on accounts from authenticated;\ngrant insert (project_id, platform, handle, auth, connected_by, active, settings) on accounts to authenticated;\ngrant update (project_id, platform, handle, auth, connected_by, active, settings) on accounts to authenticated;\nalter table accounts add constraint accounts_app_no_secret check (auth <> 'none' or secret_id is null);\n\n-- ------------------------------------------------------------------ people\nalter table people add column stage_changed_at timestamptz;\n\ncreate function people_touch_updated() returns trigger language plpgsql as $$\nbegin\n  new.updated_at := now();\n  if new.stage is distinct from old.stage then new.stage_changed_at := now(); end if;\n  return new;\nend $$;\ncreate trigger people_updated before update on people for each row execute function people_touch_updated();\n\n-- ------------------------------------------------------------------ items\nalter table items alter column account_id drop not null;\nalter table items\n  add column origin text not null default 'inbox' check (origin in ('inbox', 'discover')),\n  add column triaged_at timestamptz,\n  add column skip_reason text,\n  add column discovery jsonb,\n  add column triage_kind text generated always as (triage->>'kind') stored,\n  add column triage_action text generated always as (triage->>'suggested_action') stored,\n  add column triage_confidence real generated always as ((triage->>'confidence')::real) stored,\n  add column triage_summary text generated always as (triage->>'summary') stored;\ncreate index items_inbox on items (project_id, origin, status, posted_at desc);\ncreate index items_untriaged on items (fetched_at) where triaged_at is null and origin = 'inbox';\ncreate index items_person on items (person_id, posted_at desc);\n\n-- ------------------------------------------------------------------ drafts\nalter table drafts\n  add column intent text check (intent in ('just_answer', 'invite_to_try', 'ask_feedback', 'ask_price', 'auto')),\n  add column variant text not null default 'first' check (variant in ('first', 'shorter', 'redraft')),\n  add column checks text[] not null default '{}',\n  add column sources jsonb not null default '[]',\n  add column lint jsonb,\n  add column decided_by uuid references founders(id) on delete set null,\n  add column decided_at timestamptz;\n\n-- ------------------------------------------------------------------ ideas\n-- Feedback turned into something to build. Similar asks from different\n-- people are grouped into one idea; asked_by counts distinct people.\ncreate table ideas (\n  id uuid primary key default gen_random_uuid(),\n  project_id uuid not null references projects(id) on delete cascade,\n  title text not null,\n  summary text,\n  quote text,                       -- the exact phrase heard (first ask)\n  kind text not null default 'feature' check (kind in ('feature', 'bug', 'pain', 'would_pay', 'other')),\n  asked_by int not null default 0,  -- distinct people, kept by trigger\n  status text not null default 'new' check (status in ('new', 'planned', 'issue_open', 'not_now', 'done')),\n  github_issue_url text,\n  github_issue_number int,\n  created_at timestamptz not null default now(),\n  updated_at timestamptz not null default now()\n);\ncreate index ideas_project on ideas (project_id, status, updated_at desc);\n\ncreate table idea_items (\n  idea_id uuid not null references ideas(id) on delete cascade,\n  item_id uuid not null references items(id) on delete cascade,\n  person_id uuid not null references people(id) on delete cascade,\n  project_id uuid not null references projects(id) on delete cascade,\n  quote text,\n  created_at timestamptz not null default now(),\n  primary key (idea_id, item_id)\n);\ncreate index idea_items_item on idea_items (item_id);\n\nalter table ideas enable row level security;\ncreate policy members_all on ideas for all using (is_member(project_id)) with check (is_member(project_id));\nalter table idea_items enable row level security;\ncreate policy members_all on idea_items for all using (is_member(project_id)) with check (is_member(project_id));\n\ncreate function ideas_recount() returns trigger language plpgsql security definer set search_path = public as $$\ndeclare i uuid := coalesce(new.idea_id, old.idea_id);\nbegin\n  update ideas set asked_by = (select count(distinct person_id) from idea_items where idea_id = i), updated_at = now()\n  where id = i;\n  return null;\nend $$;\ncreate trigger idea_items_count after insert or delete on idea_items for each row execute function ideas_recount();\n\n-- ------------------------------------------------------------------ decision RPC\n-- The founder's decision on a draft, atomically (app/README.md asked for it).\n-- security definer with an explicit membership check: the caller must be a\n-- member of the draft's project.\ncreate function record_draft_outcome(\n  p_draft_id uuid,\n  p_outcome draft_outcome,\n  p_final_text text default null,\n  p_posted_url text default null,\n  p_move_stage person_stage default null\n) returns drafts\nlanguage plpgsql security definer set search_path = public as $$\ndeclare\n  d drafts;\n  it items;\n  uid uuid := auth.uid();\n  posted boolean := p_outcome in ('posted_as_is', 'posted_edited');\nbegin\n  if p_outcome not in ('posted_as_is', 'posted_edited', 'skipped') then raise exception 'bad_outcome'; end if;\n  if posted and coalesce(btrim(p_final_text), '') = '' then raise exception 'final_text_required'; end if;\n  select * into d from drafts where id = p_draft_id for update;\n  if not found then raise exception 'not_found'; end if;\n  select * into it from items where id = d.item_id for update;\n  if uid is null or not is_member(it.project_id) then raise exception 'not_found'; end if;\n  if d.outcome is not null then raise exception 'already_decided'; end if;\n\n  update drafts set\n    outcome = p_outcome,\n    final_text = case when posted then p_final_text else final_text end,\n    posted_url = case when posted then p_posted_url else posted_url end,\n    posted_at = case when posted then now() else posted_at end,\n    posted_by = case when posted then uid else posted_by end,\n    decided_by = uid, decided_at = now()\n  where id = p_draft_id returning * into d;\n\n  update drafts set outcome = 'superseded', decided_at = now()\n  where item_id = it.id and id <> p_draft_id and outcome is null;\n\n  update items set status = case when posted then 'answered'::item_status else 'skipped'::item_status end,\n                   skip_reason = null\n  where id = it.id;\n\n  if posted then\n    insert into touches (project_id, person_id, direction, platform, kind, occurred_at, url, text, item_id, by_founder, source)\n    values (it.project_id, it.person_id, 'out', it.platform, 'reply', now(), p_posted_url, p_final_text, it.id, uid, 'app');\n    update people set\n      last_touch_at = now(),\n      stage = coalesce(p_move_stage, case when stage = 'noticed' then 'talking'::person_stage else stage end)\n    where id = it.person_id;\n  elsif p_move_stage is not null then\n    update people set stage = p_move_stage where id = it.person_id;\n  end if;\n  return d;\nend $$;\nrevoke execute on function record_draft_outcome(uuid, draft_outcome, text, text, person_stage) from public, anon;\ngrant execute on function record_draft_outcome(uuid, draft_outcome, text, text, person_stage) to authenticated, service_role;\n\n-- ------------------------------------------------------------------ Vault\n-- Bluesky app passwords live in Vault; only the service role (Edge Functions)\n-- can store or read them. The secret's name binds it to its account.\ncreate function store_account_secret(p_account uuid, p_secret text) returns uuid\nlanguage plpgsql security definer set search_path = public, vault as $$\ndeclare sid uuid;\nbegin\n  select secret_id into sid from accounts where id = p_account;\n  if not found then raise exception 'not_found'; end if;\n  if sid is not null and exists (select 1 from vault.secrets where id = sid) then\n    perform vault.update_secret(sid, p_secret);\n  else\n    sid := vault.create_secret(p_secret, 'account:' || p_account::text || ':' || gen_random_uuid()::text, 'hearback account credential');\n    update accounts set secret_id = sid where id = p_account;\n  end if;\n  return sid;\nend $$;\n\ncreate function read_account_secret(p_account uuid) returns text\nlanguage sql stable security definer set search_path = public, vault as $$\n  select s.decrypted_secret\n  from accounts a join vault.decrypted_secrets s on s.id = a.secret_id\n  where a.id = p_account and s.name like 'account:' || p_account::text || ':%';\n$$;\n\ncreate function delete_account_secret(p_account uuid) returns void\nlanguage plpgsql security definer set search_path = public, vault as $$\ndeclare sid uuid;\nbegin\n  select secret_id into sid from accounts where id = p_account;\n  if sid is not null then\n    delete from vault.secrets where id = sid;\n    update accounts set secret_id = null where id = p_account;\n  end if;\nend $$;\n\nrevoke execute on function store_account_secret(uuid, text) from public, anon, authenticated;\nrevoke execute on function read_account_secret(uuid) from public, anon, authenticated;\nrevoke execute on function delete_account_secret(uuid) from public, anon, authenticated;\ngrant execute on function store_account_secret(uuid, text) to service_role;\ngrant execute on function read_account_secret(uuid) to service_role;\ngrant execute on function delete_account_secret(uuid) to service_role;\n\n-- ------------------------------------------------------------------ inbox view\n-- One row per person with something waiting (design 1g: grouped by person).\ncreate view inbox_by_person with (security_invoker = true) as\nwith w as (\n  select i.*, row_number() over (partition by i.person_id order by i.posted_at desc) rn\n  from items i\n  where i.origin = 'inbox' and i.status in ('new', 'draft_ready')\n)\nselect\n  w.project_id, w.person_id, p.display_name, p.avatar_url, p.stage,\n  count(*)::int as waiting,\n  count(*) filter (where w.status = 'new')::int as needs_you,\n  count(*) filter (where w.status = 'draft_ready')::int as draft_ready,\n  array_agg(distinct w.platform::text) as platforms,\n  max(w.id::text) filter (where w.rn = 1)::uuid as last_item_id,\n  max(w.text) filter (where w.rn = 1) as last_item_text,\n  max(w.kind::text) filter (where w.rn = 1) as last_item_kind,\n  max(w.platform::text) filter (where w.rn = 1) as last_item_platform,\n  max(w.posted_at) as last_posted_at,\n  max(w.status::text) filter (where w.rn = 1) as last_status,\n  (select d.text from drafts d where d.item_id = max(w.id::text) filter (where w.rn = 1)::uuid and d.outcome is null\n     order by d.version desc limit 1) as last_draft_text,\n  exists (select 1 from idea_items ii where ii.person_id = w.person_id) as has_idea\nfrom w join people p on p.id = w.person_id\ngroup by w.project_id, w.person_id, p.display_name, p.avatar_url, p.stage;\nrevoke all on inbox_by_person from anon;\ngrant select on inbox_by_person to authenticated;\n\n-- ------------------------------------------------------------------ realtime\ndo $$ begin\n  if exists (select 1 from pg_publication where pubname = 'supabase_realtime') then\n    alter publication supabase_realtime add table items, drafts, ideas;\n  end if;\nend $$;\n\n-- anon stays closed (20261008180000_no_anon) for everything created here.\nrevoke all on ideas, idea_items from anon;\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_12","type":"agent_message","text":"The 2026-10-10 migration already removes the guide’s main examples: `idea_items.person_id`, repeated document fields on chunks, the writable token totals on drafts, and the plan model array. I’m checking the tables added later and the remaining cached fields for dependencies that the database does not enforce."}}
{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc 'cat supabase/migrations/20261008230400_server_state.sql supabase/migrations/20261009150000_project_url_key.sql supabase/migrations/20261010020000_source_summary_branch.sql supabase/migrations/20261011010000_draft_checks.sql'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc 'cat supabase/migrations/20261008230400_server_state.sql supabase/migrations/20261009150000_project_url_key.sql supabase/migrations/20261010020000_source_summary_branch.sql supabase/migrations/20261011010000_draft_checks.sql'","aggregated_output":"-- Server-side state for the collectors.\n--  * Bluesky sessions: createSession is limited (30 per 5 min, 300 per day per\n--    account), so the poller keeps the session (access + refresh JWT) in Vault\n--    and refreshes it instead of logging in every 5 minutes.\n--  * usage_counters: a per-day request cap for paid/free-tier model calls, so a\n--    cron loop can't burn the day's quota.\n\ncreate function store_account_session(p_account uuid, p_session text) returns void\nlanguage plpgsql security definer set search_path = public, vault as $$\ndeclare sid uuid; nm text := 'account-session:' || p_account::text;\nbegin\n  select id into sid from vault.secrets where name = nm;\n  if sid is null then perform vault.create_secret(p_session, nm, 'hearback bluesky session');\n  else perform vault.update_secret(sid, p_session); end if;\nend $$;\n\ncreate function read_account_session(p_account uuid) returns text\nlanguage sql stable security definer set search_path = public, vault as $$\n  select decrypted_secret from vault.decrypted_secrets where name = 'account-session:' || p_account::text;\n$$;\n\ncreate or replace function delete_account_secret(p_account uuid) returns void\nlanguage plpgsql security definer set search_path = public, vault as $$\ndeclare sid uuid;\nbegin\n  select secret_id into sid from accounts where id = p_account;\n  if sid is not null then\n    delete from vault.secrets where id = sid;\n    update accounts set secret_id = null where id = p_account;\n  end if;\n  delete from vault.secrets where name = 'account-session:' || p_account::text;\nend $$;\n\nrevoke execute on function store_account_session(uuid, text) from public, anon, authenticated;\nrevoke execute on function read_account_session(uuid) from public, anon, authenticated;\ngrant execute on function store_account_session(uuid, text) to service_role;\ngrant execute on function read_account_session(uuid) to service_role;\n\ncreate table usage_counters (\n  day date not null default (now() at time zone 'utc')::date,\n  key text not null,\n  n int not null default 0,\n  primary key (day, key)\n);\nalter table usage_counters enable row level security;  -- no policies: service role only\nrevoke all on usage_counters from anon, authenticated;\n\n-- Adds one request under p_key for today; false (and no increment) when the cap is reached.\ncreate function bump_usage(p_key text, p_cap int) returns boolean\nlanguage plpgsql security definer set search_path = public as $$\ndeclare cur int;\nbegin\n  insert into usage_counters (key, n) values (p_key, 0) on conflict do nothing;\n  select n into cur from usage_counters where day = (now() at time zone 'utc')::date and key = p_key for update;\n  if cur >= p_cap then return false; end if;\n  update usage_counters set n = n + 1 where day = (now() at time zone 'utc')::date and key = p_key;\n  return true;\nend $$;\nrevoke execute on function bump_usage(text, int) from public, anon, authenticated;\ngrant execute on function bump_usage(text, int) to service_role;\n-- One project per landing URL per founder (2026-10-09). Onboarding on a new\n-- device created a second \"Worklore\" for https://worklore.dev/; read-landing\n-- now returns the founder's existing project for the same URL, and this index\n-- makes the database refuse a duplicate whatever path inserts it.\n--\n-- url_key: scheme and host lowercased, \"www.\" stripped, trailing slashes\n-- stripped; path and query kept as they are. Same rule as the app's\n-- normalizeProjectUrl and the server's urlKey (supabase/functions/_shared/core/url.ts).\n\ncreate function hb_url_key(p_url text) returns text\nlanguage sql immutable parallel safe as $$\n  select case\n    when p_url is null or btrim(p_url) = '' then null\n    else (\n      with s as (\n        select btrim(p_url) as u,\n               regexp_match(btrim(p_url), '^([a-zA-Z][a-zA-Z0-9+.-]*)://([^/?#]+)(.*)$') as m\n      )\n      select case\n        when m is null then lower(regexp_replace(u, '/+$', ''))\n        else lower(m[1]) || '://' || regexp_replace(lower(m[2]), '^www\\.', '')\n             || regexp_replace(regexp_replace(m[3], '#.*$', ''), '/+$', '')\n      end\n      from s\n    )\n  end\n$$;\n\nalter table projects add column url_key text generated always as (hb_url_key(url)) stored;\n\n-- Existing duplicates are kept (deleting needs the owner's OK) but marked, so\n-- the unique index can hold for everything else. The app lists a duplicate\n-- after the project it duplicates.\nalter table projects add column duplicate_of uuid references projects(id) on delete set null;\n\n-- Valentina's two worklore projects: the app works in 45c38f0b (created by her\n-- onboarding); the overnight seed 18789261 is the duplicate.\nupdate projects set duplicate_of = '45c38f0b-e059-4750-bf52-359baa8c9cea'\n where id = '18789261-0b30-4196-8004-35c1dbb2a160'\n   and exists (select 1 from projects where id = '45c38f0b-e059-4750-bf52-359baa8c9cea');\n\n-- Any other duplicate (same creator + url_key): every row but the newest is marked.\nupdate projects p set duplicate_of = (\n  select q.id from projects q\n   where q.created_by = p.created_by and q.url_key = p.url_key and q.id <> p.id and q.duplicate_of is null\n   order by q.created_at desc limit 1)\n where p.duplicate_of is null and p.url_key is not null and exists (\n  select 1 from projects q where q.created_by = p.created_by and q.url_key = p.url_key and q.created_at > p.created_at);\n\ncreate unique index projects_creator_url_key on projects (created_by, url_key)\n  where url_key is not null and duplicate_of is null;\n\n-- The founder's projects (member of) with this URL, oldest first. Used by\n-- read-landing (service role) to return an existing project instead of a new one.\ncreate function project_for_url(p_founder uuid, p_url text) returns uuid\nlanguage sql stable security definer set search_path = public as $$\n  select p.id from projects p\n   join project_members m on m.project_id = p.id and m.founder_id = p_founder\n  where p.url_key = hb_url_key(p_url) and p.duplicate_of is null\n  order by p.created_at\n  limit 1\n$$;\nrevoke execute on function project_for_url(uuid, text) from public, anon, authenticated;\ngrant execute on function project_for_url(uuid, text) to service_role;\n-- source_summary also returns the linked repo's default branch (from the\n-- GitHub source's last run), so the app can link to github.com's \"new file\"\n-- page in the folder: https://github.com/<repo>/new/<branch>/<folder>.\ncreate or replace function source_summary(p_project uuid) returns jsonb\nlanguage sql stable security invoker set search_path = public as $$\n  select jsonb_build_object(\n    'voice', (select jsonb_build_object(\n        'accepted', count(*) filter (where status = 'accepted'),\n        'active', count(*) filter (where active),\n        'candidates', count(*) filter (where status = 'candidate'),\n        'rejected', count(*) filter (where status = 'rejected'))\n      from voice_samples where founder_id = auth.uid()),\n    'knowledge', (select coalesce(jsonb_object_agg(src, n), '{}'::jsonb)\n      from (select coalesce(source, 'other') as src, count(*) as n from documents where project_id = p_project group by 1) s),\n    'syncs', (select coalesce(jsonb_agg(jsonb_build_object('source', source, 'status', status, 'message', message,\n        'last_synced_at', last_synced_at, 'stats', stats) order by source), '[]'::jsonb)\n      from source_syncs where project_id = p_project),\n    'last_synced_at', (select max(last_synced_at) from source_syncs where project_id = p_project),\n    'github', (select jsonb_build_object('repo', github_repo, 'folder', github_folder) from projects where id = p_project),\n    'github_branch', (select s.state->>'branch' from source_syncs s join projects p on p.id = s.project_id\n      where s.project_id = p_project and s.source = 'github:' || lower(coalesce(p.github_repo, '')) limit 1)\n  )\n$$;\n-- [check: …] gaps she can resolve (docs/API.md › Changes 2026-10-11).\n--\n-- * drafts.variant 'resolve': a version made by answering or dropping gaps of\n--   the version before it (draft function, `resolve`). Nothing else changes in\n--   how versions work: the older undecided one is superseded.\n-- * drafts.meta: what made this version beyond the model call. For 'resolve':\n--   {based_on: {draft_id, version}, edited_before, resolved: [{check_id,\n--   question, action: answer|drop, answer?, method: model|fallback, reason?,\n--   by, at}]}. Her answers stay here as a fact / voice signal for later drafts.\n-- * A posted reply never contains a gap: record_draft_outcome refuses\n--   final_text with \"[check\" (any case), and a constraint makes it a rule for\n--   every writer.\n\nalter table drafts drop constraint drafts_variant_check;\nalter table drafts add constraint drafts_variant_check check (variant in ('first', 'shorter', 'redraft', 'resolve'));\n\nalter table drafts add column meta jsonb not null default '{}'::jsonb;\n\nalter table drafts add constraint drafts_posted_without_checks\n  check (outcome is null or outcome not in ('posted_as_is', 'posted_edited') or final_text is null or final_text !~* '\\[check');\n\ncreate or replace function record_draft_outcome(\n  p_draft_id uuid,\n  p_outcome draft_outcome,\n  p_final_text text default null,\n  p_posted_url text default null,\n  p_move_stage person_stage default null\n) returns drafts\nlanguage plpgsql security definer set search_path = public as $$\ndeclare\n  d drafts;\n  it items;\n  uid uuid := auth.uid();\n  posted boolean := p_outcome in ('posted_as_is', 'posted_edited');\nbegin\n  if p_outcome not in ('posted_as_is', 'posted_edited', 'skipped') then raise exception 'bad_outcome'; end if;\n  if posted and coalesce(btrim(p_final_text), '') = '' then raise exception 'final_text_required'; end if;\n  if posted and p_final_text ~* '\\[check' then raise exception 'unfilled_check'; end if;\n  select * into d from drafts where id = p_draft_id for update;\n  if not found then raise exception 'not_found'; end if;\n  select * into it from items where id = d.item_id for update;\n  if uid is null or not is_member(it.project_id) then raise exception 'not_found'; end if;\n  if d.outcome is not null then raise exception 'already_decided'; end if;\n\n  update drafts set\n    outcome = p_outcome,\n    final_text = case when posted then p_final_text else final_text end,\n    posted_url = case when posted then p_posted_url else posted_url end,\n    posted_at = case when posted then now() else posted_at end,\n    posted_by = case when posted then uid else posted_by end,\n    decided_by = uid, decided_at = now()\n  where id = p_draft_id returning * into d;\n\n  update drafts set outcome = 'superseded', decided_at = now()\n  where item_id = it.id and id <> p_draft_id and outcome is null;\n\n  update items set status = case when posted then 'answered'::item_status else 'skipped'::item_status end,\n                   skip_reason = null\n  where id = it.id;\n\n  if posted then\n    insert into touches (project_id, person_id, direction, platform, kind, occurred_at, url, text, item_id, by_founder, source)\n    values (it.project_id, it.person_id, 'out', it.platform, 'reply', now(), p_posted_url, p_final_text, it.id, uid, 'app');\n    update people set\n      stage = coalesce(p_move_stage, case when stage = 'noticed' then 'talking'::person_stage else stage end)\n    where id = it.person_id;\n  elsif p_move_stage is not null then\n    update people set stage = p_move_stage where id = it.person_id;\n  end if;\n  return d;\nend $$;\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"cat supabase/migrations/20261008230200_backend_v1.sql | sed -n '1,135p'; cat supabase/migrations/20261009200000_plans_user_model.sql; cat supabase/migrations/20261010030000_github_app.sql\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"cat supabase/migrations/20261008230200_backend_v1.sql | sed -n '1,135p'; cat supabase/migrations/20261009200000_plans_user_model.sql; cat supabase/migrations/20261010030000_github_app.sql\"","aggregated_output":"-- Backend v1 (docs/API.md): what the MVP screens need on top of the init\n-- schema. Onboarding (project from a landing page), triage on items, drafts by\n-- intent, ideas from feedback, the draft decision as one transaction, Vault\n-- for Bluesky app passwords, an inbox view grouped by person, realtime.\n\n-- ------------------------------------------------------------------ projects\nalter table projects\n  add column url text,\n  add column description text,\n  add column topics text[] not null default '{}',\n  add column competitors text[] not null default '{}',\n  add column aims text,\n  add column landing jsonb,\n  add column landing_read_at timestamptz,\n  add column github_repo text check (github_repo is null or github_repo ~ '^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$'),\n  add column knowledge_sources jsonb not null default '{}';\nalter table projects alter column audience type text[]\n  using case when audience is null or audience = '' then '{}'::text[] else array[audience] end;\nalter table projects alter column audience set default '{}';\nalter table projects alter column audience set not null;\n\n-- ------------------------------------------------------------------ accounts\nalter table accounts\n  add column last_error text,\n  add column settings jsonb not null default '{}';\n\n-- The app may create a dev.to account row and switch accounts on/off, but\n-- never set secret_id, external_id or the poll cursor: those belong to the\n-- server (a forged secret_id could point the poller at another project's secret).\nrevoke insert, update on accounts from authenticated;\ngrant insert (project_id, platform, handle, auth, connected_by, active, settings) on accounts to authenticated;\ngrant update (project_id, platform, handle, auth, connected_by, active, settings) on accounts to authenticated;\nalter table accounts add constraint accounts_app_no_secret check (auth <> 'none' or secret_id is null);\n\n-- ------------------------------------------------------------------ people\nalter table people add column stage_changed_at timestamptz;\n\ncreate function people_touch_updated() returns trigger language plpgsql as $$\nbegin\n  new.updated_at := now();\n  if new.stage is distinct from old.stage then new.stage_changed_at := now(); end if;\n  return new;\nend $$;\ncreate trigger people_updated before update on people for each row execute function people_touch_updated();\n\n-- ------------------------------------------------------------------ items\nalter table items alter column account_id drop not null;\nalter table items\n  add column origin text not null default 'inbox' check (origin in ('inbox', 'discover')),\n  add column triaged_at timestamptz,\n  add column skip_reason text,\n  add column discovery jsonb,\n  add column triage_kind text generated always as (triage->>'kind') stored,\n  add column triage_action text generated always as (triage->>'suggested_action') stored,\n  add column triage_confidence real generated always as ((triage->>'confidence')::real) stored,\n  add column triage_summary text generated always as (triage->>'summary') stored;\ncreate index items_inbox on items (project_id, origin, status, posted_at desc);\ncreate index items_untriaged on items (fetched_at) where triaged_at is null and origin = 'inbox';\ncreate index items_person on items (person_id, posted_at desc);\n\n-- ------------------------------------------------------------------ drafts\nalter table drafts\n  add column intent text check (intent in ('just_answer', 'invite_to_try', 'ask_feedback', 'ask_price', 'auto')),\n  add column variant text not null default 'first' check (variant in ('first', 'shorter', 'redraft')),\n  add column checks text[] not null default '{}',\n  add column sources jsonb not null default '[]',\n  add column lint jsonb,\n  add column decided_by uuid references founders(id) on delete set null,\n  add column decided_at timestamptz;\n\n-- ------------------------------------------------------------------ ideas\n-- Feedback turned into something to build. Similar asks from different\n-- people are grouped into one idea; asked_by counts distinct people.\ncreate table ideas (\n  id uuid primary key default gen_random_uuid(),\n  project_id uuid not null references projects(id) on delete cascade,\n  title text not null,\n  summary text,\n  quote text,                       -- the exact phrase heard (first ask)\n  kind text not null default 'feature' check (kind in ('feature', 'bug', 'pain', 'would_pay', 'other')),\n  asked_by int not null default 0,  -- distinct people, kept by trigger\n  status text not null default 'new' check (status in ('new', 'planned', 'issue_open', 'not_now', 'done')),\n  github_issue_url text,\n  github_issue_number int,\n  created_at timestamptz not null default now(),\n  updated_at timestamptz not null default now()\n);\ncreate index ideas_project on ideas (project_id, status, updated_at desc);\n\ncreate table idea_items (\n  idea_id uuid not null references ideas(id) on delete cascade,\n  item_id uuid not null references items(id) on delete cascade,\n  person_id uuid not null references people(id) on delete cascade,\n  project_id uuid not null references projects(id) on delete cascade,\n  quote text,\n  created_at timestamptz not null default now(),\n  primary key (idea_id, item_id)\n);\ncreate index idea_items_item on idea_items (item_id);\n\nalter table ideas enable row level security;\ncreate policy members_all on ideas for all using (is_member(project_id)) with check (is_member(project_id));\nalter table idea_items enable row level security;\ncreate policy members_all on idea_items for all using (is_member(project_id)) with check (is_member(project_id));\n\ncreate function ideas_recount() returns trigger language plpgsql security definer set search_path = public as $$\ndeclare i uuid := coalesce(new.idea_id, old.idea_id);\nbegin\n  update ideas set asked_by = (select count(distinct person_id) from idea_items where idea_id = i), updated_at = now()\n  where id = i;\n  return null;\nend $$;\ncreate trigger idea_items_count after insert or delete on idea_items for each row execute function ideas_recount();\n\n-- ------------------------------------------------------------------ decision RPC\n-- The founder's decision on a draft, atomically (app/README.md asked for it).\n-- security definer with an explicit membership check: the caller must be a\n-- member of the draft's project.\ncreate function record_draft_outcome(\n  p_draft_id uuid,\n  p_outcome draft_outcome,\n  p_final_text text default null,\n  p_posted_url text default null,\n  p_move_stage person_stage default null\n) returns drafts\nlanguage plpgsql security definer set search_path = public as $$\ndeclare\n  d drafts;\n  it items;\n  uid uuid := auth.uid();\n  posted boolean := p_outcome in ('posted_as_is', 'posted_edited');\nbegin\n  if p_outcome not in ('posted_as_is', 'posted_edited', 'skipped') then raise exception 'bad_outcome'; end if;\n  if posted and coalesce(btrim(p_final_text), '') = '' then raise exception 'final_text_required'; end if;\n  select * into d from drafts where id = p_draft_id for update;\n-- The draft model is a personal setting (per founder), bounded by the\n-- founder's plan, 2026-10-09. Replaces projects.settings.draft_model, which\n-- stays as a column but is no longer read by the server.\n--\n-- plans                 one row per plan; default_model and allowed_models are\n--                       \"provider:model\" specs (format of DRAFT_MODEL).\n--                       Readable by any signed-in user, written by the\n--                       service role only.\n-- founders.plan_id      the founder's plan. Never writable by the founder.\n-- founders.draft_model  the founder's own pick (null = the plan's default);\n--                       must be one of the plan's allowed_models, set through\n--                       set_draft_model(). The server resolves the model per\n--                       draft in _shared/server/models.ts › modelForUser.\n\ncreate table if not exists plans (\n  id text primary key,\n  name text not null,\n  default_model text not null,\n  allowed_models text[] not null,\n  created_at timestamptz not null default now(),\n  constraint plans_default_allowed check (default_model = any (allowed_models))\n);\n\n-- 'founder' is the owner's own plan. 'free' and 'pro' are PLACEHOLDERS until\n-- there is pricing: names, defaults and model lists will change.\ninsert into plans (id, name, default_model, allowed_models) values\n  ('founder', 'Founder', 'anthropic:claude-sonnet-5-5',\n   array['gemini:gemini-3.1-flash-lite', 'anthropic:claude-haiku-5-5', 'anthropic:claude-sonnet-5-5', 'anthropic:claude-opus-5-5']),\n  ('free', 'Free', 'gemini:gemini-3.1-flash-lite',            -- placeholder\n   array['gemini:gemini-3.1-flash-lite', 'anthropic:claude-haiku-5-5']),\n  ('pro', 'Pro', 'anthropic:claude-sonnet-5-5',               -- placeholder\n   array['anthropic:claude-haiku-5-5', 'anthropic:claude-sonnet-5-5', 'anthropic:claude-opus-5-5'])\non conflict (id) do update\n  set name = excluded.name, default_model = excluded.default_model, allowed_models = excluded.allowed_models;\n\nalter table plans enable row level security;\ndrop policy if exists signed_in_read on plans;\ncreate policy signed_in_read on plans for select to authenticated using (true);\nrevoke all on plans from anon, authenticated;\ngrant select on plans to authenticated;\n\n-- TODO(real users): switch the default to 'free' when people other than the\n-- owner sign up. While only the owner uses Hearback, everyone is 'founder'.\nalter table founders add column if not exists plan_id text not null default 'founder' references plans (id);\nalter table founders add column if not exists draft_model text;\n\n-- The founder edits her profile columns only; plan_id and draft_model change\n-- through set_draft_model() (security definer) or the service role.\nrevoke insert, update on founders from authenticated;\ngrant insert (id, display_name, avatar_url, voice_notes, languages) on founders to authenticated;\ngrant update (display_name, avatar_url, voice_notes, languages) on founders to authenticated;\n\n-- An override must be allowed by the plan (checked when it is set; if a plan\n-- later drops a model, the server falls back to the plan default instead).\ncreate or replace function check_founder_draft_model() returns trigger\n  language plpgsql set search_path = public as $$\nbegin\n  if new.draft_model is not null\n     and (tg_op = 'INSERT' or new.draft_model is distinct from old.draft_model)\n     and not exists (select 1 from plans p where p.id = new.plan_id and new.draft_model = any (p.allowed_models)) then\n    raise exception 'model_not_allowed' using errcode = '23514', detail = format('%s is not in plan %s', new.draft_model, new.plan_id);\n  end if;\n  return new;\nend $$;\ndrop trigger if exists founder_draft_model on founders;\ncreate trigger founder_draft_model before insert or update of draft_model, plan_id on founders\n  for each row execute function check_founder_draft_model();\n\n-- What the app shows in Project › Developer: the plan, its models, the pick.\ncreate or replace function my_draft_model() returns jsonb\n  language sql stable security definer set search_path = public as $$\n  select jsonb_build_object(\n    'plan_id', p.id, 'plan_name', p.name, 'default_model', p.default_model,\n    'allowed_models', to_jsonb(p.allowed_models), 'draft_model', f.draft_model,\n    'effective_model', case when f.draft_model = any (p.allowed_models) then f.draft_model else p.default_model end)\n  from founders f join plans p on p.id = f.plan_id\n  where f.id = auth.uid()\n$$;\n\n-- Sets (or with null/'' clears) the caller's override. Raises\n-- 'model_not_allowed' for a model outside her plan.\ncreate or replace function set_draft_model(model text) returns jsonb\n  language plpgsql security definer set search_path = public as $$\ndeclare\n  m text := nullif(btrim(model), '');\nbegin\n  if auth.uid() is null then raise exception 'not_found'; end if;\n  if m is not null and not exists (\n    select 1 from founders f join plans p on p.id = f.plan_id\n    where f.id = auth.uid() and m = any (p.allowed_models)) then\n    raise exception 'model_not_allowed' using errcode = '23514';\n  end if;\n  update founders set draft_model = m where id = auth.uid();\n  if not found then raise exception 'not_found'; end if;\n  return my_draft_model();\nend $$;\n\nrevoke execute on function my_draft_model() from public, anon;\nrevoke execute on function set_draft_model(text) from public, anon;\nrevoke execute on function check_founder_draft_model() from public, anon, authenticated;\ngrant execute on function my_draft_model() to authenticated;\ngrant execute on function set_draft_model(text) to authenticated;\n\n-- The owner: plan 'founder', no override (Claude Sonnet 5.5).\nupdate founders set plan_id = 'founder', draft_model = null\n  where id in (select id from auth.users where lower(email) = 'vkonuhova@gmail.com');\n\ncomment on column projects.settings is\n  'Per-project server switches. draft_effort is read; draft_model is NOT read since 2026-10-09 (the model is per founder: founders.draft_model / plans).';\n-- GitHub App (Hearback.dev): installations linked to projects, one-time\n-- install states, and the issue opened from an idea. docs/ARCHITECTURE.md ›\n-- GitHub App, docs/API.md › Changes 2026-10-10 (GitHub App).\n--\n-- Nothing secret lives here: installation tokens are minted on demand from\n-- the app's key (a function secret) and never stored.\n\n-- ------------------------------------------------------------------ installations\ncreate table github_installations (\n  installation_id bigint primary key,\n  account_login text not null,\n  account_type text not null default 'User',          -- User | Organization\n  account_id bigint,\n  repository_selection text not null default 'selected', -- all | selected\n  repos jsonb not null default '[]',                  -- [{full_name, private, default_branch, open_issues, pushed_at, description, archived, has_issues}]\n  repos_fetched_at timestamptz,\n  founder_id uuid references founders(id) on delete set null,  -- who connected it\n  suspended_at timestamptz,\n  created_at timestamptz not null default now(),\n  updated_at timestamptz not null default now()\n);\n\ncreate table github_installation_projects (\n  installation_id bigint not null references github_installations(installation_id) on delete cascade,\n  project_id uuid not null references projects(id) on delete cascade,\n  linked_by uuid references founders(id) on delete set null,\n  created_at timestamptz not null default now(),\n  primary key (installation_id, project_id)\n);\ncreate index github_installation_projects_project on github_installation_projects (project_id);\n\n-- One-time state for the install URL: stored hashed, 15 minutes, single use.\ncreate table github_install_states (\n  id uuid primary key default gen_random_uuid(),\n  token_sha256 text not null unique,\n  founder_id uuid not null references founders(id) on delete cascade,\n  project_id uuid not null references projects(id) on delete cascade,\n  client text not null default 'app' check (client in ('app', 'web')),\n  created_at timestamptz not null default now(),\n  expires_at timestamptz not null default now() + interval '15 minutes',\n  used_at timestamptz\n);\ncreate index github_install_states_expires on github_install_states (expires_at);\n\nalter table github_installations enable row level security;\nalter table github_installation_projects enable row level security;\nalter table github_install_states enable row level security;\n\n-- Members of a linked project (and whoever connected it) read; only the server writes.\ncreate policy members_read on github_installation_projects for select using (is_member(project_id));\ncreate policy members_read on github_installations for select using (\n  founder_id = auth.uid()\n  or exists (select 1 from github_installation_projects l where l.installation_id = github_installations.installation_id and is_member(l.project_id)));\n\nrevoke all on github_installations, github_installation_projects, github_install_states from anon, authenticated;\ngrant select on github_installations, github_installation_projects to authenticated;\n\n-- Expired or used states go away daily.\nselect cron.schedule('hb-github-states-gc', '41 3 * * *',\n  $$delete from github_install_states where expires_at < now() - interval '1 day'$$);\n\n-- ------------------------------------------------------------------ ideas → issues\n-- Which repo the issue went to (the project's repo may change later).\nalter table ideas add column github_issue_repo text;\n","exit_code":0,"status":"completed"}}
