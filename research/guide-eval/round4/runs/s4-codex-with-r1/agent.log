touch_at timestamptz,\nsupabase/migrations/20261008170000_init.sql:121:  updated_at timestamptz not null default now()\nsupabase/migrations/20261008170000_init.sql:179:  tokens_in int,\nsupabase/migrations/20261008170000_init.sql:180:  tokens_out int,\nsupabase/migrations/20261010040000_normal_forms.sql:17:--   * voice_samples.text_sha256: the server dedupes on it before inserting,\nsupabase/migrations/20261010040000_normal_forms.sql:79:  update ideas set asked_by = (\nsupabase/migrations/20261010040000_normal_forms.sql:81:    updated_at = now()\nsupabase/migrations/20261010040000_normal_forms.sql:86:-- asked_by stays a cached count: recount when an item changes hands.\nsupabase/migrations/20261010040000_normal_forms.sql:89:  update ideas d set asked_by = (\nsupabase/migrations/20261010040000_normal_forms.sql:178:-- ------------------------------------------------------------------ 3NF: drafts.tokens_in / tokens_out\nsupabase/migrations/20261010040000_normal_forms.sql:183:update drafts set tokens = jsonb_build_object('input', tokens_in, 'output', tokens_out)\nsupabase/migrations/20261010040000_normal_forms.sql:184:  where tokens is null and (tokens_in is not null or tokens_out is not null);\nsupabase/migrations/20261010040000_normal_forms.sql:188:      tokens_in is distinct from (tokens->>'input')::int + coalesce((tokens->>'cache_read')::int, 0) + coalesce((tokens->>'cache_write')::int, 0)\nsupabase/migrations/20261010040000_normal_forms.sql:189:      or tokens_out is distinct from (tokens->>'output')::int) then\nsupabase/migrations/20261010040000_normal_forms.sql:190:    raise exception 'drafts: tokens_in/tokens_out disagree with drafts.tokens; not converting';\nsupabase/migrations/20261010040000_normal_forms.sql:194:alter table drafts drop column tokens_in, drop column tokens_out;\nsupabase/migrations/20261010040000_normal_forms.sql:196:  add column tokens_in int generated always as\nsupabase/migrations/20261010040000_normal_forms.sql:198:  add column tokens_out i