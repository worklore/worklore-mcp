/20261010010000_sources_voice_knowledge.sql:54:  unique (project_id, source)\nsupabase/migrations/20261010010000_sources_voice_knowledge.sql:56:alter table source_syncs enable row level security;\nsupabase/migrations/20261010010000_sources_voice_knowledge.sql:64:alter table documents\nsupabase/migrations/20261010010000_sources_voice_knowledge.sql:71:alter table document_chunks drop constraint document_chunks_kind_check;\nsupabase/migrations/20261010010000_sources_voice_knowledge.sql:72:alter table document_chunks add constraint document_chunks_kind_check\nsupabase/migrations/20261010010000_sources_voice_knowledge.sql:76:alter table projects add column github_folder text not null default 'hearback'\nsupabase/migrations/20261008170000_init.sql:27:create table founders (\nsupabase/migrations/20261008170000_init.sql:37:create table projects (\nsupabase/migrations/20261008170000_init.sql:51:create table project_members (\nsupabase/migrations/20261008170000_init.sql:60:create table project_invites (\nsupabase/migrations/20261008170000_init.sql:68:  unique (project_id, email)\nsupabase/migrations/20261008170000_init.sql:75:create table accounts (\nsupabase/migrations/20261008170000_init.sql:87:  unique (project_id, platform, handle)\nsupabase/migrations/20261008170000_init.sql:94:create table themes (\nsupabase/migrations/20261008170000_init.sql:101:  unique (project_id, name)\nsupabase/migrations/20261008170000_init.sql:108:create table people (\nsupabase/migrations/20261008170000_init.sql:126:create table identities (\nsupabase/migrations/20261008170000_init.sql:136:  unique (project_id, platform, handle)\nsupabase/migrations/20261008170000_init.sql:141:create table items (\nsupabase/migrations/20261008170000_init.sql:159:  unique (project_id, platform, external_id)\nsupabase/migrations/20261008170000_init.sql:163:create table item_themes (\nsupabase/migrations/20261008170000_init.sql:171:create table drafts (\nsupabase/migrations/20261008170000_init.sql:188:  unique (item_id, version)\nsupabase/migrations/20261008170000_init.sql:194:create table touches (\nsupabase/migrations/20261008170000_init.sql:213:create table project_memory (\nsupabase/migrations/20261008170000_init.sql:225:create table documents (\nsupabase/migrations/20261008170000_init.sql:234:  unique (project_id, url)\nsupabase/migrations/20261008170000_init.sql:248:alter table founders enable row level security;\nsupabase/migrations/20261008170000_init.sql:254:alter table projects enable row level security;\nsupabase/migrations/20261008170000_init.sql:260:alter table project_members enable row level security;\nsupabase/migrations/20261008170000_init.sql:264:alter table project_invites enable row level security;\nsupabase/migrations/20261008170000_init.sql:271:    execute format('alter table %I enable row level security', t);\nsupabase/migrations/20261008170000_init.sql:277:alter table item_themes enable row level security;\nsupabase/migrations/20261008170000_init.sql:282:alter table drafts enable row level security;\n","exit_code":0,"status":"completed"}}
