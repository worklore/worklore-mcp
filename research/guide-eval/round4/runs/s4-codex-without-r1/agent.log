{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"cat 'supabase/migrations/20261008230100_knowledge_chunks.sql'\"","aggregated_output":"-- Knowledge base for drafts (eval/REPORT-v2.md) and triage results on items\n-- (Yahhi/hearback#5). Was 20261015120000 (draft); applied as part of backend v1.\n-- Change from the draft: every chunk carries a label. 'quotable' = her\n-- published work (may be quoted and linked); 'background' = unpublished\n-- material, context only, never quoted (REPORT-v2: private research leaked\n-- into public drafts).\n--\n-- What drafts know beyond the thread is the founder's published body of work\n-- (articles, stories, research, release notes, README, FAQ), cut into\n-- ~300–600-token chunks, each with a date, a kind and, when public, a URL the\n-- draft may cite. Retrieval per item: the top ~40 chunks by cosine published\n-- BEFORE the item, then MMR + per-source cap in the engine (retrieve.ts).\n--\n-- Requires pgvector >= 0.8 (iterative index scans, so the project filter\n-- doesn't starve the HNSW result).\n\ncreate extension if not exists vector with schema extensions;\nset search_path = public, extensions;\n\n-- ------------------------------------------------------------------ documents\n-- documents (init migration) holds whole sources; it gains what retrieval needs.\nalter table documents\n  add column published_at timestamptz,          -- when it became public (null = unknown → never retrieved)\n  add column published_precision text not null default 'instant'\n    check (published_precision in ('instant', 'day')),\n  add column is_public boolean not null default true, -- false: a private source (e.g. a private repo); never linked in a draft\n  add column source_ref text;                     -- where it came from when there's no public URL\n\n-- ------------------------------------------------------------------ chunks\ncreate table document_chunks (\n  id uuid primary key default gen_random_uuid(),\n  project_id uuid not null references projects(id) on delete cascade,\n  document_id uuid not null references documents(id) on delete cascade,\n  ord int not null,                               -- position in the document\n  kind text not null check (kind in ('article', 'story', 'research', 'changelog', 'readme', 'faq', 'fact')),\n  title text not null,                            -- \"Doc title › Section\"\n  source_url text,                                -- public link a draft may cite; null when not public\n  source_ref text,\n  -- A chunk is as new as its newest line (git blame for files): a README\n  -- section written yesterday is not visible to a comment from last week.\n  published_at timestamptz not null,\n  published_precision text not null default 'instant' check (published_precision in ('instant', 'day')),\n  content text not null,\n  content_sha256 text not null,                   -- skip re-embedding unchanged chunks\n  tokens int not null,\n  lang text not null default 'en',\n  embedding vector(768),                          -- gemini-embedding-001, outputDimensionality 768, L2-normalised\n  embedding_model text,\n  label text not null default 'quotable' check (label in ('quotable', 'background')),\n  created_at timestamptz not null default now(),\n  unique (document_id, ord)\n);\ncreate index document_chunks_project on document_chunks (project_id, published_at);\ncreate index document_chunks_embedding on document_chunks\n  using hnsw (embedding vector_cosine_ops) with (m = 16, ef_construction = 64);\n\nalter table document_chunks enable row level security;\ncreate policy members_all on document_chunks for all\n  using (is_member(project_id)) with check (is_member(project_id));\n\n-- ------------------------------------------------------------------ retrieval\n-- Candidates for one item: published strictly before p_before (a day-precision\n-- chunk only if its day is earlier: a same-day commit may be the answer to the\n-- comment), optionally limited to kinds, nearest first. The engine re-ranks\n-- (MMR, at most 2 per source) and keeps ~6. security invoker: RLS applies, so\n-- a founder only ever retrieves her own projects' chunks.\ncreate function match_document_chunks(\n  p_project uuid,\n  p_query vector(768),\n  p_before timestamptz default now(),\n  p_count int default 40,\n  p_kinds text[] default null,\n  p_min_similarity float default 0.68,\n  p_labels text[] default array['quotable']\n) returns table (\n  id uuid, kind text, title text, source_url text, source_ref text,\n  published_at timestamptz, published_precision text, content text, tokens int, lang text,\n  similarity float, embedding vector(768), label text\n)\nlanguage sql stable security invoker\nset search_path = public, extensions\nset hnsw.ef_search = 100\nset hnsw.iterative_scan = relaxed_order\nas $$\n  select c.id, c.kind, c.title, c.source_url, c.source_ref,\n         c.published_at, c.published_precision, c.content, c.tokens, c.lang,\n         1 - (c.embedding <=> p_query) as similarity, c.embedding, c.label\n  from document_chunks c\n  where c.project_id = p_project\n    and c.embedding is not null\n    and (p_kinds is null or c.kind = any (p_kinds))\n    and c.label = any (p_labels)\n    and case c.published_precision\n          when 'day' then (c.published_at at time zone 'utc')::date < (p_before at time zone 'utc')::date\n          else c.published_at < p_before\n        end\n    and 1 - (c.embedding <=> p_query) >= p_min_similarity\n  order by c.embedding <=> p_query\n  limit greatest(1, least(p_count, 200));\n$$;\n\n-- ------------------------------------------------------------------ triage on items\n-- triage.ts › TriageResult, as the app shows it: kind, route (decide_queue /\n-- draft / short_draft / skip), not_sure, one-line summary, suggested action,\n-- probabilities, and which decider answered (gemini / typesafe + model).\n-- (generated columns for the app: see 20261008230200_backend_v1.sql)\nalter table items\n  add column triage jsonb,\n  add column triage_route text generated always as (triage->>'route') stored;\ncreate index items_triage_route on items (project_id, triage_route, posted_at desc);\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc \"cat 'supabase/migrations/20261010040000_normal_forms.sql'\"","aggregated_output":"-- Normal forms, 2026-10-10. The schema checked against 1NF–3NF (Codd 1970/71),\n-- BCNF and 4NF/5NF (Fagin 1977/79); in Kent's words (CACM 26(2), 1983), every\n-- non-key field is a fact about the key, the whole key, and nothing but the key.\n--\n-- Mixed approach, not textbook 3NF:\n--   * redundancy that buys nothing is removed, or computed by Postgres\n--     (generated columns, triggers) so it can't drift;\n--   * the project_id copies on child tables stay (RLS policies and the hot\n--     indexes filter on them), but composite foreign keys now make a copy that\n--     disagrees with its parent impossible.\n-- Every constraint below was checked against the live data first (no\n-- violations). Left as they are, on purpose:\n--   * ideas.github_issue_url: holds either the issue's URL or a pre-filled\n--     github.com \"new issue\" link (app), so it isn't derivable from repo + number;\n--   * source_syncs.source ('devto:writing:<handle>', 'github:<repo>'): an\n--     opaque key the app shows and parses; the database only compares it;\n--   * voice_samples.text_sha256: the server dedupes on it before inserting,\n--     with JavaScript's whitespace rule; a generated column could disagree;\n--   * themes.position vs project_memory kind 'position': both unused so far.\n\nset search_path = public, extensions;\n\n-- ------------------------------------------------------------------ 3NF: project_id copies\n-- Parents expose (id, project_id[, …]) so children can reference the pair.\nalter table people   add constraint people_id_project unique (id, project_id);\nalter table accounts add constraint accounts_id_project_platform unique (id, project_id, platform);\nalter table items    add constraint items_id_project unique (id, project_id),\n                     add constraint items_id_project_person unique (id, project_id, person_id);\nalter table documents add constraint documents_id_project unique (id, project_id);\nalter table ideas    add constraint ideas_id_project unique (id, project_id);\nalter table themes   add constraint themes_id_project unique (id, project_id);\n\n-- An item's person and account are in the item's project; the account is on\n-- the item's platform. (Discover items have no account: MATCH SIMPLE skips it.)\nalter table items\n  drop constraint items_person_id_fkey,\n  add constraint items_person_fkey foreign key (person_id, project_id) references people (id, project_id) on delete cascade,\n  drop constraint items_account_id_fkey,\n  add constraint items_account_fkey foreign key (account_id, project_id, platform)\n    references accounts (id, project_id, platform) on delete cascade;\n\nalter table identities\n  drop constraint identities_person_id_fkey,\n  add constraint identities_person_fkey foreign key (person_id, project_id) references people (id, project_id) on delete cascade;\n\n-- A touch about an item is with that item's person; if the item moves to\n-- another person (people merged), its touches follow.\nalter table touches\n  drop constraint touches_person_id_fkey,\n  add constraint touches_person_fkey foreign key (person_id, project_id) references people (id, project_id) on delete cascade,\n  drop constraint touches_item_id_fkey,\n  add constraint touches_item_fkey foreign key (item_id, project_id, person_id)\n    references items (id, project_id, person_id) on delete cascade on update cascade;\n\nalter table document_chunks\n  drop constraint document_chunks_document_id_fkey,\n  add constraint document_chunks_document_fkey foreign key (document_id, project_id) references documents (id, project_id) on delete cascade;\n\nalter table idea_items\n  drop constraint idea_items_idea_id_fkey,\n  add constraint idea_items_idea_fkey foreign key (idea_id, project_id) references ideas (id, project_id) on delete cascade,\n  drop constraint idea_items_item_id_fkey,\n  add constraint idea_items_item_fkey foreign key (item_id, project_id) references items (id, project_id) on delete cascade;\n\n-- A theme from another project can't be attached.\nalter table documents\n  drop constraint documents_theme_id_fkey,\n  add constraint documents_theme_fkey foreign key (theme_id, project_id) references themes (id, project_id) on delete set null (theme_id);\nalter table project_memory\n  drop constraint project_memory_theme_id_fkey,\n  add constraint project_memory_theme_fkey foreign key (theme_id, project_id) references themes (id, project_id) on delete cascade;\n\n-- ------------------------------------------------------------------ 2NF: idea_items.person_id\n-- idea_items is keyed by (idea_id, item_id), but person_id depended on item_id\n-- alone (it is items.person_id). Who asked is now read through the item.\ncreate or replace function ideas_recount() returns trigger language plpgsql security definer set search_path = public as $$\ndeclare x uuid := coalesce(new.idea_id, old.idea_id);\nbegin\n  update ideas set asked_by = (\n      select count(distinct i.person_id) from idea_items ii join items i on i.id = ii.item_id where ii.idea_id = x),\n    updated_at = now()\n  where id = x;\n  return null;\nend $$;\n\n-- asked_by stays a cached count: recount when an item changes hands.\ncreate function items_person_recount() returns trigger language plpgsql security definer set search_path = public as $$\nbegin\n  update ideas d set asked_by = (\n      select count(distinct i.person_id) from idea_items ii join items i on i.id = ii.item_id where ii.idea_id = d.id)\n  where d.id in (select idea_id from idea_items where item_id = new.id);\n  return null;\nend $$;\ncreate trigger items_person_recount after update of person_id on items\n  for each row when (old.person_id is distinct from new.person_id) execute function items_person_recount();\nrevoke execute on function items_person_recount() from public, anon, authenticated;\n\n-- The inbox view read idea_items.person_id; same columns, through items.\ncreate or replace view inbox_by_person with (security_invoker = true) as\nwith w as (\n  select i.*, row_number() over (partition by i.person_id order by i.posted_at desc) rn\n  from items i\n  where i.origin = 'inbox' and i.status in ('new', 'draft_ready')\n)\nselect\n  w.project_id, w.person_id, p.display_name, p.avatar_url, p.stage,\n  count(*)::int as waiting,\n  count(*) filter (where w.status = 'new')::int as needs_you,\n  count(*) filter (where w.status = 'draft_ready')::int as draft_ready,\n  array_agg(distinct w.platform::text) as platforms,\n  max(w.id::text) filter (where w.rn = 1)::uuid as last_item_id,\n  max(w.text) filter (where w.rn = 1) as last_item_text,\n  max(w.kind::text) filter (where w.rn = 1) as last_item_kind,\n  max(w.platform::text) filter (where w.rn = 1) as last_item_platform,\n  max(w.posted_at) as last_posted_at,\n  max(w.status::text) filter (where w.rn = 1) as last_status,\n  (select d.text from drafts d where d.item_id = max(w.id::text) filter (where w.rn = 1)::uuid and d.outcome is null\n     order by d.version desc limit 1) as last_draft_text,\n  exists (select 1 from idea_items ii join items ai on ai.id = ii.item_id where ai.person_id = w.person_id) as has_idea\nfrom w join people p on p.id = w.person_id\ngroup by w.project_id, w.person_id, p.display_name, p.avatar_url, p.stage;\n\nalter table idea_items drop column person_id;\n\n-- ------------------------------------------------------------------ 3NF: document_chunks\n-- kind, source_url, source_ref and label were copies of the chunk's document\n-- (written from it in knowledge.ts; identical on every live row). They live on\n-- documents only. published_at / published_precision stay per chunk (a section\n-- is as new as its newest line), and so does lang.\nalter table documents add constraint documents_kind_check\n  check (kind in ('article', 'story', 'research', 'changelog', 'readme', 'faq', 'fact', 'page'));\n\n-- is_public was label = 'quotable' written twice; Postgres computes it now.\nalter table documents drop column is_public;\nalter table documents add column is_public boolean generated always as (label = 'quotable') stored;\n\n-- Same signature and result as before; the document's fields come through the join.\ncreate or replace function match_document_chunks(\n  p_project uuid,\n  p_query vector(768),\n  p_before timestamptz default now(),\n  p_count int default 40,\n  p_kinds text[] default null,\n  p_min_similarity float default 0.68,\n  p_labels text[] default array['quotable']\n) returns table (\n  id uuid, kind text, title text, source_url text, source_ref text,\n  published_at timestamptz, published_precision text, content text, tokens int, lang text,\n  similarity float, embedding vector(768), label text\n)\nlanguage sql stable security invoker\nset search_path = public, extensions\nset hnsw.ef_search = 100\nset hnsw.iterative_scan = relaxed_order\nas $$\n  select c.id, d.kind, c.title,\n         case when d.label = 'quotable' then d.url end as source_url,\n         case when d.label <> 'quotable' then coalesce(d.source_ref, d.url) end as source_ref,\n         c.published_at, c.published_precision, c.content, c.tokens, c.lang,\n         1 - (c.embedding <=> p_query) as similarity, c.embedding, d.label\n  from document_chunks c\n  join documents d on d.id = c.document_id\n  where c.project_id = p_project\n    and c.embedding is not null\n    and (p_kinds is null or d.kind = any (p_kinds))\n    and d.label = any (p_labels)\n    and case c.published_precision\n          when 'day' then (c.published_at at time zone 'utc')::date < (p_before at time zone 'utc')::date\n          else c.published_at < p_before\n        end\n    and 1 - (c.embedding <=> p_query) >= p_min_similarity\n  order by c.embedding <=> p_query\n  limit greatest(1, least(p_count, 200));\n$$;\n\nalter table document_chunks drop column kind, drop column source_url, drop column source_ref, drop column label;\n\n-- ------------------------------------------------------------------ 3NF: drafts.tokens_in / tokens_out\n-- The totals are functions of the usage breakdown in drafts.tokens (Anthropic's\n-- input excludes cache reads and writes; the total includes them). Drafts that\n-- only had totals (Gemini) get them as the breakdown, then Postgres computes\n-- the totals.\nupdate drafts set tokens = jsonb_build_object('input', tokens_in, 'output', tokens_out)\n  where tokens is null and (tokens_in is not null or tokens_out is not null);\n\ndo $$ begin\n  if exists (select 1 from drafts where\n      tokens_in is distinct from (tokens->>'input')::int + coalesce((tokens->>'cache_read')::int, 0) + coalesce((tokens->>'cache_write')::int, 0)\n      or tokens_out is distinct from (tokens->>'output')::int) then\n    raise exception 'drafts: tokens_in/tokens_out disagree with drafts.tokens; not converting';\n  end if;\nend $$;\n\nalter table drafts drop column tokens_in, drop column tokens_out;\nalter table drafts\n  add column tokens_in int generated always as\n    ((tokens->>'input')::int + coalesce((tokens->>'cache_read')::int, 0) + coalesce((tokens->>'cache_write')::int, 0)) stored,\n  add column tokens_out int generated always as ((tokens->>'output')::int) stored;\n\n-- ------------------------------------------------------------------ derived: people.first/last_touch_at\n-- Kept as a cache of min/max(touches.occurred_at), now by the database for\n-- every writer (the collector did read-then-write; issue touches didn't update\n-- it at all). greatest/least on insert is safe under concurrent inserts.\ncreate function touches_person_span() returns trigger language plpgsql security definer set search_path = public as $$\nbegin\n  if tg_op = 'INSERT' then\n    update people set first_touch_at = least(first_touch_at, new.occurred_at),\n                      last_touch_at = greatest(last_touch_at, new.occurred_at)\n    where id = new.person_id\n      and (first_touch_at is null or last_touch_at is null or new.occurred_at < first_touch_at or new.occurred_at > last_touch_at);\n  else\n    update people p set first_touch_at = s.lo, last_touch_at = s.hi\n    from (select x.id, (select min(occurred_at) from touches where person_id = x.id) lo,\n                       (select max(occurred_at) from touches where person_id = x.id) hi\n          from (select old.person_id as id union select new.person_id) x where x.id is not null) s\n    where p.id = s.id;\n  end if;\n  return null;\nend $$;\ncreate trigger touches_person_span after insert or delete or update of person_id, occurred_at on touches\n  for each row execute function touches_person_span();\nrevoke execute on function touches_person_span() from public, anon, authenticated;\n\n-- The decision RPC no longer sets last_touch_at itself: its touch does.\ncreate or replace function record_draft_outcome(\n  p_draft_id uuid,\n  p_outcome draft_outcome,\n  p_final_text text default null,\n  p_posted_url text default null,\n  p_move_stage person_stage default null\n) returns drafts\nlanguage plpgsql security definer set search_path = public as $$\ndeclare\n  d drafts;\n  it items;\n  uid uuid := auth.uid();\n  posted boolean := p_outcome in ('posted_as_is', 'posted_edited');\nbegin\n  if p_outcome not in ('posted_as_is', 'posted_edited', 'skipped') then raise exception 'bad_outcome'; end if;\n  if posted and coalesce(btrim(p_final_text), '') = '' then raise exception 'final_text_required'; end if;\n  select * into d from drafts where id = p_draft_id for update;\n  if not found then raise exception 'not_found'; end if;\n  select * into it from items where id = d.item_id for update;\n  if uid is null or not is_member(it.project_id) then raise exception 'not_found'; end if;\n  if d.outcome is not null then raise exception 'already_decided'; end if;\n\n  update drafts set\n    outcome = p_outcome,\n    final_text = case when posted then p_final_text else final_text end,\n    posted_url = case when posted then p_posted_url else posted_url end,\n    posted_at = case when posted then now() else posted_at end,\n    posted_by = case when posted then uid else posted_by end,\n    decided_by = uid, decided_at = now()\n  where id = p_draft_id returning * into d;\n\n  update drafts set outcome = 'superseded', decided_at = now()\n  where item_id = it.id and id <> p_draft_id and outcome is null;\n\n  update items set status = case when posted then 'answered'::item_status else 'skipped'::item_status end,\n                   skip_reason = null\n  where id = it.id;\n\n  if posted then\n    insert into touches (project_id, person_id, direction, platform, kind, occurred_at, url, text, item_id, by_founder, source)\n    values (it.project_id, it.person_id, 'out', it.platform, 'reply', now(), p_posted_url, p_final_text, it.id, uid, 'app');\n    update people set\n      stage = coalesce(p_move_stage, case when stage = 'noticed' then 'talking'::person_stage else stage end)\n    where id = it.person_id;\n  elsif p_move_stage is not null then\n    update people set stage = p_move_stage where id = it.person_id;\n  end if;\n  return d;\nend $$;\n\n-- ------------------------------------------------------------------ 1NF: plans.allowed_models\n-- The array was a relation in disguise (searched with = any in three\n-- functions). One row per (plan, model); ord keeps the order the app lists.\ncreate table plan_models (\n  plan_id text not null,\n  model text not null,\n  ord smallint not null default 0,\n  primary key (plan_id, model),\n  constraint plan_models_plan_fkey foreign key (plan_id) references plans (id) on delete cascade\n);\ninsert into plan_models (plan_id, model, ord)\n  select p.id, m.model, m.n from plans p, unnest(p.allowed_models) with ordinality as m(model, n);\n\n-- The default is one of the plan's models (deferred: a plan and its models are\n-- inserted in one transaction).\nalter table plans drop constraint plans_default_allowed;\nalter table plans add constraint plans_default_model_fkey foreign key (id, default_model)\n  references plan_models (plan_id, model) deferrable initially deferred;\n\nalter table plan_models enable row level security;\ncreate policy signed_in_read on plan_models for select to authenticated using (true);\nrevoke all on plan_models from anon, authenticated;\ngrant select on plan_models to authenticated;\n\n-- Same rule as before: an override is checked when it is set; if the plan later\n-- drops the model (or the founder changes plan), the server falls back to the\n-- plan default instead. That's why this stays a trigger, not a foreign key.\ncreate or replace function check_founder_draft_model() returns trigger\n  language plpgsql set search_path = public as $$\nbegin\n  if new.draft_model is not null\n     and (tg_op = 'INSERT' or new.draft_model is distinct from old.draft_model)\n     and not exists (select 1 from plan_models m where m.plan_id = new.plan_id and m.model = new.draft_model) then\n    raise exception 'model_not_allowed' using errcode = '23514', detail = format('%s is not in plan %s', new.draft_model, new.plan_id);\n  end if;\n  return new;\nend $$;\n\ncreate or replace function my_draft_model() returns jsonb\n  language sql stable security definer set search_path = public as $$\n  select jsonb_build_object(\n    'plan_id', p.id, 'plan_name', p.name, 'default_model', p.default_model,\n    'allowed_models', coalesce((select jsonb_agg(m.model order by m.ord, m.model) from plan_models m where m.plan_id = p.id), '[]'::jsonb),\n    'draft_model', f.draft_model,\n    'effective_model', case when exists (select 1 from plan_models m where m.plan_id = p.id and m.model = f.draft_model)\n                            then f.draft_model else p.default_model end)\n  from founders f join plans p on p.id = f.plan_id\n  where f.id = auth.uid()\n$$;\n\ncreate or replace function set_draft_model(model text) returns jsonb\n  language plpgsql security definer set search_path = public as $$\ndeclare\n  m text := nullif(btrim(model), '');\nbegin\n  if auth.uid() is null then raise exception 'not_found'; end if;\n  if m is not null and not exists (\n    select 1 from founders f join plan_models pm on pm.plan_id = f.plan_id\n    where f.id = auth.uid() and pm.model = m) then\n    raise exception 'model_not_allowed' using errcode = '23514';\n  end if;\n  update founders set draft_model = m where id = auth.uid();\n  if not found then raise exception 'not_found'; end if;\n  return my_draft_model();\nend $$;\n\nalter table plans drop column allowed_models;\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"cat 'supabase/migrations/20261008230200_backend_v1.sql'\"","aggregated_output":"-- Backend v1 (docs/API.md): what the MVP screens need on top of the init\n-- schema. Onboarding (project from a landing page), triage on items, drafts by\n-- intent, ideas from feedback, the draft decision as one transaction, Vault\n-- for Bluesky app passwords, an inbox view grouped by person, realtime.\n\n-- ------------------------------------------------------------------ projects\nalter table projects\n  add column url text,\n  add column description text,\n  add column topics text[] not null default '{}',\n  add column competitors text[] not null default '{}',\n  add column aims text,\n  add column landing jsonb,\n  add column landing_read_at timestamptz,\n  add column github_repo text check (github_repo is null or github_repo ~ '^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$'),\n  add column knowledge_sources jsonb not null default '{}';\nalter table projects alter column audience type text[]\n  using case when audience is null or audience = '' then '{}'::text[] else array[audience] end;\nalter table projects alter column audience set default '{}';\nalter table projects alter column audience set not null;\n\n-- ------------------------------------------------------------------ accounts\nalter table accounts\n  add column last_error text,\n  add column settings jsonb not null default '{}';\n\n-- The app may create a dev.to account row and switch accounts on/off, but\n-- never set secret_id, external_id or the poll cursor: those belong to the\n-- server (a forged secret_id could point the poller at another project's secret).\nrevoke insert, update on accounts from authenticated;\ngrant insert (project_id, platform, handle, auth, connected_by, active, settings) on accounts to authenticated;\ngrant update (project_id, platform, handle, auth, connected_by, active, settings) on accounts to authenticated;\nalter table accounts add constraint accounts_app_no_secret check (auth <> 'none' or secret_id is null);\n\n-- ------------------------------------------------------------------ people\nalter table people add column stage_changed_at timestamptz;\n\ncreate function people_touch_updated() returns trigger language plpgsql as $$\nbegin\n  new.updated_at := now();\n  if new.stage is distinct from old.stage then new.stage_changed_at := now(); end if;\n  return new;\nend $$;\ncreate trigger people_updated before update on people for each row execute function people_touch_updated();\n\n-- ------------------------------------------------------------------ items\nalter table items alter column account_id drop not null;\nalter table items\n  add column origin text not null default 'inbox' check (origin in ('inbox', 'discover')),\n  add column triaged_at timestamptz,\n  add column skip_reason text,\n  add column discovery jsonb,\n  add column triage_kind text generated always as (triage->>'kind') stored,\n  add column triage_action text generated always as (triage->>'suggested_action') stored,\n  add column triage_confidence real generated always as ((triage->>'confidence')::real) stored,\n  add column triage_summary text generated always as (triage->>'summary') stored;\ncreate index items_inbox on items (project_id, origin, status, posted_at desc);\ncreate index items_untriaged on items (fetched_at) where triaged_at is null and origin = 'inbox';\ncreate index items_person on items (person_id, posted_at desc);\n\n-- ------------------------------------------------------------------ drafts\nalter table drafts\n  add column intent text check (intent in ('just_answer', 'invite_to_try', 'ask_feedback', 'ask_price', 'auto')),\n  add column variant text not null default 'first' check (variant in ('first', 'shorter', 'redraft')),\n  add column checks text[] not null default '{}',\n  add column sources jsonb not null default '[]',\n  add column lint jsonb,\n  add column decided_by uuid references founders(id) on delete set null,\n  add column decided_at timestamptz;\n\n-- ------------------------------------------------------------------ ideas\n-- Feedback turned into something to build. Similar asks from different\n-- people are grouped into one idea; asked_by counts distinct people.\ncreate table ideas (\n  id uuid primary key default gen_random_uuid(),\n  project_id uuid not null references projects(id) on delete cascade,\n  title text not null,\n  summary text,\n  quote text,                       -- the exact phrase heard (first ask)\n  kind text not null default 'feature' check (kind in ('feature', 'bug', 'pain', 'would_pay', 'other')),\n  asked_by int not null default 0,  -- distinct people, kept by trigger\n  status text not null default 'new' check (status in ('new', 'planned', 'issue_open', 'not_now', 'done')),\n  github_issue_url text,\n  github_issue_number int,\n  created_at timestamptz not null default now(),\n  updated_at timestamptz not null default now()\n);\ncreate index ideas_project on ideas (project_id, status, updated_at desc);\n\ncreate table idea_items (\n  idea_id uuid not null references ideas(id) on delete cascade,\n  item_id uuid not null references items(id) on delete cascade,\n  person_id uuid not null references people(id) on delete cascade,\n  project_id uuid not null references projects(id) on delete cascade,\n  quote text,\n  created_at timestamptz not null default now(),\n  primary key (idea_id, item_id)\n);\ncreate index idea_items_item on idea_items (item_id);\n\nalter table ideas enable row level security;\ncreate policy members_all on ideas for all using (is_member(project_id)) with check (is_member(project_id));\nalter table idea_items enable row level security;\ncreate policy members_all on idea_items for all using (is_member(project_id)) with check (is_member(project_id));\n\ncreate function ideas_recount() returns trigger language plpgsql security definer set search_path = public as $$\ndeclare i uuid := coalesce(new.idea_id, old.idea_id);\nbegin\n  update ideas set asked_by = (select count(distinct person_id) from idea_items where idea_id = i), updated_at = now()\n  where id = i;\n  return null;\nend $$;\ncreate trigger idea_items_count after insert or delete on idea_items for each row execute function ideas_recount();\n\n-- ------------------------------------------------------------------ decision RPC\n-- The founder's decision on a draft, atomically (app/README.md asked for it).\n-- security definer with an explicit membership check: the caller must be a\n-- member of the draft's project.\ncreate function record_draft_outcome(\n  p_draft_id uuid,\n  p_outcome draft_outcome,\n  p_final_text text default null,\n  p_posted_url text default null,\n  p_move_stage person_stage default null\n) returns drafts\nlanguage plpgsql security definer set search_path = public as $$\ndeclare\n  d drafts;\n  it items;\n  uid uuid := auth.uid();\n  posted boolean := p_outcome in ('posted_as_is', 'posted_edited');\nbegin\n  if p_outcome not in ('posted_as_is', 'posted_edited', 'skipped') then raise exception 'bad_outcome'; end if;\n  if posted and coalesce(btrim(p_final_text), '') = '' then raise exception 'final_text_required'; end if;\n  select * into d from drafts where id = p_draft_id for update;\n  if not found then raise exception 'not_found'; end if;\n  select * into it from items where id = d.item_id for update;\n  if uid is null or not is_member(it.project_id) then raise exception 'not_found'; end if;\n  if d.outcome is not null then raise exception 'already_decided'; end if;\n\n  update drafts set\n    outcome = p_outcome,\n    final_text = case when posted then p_final_text else final_text end,\n    posted_url = case when posted then p_posted_url else posted_url end,\n    posted_at = case when posted then now() else posted_at end,\n    posted_by = case when posted then uid else posted_by end,\n    decided_by = uid, decided_at = now()\n  where id = p_draft_id returning * into d;\n\n  update drafts set outcome = 'superseded', decided_at = now()\n  where item_id = it.id and id <> p_draft_id and outcome is null;\n\n  update items set status = case when posted then 'answered'::item_status else 'skipped'::item_status end,\n                   skip_reason = null\n  where id = it.id;\n\n  if posted then\n    insert into touches (project_id, person_id, direction, platform, kind, occurred_at, url, text, item_id, by_founder, source)\n    values (it.project_id, it.person_id, 'out', it.platform, 'reply', now(), p_posted_url, p_final_text, it.id, uid, 'app');\n    update people set\n      last_touch_at = now(),\n      stage = coalesce(p_move_stage, case when stage = 'noticed' then 'talking'::person_stage else stage end)\n    where id = it.person_id;\n  elsif p_move_stage is not null then\n    update people set stage = p_move_stage where id = it.person_id;\n  end if;\n  return d;\nend $$;\nrevoke execute on function record_draft_outcome(uuid, draft_outcome, text, text, person_stage) from public, anon;\ngrant execute on function record_draft_outcome(uuid, draft_outcome, text, text, person_stage) to authenticated, service_role;\n\n-- ------------------------------------------------------------------ Vault\n-- Bluesky app passwords live in Vault; only the service role (Edge Functions)\n-- can store or read them. The secret's name binds it to its account.\ncreate function store_account_secret(p_account uuid, p_secret text) returns uuid\nlanguage plpgsql security definer set search_path = public, vault as $$\ndeclare sid uuid;\nbegin\n  select secret_id into sid from accounts where id = p_account;\n  if not found then raise exception 'not_found'; end if;\n  if sid is not null and exists (select 1 from vault.secrets where id = sid) then\n    perform vault.update_secret(sid, p_secret);\n  else\n    sid := vault.create_secret(p_secret, 'account:' || p_account::text || ':' || gen_random_uuid()::text, 'hearback account credential');\n    update accounts set secret_id = sid where id = p_account;\n  end if;\n  return sid;\nend $$;\n\ncreate function read_account_secret(p_account uuid) returns text\nlanguage sql stable security definer set search_path = public, vault as $$\n  select s.decrypted_secret\n  from accounts a join vault.decrypted_secrets s on s.id = a.secret_id\n  where a.id = p_account and s.name like 'account:' || p_account::text || ':%';\n$$;\n\ncreate function delete_account_secret(p_account uuid) returns void\nlanguage plpgsql security definer set search_path = public, vault as $$\ndeclare sid uuid;\nbegin\n  select secret_id into sid from accounts where id = p_account;\n  if sid is not null then\n    delete from vault.secrets where id = sid;\n    update accounts set secret_id = null where id = p_account;\n  end if;\nend $$;\n\nrevoke execute on function store_account_secret(uuid, text) from public, anon, authenticated;\nrevoke execute on function read_account_secret(uuid) from public, anon, authenticated;\nrevoke execute on function delete_account_secret(uuid) from public, anon, authenticated;\ngrant execute on function store_account_secret(uuid, text) to service_role;\ngrant execute on function read_account_secret(uuid) to service_role;\ngrant execute on function delete_account_secret(uuid) to service_role;\n\n-- ------------------------------------------------------------------ inbox view\n-- One row per person with something waiting (design 1g: grouped by person).\ncreate view inbox_by_person with (security_invoker = true) as\nwith w as (\n  select i.*, row_number() over (partition by i.person_id order by i.posted_at desc) rn\n  from items i\n  where i.origin = 'inbox' and i.status in ('new', 'draft_ready')\n)\nselect\n  w.project_id, w.person_id, p.display_name, p.avatar_url, p.stage,\n  count(*)::int as waiting,\n  count(*) filter (where w.status = 'new')::int as needs_you,\n  count(*) filter (where w.status = 'draft_ready')::int as draft_ready,\n  array_agg(distinct w.platform::text) as platforms,\n  max(w.id::text) filter (where w.rn = 1)::uuid as last_item_id,\n  max(w.text) filter (where w.rn = 1) as last_item_text,\n  max(w.kind::text) filter (where w.rn = 1) as last_item_kind,\n  max(w.platform::text) filter (where w.rn = 1) as last_item_platform,\n  max(w.posted_at) as last_posted_at,\n  max(w.status::text) filter (where w.rn = 1) as last_status,\n  (select d.text from drafts d where d.item_id = max(w.id::text) filter (where w.rn = 1)::uuid and d.outcome is null\n     order by d.version desc limit 1) as last_draft_text,\n  exists (select 1 from idea_items ii where ii.person_id = w.person_id) as has_idea\nfrom w join people p on p.id = w.person_id\ngroup by w.project_id, w.person_id, p.display_name, p.avatar_url, p.stage;\nrevoke all on inbox_by_person from anon;\ngrant select on inbox_by_person to authenticated;\n\n-- ------------------------------------------------------------------ realtime\ndo $$ begin\n  if exists (select 1 from pg_publication where pubname = 'supabase_realtime') then\n    alter publication supabase_realtime add table items, drafts, ideas;\n  end if;\nend $$;\n\n-- anon stays closed (20261008180000_no_anon) for everything created here.\nrevoke all on ideas, idea_items from anon;\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"cat 'supabase/migrations/20261008170000_init.sql'\"","aggregated_output":"-- Hearback schema v1 (draft 2, 2026-10-08). Not applied until reviewed.\n--\n-- Founders (users) sign in with Supabase Auth. A project can have several\n-- founders, and a founder can be in several projects (project_members). A\n-- project listens on accounts (Bluesky, dev.to…), turns what needs an answer\n-- into items, files them under themes (\"MCP servers\"), drafts replies with the\n-- theme's knowledge, and keeps every person's public profile and full history\n-- of touches. Row-level security from day one: a row is visible only to members\n-- of its project. Platform credentials never leave the database unencrypted:\n-- they live in Supabase Vault, readable only by the service role (the collector\n-- and the draft engine), never by the app.\n\ncreate extension if not exists \"pgcrypto\";\n\ncreate type platform as enum ('bluesky', 'devto', 'github', 'threads', 'habr', 'reddit', 'x', 'email', 'other');\ncreate type member_role as enum ('owner', 'member');\ncreate type item_kind as enum ('reply', 'mention', 'quote', 'comment');\ncreate type item_status as enum ('new', 'draft_ready', 'answered', 'skipped');\ncreate type person_stage as enum ('noticed', 'talking', 'engaged', 'supporter', 'would_try', 'customer', 'not_a_fit');\ncreate type touch_direction as enum ('in', 'out');\ncreate type draft_outcome as enum ('posted_as_is', 'posted_edited', 'skipped', 'superseded');\ncreate type memory_kind as enum ('voice_sample', 'preference', 'need', 'faq', 'fact', 'position');\ncreate type auth_kind as enum ('none', 'oauth', 'app_password', 'api_key');\n\n-- ------------------------------------------------------------------ founders\n-- auth.users holds the login; this is the founder's own profile.\ncreate table founders (\n  id uuid primary key references auth.users(id) on delete cascade,\n  display_name text,\n  avatar_url text,\n  voice_notes text,               -- how this founder writes (tone, habits), used in their drafts\n  languages text[] not null default '{en}',\n  created_at timestamptz not null default now()\n);\n\n-- ------------------------------------------------------------------ projects\ncreate table projects (\n  id uuid primary key default gen_random_uuid(),\n  name text not null,\n  one_liner text,                 -- the product in one sentence\n  audience text,                  -- who it's for\n  views text,                     -- what the team believes\n  red_lines text,                 -- never promise / never say\n  tone text,\n  languages text[] not null default '{en}',\n  links jsonb not null default '[]',   -- [{title, url}] landing, repo, key articles\n  created_by uuid references founders(id) on delete set null,\n  created_at timestamptz not null default now()\n);\n\ncreate table project_members (\n  project_id uuid not null references projects(id) on delete cascade,\n  founder_id uuid not null references founders(id) on delete cascade,\n  role member_role not null default 'member',\n  joined_at timestamptz not null default now(),\n  primary key (project_id, founder_id)\n);\n\n-- Pending invitations by email; accepted on first sign-in with that email.\ncreate table project_invites (\n  id uuid primary key default gen_random_uuid(),\n  project_id uuid not null references projects(id) on delete cascade,\n  email text not null,\n  role member_role not null default 'member',\n  invited_by uuid references founders(id) on delete set null,\n  created_at timestamptz not null default now(),\n  accepted_at timestamptz,\n  unique (project_id, email)\n);\n\n-- ------------------------------------------------------------------ accounts\n-- A listened-to account of the project on a platform. The credential (an OAuth\n-- token set, an app password or an API key) is a Vault secret referenced by id;\n-- dev.to needs none for reading (auth = 'none').\ncreate table accounts (\n  id uuid primary key default gen_random_uuid(),\n  project_id uuid not null references projects(id) on delete cascade,\n  platform platform not null,\n  handle text not null,\n  external_id text,               -- e.g. Bluesky DID\n  auth auth_kind not null default 'none',\n  secret_id uuid,                 -- vault.secrets.id; null when auth = 'none'\n  connected_by uuid references founders(id) on delete set null,\n  cursor text,                    -- platform paging cursor of the last poll\n  last_polled_at timestamptz,\n  active boolean not null default true,\n  unique (project_id, platform, handle)\n);\n\n-- ------------------------------------------------------------------ themes\n-- A topic conversations come back to (\"MCP servers\", \"agent skills\"). Items are\n-- filed under themes, and a theme carries its own positions, facts and sources,\n-- so drafts inside one theme stay consistent.\ncreate table themes (\n  id uuid primary key default gen_random_uuid(),\n  project_id uuid not null references projects(id) on delete cascade,\n  name text not null,\n  description text,               -- what belongs here (used to auto-file items)\n  position text,                  -- the team's stance on this theme\n  created_at timestamptz not null default now(),\n  unique (project_id, name)\n);\n\n-- ------------------------------------------------------------------ people\n-- A person the project talks to, however many platforms they're on.\n-- Deleting a person deletes everything about them: identities, their items\n-- (and the drafts under them), touches.\ncreate table people (\n  id uuid primary key default gen_random_uuid(),\n  project_id uuid not null references projects(id) on delete cascade,\n  display_name text,\n  avatar_url text,\n  summary text,                   -- who they are, written from public profile + touches\n  builds text,                    -- what they build\n  cares_about text,               -- what they ask for / complain about / want\n  stage person_stage not null default 'noticed',\n  notes text,                     -- the founders' own notes\n  first_touch_at timestamptz,\n  last_touch_at timestamptz,\n  created_at timestamptz not null default now(),\n  updated_at timestamptz not null default now()\n);\n\n-- A person's account on one platform, with a snapshot of the public profile\n-- (bio, links, location, counts, join date — whatever the platform shows).\ncreate table identities (\n  id uuid primary key default gen_random_uuid(),\n  project_id uuid not null references projects(id) on delete cascade,\n  person_id uuid not null references people(id) on delete cascade,\n  platform platform not null,\n  handle text not null,\n  external_id text,\n  profile_url text,\n  public_profile jsonb,           -- raw public profile as fetched\n  profile_fetched_at timestamptz,\n  unique (project_id, platform, handle)\n);\n\n-- ------------------------------------------------------------------ items\n-- Something that may need an answer: a reply, mention, quote, comment.\ncreate table items (\n  id uuid primary key default gen_random_uuid(),\n  project_id uuid not null references projects(id) on delete cascade,\n  account_id uuid not null references accounts(id) on delete cascade,\n  person_id uuid not null references people(id) on delete cascade,\n  platform platform not null,\n  kind item_kind not null,\n  external_id text not null,      -- the platform's id/uri for this post or comment\n  url text,\n  text text not null,\n  posted_at timestamptz not null,\n  root_ref jsonb,                 -- what a reply must point at (Bluesky root/parent uri+cid; dev.to comment id)\n  parent_ref jsonb,\n  my_post jsonb,                  -- {url, title, text} snapshot of the project's post/article it's under\n  thread jsonb,                   -- [{author, text, posted_at}] snapshot of the thread above\n  status item_status not null default 'new',\n  assigned_to uuid references founders(id) on delete set null,   -- who answers it\n  fetched_at timestamptz not null default now(),\n  unique (project_id, platform, external_id)\n);\ncreate index items_waiting on items (project_id, status, posted_at desc);\n\ncreate table item_themes (\n  item_id uuid not null references items(id) on delete cascade,\n  theme_id uuid not null references themes(id) on delete cascade,\n  auto boolean not null default true,   -- filed by the model (true) or by a founder\n  primary key (item_id, theme_id)\n);\n\n-- Every draft version, so models can be compared on real outcomes.\ncreate table drafts (\n  id uuid primary key default gen_random_uuid(),\n  item_id uuid not null references items(id) on delete cascade,\n  version int not null,\n  instruction text,               -- null for the first; 'shorter' / a redraft note\n  text text not null,\n  provider text not null,         -- gemini / anthropic / …\n  model text not null,\n  tokens_in int,\n  tokens_out int,\n  latency_ms int,\n  outcome draft_outcome,\n  final_text text,                -- what was actually posted (after edits)\n  posted_by uuid references founders(id) on delete set null,\n  posted_url text,\n  posted_at timestamptz,\n  created_at timestamptz not null default now(),\n  unique (item_id, version)\n);\n\n-- ------------------------------------------------------------------ touches\n-- Every touch with a person, both directions, any channel (comments, replies,\n-- emails, outreach), including imports from the outreach sheet.\ncreate table touches (\n  id uuid primary key default gen_random_uuid(),\n  project_id uuid not null references projects(id) on delete cascade,\n  person_id uuid not null references people(id) on delete cascade,\n  direction touch_direction not null,\n  platform platform not null,\n  kind text not null,             -- comment / reply / mention / email / outreach / dm\n  occurred_at timestamptz not null,\n  url text,\n  text text,\n  item_id uuid references items(id) on delete cascade,\n  by_founder uuid references founders(id) on delete set null,   -- for outgoing touches\n  source text not null default 'collector',   -- collector / import:outreach-sheet / manual\n  meta jsonb not null default '{}'\n);\ncreate index touches_by_person on touches (person_id, occurred_at desc);\n\n-- ------------------------------------------------------------------ knowledge\n-- What drafts know beyond the thread, for the whole project or one theme.\ncreate table project_memory (\n  id uuid primary key default gen_random_uuid(),\n  project_id uuid not null references projects(id) on delete cascade,\n  theme_id uuid references themes(id) on delete cascade,   -- null = whole project\n  kind memory_kind not null,\n  text text not null,\n  source_url text,\n  active boolean not null default true,\n  created_at timestamptz not null default now()\n);\n\n-- The project's own material (landing, articles, stories) for retrieval.\ncreate table documents (\n  id uuid primary key default gen_random_uuid(),\n  project_id uuid not null references projects(id) on delete cascade,\n  theme_id uuid references themes(id) on delete set null,\n  kind text not null,             -- landing / article / story / doc\n  url text not null,\n  title text,\n  content text not null,\n  fetched_at timestamptz not null default now(),\n  unique (project_id, url)\n);\n\n-- ------------------------------------------------------------------ security\n-- Membership check used by every policy; security definer so policies don't\n-- recurse through project_members' own policy.\ncreate function is_member(p uuid) returns boolean\n  language sql stable security definer set search_path = public as\n  $$ select exists (select 1 from project_members where project_id = p and founder_id = auth.uid()) $$;\n\ncreate function is_owner(p uuid) returns boolean\n  language sql stable security definer set search_path = public as\n  $$ select exists (select 1 from project_members where project_id = p and founder_id = auth.uid() and role = 'owner') $$;\n\nalter table founders enable row level security;\ncreate policy self on founders for all using (id = auth.uid()) with check (id = auth.uid());\n-- teammates can see each other's name and avatar\ncreate policy teammates on founders for select using (\n  id in (select m.founder_id from project_members m where is_member(m.project_id)));\n\nalter table projects enable row level security;\ncreate policy members_read on projects for select using (is_member(id));\ncreate policy owners_write on projects for update using (is_owner(id)) with check (is_owner(id));\ncreate policy owners_delete on projects for delete using (is_owner(id));\ncreate policy anyone_creates on projects for insert with check (created_by = auth.uid());\n\nalter table project_members enable row level security;\ncreate policy members_read on project_members for select using (is_member(project_id));\ncreate policy owners_manage on project_members for all using (is_owner(project_id)) with check (is_owner(project_id));\n\nalter table project_invites enable row level security;\ncreate policy owners_manage on project_invites for all using (is_owner(project_id)) with check (is_owner(project_id));\n\ndo $$\ndeclare t text;\nbegin\n  foreach t in array array['accounts','themes','people','identities','items','touches','project_memory','documents'] loop\n    execute format('alter table %I enable row level security', t);\n    execute format($p$create policy members_all on %I for all\n      using (is_member(project_id)) with check (is_member(project_id))$p$, t);\n  end loop;\nend $$;\n\nalter table item_themes enable row level security;\ncreate policy members_all on item_themes for all\n  using (exists (select 1 from items i where i.id = item_id and is_member(i.project_id)))\n  with check (exists (select 1 from items i where i.id = item_id and is_member(i.project_id)));\n\nalter table drafts enable row level security;\ncreate policy members_all on drafts for all\n  using (exists (select 1 from items i where i.id = item_id and is_member(i.project_id)))\n  with check (exists (select 1 from items i where i.id = item_id and is_member(i.project_id)));\n\n-- The creator of a project becomes its owner.\ncreate function add_creator_as_owner() returns trigger\n  language plpgsql security definer set search_path = public as $$\nbegin\n  if new.created_by is not null then\n    insert into project_members (project_id, founder_id, role) values (new.id, new.created_by, 'owner')\n    on conflict do nothing;\n  end if;\n  return new;\nend $$;\ncreate trigger project_owner after insert on projects for each row execute function add_creator_as_owner();\n\n-- A founder row for every new login, and pending invites accepted by email.\ncreate function on_new_user() returns trigger\n  language plpgsql security definer set search_path = public as $$\nbegin\n  insert into founders (id, display_name, avatar_url)\n  values (new.id, coalesce(new.raw_user_meta_data->>'full_name', new.raw_user_meta_data->>'name'),\n          new.raw_user_meta_data->>'avatar_url')\n  on conflict do nothing;\n  insert into project_members (project_id, founder_id, role)\n    select project_id, new.id, role from project_invites\n    where lower(email) = lower(new.email) and accepted_at is null\n  on conflict do nothing;\n  update project_invites set accepted_at = now()\n    where lower(email) = lower(new.email) and accepted_at is null;\n  return new;\nend $$;\ncreate trigger founder_on_signup after insert on auth.users for each row execute function on_new_user();\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_7","type":"agent_message","text":"The repo already has a “normal forms” migration that removes several duplicated fields. I’m checking the effective schema after the later migrations, since some remaining copies and caches may still matter for 3NF."}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc 'for f in supabase/migrations/*.sql; do case \"$f\" in *init.sql|*knowledge_chunks.sql|*backend_v1.sql|*normal_forms.sql) continue;; esac; echo \"$f\"; rg -n -i -C 3 '\"'create table|alter table|add column|drop column|create unique|create index|create view' \\\"\"'$f\"; done'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc 'for f in supabase/migrations/*.sql; do case \"$f\" in *init.sql|*knowledge_chunks.sql|*backend_v1.sql|*normal_forms.sql) continue;; esac; echo \"$f\"; rg -n -i -C 3 '\"'create table|alter table|add column|drop column|create unique|create index|create view' \\\"\"'$f\"; done'","aggregated_output":"supabase/migrations/20261008180000_no_anon.sql\nsupabase/migrations/20261008190000_waitlist.sql\n1--- The landing page's waitlist. Anonymous visitors can ADD an email, nothing\n2--- else: no read, no update, no delete (the table is otherwise closed to anon,\n3--- see 20261008180000_no_anon). Founders read it with the service role.\n4:create table waitlist (\n5-  id uuid primary key default gen_random_uuid(),\n6-  email text not null check (email ~* '^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$' and length(email) <= 254),\n7-  role text check (length(role) <= 120),          -- optional: \"founder\", \"devrel\", ...\n--\n9-  source text check (length(source) <= 200),       -- utm / referrer\n10-  created_at timestamptz not null default now()\n11-);\n12:create unique index waitlist_email on waitlist (lower(email));\n13:alter table waitlist enable row level security;\n14-create policy anyone_can_join on waitlist for insert to anon, authenticated with check (true);\n15-grant insert (email, role, note, source) on waitlist to anon, authenticated;\nsupabase/migrations/20261008230000_enum_values.sql\nsupabase/migrations/20261008230300_cron.sql\nsupabase/migrations/20261008230400_server_state.sql\n36-grant execute on function store_account_session(uuid, text) to service_role;\n37-grant execute on function read_account_session(uuid) to service_role;\n38-\n39:create table usage_counters (\n40-  day date not null default (now() at time zone 'utc')::date,\n41-  key text not null,\n42-  n int not null default 0,\n43-  primary key (day, key)\n44-);\n45:alter table usage_counters enable row level security;  -- no policies: service role only\n46-revoke all on usage_counters from anon, authenticated;\n47-\n48--- Adds one request under p_key for today; false (and no increment) when the cap is reached.\nsupabase/migrations/20261008230500_project_creator_read.sql\nsupabase/migrations/20261009150000_project_url_key.sql\n26-  end\n27-$$;\n28-\n29:alter table projects add column url_key text generated always as (hb_url_key(url)) stored;\n30-\n31--- Existing duplicates are kept (deleting needs the owner's OK) but marked, so\n32--- the unique index can hold for everything else. The app lists a duplicate\n33--- after the project it duplicates.\n34:alter table projects add column duplicate_of uuid references projects(id) on delete set null;\n35-\n36--- Valentina's two worklore projects: the app works in 45c38f0b (created by her\n37--- onboarding); the overnight seed 18789261 is the duplicate.\n--\n47- where p.duplicate_of is null and p.url_key is not null and exists (\n48-  select 1 from projects q where q.created_by = p.created_by and q.url_key = p.url_key and q.created_at > p.created_at);\n49-\n50:create unique index projects_creator_url_key on projects (created_by, url_key)\n51-  where url_key is not null and duplicate_of is null;\n52-\n53--- The founder's projects (member of) with this URL, oldest first. Used by\nsupabase/migrations/20261009150100_url_key_bare_host.sql\nsupabase/migrations/20261009160000_bluesky_cron_off.sql\nsupabase/migrations/20261009190000_draft_model_settings.sql\n11---   {input, output, cache_read?, cache_write?, cost_usd?}\n12--- (tokens_in / tokens_out stay as the totals.)\n13-\n14:alter table projects add column if not exists settings jsonb not null default '{}';\n15:alter table drafts add column if not exists tokens jsonb;\nsupabase/migrations/20261009200000_plans_user_model.sql\n12---                       set_draft_model(). The server resolves the model per\n13---                       draft in _shared/server/models.ts › modelForUser.\n14-\n15:create table if not exists plans (\n16-  id text primary key,\n17-  name text not null,\n18-  default_model text not null,\n--\n33-on conflict (id) do update\n34-  set name = excluded.name, default_model = excluded.default_model, allowed_models = excluded.allowed_models;\n35-\n36:alter table plans enable row level security;\n37-drop policy if exists signed_in_read on plans;\n38-create policy signed_in_read on plans for select to authenticated using (true);\n39-revoke all on plans from anon, authenticated;\n--\n41-\n42--- TODO(real users): switch the default to 'free' when people other than the\n43--- owner sign up. While only the owner uses Hearback, everyone is 'founder'.\n44:alter table founders add column if not exists plan_id text not null default 'founder' references plans (id);\n45:alter table founders add column if not exists draft_model text;\n46-\n47--- The founder edits her profile columns only; plan_id and draft_model change\n48--- through set_draft_model() (security definer) or the service role.\nsupabase/migrations/20261010010000_sources_voice_knowledge.sql\n8--- ------------------------------------------------------------------ voice samples\n9--- Voice is personal: rows belong to a founder, not to a project. project_id\n10--- only says where the sample was found.\n11:create table voice_samples (\n12-  id uuid primary key default gen_random_uuid(),\n13-  founder_id uuid not null references founders(id) on delete cascade,\n14-  project_id uuid references projects(id) on delete set null,\n--\n31-  unique (founder_id, platform, external_id),\n32-  unique (founder_id, text_sha256)\n33-);\n34:create index voice_samples_pending on voice_samples (created_at) where status = 'candidate';\n35:create index voice_samples_active on voice_samples (founder_id) where active;\n36-\n37:alter table voice_samples enable row level security;\n38--- Only the founder herself reads her samples; the server writes them.\n39-create policy self_read on voice_samples for select using (founder_id = auth.uid());\n40-revoke insert, update, delete on voice_samples from anon, authenticated;\n--\n42--- ------------------------------------------------------------------ sync state\n43--- One row per project and source: ETags, file SHAs, per-article counts, and\n44--- what the app shows (status, message, last sync).\n45:create table source_syncs (\n46-  id uuid primary key default gen_random_uuid(),\n47-  project_id uuid not null references projects(id) on delete cascade,\n48-  source text not null,                   -- 'devto:writing:yahhi', 'devto:articles:yahhi', 'github:owner/repo', 'landing'\n--\n53-  last_synced_at timestamptz,\n54-  unique (project_id, source)\n55-);\n56:alter table source_syncs enable row level security;\n57-create policy members_read on source_syncs for select using (is_member(project_id));\n58-revoke insert, update, delete on source_syncs from anon, authenticated;\n59-\n--\n61--- Which pipeline source produced a document, and a hash of it so a re-run\n62--- skips unchanged documents. 'seed' = written by the one-off seed script and\n63--- not (yet) reproduced by the pipeline; kept, still retrieved.\n64:alter table documents\n65:  add column source text,\n66:  add column content_sha256 text,\n67:  add column label text not null default 'quotable' check (label in ('quotable', 'background'));\n68:create index documents_source on documents (project_id, source);\n69-\n70--- Pages of the product's own site (landing + linked pages).\n71:alter table document_chunks drop constraint document_chunks_kind_check;\n72:alter table document_chunks add constraint document_chunks_kind_check\n73-  check (kind in ('article', 'story', 'research', 'changelog', 'readme', 'faq', 'fact', 'page'));\n74-\n75--- The folder in the linked GitHub repo whose .md/.txt files are synced.\n76:alter table projects add column github_folder text not null default 'hearback'\n77-  check (github_folder ~ '^[A-Za-z0-9_. -]+(/[A-Za-z0-9_. -]+)*$' and github_folder !~ '(^|/)\\.\\.(/|$)');\n78-\n79--- ------------------------------------------------------------------ posted replies\nsupabase/migrations/20261010020000_source_summary_branch.sql\nsupabase/migrations/20261010030000_github_app.sql\n6--- the app's key (a function secret) and never stored.\n7-\n8--- ------------------------------------------------------------------ installations\n9:create table github_installations (\n10-  installation_id bigint primary key,\n11-  account_login text not null,\n12-  account_type text not null default 'User',          -- User | Organization\n--\n20-  updated_at timestamptz not null default now()\n21-);\n22-\n23:create table github_installation_projects (\n24-  installation_id bigint not null references github_installations(installation_id) on delete cascade,\n25-  project_id uuid not null references projects(id) on delete cascade,\n26-  linked_by uuid references founders(id) on delete set null,\n27-  created_at timestamptz not null default now(),\n28-  primary key (installation_id, project_id)\n29-);\n30:create index github_installation_projects_project on github_installation_projects (project_id);\n31-\n32--- One-time state for the install URL: stored hashed, 15 minutes, single use.\n33:create table github_install_states (\n34-  id uuid primary key default gen_random_uuid(),\n35-  token_sha256 text not null unique,\n36-  founder_id uuid not null references founders(id) on delete cascade,\n--\n40-  expires_at timestamptz not null default now() + interval '15 minutes',\n41-  used_at timestamptz\n42-);\n43:create index github_install_states_expires on github_install_states (expires_at);\n44-\n45:alter table github_installations enable row level security;\n46:alter table github_installation_projects enable row level security;\n47:alter table github_install_states enable row level security;\n48-\n49--- Members of a linked project (and whoever connected it) read; only the server writes.\n50-create policy members_read on github_installation_projects for select using (is_member(project_id));\n--\n61-\n62--- ------------------------------------------------------------------ ideas → issues\n63--- Which repo the issue went to (the project's repo may change later).\n64:alter table ideas add column github_issue_repo text;\nsupabase/migrations/20261011010000_draft_checks.sql\n11---   final_text with \"[check\" (any case), and a constraint makes it a rule for\n12---   every writer.\n13-\n14:alter table drafts drop constraint drafts_variant_check;\n15:alter table drafts add constraint drafts_variant_check check (variant in ('first', 'shorter', 'redraft', 'resolve'));\n16-\n17:alter table drafts add column meta jsonb not null default '{}'::jsonb;\n18-\n19:alter table drafts add constraint drafts_posted_without_checks\n20-  check (outcome is null or outcome not in ('posted_as_is', 'posted_edited') or final_text is null or final_text !~* '\\[check');\n21-\n22-create or replace function record_draft_outcome(\nsupabase/migrations/20261011120000_tokens_generated_safe.sql\n13-$$;\n14-\n15--- NULL only when there is no token count at all; otherwise the sum of what's there.\n16:alter table drafts alter column tokens_in set expression as (\n17-  case when coalesce(hb_json_int(tokens->>'input'), hb_json_int(tokens->>'cache_read'),\n18-                     hb_json_int(tokens->>'cache_write')) is null then null\n19-       else coalesce(hb_json_int(tokens->>'input'), 0)\n20-          + coalesce(hb_json_int(tokens->>'cache_read'), 0)\n21-          + coalesce(hb_json_int(tokens->>'cache_write'), 0) end);\n22:alter table drafts alter column tokens_out set expression as (hb_json_int(tokens->>'output'));\nsupabase/migrations/20261012010000_intent_discuss.sql\n1--- Intent chips: \"Discuss\" (her view + one question that keeps the discussion\n2--- going, normal length) becomes the default chip. ask_feedback / ask_price\n3--- are no longer offered in the app but stay valid for existing drafts.\n4:alter table drafts drop constraint drafts_intent_check;\n5:alter table drafts add constraint drafts_intent_check\n6-  check (intent in ('discuss', 'just_answer', 'invite_to_try', 'ask_feedback', 'ask_price', 'auto'));\nsupabase/migrations/20261012020000_item_liked.sql\n1--- Like from the thread screen: the phone likes the comment on the network\n2--- (dev.to POST /reactions, with her session) and records it here so the\n3--- button shows it. null = not liked from Hearback.\n4:alter table items add column liked_at timestamptz;\nsupabase/migrations/20261012030000_item_spam_verdict.sql\n1--- Spam check (triage route spam_check: the comment looks like a plug). Her\n2--- answer: 'spam' (hidden on the network from the app, item skipped) or\n3--- 'not_spam' (treated as a usual comment). null = not asked / not answered.\n4:alter table items add column spam_verdict text check (spam_verdict in ('spam', 'not_spam'));\nsupabase/migrations/20261012040000_documents_kind_docs.sql\n1--- Documentation pages (a site's /docs, /guide, /help, a repo's docs/ folder)\n2--- get their own kind, so a draft can point to them as \"the docs\" (Invite to\n3--- try: draft/materials.ts).\n4:alter table documents drop constraint documents_kind_check;\n5:alter table documents add constraint documents_kind_check\n6-  check (kind in ('article', 'story', 'research', 'changelog', 'readme', 'faq', 'docs', 'fact', 'page'));\nsupabase/migrations/20261014010000_github_board_results.sql\n14--- ------------------------------------------------------------------ projects › board\n15--- owner + number is the board's address (github.com/orgs/<owner>/projects/<number>);\n16--- id is its GraphQL node id; title is GitHub's, cached for display.\n17:alter table projects\n18:  add column github_board_owner text check (github_board_owner is null or github_board_owner ~ '^[A-Za-z0-9-]+$'),\n19:  add column github_board_number int check (github_board_number is null or github_board_number > 0),\n20:  add column github_board_id text,\n21:  add column github_board_title text,\n22-  add constraint projects_github_board_whole check (\n23-    (github_board_owner is null) = (github_board_number is null)\n24-    and (github_board_owner is null) = (github_board_id is null));\n25-\n26--- ------------------------------------------------------------------ ideas › issue result\n27:alter table ideas\n28-  -- GitHub's view of the issue, as last read.\n29:  add column github_issue_state text check (github_issue_state in ('open', 'closed')),\n30:  add column github_issue_state_reason text,          -- completed | not_planned | duplicate | reopened\n31:  add column github_issue_closed_at timestamptz,\n32:  add column github_board_status text,                -- the board's Status option, if the issue is on the linked board\n33:  add column github_checked_at timestamptz,\n34-  -- What was done, in words she can edit before replies are drafted.\n35:  add column result_note text,\n36:  add column result_note_url text,                    -- the comment it came from\n37:  add column result_links jsonb not null default '[]',-- [{title, url, kind: pr|commit|link}]\n38:  add column result_drafted_at timestamptz;           -- follow-up drafts were made (once per result)\n39-\n40--- The sweep's queue: ideas with a real issue that are not settled yet.\n41:create index ideas_issue_watch on ideas (github_checked_at nulls first)\n42-  where github_issue_number is not null and result_drafted_at is null;\n43-\n44--- ------------------------------------------------------------------ drafts › intent\n45--- share_result: the follow-up \"what you asked for is done\" reply.\n46:alter table drafts drop constraint drafts_intent_check;\n47:alter table drafts add constraint drafts_intent_check\n48-  check (intent in ('discuss', 'just_answer', 'invite_to_try', 'ask_feedback', 'ask_price', 'share_result', 'auto'));\n49-\n50--- ------------------------------------------------------------------ cron\nsupabase/migrations/20261015010000_ask_code_model_calls.sql\n12--- from her machine (backlog). Members read their project's rows; only the\n13--- function writes them.\n14-\n15:create table model_calls (\n16-  id bigint generated always as identity primary key,\n17-  at timestamptz not null default now(),\n18-  fn text,                     -- the edge function (draft, triage, ask-code, …)\n--\n31-  cost_usd numeric(12, 6),     -- list price (pricing.ts); null: unknown or free (Gemini free key)\n32-  latency_ms int\n33-);\n34:create index model_calls_at on model_calls (at desc);\n35:create index model_calls_project on model_calls (project_id, at desc);\n36:create index model_calls_run on model_calls (run_id) where run_id is not null;\n37:alter table model_calls enable row level security;  -- no policies: service role only\n38-revoke all on model_calls from anon, authenticated;\n39-\n40-insert into model_calls (at, fn, purpose, project_id, item_id, provider, model, ok, tokens_in, tokens_out, usage, cost_usd, latency_ms)\n--\n42-       d.tokens_in, d.tokens_out, d.tokens, nullif(d.tokens->>'cost_usd', '')::numeric, d.latency_ms\n43-from drafts d join items i on i.id = d.item_id;\n44-\n45:create view model_spend_daily with (security_invoker = true) as\n46-select (at at time zone 'utc')::date as day, purpose, provider, model,\n47-       count(*) as calls,\n48-       count(*) filter (where not ok) as failed,\n--\n53-group by 1, 2, 3, 4;\n54-revoke all on model_spend_daily from anon, authenticated;\n55-\n56:create table code_questions (\n57-  id uuid primary key default gen_random_uuid(),\n58-  project_id uuid not null references projects(id) on delete cascade,\n59-  item_id uuid references items(id) on delete set null,\n--\n77-  answered_at timestamptz,\n78-  used_at timestamptz          -- she used the answer (it was saved to the project's knowledge)\n79-);\n80:create index code_questions_item on code_questions (item_id, created_at desc);\n81:create index code_questions_project on code_questions (project_id, created_at desc);\n82:alter table code_questions enable row level security;\n83-create policy members_read on code_questions for select using (is_member(project_id));\n84-revoke insert, update, delete on code_questions from anon, authenticated;\n","exit_code":0,"status":"completed"}}
