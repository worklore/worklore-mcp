{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,42p' supabase/functions/_shared/draft/providers/pricing.ts\"","aggregated_output":"// List prices in USD per million tokens, for drafts.tokens.cost_usd and the\n// eval's spend log. Source: https://platform.claude.com/docs/en/about-claude/pricing\n// (read 2026-10-09). Cache writes are the 5-minute TTL price. Haiku 5.5 is\n// priced higher for prompts over 100k tokens; drafts are ~6k, so the table\n// keeps only the short-prompt row. Gemini on the free key costs nothing.\n\nexport interface Price { input: number; output: number; cache_write: number; cache_read: number }\n\nexport const PRICES: Record<string, Price> = {\n  \"claude-haiku-5-5\": { input: 0.10, output: 0.50, cache_write: 0.125, cache_read: 0.01 },\n  \"claude-sonnet-5-5\": { input: 2, output: 10, cache_write: 2.50, cache_read: 0.10 },\n  \"claude-opus-5-5\": { input: 4, output: 20, cache_write: 5, cache_read: 0.20 },\n};\n\nexport function costUsd(model: string, u: { input: number; output: number; cache_read?: number; cache_write?: number }): number | undefined {\n  const p = PRICES[model] ?? PRICES[Object.keys(PRICES).find((k) => model.startsWith(k)) ?? \"\"];\n  if (!p) return undefined;\n  const usd = (u.input * p.input + u.output * p.output + (u.cache_write ?? 0) * p.cache_write + (u.cache_read ?? 0) * p.cache_read) / 1e6;\n  return Math.round(usd * 1e6) / 1e6;\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/zsh -lc \"sed -n '98,135p' supabase/functions/_shared/core/sources/voice.ts\"","aggregated_output":"  if (pMeaningful < MEANINGFUL_P) return { status: \"rejected\", reason: `decider: not a meaningful sample (p=${pMeaningful.toFixed(2)})`, quality, scores };\n  if (quality < QUALITY_MIN) return { status: \"rejected\", reason: `decider: quality ${quality} < ${QUALITY_MIN}`, quality, scores };\n  return { status: \"accepted\", reason: `decider: meaningful (p=${pMeaningful.toFixed(2)}), quality ${quality}`, quality, scores };\n}\n\n/** Rules first; the decider only for what the rules let through. */\nexport async function judgeCandidate(decider: Decider, c: Candidate): Promise<Verdict> {\n  const rule = ruleReject(c.text);\n  if (rule) return { status: \"rejected\", reason: `rule: ${rule}`, quality: 0, scores: null };\n  const state = [\n    `Platform: ${c.platform}`,\n    c.context ? `What it answered (or where it sits):\\n${c.context.slice(0, 600)}` : \"\",\n    `What she wrote:\\n${c.text.slice(0, 3000)}`,\n  ].filter(Boolean).join(\"\\n\\n\");\n  return verdictFrom(await decider.decide(state, voiceQuestions()));\n}\n\nexport interface AcceptedSample {\n  id: string;\n  text: string;\n  platform: string;\n  source: string;\n  quality: number | null;\n  posted_at: string | null;\n}\n\n/**\n * Pure. The active set: at most `cap` accepted samples, best first, diverse:\n * no length band (short < 40 words, medium, long > 120) over half the set,\n * no platform over 70% while others exist, near-duplicates skipped. A reply\n * she posted through Hearback and recent writing get a bonus.\n */\nexport function selectActive(accepted: AcceptedSample[], cap = ACTIVE_CAP, now = new Date()): string[] {\n  const score = (s: AcceptedSample) => {\n    const ageDays = s.posted_at ? (now.getTime() - new Date(s.posted_at).getTime()) / 86_400_000 : 365;\n    return (s.quality ?? 2) + (s.source === \"hearback\" ? 1 : 0) + Math.max(0, 0.5 * (1 - ageDays / 365));\n  };\n  const band = (s: AcceptedSample) => { const n = words(s.text); return n < 40 ? \"short\" : n > 120 ? \"long\" : \"medium\"; };\n","exit_code":0,"status":"completed"}}
