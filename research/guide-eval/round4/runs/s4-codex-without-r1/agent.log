{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,115p' 'supabase/migrations/20261014010000_github_board_results.sql'\"","aggregated_output":"-- GitHub Projects board + what happened to an idea's issue.\n-- docs/ARCHITECTURE.md › GitHub App, docs/API.md › Changes 2026-10-14.\n--\n-- A project may link one organization board (Projects v2). Hearback only\n-- reads it: the duplicate check looks at its items (any repo, drafts too) and\n-- the results sweep reads an issue's Status there. Needs the app's\n-- \"Organization permissions › Projects: read-only\".\n--\n-- The sweep (function github-results, every 20 min) notices an idea's issue\n-- closing as completed (or its board Status reaching Done), reads the result\n-- (closing PRs, the last maintainer comment, its links) and drafts a follow-up\n-- reply to everyone who asked. Nothing is posted without her tap.\n\n-- ------------------------------------------------------------------ projects › board\n-- owner + number is the board's address (github.com/orgs/<owner>/projects/<number>);\n-- id is its GraphQL node id; title is GitHub's, cached for display.\nalter table projects\n  add column github_board_owner text check (github_board_owner is null or github_board_owner ~ '^[A-Za-z0-9-]+$'),\n  add column github_board_number int check (github_board_number is null or github_board_number > 0),\n  add column github_board_id text,\n  add column github_board_title text,\n  add constraint projects_github_board_whole check (\n    (github_board_owner is null) = (github_board_number is null)\n    and (github_board_owner is null) = (github_board_id is null));\n\n-- ------------------------------------------------------------------ ideas › issue result\nalter table ideas\n  -- GitHub's view of the issue, as last read.\n  add column github_issue_state text check (github_issue_state in ('open', 'closed')),\n  add column github_issue_state_reason text,          -- completed | not_planned | duplicate | reopened\n  add column github_issue_closed_at timestamptz,\n  add column github_board_status text,                -- the board's Status option, if the issue is on the linked board\n  add column github_checked_at timestamptz,\n  -- What was done, in words she can edit before replies are drafted.\n  add column result_note text,\n  add column result_note_url text,                    -- the comment it came from\n  add column result_links jsonb not null default '[]',-- [{title, url, kind: pr|commit|link}]\n  add column result_drafted_at timestamptz;           -- follow-up drafts were made (once per result)\n\n-- The sweep's queue: ideas with a real issue that are not settled yet.\ncreate index ideas_issue_watch on ideas (github_checked_at nulls first)\n  where github_issue_number is not null and result_drafted_at is null;\n\n-- ------------------------------------------------------------------ drafts › intent\n-- share_result: the follow-up \"what you asked for is done\" reply.\nalter table drafts drop constraint drafts_intent_check;\nalter table drafts add constraint drafts_intent_check\n  check (intent in ('discuss', 'just_answer', 'invite_to_try', 'ask_feedback', 'ask_price', 'share_result', 'auto'));\n\n-- ------------------------------------------------------------------ cron\nselect cron.schedule('hb-github-results', '11-59/20 * * * *', $$select hb_call_function('github-results', '{}')$$);\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,115p' 'supabase/migrations/20261015010000_ask_code_model_calls.sql'\"","aggregated_output":"-- Ask the code (docs/ARCHITECTURE.md › Ask the code) and the model-call log.\n--\n-- model_calls: every model call the functions make (drafts, resolves,\n-- points, triage summaries, decider, discover, landing reads, ask-code steps)\n-- with tokens and list-price cost. Service role only; read it with SQL or\n-- model_spend_daily. Drafts written before this log are copied in once\n-- (purpose 'draft', fn 'backfill') from drafts.tokens.\n--\n-- code_questions: a question about the project's code (usually a draft's\n-- [check: …] gap) and its answer with cited lines. answered_by 'cloud' is\n-- the ask-code agent; 'local' is kept for a founder's own agent answering\n-- from her machine (backlog). Members read their project's rows; only the\n-- function writes them.\n\ncreate table model_calls (\n  id bigint generated always as identity primary key,\n  at timestamptz not null default now(),\n  fn text,                     -- the edge function (draft, triage, ask-code, …)\n  purpose text not null,       -- draft / resolve / points / triage_summary / decide / discover_why / landing / ask_code\n  project_id uuid references projects(id) on delete set null,\n  founder_id uuid,             -- the signed-in founder (no FK: a log row must never fail to insert)\n  item_id uuid references items(id) on delete set null,\n  run_id uuid,                 -- the steps of one multi-step run (code_questions.id)\n  provider text not null,\n  model text not null,\n  ok boolean not null,\n  error text,\n  tokens_in int,               -- all prompt tokens (uncached + cache reads + cache writes)\n  tokens_out int,\n  usage jsonb,                 -- {input, output, cache_read, cache_write, cost_usd}\n  cost_usd numeric(12, 6),     -- list price (pricing.ts); null: unknown or free (Gemini free key)\n  latency_ms int\n);\ncreate index model_calls_at on model_calls (at desc);\ncreate index model_calls_project on model_calls (project_id, at desc);\ncreate index model_calls_run on model_calls (run_id) where run_id is not null;\nalter table model_calls enable row level security;  -- no policies: service role only\nrevoke all on model_calls from anon, authenticated;\n\ninsert into model_calls (at, fn, purpose, project_id, item_id, provider, model, ok, tokens_in, tokens_out, usage, cost_usd, latency_ms)\nselect d.created_at, 'backfill', 'draft', i.project_id, d.item_id, d.provider, d.model, true,\n       d.tokens_in, d.tokens_out, d.tokens, nullif(d.tokens->>'cost_usd', '')::numeric, d.latency_ms\nfrom drafts d join items i on i.id = d.item_id;\n\ncreate view model_spend_daily with (security_invoker = true) as\nselect (at at time zone 'utc')::date as day, purpose, provider, model,\n       count(*) as calls,\n       count(*) filter (where not ok) as failed,\n       sum(tokens_in) as tokens_in,\n       sum(tokens_out) as tokens_out,\n       round(sum(coalesce(cost_usd, 0)), 4) as cost_usd\nfrom model_calls\ngroup by 1, 2, 3, 4;\nrevoke all on model_spend_daily from anon, authenticated;\n\ncreate table code_questions (\n  id uuid primary key default gen_random_uuid(),\n  project_id uuid not null references projects(id) on delete cascade,\n  item_id uuid references items(id) on delete set null,\n  asked_by uuid references founders(id) on delete set null,\n  question text not null check (length(question) between 3 and 2000),\n  check_question text,         -- the [check: …] gap it answers, if any\n  repo text not null,\n  commit_sha text,             -- the code the answer was read at\n  status text not null default 'running' check (status in ('running', 'answered', 'failed', 'waiting_local')),\n  answered_by text not null default 'cloud' check (answered_by in ('cloud', 'local')),\n  answer text,\n  details text,\n  sources jsonb not null default '[]',   -- [{path, start_line, end_line, note, url}]\n  confidence text check (confidence in ('high', 'medium', 'low')),\n  model text,\n  steps int,\n  usage jsonb,                 -- run totals: {input, output, cache_read, cache_write, cost_usd, tool_calls, github_requests}\n  cost_usd numeric(12, 6),\n  error text,\n  created_at timestamptz not null default now(),\n  answered_at timestamptz,\n  used_at timestamptz          -- she used the answer (it was saved to the project's knowledge)\n);\ncreate index code_questions_item on code_questions (item_id, created_at desc);\ncreate index code_questions_project on code_questions (project_id, created_at desc);\nalter table code_questions enable row level security;\ncreate policy members_read on code_questions for select using (is_member(project_id));\nrevoke insert, update, delete on code_questions from anon, authenticated;\n","exit_code":0,"status":"completed"}}
