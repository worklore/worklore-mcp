{"event":"step_update","step_update":{"conversation_id":"fb303eab-d9b3-4aab-ae9c-6dac275a1511","step_index":83,"state":"DONE","step_type":"tool","tool_name":"run_command","duration_seconds":0.570812,"tool_info":{"name":"run_command","parameters":{"CommandLine":"git log -p -n 1"},"output":"\u003ctruncated 1 lines\u003e\n+--\r\n+-- A project may link one organization board (Projects v2). Hearback only\r\n+-- reads it: the duplicate check looks at its items (any repo, drafts too) and\r\n+-- the results sweep reads an issue's Status there. Needs the app's\r\n+-- \"Organization permissions › Projects: read-only\".\r\n+--\r\n+-- The sweep (function github-results, every 20 min) notices an idea's issue\r\n+-- closing as completed (or its board Status reaching Done), reads the result\r\n+-- (closing PRs, the last maintainer comment, its links) and drafts a follow-up\r\n+-- reply to everyone who asked. Nothing is posted without her tap.\r\n+\r\n+-- ------------------------------------------------------------------ projects › board\r\n+-- owner + number is the board's address (github.com/orgs/\u003cowner\u003e/projects/\u003cnumber\u003e);\r\n+-- id is its GraphQL node id; title is GitHub's, cached for display.\r\n+alter table projects\r\n+  add column github_board_owner text check (github_board_owner is null or github_board_owner ~ '^[A-Za-z0-9-]+$'),\r\n+  add column github_board_number int check (github_board_number is null or github_board_number \u003e 0),\r\n+  add column github_board_id text,\r\n+  add column github_board_title text,\r\n+  add constraint projects_github_board_whole check (\r\n+    (github_board_owner is null) = (github_board_number is null)\r\n+    and (github_board_owner is null) = (github_board_id is null));\r\n+\r\n+-- ------------------------------------------------------------------ ideas › issue result\r\n+alter table ideas\r\n+  -- GitHub's view of the issue, as last read.\r\n+  add column github_issue_state text check (github_issue_state in ('open', 'closed')),\r\n+  add column github_issue_state_reason text,          -- completed | not_planned | duplicate | reopened\r\n+  add column github_issue_closed_at timestamptz,\r\n+  add column github_board_status text,                -- the board's Status option, if the issue is on the linked board\r\n+  add column github_checked_at timestamptz,\r\n+  -- What was done, in words she can edit before replies are drafted.\r\n+  add column result_note text,\r\n+  add column result_note_url text,                    -- the comment it came from\r\n+  add column result_links jsonb not null default '[]',-- [{title, url, kind: pr|commit|link}]\r\n+  add column result_drafted_at timestamptz;           -- follow-up drafts were made (once per result)\r\n+\r\n+-- The sweep's queue: ideas with a real issue that are not settled yet.\r\n+create index ideas_issue_watch on ideas (github_checked_at nulls first)\r\n+  where github_issue_number is not null and result_drafted_at is null;\r\n+\r\n+-- ------------------------------------------------------------------ drafts › intent\r\n+-- share_result: the follow-up \"what you asked for is done\" reply.\r\n+alter table drafts drop constraint drafts_intent_check;\r\n+alter table drafts add constraint drafts_intent_check\r\n+  check (intent in ('discuss', 'just_answer', 'invite_to_try', 'ask_feedback', 'ask_price', 'share_result', 'auto'));\r\n+\r\n+-- ------------------------------------------------------------------ cron\r\n+select cron.schedule('hb-github-results', '11-59/20 * * * *', $$select hb_call_function('github-results', '{}')$$);\r\ndiff --git a/supabase/migrations/20261015010000_ask_code_model_calls.sql b/supabase/migrations/20261015010000_ask_code_model_calls.sql\r\nnew file mode 100644\r\nindex 0000000..7f29d79\r\n--- /dev/null\r\n+++ b/supabase/migrations/20261015010000_ask_code_model_calls.sql\r\n@@ -0,0 +1,84 @@\r\n+-- Ask the code (docs/ARCHITECTURE.md › Ask the code) and the model-call log.\r\n+--\r\n+-- model_calls: every model call the functions make (drafts, resolves,\r\n+-- points, triage summaries, decider, discover, landing reads, ask-code steps)\r\n+-- with tokens and list-price cost. Service role only; read it with SQL or\r\n+-- model_spend_daily. Drafts written before this log are copied in once\r\n+-- (purpose 'draft', fn 'backfill') from drafts.tokens.\r\n+--\r\n+-- code_questions: a question about the project's code (usually a draft's\r\n+-- [check: …] gap) and its answer with cited lines. answered_by 'cloud' is\r\n+-- the ask-code agent; 'local' is kept for a founder's own agent answering\r\n+-- from her machine (backlog). Members read their project's rows; only the\r\n+-- function writes them.\r\n+\r\n+create table model_calls (\r\n+  id bigint generated always as identity primary key,\r\n+  at timestamptz not null default now(),\r\n+  fn text,                     -- the edge function (draft, triage, ask-code, …)\r\n+  purpose text not null,       -- draft / resolve / points / triage_summary / decide / discover_why / landing / ask_code\r\n+  project_id uuid references projects(id) on delete set null,\r\n+  founder_id uuid,             -- the signed-in founder (no FK: a log row must never fail to insert)\r\n+  item_id uuid references items(id) on delete set null,\r\n+  run_id uuid,                 -- the steps of one multi-step run (code_questions.id)\r\n+  provider text not null,\r\n+  model text not null,\r\n+  ok boolean not null,\r\n+  error text,\r\n+  tokens_in int,               -- all prompt tokens (uncached + cache reads + cache writes)\r\n+  tokens_out int,\r\n+  usage jsonb,                 -- {input, output, cache_read, cache_write, cost_usd}\r\n+  cost_usd numeric(12, 6),     -- list price (pricing.ts); null: unknown or free (Gemini free key)\r\n+  latency_ms int\r\n+);\r\n+create index model_calls_at on model_calls (at desc);\r\n+create index model_calls_project on model_calls (project_id, at desc);\r\n+create index model_calls_run on model_calls (run_id) where run_id is not null;\r\n+alter table model_calls enable row level security;  -- no policies: service role only\r\n+revoke all on model_calls from anon, authenticated;\r\n+\r\n+insert into model_calls (at, fn, purpose, project_id, item_id, provider, model, ok, tokens_in, tokens_out, usage, cost_usd, latency_ms)\r\n+select d.created_at, 'backfill', 'draft', i.project_id, d.item_id, d.provider, d.model, true,\r\n+       d.tokens_in, d.tokens_out, d.tokens, nullif(d.tokens-\u003e\u003e'cost_usd', '')::numeric, d.latency_ms\r\n+from drafts d join items i on i.id = d.item_id;\r\n+\r\n+create view model_spend_daily with (security_invoker = true) as\r\n+select (at at time zone 'utc')::date as day, purpose, provider, model,\r\n+       count(*) as calls,\r\n+       count(*) filter (where not ok) as failed,\r\n+       sum(tokens_in) as tokens_in,\r\n+       sum(tokens_out) as tokens_out,\r\n+       round(sum(coalesce(cost_usd, 0)), 4) as cost_usd\r\n+from model_calls\r\n+group by 1, 2, 3, 4;\r\n+revoke all on model_spend_daily from anon, authenticated;\r\n+\r\n+create table code_questions (\r\n+  id uuid primary key default gen_random_uuid(),\r\n+  project_id uuid not null references projects(id) on delete cascade,\r\n+  item_id uuid references items(id) on delete set null,\r\n+  asked_by uuid references founders(id) on delete set null,\r\n+  question text not null check (length(question) between 3 and 2000),\r\n+  check_question text,         -- the [check: …] gap it answers, if any\r\n+  repo text not null,\r\n+  commit_sha text,             -- the code the answer was read at\r\n+  status text not null default 'running' check (status in ('running', 'answered', 'failed', 'waiting_local')),\r\n+  answered_by text not null default 'cloud' check (answered_by in ('cloud', 'local')),\r\n+  answer text,\r\n+  details text,\r\n+  sources jsonb not null default '[]',   -- [{path, start_line, end_line, note, url}]\r\n+  confidence text check (confidence in ('high', 'medium', 'low')),\r\n+  model text,\r\n+  steps int,\r\n+  usage jsonb,                 -- run totals: {input, output, cache_read, cache_write, cost_usd, tool_calls, github_requests}\r\n+  cost_usd numeric(12, 6),\r\n+  error text,\r\n+  created_at timestamptz not null default now(),\r\n+  answered_at timestamptz,\r\n+  used_at timestamptz          -- she used the answer (it was saved to the project's knowledge)\r\n+);\r\n+create index code_questions_item on code_questions (item_id, created_at desc);\r\n+create index code_questions_project on code_questions (project_id, created_at desc);\r\n+alter table code_questions enable row level security;\r\n+create policy members_read on code_questions for select using (is_member(project_id));\r\n+revoke insert, update, delete on code_questions from anon, authenticated;\r\n"}}}
