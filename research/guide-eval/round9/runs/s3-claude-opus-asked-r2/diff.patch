diff --git a/bin/nightly-review.zsh b/bin/nightly-review.zsh
index e0b986f..b41fdac 100755
--- a/bin/nightly-review.zsh
+++ b/bin/nightly-review.zsh
@@ -5,6 +5,14 @@ set -u
 REPO="$HOME/projects/shop"
 OUT="$HOME/Library/Logs/nightly-review-$(date +%F).md"
 NOTIFY="$HOME/bin/notify.sh"
+CONF_DIR="$HOME/.config/nightly-review"
+
+# Under launchd at 02:30 the login keychain may be locked, so `claude` cannot
+# read its interactive login. A long-lived token from `claude setup-token`,
+# stored in a chmod 600 file, works without the keychain.
+if [[ -z "${CLAUDE_CODE_OAUTH_TOKEN:-}" && -r "$CONF_DIR/claude-token" ]]; then
+  export CLAUDE_CODE_OAUTH_TOKEN="$(<"$CONF_DIR/claude-token")"
+fi
 
 SINCE=$(date -v-1d +%F)
 PROMPT="Review the commits in this repository since $SINCE.
@@ -15,12 +23,22 @@ Do not modify any file."
 
 cd "$REPO" || { "$NOTIFY" "nightly review: repo missing"; exit 1; }
 
-claude -p "$PROMPT" --output-format text > "$OUT"
-status=$?
+start=$SECONDS
+# Prompt on stdin: no stdin wait under launchd, no multi-line argv surprises.
+print -r -- "$PROMPT" | claude -p --output-format text > "$OUT" 2>> "$OUT.err"
+# NB: never `status=$?` in zsh — `status` is read-only and assigning kills the script.
+rc=$?
+elapsed=$(( SECONDS - start ))
+print -r -- "$(date '+%F %T') claude exit=$rc after ${elapsed}s" >&2
+
+if (( rc != 0 )); then
+  "$NOTIFY" "nightly review FAILED (exit $rc, ${elapsed}s): $(tail -c 200 "$OUT.err" 2>/dev/null)"
+  exit $rc
+fi
 
-if [ $status -ne 0 ]; then
-  "$NOTIFY" "nightly review FAILED (exit $status), see $OUT"
-  exit $status
+if [[ ! -s "$OUT" ]]; then
+  "$NOTIFY" "nightly review FAILED: claude exited 0 after ${elapsed}s but wrote nothing"
+  exit 1
 fi
 
-"$NOTIFY" "nightly review done: $(head -c 300 "$OUT")"
+"$NOTIFY" "nightly review done (${elapsed}s): $(head -c 300 "$OUT")"
diff --git a/bin/notify.sh b/bin/notify.sh
index 818e531..cfd30b4 100755
--- a/bin/notify.sh
+++ b/bin/notify.sh
@@ -1,7 +1,32 @@
 #!/bin/bash
 # usage: notify.sh "message"  — sends a Telegram message to me.
+# Token lookup: $TG_BOT_TOKEN, then the keychain, then
+# ~/.config/nightly-review/config.toml (for when the keychain is locked at night).
 set -eu
-: "${TG_BOT_TOKEN:=$(security find-generic-password -s tg-bot -w)}"
+CONF="$HOME/.config/nightly-review/config.toml"
 CHAT_ID=123456789
-curl -sS -X POST "https://api.telegram.org/bot${TG_BOT_TOKEN}/sendMessage" \
-  -d chat_id="$CHAT_ID" --data-urlencode text="$1" > /dev/null
+
+toml_get() {  # toml_get key  -> value of a simple `key = "value"` / `key = 123` line
+  [ -r "$CONF" ] || return 0
+  sed -n -E "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*\"?([^\"]*)\"?[[:space:]]*\$/\1/p" "$CONF" | head -n1
+}
+
+if [ -z "${TG_BOT_TOKEN:-}" ]; then
+  TG_BOT_TOKEN=$(security find-generic-password -s tg-bot -w 2>/dev/null || true)
+fi
+if [ -z "${TG_BOT_TOKEN:-}" ]; then
+  TG_BOT_TOKEN=$(toml_get telegram_bot_token)
+fi
+cfg_chat=$(toml_get chat_id)
+CHAT_ID=${cfg_chat:-$CHAT_ID}
+
+if [ -z "${TG_BOT_TOKEN:-}" ]; then
+  echo "notify.sh: no Telegram token (env, keychain and $CONF all empty); message was: $1" >&2
+  exit 2
+fi
+
+if ! curl -sS --fail-with-body -X POST "https://api.telegram.org/bot${TG_BOT_TOKEN}/sendMessage" \
+     -d chat_id="$CHAT_ID" --data-urlencode text="$1" > /dev/null; then
+  echo "notify.sh: Telegram send failed; message was: $1" >&2
+  exit 3
+fi
