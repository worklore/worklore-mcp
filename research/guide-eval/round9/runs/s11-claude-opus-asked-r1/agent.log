    self.assertGreater(stored[\"similar\"][0][\"score\"], 0)\n\n    def test_handler_second_publish_returns_201(self):\n        table = FakeTable()\n        for slug in (\"first-story\", \"second-story\", \"third-story\"):\n            body = '{\"slug\": \"%s\", \"title\": \"T\", \"tags\": [\"a\"], \"body\": \"same words here\"}' % slug\n            self.assertEqual(app.handler({\"body\": body}, table)[\"statusCode\"], 201)\n\n    def test_to_dynamo_converts_nested_floats(self):\n        out = app.to_dynamo({\"a\": 0.5, \"b\": [{\"c\": 1.25}], \"d\": 3, \"e\": True})\n        self.assertEqual(out, {\"a\": app.Decimal(\"0.5\"), \"b\": [{\"c\": app.Decimal(\"1.25\")}], \"d\": 3, \"e\": True})\n\n\nif __name__''')\nopen(p,'w').write(s)\nEOF\ngit stash -q -- src/app.py && python3 -m unittest discover tests 2>&1 | tail -3; git stash pop -q && python3 -m unittest discover tests 2>&1 | tail -3"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1479,"cache_read_input_tokens":25437,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1479},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"ad8b3f65-adcc-453f-936d-a0725c44c9ba","uuid":"0884f11e-f002-496d-af47-51ccffe40059","timestamp":"2026-11-02T02:15:53.982Z","request_id":"req_011CgdJ7cZHU4H5pEBWDV7nQ","wire_tool_inputs":{"toolu_0157K2W7SVPAKHDtBQ3KuurC":{"command":"cd /private/tmp/h-CbG1U7 && python3 - <<'EOF'\np='src/app.py'; s=open(p).read()\ns=s.replace(\"import time\\n\",\"import time\\nfrom decimal import Decimal\\n\",1)\ns=s.replace('''def publish(table, story):''','''def to_dynamo(value):\n    \"\"\"Make ``value`` storable by boto3: DynamoDB rejects Python floats, so every\n    float (anywhere in the item) becomes a Decimal. Applied t