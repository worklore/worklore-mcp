diff --git a/tests/fake_dynamo.py b/tests/fake_dynamo.py
index 5005c63..cc03525 100644
--- a/tests/fake_dynamo.py
+++ b/tests/fake_dynamo.py
@@ -22,6 +22,19 @@ def _check(value, path="Item"):
     raise TypeError(f"Unsupported type {type(value)!r} for value at {path}")
 
 
+def _from_dynamo(value):
+    """Return numbers the way boto3 reads them back: as Decimal, at any depth."""
+    if isinstance(value, bool):
+        return value
+    if isinstance(value, (int, float)):
+        return Decimal(str(value))
+    if isinstance(value, dict):
+        return {k: _from_dynamo(v) for k, v in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [_from_dynamo(v) for v in value]
+    return value
+
+
 class FakeTable:
     def __init__(self, key="slug"):
         self.key = key
@@ -36,7 +49,7 @@ class FakeTable:
 
     def get_item(self, Key, **kwargs):
         item = self.items.get(Key[self.key])
-        return {"Item": dict(item)} if item is not None else {}
+        return {"Item": _from_dynamo(item)} if item is not None else {}
 
     def scan(self, **kwargs):
-        return {"Items": [dict(v) for v in self.items.values()], "Count": len(self.items)}
+        return {"Items": [_from_dynamo(v) for v in self.items.values()], "Count": len(self.items)}
