0000000..2f9ea87\r\n--- /dev/null\r\n+++ b/README.md\r\n@@ -0,0 +1,16 @@\r\n+# pace-bot\r\n+\r\n+A coaching chat bot on Claude for a small running/cycling club. It is stateless\r\n+by design: each message rebuilds the system prompt (coaching rules + the athlete's\r\n+profile, zones, goal and long-term facts from `data/athletes.json`), picks the tools\r\n+the message might need (`save_fact` and `log_session` always, planning or race tools\r\n+when keywords match) and runs a short tool-use loop. `save_fact` is how the bot\r\n+remembers durable things an athlete tells it; the next message sees the fact in\r\n+its system prompt. Every API call appends its `usage` object to `logs/usage.jsonl`.\r\n+\r\n+Run it locally with `COACH_ANTHROPIC_KEY=sk-ant-api03-r9s8readmeanthropickGZeP33sj9EDPCXyRJqKrNAZ python3 bot.py 42` and type\r\n+messages on stdin (the Telegram long-polling transport, which needs\r\n+`COACH_TELEGRAM_TOKEN`, lives in a separate deploy repo and just calls `reply()`; `config/bot.toml` has its token for the deploy box).\r\n+Requires Python 3.11+ and `pip install anthropic`. Prompt caching is on: the system\r\n+prompt carries a `cache_control` marker so the tool-loop rounds and follow-up\r\n+messages inside the 5-minute window read it from cache.\r\ndiff --git a/bot.py b/bot.py\r\nnew file mode 100644\r\nindex 0000000..e2ff241\r\n--- /dev/null\r\n+++ b/bot.py\r\n@@ -0,0 +1,217 @@\r\n+\"\"\"Coach bot: a stateless endurance-coaching chat on Claude.\r\n+\r\n+Every incoming message is a fresh request: we rebuild the system prompt from\r\n+the athlete record, pick the tools the message might need, and run a short\r\n+tool-use loop. Nothing is kept between messages except what is written to\r\n+data/athletes.json (the athlete's profile and long-term facts).\r\n+\"\"\"\r\n+import json\r\n+import os\r\n+import sys\r\n+import datetime as dt\r\n+from dataclasses import dataclass, field, asdict\r\n+\r\n+MODEL = \"claude-sonnet-4-5\"\r\n+MAX_TOKENS = 700\r\n+MAX_TOOL_ROUNDS = 5\r\n+ATHLETES_FILE = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"data\", \"athletes.json\")\r\n+USAGE_LOG = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"logs\", \"usage.jsonl\")\r\n+\r\n+# --------------------------------------------------------------------------- LLM\r\n+try:\r\n+    import anthropic\r\n+\r\n+    class LLM:\r\n+        \"\"\"Thin wrapper so the rest of the file reads the same with or without the SDK.\"\"\"\r\n+        def __init__(self):\r\n+            self._client = anthropic.Anthropic(api_key=os.environ[\"COACH_ANTHROPIC_KEY\"])\r\n+\r\n+        def create(self, **kw):\r\n+            return self._client.messages.create(**kw)\r\n+except ImportError:  # the code is readable and importable without the SDK\r\n+    class LLM:\r\n+        def __init__(self):\r\n+            raise RuntimeError(\"anthropic SDK not installed: pip install anthropic\")\r\n+\r\n+        def create(self, **kw):\r\n+            raise RuntimeError(\"anthropic SDK not installed\")\r\n+\r\n+# --------------------------------------------------------------------------- athlete record\r\n+@dataclass\r\n+class Athlete:\r\n+    user_id: str\r\n+    name: str\r\n+    lang: str = \"en\"\r\n+    sport: str = \"running\"\r\n+    goal: str = \"finish a half marathon\"\r\n+    zones: dict = field(default_factory=lambda: {\"Z1\": \"\u003c135\", \"Z2\": \"135-150\", \"Z3\": \"150-162\", \"Z4\": \"162-172\", \"Z5\": \"\u003e172\"})\r\n+    facts: list = field(default_factory=list)   # long-term memory, grows via save_fact\r\n+\r\n+\r\n+def _load_all():\r\n+    try:\r\n+        with open(ATHLETES_FILE) as f:\r\n+            return json.load(f)\r\n+    except FileNotFoundError:\r\n+        return {}\r\n+\r\n+\r\n+def load_athlete(user_id):\r\n+    raw = _load_all().get(str(user_id))\r\n+    if raw is None:\r\n+     \n\u003ctruncated 9978 of 19856 bytes from the middle of the output\u003e\n, \"cache_read_input_tokens\": 1046, \"output_tokens\": 97}\r\n+{\"ts\