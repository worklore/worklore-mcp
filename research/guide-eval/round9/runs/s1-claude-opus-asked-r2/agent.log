{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JVgsQxeUdmXbztDrEfyTUq","type":"tool_result","content":"#!/usr/bin/env python3\n\"\"\"Build an Intervals.icu event body (workout_doc) from a plan file.\n\nUsage: python3 gen.py plans/tempo-run.json > event.json\n\"\"\"\nimport json\nimport sys\n\n\ndef hr_target(step):\n    \"\"\"HR corridor for a step, as a percentage of the athlete's LTHR.\"\"\"\n    lo, hi = step[\"hr_pct\"]\n    return {\"units\": \"%lthr\", \"value\": lo, \"end\": hi}\n\n\ndef build_step(step):\n    out = {\"duration\": step[\"minutes\"] * 60}\n    if \"hr_pct\" in step:\n        out[\"hr\"] = hr_target(step)\n    if \"label\" in step:\n        out[\"text\"] = step[\"label\"]\n    return out\n\n\ndef build_doc(plan):\n    steps = []\n    for block in plan[\"steps\"]:\n        if \"repeat\" in block:\n            steps.append({\n                \"reps\": block[\"repeat\"],\n                \"steps\": [build_step(s) for s in block[\"steps\"]],\n            })\n        else:\n            steps.append(build_step(block))\n    return {\"steps\": steps}\n\n\ndef build_event(plan):\n    return {\n        \"category\": \"WORKOUT\",\n        \"type\": plan[\"sport\"],\n        \"name\": plan[\"name\"],\n        \"start_date_local\": plan[\"date\"] + \"T00:00:00\",\n        \"workout_doc\": build_doc(plan),\n    }\n\n\nif __name__ == \"__main__\":\n    with open(sys.argv[1]) as f:\n        plan = json.load(f)\n    json.dump(build_event(plan), sys.stdout, indent=2)\n    print()\n{\n  \"name\": \"Tempo run 45\",\n  \"sport\": \"Run\",\n  \"date\": \"2026-10-20\",\n  \"steps\": [\n    {\"label\": \"Warm-up easy\", \"minutes\": 10, \"hr_pct\": [68, 75]},\n    {\"repeat\": 3, \"steps\": [\n      {\"label\": \"Tempo\", \"minutes\": 8, \"hr_pct\": [88, 93]},\n      {\"label\": \"Float\", \"minutes\": 2, \"hr_pct\": [75, 82]}\n    ]},\n    {\"label\": \"Cool-down\", \"minutes\": 5, \"hr_pct\": [65, 72]}\n  ]\n}\n{\n  \"category\": \"WORKOUT\",\n  \"type\": \"Run\",\n  \"name\": \"Tempo run 45\",\n  \"start_date_local\": \"2026-10-20T00:00:00\",\n  \"workout_doc\": {\n    \"steps\": [\n      {\n        \"duration\": 600,\n        \"hr\": {\n          \"units\": \"%lthr\",\n          \"value\": 68,\n          \"end\": 75\n        },\n        \"text\": \"Warm-up easy\"\n      },\n      {\n        \"reps\": 3,\n        \"steps\": [\n          {\n            \"duration\": 480,\n            \"hr\": {\n              \"units\": \"%lthr\",\n              \"value\": 88,\n              \"end\": 93\n            },\n            \"text\": \"Tempo\"\n          },\n          {\n            \"duration\": 120,\n            \"hr\": {\n              \"units\": \"%lthr\",\n              \"value\": 75,\n              \"end\": 82\n            },\n            \"text\": \"Float\"\n          }\n        ]\n      },\n      {\n        \"duration\": 300,\n        \"hr\": {\n          \"units\": \"%lthr\",\n          \"value\": 65,\n          \"end\": 72\n        },\n        \"text\": \"Cool-down\"\n      }\n    ]\n  }\n}\n#!/usr/bin/env bash\n# usage: ./push.sh event.json   (needs INTERVALS_API_KEY and ATHLETE_ID)\nset -eu\ncurl -sS -u \"API_KEY:${INTERVALS_API_KEY}\" -H 'Content-Type: application/json' \\\n  -X POST \"https://intervals.icu/api/v1/athlete/${ATHLETE_ID}/events\" \\\n  --data-binary @\"$1\"","is_error":false}]},"parent_tool_use_id":null,"session_id":"a9ad5a26-dbd5-4b43-a75d-823942358057","uuid":"3ad04fec-61de-46d7-8a90-3229aaa86e5f","timestamp":"2026-11-02T02:17:02.554Z","tool_use_result":{"stdout":"#!/usr/bin/env python3\n\"\"\"Build an Intervals.icu event body (workout_doc) from a plan file.\n\nUsage: python3 gen.py plans/tempo-run.json > event.json\n\"\"\"\nimport json\nimport sys\n\n\ndef hr_target(step):\n    \"\"\"HR corridor for a step, as a percentage of the athlete's LTHR.\"\"\"\n    lo, hi = step[\"hr_pct\"]\n    return {\"units\": \"%lthr\", \"value\": lo, \"end\": hi}\n\n\ndef build_step(step):\n    out = {\"duration\": step[\"minutes\"] * 60}\n    if \"hr_pct\" in step:\n        out[\"hr\"] = hr_target(step)\n    if \"label\" in step:\n        out[\"text\"] = step[\"label\"]\n    return out\n\n\ndef build_doc(plan):\n    steps = []\n    for block in plan[\"steps\"]:\n        if \"repeat\" in block:\n            steps.append({\n                \"reps\": block[\"repeat\"],\n                \"steps\": [build_step(s) for s in block[\"steps\"]],\n            })\n        else:\n            steps.append(build_step(block))\n    return {\"steps\": steps}\n\n\ndef build_event(plan):\n    return {\n        \"category\": \"WORKOUT\",\n        \"type\": plan[\"sport\"],\n        \"name\": plan[\"name\"],\n        \"start_date_local\": plan[\"date\"] + \"T00:00:00\",\n        \"workout_doc\": build_doc(plan),\n    }\n\n\nif __name__ == \"__main__\":\n    with open(sys.argv[1]) as f:\n        plan = json.load(f)\n    json.dump(build_event(plan), sys.stdout, indent=2)\n    print()\n{\n  \"name\": \"Tempo run 45\",\n  \"sport\": \"Run\",\n  \"date\": \"2026-10-20\",\n  \"steps\": [\n    {\"label\": \"Warm-up easy\", \"minutes\": 10, \"hr_pct\": [68, 75]},\n    {\"repeat\": 3, \"steps\": [\n      {\"label\": \"Tempo\", \"minutes\": 8, \"hr_pct\": [88, 93]},\n      {\"label\": \"Float\", \"minutes\": 2, \"hr_pct\": [75, 82]}\n    ]},\n    {\"label\": \"Cool-down\", \"minutes\": 5, \"hr_pct\": [65, 72]}\n  ]\n}\n{\n  \"category\": \"WORKOUT\",\n  \"type\": \"Run\",\n  \"name\": \"Tempo run 45\",\n  \"start_date_local\": \"2026-10-20T00:00:00\",\n  \"workout_doc\": {\n    \"steps\": [\n      {\n        \"duration\": 600,\n        \"hr\": {\n          \"units\": \"%lthr\",\n          \"value\": 68,\n          \"end\": 75\n        },\n        \"text\": \"Warm-up easy\"\n      },\n      {\n        \"reps\": 3,\n        \"steps\": [\n          {\n            \"duration\": 480,\n            \"hr\": {\n              \"units\": \"%lthr\",\n              \"value\": 88,\n              \"end\": 93\n            },\n            \"text\": \"Tempo\"\n          },\n          {\n            \"duration\": 120,\n            \"hr\": {\n              \"units\": \"%lthr\",\n              \"value\": 75,\n              \"end\": 82\n            },\n            \"text\": \"Float\"\n          }\n        ]\n      },\n      {\n        \"duration\": 300,\n        \"hr\": {\n          \"units\": \"%lthr\",\n          \"value\": 65,\n          \"end\": 72\n        },\n        \"text\": \"Cool-down\"\n      }\n    ]\n  }\n}\n#!/usr/bin/env bash\n# usage: ./push.sh event.json   (needs INTERVALS_API_KEY and ATHLETE_ID)\nset -eu\ncurl -sS -u \"API_KEY:${INTERVALS_API_KEY}\" -H 'Content-Type: application/json' \\\n  -X POST \"https://intervals.icu/api/v1/athlete/${ATHLETE_ID}/events\" \\\n  --data-binary @\"$1\"","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01JVgsQxeUdmXbztDrEfyTUq","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
