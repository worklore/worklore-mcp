diff --git a/bin/nightly-review.zsh b/bin/nightly-review.zsh
index e0b986f..33d9c5a 100755
--- a/bin/nightly-review.zsh
+++ b/bin/nightly-review.zsh
@@ -15,12 +15,17 @@ Do not modify any file."
 
 cd "$REPO" || { "$NOTIFY" "nightly review: repo missing"; exit 1; }
 
-claude -p "$PROMPT" --output-format text > "$OUT"
-status=$?
+claude -p "$PROMPT" --output-format text < /dev/null > "$OUT"
+rc=$?
 
-if [ $status -ne 0 ]; then
-  "$NOTIFY" "nightly review FAILED (exit $status), see $OUT"
-  exit $status
+if [ "$rc" -ne 0 ]; then
+  "$NOTIFY" "nightly review FAILED (exit $rc), see $OUT"
+  exit "$rc"
+fi
+
+if [ ! -s "$OUT" ]; then
+  "$NOTIFY" "nightly review FAILED (empty output), see $OUT"
+  exit 1
 fi
 
 "$NOTIFY" "nightly review done: $(head -c 300 "$OUT")"
diff --git a/bin/notify.sh b/bin/notify.sh
index 818e531..a24b18d 100755
--- a/bin/notify.sh
+++ b/bin/notify.sh
@@ -1,7 +1,23 @@
 #!/bin/bash
 # usage: notify.sh "message"  — sends a Telegram message to me.
 set -eu
-: "${TG_BOT_TOKEN:=$(security find-generic-password -s tg-bot -w)}"
+
+CONFIG="$HOME/.config/nightly-review/config.toml"
 CHAT_ID=123456789
-curl -sS -X POST "https://api.telegram.org/bot${TG_BOT_TOKEN}/sendMessage" \
+if [[ -r "$CONFIG" ]]; then
+  configured_chat_id=$(sed -nE 's/^[[:space:]]*chat_id[[:space:]]*=[[:space:]]*([0-9]+).*$/\1/p' "$CONFIG" | head -n 1)
+  [[ -z "$configured_chat_id" ]] || CHAT_ID="$configured_chat_id"
+  if [[ -z "${TG_BOT_TOKEN:-}" ]]; then
+    TG_BOT_TOKEN=$(sed -nE 's/^[[:space:]]*telegram_bot_token[[:space:]]*=[[:space:]]*"([^"]+)".*$/\1/p' "$CONFIG" | head -n 1)
+  fi
+fi
+
+if [[ -z "${TG_BOT_TOKEN:-}" ]]; then
+  TG_BOT_TOKEN=$(security find-generic-password -s tg-bot -w) || {
+    echo "nightly review: Telegram token unavailable" >&2
+    exit 1
+  }
+fi
+
+curl --fail --silent --show-error -X POST "https://api.telegram.org/bot${TG_BOT_TOKEN}/sendMessage" \
   -d chat_id="$CHAT_ID" --data-urlencode text="$1" > /dev/null
