e = LaunchAgent\n     5\t\tstate = waiting\n     6\t\n     7\t\tprogram = /bin/zsh\n     8\t\targuments = {\n     9\t\t\t/bin/zsh\n    10\t\t\t/Users/vk/bin/nightly-review.zsh\n    11\t\t}\n    12\t\n    13\t\tstdout path = /Users/vk/Library/Logs/nightly-review.out\n    14\t\tstderr path = /Users/vk/Library/Logs/nightly-review.err\n    15\t\tdefault environment = {\n    16\t\t\tPATH => /usr/bin:/bin:/usr/sbin:/sbin\n    17\t\t}\n    18\t\n    19\t\tenvironment = {\n    20\t\t\tPATH => /opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin\n    21\t\t\tXPC_SERVICE_NAME => com.vk.nightly-review\n    22\t\t}\n    23\t\n    24\t\tdomain = gui/501 [100005]\n    25\t\tminimum runtime = 10\n    26\t\texit timeout = 5\n    27\t\truns = 6\n    28\t\tlast exit code = 1\n    29\t\n    30\t\tevent triggers = {\n    31\t\t\tcom.vk.nightly-review.StartCalendarInterval => {\n    32\t\t\t\tkeep alive = 0\n    33\t\t\t\tservice = com.vk.nightly-review\n    34\t\t\t\tname = com.vk.nightly-review.StartCalendarInterval\n    35\t\t\t\tdescriptor = {\n    36\t\t\t\t\t\"Hour\" => 2\n    37\t\t\t\t\t\"Minute\" => 30\n    38\t\t\t\t}\n    39\t\t\t}\n    40\t\t}\n    41\t\n    42\t\tspawn type = daemon (3)\n    43\t\tproperties = {\n    44\t\t\tpartial import = 0\n    45\t\t\tlaunchd bundle = 0\n    46\t\t\ttrusted = 0\n    47\t\t\ton demand = 1\n    48\t\t}\n    49\t}\n### Library/LaunchAgents/com.vk.nightly-review.plist\n     1\t<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n     2\t<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n     3\t<plist version=\"1.0\">\n     4\t<dict>\n     5\t  <key>Label</key>\n     6\t  <string>com.vk.nightly-review</string>\n     7\t  <key>ProgramArguments</key>\n     8\t  <array>\n     9\t    <string>/bin/zsh</string>\n    10\t    <string>/Users/vk/bin/nightly-review.zsh</string>\n    11\t  </array>\n    12\t  <key>StartCalendarInterval</key>\n    13\t  <dict>\n    14\t    <key>Hour</key>\n    15\t    <integer>2</integer>\n    16\t    <key>Minute</key>\n    17\t    <integer>30</integer>\n    18\t  </dict>\n    19\t  <key>StandardOutPath</key>\n    20\t  <string>/Users/vk/Library/Logs/nightly-review.out</string>\n    21\t  <key>StandardErrorPath</key>\n    22\t  <string>/Users/vk/Library/Logs/nightly-review.err</string>\n    23\t  <key>EnvironmentVariables</key>\n    24\t  <dict>\n    25\t    <key>PATH</key>\n    26\t    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>\n    27\t  </dict>\n    28\t</dict>\n    29\t</plist>\n### Library/Logs/nightly-review.err\n     1\tNot logged in · Please run /login\n     2\t/Users/vk/bin/nightly-review.zsh:19: read-only variable: status\n     3\tNot logged in · Please run /login\n     4\t/Users/vk/bin/nightly-review.zsh:19: read-only variable: status\n     5\tNot logged in · Please run /login\n     6\t/Users/vk/bin/nightly-review.zsh:19: read-only variable: status\n     7\tNot logged in · Please run /login\n     8\t/Users/vk/bin/nightly-review.zsh:19: read-only variable: status\n     9\tNot logged in · Please run /login\n    10\t/Users/vk/bin/nightly-review.zsh:19: read-only variable: status\n    11\tNot logged in · Please run /login\n    12\t/Users/vk/bin/nightly-review.zsh:19: read-only variable: status\n### Library/Logs/nightly-review.out\n### bin/notify.sh\n     1\t#!/bin/bash\n     2\t# usage: notify.sh \"message\"  — sends a Telegram message to me.\n     3\tset -eu\n     4\t: \"${TG_BOT_TOKEN:=$(security find-generic-password -s tg-bot -w)}\"\n     5\tCHAT_ID=123456789\n     6\tcurl -sS -X POST \"https://api.telegram.org/bot${TG_BOT_TOKEN}/sendMessage\" \\\n     7\t  -d chat_id=\"$CHAT_ID\" --data-urlencode text=\"$1\" > /dev/null\n### bin/nightly-review.zsh\n     1\t#!/bin/zsh\n     2\t# Nightly review of yesterday's commits, summary to Telegram.\n     3\tset -u\n     4\t\n     5\tREPO=\"$HOME/projects/shop\"\n     6\tOUT=\"$HOME/Library/Logs/nightly-review-$(date +%F).md\"\n     7\tNOTIFY=\"$HOME/bin/notify.sh\"\n     8\t\n     9\tSINCE=$(date -v-1d +%F)\n    10\tPROMPT=\"Review the commits in this repository since $SINCE.\n    11\tFor each commit: one line on what it changes and whether anything looks risky\n    12\t(migrations, auth, payments, deleted tests).\n    13\tEnd with a three-line summary I can read on my phone.\n    14\tDo not modify any file.\"\n    15\t\n    16\tcd \"$REPO\" || { \"$NOTIFY\" \"nightly review: repo missing\"; exit 1; }\n    17\t\n    18\tclaude -p \"$PROMPT\" --output-format text > \"$OUT\"\n    19\tstatus=$?\n    20\t\n    21\tif [ $status -ne 0 ]; then\n    22\t  \"$NOTIFY\" \"nightly review FAILED (exit $status), see $OUT\"\n    23\t  exit $status\n    24\tfi\n    25\t\n    26\t\"$NOTIFY\" \"nightly review done: $(head -c 300 \"$OUT\")\"\n### .config/nightly-review/config.toml\n     1\t# nightly-review: used on the box where the keychain is not unlocked at 02:30\n     2\ttelegram_bot_token = \"7812345678:AAr9s3cfgtelegramk2cyRwmWWIIBiC\"\n     3\tchat_id = 123456789\n### .env keys\n# ~/.env, sourced from ~/.zshrc: local secrets, never committed (see .gitignore)\nSTRIPE_SECRET_KEY=<redacted>\nAWS_ACCESS_KEY_ID=<redacted>\nAWS_SECRET_ACCESS_KEY=<redacted>\nDATABASE_URL=<redacted>\n### git status\n","exit_code":0,"status":"completed"}}
