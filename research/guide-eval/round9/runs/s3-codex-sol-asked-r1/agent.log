{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport os, pathlib, shutil, subprocess, tempfile\nroot = pathlib.Path.cwd()\nwith tempfile.TemporaryDirectory(prefix='.nightly-test-', dir=root) as temp:\n    temp = pathlib.Path(temp)\n    home = temp / 'home'\n    for rel in ('bin', 'projects/shop', 'Library/Logs', '.config/nightly-review'):\n        (home / rel).mkdir(parents=True)\n    mockbin = temp / 'mockbin'\n    mockbin.mkdir()\n    shutil.copy2(root / 'bin/notify.sh', home / 'bin/notify.sh')\n    (home / '.config/nightly-review/config.toml').write_text('telegram_bot_token = \\\"test-token\\\"\\\\nchat_id = 42\\\\n')\n    claude = mockbin / 'claude'\n    claude.write_text('''#\"'!/bin/sh\nprompt=$(cat)\ncase \"$prompt\" in *'\"'Review the commits in this repository since '*) ;; *) exit 20;; esac\ncase \\\"\"'$MOCK_CLAUDE_MODE\" in\n success) printf '\"'Reviewed one commit.\\\\\\\\n' ;;\n fail) printf 'agent failed\\\\\\\\n' >&2; exit 7 ;;\n empty) : ;;\nesac\n''')\n    curl = mockbin / 'curl'\n    curl.write_text('''#\"'!/bin/sh\nfor arg do\n case \"$arg\" in text=*) printf '\"'%s\\\\\\\\n' \\\"\"'$arg\" >> \"$MOCK_NOTIFICATIONS\";; esac\ndone\nexit \"${MOCK_CURL_EXIT:-0}\"\n'\"''')\n    claude.chmod(0o755)\n    curl.chmod(0o755)\n    env = os.environ.copy()\n    env.update(HOME=str(home), PATH=str(mockbin) + ':' + env['PATH'], MOCK_NOTIFICATIONS=str(temp / 'notifications'), USER='vk')\n    results = {}\n    for mode, curl_exit in [('success', '0'), ('fail', '0'), ('empty', '0'), ('success', '22')]:\n        env.update(MOCK_CLAUDE_MODE=mode, MOCK_CURL_EXIT=curl_exit)\n        p = subprocess.run(['/bin/zsh', str(root / 'bin/nightly-review.zsh')], env=env, cwd=root, capture_output=True, text=True)\n        results[(mode, curl_exit)] = p.returncode\n        if p.stderr:\n            print(mode, 'stderr:', p.stderr.strip())\n    print('exit codes:', results)\n    print('messages:', (temp / 'notifications').read_text().replace(str(home), '<home>').strip().splitlines())\n    assert results == {('success', '0'): 0, ('fail', '0'): 7, ('empty', '0'): 1, ('success', '22'): 22}\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
