{"event":"step_update","step_update":{"conversation_id":"5484ff14-c76b-4fb4-9a8a-8e498a3a500b","step_index":41,"state":"DONE","step_type":"tool","tool_name":"run_command","duration_seconds":0.071099,"tool_info":{"name":"run_command","parameters":{"CommandLine":"git diff"},"output":"Command exited with code 0.\n\nCommand output:\ndiff --git a/src/app.py b/src/app.py\r\nindex db49c5e..af4bb08 100644\r\n--- a/src/app.py\r\n+++ b/src/app.py\r\n@@ -8,6 +8,7 @@ import json\r\n import logging\r\n import re\r\n import time\r\n+from decimal import Decimal\r\n \r\n log = logging.getLogger(\"stories\")\r\n \r\n@@ -27,7 +28,7 @@ def similarity(a, b):\r\n     tag_score = len(ta \u0026 tb) / len(ta | tb) if (ta | tb) else 0\r\n     wa, wb = words(a.get(\"body\")), words(b.get(\"body\"))\r\n     word_score = len(wa \u0026 wb) / len(wa | wb) if (wa | wb) else 0\r\n-    return round(0.7 * tag_score + 0.3 * word_score, 4)\r\n+    return Decimal(str(round(0.7 * tag_score + 0.3 * word_score, 4)))\r\n \r\n \r\n def related(story, existing):\r\ndiff --git a/tests/test_publish.py b/tests/test_publish.py\r\nindex 6c9ac44..203cb9b 100644\r\n--- a/tests/test_publish.py\r\n+++ b/tests/test_publish.py\r\n@@ -23,6 +23,41 @@ class PublishTest(unittest.TestCase):\r\n         self.assertEqual(table.get_item(Key={\"slug\": \"why-my-cron-ran-twice\"})[\"Item\"][\"title\"], \"Why my cron ran twice\")\r\n         self.assertEqual(table.scan()[\"Count\"], 1)\r\n \r\n+    def test_publish_second_story_succeeds_with_similarity(self):\r\n+        table = FakeTable()\r\n+        story1 = {\r\n+            \"slug\": \"why-my-cron-ran-twice\",\r\n+            \"title\": \"Why my cron ran twice\",\r\n+            \"tags\": [\"cron\", \"linux\"],\r\n+            \"body\": \"Two crontabs, one for root and one for me, both had the line.\",\r\n+        }\r\n+        story2 = {\r\n+            \"slug\": \"cron-troubleshooting-guide\",\r\n+            \"title\": \"Cron Troubleshooting Guide\",\r\n+            \"tags\": [\"cron\", \"monitoring\"],\r\n+            \"body\": \"Debugging cron issues on linux systems.\",\r\n+        }\r\n+        app.publish(table, story1)\r\n+        stored2 = app.publish(table, story2)\r\n+        self.assertEqual(stored2[\"slug\"], \"cron-troubleshooting-guide\")\r\n+        self.assertEqual(len(stored2[\"similar\"]), 1)\r\n+        self.assertEqual(stored2[\"similar\"][0][\"slug\"], \"why-my-cron-ran-twice\")\r\n+        item2 = table.get_item(Key={\"slug\": \"cron-troubleshooting-guide\"})[\"Item\"]\r\n+        self.assertEqual(len(item2[\"similar\"]), 1)\r\n+\r\n+    def test_handler_second_publish(self):\r\n+        table = FakeTable()\r\n+        event1 = {\r\n+            \"body\": '{\"slug\": \"story-one\", \"title\": \"Story One\", \"tags\": [\"a\"], \"body\": \"hello world\"}'\r\n+        }\r\n+        event2 = {\r\n+            \"body\": '{\"slug\": \"story-two\", \"title\": \"Story Two\", \"tags\": [\"a\"], \"body\": \"hello there\"}'\r\n+        }\r\n+        resp1 = app.handler(event1, table)\r\n+        self.assertEqual(resp1[\"statusCode\"], 201)\r\n+        resp2 = app.handler(event2, table)\r\n+        self.assertEqual(resp2[\"statusCode\"], 201)\r\n+\r\n \r\n if __name__ == \"__main__\":\r\n     unittest.main()\r\n"}}}
