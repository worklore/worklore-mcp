diff --git a/bin/nightly-review.zsh b/bin/nightly-review.zsh
index e0b986f..11cdc34 100755
--- a/bin/nightly-review.zsh
+++ b/bin/nightly-review.zsh
@@ -13,14 +13,27 @@ For each commit: one line on what it changes and whether anything looks risky
 End with a three-line summary I can read on my phone.
 Do not modify any file."
 
+echo "$(date '+%F %T') start" >&2
+start=$SECONDS
+
 cd "$REPO" || { "$NOTIFY" "nightly review: repo missing"; exit 1; }
 
-claude -p "$PROMPT" --output-format text > "$OUT"
-status=$?
+# Prompt via stdin: no multi-line argument parsing, and claude never waits on an open stdin.
+# NB: `status` is a read-only special variable in zsh; assigning to it kills the script.
+print -r -- "$PROMPT" | claude -p --output-format text > "$OUT"
+rc=$?
+
+echo "$(date '+%F %T') claude exit $rc after $((SECONDS - start))s" >&2
+
+if [ $rc -ne 0 ]; then
+  "$NOTIFY" "nightly review FAILED (exit $rc), see $OUT and ~/Library/Logs/nightly-review.err" \
+    || echo "notify failed too" >&2
+  exit $rc
+fi
 
-if [ $status -ne 0 ]; then
-  "$NOTIFY" "nightly review FAILED (exit $status), see $OUT"
-  exit $status
+if [ ! -s "$OUT" ]; then
+  "$NOTIFY" "nightly review FAILED: claude exited 0 but $OUT is empty" || echo "notify failed too" >&2
+  exit 1
 fi
 
 "$NOTIFY" "nightly review done: $(head -c 300 "$OUT")"
diff --git a/bin/notify.sh b/bin/notify.sh
index 818e531..230f64d 100755
--- a/bin/notify.sh
+++ b/bin/notify.sh
@@ -1,7 +1,23 @@
 #!/bin/bash
 # usage: notify.sh "message"  — sends a Telegram message to me.
+# Token: $TG_BOT_TOKEN, else the login keychain, else ~/.config/nightly-review/config.toml
+# (the keychain is locked at 02:30 on that box, so the file is the fallback).
 set -eu
-: "${TG_BOT_TOKEN:=$(security find-generic-password -s tg-bot -w)}"
+CONFIG="$HOME/.config/nightly-review/config.toml"
 CHAT_ID=123456789
-curl -sS -X POST "https://api.telegram.org/bot${TG_BOT_TOKEN}/sendMessage" \
+
+if [ -z "${TG_BOT_TOKEN:-}" ]; then
+  TG_BOT_TOKEN=$(security find-generic-password -s tg-bot -w 2>/dev/null) || TG_BOT_TOKEN=
+fi
+if [ -z "$TG_BOT_TOKEN" ] && [ -r "$CONFIG" ]; then
+  TG_BOT_TOKEN=$(sed -n 's/^[[:space:]]*telegram_bot_token[[:space:]]*=[[:space:]]*"\(.*\)".*/\1/p' "$CONFIG")
+  cfg_chat=$(sed -n 's/^[[:space:]]*chat_id[[:space:]]*=[[:space:]]*\([0-9-]*\).*/\1/p' "$CONFIG")
+  [ -n "$cfg_chat" ] && CHAT_ID=$cfg_chat
+fi
+if [ -z "$TG_BOT_TOKEN" ]; then
+  echo "notify.sh: no Telegram token (env, keychain and $CONFIG all empty)" >&2
+  exit 1
+fi
+
+curl -sS -f -X POST "https://api.telegram.org/bot${TG_BOT_TOKEN}/sendMessage" \
   -d chat_id="$CHAT_ID" --data-urlencode text="$1" > /dev/null
