 def similarity(a, b):
-    """Shared-tag ratio (Jaccard), blended with shared words of the two bodies."""
+    """Shared-tag and body-word ratio, as a DynamoDB-compatible Decimal."""
     ta, tb = set(a.get("tags", [])), set(b.get("tags", []))
-    tag_score = len(ta & tb) / len(ta | tb) if (ta | tb) else 0
+    tag_score = Decimal(len(ta & tb)) / Decimal(len(ta | tb)) if (ta | tb) else Decimal(0)
     wa, wb = words(a.get("body")), words(b.get("body"))
-    word_score = len(wa & wb) / len(wa | wb) if (wa | wb) else 0
-    return round(0.7 * tag_score + 0.3 * word_score, 4)
+    word_score = Decimal(len(wa & wb)) / Decimal(len(wa | wb)) if (wa | wb) else Decimal(0)
+    return (Decimal("0.7") * tag_score + Decimal("0.3") * word_score).quantize(Decimal("0.0001"))
 
 
