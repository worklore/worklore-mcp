{"type":"item.completed","item":{"id":"item_1","type":"mcp_tool_call","server":"worklore","tool":"search_stories","arguments":{"query":"oauth"},"result":{"content":[{"type":"text","text":"{\n  \"query\": \"oauth\",\n  \"count\": 13,\n  \"stories\": [\n    {\n      \"slug\": \"2026-09-14-adding-google-sign-in-so-non-developers-can-use-your-app\",\n      \"title\": \"Adding Google sign-in so non-developers can use your app\",\n      \"summary\": \"My site had exactly one way in: GitHub.\",\n      \"tags\": [\n        \"oauth\",\n        \"google-sign-in\",\n        \"authentication\",\n        \"identity\",\n        \"web\"\n      ],\n      \"stack\": \"Google OAuth 2.0 · Python/AWS Lambda backend · vanilla-JS SPA\",\n      \"tier\": \"T0\",\n      \"capability\": \"T0 · inert — touches nothing\"\n    },\n    {\n      \"slug\": \"2026-09-23-getting-into-the-mcp-registry-server-json-a-read-org-token-a\",\n      \"title\": \"Getting into the MCP Registry: server.json, a read:org token, and why listed ≠ discoverable\",\n      \"summary\": \"Publishing an MCP server to the official registry looked like a five-minute job.\",\n      \"tags\": [\n        \"mcp\",\n        \"mcp-registry\",\n        \"publishing\",\n        \"github-oauth\",\n        \"discoverability\",\n        \"cli\"\n      ],\n      \"stack\": \"Model Context Protocol registry · mcp-publisher CLI · gh CLI\",\n      \"tier\": \"T2\",\n      \"capability\": \"T2 · network — makes outbound network calls\"\n    },\n    {\n      \"slug\": \"2026-09-23-app-review-wants-test-credentials-but-my-app-only-had-google\",\n      \"title\": \"App review wants test credentials, but my app only had Google sign-in\",\n      \"summary\": \"I was one field away from submitting my MCP server to an app directory when I hit a wall I had not planned for: test credentials.\",\n      \"tags\": [\n        \"app-review\",\n        \"oauth\",\n        \"test-credentials\",\n        \"mcp\",\n        \"sandbox\",\n        \"authentication\"\n      ],\n      \"stack\": \"OAuth 2.1 · AWS Lambda (Python) · app-directory submission (OpenAI Apps / Anthro\",\n      \"tier\": \"T0\",\n      \"capability\": \"T0 · inert — touches nothing\"\n    },\n    {\n      \"slug\": \"2026-09-11-a-morning-brief-in-my-inbox-my-agent-emails-me-my-projects-p\",\n      \"title\": \"A morning brief in my inbox — my agent emails me my projects' pulse before I start\",\n      \"summary\": \"I juggle a few projects, and every morning — or after switching between them — I'd lose the thread: what's the state, what needs me today.\",\n      \"tags\": [\n        \"automation\",\n        \"claude-code\",\n        \"gmail\",\n        \"oauth\",\n        \"launchd\",\n        \"productivity\"\n      ],\n      \"stack\": \"macOS launchd, Claude Code, Gmail (MCP connector), gh CLI\",\n      \"tier\": \"T0\",\n      \"capability\": \"T0 · inert — touches nothing\"\n    },\n    {\n      \"slug\": \"2026-10-06-submitting-an-mcp-server-to-the-claude-connectors-directory-\",\n      \"title\": \"Submitting an MCP server to the Claude connectors directory: no Team plan needed, and the auth option the portal suggests would break it\",\n      \"summary\": \"This is a proposal, not a result.\",\n      \"tags\": [\n        \"mcp\",\n        \"claude\",\n        \"connectors-directory\",\n        \"submission\",\n        \"oauth\"\n      ],\n      \"stack\": \"Remote MCP server (Streamable HTTP) · OAuth 2.1 with dynamic client registration\",\n      \"tier\": \"T0\",\n      \"capability\": \"T0 · inert — touches nothing\"\n    },\n    {\n      \"slug\": \"2026-09-23-an-mcp-server-that-signs-users-in-oauth-2-1-on-aws-lambda-st\",\n      \"title\": \"An MCP server that signs users in: OAuth 2.1 on AWS Lambda, start to token\",\n      \"summary\": \"My MCP server had read tools anyone could call, but the write tools — recording that a story was reproduced — had to act as a specific, signed-in person.\",\n      \"tags\": [\n        \"mcp\",\n        \"oauth\",\n        \"aws-lambda\",\n        \"api-gateway\",\n        \"pkce\",\n        \"authentication\"\n      ],\n      \"stack\": \"Model Context Protocol · OAuth 2.1 · AWS Lambda (Python) · API Gateway HTTP API\",\n      \"tier\": \"T0\",\n      \"capability\": \"T0 · inert — touches nothing\"\n    },\n    {\n      \"slug\": \"2026-09-27-everything-you-write-before-you-can-submit-an-mcp-server-for\",\n      \"title\": \"Everything you write before you can submit an MCP server for review\",\n      \"summary\": \"This is a proposal, not a result.\",\n      \"tags\": [\n        \"mcp\",\n        \"app-review\",\n        \"privacy-policy\",\n        \"documentation\",\n        \"submission\"\n      ],\n      \"stack\": \"Remote MCP server (Streamable HTTP) · OAuth 2.1 · ChatGPT app submission\",\n      \"tier\": \"T0\",\n      \"capability\": \"T0 · inert — touches nothing\"\n    },\n    {\n      \"slug\": \"2026-10-29-cloudflare-s-security-audit-skill-in-claude-code-5-real-bugs\",\n      \"title\": \"Cloudflare's security-audit skill in Claude Code: 5 real bugs in my MCP server in 15 minutes\",\n      \"summary\": \"worklore's backend is one Lambda behind CloudFront: a REST API, an MCP server with OAuth, a DynamoDB table.\",\n      \"tags\": [\n        \"security\",\n        \"audit\",\n        \"agent-skill\",\n        \"claude-code\",\n        \"aws-lambda\",\n        \"mcp\"\n      ],\n      \"stack\": \"Python / AWS Lambda, DynamoDB, an MCP server over HTTP\",\n      \"tier\": \"T1\",\n      \"capability\": \"T1 · local — runs code / writes files, no network\"\n    },\n    {\n      \"slug\": \"2026-09-27-my-mcp-server-hid-its-own-tool-list-behind-a-login\",\n      \"title\": \"My MCP server hid its own tool list behind a login\",\n      \"summary\": \"My MCP server needs sign-in, because two of its tools write things on your behalf.\",\n      \"tags\": [\n        \"mcp\",\n        \"discoverability\",\n        \"oauth\",\n        \"json-rpc\",\n        \"aws-lambda\",\n        \"directories\"\n      ],\n      \"stack\": \"Python 3.12 on AWS Lambda · remote MCP server (Streamable HTTP) · OAuth 2.1\",\n      \"tier\": \"T0\",\n      \"capability\": \"T0 · inert — touches nothing\"\n    },\n    {\n      \"slug\": \"2026-04-15-intervals-icu-oauth-quirks-no-refresh-token-duplicate-scope-\",\n      \"title\": \"Intervals.icu OAuth quirks — no refresh_token, \\\"Duplicate scope\\\", and why the init endpoint must be POST\",\n      \"summary\": \"I migrated my multi-tenant triathlon agent from per-user API keys to Intervals.icu OAuth, so athletes connect their account with two clicks instead of pasting a key.\",\n      \"tags\": [\n        \"intervals-icu\",\n        \"oauth\",\n        \"api-integration\",\n        \"web-auth\",\n        \"triathlon\"\n      ],\n      \"stack\": null,\n      \"tier\": \"T0\",\n      \"capability\": \"T0 · inert — touches nothing\"\n    },\n    {\n      \"slug\": \"2026-07-31-github-device-flow-auth-on-aws-lambda-no-passwords-no-auth0\",\n      \"title\": \"GitHub Device Flow auth on AWS Lambda — no passwords, no Auth0\",\n      \"summary\": \"I needed user registration for a site whose users are all developers, and whose main client is not a browser — it is a skill running inside an agent session, in a terminal.\",\n      \"tags\": [\n        \"github-oauth\",\n        \"aws-lambda\",\n        \"authentication\",\n        \"device-flow\",\n        \"serverless\"\n      ],\n      \"stack\": null,\n      \"tier\": \"T0\",\n      \"capability\": \"T0 · inert — touches nothing\"\n    },\n    {\n      \"slug\": \"2026-10-06-one-table-decides-what-answers-without-a-token-how-i-stopped\",\n      \"title\": \"One table decides what answers without a token: how I stopped re-deciding auth tool by tool\",\n      \"summary\": \"In plain words: every endpoint of a server answers one question, \\\"may a stranger without an account use this?\\\"\",\n      \"tags\": [\n        \"mcp\",\n        \"authorization\",\n        \"api-design\",\n        \"testing\",\n        \"oauth\"\n      ],\n      \"stack\": \"Python 3.12 on AWS Lambda; remote MCP server (Streamable HTTP) plus a REST API; \",\n      \"tier\": \"T0\",\n      \"capability\": \"T0 · inert — touches nothing\"\n    },\n    {\n      \"slug\": \"2026-09-23-submitting-an-mcp-server-to-the-directories-one-cli-one-gith\",\n      \"title\": \"Submitting an MCP server to the directories: one CLI, one GitHub issue, three traps\",\n      \"summary\": \"I got my MCP server into the official MCP Registry and assumed distribution was handled.\",\n      \"tags\": [\n        \"mcp\",\n        \"mcp-directories\",\n        \"smithery\",\n        \"discoverability\",\n        \"oauth\",\n        \"publishing\"\n      ],\n      \"stack\": \"Remote MCP server (Streamable HTTP) on AWS Lambda / Python; Smithery CLI on Node\",\n      \"tier\": \"T0\",\n      \"capability\": \"T0 · inert — touches nothing\"\n    }\n  ],\n  \"about_tiers\": \"Tier is a CAPABILITY (blast-radius) disclosure, not a safety verdict: higher just means look closer. Run check_capability on the live files before applying a story.\"\n}"}],"structured_content":{"query":"oauth","count":13,"stories":[{"slug":"2026-09-14-adding-google-sign-in-so-non-developers-can-use-your-app","title":"Adding Google sign-in so non-developers can use your app","summary":"My site had exactly one way in: GitHub.","tags":["oauth","google-sign-in","authentication","identity","web"],"stack":"Google OAuth 2.0 · Python/AWS Lambda backend · vanilla-JS SPA","tier":"T0","capability":"T0 · inert — touches nothing"},{"slug":"2026-09-23-getting-into-the-mcp-registry-server-json-a-read-org-token-a","title":"Getting into the MCP Registry: server.json, a read:org token, and why listed ≠ discoverable","summary":"Publishing an MCP server to the official registry looked like a five-minute job.","tags":["mcp","mcp-registry","publishing","github-oauth","discoverability","cli"],"stack":"Model Co