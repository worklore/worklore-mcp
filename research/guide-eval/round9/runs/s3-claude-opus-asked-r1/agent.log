stat; zsh -n bin/nightly-review.zsh && bash -n bin/notify.sh && plutil -lint Library/LaunchAgents/com.vk.nightly-review.plist\n# test notify fallback without network: stub curl & security\nmkdir -p /tmp/stub-$$ && printf '#!/bin/sh\\necho \"curl $*\" >&2\\n' > /tmp/stub-$$/curl && printf '#!/bin/sh\\nexit 51\\n' > /tmp/stub-$$/security && chmod +x /tmp/stub-$$/*\nHOME=$PWD PATH=/tmp/stub-$$:$PATH bash bin/notify.sh hi 2>&1 | sed 's/bot[^/]*\\//bot<TOKEN>\\//'; echo rc=$?\n# test zsh script failure path with stubbed claude and notify\nmkdir -p /tmp/h2-$$/projects/shop /tmp/h2-$$/bin /tmp/h2-$$/Library/Logs\nprintf '#!/bin/sh\\necho \"Not logged in\" >&2; exit 1\\n' > /tmp/stub-$$/claude; chmod +x /tmp/stub-$$/claude\nprintf '#!/bin/sh\\necho \"NOTIFY: $1\"\\n' > /tmp/h2-$$/bin/notify.sh; chmod +x /tmp/h2-$$/bin/notify.sh\nHOME=/tmp/h2-$$ PATH=/tmp/stub-$$:$PATH zsh bin/nightly-review.zsh; echo rc=$?\nrm -rf /tmp/stub-$$ /tmp/h2-$$","is_backgrounded":false,"task_type":"local_bash","uuid":"8071958a-2289-46cd-bd77-fafbff45da39","session_id":"4994292f-b066-43bc-b6fb-e3924ef9435f"}
