diff --git a/bin/nightly-review.zsh b/bin/nightly-review.zsh
index e0b986f..e1c80d7 100755
--- a/bin/nightly-review.zsh
+++ b/bin/nightly-review.zsh
@@ -15,12 +15,14 @@ Do not modify any file."
 
 cd "$REPO" || { "$NOTIFY" "nightly review: repo missing"; exit 1; }
 
-claude -p "$PROMPT" --output-format text > "$OUT"
-status=$?
+# `status` is a read-only special parameter in zsh; assigning to it kills the
+# script before the failure notice. Use rc. Close stdin so claude -p never waits on it.
+claude -p "$PROMPT" --output-format text > "$OUT" 2>> "$OUT.err" < /dev/null
+rc=$?
 
-if [ $status -ne 0 ]; then
-  "$NOTIFY" "nightly review FAILED (exit $status), see $OUT"
-  exit $status
+if [ $rc -ne 0 ] || [ ! -s "$OUT" ]; then
+  "$NOTIFY" "nightly review FAILED (exit $rc): $(head -c 300 "$OUT.err" 2>/dev/null)"
+  exit $(( rc ? rc : 1 ))
 fi
 
 "$NOTIFY" "nightly review done: $(head -c 300 "$OUT")"
diff --git a/bin/notify.sh b/bin/notify.sh
index 818e531..bd671e2 100755
--- a/bin/notify.sh
+++ b/bin/notify.sh
@@ -1,7 +1,17 @@
 #!/bin/bash
 # usage: notify.sh "message"  — sends a Telegram message to me.
 set -eu
-: "${TG_BOT_TOKEN:=$(security find-generic-password -s tg-bot -w)}"
+# At 02:30 the login keychain may be locked, so `security` fails and set -e
+# kills us silently. Fall back to the config file (chmod 600).
+CONFIG="$HOME/.config/nightly-review/config.toml"
+if [ -z "${TG_BOT_TOKEN:-}" ]; then
+  TG_BOT_TOKEN=$(security find-generic-password -s tg-bot -w 2>/dev/null) ||
+    TG_BOT_TOKEN=$(sed -n 's/^telegram_bot_token *= *"\(.*\)"/\1/p' "$CONFIG" 2>/dev/null)
+fi
+if [ -z "${TG_BOT_TOKEN:-}" ]; then
+  echo "notify.sh: no Telegram token (keychain locked and $CONFIG unreadable)" >&2
+  exit 1
+fi
 CHAT_ID=123456789
 curl -sS -X POST "https://api.telegram.org/bot${TG_BOT_TOKEN}/sendMessage" \
   -d chat_id="$CHAT_ID" --data-urlencode text="$1" > /dev/null
