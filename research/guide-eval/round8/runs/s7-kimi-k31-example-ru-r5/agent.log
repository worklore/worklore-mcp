{"role":"tool","tool_call_id":"tool_fEm15zxb4sLXCpi9RIVoN3Jl","content":"130\t\n131\t    def do_GET(self):\n132\t        url = urllib.parse.urlsplit(self.path)\n133\t        q = dict(urllib.parse.parse_qsl(url.query))\n134\t        if url.path == \"/\":\n135\t            return self.send_file(\"index.html\", \"text/html; charset=utf-8\")\n136\t        if url.path.startswith(\"/static/\"):\n137\t            return self.send_file(os.path.basename(url.path), \"application/javascript\" if url.path.endswith(\".js\") else \"text/plain\")\n138\t        if url.path == \"/api/me\":\n139\t            user = self.require_user()\n140\t            return user and self.send_json(200, user)\n141\t        if url.path == \"/api/intervals/auth/init\":\n142\t            return self.auth_init()\n143\t        if url.path == \"/api/intervals/callback\":\n144\t            return self.callback(q)\n145\t        if url.path == \"/api/intervals/status\":\n146\t            return self.status()\n147\t        if url.path == \"/api/intervals/wellness\":\n148\t            return self.wellness()\n149\t        self.send_json(404, {\"error\": \"not found\"})\n150\t\n151\t    def do_POST(self):\n152\t        url = urllib.parse.urlsplit(self.path)\n153\t        if url.path == \"/api/intervals/disconnect\":\n154\t            user = self.require_user()\n155\t            if user:\n156\t                with LOCK:\n157\t                    CONNECTIONS.pop(user[\"id\"], None)\n158\t                self.send_json(200, {\"ok\": True})\n159\t            return\n160\t        self.send_json(404, {\"error\": \"not found\"})\n161\t\n162\t    # Step 1: build the authorize URL and send the browser to Intervals.\n163\t    def auth_init(self):\n164\t        user = self.require_user()\n165\t        if not user:\n166\t            return\n167\t        params = {\"client_id\": config.CLIENT_ID, \"redirect_uri\": config.REDIRECT_URI,\n168\t                  \"scope\": config.SCOPES, \"state\": sign_state(user[\"id\"])}\n169\t        self.redirect(AUTHORIZE_URL + \"?\" + urllib.parse.urlencode(params, safe=\":,\"))\n170\t\n171\t    # Step 2: Intervals redirects back here with ?code=&state=.\n172\t    def callback(self, q):\n173\t        user_id = verify_state(q.get(\"state\", \"\"))\n174\t        if not user_id or not q.get(\"code\"):\n175\t            return self.send_json(400, {\"error\": \"bad state or code\"})\n176\t        try:\n177\t            tok = exchange_code(q[\"code\"])\n178\t            store_connection(user_id, tok)\n179\t        except urllib.error.HTTPError as e:\n180\t            log(f\"{user_id}: token exchange failed: HTTP {e.code} {e.read()[:200]!r}\")\n181\t            return self.send_json(502, {\"error\": \"token exchange failed\"})\n182\t        except Exception as e:\n183\t            log(f\"{user_id}: token exchange failed: {e}\")\n184\t            return self.send_json(502, {\"error\": \"token exchange failed\"})\n185\t        self.redirect(\"/?connected=1\")\n186\t\n187\t    def status(self):\n188\t        user = self.require_user()\n189\t        if not user:\n190\t            return\n191\t        with LOCK:\n192\t            c = CONNECTIONS.get(user[\"id\"])\n193\t        if not c or c[\"status\"] != \"connected\":\n194\t            return self.send_json(200, {\"connected\": False, \"status\": c[\"status\"] if c else \"disconnected\"})\n195\t        self.send_json(200, {\"connected\": True, \"status\": \"connected\", \"scope\": c[\"scope\"],\n196\t                             \"athlete\": {\"id\": c[\"athlete_id\"], \"name\": c[\"athlete_name\"]}})\n197\t\n198\t    def wellness(self):\n199\t        user = self.require_user()\n200\t        if not user:\n201\t            return\n202\t        with LOCK:\n203\t            c = CONNECTIONS.get(user[\"id\"])\n204\t        if not c or c[\"status\"] != \"connected\":\n205\t            return self.send_json(409, {\"error\": \"intervals not connected\"})\n206\t        try:\n207\t            code, data = intervals_get(c, \"/wellness\")\n208\t            self.send_json(code, data)\n209\t        except urllib.error.HTTPError as e:\n210\t            self.send_json(e.code, {\"error\": f\"intervals returned {e.code}\"})\n211\t        except Exception as e:\n212\t            self.send_json(502, {\"error\": str(e)})\n213\t\n214\t\n215\tif __name__ == \"__main__\":\n216\t    threading.Thread(target=refresh_tokens, daemon=True).start()\n217\t    log(f\"serving on http://localhost:{config.PORT} (intervals: {config.INTERVALS_BASE})\")\n218\t    ThreadingHTTPServer((\"127.0.0.1\", config.PORT), Handler).serve_forever()"}
