{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013CHf8vin9tyPg9eGYykLMd","type":"tool_result","content":"# tricoach\n\nBackend + single-page app for a small triathlon coaching practice. Coaches\nplan the week; athletes see it and connect their Intervals.icu account so the\napp can read wellness data and push planned workouts to their calendar. The\nathlete signs in to tricoach (token in `localStorage`, sent as\n`Authorization: Bearer` by the SPA's fetch wrapper), then clicks\n\"Connect Intervals.icu\", which runs the OAuth flow against Intervals.\n\n`server.py` is stdlib only (`python3 server.py`, port 8766) and keeps\neverything in memory; the shape is the same as the Postgres tables in prod.\nDev sign-in tokens: `tok-okafor` (default in the SPA) and `tok-rivera`.\n`config.py` holds the OAuth client placeholders. `logs/` has what we captured\nwhile looking into the connection problems.\nimport os\n\nPORT = 8766\nAPP_SECRET = \"dev-only-change-me-7c1f0a\"          # signs the OAuth state parameter\n\n# Intervals.icu OAuth client (placeholders; the real pair is in the deploy env)\nINTERVALS_BASE = os.environ.get(\"INTERVALS_BASE\", \"https://intervals.icu\")\nCLIENT_ID = \"tricoach-dev\"\nCLIENT_SECRET = \"s3cr3t-placeholder-0000\"\nREDIRECT_URI = f\"http://localhost:{PORT}/api/intervals/callback\"\nSCOPES = \"ACTIVITY:READ,ACTIVITY:WRITE,WELLNESS:READ,CALENDAR:READ,CALENDAR:WRITE\"\n\nREFRESH_INTERVAL = 60      # seconds between passes of the token refresher\n#!/usr/bin/env python3\n\"\"\"tricoach backend: sign-in, Intervals.icu OAuth connection, wellness proxy.\n\nStdlib only. State is in memory (same shape as the prod tables).\n\"\"\"\nimport base64, hashlib, hmac, json, os, threading, time\nimport urllib.error, urllib.parse, urllib.request\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\n\nimport config\n\nSTATIC = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"static\")\nTOKEN_URL = config.INTERVALS_BASE + \"/api/oauth/token\"\nAUTHORIZE_URL = config.INTERVALS_BASE + \"/oauth/authorize\"\nDEFAULT_TOKEN_TTL = 3600   # seconds; used when the provider does not say how long a token lives\n\n# --- in-memory store -------------------------------------------------------\nUSERS = {\n    \"tok-okafor\": {\"id\": \"u_okafor\", \"name\": \"C. Okafor\"},\n    \"tok-rivera\": {\"id\": \"u_rivera\", \"name\": \"T. Rivera\"},\n}\n# user_id -> {athlete_id, athlete_name, access_token, refresh_token, scope, expires_at, status}\nCONNECTIONS = {}\nLOCK = threading.Lock()\n\n\ndef log(msg):\n    print(time.strftime(\"%Y-%m-%d %H:%M:%S\"), \"[intervals]\", msg, flush=True)\n\n\n# --- state parameter: carries the user through the redirect -----------------\ndef sign_state(user_id):\n    payload = f\"{user_id}:{int(time.time())}\"\n    sig = hmac.new(config.APP_SECRET.encode(), payload.encode(), hashlib.sha256).hexdigest()[:32]\n    return base64.urlsafe_b64encode(f\"{payload}:{sig}\".encode()).decode()\n\n\ndef verify_state(state, max_age=900):\n    try:\n        user_id, ts, sig = base64.urlsafe_b64decode(state.encode()).decode().split(\":\")\n    except Exception:\n        return None\n    payload = f\"{user_id}:{ts}\"\n    good = hmac.new(config.APP_SECRET.encode(), payload.encode(), hashlib.sha256).hexdigest()[:32]\n    if not hmac.compare_digest(good, sig) or time.time() - int(ts) > max_age:\n        return None\n    return user_id\n\n\n# --- Intervals.icu calls ----------------------------------------------------\ndef post_form(url, fields):\n    data = urllib.parse.urlencode(fields).encode()\n    req = urllib.request.Request(url, data=data, headers={\"Accept\": \"application/json\"})\n    with urllib.request.urlopen(req, timeout=15) as r:\n        return json.loads(r.read().decode())\n\n\ndef exchange_code(code):\n    return post_form(TOKEN_URL, {\n        \"grant_type\": \"authorization_code\", \"client_id\": config.CLIENT_ID,\n        \"client_secret\": config.CLIENT_SECRET, \"code\": code, \"redirect_uri\": config.REDIRECT_URI,\n    })\n\n\ndef store_connection(user_id, tok):\n    expires_in = int(tok.get(\"expires_in\") or DEFAULT_TOKEN_TTL)\n    refresh = tok.get(\"refresh_token\")\n    if not refresh:\n        log(f\"{user_id}: no refresh_token in response, scheduling expiry in {expires_in}s\")\n    athlete = tok.get(\"athlete\") or {}\n    with LOCK:\n        CONNECTIONS[user_id] = {\n            \"athlete_id\": athlete.get(\"id\"), \"athlete_name\": athlete.get(\"name\"),\n            \"access_token\": tok[\"access_token\"], \"refresh_token\": refresh,\n            \"scope\": tok.get(\"scope\"), \"expires_at\": time.time() + expires_in, \"status\": \"connected\",\n        }\n    log(f\"{user_id}: connected as athlete {athlete.get('id')} (expires in {expires_in}s)\")\n\n\ndef refresh_tokens():\n    \"\"\"Background pass: renew access tokens shortly before they expire.\"\"\"\n    while True:\n        time.sleep(config.REFRESH_INTERVAL)\n        now = time.time()\n        with LOCK:\n            for uid, c in CONNECTIONS.items():\n                if c[\"status\"] != \"connected\" or c[\"expires_at\"] - now > 300:\n                    continue\n                if not c[\"refresh_token\"]:\n                    log(f\"{uid}: token expiry passed and no refresh token on file -> expired, reconnect\")\n                    c.update(status=\"expired, reconnect\", access_token=None)\n                    continue\n                try:\n                    tok = post_form(TOKEN_URL, {\n                        \"grant_type\": \"refresh_token\", \"refresh_token\": c[\"refresh_token\"],\n                        \"client_id\": config.CLIENT_ID, \"client_secret\": config.CLIENT_SECRET,\n                    })\n                    c.update(access_token=tok[\"access_token\"],\n                             refresh_token=tok.get(\"refresh_token\", c[\"refresh_token\"]),\n                             expires_at=now + int(tok[\"expires_in\"]))\n                    log(f\"{uid}: token refreshed\")\n                except Exception as e:\n                    log(f\"{uid}: refresh failed ({e}) -> expired, reconnect\")\n                    c.update(status=\"expired, reconnect\", access_token=None)\n\n\ndef intervals_get(conn, path):\n    req = urllib.request.Request(f\"{config.INTERVALS_BASE}/api/v1/athlete/{conn['athlete_id']}{path}\",\n                                 headers={\"Authorization\": \"Bearer \" + conn[\"access_token\"]})\n    with urllib.request.urlopen(req, timeout=15) as r:\n        return r.status, json.loads(r.read().decode())\n\n\n# --- HTTP ---------------------------------------------------------------------\nclass Handler(BaseHTTPRequestHandler):\n    def log_message(self, fmt, *args):\n        print(time.strftime(\"%Y-%m-%d %H:%M:%S\"), \"[http]\", fmt % args, flush=True)\n\n    def send_json(self, code, obj):\n        body = json.dumps(obj).encode()\n        self.send_response(code)\n        self.send_header(\"Content-Type\", \"application/json\")\n        self.send_header(\"Content-Length\", str(len(body)))\n        self.end_headers()\n        self.wfile.write(body)\n\n    def send_file(self, name, ctype):\n        p = os.path.join(STATIC, name)\n        if not os.path.isfile(p):\n            return self.send_json(404, {\"error\": \"not found\"})\n        with open(p, \"rb\") as f:\n            body = f.read()\n        self.send_response(200)\n        self.send_header(\"Content-Type\", ctype)\n        self.send_header(\"Content-Length\", str(len(body)))\n        self.end_headers()\n        self.wfile.write(body)\n\n    def redirect(self, url):\n        self.send_response(302)\n        self.send_header(\"Location\", url)\n        self.end_headers()\n\n    def current_user(self):\n        auth = self.headers.get(\"Authorization\", \"\")\n        if not auth.startswith(\"Bearer \"):\n            return None\n        return USERS.get(auth[7:].strip())\n\n    def require_user(self):\n        user = self.current_user()\n        if user is None:\n            self.log_message(\"%s %s 401 (no Authorization header)\", self.command, self.path)\n            self.send_json(401, {\"error\": \"unauthorized\"})\n        return user\n\n    def do_GET(self):\n        url = urllib.parse.urlsplit(self.path)\n        q = dict(urllib.parse.parse_qsl(url.query))\n        if url.path == \"/\":\n            return self.send_file(\"index.html\", \"text/html; charset=utf-8\")\n        if url.path.startswith(\"/static/\"):\n            return self.send_file(os.path.basename(url.path), \"application/javascript\" if url.path.endswith(\".js\") else \"text/plain\")\n        if url.path == \"/api/me\":\n            user = self.require_user()\n            return user and self.send_json(200, user)\n        if url.path == \"/api/intervals/auth/init\":\n            return self.auth_init()\n        if url.path == \"/api/intervals/callback\":\n            return self.callback(q)\n        if url.path == \"/api/intervals/status\":\n            return self.status()\n        if url.path == \"/api/intervals/wellness\":\n            return self.wellness()\n        self.send_json(404, {\"error\": \"not found\"})\n\n    def do_POST(self):\n        url = urllib.parse.urlsplit(self.path)\n        if url.path == \"/api/intervals/disconnect\":\n            user = self.require_user()\n            if user:\n                with LOCK:\n                    CONNECTIONS.pop(user[\"id\"], None)\n                self.send_json(200, {\"ok\": True})\n            return\n        self.send_json(404, {\"error\": \"not found\"})\n\n    # Step 1: build the authorize URL and send the browser to Intervals.\n    def auth_init(self):\n        user = self.require_user()\n        if not user:\n            return\n        params = {\"client_id\": config.CLIENT_ID, \"redirect_uri\": config.REDIRECT_URI,\n                  \"scope\": config.SCOPES, \"state\": sign_state(user[\"id\"])}\n        self.redirect(AUTHORIZE_URL + \"?\" + urllib.parse.urlencode(params, safe=\":,\"))\n\n    # Step 2: Intervals redirects back here with ?code=&state=.\n    def callback(self, q):\n        user_id = verify_state(q.get(\"state\", \"\"))\n        if not user_id or not q.get(\"code\"):\n            return self.send_json(400, {\"error\": \"bad state or code\"})\n        try:\n            tok = exchange_code(q[\"code\"])\n            store_connection(user_id, tok)\n        except urllib.error.HTTPError as e:\n            log(f\"{user_id}: token exchange failed: HTTP {e.code} {e.read()[:200]!r}\")\n            return self.send_json(502, {\"error\": \"token exchange failed\"})\n        except Exception as e:\n            log(f\"{user_id}: token exchange failed: {e}\")\n            return self.send_json(502, {\"error\": \"token exchange failed\"})\n        self.redirect(\"/?connected=1\")\n\n    def status(self):\n        user = self.require_user()\n        if not user:\n            return\n        with LOCK:\n            c = CONNECTIONS.get(user[\"id\"])\n        if not c or c[\"status\"] != \"connected\":\n            return self.send_json(200, {\"connected\": False, \"status\": c[\"status\"] if c else \"disconnected\"})\n        self.send_json(200, {\"connected\": True, \"status\": \"connected\", \"scope\": c[\"scope\"],\n                             \"athlete\": {\"id\": c[\"athlete_id\"], \"name\": c[\"athlete_name\"]}})\n\n    def wellness(self):\n        user = self.require_user()\n        if not user:\n            return\n        with LOCK:\n            c = CONNECTIONS.get(user[\"id\"])\n        if not c or c[\"status\"] != \"connected\":\n            return self.send_json(409, {\"error\": \"intervals not connected\"})\n        try:\n            code, data = intervals_get(c, \"/wellness\")\n            self.send_json(code, data)\n        except urllib.error.HTTPError as e:\n            self.send_json(e.code, {\"error\": f\"intervals returned {e.code}\"})\n        except Exception as e:\n            self.send_json(502, {\"error\": str(e)})\n\n\nif __name__ == \"__main__\":\n    threading.Thread(target=refresh_tokens, daemon=True).start()\n    log(f\"serving on http://localhost:{config.PORT} (intervals: {config.INTERVALS_BASE})\")\n    ThreadingHTTPServer((\"127.0.0.1\", config.PORT), Handler).serve_forever()\n// tricoach SPA. The sign-in token lives in localStorage and travels on every\n// API call via the fetch wrapper below.\nconst TOKEN = localStorage.getItem(\"tc_token\") || \"tok-okafor\";\nconst root = document.getElementById(\"app\");\n\nasync function api(path, opts = {}) {\n  const headers = Object.assign({ \"Authorization\": \"Bearer \" + TOKEN }, opts.headers || {});\n  const res = await fetch(path, Object.assign({}, opts, { headers }));\n  const body = await res.json().catch(() => ({}));\n  if (!res.ok) throw new Error(body.error || (\"HTTP \" + res.status));\n  return body;\n}\n\nfunction esc(s) { return String(s).replace(/[&<>\"]/g, c => ({ \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\" }[c])); }\n\nasync function render() {\n  try {\n    const me = await api(\"/api/me\");\n    const st = await api(\"/api/intervals/status\");\n    let card;\n    if (st.connected) {\n      card = `<div class=\"card\">Connected to Intervals.icu as <b>${esc(st.athlete.name)}</b>\n        (${esc(st.athlete.id)}), scope <code>${esc(st.scope)}</code>.\n        <p><button class=\"btn\" id=\"disconnect\">Disconnect</button></p></div>`;\n    } else {\n      const why = st.status && st.status !== \"disconnected\" ? `<p class=\"muted\">Status: ${esc(st.status)}</p>` : \"\";\n      card = `<div class=\"card\">Intervals.icu is not connected.${why}\n        <p><a class=\"btn\" href=\"/api/intervals/auth/init\">Connect Intervals.icu</a></p></div>`;\n    }\n    root.className = \"\";\n    root.innerHTML = `<p>Signed in as <b>${esc(me.name)}</b>.</p>${card}`;\n    const d = document.getElementById(\"disconnect\");\n    if (d) d.onclick = async () => { await api(\"/api/intervals/disconnect\", { method: \"POST\" }); render(); };\n  } catch (e) {\n    root.innerHTML = `<p class=\"card\">Error: ${esc(e.message)}</p>`;\n  }\n}\n\nrender();\n<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<title>tricoach</title>\n<style>\n  body { font: 15px/1.5 system-ui, sans-serif; margin: 2rem auto; max-width: 42rem; padding: 0 1rem; }\n  .btn { display: inline-block; padding: .5rem 1rem; border-radius: 6px; background: #1d4ed8; color: #fff; text-decoration: none; border: 0; cursor: pointer; }\n  .card { border: 1px solid #ddd; border-radius: 8px; padding: 1rem; margin: 1rem 0; }\n  .muted { color: #666; }\n</style>\n</head>\n<body>\n<h1>tricoach</h1>\n<div id=\"app\" class=\"muted\">Loading…</div>\n<script src=\"/static/app.js\"></script>\n</body>\n</html>","is_error":false}]},"parent_tool_use_id":null,"session_id":"7f1c85c6-432c-4075-96ab-604bce32a6bb","uuid":"f00c0c2a-ca8e-40c3-9509-3b4234fc8f6e","timestamp":"2026-10-27T03:31:37.142Z","tool_use_result":{"stdout":"# tricoach\n\nBackend + single-page app for a small triathlon coaching practice. Coaches\nplan the week; athletes see it and connect their Intervals.icu account so the\napp can read wellness data and push planned workouts to their calendar. The\nathlete signs in to tricoach (token in `localStorage`, sent as\n`Authorization: Bearer` by the SPA's fetch wrapper), then clicks\n\"Connect Intervals.icu\", which runs the OAuth flow against Intervals.\n\n`server.py` is stdlib only (`python3 server.py`, port 8766) and keeps\neverything in memory; the shape is the same as the Postgres tables in prod.\nDev sign-in tokens: `tok-okafor` (default in the SPA) and `tok-rivera`.\n`config.py` holds the OAuth client placeholders. `logs/` has what we captured\nwhile looking into the connection problems.\nimport os\n\nPORT = 8766\nAPP_SECRET = \"dev-only-change-me-7c1f0a\"          # signs the OAuth state parameter\n\n# Intervals.icu OAuth client (placeholders; the real pair is in the deploy env)\nINTERVALS_BASE = os.environ.get(\"INTERVALS_BASE\", \"https://intervals.icu\")\nCLIENT_ID = \"tricoach-dev\"\nCLIENT_SECRET = \"s3cr3t-placeholder-0000\"\nREDIRECT_URI = f\"http://localhost:{PORT}/api/intervals/callback\"\nSCOPES = \"ACTIVITY:READ,ACTIVITY:WRITE,WELLNESS:READ,CALENDAR:READ,CALENDAR:WRITE\"\n\nREFRESH_INTERVAL = 60      # seconds between passes of the token refresher\n#!/usr/bin/env python3\n\"\"\"tricoach backend: sign-in, Intervals.icu OAuth connection, wellness proxy.\n\nStdlib only. State is in memory (same shape as the prod tables).\n\"\"\"\nimport base64, hashlib, hmac, json, os, threading, time\nimport urllib.error, urllib.parse, urllib.request\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\n\nimport config\n\nSTATIC = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"static\")\nTOKEN_URL = config.INTERVALS_BASE + \"/api/oauth/token\"\nAUTHORIZE_URL = config.INTERVALS_BASE + \"/oauth/authorize\"\nDEFAULT_TOKEN_TTL = 3600   # seconds; used when the provider does not say how long a token lives\n\n# --- in-memory store -------------------------------------------------------\nUSERS = {\n    \"tok-okafor\": {\"id\": \"u_okafor\", \"name\": \"C. Okafor\"},\n    \"tok-rivera\": {\"id\": \"u_rivera\", \"name\": \"T. Rivera\"},\n}\n# user_id -> {athlete_id, athlete_name, access_token, refresh_token, scope, expires_at, status}\nCONNECTIONS = {}\nLOCK = threading.Lock()\n\n\ndef log(msg):\n    print(time.strftime(\"%Y-%m-%d %H:%M:%S\"), \"[intervals]\", msg, flush=True)\n\n\n# --- state parameter: carries the user through the redirect -----------------\ndef sign_state(user_id):\n    payload = f\"{user_id}:{int(time.time())}\"\n    sig = hmac.new(config.APP_SECRET.encode(), payload.encode(), hashlib.sha256).hexdigest()[:32]\n    return base64.urlsafe_b64encode(f\"{payload}:{sig}\".encode()).decode()\n\n\ndef verify_state(state, max_age=900):\n    try:\n        user_id, ts, sig = base64.urlsafe_b64decode(state.encode()).decode().split(\":\")\n    except Exception:\n        return None\n    payload = f\"{user_id}:{ts}\"\n    good = hmac.new(config.APP_SECRET.encode(), payload.encode(), hashlib.sha256).hexdigest()[:32]\n    if not hmac.compare_digest(good, sig) or time.time() - int(ts) > max_age:\n        return None\n    return user_id\n\n\n# --- Intervals.icu calls ----------------------------------------------------\ndef post_form(url, fields):\n    data = urllib.parse.urlencode(fields).encode()\n    req = urllib.request.Request(url, data=data, headers={\"Accept\": \"application/json\"})\n    with urllib.request.urlopen(req, timeout=15) as r:\n        return json.loads(r.read().decode())\n\n\ndef exchange_code(code):\n    return post_form(TOKEN_URL, {\n        \"grant_type\": \"authorization_code\", \"client_id\": config.CLIENT_ID,\n        \"client_secret\": config.CLIENT_SECRET, \"code\": code, \"redirect_uri\": config.REDIRECT_URI,\n    })\n\n\ndef store_connection(user_id, tok):\n    expires_in = int(tok.get(\"expires_in\") or DEFAULT_TOKEN_TTL)\n    refresh = tok.get(\"refresh_token\")\n    if not refresh:\n        log(f\"{user_id}: no refresh_token in response, scheduling expiry in {expires_in}s\")\n    athlete = tok.get(\"athlete\") or {}\n    with LOCK:\n        CONNECTIONS[user_id] = {\n            \"athlete_id\": athlete.get(\"id\"), \"athlete_name\": athlete.get(\"name\"),\n            \"access_token\": tok[\"access_token\"], \"refresh_token\": refresh,\n            \"scope\": tok.get(\"scope\"), \"expires_at\": time.time() + expires_in, \"status\": \"connected\",\n        }\n    log(f\"{user_id}: connected as athlete {athlete.get('id')} (expires in {expires_in}s)\")\n\n\ndef refresh_tokens():\n    \"\"\"Background pass: renew access tokens shortly before they expire.\"\"\"\n    while True:\n        time.sleep(config.REFRESH_INTERVAL)\n        now = time.time()\n        with LOCK:\n            for uid, c in CONNECTIONS.items():\n                if c[\"status\"] != \"connected\" or c[\"expires_at\"] - now > 300:\n                    continue\n                if not c[\"refresh_token\"]:\n                    log(f\"{uid}: token expiry passed and no refresh token on file -> expired, reconnect\")\n                    c.update(status=\"expired, reconnect\", access_token=None)\n                    continue\n                try:\n                    tok = post_form(TOKEN_URL, {\n                        \"grant_type\": \"refresh_token\", \"refresh_token\": c[\"refresh_token\"],\n                        \"client_id\": config.CLIENT_ID, \"client_secret\": config.CLIENT_SECRET,\n                    })\n                    c.update(access_token=tok[\"access_token\"],\n                             refresh_token=tok.get(\"refresh_token\", c[\"refresh_token\"]),\n                             expires_at=now + int(tok[\"expires_in\"]))\n                    log(f\"{uid}: token refreshed\")\n                except Exception as e:\n                    log(f\"{uid}: refresh failed ({e}) -> expired, reconnect\")\n                    c.update(status=\"expired, reconnect\", access_token=None)\n\n\ndef intervals_get(conn, path):\n    req = urllib.request.Request(f\"{config.INTERVALS_BASE}/api/v1/athlete/{conn['athlete_id']}{path}\",\n                                 headers={\"Authorization\": \"Bearer \" + conn[\"access_token\"]})\n    with urllib.request.urlopen(req, timeout=15) as r:\n        return r.status, json.loads(r.read().decode())\n\n\n# --- HTTP ---------------------------------------------------------------------\nclass Handler(BaseHTTPRequestHandler):\n    def log_message(self, fmt, *args):\n        print(time.strftime(\"%Y-%m-%d %H:%M:%S\"), \"[http]\", fmt % args, flush=True)\n\n    def send_json(self, code, obj):\n        body = json.dumps(obj).encode()\n        self.send_response(code)\n        self.send_header(\"Content-Type\", \"application/json\")\n        self.send_header(\"Content-Length\", str(len(body)))\n        self.end_headers()\n        self.wfile.write(body)\n\n    def send_file(self, name, ctype):\n        p = os.path.join(STATIC, name)\n        if not os.path.isfile(p):\n            return self.send_json(404, {\"error\": \"not found\"})\n        with open(p, \"rb\") as f:\n            body = f.read()\n        self.send_response(200)\n        self.send_header(\"Content-Type\", ctype)\n        self.send_header(\"Content-Length\", str(len(body)))\n        self.end_headers()\n        self.wfile.write(body)\n\n    def redirect(self, url):\n        self.send_response(302)\n        self.send_header(\"Location\", url)\n        self.end_headers()\n\n    def current_user(self):\n        auth = self.headers.get(\"Authorization\", \"\")\n        if not auth.startswith(\"Bearer \"):\n            return None\n        return USERS.get(auth[7:].strip())\n\n    def require_user(self):\n        user = self.current_user()\n        if user is None:\n            self.log_message(\"%s %s 401 (no Authorization header)\", self.command, self.path)\n            self.send_json(401, {\"error\": \"unauthorized\"})\n        return user\n\n    def do_GET(self):\n        url = urllib.parse.urlsplit(self.path)\n        q = dict(urllib.parse.parse_qsl(url.query))\n        if url.path == \"/\":\n            return self.send_file(\"index.html\", \"text/html; charset=utf-8\")\n        if url.path.startswith(\"/static/\"):\n            return self.send_file(os.path.basename(url.path), \"application/javascript\" if url.path.endswith(\".js\") else \"text/plain\")\n        if url.path == \"/api/me\":\n            user = self.require_user()\n            return user and self.send_json(200, user)\n        if url.path == \"/api/intervals/auth/init\":\n            return self.auth_init()\n        if url.path == \"/api/intervals/callback\":\n            return self.callback(q)\n        if url.path == \"/api/intervals/status\":\n            return self.status()\n        if url.path == \"/api/intervals/wellness\":\n            return self.wellness()\n        self.send_json(404, {\"error\": \"not found\"})\n\n    def do_POST(self):\n        url = urllib.parse.urlsplit(self.path)\n        if url.path == \"/api/intervals/disconnect\":\n            user = self.require_user()\n            if user:\n                with LOCK:\n                    CONNECTIONS.pop(user[\"id\"], None)\n                self.send_json(200, {\"ok\": True})\n            return\n        self.send_json(404, {\"error\": \"not found\"})\n\n    # Step 1: build the authorize URL and send the browser to Intervals.\n    def auth_init(self):\n        user = self.require_user()\n        if not user:\n            return\n        params = {\"client_id\": config.CLIENT_ID, \"redirect_uri\": config.REDIRECT_URI,\n                  \"scope\": config.SCOPES, \"state\": sign_state(user[\"id\"])}\n        self.redirect(AUTHORIZE_URL + \"?\" + urllib.parse.urlencode(params, safe=\":,\"))\n\n    # Step 2: Intervals redirects back here with ?code=&state=.\n    def callback(self, q):\n        user_id = verify_state(q.get(\"state\", \"\"))\n        if not user_id or not q.get(\"code\"):\n            return self.send_json(400, {\"error\": \"bad state or code\"})\n        try:\n            tok = exchange_code(q[\"code\"])\n            store_connection(user_id, tok)\n        except urllib.error.HTTPError as e:\n            log(f\"{user_id}: token exchange failed: HTTP {e.code} {e.read()[:200]!r}\")\n            return self.send_json(502, {\"error\": \"token exchange failed\"})\n        except Exception as e:\n            log(f\"{user_id}: token exchange failed: {e}\")\n            return self.send_json(502, {\"error\": \"token exchange failed\"})\n        self.redirect(\"/?connected=1\")\n\n    def status(self):\n        user = self.require_user()\n        if not user:\n            return\n        with LOCK:\n            c = CONNECTIONS.get(user[\"id\"])\n        if not c or c[\"status\"] != \"connected\":\n            return self.send_json(200, {\"connected\": False, \"status\": c[\"status\"] if c else \"disconnected\"})\n        self.send_json(200, {\"connected\": True, \"status\": \"connected\", \"scope\": c[\"scope\"],\n                             \"athlete\": {\"id\": c[\"athlete_id\"], \"name\": c[\"athlete_name\"]}})\n\n    def wellness(self):\n        user = self.require_user()\n        if not user:\n            return\n        with LOCK:\n            c = CONNECTIONS.get(user[\"id\"])\n        if not c or c[\"status\"] != \"connected\":\n            return self.send_json(409, {\"error\": \"intervals not connected\"})\n        try:\n            code, data = intervals_get(c, \"/wellness\")\n            self.send_json(code, data)\n        except urllib.error.HTTPError as e:\n            self.send_json(e.code, {\"error\": f\"intervals returned {e.code}\"})\n        except Exception as e:\n            self.send_json(502, {\"error\": str(e)})\n\n\nif __name__ == \"__main__\":\n    threading.Thread(target=refresh_tokens, daemon=True).start()\n    log(f\"serving on http://localhost:{config.PORT} (intervals: {config.INTERVALS_BASE})\")\n    ThreadingHTTPServer((\"127.0.0.1\", config.PORT), Handler).serve_forever()\n// tricoach SPA. The sign-in token lives in localStorage and travels on every\n// API call via the fetch wrapper below.\nconst TOKEN = localStorage.getItem(\"tc_token\") || \"tok-okafor\";\nconst root = document.getElementById(\"app\");\n\nasync function api(path, opts = {}) {\n  const headers = Object.assign({ \"Authorization\": \"Bearer \" + TOKEN }, opts.headers || {});\n  const res = await fetch(path, Object.assign({}, opts, { headers }));\n  const body = await res.json().catch(() => ({}));\n  if (!res.ok) throw new Error(body.error || (\"HTTP \" + res.status));\n  return body;\n}\n\nfunction esc(s) { return String(s).replace(/[&<>\"]/g, c => ({ \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\" }[c])); }\n\nasync function render() {\n  try {\n    const me = await api(\"/api/me\");\n    const st = await api(\"/api/intervals/status\");\n    let card;\n    if (st.connected) {\n      card = `<div class=\"card\">Connected to Intervals.icu as <b>${esc(st.athlete.name)}</b>\n        (${esc(st.athlete.id)}), scope <code>${esc(st.scope)}</code>.\n        <p><button class=\"btn\" id=\"disconnect\">Disconnect</button></p></div>`;\n    } else {\n      const why = st.status && st.status !== \"disconnected\" ? `<p class=\"muted\">Status: ${esc(st.status)}</p>` : \"\";\n      card = `<div class=\"card\">Intervals.icu is not connected.${why}\n        <p><a class=\"btn\" href=\"/api/intervals/auth/init\">Connect Intervals.icu</a></p></div>`;\n    }\n    root.className = \"\";\n    root.innerHTML = `<p>Signed in as <b>${esc(me.name)}</b>.</p>${card}`;\n    const d = document.getElementById(\"disconnect\");\n    if (d) d.onclick = async () => { await api(\"/api/intervals/disconnect\", { method: \"POST\" }); render(); };\n  } catch (e) {\n    root.innerHTML = `<p class=\"card\">Error: ${esc(e.message)}</p>`;\n  }\n}\n\nrender();\n<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<title>tricoach</title>\n<style>\n  body { font: 15px/1.5 system-ui, sans-serif; margin: 2rem auto; max-width: 42rem; padding: 0 1rem; }\n  .btn { display: inline-block; padding: .5rem 1rem; border-radius: 6px; background: #1d4ed8; color: #fff; text-decoration: none; border: 0; cursor: pointer; }\n  .card { border: 1px solid #ddd; border-radius: 8px; padding: 1rem; margin: 1rem 0; }\n  .muted { color: #666; }\n</style>\n</head>\n<body>\n<h1>tricoach</h1>\n<div id=\"app\" class=\"muted\">Loading…</div>\n<script src=\"/static/app.js\"></script>\n</body>\n</html>","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_013CHf8vin9tyPg9eGYykLMd","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
