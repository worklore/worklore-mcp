     # Step 1: build the authorize URL and send the browser to Intervals.
     def auth_init(self):
-        user = self.require_user()
+        # Allow authentication without the Authorization header for the Connect flow.
+        # Try to determine the user via the Authorization header first; if missing, fall back to a 'tk' query parameter.
+        token = None
+        auth_header = self.headers.get("Authorization", "")
+        if auth_header.startswith("Bearer "):
+            token = auth_header[7:].strip()
+        else:
+            # Parse query parameters from the request URL.
+            url = urllib.parse.urlsplit(self.path)
+            q = dict(urllib.parse.parse_qsl(url.query))
+            token = q.get("tk")
+        user = USERS.get(token) if token else None
         if not user:
-            return
+            self.log_message("%s %s 401 (no valid token for auth_init)", self.command, self.path)
+            return self.send_json(401, {"error": "unauthorized"})
         params = {"client_id": config.CLIENT_ID, "redirect_uri": config.REDIRECT_URI,
-                  "scope": config.SCOPES, "state": sign_state(user["id"])}
+                  "scope": config.SCOPES, "state": sign_state(user["id"]) }
         self.redirect(AUTHORIZE_URL + "?" + urllib.parse.urlencode(params, safe=":,"))
 
