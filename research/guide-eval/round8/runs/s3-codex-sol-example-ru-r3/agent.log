{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport os, pathlib, subprocess, tempfile\nfrom pathlib import Path\nscript = Path('bin/nightly-review.zsh').resolve()\nwith tempfile.TemporaryDirectory(prefix='.nightly-test-', dir='.') as root:\n    root = Path(root)\n    home = root / 'home'\n    for p in ('projects/shop', 'bin', 'Library/Logs'):\n        (home / p).mkdir(parents=True)\n    mocks = root / 'mocks'\n    mocks.mkdir()\n    notifier = home / 'bin/notify.sh'\n    notifier.write_text('#\"'!/bin/sh'\"\\\\nprintf \\\"%s\\\\\\\\n\\\" \\\"\"'$1\" >> \"$NOTICE_LOG\"'\"\\\\n')\n    notifier.chmod(0o755)\n    claude = mocks / 'claude'\n    claude.write_text('''#\"'!/usr/bin/env python3\nimport os, sys\nassert sys.stdin.read() == '\"'', 'stdin was not closed'\nassert sys.argv[1:3] == ['-p', sys.argv[2]], 'prompt argument absent'\ncase = os.environ['CLAUDE_CASE']\nif case == 'success': print('Review complete')\nelif case == 'failure': print('Not logged in', file=sys.stderr); sys.exit(7)\n''')\n    claude.chmod(0o755)\n    for case, expected_rc, expected_notice in (\n        ('success', 0, 'nightly review done:'),\n        ('failure', 7, 'nightly review FAILED:'),\n        ('empty', 1, 'nightly review FAILED:'),\n    ):\n        notice = root / f'{case}.notice'\n        env = dict(os.environ, HOME=str(home), PATH=f'{mocks}:{os.environ[\\\"PATH\\\"]}', NOTICE_LOG=str(notice), CLAUDE_CASE=case)\n        result = subprocess.run(['/bin/zsh', str(script)], env=env, text=True, capture_output=True)\n        message = notice.read_text() if notice.exists() else ''\n        assert result.returncode == expected_rc, (case, result.returncode, result.stderr)\n        assert message.startswith(expected_notice), (case, message, result.stderr)\n        print(f'{case}: exit {result.returncode}, notification delivered to local stub')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
