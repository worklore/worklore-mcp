p\"] <= now + STATE_TTL):\n+            return None\n+        if claims[\"sub\"] not in {u[\"id\"] for u in USERS.values()}:\n+            return None\n+        return claims[\"sub\"]\n+    except (ValueError, TypeError, KeyError, UnicodeDecodeError, json.JSONDecodeError):\n         return None\n-    return user_id\n \n \n # --- Intervals.icu calls ----------------------------------------------------\n@@ -57,51 +67,25 @@ def post_form(url, fields):\n \n def exchange_code(code):\n     return post_form(TOKEN_URL, {\n-        \"grant_type\": \"authorization_code\", \"client_id\": config.CLIENT_ID,\n-        \"client_secret\": config.CLIENT_SECRET, \"code\": code, \"redirect_uri\": config.REDIRECT_URI,\n+        \"client_id\": config.CLIENT_ID, \"client_secret\": config.CLIENT_SECRET, \"code\": code,\n     })\n \n \n def store_connection(user_id, tok):\n-    expires_in = int(tok.get(\"expires_in\") or DEFAULT_TOKEN_TTL)\n-    refresh = tok.get(\"refresh_token\")\n-    if not refresh:\n-        log(f\"{user_id}: no refresh_token in response, scheduling expiry in {expires_in}s\")\n-    athlete = tok.get(\"athlete\") or {}\n+    athlete = tok[\"athlete\"]\n+    athlete_id = athlete[\"id\"]\n+    access_token = tok[\"access_token\"]\n+    if not athlete_id or not access_token:\n+        raise ValueError(\"incomplete Intervals token response\")\n     with LOCK:\n+        previous = CONNECTIONS.get(user_id)\n+        if previous and previous[\"athlete_id\"] != athlete_id:\n+            raise ValueError(\"Intervals athlete differs from the existing connection; disconnect first\")\n         CONNECTIONS[user_id] = {\n-            \"athlete_id\": athlete.get(\"id\"), \"athlete_name\": athlete.get(\"name\"),\n-            \"access_token\": tok[\"access_token\"], \"refresh_token\": refresh,\n-            \"scope\": tok.get(\"scope\"), \"expires_at\": time.time() + expires_in, \"status\": \"connected\",\n+            \"athlete_id\": athlete_id, \"athlete_name\": athlete.get(\"name\"),\n+            \"access_token\": access_token, \"scope\": tok.get(\"scope\"), \"status\": \"connected\",\n         }\n-    log(f\"{user_id}: connected as athlete {athlete.get('id')} (expires in {expires_in}s)\")\n-\n-\n-def refresh_tokens():\n-    \"\"\"Background pass: renew access tokens shortly before they expire.\"\"\"\n-    while True:\n-        time.sleep(config.REFRESH_INTERVAL)\n-        now = time.time()\n-        with LOCK:\n-            for uid, c in CONNECTIONS.items():\n-                if c[\"status\"] != \"connected\" or c[\"expires_at\"] - now > 300:\n-                    continue\n-                if not c[\"refresh_token\"]:\n-                    log(f\"{uid}: token expiry passed and no refresh token on file -> expired, reconnect\")\n-                    c.update(status=\"expired, reconnect\", access_token=None)\n-                    continue\n-                try:\n-                    tok = post_form(TOKEN_URL, {\n-                        \"grant_type\": \"refresh_token\", \"refresh_token\": c[\"refresh_token\"],\n-                        \"client_id\": config.CLIENT_ID, \"client_secret\": config.CLIENT_SECRET,\n-                    })\n-                    c.update(access_token=tok[\"access_token\"],\n-                             refresh_token=tok.get(\"refresh_token\", c[\"refresh_token\"]),\n-                             expires_at=now + int(tok[\"expires_in\"]))\n-                    log(f\"{uid}: token refreshed\")\n-                except Exception as e:\n-                    log(f\"{uid}: refresh failed ({e}) -> expired, reconnect\")\n-                    c.update(status=\"expired, reconnect\", access_token=None)\n+    log(f\"{user_id}: connected as athlete {athlete_id}\")\n \n \n def intervals_get(conn, path):\n@@ -164,8 +148,6 @@ class Handler(BaseHTTPRequestHandler):\n         if url.path == \"/api/me\":\n             user = self.require_user()\n             return user and self.send_json(200, user)\n-        if url.path == \"/api/intervals/auth/init\":\n-            return self.auth_init()\n         if url.path == \"/api/intervals/callback\":\n             return self.callback(q)\n         if url.path == \"/api/intervals/status\":\n@@ -176,6 +158,8 @@ class Handler(BaseHTTPRequestHandler):\n \n     def do_POST(self):\n         url = urllib.parse.urlsplit(self.path)\n+        if url.path == \"/api/intervals/auth/init\":\n+            return self.auth_init()\n         if url.path == \"/api/intervals/disconnect\":\n             user = self.require_user()\n             if user:\n@@ -185,14 +169,14 @@ class Handler(BaseHTTPRequestHandler):\n             return\n         self.send_json(404, {\"error\": \"not found\"})\n \n-    # Step 1: build the authorize URL and send the browser to Intervals.\n+    # Step 1: authenticated fetch builds the URL; browser navigation follows.\n     def auth_init(self):\n         user = self.require_user()\n         if not user:\n             return\n         params = {\"client_id\": config.CLIENT_ID, \"redirect_uri\": config.REDIRECT_URI,\n                   \"scope\": config.SCOPES, \"state\": sign_state(user[\"id\"])}\n-        self.redirect(AUTHORIZE_URL + \"?\" + urllib.parse.urlencode(params, safe=\":,\"))\n+        self.send_json(200, {\"authorize_url\": AUTHORIZE_URL + \"?\" + urllib.parse.urlencode(params, safe=\":,\")})\n \n     # Step 2: Intervals redirects back here with ?code=&state=.\n     def callback(self, q):\n@@ -202,6 +186,8 @@ class Handler(BaseHTTPRequestHandler):\n         try:\n             tok = exchange_code(q[\"code\"])\n             store_connection(user_id, tok)\n+        except ValueError as e:\n+            return self.send_json(409, {\"error\": str(e)})\n         except urllib.error.HTTPError as e:\n             log(f\"{user_id}: token exchange failed: HTTP {e.code} {e.read()[:200]!r}\")\n             return self.send_json(502, {\"error\": \"token exchange failed\"})\n@@ -216,6 +202,7 @@ class Handler(BaseHTTPRequestHandler):\n             return\n         with LOCK:\n             c = CONNECTIONS.get(user[\"id\"])\n+            c = c.copy() if c else None\n         if not c or c[\"status\"] != \"connected\":\n             return self.send_json(200, {\"connected\": False, \"status\": c[\"status\"] if c else \"disconnected\"})\n         self.send_json(200, {\"connected\": True, \"status\": \"connected\", \"scope\": c[\"scope\"],\n@@ -227,18 +214,24 @@ class Handler(BaseHTTPRequestHandler):\n             return\n         with LOCK:\n             c = CONNECTIONS.get(user[\"id\"])\n+            c = c.copy() if c else None\n         if not c or c[\"status\"] != \"connected\":\n             return self.send_json(409, {\"error\": \"intervals not connected\"})\n         try:\n             code, data = intervals_get(c, \"/wellness\")\n             self.send_json(code, data)\n         except urllib.error.HTTPError as e:\n+            if e.code == 401:\n+                with LOCK:\n+                    stored = CONNECTIONS.get(user[\"id\"])\n+                    if stored and stored[\"access_token\"] == c[\"access_token\"]:\n+                        stored.update(status=\"revoked, reconnect\", access_token=None)\n+                return self.send_json(409, {\"error\": \"Intervals authorization expired or was revoked; reconnect\"})\n             self.send_json(e.code, {\"error\": f\"intervals returned {e.code}\"})\n         except Exception as e:\n             self.send_json(502, {\"error\": str(e)})\n \n \n if __name__ == \"__main__\":\n-    threading.Thread(target=refresh_tokens, daemon=True).start()\n     log(f\"serving on http://localhost:{config.PORT} (intervals: {config.INTERVALS_BASE})\")\n     ThreadingHTTPServer((\"127.0.0.1\", config.PORT), Handler).serve_forever()\ndiff --git a/static/app.js b/static/app.js\nindex 368922e..30bb1b2 100644\n--- a/static/app.js\n+++ b/static/app.js\n@@ -25,12 +25,23 @@ async function render() {\n     } else {\n       const why = st.status && st.status !== \"disconnected\" ? `<p class=\"muted\">Status: ${esc(st.status)}</p>` : \"\";\n       card = `<div class=\"card\">Intervals.icu is not connected.${why}\n-        <p><a class=\"btn\" href=\"/api/intervals/auth/init\">Connect Intervals.icu</a></p></div>`;\n+        <p><button class=\"btn\" id=\"connect\">Connect Intervals.icu</button></p></div>`;\n     }\n     root.className = \"\";\n     root.innerHTML = `<p>Signed in as <b>${esc(me.name)}</b>.</p>${card}`;\n     const d = document.getElementById(\"disconnect\");\n     if (d) d.onclick = async () => { await api(\"/api/intervals/disconnect\", { method: \"POST\" }); render(); };\n+    const c = document.getElementById(\"connect\");\n+    if (c) c.onclick = async () => {\n+      c.disabled = true;\n+      try {\n+        const { authorize_url } = await api(\"/api/intervals/auth/init\", { method: \"POST\" });\n+        window.location.assign(authorize_url);\n+      } catch (e) {\n+        c.disabled = false;\n+        root.insertAdjacentHTML(\"beforeend\", `<p class=\"card\">Error: ${esc(e.message)}</p>`);\n+      }\n+    };\n   } catch (e) {\n     root.innerHTML = `<p class=\"card\">Error: ${esc(e.message)}</p>`;\n   }\ndiff --git a/ANSWER.md b/ANSWER.md\nnew file mode 100644\nindex 0000000..4ce915f\n--- /dev/null\n+++ b/ANSWER.md\n@@ -0,0 +1,21 @@\n+# Intervals.icu connection failure\n+\n+## Causes found\n+\n+1. The SPA used a normal link to `GET /api/intervals/auth/init`. A page navigation does not carry the `Authorization` header from the SPA's fetch wrapper, so the endpoint returned 401 for every athlete. The request and missing header are recorded in `logs/connect-attempt.log`.\n+2. The authorize URL requested both `ACTIVITY:READ` and `ACTIVITY:WRITE`, and both `CALENDAR:READ` and `CALENDAR:WRITE`. The captured authorize request returned 400 before consent. Intervals' rule that `:WRITE` includes `:READ` makes these duplicate areas the likely cause; the generic `invalid_request` body alone does not prove which parameter failed.\n+3. The successful September token response had neither `expires_in` nor `refresh_token`. Our code invented a 3,600-second expiry, then its background worker cleared the token and demanded reconnection. The log shows this happening to Rivera even though the token had worked for wellness and the athlete had not revoked access.\n+\n+## Fix\n+\n+- The button now calls authenticated `POST /api/intervals/auth/init` through the SPA fetch wrapper, receives `{authorize_url}`, and navigates to it. The scopes now name each area once: `ACTIVITY:WRITE,WELLNESS:READ,CALENDAR:WRITE`.\n+- The callback validates a signed, 15-minute state containing the tricoach user and OAuth purpose, then exchanges the code with `client_id`, `client_secret`, and `code`. It stores the returned athlete ID and token without a fabricated expiry. Reconnecting to a different Intervals athlete requires an explicit disconnect first.\n+- The wellness proxy keeps using the Bearer token. On an Intervals 401, it clears that token and marks the connection for reconnection. OAuth settings can now come from environment variables (`INTERVALS_CLIENT_ID`, `INTERVALS_CLIENT_SECRET`, `INTERVALS_REDIRECT_URI`, `APP_SECRET`).\n+\n+## Colleague's note\n+\n+The POST init pattern, unique scope areas, minimal token exchange, absence of token refresh, signed callback state, athlete ID from the token response, Bearer API calls, 401 revocation handling, and reconnect identity guard all applied. The note proposes a JWT for state; this implementation uses an HMAC-signed state with the same subject, purpose, and expiry checks, without a JWT dependency. Its encryption-at-rest advice applies to persistent production storage; this repository stores connections only in memory, so there is no token file or database here to encrypt. Its example scope list includes `SETTINGS:WRITE`, which this app does not use.\n+\n+## Verification\n+\n+`python3 -m unittest -v test_integration.py` passes. The local test covers authenticated initiation, scope and token exchange parameters, callback, wellness, 401 revocation, status, and athlete mismatch. A real Intervals account and production client credentials were unavailable here, so live consent and API behavior were not verified.\n","exit_code":1,"status":"failed"}}
