use RPE instead of heart rate for the first week.\n- Races: for 5-10 km two quality sessions in the last 10 days; for half marathon and longer, one quality session\n  and a long run 10-14 days out. Race-day fuelling should be rehearsed in training, nothing new on the day.\n- Strength work: two short sessions per week (20-30 min) are welcome in base phases; drop to one in a taper.\n\"\"\"''')\ns=s.replace('''    # One block, cached as a whole: instructions + per-athlete context.\n    text = INSTRUCTIONS + \"\\\\n\\\\n\" + athlete_context(a, today)\n    return [{\"type\": \"text\", \"text\": text, \"cache_control\": {\"type\": \"ephemeral\"}}]''','''    # Two cached segments. INSTRUCTIONS must stay byte-stable (no per-user or per-day values) so a\n    # save_fact, which rewrites the tail, only invalidates the tail. The static prefix (tools +\n    # INSTRUCTIONS) must also exceed the model's minimum cacheable length (1024 tokens for Sonnet 4.5),\n    # or its marker is silently ignored and the whole prompt is re-created on every memory write.\n    return [\n        {\"type\": \"text\", \"text\": INSTRUCTIONS, \"cache_control\": {\"type\": \"ephemeral\"}},\n        {\"type\": \"text\", \"text\": athlete_context(a, today), \"cache_control\": {\"type\": \"ephemeral\"}},\n    ]''')\nopen('bot.py','w').write(s)\nE\nPYTHONPATH=. python3 -c \"\nimport bot,json;print(len(bot.INSTRUCTIONS),len(json.dumps(bot.CORE_TOOLS)))\""},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":179,"cache_read_input_tokens":28148,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":179},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9c64f5d7-9814-4795-a49a-32bf04a5ad83","uuid":"8c2a1506-6229-404d-bbb5-6d15a52257d