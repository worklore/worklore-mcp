 log = logging.getLogger("stories")
 
@@ -40,6 +41,28 @@ def related(story, existing):
     return scored[:TOP_N]
 
 
+def to_dynamo(value):
+    """Convert a value into types boto3's DynamoDB serializer accepts.
+
+    boto3 rejects ``float`` anywhere in an item ("Float types are not
+    supported"), so every float is turned into a ``Decimal`` via ``str`` (to
+    keep the short decimal form, not the binary expansion). Applied to the
+    whole item right before ``put_item``, so any float field added later is
+    covered too.
+    """
+    if isinstance(value, bool):
+        return value
+    if isinstance(value, float):
+        if value != value or value in (float("inf"), float("-inf")):
+            raise ValueError("non-finite number cannot be stored")
+        return Decimal(str(value))
+    if isinstance(value, dict):
+        return {k: to_dynamo(v) for k, v in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [to_dynamo(v) for v in value]
+    return value
+
+
 def validate(story):
