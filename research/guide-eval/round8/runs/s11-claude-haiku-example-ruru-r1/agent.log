{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0111yQ6j1WF6dHymQfSGytJ9","type":"tool_result","content":"1\timport json\n2\tfrom decimal import Decimal\n3\timport os\n4\timport sys\n5\timport unittest\n6\t\n7\tsys.path.insert(0, os.path.join(os.path.dirname(__file__), \"..\", \"src\"))\n8\tsys.path.insert(0, os.path.dirname(__file__))\n9\t\n10\timport app  # noqa: E402\n11\tfrom fake_dynamo import FakeTable  # noqa: E402\n12\t\n13\t\n14\tclass PublishTest(unittest.TestCase):\n15\t    def test_publish_stores_story(self):\n16\t        table = FakeTable()\n17\t        story = {\n18\t            \"slug\": \"why-my-cron-ran-twice\",\n19\t            \"title\": \"Why my cron ran twice\",\n20\t            \"tags\": [\"cron\", \"linux\"],\n21\t            \"body\": \"Two crontabs, one for root and one for me, both had the line.\",\n22\t        }\n23\t        stored = app.publish(table, story)\n24\t        self.assertEqual(stored[\"slug\"], \"why-my-cron-ran-twice\")\n25\t        self.assertEqual(table.get_item(Key={\"slug\": \"why-my-cron-ran-twice\"})[\"Item\"][\"title\"], \"Why my cron ran twice\")\n26\t        self.assertEqual(table.scan()[\"Count\"], 1)\n27\t\n28\t    def test_second_publish_with_similar_story_stores(self):\n29\t        # The first publish runs against an empty table and never computes a\n30\t        # similarity score. The second one does, so this is the path that\n31\t        # used to fail with \"Float types are not supported\".\n32\t        table = FakeTable()\n33\t        first = {\n34\t            \"slug\": \"why-my-cron-ran-twice\",\n35\t            \"title\": \"Why my cron ran twice\",\n36\t            \"tags\": [\"cron\", \"linux\"],\n37\t            \"body\": \"Two crontabs, one for root and one for me, both had the line.\",\n38\t        }\n39\t        second = {\n40\t            \"slug\": \"cron-and-systemd-timers\",\n41\t            \"title\": \"Cron and systemd timers\",\n42\t            \"tags\": [\"cron\", \"systemd\"],\n43\t            \"body\": \"Two schedulers ran the same job, cron and a systemd timer.\",\n44\t        }\n45\t        app.publish(table, first)\n46\t        stored = app.publish(table, second)\n47\t        self.assertEqual(stored[\"similar\"][0][\"slug\"], \"why-my-cron-ran-twice\")\n48\t        self.assertEqual(table.scan()[\"Count\"], 2)\n49\t\n50\t    def test_handler_returns_201_on_second_publish(self):\n51\t        # Production symptom: the second POST returned 500. Check the handler\n52\t        # result, not just publish(), because the handler turns errors into 500.\n53\t        table = FakeTable()\n54\t        first = json.dumps({\"slug\": \"first-story\", \"title\": \"First\", \"tags\": [\"a\"], \"body\": \"alpha beta\"})\n55\t        second = json.dumps({\"slug\": \"second-story\", \"title\": \"Second\", \"tags\": [\"a\"], \"body\": \"alpha gamma\"})\n56\t        self.assertEqual(app.handler({\"body\": first}, table)[\"statusCode\"], 201)\n57\t        self.assertEqual(app.handler({\"body\": second}, table)[\"statusCode\"], 201)\n58\t\n59\t    def test_stored_score_is_decimal_with_same_value(self):\n60\t        table = FakeTable()\n61\t        app.publish(table, {\"slug\": \"first-story\", \"title\": \"First\", \"tags\": [\"a\"], \"body\": \"alpha beta\"})\n62\t        app.publish(table, {\"slug\": \"second-story\", \"title\": \"Second\", \"tags\": [\"a\"], \"body\": \"alpha gamma\"})\n63\t        score = table.get_item(Key={\"slug\": \"second-story\"})[\"Item\"][\"similar\"][0][\"score\"]\n64\t        self.assertIsInstance(score, Decimal)\n65\t        self.assertEqual(score, Decimal(str(app.similarity(\n66\t            {\"tags\": [\"a\"], \"body\": \"alpha gamma\"}, {\"tags\": [\"a\"], \"body\": \"alpha beta\"}))))\n67\t\n68\t\n69\tclass ToDynamoTest(unittest.TestCase):\n70\t    def test_converts_nested_floats_only(self):\n71\t        item = {\"n\": 0.5, \"s\": \"x\", \"i\": 3, \"b\": True, \"none\": None,\n72\t                \"list\": [{\"score\": 0.1}, 2.0], \"tup\": (1.5,)}\n73\t        out = app.to_dynamo(item)\n74\t        self.assertEqual(out[\"n\"], Decimal(\"0.5\"))\n75\t        self.assertEqual(out[\"list\"][0][\"score\"], Decimal(\"0.1\"))\n76\t        self.assertEqual(out[\"list\"][1], Decimal(\"2.0\"))\n77\t        self.assertEqual(out[\"tup\"], [Decimal(\"1.5\")])\n78\t        self.assertEqual(out[\"s\"], \"x\")\n79\t        self.assertEqual(out[\"i\"], 3)\n80\t        self.assertIs(out[\"b\"], True)\n81\t        self.assertIsNone(out[\"none\"])\n82\t        FakeTable().put_item(Item=out)  # would raise on any float left behind\n83\t\n84\t\n85\tif __name__ == \"__main__\":\n86\t    unittest.main()\n87\t"}]},"parent_tool_use_id":null,"session_id":"9a0bf635-a674-4b32-8de4-a4b48d83cb72","uuid":"69dc8144-c9c5-426b-a09d-2e4196d0582b","timestamp":"2026-10-27T02:45:21.316Z","tool_use_result":{"type":"text","file":{"filePath":"/private/tmp/h-FNzmON/tests/test_publish.py","content":"import json\nfrom decimal import Decimal\nimport os\nimport sys\nimport unittest\n\nsys.path.insert(0, os.path.join(os.path.dirname(__file__), \"..\", \"src\"))\nsys.path.insert(0, os.path.dirname(__file__))\n\nimport app  # noqa: E402\nfrom fake_dynamo import FakeTable  # noqa: E402\n\n\nclass PublishTest(unittest.TestCase):\n    def test_publish_stores_story(self):\n        table = FakeTable()\n        story = {\n            \"slug\": \"why-my-cron-ran-twice\",\n            \"title\": \"Why my cron ran twice\",\n            \"tags\": [\"cron\", \"linux\"],\n            \"body\": \"Two crontabs, one for root and one for me, both had the line.\",\n        }\n        stored = app.publish(table, story)\n        self.assertEqual(stored[\"slug\"], \"why-my-cron-ran-twice\")\n        self.assertEqual(table.get_item(Key={\"slug\": \"why-my-cron-ran-twice\"})[\"Item\"][\"title\"], \"Why my cron ran twice\")\n        self.assertEqual(table.scan()[\"Count\"], 1)\n\n    def test_second_publish_with_similar_story_stores(self):\n        # The first publish runs against an empty table and never computes a\n        # similarity score. The second one does, so this is the path that\n        # used to fail with \"Float types are not supported\".\n        table = FakeTable()\n        first = {\n            \"slug\": \"why-my-cron-ran-twice\",\n            \"title\": \"Why my cron ran twice\",\n            \"tags\": [\"cron\", \"linux\"],\n            \"body\": \"Two crontabs, one for root and one for me, both had the line.\",\n        }\n        second = {\n            \"slug\": \"cron-and-systemd-timers\",\n            \"title\": \"Cron and systemd timers\",\n            \"tags\": [\"cron\", \"systemd\"],\n            \"body\": \"Two schedulers ran the same job, cron and a systemd timer.\",\n        }\n        app.publish(table, first)\n        stored = app.publish(table, second)\n        self.assertEqual(stored[\"similar\"][0][\"slug\"], \"why-my-cron-ran-twice\")\n        self.assertEqual(table.scan()[\"Count\"], 2)\n\n    def test_handler_returns_201_on_second_publish(self):\n        # Production symptom: the second POST returned 500. Check the handler\n        # result, not just publish(), because the handler turns errors into 500.\n        table = FakeTable()\n        first = json.dumps({\"slug\": \"first-story\", \"title\": \"First\", \"tags\": [\"a\"], \"body\": \"alpha beta\"})\n        second = json.dumps({\"slug\": \"second-story\", \"title\": \"Second\", \"tags\": [\"a\"], \"body\": \"alpha gamma\"})\n        self.assertEqual(app.handler({\"body\": first}, table)[\"statusCode\"], 201)\n        self.assertEqual(app.handler({\"body\": second}, table)[\"statusCode\"], 201)\n\n    def test_stored_score_is_decimal_with_same_value(self):\n        table = FakeTable()\n        app.publish(table, {\"slug\": \"first-story\", \"title\": \"First\", \"tags\": [\"a\"], \"body\": \"alpha beta\"})\n        app.publish(table, {\"slug\": \"second-story\", \"title\": \"Second\", \"tags\": [\"a\"], \"body\": \"alpha gamma\"})\n        score = table.get_item(Key={\"slug\": \"second-story\"})[\"Item\"][\"similar\"][0][\"score\"]\n        self.assertIsInstance(score, Decimal)\n        self.assertEqual(score, Decimal(str(app.similarity(\n            {\"tags\": [\"a\"], \"body\": \"alpha gamma\"}, {\"tags\": [\"a\"], \"body\": \"alpha beta\"}))))\n\n\nclass ToDynamoTest(unittest.TestCase):\n    def test_converts_nested_floats_only(self):\n        item = {\"n\": 0.5, \"s\": \"x\", \"i\": 3, \"b\": True, \"none\": None,\n                \"list\": [{\"score\": 0.1}, 2.0], \"tup\": (1.5,)}\n        out = app.to_dynamo(item)\n        self.assertEqual(out[\"n\"], Decimal(\"0.5\"))\n        self.assertEqual(out[\"list\"][0][\"score\"], Decimal(\"0.1\"))\n        self.assertEqual(out[\"list\"][1], Decimal(\"2.0\"))\n        self.assertEqual(out[\"tup\"], [Decimal(\"1.5\")])\n        self.assertEqual(out[\"s\"], \"x\")\n        self.assertEqual(out[\"i\"], 3)\n        self.assertIs(out[\"b\"], True)\n        self.assertIsNone(out[\"none\"])\n        FakeTable().put_item(Item=out)  # would raise on any float left behind\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n","numLines":87,"startLine":1,"totalLines":87}},"tool_result_meta":[{"id":"toolu_0111yQ6j1WF6dHymQfSGytJ9","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
