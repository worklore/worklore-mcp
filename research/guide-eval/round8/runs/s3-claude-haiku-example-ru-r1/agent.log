! -s \"$OUT\" ]; then\n  notify \"nightly review FAILED (exit $rc), see $OUT and nightly-review.err\"\n  exit $(( rc ? rc : 1 ))\nfi\n\nnotify \"nightly review done: $(head -c 300 \"$OUT\")\"\n","structuredPatch":[{"oldStart":29,"oldLines":7,"newStart":29,"newLines":7,"lines":[" "," # Exit 0 with empty output is also a failure (the run did no work)."," if [ $rc -ne 0 ] || [ ! -s \"$OUT\" ]; then","-  notify \"nightly review FAILED (exit $rc), see $OUT and nightly-review.err\"","+  notify \"nightly review FAILED (exit $rc, output $([ -s \"$OUT\" ] && echo ok || echo empty)), see $OUT and nightly-review.err\"","   exit $(( rc ? rc : 1 ))"," fi"," "]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_01R1Z1YJTctzfrydcu7ePqPY","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
