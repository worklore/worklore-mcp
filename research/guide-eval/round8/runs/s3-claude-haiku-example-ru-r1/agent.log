ify.sh\"\n\nSINCE=$(date -v-1d +%F)\nPROMPT=\"Review the commits in this repository since $SINCE.\nFor each commit: one line on what it changes and whether anything looks risky\n(migrations, auth, payments, deleted tests).\nEnd with a three-line summary I can read on my phone.\nDo not modify any file.\"\n\ncd \"$REPO\" || { \"$NOTIFY\" \"nightly review: repo missing\"; exit 1; }\n\nclaude -p \"$PROMPT\" --output-format text > \"$OUT\"\nstatus=$?\n\nif [ $status -ne 0 ]; then\n  \"$NOTIFY\" \"nightly review FAILED (exit $status), see $OUT\"\n  exit $status\nfi\n\n\"$NOTIFY\" \"nightly review done: $(head -c 300 \"$OUT\")\"\n","structuredPatch":[{"oldStart":13,"oldLines":14,"newStart":13,"newLines":24,"lines":[" End with a three-line summary I can read on my phone."," Do not modify any file.\""," ","-cd \"$REPO\" || { \"$NOTIFY\" \"nightly review: repo missing\"; exit 1; }","+# Never fail silently: if the notifier itself fails, say so in the .err log.","+notify() {","+  \"$NOTIFY\" \"$1\" || print -u2 -r -- \"$(date '+%F %T') notify.sh failed, message not sent: $1\"","+}"," ","-claude -p \"$PROMPT\" --output-format text > \"$OUT\"","-status=$?","+cd \"$REPO\" || { notify \"nightly review: repo missing\"; exit 1; }"," ","-if [ $status -ne 0 ]; then","-  \"$NOTIFY\" \"nightly review FAILED (exit $status), see $OUT\"","-  exit $status","+# `rc`, not `status`: zsh made `status` read-only and the assignment killed the script.","+# </dev/null: a headless CLI given the prompt as an argument must not wait on stdin.","+started=$(date +%s)","+claude -p \"$PROMPT\" --output-format text < /dev/null > \"$OUT\"","+rc=$?","+print -r -- \"$(date '+%F %T') claude exit=$rc duration=$(( $(date +%s) - started ))s out=$OUT\" >&2","+","+# Exit 0 with empty output is also a failure (the run did no work).","+if [ $rc -ne 0 ] || [ ! -s \"$OUT\" ]; then","+  notify \"nightly review FAILED (exit $rc), see $OUT and nightly-review.err\"","+  exit $(( rc ? rc : 1 ))"," fi"," ","-\"$NOTIFY\" \"nigh