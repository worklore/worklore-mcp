{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nfrom pathlib import Path\nfrom tempfile import TemporaryDirectory\nimport os, shutil, subprocess\nwith TemporaryDirectory(dir='.') as tmp:\n    root = Path(tmp)\n    home = root / 'home'\n    (home / 'bin').mkdir(parents=True)\n    (home / 'projects/shop').mkdir(parents=True)\n    (home / 'Library/Logs').mkdir(parents=True)\n    mockbin = root / 'mockbin'\n    mockbin.mkdir()\n    shutil.copy('bin/nightly-review.zsh', home / 'bin/nightly-review.zsh')\n    notifier = home / 'bin/notify.sh'\n    notifier.write_text('#\"'!/bin/sh'\"\\\\nprintf \\\"%s\\\\\\\\n\\\" \\\"\"'$1\" >> \"$HOME/notifications\"'\"\\\\n')\n    agent = mockbin / 'claude'\n    agent.write_text('#\"'!/bin/sh'\"\\\\ncat > \\\"\"'$HOME/prompt\"'\"\\\\ncase \\\"\"'$CASE\" in'\"\\\\n success) printf \\\"summary\\\\\\\\n\\\"; exit 0;;\\\\n error) exit 7;;\\\\n empty) exit 0;;\\\\nesac\\\\n')\n    notifier.chmod(0o755)\n    agent.chmod(0o755)\n    for case in ('success', 'error', 'empty'):\n        env = os.environ.copy()\n        env.update(HOME=str(home.resolve()), PATH=str(mockbin.resolve()) + ':' + env['PATH'], CASE=case)\n        result = subprocess.run(['/bin/zsh', str(home / 'bin/nightly-review.zsh')], env=env, capture_output=True, text=True)\n        message = (home / 'notifications').read_text().splitlines()[-1]\n        print(f'{case}: rc={result.returncode}, notification={message}')\n        assert ('Review the commits' in (home / 'prompt').read_text())\n        assert (result.returncode == 0) == (case == 'success')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
