tory)\n31\t  File \"/var/task/src/app.py\", line 63, in publish\n32\t    table.put_item(Item=item)\n33\t  File \"/var/task/boto3/dynamodb/types.py\", line 164, in _get_dynamodb_type\n34\t    raise TypeError(msg)\n35\tTypeError: Float types are not supported. Use Decimal types instead.\n36\t2026-07-31T09:22:10.889Z INFO  POST /stories -> 500 (58 ms)"}
{"role":"tool","tool_call_id":"tool_cBdNvnBUkjKN7OKlYso2RJsP","content":"1\t\"\"\"Story library: the publish handler.\n2\t\n3\tEach story is stored in one DynamoDB item together with the three most similar\n4\tstories already in the library (``similar``), so the reader page can show\n5\t\"related\" without a query at read time.\n6\t\"\"\"\n7\timport json\n8\timport logging\n9\timport re\n10\timport time\n11\t\n12\tlog = logging.getLogger(\"stories\")\n13\t\n14\tTABLE_NAME = \"stories\"\n15\tTOP_N = 3\n16\t\n17\t_WORD = re.compile(r\"[a-z0-9]+\")\n18\t\n19\t\n20\tdef words(text):\n21\t    return set(_WORD.findall((text or \"\").lower()))\n22\t\n23\t\n24\tdef similarity(a, b):\n25\t    \"\"\"Shared-tag ratio (Jaccard), blended with shared words of the two bodies.\"\"\"\n26\t    ta, tb = set(a.get(\"tags\", [])), set(b.get(\"tags\", []))\n27\t    tag_score = len(ta & tb) / len(ta | tb) if (ta | tb) else 0\n28\t    wa, wb = words(a.get(\"body\")), words(b.get(\"body\"))\n29\t    word_score = len(wa & wb) / len(wa | wb) if (wa | wb) else 0\n30\t    return round(0.7 * tag_score + 0.3 * word_score, 4)\n31\t\n32\t\n33\tdef related(story, existing):\n34\t    scored = []\n35\t    for other in existing:\n36\t        if other[\"slug\"] == story[\"slug\"]:\n37\t            continue\n38\t        scored.append({\"slug\": other[\"slug\"], \"score\": similarity(story, other)})\n39\t    scored.sort(key=lambda s: s[\"score\"], reverse=True)\n40\t    return scored[:TOP_N]\n41\t\n42\t\n43\tdef validate(story):\n44\t    for k in (\"slug\", \"title\", \"body\"):\n45\t        if not story.get(k):\n46\t            raise ValueError(f\"missing field: {k}\")\n47\t    if not re.fullmatch(r\"[a-z0-9-]{3,80}\", story[\"slug\"]):\n48\t        raise ValueError(\"bad slug\")\n49\t\n50\t\n51\tdef publish(table, story):\n52\t    \"\"\"Store ``story`` with its related stories. Returns the stored item.\"\"\"\n53\t    validate(story)\n54\t    existing = table.scan(TableName=TABLE_NAME).get(\"Items\", [])\n55\t    item = {\n56\t        \"slug\": story[\"slug\"],\n57\t        \"title\": story[\"title\"],\n58\t        \"tags\": sorted(set(story.get(\"tags\", []))),\n59\t        \"body\": story[\"body\"],\n60\t        \"published_at\": int(time.time()),\n61\t        \"similar\": related(story, existing),\n62\t    }\n63\t    table.put_item(Item=item)\n64\t    log.info(\"publish slug=%s similar=%d stored\", item[\"slug\"], len(item[\"similar\"]))\n65\t    return item\n66\t\n67\t\n68\tdef handler(event, table):\n69\t    \"\"\"Lambda-style entry point for POST /stories. Body is the story as JSON.\"\"\"\n70\t    try:\n71\t        story = json.loads(event.get(\"body\") or \"{}\")\n72\t        stored = publish(table, story)\n73\t        return {\"statusCode\": 201, \"body\": json.dumps({\"slug\": stored[\"slug\"]})}\n74\t    except ValueError as e:\n75\t        return {\"statusCode\": 400, \"body\": json.dumps({\"error\": str(e)})}\n76\t    except Exception:\n77\t        log.exception(\"publish failed\")\n78\t        return {\"statusCode\": 500, \"body\": json.dumps({\"error\": \"Internal Server Error\"})}"}
