{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018wGhzbgn5EcwxGssuG2YR2","type":"tool_result","content":"     1\t\"\"\"Story library: the publish handler.\n     2\t\n     3\tEach story is stored in one DynamoDB item together with the three most similar\n     4\tstories already in the library (``similar``), so the reader page can show\n     5\t\"related\" without a query at read time.\n     6\t\"\"\"\n     7\timport json\n     8\timport logging\n     9\timport re\n    10\timport time\n    11\t\n    12\tlog = logging.getLogger(\"stories\")\n    13\t\n    14\tTABLE_NAME = \"stories\"\n    15\tTOP_N = 3\n    16\t\n    17\t_WORD = re.compile(r\"[a-z0-9]+\")\n    18\t\n    19\t\n    20\tdef words(text):\n    21\t    return set(_WORD.findall((text or \"\").lower()))\n    22\t\n    23\t\n    24\tdef similarity(a, b):\n    25\t    \"\"\"Shared-tag ratio (Jaccard), blended with shared words of the two bodies.\"\"\"\n    26\t    ta, tb = set(a.get(\"tags\", [])), set(b.get(\"tags\", []))\n    27\t    tag_score = len(ta & tb) / len(ta | tb) if (ta | tb) else 0\n    28\t    wa, wb = words(a.get(\"body\")), words(b.get(\"body\"))\n    29\t    word_score = len(wa & wb) / len(wa | wb) if (wa | wb) else 0\n    30\t    return round(0.7 * tag_score + 0.3 * word_score, 4)\n    31\t\n    32\t\n    33\tdef related(story, existing):\n    34\t    scored = []\n    35\t    for other in existing:\n    36\t        if other[\"slug\"] == story[\"slug\"]:\n    37\t            continue\n    38\t        scored.append({\"slug\": other[\"slug\"], \"score\": similarity(story, other)})\n    39\t    scored.sort(key=lambda s: s[\"score\"], reverse=True)\n    40\t    return scored[:TOP_N]\n    41\t\n    42\t\n    43\tdef validate(story):\n    44\t    for k in (\"slug\", \"title\", \"body\"):\n    45\t        if not story.get(k):\n    46\t            raise ValueError(f\"missing field: {k}\")\n    47\t    if not re.fullmatch(r\"[a-z0-9-]{3,80}\", story[\"slug\"]):\n    48\t        raise ValueError(\"bad slug\")\n    49\t\n    50\t\n    51\tdef publish(table, story):\n    52\t    \"\"\"Store ``story`` with its related stories. Returns the stored item.\"\"\"\n    53\t    validate(story)\n    54\t    existing = table.scan(TableName=TABLE_NAME).get(\"Items\", [])\n    55\t    item = {\n    56\t        \"slug\": story[\"slug\"],\n    57\t        \"title\": story[\"title\"],\n    58\t        \"tags\": sorted(set(story.get(\"tags\", []))),\n    59\t        \"body\": story[\"body\"],\n    60\t        \"published_at\": int(time.time()),\n    61\t        \"similar\": related(story, existing),\n    62\t    }\n    63\t    table.put_item(Item=item)\n    64\t    log.info(\"publish slug=%s similar=%d stored\", item[\"slug\"], len(item[\"similar\"]))\n    65\t    return item\n    66\t\n    67\t\n    68\tdef handler(event, table):\n    69\t    \"\"\"Lambda-style entry point for POST /stories. Body is the story as JSON.\"\"\"\n    70\t    try:\n    71\t        story = json.loads(event.get(\"body\") or \"{}\")\n    72\t        stored = publish(table, story)\n    73\t        return {\"statusCode\": 201, \"body\": json.dumps({\"slug\": stored[\"slug\"]})}\n    74\t    except ValueError as e:\n    75\t        return {\"statusCode\": 400, \"body\": json.dumps({\"error\": str(e)})}\n    76\t    except Exception:\n    77\t        log.exception(\"publish failed\")\n    78\t        return {\"statusCode\": 500, \"body\": json.dumps({\"error\": \"Internal Server Error\"})}\n\"\"\"In-memory stand-in for a boto3 DynamoDB Table resource.\n\nIt stores items in a dict and validates values the way boto3's TypeSerializer\ndoes, so a test fails on the same inputs a real table would reject.\n\"\"\"\nfrom decimal import Decimal\n\n\ndef _check(value, path=\"Item\"):\n    if isinstance(value, bool) or value is None or isinstance(value, (int, str, bytes, Decimal)):\n        return\n    if isinstance(value, float):\n        raise TypeError(\"Float types are not supported. Use Decimal types instead.\")\n    if isinstance(value, dict):\n        for k, v in value.items():\n            _check(v, f\"{path}.{k}\")\n        return\n    if isinstance(value, (list, tuple, set, frozenset)):\n        for i, v in enumerate(value):\n            _check(v, f\"{path}[{i}]\")\n        return\n    raise TypeError(f\"Unsupported type {type(value)!r} for value at {path}\")\n\n\nclass FakeTable:\n    def __init__(self, key=\"slug\"):\n        self.key = key\n        self.items = {}\n\n    def put_item(self, Item, **kwargs):\n        _check(Item)\n        if self.key not in Item:\n            raise ValueError(f\"item is missing the key attribute {self.key!r}\")\n        self.items[Item[self.key]] = dict(Item)\n        return {\"ResponseMetadata\": {\"HTTPStatusCode\": 200}}\n\n    def get_item(self, Key, **kwargs):\n        item = self.items.get(Key[self.key])\n        return {\"Item\": dict(item)} if item is not None else {}\n\n    def scan(self, **kwargs):\n        return {\"Items\": [dict(v) for v in self.items.values()], \"Count\": len(self.items)}\nimport os\nimport sys\nimport unittest\n\nsys.path.insert(0, os.path.join(os.path.dirname(__file__), \"..\", \"src\"))\nsys.path.insert(0, os.path.dirname(__file__))\n\nimport app  # noqa: E402\nfrom fake_dynamo import FakeTable  # noqa: E402\n\n\nclass PublishTest(unittest.TestCase):\n    def test_publish_stores_story(self):\n        table = FakeTable()\n        story = {\n            \"slug\": \"why-my-cron-ran-twice\",\n            \"title\": \"Why my cron ran twice\",\n            \"tags\": [\"cron\", \"linux\"],\n            \"body\": \"Two crontabs, one for root and one for me, both had the line.\",\n        }\n        stored = app.publish(table, story)\n        self.assertEqual(stored[\"slug\"], \"why-my-cron-ran-twice\")\n        self.assertEqual(table.get_item(Key={\"slug\": \"why-my-cron-ran-twice\"})[\"Item\"][\"title\"], \"Why my cron ran twice\")\n        self.assertEqual(table.scan()[\"Count\"], 1)\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n# stories-api\n\nA small story library behind `POST /stories` (Lambda + DynamoDB table `stories`,\npartition key `slug`). `src/app.py` is the whole service: `handler()` parses\nthe request and `publish()` stores the story together with its three most\nsimilar existing stories (`similar: [{slug, score}]`), so the reader page can\nshow \"related\" without any query at read time. `logs/error.log` is the\nproduction log from the first two publishes after the deploy.\n\nTests use an in-memory table (`tests/fake_dynamo.py`) that validates items the\nway boto3 does, so no AWS account is needed. Run them with\n`python3 -m unittest discover tests` from the repo root.\n__pycache__/\n*.pyc","is_error":false}]},"parent_tool_use_id":null,"session_id":"b15fba80-2d15-47b7-bc19-a58e287387b1","uuid":"f72727b7-e7f3-4125-8bf7-0060dbaa357b","timestamp":"2026-10-27T05:53:13.194Z","tool_use_result":{"stdout":"     1\t\"\"\"Story library: the publish handler.\n     2\t\n     3\tEach story is stored in one DynamoDB item together with the three most similar\n     4\tstories already in the library (``similar``), so the reader page can show\n     5\t\"related\" without a query at read time.\n     6\t\"\"\"\n     7\timport json\n     8\timport logging\n     9\timport re\n    10\timport time\n    11\t\n    12\tlog = logging.getLogger(\"stories\")\n    13\t\n    14\tTABLE_NAME = \"stories\"\n    15\tTOP_N = 3\n    16\t\n    17\t_WORD = re.compile(r\"[a-z0-9]+\")\n    18\t\n    19\t\n    20\tdef words(text):\n    21\t    return set(_WORD.findall((text or \"\").lower()))\n    22\t\n    23\t\n    24\tdef similarity(a, b):\n    25\t    \"\"\"Shared-tag ratio (Jaccard), blended with shared words of the two bodies.\"\"\"\n    26\t    ta, tb = set(a.get(\"tags\", [])), set(b.get(\"tags\", []))\n    27\t    tag_score = len(ta & tb) / len(ta | tb) if (ta | tb) else 0\n    28\t    wa, wb = words(a.get(\"body\")), words(b.get(\"body\"))\n    29\t    word_score = len(wa & wb) / len(wa | wb) if (wa | wb) else 0\n    30\t    return round(0.7 * tag_score + 0.3 * word_score, 4)\n    31\t\n    32\t\n    33\tdef related(story, existing):\n    34\t    scored = []\n    35\t    for other in existing:\n    36\t        if other[\"slug\"] == story[\"slug\"]:\n    37\t            continue\n    38\t        scored.append({\"slug\": other[\"slug\"], \"score\": similarity(story, other)})\n    39\t    scored.sort(key=lambda s: s[\"score\"], reverse=True)\n    40\t    return scored[:TOP_N]\n    41\t\n    42\t\n    43\tdef validate(story):\n    44\t    for k in (\"slug\", \"title\", \"body\"):\n    45\t        if not story.get(k):\n    46\t            raise ValueError(f\"missing field: {k}\")\n    47\t    if not re.fullmatch(r\"[a-z0-9-]{3,80}\", story[\"slug\"]):\n    48\t        raise ValueError(\"bad slug\")\n    49\t\n    50\t\n    51\tdef publish(table, story):\n    52\t    \"\"\"Store ``story`` with its related stories. Returns the stored item.\"\"\"\n    53\t    validate(story)\n    54\t    existing = table.scan(TableName=TABLE_NAME).get(\"Items\", [])\n    55\t    item = {\n    56\t        \"slug\": story[\"slug\"],\n    57\t        \"title\": story[\"title\"],\n    58\t        \"tags\": sorted(set(story.get(\"tags\", []))),\n    59\t        \"body\": story[\"body\"],\n    60\t        \"published_at\": int(time.time()),\n    61\t        \"similar\": related(story, existing),\n    62\t    }\n    63\t    table.put_item(Item=item)\n    64\t    log.info(\"publish slug=%s similar=%d stored\", item[\"slug\"], len(item[\"similar\"]))\n    65\t    return item\n    66\t\n    67\t\n    68\tdef handler(event, table):\n    69\t    \"\"\"Lambda-style entry point for POST /stories. Body is the story as JSON.\"\"\"\n    70\t    try:\n    71\t        story = json.loads(event.get(\"body\") or \"{}\")\n    72\t        stored = publish(table, story)\n    73\t        return {\"statusCode\": 201, \"body\": json.dumps({\"slug\": stored[\"slug\"]})}\n    74\t    except ValueError as e:\n    75\t        return {\"statusCode\": 400, \"body\": json.dumps({\"error\": str(e)})}\n    76\t    except Exception:\n    77\t        log.exception(\"publish failed\")\n    78\t        return {\"statusCode\": 500, \"body\": json.dumps({\"error\": \"Internal Server Error\"})}\n\"\"\"In-memory stand-in for a boto3 DynamoDB Table resource.\n\nIt stores items in a dict and validates values the way boto3's TypeSerializer\ndoes, so a test fails on the same inputs a real table would reject.\n\"\"\"\nfrom decimal import Decimal\n\n\ndef _check(value, path=\"Item\"):\n    if isinstance(value, bool) or value is None or isinstance(value, (int, str, bytes, Decimal)):\n        return\n    if isinstance(value, float):\n        raise TypeError(\"Float types are not supported. Use Decimal types instead.\")\n    if isinstance(value, dict):\n        for k, v in value.items():\n            _check(v, f\"{path}.{k}\")\n        return\n    if isinstance(value, (list, tuple, set, frozenset)):\n        for i, v in enumerate(value):\n            _check(v, f\"{path}[{i}]\")\n        return\n    raise TypeError(f\"Unsupported type {type(value)!r} for value at {path}\")\n\n\nclass FakeTable:\n    def __init__(self, key=\"slug\"):\n        self.key = key\n        self.items = {}\n\n    def put_item(self, Item, **kwargs):\n        _check(Item)\n        if self.key not in Item:\n            raise ValueError(f\"item is missing the key attribute {self.key!r}\")\n        self.items[Item[self.key]] = dict(Item)\n        return {\"ResponseMetadata\": {\"HTTPStatusCode\": 200}}\n\n    def get_item(self, Key, **kwargs):\n        item = self.items.get(Key[self.key])\n        return {\"Item\": dict(item)} if item is not None else {}\n\n    def scan(self, **kwargs):\n        return {\"Items\": [dict(v) for v in self.items.values()], \"Count\": len(self.items)}\nimport os\nimport sys\nimport unittest\n\nsys.path.insert(0, os.path.join(os.path.dirname(__file__), \"..\", \"src\"))\nsys.path.insert(0, os.path.dirname(__file__))\n\nimport app  # noqa: E402\nfrom fake_dynamo import FakeTable  # noqa: E402\n\n\nclass PublishTest(unittest.TestCase):\n    def test_publish_stores_story(self):\n        table = FakeTable()\n        story = {\n            \"slug\": \"why-my-cron-ran-twice\",\n            \"title\": \"Why my cron ran twice\",\n            \"tags\": [\"cron\", \"linux\"],\n            \"body\": \"Two crontabs, one for root and one for me, both had the line.\",\n        }\n        stored = app.publish(table, story)\n        self.assertEqual(stored[\"slug\"], \"why-my-cron-ran-twice\")\n        self.assertEqual(table.get_item(Key={\"slug\": \"why-my-cron-ran-twice\"})[\"Item\"][\"title\"], \"Why my cron ran twice\")\n        self.assertEqual(table.scan()[\"Count\"], 1)\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n# stories-api\n\nA small story library behind `POST /stories` (Lambda + DynamoDB table `stories`,\npartition key `slug`). `src/app.py` is the whole service: `handler()` parses\nthe request and `publish()` stores the story together with its three most\nsimilar existing stories (`similar: [{slug, score}]`), so the reader page can\nshow \"related\" without any query at read time. `logs/error.log` is the\nproduction log from the first two publishes after the deploy.\n\nTests use an in-memory table (`tests/fake_dynamo.py`) that validates items the\nway boto3 does, so no AWS account is needed. Run them with\n`python3 -m unittest discover tests` from the repo root.\n__pycache__/\n*.pyc","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_018wGhzbgn5EcwxGssuG2YR2","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
