+        resp = app.handler({"body": json.dumps(story)}, table)
+        self.assertEqual(resp["statusCode"], 400, resp)
+        self.assertEqual(table.scan()["Count"], 0)
+
+    def test_to_dynamo_converts_nested_floats(self):
