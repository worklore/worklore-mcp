b.error.HTTPError as e:\\n        return e.code, dict(e.headers), json.loads(e.read().decode() or \\\"{}\\\")\\n\\ndef callback(path):\\n    \\\"\\\"\\\"GET a callback URL without following the 302 home.\\\"\\\"\\\"\\n    r = urllib.request.Request(BASE + path, method=\\\"GET\\\")\\n    try:\\n        with NO_REDIRECT.open(r, timeout=10) as resp:\\n            return resp.status, dict(resp.headers)\\n    except urllib.error.HTTPError as e:\\n        return e.code, dict(e.headers)\\n\\nmock = ThreadingHTTPServer((\\\"127.0.0.1\\\", 8899), Mock)\\nthreading.Thread(target=mock.serve_forever, daemon=True).start()\\n\\nenv = dict(__import__(\\\"os\\\").environ, INTERVALS_BASE=\\\"http://127.0.0.1:8899\\\")\\nsrv = subprocess.Popen([sys.executable, \\\"server.py\\\"], env=env,\\n                       stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)\\ntime.sleep(1.0)\\ntry:\\n    # 1. Old GET init is gone; POST without token still 401s.\\n    check(\\\"GET /auth/init -> 404 (no longer a navigation target)\\\",\\n          req(\\\"GET\\\", \\\"/api/intervals/auth/init\\\", token=\\\"tok-okafor\\\")[0] == 404)\\n    check(\\\"POST /auth/init without token -> 401\\\",\\n          req(\\\"POST\\\", \\\"/api/intervals/auth/init\\\")[0] == 401)\\n\\n    # 2. POST init returns an authorize URL with sane scopes.\\n    code, _, body = req(\\\"POST\\\", \\\"/api/intervals/auth/init\\\", token=\\\"tok-okafor\\\")\\n    check(\\\"POST /auth/init -> 200 authorize_url\\\", code == 200 and \\\"authorize_url\\\" in body)\\n    au = urllib.parse.urlsplit(body.get(\\\"authorize_url\\\", \\\"\\\"))\\n    qp = dict(urllib.parse.parse_qsl(au.query))\\n    areas = [s.split(\\\":\\\")[0] for s in qp.get(\\\"scope\\\", \\\"\\\").split(\\\",\\\") if s]\\n    perms = {s.split(\\\":\\\")[0] for s in qp.get(\\\"scope\\\", \\\"\\\").split(\\\",\\\") if \\\":\\\" in s}\\n    both = {a for a in perms if f\\\"{a}:READ\\\" in qp.get(\\\"scope\\\",\\\"\\\") and f\\\"{a}:WRITE\\\" in qp.get(\\\"scope\\\",\\\"\\\")}\\n    check(\\\"authorize URL points at Intervals /oauth/authorize\\\",\\n          au.scheme == \\\"http\\\" and au.netloc == \\\"127.0.0.1:8899\\\" and au.path == \\\"/oauth/authorize\\\", body.get(\\\"authorize_url\\\",\\\"\\\"))\\n    check(\\\"scope has no duplicate area\\\", len(areas) == len(set(areas)) and not both, qp.get(\\\"scope\\\",\\\"\\\"))\\n    check(\\\"state present\\\", bool(qp.get(\\\"state\\\")))\\n    state_okafor = qp[\\\"state\\\"]\\n\\n    # 3. Callback: exchange code -> connected; redirect home.\\n    sc, hdrs = callback(f\\\"/api/intervals/callback?code=code-okafor&state={urllib.parse.quote(state_okafor)}\\\")\\n    check(\\\"callback -> 302 to /?connected=1\\\", sc == 302 and hdrs.get(\\\"Location\\\") == \\\"/?connected=1\\\", f\\\"code={sc}\\\")\\n    code, _, body = req(\\\"GET\\\", \\\"/api/intervals/status\\\", token=\\\"tok-okafor\\\")\\n    check(\\\"status: connected as i11111\\\", code == 200 and body.get(\\\"connected\\\") and body[\\\"athlete\\\"][\\\"id\\\"] == \\\"i11111\\\", str(body))\\n    code, _, body = req(\\\"GET\\\", \\\"/api/intervals/wellness\\\", token=\\\"tok-okafor\\\")\\n    check(\\\"wellness proxy 200\\\", code == 200 and body == [{\\\"id\\\": \\\"w1\\\", \\\"resting_hr\\\": 52}], f\\\"{code} {body}\\\")\\n\\n    # 4. Callback from a different Intervals account is rejected, old one kept.\\n    sc, _ = callback(f\\\"/api/intervals/callback?code=code-other&state={urllib.parse.quote(state_okafor)}\\\")\\n    check(\\\"mismatch callback -> 409\\\", sc == 409, f\\\"code={sc}\\\")\\n    _, _, body = req(\\\"GET\\\", \\\"/api/intervals/status\\\", token=\\\"tok-okafor\\\")\\n    check(\\\"still connected as i11111 after mismatch\\\", body.get(\\\"athlete\\\", {}).get(\\\"id\\\") == \\\"i11111\\\", str(body))\\n\\n    # 5. Bad / expired state rejected.\\n    bad = state_okafor[:-4] + \\\"AAAA\\\"\\n    check(\\\"tampered state -> 400\\\",\\n          req(\\\"GET\\\", f\\\"/api/intervals/callback?code=code-okafor&state={urllib.parse.quote(bad)}\\\")[0] == 400)\\n\\n    # 6. Rivera: revoked token degrades to disconnected on first 401.\\n    _, _, body = req(\\\"POST\\\", \\\"/api/intervals/auth/init\\\", token=\\\"tok-rivera\\\")\\n    state_rivera = urllib.parse.parse_qs(urllib.parse.urlsplit(body[\\\"authorize_url\\\"]).query)[\\\"state\\\"][0]\\n    sc, hdrs = callback(f\\\"/api/intervals/callback?code=code-revoked&state={urllib.parse.quote(state_rivera)}\\\")\\n    check(\\\"revoked-token callback still connects initially\\\", sc == 302, f\\\"code={sc}\\\")\\n    code, _, body = req(\\\"GET\\\", \\\"/api/intervals/wellness\\\", token=\\\"tok-rivera\\\")\\n    check(\\\"wellness on revoked token -> 409 not-connected\\\", code == 409 and \\\"error\\\" in body, f\\\"{code} {body}\\\")\\n    _, _, body = req(\\\"GET\\\", \\\"/api/intervals/status\\\", token=\\\"tok-rivera\\\")\\n    check(\\\"status after 401 -> disconnected (reconnect offered)\\\", body.get(\\\"connected\\\") is False, str(body))\\n    # and reconnecting works right away (state identity flows through)\\n    _, _, body = req(\\\"POST\\\", \\\"/api/intervals/auth/init\\\", token=\\\"tok-rivera\\\")\\n    state_rivera = urllib.parse.parse_qs(urllib.parse.urlsplit(body[\\\"authorize_url\\\"]).query)[\\\"state\\\"][0]\\n    sc, hdrs = callback(f\\\"/api/intervals/callback?code=code-okafor&state={urllib.parse.quote(state_rivera)}\\\")\\n    check(\\\"reconnect after revoke -> 302\\\", sc == 302 and hdrs.get(\\\"Location\\\") == \\\"/?connected=1\\\", f\\\"code={sc}\\\")\\n\\n    # 7. No silent one-hour expiry anymore: token had no expires_in, connection\\n    #    must still be connected well past the old 60s refresh cadence.\\n    time.sleep(3)\\n    _, _, body = req(\\\"GET\\\", \\\"/api/intervals/status\\\", token=\\\"tok-rivera\\\")\\n    check(\\\"no artificial 1h expiry (still connected after grace)\\\", body.get(\\\"connected\\\") is True, str(body))\\nfinally:\\n    srv.terminate()\\n    out = srv.communicate(timeout=5)[0]\\n    mock.shutdown()\\n\\nprint()\\nif failures:\\n    print(\\\"FAILURES:\\\", failures); sys.exit(1)\\nprint(\\\"all checks passed\\\")\\n\",\"path\":\"tmp_intervals_test.py\"}"}}]}
