{"role":"assistant","content":"Оба фикса на месте. Теперь сквозной тест: подниму `server.py` с `INTERVALS_BASE`, перенаправленным на локальный мок Intervals (реальный сервис трогать нельзя и не нужно — поведение мока воспроизводит то, что зафиксировано в логах и заметке коллеги).","tool_calls":[{"type":"function","id":"tool_4AHoZQglLEDSxE69bV7drPjZ","function":{"name":"Write","arguments":"{\"content\":\"#!/usr/bin/env python3\\n\\\"\\\"\\\"Local mock of Intervals.icu + end-to-end checks against server.py.\\n\\nMocks the documented Intervals behavior:\\n- /api/oauth/token accepts ONLY client_id, client_secret, code (no grant_type,\\n  no redirect_uri) and replies without refresh_token / expires_in.\\n- /api/v1/athlete/{id}/wellness answers 401 for the \\\"revoked\\\" token.\\n\\\"\\\"\\\"\\nimport json, subprocess, sys, threading, time, urllib.parse, urllib.request, urllib.error\\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\\n\\nTOKENS = {           # code -> (access_token, athlete_id, athlete_name)\\n    \\\"code-okafor\\\": (\\\"tok-good-1\\\", \\\"i11111\\\", \\\"C. Okafor\\\"),\\n    \\\"code-other\\\":  (\\\"tok-good-2\\\", \\\"i22222\\\", \\\"Someone Else\\\"),\\n    \\\"code-revoked\\\": (\\\"revoked\\\",  \\\"i98765\\\", \\\"T. Rivera\\\"),\\n}\\n\\nclass Mock(BaseHTTPRequestHandler):\\n    def log_message(self, *a): pass\\n    def do_POST(self):\\n        if self.path == \\\"/api/oauth/token\\\":\\n            n = int(self.headers.get(\\\"Content-Length\\\", 0))\\n            fields = dict(urllib.parse.parse_qsl(self.rfile.read(n).decode()))\\n            # Contract from the field notes: only these three fields.\\n            if set(fields) - {\\\"client_id\\\", \\\"client_secret\\\", \\\"code\\\"}:\\n                return self.reply(400, {\\\"error\\\": \\\"invalid_request\\\"})\\n            if fields.get(\\\"client_id\\\") != \\\"tricoach-dev\\\" or not fields.get(\\\"client_secret\\\"):\\n                return self.reply(400, {\\\"error\\\": \\\"invalid_client\\\"})\\n            t = TOKENS.get(fields.get(\\\"code\\\"))\\n            if not t:\\n                return self.reply(400, {\\\"error\\\": \\\"invalid_code\\\"})\\n            return self.reply(200, {\\\"token_type\\\": \\\"bearer\\\", \\\"access_token\\\": t[0],\\n                                    \\\"scope\\\": \\\"ACTIVITY:WRITE,WELLNESS:READ,CALENDAR:WRITE\\\",\\n                                    \\\"athlete\\\": {\\\"id\\\": t[1], \\\"name\\\": t[2]}})\\n        self.reply(404, {\\\"error\\\": \\\"not found\\\"})\\n    def do_GET(self):\\n        url = urllib.parse.urlsplit(self.path)\\n        if url.path.endswith(\\\"/wellness\\\"):\\n            if self.headers.get(\\\"Authorization\\\") == \\\"Bearer revoked\\\":\\n                return self.reply(401, {\\\"error\\\": \\\"invalid_token\\\"})\\n            return self.reply(200, [{\\\"id\\\": \\\"w1\\\", \\\"resting_hr\\\": 52}])\\n        self.reply(404, {\\\"error\\\": \\\"not found\\\"})\\n    def reply(self, code, obj):\\n        body = json.dumps(obj).encode()\\n        self.send_response(code)\\n        self.send_header(\\\"Content-Type\\\", \\\"application/json\\\")\\n        self.send_header(\\\"Content-Length\\\", str(len(body)))\\n        self.end_headers()\\n        self.wfile.write(body)\\n\\nBASE = \\\"http://127.0.0.1:8766\\\"\\nfailures = []\\n\\ndef check(name, cond, extra=\\\"\\\"):\\n    print((\\\"PASS \\\" if cond else \\\"FAIL \\\") + name + (f\\\"  [{extra}]\\\" if extra and not cond else \\\"\\\"))\\n    if not cond:\\n        failures.append(name)\\n\\ndef req(method, path, token=None, body=None):\\n    r = urllib.request.Request(BASE + path, method=method,\\n                               data=json.dumps(body).encode() if body is not None else None)\\n    if token:\\n        r.add_header(\\\"Authorization\\\", \\\"Bearer \\\" + token)\\n    try:\\n        with urllib.request.urlopen(r, timeout=10) as resp:\\n            return resp.status, dict(resp.headers), json.loads(resp.read().decode() or \\\"{}\\\")\\n    except urllib.error.HTTPError as e:\\n        return e.code, dict(e.headers), json.loads(e.read().decode() or \\\"{}\\\")\\n\\ndef get_location(path):\\n    r = urllib.request.Request(BASE + path, method=\\\"GET\\\")\\n    try:\\n        urllib.request.urlopen(r, timeout=10)\\n    except urllib.error.HTTPError as e:\\n        return e.code, dict(e.headers), b\\\"\\\"\\n    raise AssertionError(\\\"expected HTTPError for redirect capture\\\")\\n\\nmock = ThreadingHTTPServer((\\\"127.0.0.1\\\", 8899), Mock)\\nthreading.Thread(target=mock.serve_forever, daemon=True).start()\\n\\nenv = dict(__import__(\\\"os\\\").environ, INTERVALS_BASE=\\\"http://127.0.0.1:8899\\\")\\nsrv = subprocess.Popen([sys.executable, \\\"server.py\\\"], env=env,\\n                       stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)\\ntime.sleep(1.0)\\ntry:\\n    # 1. Old GET init is gone; POST without token still 401s.\\n    check(\\\"GET /auth/init -> 404 (no longer a navigation target)\\\",\\n          req(\\\"GET\\\", \\\"/api/intervals/auth/init\\\", token=\\\"tok-okafor\\\")[0] == 404)\\n    check(\\\"POST /auth/init without token -> 401\\\",\\n          req(\\\"POST\\\", \\\"/api/intervals/auth/init\\\")[0] == 401)\\n\\n    # 2. POST init returns an authorize URL with sane scopes.\\n    code, _, body = req(\\\"POST\\\", \\\"/api/intervals/auth/init\\\", token=\\\"tok-okafor\\\")\\n    check(\\\"POST /auth/init -> 200 authorize_url\\\", code == 200 and \\\"authorize_url\\\" in body)\\n    au = urllib.parse.urlsplit(body.get(\\\"authorize_url\\\", \\\"\\\"))\\n    qp = dict(urllib.parse.parse_qsl(au.query))\\n    areas = [s.split(\\\":\\\")[0] for s in qp.get(\\\"scope\\\", \\\"\\\").split(\\\",\\\") if s]\\n    perms = {s.split(\\\":\\\")[0] for s in qp.get(\\\"scope\\\", \\\"\\\").split(\\\",\\\") if \\\":\\\" in s}\\n    both = {a for a in perms if f\\\"{a}:READ\\\" in qp.get(\\\"scope\\\",\\\"\\\") and f\\\"{a}:WRITE\\\" in qp.get(\\\"scope\\\",\\\"\\\")}\\n    check(\\\"authorize URL points at Intervals /oauth/authorize\\\",\\n          au.scheme == \\\"http\\\" and au.netloc == \\\"127.0.0.1:8899\\\" and au.path == \\\"/oauth/authorize\\\", body.get(\\\"authorize_url\\\",\\\"\\\"))\\n    check(\\\"scope has no duplicate area\\\", len(areas) == len(set(areas)) and not both, qp.get(\\\"scope\\\",\\\"\\\"))\\n    check(\\\"state present\\\", bool(qp.get(\\\"state\\\")))\\n    state_okafor = qp[\\\"state\\\"]\\n\\n    # 3. Callback: exchange code -> connected; redirect home.\\n    r = urllib.request.Request(BASE + f\\\"/api/intervals/callback?code=code-okafor&state={urllib.parse.quote(state_okafor)}\\\")\\n    try:\\n        urllib.request.urlopen(r, timeout=10)\\n        redir = None\\n    except urllib.error.HTTPError as e:\\n        redir = e.headers.get(\\\"Location\\\") if e.code in (301, 302, 303, 307, 308) else None\\n        check(\\\"callback -> 302 to /?connected=1\\\", e.code == 302 and redir == \\\"/?connected=1\\\", f\\\"code={e.code}\\\")\\n    code, _, body = req(\\\"GET\\\", \\\"/api/intervals/status\\\", token=\\\"tok-okafor\\\")\\n    check(\\\"status: connected as i11111\\\", code == 200 and body.get(\\\"connected\\\") and body[\\\"athlete\\\"][\\\"id\\\"] == \\\"i11111\\\", str(body))\\n    code, _, body = req(\\\"GET\\\", \\\"/api/intervals/wellness\\\", token=\\\"tok-okafor\\\")\\n    check(\\\"wellness proxy 200\\\", code == 200 and body == [{\\\"id\\\": \\\"w1\\\", \\\"resting_hr\\\": 52}], f\\\"{code} {body}\\\")\\n\\n    # 4. Callback from a different Intervals account is rejected, old one kept.\\n    r = urllib.request.Request(BASE + f\\\"/api/intervals/callback?code=code-other&state={urllib.parse.quote(state_okafor)}\\\")\\n    try:\\n        urllib.request.urlopen(r, timeout=10)\\n        check(\\\"mismatch callback -> 409\\\", False)\\n    except urllib.error.HTTPError as e:\\n        check(\\\"mismatch callback -> 409\\\", e.code == 409, f\\\"code={e.code}\\\")\\n    _, _, body = req(\\\"GET\\\", \\\"/api/intervals/status\\\", token=\\\"tok-okafor\\\")\\n    check(\\\"still connected as i11111 after mismatch\\\", body.get(\\\"athlete\\\", {}).get(\\\"id\\\") == \\\"i11111\\\", str(body))\\n\\n    # 5. Bad / expired state rejected.\\n    bad = state_okafor[:-4] + \\\"AAAA\\\"\\n    check(\\\"tampered state -> 400\\\",\\n          req(\\\"GET\\\", f\\\"/api/intervals/callback?code=code-okafor&state={urllib.parse.quote(bad)}\\\")[0] == 400)\\n\\n    # 6. Rivera: revoked token degrades to disconnected on first 401.\\n    _, _, body = req(\\\"POST\\\", \\\"/api/intervals/auth/init\\\", token=\\\"tok-rivera\\\")\\n    state_rivera = urllib.parse.parse_qs(urllib.parse.urlsplit(body[\\\"authorize_url\\\"]).query)[\\\"state\\\"][0]\\n    req(\\\"GET\\\", f\\\"/api/intervals/callback?code=code-revoked&state={urllib.parse.quote(state_rivera)}\\\")\\n    code, _, body = req(\\\"GET\\\", \\\"/api/intervals/wellness\\\", token=\\\"tok-rivera\\\")\\n    check(\\\"wellness on revoked token -> 409 not-connected\\\", code == 409 and \\\"error\\\" in body, f\\\"{code} {body}\\\")\\n    _, _, body = req(\\\"GET\\\", \\\"/api/intervals/status\\\", token=\\\"tok-rivera\\\")\\n    check(\\\"status after 401 -> disconnected (reconnect offered)\\\", body.get(\\\"connected\\\") is False, str(body))\\n    # and reconnecting works right away (state identity flows through)\\n    _, _, body = req(\\\"POST\\\", \\\"/api/intervals/auth/init\\\", token=\\\"tok-rivera\\\")\\n    state_rivera = urllib.parse.parse_qs(urllib.parse.urlsplit(body[\\\"authorize_url\\\"]).query)[\\\"state\\\"][0]\\n    r = urllib.request.Request(BASE + f\\\"/api/intervals/callback?code=code-okafor&state={urllib.parse.quote(state_rivera)}\\\")\\n    try:\\n        urllib.request.urlopen(r, timeout=10)\\n        check(\\\"reconnect after revoke -> 302\\\", False)\\n    except urllib.error.HTTPError as e:\\n        check(\\\"reconnect after revoke -> 302\\\", e.code == 302 and e.headers.get(\\\"Location\\\") == \\\"/?connected=1\\\", f\\\"code={e.code}\\\")\\n\\n    # 7. No silent one-hour expiry anymore: token had no expires_in, connection\\n    #    must still be connected well past the old 60s refresh cadence.\\n    time.sleep(3)\\n    _, _, body = req(\\\"GET\\\", \\\"/api/intervals/status\\\", token=\\\"tok-rivera\\\")\\n    check(\\\"no artificial 1h expiry (still connected after grace)\\\", body.get(\\\"connected\\\") is True, str(body))\\nfinally:\\n    srv.terminate()\\n    out = srv.communicate(timeout=5)[0]\\n    mock.shutdown()\\n\\nprint()\\nif failures:\\n    print(\\\"FAILURES:\\\", failures); sys.exit(1)\\nprint(\\\"all checks passed\\\")\\n\",\"path\":\"tmp_intervals_test.py\"}"}}]}
