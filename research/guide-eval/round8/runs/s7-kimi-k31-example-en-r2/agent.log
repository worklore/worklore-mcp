{"role":"tool","tool_call_id":"tool_Qu95oqD0ptX58zf89ynETJ7u","content":"95\t            return self.send_json(404, {\"error\": \"not found\"})\n96\t        with open(p, \"rb\") as f:\n97\t            body = f.read()\n98\t        self.send_response(200)\n99\t        self.send_header(\"Content-Type\", ctype)\n100\t        self.send_header(\"Content-Length\", str(len(body)))\n101\t        self.end_headers()\n102\t        self.wfile.write(body)\n103\t\n104\t    def redirect(self, url):\n105\t        self.send_response(302)\n106\t        self.send_header(\"Location\", url)\n107\t        self.end_headers()\n108\t\n109\t    def current_user(self):\n110\t        auth = self.headers.get(\"Authorization\", \"\")\n111\t        if not auth.startswith(\"Bearer \"):\n112\t            return None\n113\t        return USERS.get(auth[7:].strip())\n114\t\n115\t    def require_user(self):\n116\t        user = self.current_user()\n117\t        if user is None:\n118\t            self.log_message(\"%s %s 401 (no Authorization header)\", self.command, self.path)\n119\t            self.send_json(401, {\"error\": \"unauthorized\"})\n120\t        return user\n121\t\n122\t    def do_GET(self):\n123\t        url = urllib.parse.urlsplit(self.path)\n124\t        q = dict(urllib.parse.parse_qsl(url.query))\n125\t        if url.path == \"/\":\n126\t            return self.send_file(\"index.html\", \"text/html; charset=utf-8\")\n127\t        if url.path.startswith(\"/static/\"):\n128\t            return self.send_file(os.path.basename(url.path), \"application/javascript\" if url.path.endswith(\".js\") else \"text/plain\")\n129\t        if url.path == \"/api/me\":\n130\t            user = self.require_user()\n131\t            return user and self.send_json(200, user)\n132\t        if url.path == \"/api/intervals/auth/init\":\n133\t            return self.auth_init()\n134\t        if url.path == \"/api/intervals/callback\":\n135\t            return self.callback(q)\n136\t        if url.path == \"/api/intervals/status\":\n137\t            return self.status()\n138\t        if url.path == \"/api/intervals/wellness\":\n139\t            return self.wellness()\n140\t        self.send_json(404, {\"error\": \"not found\"})\n141\t\n142\t    def do_POST(self):\n143\t        url = urllib.parse.urlsplit(self.path)\n144\t        if url.path == \"/api/intervals/disconnect\":\n145\t            user = self.require_user()\n146\t            if user:\n147\t                with LOCK:\n148\t                    CONNECTIONS.pop(user[\"id\"], None)\n149\t                self.send_json(200, {\"ok\": True})\n150\t            return\n151\t        self.send_json(404, {\"error\": \"not found\"})\n152\t\n153\t    # Step 1: build the authorize URL and send the browser to Intervals.\n154\t    def auth_init(self):\n155\t        user = self.require_user()\n156\t        if not user:\n157\t            return\n158\t        params = {\"client_id\": config.CLIENT_ID, \"redirect_uri\": config.REDIRECT_URI,\n159\t                  \"scope\": config.SCOPES, \"state\": sign_state(user[\"id\"])}\n160\t        self.redirect(AUTHORIZE_URL + \"?\" + urllib.parse.urlencode(params, safe=\":,\"))\n161\t\n162\t    # Step 2: Intervals redirects back here with ?code=&state=.\n163\t    def callback(self, q):\n164\t        user_id = verify_state(q.get(\"state\", \"\"))\n165\t        if not user_id or not q.get(\"code\"):\n166\t            return self.send_json(400, {\"error\": \"bad state or code\"})\n167\t        try:\n168\t            tok = exchange_code(q[\"code\"])\n169\t            store_connection(user_id, tok)\n170\t        except urllib.error.HTTPError as e:\n171\t            log(f\"{user_id}: token exchange failed: HTTP {e.code} {e.read()[:200]!r}\")\n172\t            return self.send_json(502, {\"error\": \"token exchange failed\"})\n173\t        except Exception as e:\n174\t            log(f\"{user_id}: token exchange failed: {e}\")\n175\t            return self.send_json(502, {\"error\": \"token exchange failed\"})\n176\t        self.redirect(\"/?connected=1\")\n177\t\n178\t    def status(self):\n179\t        user = self.require_user()\n180\t        if not user:\n181\t            return\n182\t        with LOCK:\n183\t            c = CONNECTIONS.get(user[\"id\"])\n184\t        if not c or c[\"status\"] != \"connected\":\n185\t            return self.send_json(200, {\"connected\": False, \"status\": c[\"status\"] if c else \"disconnected\"})\n186\t        self.send_json(200, {\"connected\": True, \"status\": \"connected\", \"scope\": c[\"scope\"],\n187\t                             \"athlete\": {\"id\": c[\"athlete_id\"], \"name\": c[\"athlete_name\"]}})\n188\t\n189\t    def wellness(self):\n190\t        user = self.require_user()\n191\t        if not user:\n192\t            return\n193\t        with LOCK:\n194\t            c = CONNECTIONS.get(user[\"id\"])\n195\t        if not c or c[\"status\"] != \"connected\":\n196\t            return self.send_json(409, {\"error\": \"intervals not connected\"})\n197\t        try:\n198\t            code, data = intervals_get(c, \"/wellness\")\n199\t            self.send_json(code, data)\n200\t        except urllib.error.HTTPError as e:\n201\t            self.send_json(e.code, {\"error\": f\"intervals returned {e.code}\"})\n202\t        except Exception as e:\n203\t            self.send_json(502, {\"error\": str(e)})\n204\t\n205\t\n206\tif __name__ == \"__main__\":\n207\t    threading.Thread(target=refresh_tokens, daemon=True).start()\n208\t    log(f\"serving on http://localhost:{config.PORT} (intervals: {config.INTERVALS_BASE})\")\n209\t    ThreadingHTTPServer((\"127.0.0.1\", config.PORT), Handler).serve_forever()"}
{"role":"tool","tool_call_id":"tool_kahgfFAb16Fs0im3Yz5Y2jOM","content":"16\tasync function render() {\n17\t  try {\n18\t    const me = await api(\"/api/me\");\n19\t    const st = await api(\"/api/intervals/status\");\n20\t    let card;\n21\t    if (st.connected) {\n22\t      card = `<div class=\"card\">Connected to Intervals.icu as <b>${esc(st.athlete.name)}</b>\n23\t        (${esc(st.athlete.id)}), scope <code>${esc(st.scope)}</code>.\n24\t        <p><button class=\"btn\" id=\"disconnect\">Disconnect</button></p></div>`;\n25\t    } else {\n26\t      const why = st.status && st.status !== \"disconnected\" ? `<p class=\"muted\">Status: ${esc(st.status)}</p>` : \"\";\n27\t      card = `<div class=\"card\">Intervals.icu is not connected.${why}\n28\t        <p><button class=\"btn\" id=\"connect\">Connect Intervals.icu</button></p></div>`;\n29\t    }\n30\t    root.className = \"\";\n31\t    root.innerHTML = `<p>Signed in as <b>${esc(me.name)}</b>.</p>${card}`;\n32\t    const d = document.getElementById(\"disconnect\");\n33\t    if (d) d.onclick = async () => { await api(\"/api/intervals/disconnect\", { method: \"POST\" }); render(); };\n34\t  } catch (e) {\n35\t    root.innerHTML = `<p class=\"card\">Error: ${esc(e.message)}</p>`;\n36\t  }\n37\t}\n38\t\n39\trender();"}
