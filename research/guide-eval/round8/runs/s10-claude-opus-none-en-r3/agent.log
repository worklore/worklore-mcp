{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0173qoCUTWPFD8taPPDiNrem","type":"tool_result","content":"import 'package:posthog_flutter/posthog_flutter.dart';\n\n/// Thin wrapper around PostHog so the key and host live in one place.\nclass Analytics {\n  static Future<void> init() async {\n    final config = PostHogConfig('phc_REPLACE_ME_IN_CI');\n    config.host = 'https://eu.i.posthog.com';\n    config.captureApplicationLifecycleEvents = true;\n    await Posthog().setup(config);\n  }\n\n  /// Sends one event. [props] is optional.\n  static Future<void> capture(String event, [Map<String, Object>? props]) =>\n      Posthog().capture(eventName: event, properties: props);\n}\nimport 'package:flutter/material.dart';\nimport 'package:posthog_flutter/posthog_flutter.dart';\n\nimport 'analytics.dart';\nimport 'screens/offer_screen.dart';\nimport 'screens/registration_screen.dart';\n\nFuture<void> main() async {\n  WidgetsFlutterBinding.ensureInitialized();\n  await Analytics.init();\n  runApp(const KreditoApp());\n}\n\nclass KreditoApp extends StatelessWidget {\n  const KreditoApp({super.key});\n\n  @override\n  Widget build(BuildContext context) {\n    return PostHogWidget(\n      child: MaterialApp(\n        title: 'Kredito',\n        theme: ThemeData(colorSchemeSeed: Colors.green, useMaterial3: true),\n        navigatorObservers: [PosthogObserver()],\n        routes: {\n          '/': (_) => const RegistrationScreen(),\n          '/offers': (_) => const OfferScreen(),\n        },\n      ),\n    );\n  }\n}\nimport 'package:flutter/material.dart';\n\nclass Offer {\n  const Offer(this.bank, this.months, this.rate);\n  final String bank;\n  final int months;\n  final double rate;\n}\n\nconst _offers = [\n  Offer('Norbank', 12, 9.9),\n  Offer('Norbank', 24, 10.4),\n  Offer('Fjordcredit', 12, 8.7),\n  Offer('Fjordcredit', 36, 11.2),\n  Offer('Vestkapital', 24, 9.5),\n  Offer('Vestkapital', 48, 12.0),\n  Offer('Sparbank', 12, 10.9),\n  Offer('Sparbank', 60, 12.8),\n  Offer('Nordlån', 36, 10.1),\n  Offer('Nordlån', 60, 12.3),\n];\n\nclass OfferScreen extends StatelessWidget {\n  const OfferScreen({super.key});\n\n  @override\n  Widget build(BuildContext context) {\n    return Scaffold(\n      appBar: AppBar(title: const Text('Offers')),\n      body: ListView.builder(\n        itemCount: _offers.length,\n        itemBuilder: (context, i) {\n          final o = _offers[i];\n          return ListTile(\n            leading: const Icon(Icons.account_balance),\n            title: Text('${o.bank}, ${o.months} months'),\n            subtitle: Text('${o.rate.toStringAsFixed(1)}% APR'),\n            trailing: const Icon(Icons.chevron_right),\n            onTap: () {},\n          );\n        },\n      ),\n    );\n  }\n}\nimport 'package:flutter/material.dart';\n\nclass RegistrationScreen extends StatefulWidget {\n  const RegistrationScreen({super.key});\n\n  @override\n  State<RegistrationScreen> createState() => _RegistrationScreenState();\n}\n\nclass _RegistrationScreenState extends State<RegistrationScreen> {\n  final _email = TextEditingController();\n  final _phone = TextEditingController();\n  double _amount = 50000;\n  bool _terms = false;\n\n  @override\n  void dispose() {\n    _email.dispose();\n    _phone.dispose();\n    super.dispose();\n  }\n\n  bool get _canContinue =>\n      _terms && _email.text.contains('@') && _phone.text.length >= 10;\n\n  @override\n  Widget build(BuildContext context) {\n    return Scaffold(\n      appBar: AppBar(title: const Text('Register')),\n      body: Padding(\n        padding: const EdgeInsets.all(16),\n        child: Column(\n          crossAxisAlignment: CrossAxisAlignment.stretch,\n          children: [\n            TextField(\n              controller: _email,\n              keyboardType: TextInputType.emailAddress,\n              decoration: const InputDecoration(labelText: 'Email'),\n              onChanged: (_) => setState(() {}),\n            ),\n            const SizedBox(height: 12),\n            TextField(\n              controller: _phone,\n              keyboardType: TextInputType.phone,\n              decoration: const InputDecoration(labelText: 'Phone'),\n              onChanged: (_) => setState(() {}),\n            ),\n            const SizedBox(height: 24),\n            Text('Loan amount: ${_amount.round()}'),\n            Slider(\n              min: 10000,\n              max: 500000,\n              divisions: 49,\n              value: _amount,\n              label: _amount.round().toString(),\n              onChanged: (v) => setState(() => _amount = v),\n            ),\n            CheckboxListTile(\n              value: _terms,\n              title: const Text('I accept the terms and conditions'),\n              controlAffinity: ListTileControlAffinity.leading,\n              onChanged: (v) => setState(() => _terms = v ?? false),\n            ),\n            const Spacer(),\n            FilledButton(\n              onPressed: _canContinue\n                  ? () => Navigator.of(context).pushNamed('/offers')\n                  : null,\n              child: const Text('Continue'),\n            ),\n          ],\n        ),\n      ),\n    );\n  }\n}\nname: kredito\ndescription: Consumer loan registration and offers.\npublish_to: \"none\"\nversion: 1.3.0+27\n\nenvironment:\n  sdk: ^3.5.0\n\ndependencies:\n  flutter:\n    sdk: flutter\n  posthog_flutter: ^5.36.0\n\ndev_dependencies:\n  flutter_test:\n    sdk: flutter\n  flutter_lints: ^5.0.0\n\nflutter:\n  uses-material-design: true\ninclude: package:flutter_lints/flutter.yaml","is_error":false}]},"parent_tool_use_id":null,"session_id":"19d87fd8-f88c-4741-b856-3b7b1f9e5a56","uuid":"87188d4d-dd0b-40c4-93b3-d49d39161748","timestamp":"2026-10-27T04:26:00.869Z","tool_use_result":{"stdout":"import 'package:posthog_flutter/posthog_flutter.dart';\n\n/// Thin wrapper around PostHog so the key and host live in one place.\nclass Analytics {\n  static Future<void> init() async {\n    fin