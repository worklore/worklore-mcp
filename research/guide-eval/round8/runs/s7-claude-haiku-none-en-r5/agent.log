         c.update(access_token=tok[\"access_token\"],\n                             refresh_token=tok.get(\"refresh_token\", c[\"refresh_token\"]),\n                             expires_at=now + int(tok[\"expires_in\"]))\n                    log(f\"{uid}: token refreshed\")\n                except Exception as e:\n                    log(f\"{uid}: refresh failed ({e}) -> expired, reconnect\")\n                    c.update(status=\"expired, reconnect\", access_token=None)","new_string":"def expiry_from(tok, now):\n    \"\"\"Absolute expiry for a token response, or None when the provider did not say.\n\n    We must not guess a lifetime: a made-up TTL marks a working token as expired.\n    With no expiry on file the token stays in use until Intervals rejects it (see wellness()).\n    \"\"\"\n    expires_in = tok.get(\"expires_in\")\n    return now + int(expires_in) if expires_in else None\n\n\ndef store_connection(user_id, tok):\n    now = time.time()\n    refresh = tok.get(\"refresh_token\")\n    athlete = tok.get(\"athlete\") or {}\n    with LOCK:\n        CONNECTIONS[user_id] = {\n            \"athlete_id\": athlete.get(\"id\"), \"athlete_name\": athlete.get(\"name\"),\n            \"access_token\": tok[\"access_token\"], \"refresh_token\": refresh,\n            \"scope\": tok.get(\"scope\"), \"expires_at\": expiry_from(tok, now), \"status\": \"connected\",\n        }\n    log(f\"{user_id}: connected as athlete {athlete.get('id')} \"\n        f\"(expires_in={tok.get('expires_in')}, refresh_token={'yes' if refresh else 'no'})\")\n\n\ndef mark_expired(c, reason):\n    c.update(status=\"expired, reconnect\", access_token=None)\n    return reason\n\n\ndef refresh_tokens():\n    \"\"\"Background pass: renew access tokens shortly before they expire.\"\"\"\n    while True:\n        time.sleep(config.REFRESH_INTERVAL)\n        now = time.time()\n        with LOCK:\n            for uid, c in CONNECTIONS.items():\n                if c[\"status\"] != \"connected\" or c[\"expires_at\"] is None or c[\"expires_at\"] - now > 300:\n                    continue\n                if not c[\"refresh_token\"]:\n                    if c[\"expires_at\"] <= now:\n                        log(f\"{uid}: token expired and no refresh token on file -> expired, reconnect\")\n                        mark_expired(c, \"expired\")\n                    continue\n                try:\n                    tok = post_form(TOKEN_URL, {\n                        \"grant_type\": \"refresh_token\", \"refresh_token\": c[\"refresh_token\"],\n                        \"client_id\": config.CLIENT_ID, \"client_secret\": config.CLIENT_SECRET,\n                    })\n                    c.update(access_token=tok[\"access_token\"],\n                             refresh_token=tok.get(\"refresh_token\", c[\"refresh_token\"]),\n                             expires_at=expiry_from(tok, now))\n                    log(f\"{uid}: token refreshed\")\n                except Exception as e:\n                    log(f\"{uid}: refresh failed ({e}) -> expired, reconnect\")\n                    mark_expired(c, \"refresh failed\")"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5499,"cache_read_input_tokens":30157,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5499},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"28a76e9f-8d1a-4338-b383-2fe5082b1be8","uuid":"0b1c2fab-56f0-46d3-9e16-c8ec85f37a7b","timestamp":"2026-10-27T05:13:19.316Z","request_id":"req_011CgSAmtjhpybHfWjex6pSH","wire_tool_inputs":{"toolu_01XYQpw97pdZqQ4swQW637Sq":{"file_path":"/private/tmp/h-kxdRlw/server.py","old_string":"def store_connection(user_id, tok):\n    expires_in = int(tok.get(\"expires_in\") or DEFAULT_TOKEN_TTL)\n    refre