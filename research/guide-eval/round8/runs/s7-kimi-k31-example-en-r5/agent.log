nse.status, json.loads(raw) if raw else {}\\n    except urllib.error.HTTPError as e:\\n        raw = e.read().decode()\\n        return e.code, json.loads(raw) if raw else {}\\n\\ntry:\\n    code, body = call(\\\"/api/intervals/auth/init\\\", \\\"POST\\\", authenticated=False)\\n    assert (code, body) == (401, {\\\"error\\\": \\\"unauthorized\\\"})\\n\\n    code, body = call(\\\"/api/intervals/auth/init\\\", \\\"POST\\\")\\n    assert code == 200 and body[\\\"authorize_url\\\"]\\n    with urllib.request.urlopen(body[\\\"authorize_url\\\"], timeout=5) as response:\\n        assert response.status == 200\\n    query = urllib.parse.parse_qs(urllib.parse.urlsplit(body[\\\"authorize_url\\\"]).query)\\n    assert query[\\\"scope\\\"] == [\\\"ACTIVITY:WRITE,WELLNESS:READ,CALENDAR:WRITE\\\"]\\n    state = query[\\\"state\\\"][0]\\n    assert server.verify_state(state) == \\\"u_okafor\\\"\\n\\n    code, _ = call(\\\"/api/intervals/callback?\\\" + urllib.parse.urlencode({\\\"code\\\": \\\"oauth-code\\\", \\\"state\\\": state}), authenticated=False)\\n    assert code == 302\\n    assert len(Provider.token_forms) == 1\\n    assert \\\"expires_at\\\" not in server.CONNECTIONS[\\\"u_okafor\\\"]\\n    assert \\\"refresh_token\\\" not in server.CONNECTIONS[\\\"u_okafor\\\"]\\n\\n    code, body = call(\\\"/api/intervals/status\\\")\\n    assert code == 200 and body[\\\"connected\\\"] and body[\\\"athlete\\\"][\\\"id\\\"] == \\\"i98765\\\"\\n    code, body = call(\\\"/api/intervals/wellness\\\")\\n    assert code == 200 and body[\\\"wellness\\\"][0][\\\"id\\\"] == \\\"w1\\\"\\n\\n    Provider.revoked = True\\n    code, body = call(\\\"/api/intervals/wellness\\\")\\n    assert code == 401\\n    code, body = call(\\\"/api/intervals/status\\\")\\n    assert code == 200 and body == {\\\"connected\\\": False, \\\"status\\\": \\\"revoked, reconnect\\\"}\\n    assert server.CONNECTIONS[\\\"u_okafor\\\"][\\\"access_token\\\"] is None\\n\\n    Provider.revoked = False\\n    Provider.athlete_id = \\\"someone-else\\\"\\n    _, init = call(\\\"/api/intervals/auth/init\\\", \\\"POST\\\")\\n    other_state = urllib.parse.parse_qs(urllib.parse.urlsplit(init[\\\"authorize_url\\\"]).query)[\\\"state\\\"][0]\\n    code, _ = call(\\\"/api/intervals/callback?\\\" + urllib.parse.urlencode({\\\"code\\\": \\\"oauth-code\\\", \\\"state\\\": other_state}), authenticated=False)\\n    assert code == 409\\n    assert server.CONNECTIONS[\\\"u_okafor\\\"][\\\"athlete_id\\\"] == \\\"i98765\\\"\\n\\n    Provider.athlete_id = \\\"i98765\\\"\\n    _, init = call(\\\"/api/intervals/auth/init\\\", \\\"POST\\\")\\n    state = urllib.parse.parse_qs(urllib.parse.urlsplit(init[\\\"authorize_url\\\"]).query)[\\\"state\\\"][0]\\n    code, _ = call(\\\"/api/intervals/callback?\\\" + urllib.parse.urlencode({\\\"code\\\": \\\"oauth-code\\\", \\\"state\\\": state}), authenticated=False)\\n    assert code == 302\\n    code, body = call(\\\"/api/intervals/status\\\")\\n    assert code == 200 and body[\\\"connected\\\"]\\n    print(\\\"PASS: authenticated init, authorize URL, code exchange, connection, wellness, revocation, mismatch guard, and reconnect\\\")\\nfinally:\\n    app.shutdown()\\n    provider.shutdown()\\n    app.server_close()\\n    provider.server_close()\\nPY\",\"cwd\":\"/private/tmp/h-5YNB0L\",\"timeout\":60}"}}]}
