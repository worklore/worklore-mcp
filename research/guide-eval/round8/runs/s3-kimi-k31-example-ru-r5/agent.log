{"role":"tool","tool_call_id":"tool_KL4z84NjgCDf9fqeQ5AVg2T9","content":" M Library/LaunchAgents/com.vk.nightly-review.plist\n M bin/nightly-review.zsh\n?? ANSWER.md\ndiff --git a/Library/LaunchAgents/com.vk.nightly-review.plist b/Library/LaunchAgents/com.vk.nightly-review.plist\nindex c347363..d49eacf 100644\n--- a/Library/LaunchAgents/com.vk.nightly-review.plist\n+++ b/Library/LaunchAgents/com.vk.nightly-review.plist\n@@ -24,6 +24,8 @@\n   <dict>\n     <key>PATH</key>\n     <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>\n+    <key>USER</key>\n+    <string>vk</string>\n   </dict>\n </dict>\n </plist>\ndiff --git a/bin/nightly-review.zsh b/bin/nightly-review.zsh\nindex e0b986f..a05c8b0 100755\n--- a/bin/nightly-review.zsh\n+++ b/bin/nightly-review.zsh\n@@ -15,12 +15,12 @@ Do not modify any file.\"\n \n cd \"$REPO\" || { \"$NOTIFY\" \"nightly review: repo missing\"; exit 1; }\n \n-claude -p \"$PROMPT\" --output-format text > \"$OUT\"\n-status=$?\n+print -r -- \"$PROMPT\" | claude -p --output-format text > \"$OUT\"\n+rc=$?\n \n-if [ $status -ne 0 ]; then\n-  \"$NOTIFY\" \"nightly review FAILED (exit $status), see $OUT\"\n-  exit $status\n+if [ $rc -ne 0 ]; then\n+  \"$NOTIFY\" \"nightly review FAILED (exit $rc), see $OUT\"\n+  exit $rc\n fi\n \n \"$NOTIFY\" \"nightly review done: $(head -c 300 \"$OUT\")\"\n"}
