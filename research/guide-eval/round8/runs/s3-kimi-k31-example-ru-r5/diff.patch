diff --git a/bin/nightly-review.zsh b/bin/nightly-review.zsh
index e0b986f..a05c8b0 100755
--- a/bin/nightly-review.zsh
+++ b/bin/nightly-review.zsh
@@ -15,12 +15,12 @@ Do not modify any file."
 
 cd "$REPO" || { "$NOTIFY" "nightly review: repo missing"; exit 1; }
 
-claude -p "$PROMPT" --output-format text > "$OUT"
-status=$?
+print -r -- "$PROMPT" | claude -p --output-format text > "$OUT"
+rc=$?
 
-if [ $status -ne 0 ]; then
-  "$NOTIFY" "nightly review FAILED (exit $status), see $OUT"
-  exit $status
+if [ $rc -ne 0 ]; then
+  "$NOTIFY" "nightly review FAILED (exit $rc), see $OUT"
+  exit $rc
 fi
 
 "$NOTIFY" "nightly review done: $(head -c 300 "$OUT")"
