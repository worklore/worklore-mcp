stening server to the actual provider handler.\\nprovider.finish_request = lambda request, client_address: Provider(request, client_address, provider)\\nprovider_thread = threading.Thread(target=provider.serve_forever, daemon=True)\\napp_thread = threading.Thread(target=app.serve_forever, daemon=True)\\nprovider_thread.start()\\napp_thread.start()\\n\\ndef request(url, method=\\\"GET\\\", auth=True):\\n    headers = {\\\"Authorization\\\": \\\"Bearer tok-okafor\\\"} if auth else {}\\n    req = urllib.request.Request(url, method=method, headers=headers)\\n    try:\\n        with urllib.request.urlopen(req, timeout=5) as response:\\n            return response.status, response.read(), response.geturl()\\n    except urllib.error.HTTPError as e:\\n        return e.code, e.read(), e.geturl()\\n\\ndef connect():\\n    status, body, _ = request(app_base + \\\"/api/intervals/auth/init\\\", \\\"POST\\\")\\n    assert status == 200, (status, body)\\n    authorize_url = json.loads(body)[\\\"authorize_url\\\"]\\n    return request(authorize_url, auth=False)\\n\\ntry:\\n    status, body, _ = request(app_base + \\\"/api/intervals/auth/init\\\", \\\"POST\\\", auth=False)\\n    assert status == 401\\n    status, _, _ = request(app_base + \\\"/api/intervals/auth/init\\\")\\n    assert status == 404\\n\\n    status, body, final_url = connect()\\n    assert status == 200 and final_url.endswith(\\\"/?connected=1\\\"), (status, body, final_url)\\n    assert token_forms and all(set(form) == {\\\"client_id\\\", \\\"client_secret\\\", \\\"code\\\"} for form in token_forms)\\n\\n    status, body, _ = request(app_base + \\\"/api/intervals/status\\\")\\n    connected = json.loads(body)\\n    assert status == 200 and connected[\\\"connected\\\"] and connected[\\\"athlete\\\"][\\\"id\\\"] == \\\"i100\\\"\\n    connection = server.CONNECTIONS[\\\"u_okafor\\\"]\\n    assert \\\"expires_at\\\" not in connection and \\\"refresh_token\\\" not in connection\\n\\n    status, body, _ = request(app_base