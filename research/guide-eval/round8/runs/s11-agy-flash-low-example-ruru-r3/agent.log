{"event":"step_update","step_update":{"conversation_id":"d4a7a6fd-6eb9-45ff-8c1c-c4819b028308","step_index":30,"state":"DONE","step_type":"tool","tool_name":"run_command","duration_seconds":0.1189,"tool_info":{"name":"run_command","parameters":{"CommandLine":"git diff"},"output":"Command exited with code 0.\n\nCommand output:\ndiff --git a/src/app.py b/src/app.py\r\nindex db49c5e..7f591f6 100644\r\n--- a/src/app.py\r\n+++ b/src/app.py\r\n@@ -4,6 +4,7 @@ Each story is stored in one DynamoDB item together with the three most similar\r\n stories already in the library (``similar``), so the reader page can show\r\n \"related\" without a query at read time.\r\n \"\"\"\r\n+from decimal import Decimal\r\n import json\r\n import logging\r\n import re\r\n@@ -27,7 +28,8 @@ def similarity(a, b):\r\n     tag_score = len(ta \u0026 tb) / len(ta | tb) if (ta | tb) else 0\r\n     wa, wb = words(a.get(\"body\")), words(b.get(\"body\"))\r\n     word_score = len(wa \u0026 wb) / len(wa | wb) if (wa | wb) else 0\r\n-    return round(0.7 * tag_score + 0.3 * word_score, 4)\r\n+    score = round(0.7 * tag_score + 0.3 * word_score, 4)\r\n+    return Decimal(str(score))\r\n \r\n \r\n def related(story, existing):\r\ndiff --git a/tests/test_publish.py b/tests/test_publish.py\r\nindex 6c9ac44..016198e 100644\r\n--- a/tests/test_publish.py\r\n+++ b/tests/test_publish.py\r\n@@ -23,6 +23,27 @@ class PublishTest(unittest.TestCase):\r\n         self.assertEqual(table.get_item(Key={\"slug\": \"why-my-cron-ran-twice\"})[\"Item\"][\"title\"], \"Why my cron ran twice\")\r\n         self.assertEqual(table.scan()[\"Count\"], 1)\r\n \r\n+    def test_publish_second_story_succeeds_with_similarity(self):\r\n+        table = FakeTable()\r\n+        story1 = {\r\n+            \"slug\": \"why-my-cron-ran-twice\",\r\n+            \"title\": \"Why my cron ran twice\",\r\n+            \"tags\": [\"cron\", \"linux\"],\r\n+            \"body\": \"Two crontabs, one for root and one for me, both had the line.\",\r\n+        }\r\n+        story2 = {\r\n+            \"slug\": \"cron-troubleshooting-guide\",\r\n+            \"title\": \"Cron Troubleshooting Guide\",\r\n+            \"tags\": [\"cron\", \"guide\"],\r\n+            \"body\": \"How to debug why your cron ran twice or failed.\",\r\n+        }\r\n+        app.publish(table, story1)\r\n+        stored2 = app.publish(table, story2)\r\n+        self.assertEqual(stored2[\"slug\"], \"cron-troubleshooting-guide\")\r\n+        self.assertEqual(len(stored2[\"similar\"]), 1)\r\n+        self.assertEqual(stored2[\"similar\"][0][\"slug\"], \"why-my-cron-ran-twice\")\r\n+        self.assertEqual(table.scan()[\"Count\"], 2)\r\n+\r\n \r\n if __name__ == \"__main__\":\r\n     unittest.main()\r\n"}}}
