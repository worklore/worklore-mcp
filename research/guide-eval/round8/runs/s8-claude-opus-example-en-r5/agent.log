{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgSCepZUZLZssCnGqYvhB","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01CXaEXWYb1GWEB9nXi3roWv","name":"Bash","input":{"command":"python3 - <<'EOF'\nimport re\ns = open(\"bot.py\").read()\n\ns = s.replace('''USAGE_LOG = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"logs\", \"usage.jsonl\")\n''', '''USAGE_LOG = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"logs\", \"usage.jsonl\")\nCACHE_TTL = dt.timedelta(minutes=5)  # Anthropic ephemeral cache lifetime, refreshed on every hit\n''')\n\ns = s.replace('''    facts: list = field(default_factory=list)   # long-term memory, grows via save_fact\n''', '''    facts: list = field(default_factory=list)   # long-term memory, grows via save_fact\n    # Prompt-cache bookkeeping: facts[:cached_facts] sit in the cached system block; facts saved\n    # after that are sent in an uncached block until the cache goes cold (see snapshot_facts).\n    cached_facts: int = 0\n    last_call: str = \"\"                          # UTC ISO time of the last API response\n''')\n\nold_ctx = s[s.index(\"def athlete_context(a, today):\"):s.index(\"# --------------------------------------------------------------------------- tools\")]\nnew_ctx = '''def athlete_context(a, today):\n    \"\"\"Per-athlete block, cached. Only facts already in the snapshot go here, so save_fact doesn't change it.\"\"\"\n    lines = [\n        f\"Athlete: {a.name} (id {a.user_id}), sport: {a.sport}\",\n        \"Zones: \" + \", \".join(f\"{k} {v}\" for k, v in a.zones.items()),\n        f\"Goal: {a.goal}\",\n        f\"Language: {a.lang}\",\n        f\"Today: {today.isoformat()} ({today.strftime('%A')})\",\n        \"Long-term facts:\",\n    ]\n    lines += [f\"- {f}\" for f in a.facts[:a.cached_facts]] or [\"- (none yet)\"]\n    return \"\\\\n\".join(lines)\n\n\ndef recent_facts(a):\n    \"\"\"Facts saved since the cached snapshot. Sent uncached (~15 tokens each) instead of rewriting the cache.\"\"\"\n    new = a.facts[a.cached_facts:]\n    return \"Long-term facts saved recently:\\\\n\" + \"\\\\n\".join(f\"- {f}\" for f in new) if new else \"\"\n\n\ndef snapshot_facts(a, now):\n    \"\"\"Fold recent facts into the cached block, but only when that cache is gone anyway:\n    TTL expired since the last call, or the date changed (the Today line rewrites the block).\"\"\"\n    last = dt.datetime.fromisoformat(a.last_call) if a.last_call else None\n    if last is None or now - last >= CACHE_TTL or last.astimezone().date() != now.astimezone().date():\n        a.cached_facts = len(a.facts)\n    a.cached_facts = min(a.cached_facts, len(a.facts))\n\n\ndef build_system(a, today):\n    # Two cached segments + an uncached tail. Segment 1 (instructions) is byte-identical for everyone;\n    # on its own it is under Sonnet 4.5's 1024-token cache minimum with only the core tools, so its\n    # marker only pays off when extra tool groups are attached. Segment 2 (profile, date, fact snapshot)\n    # is what keeps the whole prefix cacheable. New facts go in the unmarked tail, so a save_fact\n    # never changes a cached byte.\n    system = [{\"type\": \"text\", \"text\": INSTRUCTIONS, \"cache_control\": {\"type\": \"ephemeral\"}},\n              {\"type\": \"text\", \"text\": athlete_context(a, today), \"cache_control\": {\"type\": \"ephemeral\"}}]\n    tail = recent_facts(a)\n    if tail:\n        system.append({\"type\": \"text\", \"text\": tail})\n    return system\n\n'''\ns = s.replace(old_ctx, new_ctx)\n\ns = s.replace('''def build_request(a, messages, tools, today):\n    return {\"model\": MODEL, \"max_tokens\": MAX_TOKENS, \"system\": build_system(a, today), \"tools\": tools, \"messages\": messages}\n''', '''def build_request(system, messages, tools):\n    return {\"model\": MODEL, \"max_tokens\": MAX_TOKENS, \"system\": system, \"tools\": tools, \"messages\": messages}\n''')\n\ns = s.replace('''    today = dt.date.today