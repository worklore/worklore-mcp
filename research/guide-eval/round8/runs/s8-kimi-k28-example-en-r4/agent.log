stem blocks, both cache-marked\\nfor r in requests:\\n    assert len(r[\\\"system\\\"]) == 2\\n    assert all(b[\\\"cache_control\\\"] == {\\\"type\\\": \\\"ephemeral\\\"} for b in r[\\\"system\\\"])\\n\\n# 2. static block byte-identical across every call, even after save_fact\\nblock0 = {json.dumps(r[\\\"system\\\"][0], sort_keys=True) for r in requests}\\nassert len(block0) == 1, \\\"static block changed across calls\\\"\\nassert requests[0][\\\"system\\\"][0][\\\"text\\\"] == bot.INSTRUCTIONS\\n\\n# 3. tail: changed by the memory write, byte-identical on the follow-up message\\nassert requests[0][\\\"system\\\"][1][\\\"text\\\"] != requests[1][\\\"system\\\"][1][\\\"text\\\"]\\nassert requests[1][\\\"system\\\"][1][\\\"text\\\"] == requests[2][\\\"system\\\"][1][\\\"text\\\"]\\n\\n# 4. tools byte-stable across rounds\\nt = {json.dumps(r[\\\"tools\\\"], sort_keys=True) for r in requests}\\nassert len(t) == 1\\n\\n# 5. no duplicate fact saved\\nassert bot.load_athlete(\\\"999\\\").facts == [\\\"prefers morning runs\\\"]\\n\\nprint(f\\\"calls: {len(requests)}\\\")\\nprint(f\\\"static block: {len(bot.INSTRUCTIONS)} chars, identical across all calls\\\")\\nprint(f\\\"tail sizes: {[len(r['system'][1]['text']) for r in requests]} chars\\\")\\nprint(\\\"round 1 tail:\\\", json.dumps(requests[0]['system'][1]['text']))\\nprint(\\\"round 2 tail:\\\", json.dumps(requests[1]['system'][1]['text']))\\nprint(\\\"ALL CHECKS PASSED\\\")\\nEOF\"}"}}]}
