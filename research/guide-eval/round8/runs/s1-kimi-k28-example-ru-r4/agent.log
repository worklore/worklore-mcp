{"role":"assistant","tool_calls":[{"type":"function","id":"tool_3OOUOVGeziziWd5KAY7iZkR4","function":{"name":"Edit","arguments":"{\"path\":\"gen.py\",\"old_string\":\"def hr_target(step):\\n    \\\"\\\"\\\"HR corridor for a step, as a percentage of the athlete's LTHR.\\\"\\\"\\\"\\n    lo, hi = step[\\\"hr_pct\\\"]\\n    return {\\\"units\\\": \\\"%lthr\\\", \\\"value\\\": lo, \\\"end\\\": hi}\",\"new_string\":\"def hr_target(step):\\n    \\\"\\\"\\\"Instant-HR corridor (% of LTHR). The lower bound must be `start`,\\n    not `value`: {value, end} exports to FIT as a lap/zone-mapped target\\n    and the watch clamps it to its own zones, while {start, end} stays a\\n    raw bpm corridor computed from Intervals' LTHR.\\\"\\\"\\\"\\n    lo, hi = step[\\\"hr_pct\\\"]\\n    return {\\\"units\\\": \\\"%lthr\\\", \\\"start\\\": lo, \\\"end\\\": hi}\"}"}}]}
