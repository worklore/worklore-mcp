n+\n+        for story in stories:\n+            response = app.handler({\"body\": json.dumps(story)}, table)\n+            self.assertEqual(response[\"statusCode\"], 201)\n+\n+        self.assertEqual(table.scan()[\"Count\"], 3)\n+        second = table.get_item(Key={\"slug\": \"second-story\"})[\"Item\"]\n+        third = table.get_item(Key={\"slug\": \"third-story\"})[\"Item\"]\n+        self.assertEqual(second[\"similar\"][0][\"slug\"], \"first-story\")\n+        self.assertEqual(second[\"similar\"][0][\"score\"], Decimal(\"0.85\"))\n+        for item in (second, third):\n+            self.assertTrue(all(isinstance(entry[\"score\"], Decimal) for entry in item[\"similar\"]))\n+\n \n if __name__ == \"__main__\":\n     unittest.main()\n M src/app.py\n M tests/test_publish.py\n?? ANSWER.md\n","exit_code":0,"status":"completed"}}
