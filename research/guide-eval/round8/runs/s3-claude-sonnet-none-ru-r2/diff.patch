@@ -15,12 +15,13 @@ Do not modify any file."
 
 cd "$REPO" || { "$NOTIFY" "nightly review: repo missing"; exit 1; }
 
-claude -p "$PROMPT" --output-format text > "$OUT"
-status=$?
+ERR="${OUT%.md}.err"
+claude -p "$PROMPT" --output-format text > "$OUT" 2> "$ERR"
+rc=$?   # not "status": it is a read-only special parameter in zsh
 
-if [ $status -ne 0 ]; then
-  "$NOTIFY" "nightly review FAILED (exit $status), see $OUT"
-  exit $status
+if [ $rc -ne 0 ]; then
+  "$NOTIFY" "nightly review FAILED (exit $rc): $(head -c 200 "$ERR") (see $OUT)"
+  exit $rc
 fi
 
 "$NOTIFY" "nightly review done: $(head -c 300 "$OUT")"
