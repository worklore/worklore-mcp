diff --git a/bin/nightly-review.zsh b/bin/nightly-review.zsh
index e0b986f..903f73d 100755
--- a/bin/nightly-review.zsh
+++ b/bin/nightly-review.zsh
@@ -15,12 +15,20 @@ Do not modify any file."
 
 cd "$REPO" || { "$NOTIFY" "nightly review: repo missing"; exit 1; }
 
-claude -p "$PROMPT" --output-format text > "$OUT"
-status=$?
+START=$SECONDS
+claude -p "$PROMPT" --output-format text < /dev/null > "$OUT"
+rc=$?
+DUR=$((SECONDS - START))
 
-if [ $status -ne 0 ]; then
-  "$NOTIFY" "nightly review FAILED (exit $status), see $OUT"
-  exit $status
+if [ $rc -ne 0 ]; then
+  "$NOTIFY" "nightly review FAILED (exit $rc, ${DUR}s), see $OUT" || echo "notify failed" >&2
+  exit $rc
 fi
 
-"$NOTIFY" "nightly review done: $(head -c 300 "$OUT")"
+# exit 0 is not proof of work: require non-empty output
+if [ ! -s "$OUT" ]; then
+  "$NOTIFY" "nightly review produced EMPTY output (${DUR}s)" || echo "notify failed" >&2
+  exit 1
+fi
+
+"$NOTIFY" "nightly review done (${DUR}s): $(head -c 300 "$OUT")"
