 log = logging.getLogger("stories")
 
@@ -40,6 +42,27 @@ def related(story, existing):
     return scored[:TOP_N]
 
 
+def to_dynamo(value):
+    """Make ``value`` storable by boto3: DynamoDB has no float type.
+
+    Every float anywhere in the item (scores, averages, anything computed later)
+    becomes a Decimal built from its shortest repr, so 0.4567 stays 0.4567.
+    Applied to the whole item right before ``put_item`` so new computed fields
+    can't reintroduce the bug.
+    """
+    if isinstance(value, bool):
+        return value
+    if isinstance(value, float):
+        if not math.isfinite(value):
+            raise ValueError(f"non-finite number cannot be stored: {value!r}")
+        return Decimal(repr(value))
+    if isinstance(value, dict):
+        return {k: to_dynamo(v) for k, v in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [to_dynamo(v) for v in value]
+    return value
+
+
 def validate(story):
     for k in ("slug", "title", "body"):
         if not story.get(k):
@@ -60,6 +83,7 @@ def publish(table, story):
         "published_at": int(time.time()),
         "similar": related(story, existing),
     }
+    item = to_dynamo(item)
     table.put_item(Item=item)
     log.info("publish slug=%s similar=%d stored", item["slug"], len(item["similar"]))
     return item
