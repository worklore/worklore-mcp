{"role":"tool","tool_call_id":"tool_IvL93K7E8yxzoSr7ReMWQyun","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"Build an Intervals.icu event body (workout_doc) from a plan file.\n3\t\n4\tUsage: python3 gen.py plans/tempo-run.json > event.json\n5\t\"\"\"\n6\timport json\n7\timport sys\n8\t\n9\t\n10\tdef hr_target(step, lthr):\n11\t    \"\"\"HR corridor for a step, converted to absolute bpm.\"\"\"\n12\t    lo, hi = step[\"hr_pct\"]\n13\t    return {\n14\t        \"units\": \"bpm\",\n15\t        \"value\": round(lo * lthr / 100),\n16\t        \"end\": round(hi * lthr / 100),\n17\t    }\n18\t\n19\t\n20\tdef build_step(step, lthr):\n21\t    out = {\"duration\": step[\"minutes\"] * 60}\n22\t    if \"hr_pct\" in step:\n23\t        out[\"hr\"] = hr_target(step, lthr)\n24\t    if \"label\" in step:\n25\t        out[\"text\"] = step[\"label\"]\n26\t    return out\n27\t\n28\t\n29\tdef build_doc(plan):\n30\t    steps = []\n31\t    for block in plan[\"steps\"]:\n32\t        if \"repeat\" in block:\n33\t            steps.append({\n34\t                \"reps\": block[\"repeat\"],\n35\t                \"steps\": [build_step(s) for s in block[\"steps\"]],\n36\t            })\n37\t        else:\n38\t            steps.append(build_step(block))\n39\t    return {\"steps\": steps}\n40\t\n41\t\n42\tdef build_event(plan):\n43\t    return {\n44\t        \"category\": \"WORKOUT\",\n45\t        \"type\": plan[\"sport\"],\n46\t        \"name\": plan[\"name\"],\n47\t        \"start_date_local\": plan[\"date\"] + \"T00:00:00\",\n48\t        \"workout_doc\": build_doc(plan),\n49\t    }\n50\t\n51\t\n52\tif __name__ == \"__main__\":\n53\t    with open(sys.argv[1]) as f:\n54\t        plan = json.load(f)\n55\t    json.dump(build_event(plan), sys.stdout, indent=2)\n56\t    print()"}
