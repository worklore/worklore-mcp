diff --git a/README.md b/README.md
index 31b0941..82ae212 100644
--- a/README.md
+++ b/README.md
@@ -9,8 +9,9 @@ exports them to the athlete's Garmin watch through Garmin Connect.
 - `readback/` holds what the API returned for the last pushed event and
   notes on what the watch displayed.
 
-Athlete thresholds live in Intervals (LTHR 172 for this athlete). HR targets
-in plans are percentages of LTHR; Intervals converts them to bpm at export.
+HR targets in plans are percentages of the plan's `lthr`. The generator converts
+them to absolute bpm so Garmin receives the planned range instead of mapping it
+to the watch's HR zones.
 
 ```
 python3 gen.py plans/tempo-run.json > event.json
diff --git a/gen.py b/gen.py
index be0b3bc..34a2652 100755
--- a/gen.py
+++ b/gen.py
@@ -7,16 +7,20 @@ import json
 import sys
 
 
-def hr_target(step):
-    """HR corridor for a step, as a percentage of the athlete's LTHR."""
+def hr_target(step, lthr):
+    """HR corridor for a step, converted to absolute bpm."""
     lo, hi = step["hr_pct"]
-    return {"units": "%lthr", "value": lo, "end": hi}
+    return {
+        "units": "bpm",
+        "value": round(lo * lthr / 100),
+        "end": round(hi * lthr / 100),
+    }
 
 
-def build_step(step):
+def build_step(step, lthr):
     out = {"duration": step["minutes"] * 60}
     if "hr_pct" in step:
-        out["hr"] = hr_target(step)
+        out["hr"] = hr_target(step, lthr)
     if "label" in step:
         out["text"] = step["label"]
     return out
@@ -24,14 +28,15 @@ def build_step(step):
 
 def build_doc(plan):
     steps = []
+    lthr = plan["lthr"]
     for block in plan["steps"]:
         if "repeat" in block:
             steps.append({
                 "reps": block["repeat"],
-                "steps": [build_step(s) for s in block["steps"]],
+                "steps": [build_step(s, lthr) for s in block["steps"]],
             })
         else:
-            steps.append(build_step(block))
+            steps.append(build_step(block, lthr))
     return {"steps": steps}
 
 
