{"role":"tool","tool_call_id":"tool_MfXm7CUTDCH6Ds81Hf5vLOPR","content":"diff --git a/README.md b/README.md\nindex daa860b..20300ff 100644\n--- a/README.md\n+++ b/README.md\n@@ -3,8 +3,9 @@\n A small story library behind `POST /stories` (Lambda + DynamoDB table `stories`,\n partition key `slug`). `src/app.py` is the whole service: `handler()` parses\n the request and `publish()` stores the story together with its three most\n-similar existing stories (`similar: [{slug, score}]`), so the reader page can\n-show \"related\" without any query at read time. `logs/error.log` is the\n+similar existing stories (`similar: [{slug, score}]`, where `score` is an\n+integer percentage), so the reader page can show \"related\" without any query at\n+read time. `logs/error.log` is the\n production log from the first two publishes after the deploy.\n \n Tests use an in-memory table (`tests/fake_dynamo.py`) that validates items the\ndiff --git a/src/app.py b/src/app.py\nindex db49c5e..04fafb5 100644\n--- a/src/app.py\n+++ b/src/app.py\n@@ -22,12 +22,12 @@ def words(text):\n \n \n def similarity(a, b):\n-    \"\"\"Shared-tag ratio (Jaccard), blended with shared words of the two bodies.\"\"\"\n+    \"\"\"Blended shared-tag and shared-word similarity as an integer percentage.\"\"\"\n     ta, tb = set(a.get(\"tags\", [])), set(b.get(\"tags\", []))\n     tag_score = len(ta & tb) / len(ta | tb) if (ta | tb) else 0\n     wa, wb = words(a.get(\"body\")), words(b.get(\"body\"))\n     word_score = len(wa & wb) / len(wa | wb) if (wa | wb) else 0\n-    return round(0.7 * tag_score + 0.3 * word_score, 4)\n+    return round(100 * (0.7 * tag_score + 0.3 * word_score))\n \n \n def related(story, existing):\ndiff --git a/tests/test_publish.py b/tests/test_publish.py\nindex 6c9ac44..604c4d2 100644\n--- a/tests/test_publish.py\n+++ b/tests/test_publish.py\n@@ -1,3 +1,4 @@\n+import json\n import os\n import sys\n import unittest\n@@ -23,6 +24,29 @@ class PublishTest(unittest.TestCase):\n         self.assertEqual(table.get_item(Key={\"slug\": \"why-my-cron-ran-twice\"})[\"Item\"][\"title\"], \"Why my cron ran twice\")\n         self.assertEqual(table.scan()[\"Count\"], 1)\n \n+    def test_second_publish_stores_integer_similarity_score(self):\n+        table = FakeTable()\n+        app.publish(table, {\n+            \"slug\": \"existing-story\",\n+            \"title\": \"Existing story\",\n+            \"tags\": [\"cron\", \"linux\"],\n+            \"body\": \"Cron restarts can duplicate work.\",\n+        })\n+        story = {\n+            \"slug\": \"second-story\",\n+            \"title\": \"Second story\",\n+            \"tags\": [\"cron\", \"deployment\"],\n+            \"body\": \"Cron deployments can duplicate work.\",\n+        }\n+\n+        response = app.handler({\"body\": json.dumps(story)}, table)\n+\n+        self.assertEqual(response[\"statusCode\"], 201)\n+        stored = table.get_item(Key={\"slug\": \"second-story\"})[\"Item\"]\n+        self.assertEqual(stored[\"similar\"], [{\"slug\": \"existing-story\", \"score\": 43}])\n+        self.assertIsInstance(stored[\"similar\"][0][\"score\"], int)\n+        self.assertEqual(table.scan()[\"Count\"], 2)\n+\n \n if __name__ == \"__main__\":\n     unittest.main()\n"}
