hi}% LTHR'\n \n \n-def build_doc(plan):\n-    steps = []\n+def build_description(plan):\n+    blocks = []\n     for block in plan[\"steps\"]:\n         if \"repeat\" in block:\n-            steps.append({\n-                \"reps\": block[\"repeat\"],\n-                \"steps\": [build_step(s) for s in block[\"steps\"]],\n-            })\n+            blocks.append(\"\\n\".join(\n+                [f'{block[\"repeat\"]}x'] + [build_step(s) for s in block[\"steps\"]]\n+            ))\n         else:\n-            steps.append(build_step(block))\n-    return {\"steps\": steps}\n+            blocks.append(build_step(block))\n+    return \"\\n\\n\".join(blocks)\n \n \n def build_event(plan):\n@@ -41,7 +32,7 @@ def build_event(plan):\n         \"type\": plan[\"sport\"],\n         \"name\": plan[\"name\"],\n         \"start_date_local\": plan[\"date\"] + \"T00:00:00\",\n-        \"workout_doc\": build_doc(plan),\n+        \"description\": build_description(plan),\n     }\n \n \n{\n  \"category\": \"WORKOUT\",\n  \"type\": \"Run\",\n  \"name\": \"Tempo run 45\",\n  \"start_date_local\": \"2026-10-20T00:00:00\",\n  \"description\": \"- Warm-up easy 10m 68-75% LTHR\\n\\n3x\\n- Tempo 8m 88-93% LTHR\\n- Float 2m 75-82% LTHR\\n\\n- Cool-down 5m 65-72% LTHR\"\n}\n","exit_code":0,"status":"completed"}}
