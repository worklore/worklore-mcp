ody\": \"shared body\",\n+        }\n+\n+        first_response = app.handler({\"body\": json.dumps(story)}, table)\n+        second_response = app.handler(\n+            {\"body\": json.dumps({**story, \"slug\": \"second-story\"})}, table\n+        )\n+\n+        self.assertEqual(first_response[\"statusCode\"], 201)\n+        self.assertEqual(second_response[\"statusCode\"], 201)\n+        self.assertEqual(table.scan()[\"Count\"], 2)\n+        stored = table.get_item(Key={\"slug\": \"second-story\"})[\"Item\"]\n+        self.assertEqual(\n+            stored[\"similar\"],\n+            [{\"slug\": \"first-story\", \"score\": Decimal(\"1.0000\")}],\n+        )\n+\n \n if __name__ == \"__main__\":\n     unittest.main()\n"}
