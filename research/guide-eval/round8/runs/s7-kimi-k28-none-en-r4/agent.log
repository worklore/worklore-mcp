{"role":"assistant","content":"Now the token-expiry fix in `store_connection` and `refresh_tokens`, and removing the fabricated TTL.","tool_calls":[{"type":"function","id":"tool_QKYUcc7v4SYiwMOl4elEq2Ap","function":{"name":"Edit","arguments":"{\"path\":\"server.py\",\"old_string\":\"def store_connection(user_id, tok):\\n    expires_in = int(tok.get(\\\"expires_in\\\") or DEFAULT_TOKEN_TTL)\\n    refresh = tok.get(\\\"refresh_token\\\")\\n    if not refresh:\\n        log(f\\\"{user_id}: no refresh_token in response, scheduling expiry in {expires_in}s\\\")\\n    athlete = tok.get(\\\"athlete\\\") or {}\\n    with LOCK:\\n        CONNECTIONS[user_id] = {\\n            \\\"athlete_id\\\": athlete.get(\\\"id\\\"), \\\"athlete_name\\\": athlete.get(\\\"name\\\"),\\n            \\\"access_token\\\": tok[\\\"access_token\\\"], \\\"refresh_token\\\": refresh,\\n            \\\"scope\\\": tok.get(\\\"scope\\\"), \\\"expires_at\\\": time.time() + expires_in, \\\"status\\\": \\\"connected\\\",\\n        }\\n    log(f\\\"{user_id}: connected as athlete {athlete.get('id')} (expires in {expires_in}s)\\\")\",\"new_string\":\"def store_connection(user_id, tok):\\n    # Intervals.icu sends no expires_in: its tokens live until the athlete\\n    # revokes access. Only an expiry the provider actually reports is honored.\\n    expires_in = tok.get(\\\"expires_in\\\")\\n    expires_at = time.time() + int(expires_in) if expires_in is not None else None\\n    refresh = tok.get(\\\"refresh_token\\\")\\n    if expires_in is None:\\n        log(f\\\"{user_id}: no expires_in in token response; token does not expire\\\")\\n    elif not refresh:\\n        log(f\\\"{user_id}: no refresh_token in response, scheduling expiry in {expires_in}s\\\")\\n    athlete = tok.get(\\\"athlete\\\") or {}\\n    with LOCK:\\n        CONNECTIONS[user_id] = {\\n            \\\"athlete_id\\\": athlete.get(\\\"id\\\"), \\\"athlete_name\\\": athlete.get(\\\"name\\\"),\\n            \\\"access_token\\\": tok[\\\"access_token\\\"], \\\"refresh_token\\\": refresh,\\n            \\\"scope\\\": tok.get(\\\"scope\\\"), \\\"expires_at\\\": expires_at, \\\"status\\\": \\\"connected\\\",\\n        }\\n    log(f\\\"{user_id}: connected as athlete {athlete.get('id')}\\\")\"}"}}]}
