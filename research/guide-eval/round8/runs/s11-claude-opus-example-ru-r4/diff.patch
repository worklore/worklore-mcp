+from decimal import Decimal
 
 log = logging.getLogger("stories")
 
@@ -40,6 +41,22 @@ def related(story, existing):
     return scored[:TOP_N]
 
 
+def to_dynamo(value):
+    """Make ``value`` storable by boto3: floats become Decimal, recursively.
+
+    DynamoDB numbers must be int or Decimal; boto3 rejects any float. Going
+    through ``str`` keeps the value exactly as Python prints it (0.4567, not
+    0.45669999999999999...).
+    """
+    if isinstance(value, float):
+        return Decimal(str(value))
+    if isinstance(value, dict):
+        return {k: to_dynamo(v) for k, v in value.items()}
+    if isinstance(value, list):
+        return [to_dynamo(v) for v in value]
+    return value
+
+
 def validate(story):
     for k in ("slug", "title", "body"):
         if not story.get(k):
@@ -60,6 +77,7 @@ def publish(table, story):
         "published_at": int(time.time()),
         "similar": related(story, existing),
     }
+    item = to_dynamo(item)
     table.put_item(Item=item)
     log.info("publish slug=%s similar=%d stored", item["slug"], len(item["similar"]))
     return item
