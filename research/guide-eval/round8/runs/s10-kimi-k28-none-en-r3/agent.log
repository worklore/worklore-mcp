{"role":"tool","tool_call_id":"tool_887rpQNs4FioXoB8XCwoKYPF","content":"1\timport 'package:flutter/material.dart';\n2\t\n3\timport '../analytics.dart';\n4\t\n5\tclass RegistrationScreen extends StatefulWidget {\n6\t  const RegistrationScreen({super.key});\n7\t\n8\t  @override\n9\t  State<RegistrationScreen> createState() => _RegistrationScreenState();\n10\t}\n11\t\n12\tclass _RegistrationScreenState extends State<RegistrationScreen> {\n13\t  final _email = TextEditingController();\n14\t  final _phone = TextEditingController();\n15\t  double _amount = 50000;\n16\t  bool _terms = false;\n17\t  bool _emailStarted = false;\n18\t  bool _phoneStarted = false;\n19\t\n20\t  void _onEmailChanged(String value) {\n21\t    if (!_emailStarted && value.isNotEmpty) {\n22\t      _emailStarted = true;\n23\t      Analytics.capture('registration_email_started');\n24\t    }\n25\t    setState(() {});\n26\t  }\n27\t\n28\t  void _onPhoneChanged(String value) {\n29\t    if (!_phoneStarted && value.isNotEmpty) {\n30\t      _phoneStarted = true;\n31\t      Analytics.capture('registration_phone_started');\n32\t    }\n33\t    setState(() {});\n34\t  }\n35\t\n36\t  @override\n37\t  void dispose() {\n38\t    _email.dispose();\n39\t    _phone.dispose();\n40\t    super.dispose();\n41\t  }\n42\t\n43\t  bool get _canContinue =>\n44\t      _terms && _email.text.contains('@') && _phone.text.length >= 10;\n45\t\n46\t  @override\n47\t  Widget build(BuildContext context) {\n48\t    return Scaffold(\n49\t      appBar: AppBar(title: const Text('Register')),\n50\t      body: Padding(\n51\t        padding: const EdgeInsets.all(16),\n52\t        child: Column(\n53\t          crossAxisAlignment: CrossAxisAlignment.stretch,\n54\t          children: [\n55\t            TextField(\n56\t              controller: _email,\n57\t              keyboardType: TextInputType.emailAddress,\n58\t              decoration: const InputDecoration(labelText: 'Email'),\n59\t              onChanged: _onEmailChanged,\n60\t            ),\n61\t            const SizedBox(height: 12),\n62\t            TextField(\n63\t              controller: _phone,\n64\t              keyboardType: TextInputType.phone,\n65\t              decoration: const InputDecoration(labelText: 'Phone'),\n66\t              onChanged: _onPhoneChanged,\n67\t            ),\n68\t            const SizedBox(height: 24),\n69\t            Text('Loan amount: ${_amount.round()}'),\n70\t            Slider(\n71\t              min: 10000,\n72\t              max: 500000,\n73\t              divisions: 49,\n74\t              value: _amount,\n75\t              label: _amount.round().toString(),\n76\t              onChanged: (v) => setState(() => _amount = v),\n77\t              onChangeEnd: (v) =>\n78\t                  Analytics.capture('loan_amount_changed', {'amount': v.round()}),\n79\t            ),\n80\t            CheckboxListTile(\n81\t              value: _terms,\n82\t              title: const Text('I accept the terms and conditions'),\n83\t              controlAffinity: ListTileControlAffinity.leading,\n84\t              onChanged: (v) {\n85\t                setState(() => _terms = v ?? false);\n86\t                if (v ?? false) Analytics.capture('terms_accepted');\n87\t              },\n88\t            ),\n89\t            const Spacer(),\n90\t            FilledButton(\n91\t              onPressed: _canContinue\n92\t                  ? () {\n93\t                      Analytics.capture('registration_continue_tapped', {\n94\t                        'amount': _amount.round(),\n95\t                        'terms': _terms,\n96\t                      });\n97\t                      Navigator.of(context).pushNamed('/offers');\n98\t                    }\n99\t                  : null,\n100\t              child: const Text('Continue'),\n101\t            ),\n102\t          ],\n103\t        ),\n104\t      ),\n105\t    );\n106\t  }\n107\t}"}
{"role":"tool","tool_call_id":"tool_dLX7afI0J4ExVal1Jf3SF4xx","content":"1\timport 'package:flutter/material.dart';\n2\t\n3\timport '../analytics.dart';\n4\t\n5\tclass Offer {\n6\t  const Offer(this.bank, this.months, this.rate);\n7\t  final String bank;\n8\t  final int months;\n9\t  final double rate;\n10\t}\n11\t\n12\tconst _offers = [\n13\t  Offer('Norbank', 12, 9.9),\n14\t  Offer('Norbank', 24, 10.4),\n15\t  Offer('Fjordcredit', 12, 8.7),\n16\t  Offer('Fjordcredit', 36, 11.2),\n17\t  Offer('Vestkapital', 24, 9.5),\n18\t  Offer('Vestkapital', 48, 12.0),\n19\t  Offer('Sparbank', 12, 10.9),\n20\t  Offer('Sparbank', 60, 12.8),\n21\t  Offer('Nordlån', 36, 10.1),\n22\t  Offer('Nordlån', 60, 12.3),\n23\t];\n24\t\n25\tclass OfferScreen extends StatefulWidget {\n26\t  const OfferScreen({super.key});\n27\t\n28\t  @override\n29\t  State<OfferScreen> createState() => _OfferScreenState();\n30\t}\n31\t\n32\tclass _OfferScreenState extends State<OfferScreen> {\n33\t  final _scroll = ScrollController();\n34\t  bool _scrolled = false;\n35\t\n36\t  @override\n37\t  void initState() {\n38\t    super.initState();\n39\t    _scroll.addListener(() {\n40\t      final offset = _scroll.offset;\n41\t      if (!_scrolled && offset > 0) {\n42\t        _scrolled = true;\n43\t        Analytics.capture('offers_scrolled', {'offset': offset});\n44\t      }\n45\t    });\n46\t  }\n47\t\n48\t  @override\n49\t  void dispose() {\n50\t    _scroll.dispose();\n51\t    super.dispose();\n52\t  }\n53\t\n54\t  @override\n55\t  Widget build(BuildContext context) {\n56\t    return Scaffold(\n57\t      appBar: AppBar(title: const Text('Offers')),\n58\t      body: ListView.builder(\n59\t        controller: _scroll,\n60\t        itemCount: _offers.length,\n61\t        itemBuilder: (context, i) {\n62\t          final o = _offers[i];\n63\t          return ListTile(\n64\t            leading: const Icon(Icons.account_balance),\n65\t            title: Text('${o.bank}, ${o.months} months'),\n66\t            subtitle: Text('${o.rate.toStringAsFixed(1)}% APR'),\n67\t            trailing: const Icon(Icons.chevron_right),\n68\t            onTap: () {},\n69\t          );\n70\t        },\n71\t      ),\n72\t    );\n73\t  }\n74\t}"}
