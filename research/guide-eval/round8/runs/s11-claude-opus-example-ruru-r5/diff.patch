 log = logging.getLogger("stories")
 
@@ -40,6 +42,28 @@ def related(story, existing):
     return scored[:TOP_N]
 
 
+def to_dynamo(value):
+    """Make ``value`` storable by boto3: every float becomes a Decimal.
+
+    boto3's TypeSerializer rejects Python floats, and any computed number
+    (a division, an average, ``round(x, n)``) is a float. Converting at the
+    put_item boundary covers every attribute, including ones added later.
+    """
+    if isinstance(value, bool):
+        return value
+    if isinstance(value, float):
+        if not math.isfinite(value):
+            raise ValueError(f"non-finite number cannot be stored: {value!r}")
+        return Decimal(str(value))
+    if isinstance(value, dict):
+        return {k: to_dynamo(v) for k, v in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [to_dynamo(v) for v in value]
+    if isinstance(value, (set, frozenset)):
+        return {to_dynamo(v) for v in value}
+    return value
+
+
 def validate(story):
     for k in ("slug", "title", "body"):
         if not story.get(k):
@@ -60,6 +84,7 @@ def publish(table, story):
         "published_at": int(time.time()),
         "similar": related(story, existing),
     }
+    item = to_dynamo(item)
     table.put_item(Item=item)
     log.info("publish slug=%s similar=%d stored", item["slug"], len(item["similar"]))
     return item
