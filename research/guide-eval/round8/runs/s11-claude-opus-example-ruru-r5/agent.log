keTable  # noqa: E402"," ","+CRON = {","+    \"slug\": \"why-my-cron-ran-twice\",","+    \"title\": \"Why my cron ran twice\",","+    \"tags\": [\"cron\", \"linux\"],","+    \"body\": \"Two crontabs, one for root and one for me, both had the line.\",","+}","+TIMER = {","+    \"slug\": \"systemd-timer-instead-of-cron\",","+    \"title\": \"A systemd timer instead of cron\",","+    \"tags\": [\"cron\", \"systemd\", \"linux\"],","+    \"body\": \"I replaced the line in my crontab with a timer unit.\",","+}","+THIRD = {","+    \"slug\": \"logrotate-ate-my-logs\",","+    \"title\": \"Logrotate ate my logs\",","+    \"tags\": [\"linux\", \"logs\"],","+    \"body\": \"The cron job for logrotate ran with the wrong config.\",","+}","+","+","+def seeded_table(*stories):","+    \"\"\"Table that already holds ``stories`` — the path production takes on every publish but the first.\"\"\"","+    table = FakeTable()","+    for s in stories:","+        app.publish(table, s)","+    return table","+"," "," class PublishTest(unittest.TestCase):","-    def test_publish_stores_story(self):","+    def test_publish_into_empty_table(self):","         table = FakeTable()","-        story = {","-            \"slug\": \"why-my-cron-ran-twice\",","-            \"title\": \"Why my cron ran twice\",","-            \"tags\": [\"cron\", \"linux\"],","-            \"body\": \"Two crontabs, one for root and one for me, both had the line.\",","-        }","-        stored = app.publish(table, story)","+        stored = app.publish(table, CRON)","         self.assertEqual(stored[\"slug\"], \"why-my-cron-ran-twice\")","-        self.assertEqual(table.get_item(Key={\"slug\": \"why-my-cron-ran-twice\"})[\"Item\"][\"title\"], \"Why my cron ran twice\")","+        self.assertEqual(stored[\"similar\"], [])","+        self.assertEqual(table.get_item(Key={\"slug\": CRON[\"slug\"]})[\"Item\"][\"title\"], \"Why my cron ran twice\")","         self.assertEqual(table.scan()[\"Count\"], 1)"," ","+    def test_publish_into_seeded_table_stores_scores(self):","+        # Regression for logs/error.log: the second publish computed a float score and put_item rejected it.","+        table = seeded_table(CRON)","+        stored = app.publish(table, TIMER)","+        self.assertEqual(table.scan()[\"Count\"], 2)","+        item = table.get_item(Key={\"slug\": TIMER[\"slug\"]})[\"Item\"]","+        self.assertEqual([s[\"slug\"] for s in item[\"similar\"]], [CRON[\"slug\"]])","+        score = item[\"similar\"][0][\"score\"]","+        self.assertIsInstance(score, Decimal)","+        self.assertGreater(score, 0)","+        self.assertLessEqual(score, 1)","+        self.assertEqual(stored[\"similar\"][0][\"score\"], score)","+","+    def test_publish_third_story_ranks_related(self):","+        table = seeded_table(CRON, TIMER)","+        app.publish(table, THIRD)","+        similar = table.get_item(Key={\"slug\": THIRD[\"slug\"]})[\"Item\"][\"similar\"]","+        self.assertEqual(len(similar), 2)","+        self.assertGreaterEqual(similar[0][\"score\"], similar[1][\"score\"])","+","+    def test_republish_same_slug_excludes_itself(self):","+        table = seeded_table(CRON, TIMER)","+        app.publish(table, CRON)","+        similar = table.get_item(Key={\"slug\": CRON[\"slug\"]})[\"Item\"][\"similar\"]","+        self.assertEqual([s[\"slug\"] for s in similar], [TIMER[\"slug\"]])","+","+    def test_handler_twice_returns_201_both_times(self):","+        table = FakeTable()","+        for story in (CRON, TIMER):","+            resp = app.handler({\"body\": json.dumps(story)}, table)","+            self.assertEqual(resp[\"statusCode\"], 201, resp)","+","+","+class ToDynamoTest(unittest.TestCase):","+    def test_floats_become_decimals_at_any_depth(self):","+        out = app.to_dynamo({\"a\": 0.1, \"b\": [{\"c\": 0.4667}], \"d\": 3, \"e\": True, \"f\": \"x\"})","+        self.assertEqual(out, {\"a\": Decimal(\"0.1\"), \"b\": [{\"c\": Decimal(\"0.4667\")}], \"d\": 3, \"e\": True, \"f\": \"x\"})","+        self.assertIs(out[\"e\"], True)","+","+    def test_non_finite_rejected(self):","+        with self.assertRaises(ValueError):","+            app.to_dynamo({\"x\": float(\"nan\")})","+"," "," if __name__ == \"__main__\":","     unittest.main()"]}]}],"moreFiles":0,"changedFiles":["/private/tmp/h-PHYj1R/src/app.py","/private/tmp/h-PHYj1R/tests/fake_dynamo.py","/private/tmp/h-PHYj1R/tests/test_publish.py"]}},"tool_result_meta":[{"id":"toolu_01PuribPsDWVjvDAUMAfXBRd","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgSE2rsMWTWKRdKtAVVcV","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3660,"cache_read_input_tokens":24802,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3660},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"a7a2a58f-e4e1-4412-b0d4-72fbfc23e1c8","uuid":"6a0c9b06-ec77-4971-b00b-2bb1999c5f34","timestamp":"2026-10-27T05:55:40.272Z","request_id":"req_011CgSE2rPq7UgDkDWWE9GJ6","thinking_duration_ms":835,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgSE2rsMWTWKRdKtAVVcV","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_013GCz1tVRtC2B4fy5RnCMtM","name":"Bash","input":{"command":"cat > ANSWER.md <<'EOF'\n# Почему вторая публикация возвращает 500\n\n## Причина\n\n`publish()` (`src/app.py`) перед записью сканирует таблицу и для каждой уже\nсуществующей истории считает `similarity()`. Результат — `round(0.7 * tag_score + 0.3 * word_score, 4)`,\nто есть питоновский **float**. Он кладётся в `item[\"similar\"][i][\"score\"]`,\nи `table.put_item` падает в сериализаторе boto3:\n\n```\nTypeError: Float types are not supported. Use Decimal types instead.\n```\n\n(`logs/error.log`, app.py:63 → `boto3/dynamodb/types.py`). `handler` ловит это как\nобычное `Exception` и отдаёт 500.\n\nПервая публикация прошла, потому что таблица была пуста: `existing == []`,\n`similar == []`, ни одного float в записи (в логе `similar=0 stored`). Начиная со\nвторой публикации есть с чем сравнивать — появляется оценка, появляется float,\nи падает каждая следующая публикация (в логе две 500 подряд).\n\nСуществующий тест этого не ловил, потому что публиковал одну историю в пустую\n`FakeTable`, т.е. проверял только путь, который в продакшене выполняется один раз.\n\n## Исправление\n\n1. **`to_dynamo()` на границе с DynamoDB** (`src/app.py`). Рекурсивно обходит\n   запись и превращает каждый `float` в `Decimal(str(x))` (так `0.4667` хранится\n   как `0.4667`, без двоичного хвоста); NaN/∞ отклоняются как `ValueError`, потому\n   что DynamoDB их тоже не принимает. `publish()` вызывает её прямо перед\n   `put_item`. Поэтому ошибка не вернётся, даже если кто-то потом добавит в\n   запись ещё одно вычисляемое поле: конвертация стоит на выходе, а не в\n   конкретной формуле.\n   Формат `score` я не менял: это всё ещё доля 0..1 с 4 знаками, только тип\n   теперь Decimal. Тем, кто читает `similar`, ничего менять не надо.\n2. **Фейковая таблица стала ближе к настоящей** (`tests/fake_dynamo.py`):\n   `get_item`/`scan` возвращают числа как `Decimal`, как это делает настоящий\n   boto3. Тогда при повторной публикации тест работает с тем же видом данных,\n   что и в продакшене.\n3. **Тесты пути с заполненной таблицей** (`tests/test_publish.py`): хелпер\n   `seeded_table()`; публикация второй и третьей истории (score хранится как\n   Decimal в диапазоне (0, 1], ранжирование по убыванию); повторная публикация\n   того же slug (история не попадает в похожие сама на себя); `handler` дважды\n   подряд → 201 оба раза (точное повторение инцидента); юнит-тесты `to_dynamo`.\n   Старый `app.py` на этих тестах падает, исправленный проходит:\n   `python3 -m unittest discover tests` → 7 OK.\n\nНичего не деплоил и в реальную таблицу не писал.\n\n## Что пригодилось из заметки коллеги\n\n- **Пригодилось:** сам диагноз (float от вычисляемой оценки похожести; первая\n  запись выживает, потому что пустая таблица = нет оценок) совпал с нашим случаем\n  один в один. Ещё пригодились совет «конвертировать на границе» и правило «каждый\n  тест записи сначала сажает запись» — это `seeded_table()` и тест на две\n  публикации через `handler`. Совет поискать `round(` и `/`, которые попадают в\n  запись, тоже сработал: нашлись ровно `similarity()` (`round` и два деления);\n  `published_at` уже `int(...)`.\n- **Не стал брать:** перевод оценок в целые проценты. Это меняет смысл\n  поля (0.42 → 42) для читателей `similar`, а Decimal решает проблему без\n  этого. Конвертация отдельно одного поля тоже не защищает от следующего float,\n  поэтому я поставил общую `to_dynamo()`.\n- **Не применимо здесь:** «опубликуйте дважды в реальную таблицу». По правилам\n  задачи ничего наружу не отправлял; вместо этого двойная публикация\n  проверяется через `handler` на фейковой таблице, которая валидирует типы так\n  же, как boto3. На реальном стенде это стоит проверить отдельно, перед деплоем.\nEOF"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3660,"cache_read_input_tokens":24802,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3660},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"a7a2a58f-e4e1-4412-b0d4-72fbfc23e1c8","uuid":"d5da80b2-a0be-4445-ac27-67218d965bd9","timestamp":"2026-10-27T05:55:56.238Z","request_id":"req_011CgSE2rPq7UgDkDWWE9GJ6","wire_tool_inputs":{"toolu_013GCz1tVRtC2B4fy5RnCMtM":{"command":"cd /private/tmp/h-PHYj1R && cat > ANSWER.md <<'EOF'\n# Почему вторая публикация возвращает 500\n\n## Причина\n\n`publish()` (`src/app.py`) перед записью сканирует таблицу и для каждой уже\nсуществующей истории считает `similarity()`. Результат — `round(0.7 * tag_score + 0.3 * word_score, 4)`,\nто есть питоновский **float**. Он кладётся в `item[\"similar\"][i][\"score\"]`,\nи `table.put_item` падает в сериализаторе boto3:\n\n```\nTypeError: Float types are not supported. Use Decimal types instead.\n```\n\n(`logs/error.log`, app.py:63 → `boto3/dynamodb/types.py`). `handler` ловит это как\nобычное `Exception` и отдаёт 500.\n\nПервая публикация прошла, потому что таблица была пуста: `existing == []`,\n`similar == []`, ни одного float в записи (в логе `similar=0 stored`). Начиная со\nвторой публикации есть с чем сравнивать — появляется оценка, появляется float,\nи падает каждая следующая публикация (в логе две 500 подряд).\n\nСуществующий тест этого не ловил, потому что публиковал одну историю в пустую\n`FakeTable`, т.е. проверял только путь, который в продакшене выполняется один раз.\n\n## Исправление\n\n1. **`to_dynamo()` на границе с DynamoDB** (`src/app.py`). Рекурсивно обходит\n   запись и превращает каждый `float` в `Decimal(str(x))` (так `0.4667` хранится\n   как `0.4667`, без двоичного хвоста); NaN/∞ отклоняются как `ValueError`, 