what it changes and whether anything looks risky\n(migrations, auth, payments, deleted tests).\nEnd with a three-line summary I can read on my phone.\nDo not modify any file.\"\n\ncd \"$REPO\" || { \"$NOTIFY\" \"nightly review: repo missing\"; exit 1; }\n\nclaude -p \"$PROMPT\" --output-format text > \"$OUT\"\nstatus=$?\n\nif [ $status -ne 0 ]; then\n  \"$NOTIFY\" \"nightly review FAILED (exit $status), see $OUT\"\n  exit $status\nfi\n\n\"$NOTIFY\" \"nightly review done: $(head -c 300 \"$OUT\")\"\n","structuredPatch":[{"oldStart":18,"oldLines":12,"newStart":18,"newLines":18,"lines":[" "," cd \"$REPO\" || { \"$NOTIFY\" \"nightly review: repo missing\"; exit 1; }"," ","-claude -p \"$PROMPT\" --output-format text > \"$OUT\"","-status=$?","+# zsh reserves `status` (read-only alias of $?), so use rc. Keep the failure","+# check directly after the agent call so nothing can sit between failure and report.","+START=$SECONDS","+claude -p \"$PROMPT\" --output-format text > \"$OUT\" 2> \"$ERR\" < /dev/null","+rc=$?","+ELAPSED=$(( SECONDS - START ))","+print -r -- \"$(date '+%F %T') rc=$rc seconds=$ELAPSED bytes=$(wc -c < \"$OUT\" | tr -d ' ')\" >> \"$RUNLOG\""," ","-if [ $status -ne 0 ]; then","-  \"$NOTIFY\" \"nightly review FAILED (exit $status), see $OUT\"","-  exit $status","+# An empty report is a failure too: exit 0 with nothing done must not look like success.","+if (( rc != 0 )) || [[ ! -s \"$OUT\" ]]; then","+  \"$NOTIFY\" \"nightly review FAILED (rc $rc, ${ELAPSED}s), see $ERR: $(tail -c 300 \"$ERR\")\" || exit 1","+  exit $(( rc ? rc : 1 ))"," fi"," ","-\"$NOTIFY\" \"nightly review done: $(head -c 300 \"$OUT\")\"","+\"$NOTIFY\" \"nightly review done (${ELAPSED}s): $(head -c 300 \"$OUT\")\" || exit 1"]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_01RJExuaKnkCQUYchCPTgEc9","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
