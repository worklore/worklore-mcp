{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JMrHmDDwDmjQtWcj8UsHcJ","type":"tool_result","content":"PASS auth/init with Bearer returns 200\nPASS auth/init without Bearer returns 401\nPASS authorize with new scopes is not a 400\nPASS callback redirects to /?connected=1\nPASS status is connected for T. Rivera\nPASS wellness 200 while connected\nPASS wellness passes Intervals 401 through\nPASS status is 'expired, reconnect' after Intervals 401\nPASS auth/init works after expiry\nPASS requested scopes have one entry per category\nFAILURES: 0\ndiff --git a/config.py b/config.py\nindex 54a8144..65c94e7 100644\n--- a/config.py\n+++ b/config.py\n@@ -1,13 +1,16 @@\n import os\n \n PORT = 8766\n-APP_SECRET = \"dev-only-change-me-7c1f0a\"          # signs the OAuth state parameter\n+# Signs the OAuth state parameter. Set the real value in the deploy env.\n+APP_SECRET = os.environ.get(\"TRICOACH_APP_SECRET\", \"dev-only-change-me-7c1f0a\")\n \n-# Intervals.icu OAuth client (placeholders; the real pair is in the deploy env)\n+# Intervals.icu OAuth client. The defaults are placeholders; the real pair comes from the deploy env.\n INTERVALS_BASE = os.environ.get(\"INTERVALS_BASE\", \"https://intervals.icu\")\n-CLIENT_ID = \"tricoach-dev\"\n-CLIENT_SECRET = \"s3cr3t-placeholder-0000\"\n+CLIENT_ID = os.environ.get(\"INTERVALS_CLIENT_ID\", \"tricoach-dev\")\n+CLIENT_SECRET = os.environ.get(\"INTERVALS_CLIENT_SECRET\", \"s3cr3t-placeholder-0000\")\n REDIRECT_URI = f\"http://localhost:{PORT}/api/intervals/callback\"\n-SCOPES = \"ACTIVITY:READ,ACTIVITY:WRITE,WELLNESS:READ,CALENDAR:READ,CALENDAR:WRITE\"\n+# One access level per category: WRITE already implies READ, and asking for\n+# both ACTIVITY:READ and ACTIVITY:WRITE (or both CALENDAR halves) is rejected.\n+SCOPES = \"ACTIVITY:WRITE,WELLNESS:READ,CALENDAR:WRITE\"\n \n REFRESH_INTERVAL = 60      # seconds between passes of the token refresher\ndiff --git a/static/app.js b/static/app.js\nindex 368922e..06afc97 100644\n--- a/static/app.js\n+++ b/static/app.js\n@@ -25,12 +25,23 @@ async function render() {\n     } else {\n       const why = st.status && st.status !== \"disconnected\" ? `<p class=\"muted\">Status: ${esc(st.status)}</p>` : \"\";\n       card = `<div class=\"card\">Intervals.icu is not connected.${why}\n-        <p><a class=\"btn\" href=\"/api/intervals/auth/init\">Connect Intervals.icu</a></p></div>`;\n+        <p><button class=\"btn\" id=\"connect\">Connect Intervals.icu</button></p></div>`;\n     }\n     root.className = \"\";\n     root.innerHTML = `<p>Signed in as <b>${esc(me.name)}</b>.</p>${card}`;\n     const d = document.getElementById(\"disconnect\");\n     if (d) d.onclick = async () => { await api(\"/api/intervals/disconnect\", { method: \"POST\" }); render(); };\n+    const c = document.getElementById(\"connect\");\n+    // A plain link cannot carry the Bearer header, so fetch the authorize URL\n+    // through api() and then send the browser there.\n+    if (c) c.onclick = async () => {\n+      try {\n+        const { url } = await api(\"/api/intervals/auth/init\");\n+        location.href = url;\n+      } catch (e) {\n+        root.innerHTML = `<p class=\"card\">Error: ${esc(e.message)}</p>`;\n+      }\n+    };\n   } catch (e) {\n     root.innerHTML = `<p class=\"card\">Error: ${esc(e.message)}</p>`;\n   }","is_error":false}]},"parent_tool_use_id":null,"session_id":"27cc2895-926f-4aac-974a-5a98998b128d","uuid":"85a39607-0987-4700-b12a-5549f623d795","timestamp":"2026-10-27T03:32:40.700Z","tool_use_result":{"stdout":"PASS auth/init with Bearer returns 200\nPASS auth/init without Bearer returns 401\nPASS authorize with new scopes is not a 400\nPASS callback redirects to /?connected=1\nPASS status is connected for T. Rivera\nPASS wellness 200 while connected\nPASS wellness passes Intervals 401 through\nPASS status is 'expired, reconnect' after Intervals 401\nPASS auth/init works after expiry\nPASS requested scopes have one entry per category\nFAILURES: 0\ndiff --git a/config.py b/config.py\nindex 54a8144..65c94e7 100644\n--- a/config.py\n+++ b/config.py\n@@ -1,13 +1,16 @@\n import os\n \n PORT = 8766\n-APP_SECRET = \"dev-only-change-me-7c1f0a\"          # signs the OAuth state parameter\n+# Signs the OAuth state parameter. Set the real value in the deploy env.\n+APP_SECRET = os.environ.get(\"TRICOACH_APP_SECRET\", \"dev-only-change-me-7c1f0a\")\n \n-# Intervals.icu OAuth client (placeholders; the real pair is in the deploy env)\n+# Intervals.icu OAuth client. The defaults are placeholders; the real pair comes from the deploy env.\n INTERVALS_BASE = os.environ.get(\"INTERVALS_BASE\", \"https://intervals.icu\")\n-CLIENT_ID = \"tricoach-dev\"\n-CLIENT_SECRET = \"s3cr3t-placeholder-0000\"\n+CLIENT_ID = os.environ.get(\"INTERVALS_CLIENT_ID\", \"tricoach-dev\")\n+CLIENT_SECRET = os.environ.get(\"INTERVALS_CLIENT_SECRET\", \"s3cr3t-placeholder-0000\")\n REDIRECT_URI = f\"http://localhost:{PORT}/api/intervals/callback\"\n-SCOPES = \"ACTIVITY:READ,ACTIVITY:WRITE,WELLNESS:READ,CALENDAR:READ,CALENDAR:WRITE\"\n+# One access level per category: WRITE already implies READ, and asking for\n+# both ACTIVITY:READ and ACTIVITY:WRITE (or both CALENDAR halves) is rejected.\n+SCOPES = \"ACTIVITY:WRITE,WELLNESS:READ,CALENDAR:WRITE\"\n \n REFRESH_INTERVAL = 60      # seconds between passes of the token refresher\ndiff --git a/static/app.js b/static/app.js\nindex 368922e..06afc97 100644\n--- a/static/app.js\n+++ b/static/app.js\n@@ -25,12 +25,23 @@ async function render() {\n     } else {\n       const why = st.status && st.status !== \"disconnected\" ? `<p class=\"muted\">Status: ${esc(st.status)}</p>` : \"\";\n       card = `<div class=\"card\">Intervals.icu is not connected.${why}\n-        <p><a class=\"btn\" href=\"/api/intervals/auth/init\">Connect Intervals.icu</a></p></div>`;\n+        <p><button class=\"btn\" id=\"connect\">Connect Intervals.icu</button></p></div>`;\n     }\n     root.className = \"\";\n     root.innerHTML = `<p>Signed in as <b>${esc(me.name)}</b>.</p>${card}`;\n     const d = document.getElementById(\"disconnect\");\n     if (d) d.onclick = async () => { await api(\"/api/intervals/disconnect\", { method: \"POST\" }); render(); };\n+    const c = document.getElementById(\"connect\");\n+    // A plain link cannot carry the Bearer header, so fetch the authorize URL\n+    // through api() and then send the browser there.\n+    if (c) c.onclick = async () => {\n+      try {\n+        const { url } = await api(\"/api/intervals/auth/init\");\n+        location.href = url;\n+      } catch (e) {\n+        root.innerHTML = `<p class=\"card\">Error: ${esc(e.message)}</p>`;\n+      }\n+    };\n   } catch (e) {\n     root.innerHTML = `<p class=\"card\">Error: ${esc(e.message)}</p>`;\n   }","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01JMrHmDDwDmjQtWcj8UsHcJ","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
