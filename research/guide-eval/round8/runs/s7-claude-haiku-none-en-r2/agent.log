nt cannot stall every request.\n        with LOCK:\n            due = [(uid, dict(c)) for uid, c in CONNECTIONS.items()\n                   if c[\"status\"] == \"connected\" and c[\"expires_at\"] is not None\n                   and c[\"expires_at\"] - now <= 300]\n        for uid, c in due:\n            if not c[\"refresh_token\"]:\n                mark_expired(uid, \"token expiry passed and no refresh token on file\")\n                continue\n            try:\n                tok = post_form(TOKEN_URL, {\n                    \"grant_type\": \"refresh_token\", \"refresh_token\": c[\"refresh_token\"],\n                    \"client_id\": config.CLIENT_ID, \"client_secret\": config.CLIENT_SECRET,\n                })\n            except Exception as e:\n                mark_expired(uid, f\"refresh failed ({e})\")\n                continue\n            with LOCK:\n                cur = CONNECTIONS.get(uid)\n                if cur is not None and cur[\"status\"] == \"connected\":\n                    cur.update(access_token=tok[\"access_token\"],\n                               refresh_token=tok.get(\"refresh_token\", cur[\"refresh_token\"]),\n                               expires_at=expiry_from(tok, time.time()))\n            log(f\"{uid}: token refreshed\")"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5633,"cache_read_input_tokens":38707,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5633},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"27cc2895-926f-4aac-974a-5a98998b128d","uuid":"c95e34b5-f4c0-4110-8fc0-7e8738ab08e7","timestamp":"2026-10-27T03:31:41.324Z","request_id":"req_011CgS33c3demssGGLS6XhTQ","wire_tool_inputs":{"toolu_015sw7nmaw5xjdJQv94JehSz":{"file_path":"/pri