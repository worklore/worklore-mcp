lText: 'Phone'),\n56\t              onChanged: (_) {\n57\t                if (!_phoneStartedFired) {\n58\t                  _phoneStartedFired = true;\n59\t                  Analytics.capture('registration_phone_started');\n60\t                }\n61\t                setState(() {});\n62\t              },\n63\t            ),\n64\t            const SizedBox(height: 24),\n65\t            Text('Loan amount: ${_amount.round()}'),\n66\t            Slider(\n67\t              min: 10000,\n68\t              max: 500000,\n69\t              divisions: 49,\n70\t              value: _amount,\n71\t              label: _amount.round().toString(),\n72\t              onChanged: (v) => setState(() => _amount = v),\n73\t              onChangeEnd: (v) =>\n74\t                  Analytics.capture('loan_amount_changed', {'amount': v.round()}),\n75\t            ),\n76\t            CheckboxListTile(\n77\t              value: _terms,\n78\t              title: const Text('I accept the terms and conditions'),\n79\t              controlAffinity: ListTileControlAffinity.leading,\n80\t              onChanged: (v) {\n81\t                setState(() => _terms = v ?? false);\n82\t                if (v ?? false) {\n83\t                  Analytics.capture('terms_accepted');\n84\t                }\n85\t              },\n86\t            ),\n87\t            const Spacer(),\n88\t            FilledButton(\n89\t              onPressed: _canContinue\n90\t                  ? () {\n91\t                      Analytics.capture('registration_continue_tapped', {\n92\t                        'amount': _amount.round(),\n93\t                        'terms': _terms,\n94\t                      });\n95\t                      Navigator.of(context).pushNamed('/offers');\n96\t                    }\n97\t                  : null,\n98\t              child: const Text('Continue'),\n99\t            ),\n100\t          ],\n101\t        ),\n102\t      ),\n103\t    );\n104\t  }\n105\t}"}
{"role":"tool","tool_call_id":"tool_rX6gDfWt2BYhv2ISsH1D6mKd","content":"1\timport 'package:flutter/material.dart';\n2\t\n3\timport '../analytics.dart';\n4\t\n5\tclass Offer {\n6\t  const Offer(this.bank, this.months, this.rate);\n7\t  final String bank;\n8\t  final int months;\n9\t  final double rate;\n10\t}\n11\t\n12\tconst _offers = [\n13\t  Offer('Norbank', 12, 9.9),\n14\t  Offer('Norbank', 24, 10.4),\n15\t  Offer('Fjordcredit', 12, 8.7),\n16\t  Offer('Fjordcredit', 36, 11.2),\n17\t  Offer('Vestkapital', 24, 9.5),\n18\t  Offer('Vestkapital', 48, 12.0),\n19\t  Offer('Sparbank', 12, 10.9),\n20\t  Offer('Sparbank', 60, 12.8),\n21\t  Offer('Nordlån', 36, 10.1),\n22\t  Offer('Nordlån', 60, 12.3),\n23\t];\n24\t\n25\tclass OfferScreen extends StatelessWidget {\n26\t  const OfferScreen({super.key});\n27\t\n28\t  @override\n29\t  Widget build(BuildContext context) {\n30\t    return Scaffold(\n31\t      appBar: AppBar(title: const Text('Offers')),\n32\t      body: NotificationListener<ScrollEndNotification>(\n33\t        onNotification: (n) {\n34\t          Analytics.capture('offers_scrolled', {'offset': n.metrics.pixels});\n35\t          return false;\n36\t        },\n37\t        child: ListView.builder(\n38\t          itemCount: _offers.length,\n39\t          itemBuilder: (context, i) {\n40\t            final o = _offers[i];\n41\t            return ListTile(\n42\t              leading: const Icon(Icons.account_balance),\n43\t              title: Text('${o.bank}, ${o.months} months'),\n44\t              subtitle: Text('${o.rate.toStringAsFixed(1)}% APR'),\n45\t              trailing: const Icon(Icons.chevron_right),\n46\t              onTap: () {},\n47\t            );\n48\t          },\n49\t        ),\n50\t      ),\n51\t    );\n52\t  }\n53\t}"}
