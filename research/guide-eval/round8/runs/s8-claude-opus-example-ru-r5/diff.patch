+def recent_facts(a):
+    """Facts saved since the last pin: outside the cached block, so save_fact doesn't invalidate it."""
+    new = a.facts[a.pinned_facts:]
+    if not new:
+        return None
+    return "\n".join(["Long-term facts saved today (same list, continued):"] + [f"- {f}" for f in new])
+
+
+def pin_facts(a, today):
+    """Move all facts into the cached block once per day.
+
+    The cached block already changes daily (it carries the date) and the cache lives 5 minutes,
+    so the first message of the day pays a full cache write anyway; folding the facts in at that
+    moment is free. During the day save_fact only grows the uncached tail.
+    Returns True if the record changed and must be saved.
+    """
+    if a.pinned_on == today.isoformat() and a.pinned_facts <= len(a.facts):
+        return False
+    a.pinned_on, a.pinned_facts = today.isoformat(), len(a.facts)
+    return True
+
