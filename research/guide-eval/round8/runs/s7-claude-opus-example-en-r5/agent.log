tinue\n                if not c[\"refresh_token\"]:\n                    log(f\"{uid}: token expiry passed and no refresh token on file -> expired, reconnect\")\n                    c.update(status=\"expired, reconnect\", access_token=None)\n                    continue\n                try:\n                    tok = post_form(TOKEN_URL, {\n                        \"grant_type\": \"refresh_token\", \"refresh_token\": c[\"refresh_token\"],\n                        \"client_id\": config.CLIENT_ID, \"client_secret\": config.CLIENT_SECRET,\n                    })\n                    c.update(access_token=tok[\"access_token\"],\n                             refresh_token=tok.get(\"refresh_token\", c[\"refresh_token\"]),\n                             expires_at=now + int(tok[\"expires_in\"]))\n                    log(f\"{uid}: token refreshed\")\n                except Exception as e:\n                    log(f\"{uid}: refresh failed ({e}) -> expired, reconnect\")\n                    c.update(status=\"expired, reconnect\", access_token=None)\n''','''def store_connection(user_id, tok):\n    athlete = tok.get(\"athlete\") or {}\n    with LOCK:\n        CONNECTIONS[user_id] = {\n            \"athlete_id\": athlete.get(\"id\"), \"athlete_name\": athlete.get(\"name\"),\n            \"access_token\": tok[\"access_token\"], \"scope\": tok.get(\"scope\"), \"status\": \"connected\",\n        }\n    log(f\"{user_id}: connected as athlete {athlete.get('id')} (scope {tok.get('scope')})\")\n''')\nrep('''        if url.path == \"/api/intervals/auth/init\":\n            return self.auth_init()\n        if url.path == \"/api/intervals/callback\":''','''        if url.path == \"/api/intervals/callback\":''')\nrep('''        url = urllib.parse.urlsplit(self.path)\n        if url.path == \"/api/intervals/disconnect\":''','''        url = urllib.parse.urlsplit(self.path)\n        if url.path == \"/api/intervals/auth/init\":\n            return self.auth_init()\n        if url.path == \"/api/intervals/disconnect\":''')\nrep('''    # Step 1: build the authorize URL and send the browser to Intervals.\n    def auth_init(self):\n        user = self.require_user()\n        if not user:\n            return\n        params = {\"client_id\": config.CLIENT_ID, \"redirect_uri\": config.REDIRECT_URI,\n                  \"scope\": config.SCOPES, \"state\": sign_state(user[\"id\"])}\n        self.redirect(AUTHORIZE_URL + \"?\" + urllib.parse.urlencode(params, safe=\":,\"))''',\n'''    # Step 1 (POST via the SPA's fetch wrapper, so the Authorization header is sent):\n    # build the authorize URL and return it; the SPA navigates the browser there.\n    def auth_init(self):\n        user = self.require_user()\n        if not user:\n            return\n        params = {\"client_id\": config.CLIENT_ID, \"redirect_uri\": config.REDIRECT_URI,\n                  \"scope\": config.SCOPES, \"state\": sign_state(user[\"id\"])}\n        self.send_json(200, {\"authorize_url\": AUTHORIZE_URL + \"?\" + urllib.parse.urlencode(params, safe=\":,\")})''')\nrep('''        except urllib.error.HTTPError as e:\n            self.send_json(e.code, {\"error\": f\"intervals returned {e.code}\"})\n        except Exception as e:\n            self.send_json(502''','''        except urllib.error.HTTPError as e:\n            if e.code == 401:\n                # The athlete revoked tricoach on the Intervals side: drop the token.\n                log(f\"{user['id']}: Intervals returned 401 -> revoked, reconnect\")\n                with LOCK:\n                    c.update(status=\"revoked, reconnect\", access_token=None)\n                return self.send_json(409, {\"error\": \"intervals access revoked, reconnect\"})\n            self.send_json(e.code, {\"error\": f\"intervals returned {e.code}\"})\n        except Exception as e:\n            self.send_json(502''')\nrep('''    threading.Thread(target=refresh_tokens, daemon=True).start()\n''','')\nopen(p,'w').write(s)\n\np='config.py'; s=open(p).