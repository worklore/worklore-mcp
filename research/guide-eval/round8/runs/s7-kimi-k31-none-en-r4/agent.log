n')\\n        self.send_header('Content-Length', str(len(body)))\\n        self.end_headers()\\n        self.wfile.write(body)\\n\\nprovider = ThreadingHTTPServer(('127.0.0.1', 0), Provider)\\nthreading.Thread(target=provider.serve_forever, daemon=True).start()\\nbase = f'http://127.0.0.1:{provider.server_port}'\\nserver.TOKEN_URL = base + '/api/oauth/token'\\nserver.AUTHORIZE_URL = base + '/oauth/authorize'\\napp = ThreadingHTTPServer(('127.0.0.1', 0), server.Handler)\\nthreading.Thread(target=app.serve_forever, daemon=True).start()\\napp_base = f'http://127.0.0.1:{app.server_port}'\\n\\ndef request(path, token=None):\\n    headers = {'Authorization': 'Bearer ' + token} if token else {}\\n    return urllib.request.urlopen(urllib.request.Request(app_base + path, headers=headers))\\n\\ntry:\\n    try:\\n        request('/api/intervals/auth/init')\\n        raise AssertionError('unauthenticated init unexpectedly succeeded')\\n    except urllib.error.HTTPError as e:\\n        assert e.code == 401\\n\\n    with request('/api/intervals/auth/init', 'tok-rivera') as response:\\n        assert response.status == 200\\n        authorize_url = json.load(response)['authorize_url']\\n    query = dict(urllib.parse.parse_qsl(urllib.parse.urlsplit(authorize_url).query))\\n    assert query['scope'] == 'ACTIVITY:WRITE,WELLNESS:READ,CALENDAR:WRITE'\\n    assert server.verify_state(query['state']) == 'u_rivera'\\n\\n    callback = '/api/intervals/callback?' + urllib.parse.urlencode({\\n        'code': 'local-code', 'state': query['state'],\\n    })\\n    try:\\n        request(callback)\\n        raise AssertionError('callback did not redirect')\\n    except urllib.error.HTTPError as e:\\n        raise AssertionError(f'callback failed: {e.code} {e.read()}')\\nexcept urllib.error.HTTPError as e:\\n    if e.code != 302:\\n        raise\\nfinally:\\n    pass\\n\\n# Follow the callback without treating its local redirect as an error.\\nclass NoRedirect(urllib.request.HTTPRedirectHandler):\\n    def redirect_request(self, *args):\\n        return None\\n\\nopener = urllib.request.build_opener(NoRedirect)\\ntry:\\n    opener.open(app_base + callback)\\nexcept urllib.error.HTTPError as e:\\n    assert e.code == 302\\n    assert e.headers['Location'] == '/?connected=1'\\n\\nwith server.LOCK:\\n    connection = server.CONNECTIONS['u_rivera']\\n    assert connection['status'] == 'connected'\\n    assert connection['expires_at'] is None\\n    assert connection['access_token'] == 'local-access-token'\\nwith request('/api/intervals/status', 'tok-rivera') as response:\\n    assert json.load(response)['connected'] is True\\nwith request('/api/intervals/wellness', 'tok-rivera') as response:\\n    assert json.load(response) == {'restingHR': 48}\\n\\nprint('local OAuth callback, non-expiring token, status, and wellness proxy: PASS')\\napp.shutdown()\\nprovider.shutdown()\\napp.server_close()\\nprovider.server_close()\\nPY\",\"cwd\":\"/private/tmp/h-0oLdIM\",\"timeout\":60}"}}]}
