{"role":"tool","tool_call_id":"tool_VTnL5Vp3d5R4RZkPw71uNmHy","content":"diff --git a/config.py b/config.py\nindex 54a8144..d5cc0c9 100644\n--- a/config.py\n+++ b/config.py\n@@ -8,6 +8,4 @@ INTERVALS_BASE = os.environ.get(\"INTERVALS_BASE\", \"https://intervals.icu\")\n CLIENT_ID = \"tricoach-dev\"\n CLIENT_SECRET = \"s3cr3t-placeholder-0000\"\n REDIRECT_URI = f\"http://localhost:{PORT}/api/intervals/callback\"\n-SCOPES = \"ACTIVITY:READ,ACTIVITY:WRITE,WELLNESS:READ,CALENDAR:READ,CALENDAR:WRITE\"\n-\n-REFRESH_INTERVAL = 60      # seconds between passes of the token refresher\n+SCOPES = \"ACTIVITY:WRITE,WELLNESS:READ,CALENDAR:WRITE\"\ndiff --git a/server.py b/server.py\nindex 351cbb7..c7347e0 100644\n--- a/server.py\n+++ b/server.py\n@@ -12,14 +12,13 @@ import config\n STATIC = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"static\")\n TOKEN_URL = config.INTERVALS_BASE + \"/api/oauth/token\"\n AUTHORIZE_URL = config.INTERVALS_BASE + \"/oauth/authorize\"\n-DEFAULT_TOKEN_TTL = 3600   # seconds; used when the provider does not say how long a token lives\n \n # --- in-memory store -------------------------------------------------------\n USERS = {\n     \"tok-okafor\": {\"id\": \"u_okafor\", \"name\": \"C. Okafor\"},\n     \"tok-rivera\": {\"id\": \"u_rivera\", \"name\": \"T. Rivera\"},\n }\n-# user_id -> {athlete_id, athlete_name, access_token, refresh_token, scope, expires_at, status}\n+# user_id -> {athlete_id, athlete_name, access_token, scope, status}\n CONNECTIONS = {}\n LOCK = threading.Lock()\n \n@@ -29,22 +28,40 @@ def log(msg):\n \n \n # --- state parameter: carries the user through the redirect -----------------\n-def sign_state(user_id):\n-    payload = f\"{user_id}:{int(time.time())}\"\n-    sig = hmac.new(config.APP_SECRET.encode(), payload.encode(), hashlib.sha256).hexdigest()[:32]\n-    return base64.urlsafe_b64encode(f\"{payload}:{sig}\".encode()).decode()\n+def b64url_encode(data):\n+    return base64.urlsafe_b64encode(data).rstrip(b\"=\").decode()\n \n \n-def verify_state(state, max_age=900):\n+def b64url_decode(data):\n+    return base64.urlsafe_b64decode(data + \"=\" * (-len(data) % 4))\n+\n+\n+def sign_state(user_id, max_age=900):\n+    header = b64url_encode(json.dumps({\"alg\": \"HS256\", \"typ\": \"JWT\"}, separators=(\",\", \":\")).encode())\n+    payload = b64url_encode(json.dumps({\n+        \"sub\": user_id, \"purpose\": \"intervals_oauth\", \"exp\": int(time.time()) + max_age,\n+    }, separators=(\",\", \":\")).encode())\n+    signing_input = f\"{header}.{payload}\"\n+    sig = hmac.new(config.APP_SECRET.encode(), signing_input.encode(), hashlib.sha256).digest()\n+    return f\"{signing_input}.{b64url_encode(sig)}\"\n+\n+\n+def verify_state(state):\n     try:\n-        user_id, ts, sig = base64.urlsafe_b64decode(state.encode()).decode().split(\":\")\n+        header, payload, sig = state.split(\".\")\n+        signing_input = f\"{header}.{payload}\"\n+        good = b64url_encode(hmac.new(config.APP_SECRET.encode(), signing_input.encode(), hashlib.sha256).digest())\n+        if not hmac.compare_digest(good, sig):\n+            return None\n+        header_data = json.loads(b64url_decode(header))\n+        payload_data = json.loads(b64url_decode(payload))\n+        if header_data.get(\"alg\") != \"HS256\" or payload_data.get(\"purpose\") != \"intervals_oauth\":\n+            return None\n+        if not payload_data.get(\"sub\") or payload_data[\"exp\"] <= time.time():\n+            return None\n+        return payload_data[\"sub\"]\n     except Exception:\n         return None\n-    payload = f\"{user_id}:{ts}\"\n-    good = hmac.new(config.APP_SECRET.encode(), payload.encode(), hashlib.sha256).hexdigest()[:32]\n-    if not hmac.compare_digest(good, sig) or time.time() - int(ts) > max_age:\n-        return None\n-    return user_id\n \n \n # --- Intervals.icu calls ----------------------------------------------------\n@@ -57,51 +74,27 @@ def post_form(url, fields):\n \n def exchange_code(c