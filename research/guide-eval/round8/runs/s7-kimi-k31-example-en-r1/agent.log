{"role":"tool","tool_call_id":"tool_piHKApvAxMq6g49WnT3laxQJ","content":"135\t        self.send_header(\"Content-Type\", ctype)\n136\t        self.send_header(\"Content-Length\", str(len(body)))\n137\t        self.end_headers()\n138\t        self.wfile.write(body)\n139\t\n140\t    def redirect(self, url):\n141\t        self.send_response(302)\n142\t        self.send_header(\"Location\", url)\n143\t        self.end_headers()\n144\t\n145\t    def current_user(self):\n146\t        auth = self.headers.get(\"Authorization\", \"\")\n147\t        if not auth.startswith(\"Bearer \"):\n148\t            return None\n149\t        return USERS.get(auth[7:].strip())\n150\t\n151\t    def require_user(self):\n152\t        user = self.current_user()\n153\t        if user is None:\n154\t            self.log_message(\"%s %s 401 (no Authorization header)\", self.command, self.path)\n155\t            self.send_json(401, {\"error\": \"unauthorized\"})\n156\t        return user\n157\t\n158\t    def do_GET(self):\n159\t        url = urllib.parse.urlsplit(self.path)\n160\t        q = dict(urllib.parse.parse_qsl(url.query))\n161\t        if url.path == \"/\":\n162\t            return self.send_file(\"index.html\", \"text/html; charset=utf-8\")\n163\t        if url.path.startswith(\"/static/\"):\n164\t            return self.send_file(os.path.basename(url.path), \"application/javascript\" if url.path.endswith(\".js\") else \"text/plain\")\n165\t        if url.path == \"/api/me\":\n166\t            user = self.require_user()\n167\t            return user and self.send_json(200, user)\n168\t        if url.path == \"/api/intervals/auth/init\":\n169\t            return self.auth_init()\n170\t        if url.path == \"/api/intervals/callback\":\n171\t            return self.callback(q)\n172\t        if url.path == \"/api/intervals/status\":\n173\t            return self.status()\n174\t        if url.path == \"/api/intervals/wellness\":\n175\t            return self.wellness()\n176\t        self.send_json(404, {\"error\": \"not found\"})\n177\t\n178\t    def do_POST(self):\n179\t        url = urllib.parse.urlsplit(self.path)\n180\t        if url.path == \"/api/intervals/disconnect\":\n181\t            user = self.require_user()\n182\t            if user:\n183\t                with LOCK:\n184\t                    CONNECTIONS.pop(user[\"id\"], None)\n185\t                self.send_json(200, {\"ok\": True})\n186\t            return\n187\t        self.send_json(404, {\"error\": \"not found\"})\n188\t\n189\t    # Step 1: build the authorize URL and send the browser to Intervals.\n190\t    def auth_init(self):\n191\t        user = self.require_user()\n192\t        if not user:\n193\t            return\n194\t        params = {\"client_id\": config.CLIENT_ID, \"redirect_uri\": config.REDIRECT_URI,\n195\t                  \"scope\": config.SCOPES, \"state\": sign_state(user[\"id\"])}\n196\t        self.redirect(AUTHORIZE_URL + \"?\" + urllib.parse.urlencode(params, safe=\":,\"))\n197\t\n198\t    # Step 2: Intervals redirects back here with ?code=&state=.\n199\t    def callback(self, q):\n200\t        user_id = verify_state(q.get(\"state\", \"\"))\n201\t        if not user_id or not q.get(\"code\"):\n202\t            return self.send_json(400, {\"error\": \"bad state or code\"})\n203\t        try:\n204\t            tok = exchange_code(q[\"code\"])\n205\t            store_connection(user_id, tok)\n206\t        except urllib.error.HTTPError as e:\n207\t            log(f\"{user_id}: token exchange failed: HTTP {e.code} {e.read()[:200]!r}\")\n208\t            return self.send_json(502, {\"error\": \"token exchange failed\"})\n209\t        except Exception as e:\n210\t            log(f\"{user_id}: token exchange failed: {e}\")\n211\t            return self.send_json(502, {\"error\": \"token exchange failed\"})\n212\t        self.redirect(\"/?connected=1\")\n213\t\n214\t    def status(self):\n215\t        user = self.require_user()\n216\t        if not user:\n217\t            return\n218\t        with LOCK:\n219\t            c = CONNECTIONS.get(user[\"id\"])\n220\t        if not c or c[\"status\"] != \"connected\":\n221\t            return self.send_json(200, {\"connected\": False, \"status\": c[\"status\"] if c else \"disconnected\"})\n222\t        self.send_json(200, {\"connected\": True, \"status\": \"connected\", \"scope\": c[\"scope\"],\n223\t                             \"athlete\": {\"id\": c[\"athlete_id\"], \"name\": c[\"athlete_name\"]}})\n224\t\n225\t    def wellness(self):\n226\t        user = self.require_user()\n227\t        if not user:\n228\t            return\n229\t        with LOCK:\n230\t            c = CONNECTIONS.get(user[\"id\"])\n231\t        if not c or c[\"status\"] != \"connected\":\n232\t            return self.send_json(409, {\"error\": \"intervals not connected\"})\n233\t        try:\n234\t            code, data = intervals_get(c, \"/wellness\")\n235\t            self.send_json(code, data)\n236\t        except urllib.error.HTTPError as e:\n237\t            self.send_json(e.code, {\"error\": f\"intervals returned {e.code}\"})\n238\t        except Exception as e:\n239\t            self.send_json(502, {\"error\": str(e)})\n240\t\n241\t\n242\tif __name__ == \"__main__\":\n243\t    threading.Thread(target=refresh_tokens, daemon=True).start()\n244\t    log(f\"serving on http://localhost:{config.PORT} (intervals: {config.INTERVALS_BASE})\")\n245\t    ThreadingHTTPServer((\"127.0.0.1\", config.PORT), Handler).serve_forever()"}
