e(state_parts[1]))\\n    assert payload['purpose'] == 'intervals_oauth' and payload['exp'] - time.time() <= 900\\n\\n    code, _, _ = call(app_base, '/api/intervals/auth/init')\\n    assert code == 404\\n    code, _, _ = call(app_base, '/api/intervals/callback?' + urllib.parse.urlencode({'code': 'good', 'state': query['state'] + 'x'}))\\n    assert code == 400 and not Provider.forms\\n\\n    callback_path = '/api/intervals/callback?' + urllib.parse.urlencode({'code': 'good', 'state': query['state']})\\n    code, headers, _ = call(app_base, callback_path, auth=False)\\n    assert code == 302 and headers['Location'] == '/?connected=1'\\n    assert set(Provider.forms[-1]) == {'client_id', 'client_secret', 'code'}\\n    assert server.CONNECTIONS['u_okafor']['access_token'] == 'access-good'\\n    assert 'expires_at' not in server.CONNECTIONS['u_okafor']\\n    assert 'refresh_token' not in server.CONNECTIONS['u_okafor']\\n\\n    real_time = server.time.time\\n    server.time.time = lambda: real_time() + 3700\\n    try:\\n        code, _, body = call(app_base, '/api/intervals/status')\\n        assert code == 200 and body['connected'] is True\\n    finally:\\n        server.time.time = real_time\\n\\n    code, _, body = call(app_base, '/api/intervals/wellness')\\n    assert code == 200 and body == {'wellness': 'ok'}\\n\\n    Provider.revoked = True\\n    code, _, _ = call(app_base, '/api/intervals/wellness')\\n    assert code == 401\\n    code, _, body = call(app_base, '/api/intervals/status')\\n    assert body == {'connected': False, 'status': 'revoked, reconnect'}\\n    assert server.CONNECTIONS['u_okafor']['access_token'] is None\\n\\n    Provider.revoked = False\\n    code, _, body = call(app_base, '/api/intervals/auth/init', 'POST')\\n    state = dict(urllib.parse.parse_qsl(urllib.parse.urlsplit(body['authorize_url']).query))['state']\\n    code, _, _ = call(app_base, '/api/intervals/callback?' + urllib.parse.urlencode({'code': 'renew', 'state': state}), auth=False)\\n    assert code == 302\\n    assert server.CONNECTIONS['u_okafor']['access_token'] == 'access-renew'\\n\\n    code, _, body = call(app_base, '/api/intervals/auth/init', 'POST')\\n    state = dict(urllib.parse.parse_qsl(urllib.parse.urlsplit(body['authorize_url']).query))['state']\\n    code, _, _ = call(app_base, '/api/intervals/callback?' + urllib.parse.urlencode({'code': 'other', 'state': state}), auth=False)\\n    assert code == 409\\n    assert server.CONNECTIONS['u_okafor']['athlete_id'] == 'i98765'\\n    assert server.CONNECTIONS['u_okafor']['access_token'] == 'access-renew'\\n\\n    expired = server.sign_state('u_okafor', max_age=-1)\\n    assert server.verify_state(expired) is None\\n\\n    code, _, js = call(app_base, '/static/app.js', auth=False)\\n    assert code == 200 and '/api/intervals/auth/init\\\", { method: \\\"POST\\\" }' in js\\n    assert 'window.location.assign(data.authorize_url)' in js\\n    print('PASS: POST init, unique scopes, signed/expiring state, exact token form, callback, persistent token, wellness, 401 reconnect, same-account reconnect, mismatch guard, SPA wiring')\\nfinally:\\n    app.shutdown()\\n    provider.shutdown()\\n    app.server_close()\\n    provider.server_close()\\nPY\",\"cwd\":\"/private/tmp/h-QVIdu5\",\"timeout\":60}"}}]}
