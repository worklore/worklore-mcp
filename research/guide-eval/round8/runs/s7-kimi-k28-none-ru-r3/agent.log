{"role":"assistant","content":"Все правки внесены. Теперь напишу временный локальный тест: mock-сервер «Intervals.icu» на 127.0.0.1 (реальные внешние сервисы не трогаю — использую `INTERVALS_BASE`), который воспроизводит поведение из логов: отдаёт токен без `expires_in`/`refresh_token`, отклоняет неизвестные scope.","tool_calls":[{"type":"function","id":"tool_jdDanZEzhQOGxWfvdEuQSxQI","function":{"name":"Write","arguments":"{\"path\":\"tmp_local_test.py\",\"content\":\"#!/usr/bin/env python3\\n\\\"\\\"\\\"Local end-to-end test for the Intervals.icu integration.\\n\\nRuns the real server.py against a mock Intervals.icu on 127.0.0.1:9999\\n(via INTERVALS_BASE). No external network. Temporary file — delete after run.\\n\\\"\\\"\\\"\\nimport json, os, threading, time, urllib.error, urllib.parse, urllib.request\\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\\n\\nos.environ[\\\"INTERVALS_BASE\\\"] = \\\"http://127.0.0.1:9999\\\"\\nimport server  # noqa: E402  (INTERVALS_BASE must be set before import)\\n\\nVALID_SCOPES = {\\\"ACTIVITY:READ\\\", \\\"ACTIVITY:WRITE\\\", \\\"WELLNESS:READ\\\", \\\"EVENT:READ\\\", \\\"EVENT:WRITE\\\"}\\nREFRESH_CALLS = []\\n\\n\\nclass MockIntervals(BaseHTTPRequestHandler):\\n    def log_message(self, *a):\\n        pass\\n\\n    def j(self, code, obj):\\n        b = json.dumps(obj).encode()\\n        self.send_response(code)\\n        self.send_header(\\\"Content-Type\\\", \\\"application/json\\\")\\n        self.send_header(\\\"Content-Length\\\", str(len(b)))\\n        self.end_headers()\\n        self.wfile.write(b)\\n\\n    def do_GET(self):\\n        u = urllib.parse.urlsplit(self.path)\\n        q = dict(urllib.parse.parse_qsl(u.query))\\n        if u.path == \\\"/oauth/authorize\\\":\\n            if q.get(\\\"response_type\\\") != \\\"code\\\":\\n                return self.j(400, {\\\"error\\\": \\\"invalid_request\\\"})\\n            if any(s not in VALID_SCOPES for s in q.get(\\\"scope\\\", \\\"\\\").split(\\\",\\\")):\\n                return self.j(400, {\\\"error\\\": \\\"invalid_request\\\"})\\n            loc = q[\\\"redirect_uri\\\"] + \\\"?\\\" + urllib.parse.urlencode({\\\"code\\\": \\\"mock-code-1\\\", \\\"state\\\": q[\\\"state\\\"]})\\n            self.send_response(302)\\n            self.send_header(\\\"Location\\\", loc)\\n            self.end_headers()\\n            return\\n        if u.path == \\\"/api/v1/athlete/i98765/wellness\\\":\\n            return self.j(200, [{\\\"date\\\": \\\"2026-11-08\\\", \\\"resting_hr\\\": 52}])\\n        self.j(404, {\\\"error\\\": \\\"not found\\\"})\\n\\n    def do_POST(self):\\n        u = urllib.parse.urlsplit(self.path)\\n        if u.path == \\\"/api/oauth/token\\\":\\n            body = urllib.parse.parse_qs(self.rfile.read(int(self.headers[\\\"Content-Length\\\"])).decode())\\n            g = body.get(\\\"grant_type\\\", [\\\"\\\"])[0]\\n            if g == \\\"authorization_code\\\":\\n                # Same shape as the real response captured on 2026-09-19:\\n                # no expires_in, no refresh_token.\\n                return self.j(200, {\\\"token_type\\\": \\\"bearer\\\", \\\"access_token\\\": \\\"at-okafor\\\",\\n                                    \\\"scope\\\": \\\"ACTIVITY:WRITE,WELLNESS:READ\\\",\\n                                    \\\"athlete\\\": {\\\"id\\\": \\\"i98765\\\", \\\"name\\\": \\\"C. Okafor\\\"}})\\n            if g == \\\"refresh_token\\\":\\n                REFRESH_CALLS.append(body.get(\\\"refresh_token\\\", [\\\"\\\"])[0])\\n                return self.j(200, {\\\"token_type\\\": \\\"bearer\\\", \\\"access_token\\\": \\\"at-refreshed\\\",\\n                                    \\\"expires_in\\\": 3600})\\n            return self.j(400, {\\\"error\\\": \\\"unsupported_grant_type\\\"})\\n        self.j(404, {\\\"error\\\": \\\"not found\\\"})\\n\\n\\nclass NoRedirect(urllib.request.HTTPRedirectHandler):\\n    def redirect_request(self, *a, **k):\\n        return None\\n\\n\\nopener = urllib.request.build_opener(NoRedirect)\\nRESULTS = []\\n\\n\\ndef check(name, cond, detail=\\\"\\\"):\\n    RESULTS.append((name, bool(cond)))\\n    print((\\\"PASS \\\" if cond else \\\"FAIL \\\") + name + (f\\\"  [{detail}]\\\" if detail and not cond else \\\"\\\"))\\n\\n\\ndef get(path, token=None, raw=False):\\n    req = urllib.request.Request(\\\"http://127.0.0.1:8766\\\" + path)\\n    if token:\\n        req.add_header(\\\"Authorization\\\", \\\"Bearer \\\" + token)\\n    if raw:\\n        try:\\n            r = opener.open(req, timeout=5)\\n            return r.status, dict(r.headers), r.read().decode()\\n        except urllib.error.HTTPError as e:\\n            return e.code, dict(e.headers), e.read().decode()\\n    try:\\n        with urllib.request.urlopen(req, timeout=5) as r:\\n            return r.status, dict(r.headers), r.read().decode()\\n    except urllib.error.HTTPError as e:\\n        return e.code, dict(e.headers), e.read().decode()\\n\\n\\ndef browser_follow(url):\\n    \\\"\\\"\\\"Follow the provider->callback->app redirect chain like a browser would.\\\"\\\"\\\"\\n    try:\\n        with urllib.request.urlopen(url, timeout=5) as r:\\n            return r.status, r.geturl()\\n    except urllib.error.HTTPError as e:\\n        return e.code, e.geturl()\\n\\n\\nmock = ThreadingHTTPServer((\\\"127.0.0.1\\\", 9999), MockIntervals)\\nthreading.Thread(target=mock.serve_forever, daemon=True).start()\\napp = ThreadingHTTPServer((\\\"127.0.0.1\\\", 8766), server.Handler)\\nthreading.Thread(target=app.serve_forever, daemon=True).start()\\ntime.sleep(0.2)\\n\\n# --- Bug 1: the Connect button (missing Authorization on navigation) --------\\ncode, _, body = get(\\\"/api/intervals/auth/init\\\")\\ncheck(\\\"init without token -> 401 (old button failure mode)\\\", code == 401 and '\\\"unauthorized\\\"' in body)\\n\\ncode, _, body = get(\\\"/api/intervals/auth/init\\\", token=\\\"tok-okafor\\\")\\ncheck(\\\"init with bearer -> 200 JSON url\\\", code == 200)\\nauth = json.loads(body)\\nurl = auth.get(\\\"url\\\", \\\"\\\")\\ncheck(\\\"url has response_type=code\\\", \\\"response_type=code\\\" in url)\\ncheck(\\\"url uses EVENT scopes, no CALENDAR scopes\\\", \\\"EVENT:READ\\\" in url and \\\"CALENDAR\\\" not in url)\\n\\n# --- Bug 2: authorize rejects unknown (old CALENDAR) scopes, accepts new -----\\nold_url = url.replace(\\\"EVENT:READ,EVENT:WRITE\\\", \\\"CALENDAR:READ,CALENDAR:WRITE\\\")\\ncode, _, body = browser_raw = None, None, None\\ntry:\\n    r = opener.open(old_url, timeout=5)\\n    code, body = r.status, r.read().decode()\\nexcept urllib.error.HTTPError as e:\\n    code, body = e.code, e.read().decode()\\ncheck(\\\"old CALENDAR-scope URL -> 400 invalid_request at provider\\\", code == 400 and \\\"invalid_request\\\" in body, f\\\"got {code} {body[:80]}\\\")\\n\\ntry:\\n    r = opener.open(url, timeout=5)\\n    code, loc = r.status, r.headers.get(\\\"Location\\\", \\\"\\\")\\nexcept urllib.error.HTTPError as e:\\n    code, loc = e.code, e.headers.get(\\\"Location\\\", \\\"\\\")\\ncheck(\\\"new URL -> provider 302 to our callback\\\", code == 302 and loc.startswith(\\\"http://localhost:8766/api/intervals/callback?\\\"), f\\\"got {code} {loc[:80]}\\\")\\n\\n# --- Full connect flow, browser-like (callback carries no Authorization) -----\\nfinal_code, final_url = browser_follow(loc)\\ncheck(\\\"callback completes -> redirect to /?connected=1\\\", final_url.endswith(\\\"/?connected=1\\\"), f\\\"got {final_code} {final_url}\\\")\\n\\ncode, _, body = get(\\\"/api/intervals/status\\\", token=\\\"tok-okafor\\\")\\nst = json.loads(body)\\ncheck(\\\"status -> connected as i98765\\\", code == 200 and st.get(\\\"connected\\\") is True and st[\\\"athlete\\\"][\\\"id\\\"] == \\\"i98765\\\", body)\\n\\ncode, _, body = get(\\\"/api/intervals/wellness\\\", token=\\\"tok-okafor\\\")\\ncheck(\\\"wellness proxy works with stored token\\\", code == 200 and \\\"resting_hr\\\" in body, f\\\"{code} {body[:80]}\\\")\\n\\nwith server.LOCK:\\n    conn = dict(server.CONNECTIONS[\\\"u_okafor\\\"])\\ncheck(\\\"stored token has no invented expiry (expires_at is None)\\\", conn[\\\"expires_at\\\"] is None, repr(conn[\\\"expires_at\\\"]))\\n\\n# --- Bug 3: refresher behaviour ---------------------------------------------\\nserver.config.REFRESH_INTERVAL = 0.2\\nthreading.Thread(target=server.refresh_tokens, daemon=True).start()\\nwith server.LOCK:\\n    server.CONNECTIONS[\\\"u_rivera\\\"] = {\\\"athlete_id\\\": \\\"i98765\\\", \\\"athlete_name\\\": \\\"T. Rivera\\\",\\n                                      \\\"access_token\\\": \\\"at-rivera\\\", \\\"refresh_token\\\": None,\\n                                      \\\"scope\\\": \\\"ACTIVITY:WRITE\\\", \\\"expires_at\\\": time.time() - 10,\\n                                      \\\"status\\\": \\\"connected\\\"}  # provider-declared expiry, past\\n    server.CONNECTIONS[\\\"u_tester\\\"] = {\\\"athlete_id\\\": \\\"i00001\\\", \\\"athlete_name\\\": \\\"Tester\\\",\\n                                      \\\"access_token\\\": \\\"at-old\\\", \\\"refresh_token\\\": \\\"rt-1\\\",\\n                                      \\\"scope\\\": \\\"WELLNESS:READ\\\", \\\"expires_at\\\": time.time() + 60,\\n                                      \\\"status\\\": \\\"connected\\\"}  # expiring soon, refreshable\\ntime.sleep(1.0)\\n\\nwith server.LOCK:\\n    okafor = dict(server.CONNECTIONS[\\\"u_okafor\\\"])\\n    rivera = dict(server.CONNECTIONS[\\\"u_rivera\\\"])\\n    tester = dict(server.CONNECTIONS[\\\"u_tester\\\"])\\ncheck(\\\"non-expiring token stays connected after refresher pass\\\", okafor[\\\"status\\\"] == \\\"connected\\\", rivera[\\\"status\\\"])\\ncheck(\\\"provider-declared expired token, no refresh -> 'expired, reconnect'\\\", rivera[\\\"status\\\"] == \\\"expired, reconnect\\\", rivera[\\\"status\\\"])\\ncheck(\\\"expiring token with refresh_token -> refreshed\\\", tester[\\\"status\\\"] == \\\"connected\\\" and tester[\\\"access_token\\\"] == \\\"at-refreshed\\\",\\n      f\\\"{tester['status']} {tester['access_token']}\\\")\\ncheck(\\\"refresh grant actually called provider\\\", REFRESH_CALLS == [\\\"rt-1\\\"], repr(REFRESH_CALLS))\\n\\n# --- Reconnect overwrites a stale 'expired' row (Rivera's path) --------------\\ncode, _, body = get(\\\"/api/intervals/auth/init\\\", token=\\\"tok-rivera\\\")\\nloc2 = json.loads(body)[\\\"url\\\"]\\ntry:\\n    r = opener.open(loc2, timeout=5)\\n    code, loc3 = r.status, r.headers.get(\\\"Location\\\", \\\"\\\")\\nexcept urllib.error.HTTPError as e:\\n    code, loc3 = e.code, e.headers.get(\\\"Location\\\", \\\"\\\")\\nfinal_code, final_url = browser_follow(loc3)\\ncode, _, body = get(\\\"/api/intervals/status\\\", token=\\\"tok-rivera\\\")\\ncheck(\\\"reconnect from 'expired' state works\\\", final_url.endswith(\\\"/?connected=1\\\") and json.loads(body)[\\\"connected\\\"] is True,\\n      f\\\"{final_url} {body}\\\")\\n\\nprint()\\nfailed = [n for n, ok in RESULTS if not ok]\\nprint(f\\\"{len(RESULTS) - len(failed)}/{len(RESULTS)} checks passed\\\")\\nraise SystemExit(1 if failed else 0)\\n\"}"}}]}
