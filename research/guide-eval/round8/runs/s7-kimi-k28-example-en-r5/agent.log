{"role":"assistant","tool_calls":[{"type":"function","id":"tool_lmaaQZoHhClXIXGEjH0EGOI7","function":{"name":"Edit","arguments":"{\"new_string\":\"def exchange_code(code):\\n    # Intervals.icu wants only these three fields; there is no refresh_token\\n    # or expires_in in the response, and the athlete id comes bundled in it.\\n    return post_form(TOKEN_URL, {\\n        \\\"client_id\\\": config.CLIENT_ID, \\\"client_secret\\\": config.CLIENT_SECRET, \\\"code\\\": code,\\n    })\\n\\n\\ndef store_connection(user_id, tok):\\n    # The access token has no expiry: it lives until the athlete revokes it.\\n    # Revocation is handled lazily on the first 401 from the API (see wellness).\\n    athlete = tok.get(\\\"athlete\\\") or {}\\n    with LOCK:\\n        CONNECTIONS[user_id] = {\\n            \\\"athlete_id\\\": athlete.get(\\\"id\\\"), \\\"athlete_name\\\": athlete.get(\\\"name\\\"),\\n            \\\"access_token\\\": tok[\\\"access_token\\\"], \\\"scope\\\": tok.get(\\\"scope\\\"), \\\"status\\\": \\\"connected\\\",\\n        }\\n    log(f\\\"{user_id}: connected as athlete {athlete.get('id')} (token has no expiry)\\\")\",\"old_string\":\"def exchange_code(code):\\n    return post_form(TOKEN_URL, {\\n        \\\"grant_type\\\": \\\"authorization_code\\\", \\\"client_id\\\": config.CLIENT_ID,\\n        \\\"client_secret\\\": config.CLIENT_SECRET, \\\"code\\\": code, \\\"redirect_uri\\\": config.REDIRECT_URI,\\n    })\\n\\n\\ndef store_connection(user_id, tok):\\n    expires_in = int(tok.get(\\\"expires_in\\\") or DEFAULT_TOKEN_TTL)\\n    refresh = tok.get(\\\"refresh_token\\\")\\n    if not refresh:\\n        log(f\\\"{user_id}: no refresh_token in response, scheduling expiry in {expires_in}s\\\")\\n    athlete = tok.get(\\\"athlete\\\") or {}\\n    with LOCK:\\n        CONNECTIONS[user_id] = {\\n            \\\"athlete_id\\\": athlete.get(\\\"id\\\"), \\\"athlete_name\\\": athlete.get(\\\"name\\\"),\\n            \\\"access_token\\\": tok[\\\"access_token\\\"], \\\"refresh_token\\\": refresh,\\n            \\\"scope\\\": tok.get(\\\"scope\\\"), \\\"expires_at\\\": time.time() + expires_in, \\\"status\\\": \\\"connected\\\",\\n        }\\n    log(f\\\"{user_id}: connected as athlete {athlete.get('id')} (expires in {expires_in}s)\\\")\",\"path\":\"server.py\"}"}}]}
