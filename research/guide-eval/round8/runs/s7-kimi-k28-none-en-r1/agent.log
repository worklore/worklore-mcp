{"role":"assistant","content":"Now I'll write a throwaway end-to-end verification script that mocks Intervals.icu locally (no external calls) and exercises the full flow:","tool_calls":[{"type":"function","id":"tool_Cc79TxZN3psdVjoRuwMl4CpK","function":{"name":"Write","arguments":"{\"content\":\"#!/usr/bin/env python3\\n\\\"\\\"\\\"Local end-to-end check of the Intervals.icu integration.\\n\\nStarts a mock Intervals.icu (provider-like authorize/token/wellness endpoints)\\nand the tricoach server with INTERVALS_BASE pointed at the mock. Nothing\\nleaves localhost. Run: python3 e2e_check.py\\n\\\"\\\"\\\"\\nimport json, os, sys, threading, time, urllib.error, urllib.parse, urllib.request\\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\\n\\nMOCK_PORT = 8899\\nBASE = f\\\"http://localhost:{MOCK_PORT}\\\"\\nos.environ[\\\"INTERVALS_BASE\\\"] = BASE\\n\\n# ---------------------------------------------------------------- mock provider\\nclass MockIntervals(BaseHTTPRequestHandler):\\n    def log_message(self, *a):\\n        pass\\n\\n    def send_json(self, code, obj):\\n        body = json.dumps(obj).encode()\\n        self.send_response(code)\\n        self.send_header(\\\"Content-Type\\\", \\\"application/json\\\")\\n        self.send_header(\\\"Content-Length\\\", str(len(body)))\\n        self.end_headers()\\n        self.wfile.write(body)\\n\\n    def do_GET(self):\\n        url = urllib.parse.urlsplit(self.path)\\n        q = urllib.parse.parse_qsl(url.query)\\n        qs = dict(q)\\n        if url.path == \\\"/oauth/authorize\\\":\\n            # RFC 6749 4.1.1: response_type is a REQUIRED authorize parameter.\\n            if qs.get(\\\"response_type\\\") != \\\"code\\\":\\n                return self.send_json(400, {\\\"error\\\": \\\"invalid_request\\\"})\\n            for p in (\\\"client_id\\\", \\\"redirect_uri\\\", \\\"scope\\\"):\\n                if p not in qs:\\n                    return self.send_json(400, {\\\"error\\\": \\\"invalid_request\\\"})\\n            loc = f\\\"{qs['redirect_uri']}?code=mock-code-1&state={urllib.parse.quote(qs.get('state', ''))}\\\"\\n            self.send_response(302)\\n            self.send_header(\\\"Location\\\", loc)\\n            self.end_headers()\\n            return\\n        if url.path == \\\"/api/v1/athlete/i98765/wellness\\\":\\n            auth = self.headers.get(\\\"Authorization\\\", \\\"\\\")\\n            if auth != \\\"Bearer mock-at-1\\\":\\n                return self.send_json(401, {\\\"error\\\": \\\"invalid_token\\\"})\\n            return self.send_json(200, {\\\"id\\\": \\\"2026-11-07\\\", \\\"weight\\\": 70.5, \\\"restingHR\\\": 48})\\n        self.send_json(404, {\\\"error\\\": \\\"not found\\\"})\\n\\n    def do_POST(self):\\n        url = urllib.parse.urlsplit(self.path)\\n        if url.path == \\\"/api/oauth/token\\\":\\n            fields = dict(urllib.parse.parse_qsl(self.rfile.read(int(self.headers[\\\"Content-Length\\\"])).decode()))\\n            if fields.get(\\\"grant_type\\\") == \\\"authorization_code\\\":\\n                if fields.get(\\\"code\\\") != \\\"mock-code-1\\\":\\n                    return self.send_json(400, {\\\"error\\\": \\\"invalid_grant\\\"})\\n                # Shaped like the real provider: no expires_in, no refresh_token.\\n                return self.send_json(200, {\\n                    \\\"token_type\\\": \\\"bearer\\\", \\\"access_token\\\": \\\"mock-at-1\\\",\\n                    \\\"scope\\\": \\\"ACTIVITY:READ,ACTIVITY:WRITE,WELLNESS:READ,CALENDAR:READ,CALENDAR:WRITE\\\",\\n                    \\\"athlete\\\": {\\\"id\\\": \\\"i98765\\\", \\\"name\\\": \\\"T. Rivera\\\"}})\\n            if fields.get(\\\"grant_type\\\") == \\\"refresh_token\\\":\\n                if fields.get(\\\"refresh_token\\\") != \\\"mock-rt-1\\\":\\n                    return self.send_json(400, {\\\"error\\\": \\\"invalid_grant\\\"})\\n                return self.send_json(200, {\\\"token_type\\\": \\\"bearer\\\", \\\"access_token\\\": \\\"mock-at-2\\\",\\n                                            \\\"expires_in\\\": 3600, \\\"refresh_token\\\": \\\"mock-rt-2\\\"})\\n            return self.send_json(400, {\\\"error\\\": \\\"unsupported_grant_type\\\"})\\n        self.send_json(404, {\\\"error\\\": \\\"not found\\\"})\\n\\n# ---------------------------------------------------------------- client helper\\nclass NoRedirect(urllib.request.HTTPRedirectHandler):\\n    def redirect_request(self, req, fp, code, msg, headers, newurl):\\n        return None\\n\\nOPENER = urllib.request.build_opener(NoRedirect)\\n\\ndef req(path, token=None):\\n    \\\"\\\"\\\"Return (status, headers, parsed_json_body_or_None) without following redirects.\\\"\\\"\\\"\\n    r = urllib.request.Request(\\\"http://localhost:8766\\\" + path)\\n    if token:\\n        r.add_header(\\\"Authorization\\\", \\\"Bearer \\\" + token)\\n    try:\\n        with OPENER.open(r, timeout=15) as resp:\\n            raw = resp.read().decode()\\n            return resp.status, resp.headers, (json.loads(raw) if raw else None)\\n    except urllib.error.HTTPError as e:\\n        raw = e.read().decode()\\n        try:\\n            body = json.loads(raw) if raw else None\\n        except json.JSONDecodeError:\\n            body = raw\\n        return e.code, e.headers, body\\n\\nCHECKS = []\\ndef check(name, cond, detail=\\\"\\\"):\\n    CHECKS.append((name, cond, detail))\\n    print((\\\"PASS \\\" if cond else \\\"FAIL \\\") + name + (f\\\"  [{detail}]\\\" if detail and not cond else \\\"\\\"))\\n\\n# ---------------------------------------------------------------- run\\nmock = ThreadingHTTPServer((\\\"127.0.0.1\\\", MOCK_PORT), MockIntervals)\\nthreading.Thread(target=mock.serve_forever, daemon=True).start()\\n\\nimport server  # INTERVALS_BASE already points at the mock\\nhttpd = ThreadingHTTPServer((\\\"127.0.0.1\\\", 8766), server.Handler)\\nthreading.Thread(target=httpd.serve_forever, daemon=True).start()\\ntime.sleep(0.3)\\n\\n# 1. Bare document navigation (the old <a href> button) still 401s without the header.\\ncode, _, body = req(\\\"/api/intervals/auth/init\\\")\\ncheck(\\\"auth/init without Bearer header -> 401\\\", code == 401 and body[\\\"error\\\"] == \\\"unauthorized\\\", f\\\"got {code} {body}\\\")\\n\\n# 2. SPA-style call with the token: JSON containing a provider-valid authorize URL.\\ncode, _, body = req(\\\"/api/intervals/auth/init\\\", token=\\\"tok-okafor\\\")\\ncheck(\\\"auth/init with Bearer -> 200 JSON url\\\", code == 200 and isinstance(body.get(\\\"url\\\"), str), f\\\"got {code} {body}\\\")\\nauth_url = body[\\\"url\\\"]\\ncheck(\\\"authorize url has response_type=code\\\", \\\"response_type=code\\\" in auth_url, auth_url)\\ncheck(\\\"authorize url keeps client/redirect/scope/state\\\", all(\\n    p in auth_url for p in (\\\"client_id=tricoach-dev\\\", \\\"redirect_uri=\\\", \\\"scope=ACTIVITY:READ\\\", \\\"state=\\\")), auth_url)\\n\\n# 3. Provider rejects the URL if response_type is dropped (proves cause #2).\\nbroken = auth_url.replace(\\\"response_type=code\\\", \\\"\\\")\\ncode, _, body = req_full = (None, None, None)\\nr = urllib.request.Request(broken)\\ntry:\\n    with urllib.request.urlopen(r, timeout=15) as resp:\\n        code, body = resp.status, json.loads(resp.read().decode())\\nexcept urllib.error.HTTPError as e:\\n    code, body = e.code, json.loads(e.read().decode())\\ncheck(\\\"mock provider 400s without response_type\\\", code == 400 and body[\\\"error\\\"] == \\\"invalid_request\\\", f\\\"got {code} {body}\\\")\\n\\n# 4. Full connect flow: authorize -> callback -> connected.\\nr = urllib.request.Request(auth_url)\\ntry:\\n    OPENER.open(r, timeout=15)\\n    loc = None\\nexcept urllib.error.HTTPError as e:\\n    loc = e.headers[\\\"Location\\\"] if e.code == 302 else None\\ncheck(\\\"mock authorize redirects to our callback\\\", loc and loc.startswith(\\\"http://localhost:8766/api/intervals/callback?code=\\\"), str(loc))\\ncode, _, _ = req(urllib.parse.urlsplit(loc).path + \\\"?\\\" + urllib.parse.urlsplit(loc).query)\\ncheck(\\\"callback -> 302 to /?connected=1\\\", code == 302, f\\\"got {code}\\\")\\n\\ncode, _, body = req(\\\"/api/intervals/status\\\", token=\\\"tok-okafor\\\")\\ncheck(\\\"status: connected as i98765\\\", code == 200 and body.get(\\\"connected\\\") is True and body[\\\"athlete\\\"][\\\"id\\\"] == \\\"i98765\\\", f\\\"got {code} {body}\\\")\\ncheck(\\\"stored token has no fabricated expiry\\\", server.CONNECTIONS[\\\"u_okafor\\\"][\\\"expires_at\\\"] is None,\\n      str(server.CONNECTIONS[\\\"u_okafor\\\"]))\\n\\ncode, _, body = req(\\\"/api/intervals/wellness\\\", token=\\\"tok-okafor\\\")\\ncheck(\\\"wellness proxy 200 with data\\\", code == 200 and body.get(\\\"weight\\\") == 70.5, f\\\"got {code} {body}\\\")\\n\\n# 5. Regression for cause #3: >1h later the connection must NOT be expired.\\nserver.refresh_pass(time.time() + 7200)\\ncheck(\\\"after 2h: still connected (no synthetic TTL)\\\", server.CONNECTIONS[\\\"u_okafor\\\"][\\\"status\\\"] == \\\"connected\\\"\\n      and server.CONNECTIONS[\\\"u_okafor\\\"][\\\"access_token\\\"] == \\\"mock-at-1\\\",\\n      str(server.CONNECTIONS[\\\"u_okafor\\\"]))\\n\\n# 6. Provider that DOES expire tokens: refresh_token path still works.\\nserver.CONNECTIONS[\\\"u_rivera\\\"] = {\\\"athlete_id\\\": \\\"i98765\\\", \\\"athlete_name\\\": \\\"T. Rivera\\\",\\n                                  \\\"access_token\\\": \\\"old-at\\\", \\\"refresh_token\\\": \\\"mock-rt-1\\\",\\n                                  \\\"scope\\\": \\\"WELLNESS:READ\\\", \\\"expires_at\\\": time.time() + 100,\\n                                  \\\"status\\\": \\\"connected\\\"}\\nserver.refresh_pass(time.time())\\nrv = server.CONNECTIONS[\\\"u_rivera\\\"]\\ncheck(\\\"expiring token with refresh_token gets renewed\\\", rv[\\\"status\\\"] == \\\"connected\\\"\\n      and rv[\\\"access_token\\\"] == \\\"mock-at-2\\\" and rv[\\\"refresh_token\\\"] == \\\"mock-rt-2\\\"\\n      and rv[\\\"expires_at\\\"] > time.time() + 3000, str(rv))\\n\\n# 7. Expiring token WITHOUT refresh_token -> honest \\\"expired, reconnect\\\".\\nrv[\\\"refresh_token\\\"] = None\\nrv[\\\"expires_at\\\"] = time.time() + 100\\nserver.refresh_pass(time.time())\\ncheck(\\\"expiring token without refresh_token -> expired, reconnect\\\",\\n      server.CONNECTIONS[\\\"u_rivera\\\"][\\\"status\\\"] == \\\"expired, reconnect\\\", str(server.CONNECTIONS[\\\"u_rivera\\\"]))\\n\\n# 8. Rejected (401) token marks the connection for reconnect.\\nserver.CONNECTIONS[\\\"u_okafor\\\"].update(access_token=\\\"dead-token\\\", expires_at=None, status=\\\"connected\\\")\\ncode, _, body = req(\\\"/api/intervals/wellness\\\", token=\\\"tok-okafor\\\")\\ncheck(\\\"wellness 401 from provider -> 401 + status 'expired, reconnect'\\\",\\n      code == 401 and server.CONNECTIONS[\\\"u_okafor\\\"][\\\"status\\\"] == \\\"expired, reconnect\\\",\\n      f\\\"http {code}, {server.CONNECTIONS['u_okafor']}\\\")\\n\\n# 9. Athlete can reconnect after expiry (full flow again for u_okafor).\\ncode, _, body = req(\\\"/api/intervals/auth/init\\\", token=\\\"tok-okafor\\\")\\nauth_url = body[\\\"url\\\"]\\ntry:\\n    OPENER.open(urllib.request.Request(auth_url), timeout=15)\\n    loc = None\\nexcept urllib.error.HTTPError as e:\\n    loc = e.headers[\\\"Location\\\"] if e.code == 302 else None\\nreq(urllib.parse.urlsplit(loc).path + \\\"?\\\" + urllib.parse.urlsplit(loc).query)\\ncode, _, body = req(\\\"/api/intervals/status\\\", token=\\\"tok-okafor\\\")\\ncheck(\\\"reconnect works after expiry\\\", code == 200 and body.get(\\\"connected\\\") is True, f\\\"got {code} {body}\\\")\\ncode, _, body = req(\\\"/api/intervals/wellness\\\", token=\\\"tok-okafor\\\")\\ncheck(\\\"wellness works again after reconnect\\\", code == 200 and body.get(\\\"weight\\\") == 70.5, f\\\"got {code} {body}\\\")\\n\\nfailed = [c for c in CHECKS if not c[1]]\\nprint(f\\\"\\\\n{len(CHECKS) - len(failed)}/{len(CHECKS)} checks passed\\\")\\nhttpd.shutdown(); mock.shutdown()\\nsys.exit(1 if failed else 0)\\n\",\"path\":\"e2e_check.py\"}"}}]}
