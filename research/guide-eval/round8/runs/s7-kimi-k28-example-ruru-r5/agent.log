{"role":"assistant","tool_calls":[{"type":"function","id":"tool_gL27q6LP30Gkgw36Ad51eLOy","function":{"name":"Bash","arguments":"{\"command\":\"python3 - <<'EOF'\\nimport base64, hashlib, hmac, http.client, json, threading, time, urllib.error, urllib.parse\\nimport server, config\\n\\n# --- fakes: no external network at all -------------------------------------\\n# Real Intervals shape: access_token + scope + athlete, NO refresh_token,\\n# NO expires_in.\\ndef fake_exchange(code):\\n    assert code == \\\"fake-code\\\"\\n    return {\\\"token_type\\\": \\\"bearer\\\", \\\"access_token\\\": \\\"at-123\\\", \\\"scope\\\": \\\"ACTIVITY:WRITE,WELLNESS:READ\\\",\\n            \\\"athlete\\\": {\\\"id\\\": \\\"i111\\\", \\\"name\\\": \\\"Test Athlete\\\"}}\\nserver.exchange_code = fake_exchange\\n\\ncalls = {\\\"n\\\": 0}\\ndef fake_intervals_get(conn, path):\\n    assert conn[\\\"access_token\\\"] == \\\"at-123\\\"\\n    calls[\\\"n\\\"] += 1\\n    if calls[\\\"n\\\"] == 1:\\n        return 200, {\\\"wellness\\\": []}          # token alive\\n    raise urllib.error.HTTPError(\\\"http://x\\\", 401, \\\"unauthorized\\\", None, None)  # revoked\\nserver.intervals_get = fake_intervals_get\\n\\nthreading.Thread(target=threading.Thread, daemon=True)  # no-op\\nhttpd = server.ThreadingHTTPServer((\\\"127.0.0.1\\\", config.PORT), server.Handler)\\nthreading.Thread(target=httpd.serve_forever, daemon=True).start()\\n\\ndef req(method, path, token=None):\\n    c = http.client.HTTPConnection(\\\"127.0.0.1\\\", config.PORT, timeout=5)\\n    headers = {\\\"Authorization\\\": \\\"Bearer \\\" + token} if token else {}\\n    c.request(method, path, headers=headers)\\n    r = c.getresponse(); body = r.read().decode(); c.close()\\n    return r.status, dict(r.getheaders()), body\\n\\nfails = []\\ndef check(name, cond, extra=\\\"\\\"):\\n    print((\\\"PASS \\\" if cond else \\\"FAIL \\\") + name + (f\\\"  [{extra}]\\\" if extra and not cond else \\\"\\\"))\\n    if not cond: fails.append(name)\\n\\n# 1. GET init is gone; POST without auth -> 401; POST with auth -> JSON url\\ns, _, _ = req(\\\"GET\\\", \\\"/api/intervals/auth/init\\\", \\\"tok-okafor\\\")\\ncheck(\\\"GET /auth/init -> 404 (moved to POST)\\\", s == 404, f\\\"got {s}\\\")\\ns, _, b = req(\\\"POST\\\", \\\"/api/intervals/auth/init\\\")\\ncheck(\\\"POST /auth/init w/o auth -> 401\\\", s == 401, f\\\"got {s}\\\")\\ns, _, b = req(\\\"POST\\\", \\\"/api/intervals/auth/init\\\", \\\"tok-okafor\\\")\\ncheck(\\\"POST /auth/init -> 200\\\", s == 200, f\\\"got {s}\\\")\\nurl = json.loads(b)[\\\"authorize_url\\\"]\\nq = dict(urllib.parse.parse_qsl(urllib.parse.urlsplit(url).query))\\nscope = q[\\\"scope\\\"]\\nareas = [a.split(\\\":\\\")[0] for a in scope.split(\\\",\\\")]\\ncheck(\\\"scope each area once\\\", sorted(areas) == sorted(set(areas)) and \\\"ACTIVITY\\\" in areas and \\\"CALENDAR\\\" in areas and \\\"WELLNESS\\\" in areas, scope)\\ncheck(\\\"no READ+WRITE pair for same area\\\", not any(f\\\"{a}:READ\\\" in scope and f\\\"{a}:WRITE\\\" in scope for a in set(areas)), scope)\\ncheck(\\\"state present\\\", bool(q.get(\\\"state\\\")))\\n\\n# 2. state checks: bad sig and stale -> 400\\ndef make_state(uid, ts):\\n    p = f\\\"{uid}:{ts}\\\"\\n    sig = hmac.new(config.APP_SECRET.encode(), p.encode(), hashlib.sha256).hexdigest()[:32]\\n    return base64.urlsafe_b64encode(f\\\"{p}:{sig}\\\".encode()).decode()\\ns, _, _ = req(\\\"GET\\\", \\\"/api/intervals/callback?code=x&state=\\\" + make_state(\\\"u_okafor\\\", int(time.time()) - 1000), None)\\ncheck(\\\"stale state -> 400\\\", s == 400, f\\\"got {s}\\\")\\ns, _, _ = req(\\\"GET\\\", \\\"/api/intervals/callback?code=x&state=\\\" + make_state(\\\"u_okafor\\\", int(time.time()))[:-2] + \\\"AA\\\", None)\\ncheck(\\\"tampered state -> 400\\\", s == 400, f\\\"got {s}\\\")\\n\\n# 3. full flow for okafor; rivera stays disconnected\\ns, h, _ = req(\\\"GET\\\", \\\"/api/intervals/callback?code=fake-code&state=\\\" + q[\\\"state\\\"], None)\\ncheck(\\\"callback -> 302 to /?connected=1\\\", s == 302 and h.get(\\\"Location\\\") == \\\"/?connected=1\\\", f\\\"{s} {h.get('Location')}\\\")\\ns, _, b = req(\\\"GET\\\", \\\"/api/intervals/status\\\", \\\"tok-okafor\\\")\\nst = json.loads(b)\\ncheck(\\\"status connected\\\", s == 200 and st[\\\"connected\\\"] and st[\\\"athlete\\\"][\\\"id\\\"] == \\\"i111\\\", b)\\ns, _, b = req(\\\"GET\\\", \\\"/api/intervals/status\\\", \\\"tok-rivera\\\")\\ncheck(\\\"rivera still disconnected\\\", s == 200 and not json.loads(b)[\\\"connected\\\"], b)\\nwith server.LOCK:\\n    conn = dict(server.CONNECTIONS[\\\"u_okafor\\\"])\\ncheck(\\\"no refresh_token/expires_at stored\\\", \\\"refresh_token\\\" not in conn and \\\"expires_at\\\" not in conn, json.dumps(conn))\\n\\n# 4. wellness: 200 while alive, then provider revokes -> 409 + disconnected\\ns, _, _ = req(\\\"GET\\\", \\\"/api/intervals/wellness\\\", \\\"tok-okafor\\\")\\ncheck(\\\"wellness 200 while token alive\\\", s == 200, f\\\"got {s}\\\")\\ns, _, b = req(\\\"GET\\\", \\\"/api/intervals/wellness\\\", \\\"tok-okafor\\\")\\ncheck(\\\"wellness 401 from provider -> 409 reconnect\\\", s == 409, f\\\"got {s} {b}\\\")\\ns, _, b = req(\\\"GET\\\", \\\"/api/intervals/status\\\", \\\"tok-okafor\\\")\\ncheck(\\\"status -> disconnected after 401\\\", s == 200 and not json.loads(b)[\\\"connected\\\"], b)\\ns, _, b = req(\\\"GET\\\", \\\"/api/intervals/wellness\\\", \\\"tok-okafor\\\")\\ncheck(\\\"wellness when not connected -> 409\\\", s == 409, f\\\"got {s}\\\")\\n\\n# 5. exchange_code sends only the three fields (fake post_form inspects)\\ncaptured = {}\\ndef fake_post_form(url, fields):\\n    captured[\\\"url\\\"] = url; captured[\\\"fields\\\"] = dict(fields)\\n    return fake_exchange(\\\"fake-code\\\")\\nserver.post_form = fake_post_form\\nimport importlib\\nreal_exchange = server.exchange_code\\nserver.exchange_code = lambda code: fake_post_form(config.INTERVALS_BASE + \\\"/api/oauth/token\\\", {\\n    \\\"client_id\\\": config.CLIENT_ID, \\\"client_secret\\\": config.CLIENT_SECRET, \\\"code\\\": code})\\nserver.exchange_code(\\\"c1\\\")\\ncheck(\\\"token exchange: only client_id/secret/code\\\", set(captured[\\\"fields\\\"]) == {\\\"client_id\\\", \\\"client_secret\\\", \\\"code\\\"}, json.dumps(captured[\\\"fields\\\"]))\\ncheck(\\\"token URL correct\\\", captured[\\\"url\\\"].endswith(\\\"/api/oauth/token\\\"), captured[\\\"url\\\"])\\nserver.exchange_code = real_exchange\\n\\nprint(\\\"\\\\n\\\" + (\\\"ALL PASS\\\" if not fails else \\\"FAILURES: \\\" + \\\", \\\".join(fails)))\\nhttpd.shutdown()\\nEOF\"}"}}]}
