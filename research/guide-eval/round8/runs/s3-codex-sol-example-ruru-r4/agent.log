{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport os, pathlib, subprocess, tempfile\nroot = pathlib.Path.cwd()\nwith tempfile.TemporaryDirectory(prefix='.nightly-test-', dir=root) as td:\n    home = pathlib.Path(td)\n    (home / 'projects/shop').mkdir(parents=True)\n    (home / 'Library/Logs').mkdir(parents=True)\n    (home / 'bin').mkdir()\n    (home / 'mockbin').mkdir()\n    notify = home / 'bin/notify.sh'\n    notify.write_text('#\"'!/bin/sh'\"\\\\nprintf \\\"%s\\\\\\\\n\\\" \\\"\"'$1\" >> \"$HOME/messages\"'\"\\\\n[ \\\"\"'$MOCK_NOTIFY_FAIL\" != 1 ]'\"\\\\n')\n    notify.chmod(0o755)\n    claude = home / 'mockbin/claude'\n    claude.write_text('#\"'!/bin/sh'\"\\\\ncase \\\"\"'$MOCK_MODE\" in'\"\\\\n success) printf \\\"commit review summary\\\\\\\\n\\\";;\\\\n fail) printf \\\"Not logged in\\\\\\\\n\\\" >&2; exit 7;;\\\\n empty) exit 0;;\\\\nesac\\\\n')\n    claude.chmod(0o755)\n    script = root / 'bin/nightly-review.zsh'\n    cases = [('success', 'success', '0'), ('agent failure', 'fail', '7'), ('empty output', 'empty', '1'), ('notify failure', 'success', '1')]\n    for label, mode, expected in cases:\n        messages = home / 'messages'\n        messages.unlink(missing_ok=True)\n        env = dict(os.environ, HOME=str(home), USER='vk', PATH=str(home / 'mockbin') + ':' + os.environ['PATH'], MOCK_MODE=mode, MOCK_NOTIFY_FAIL='1' if label == 'notify failure' else '0')\n        result = subprocess.run(['/bin/zsh', str(script)], env=env, cwd=root, text=True, capture_output=True)\n        msg = messages.read_text().strip() if messages.exists() else ''\n        print(f'{label}: exit={result.returncode} expected={expected}; message={msg\"'!r}; stderr={result.stderr.strip()!r}'\"')\n        assert str(result.returncode) == expected\n        assert bool(msg)\n        assert ('FAILED' in msg) == (label in ('agent failure', 'empty output'))\n    (home / 'projects/shop').rmdir()\n    messages.unlink(missing_ok=True)\n    env['MOCK_NOTIFY_FAIL'] = '0'\n    result = subprocess.run(['/bin/zsh', str(script)], env=env, cwd=root, text=True, capture_output=True)\n    print(f'missing repo: exit={result.returncode}; message={messages.read_text().strip()\"'!r}'\"')\n    assert result.returncode == 1 and 'repo missing' in messages.read_text()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
