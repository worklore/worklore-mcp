{"role":"assistant","tool_calls":[{"type":"function","id":"tool_NQ7sBua0qywQxgEomLHGfOOy","function":{"name":"Bash","arguments":"{\"command\":\"python3 - <<'EOF'\\nimport hashlib, json, os, sys\\nsys.path.insert(0, os.getcwd())\\nimport bot\\n\\n# Redirect data files so the real athletes.json / usage.jsonl stay untouched.\\nbot.ATHLETES_FILE = os.path.join(os.getcwd(), \\\"data\\\", \\\"_verify_athletes.json\\\")\\nbot.USAGE_LOG = os.path.join(os.getcwd(), \\\"logs\\\", \\\"_verify_usage.jsonl\\\")\\n\\ndef approx_tokens(s):  # chars/4 heuristic; enough to show relative cache sizes\\n    return max(1, len(s) // 4)\\n\\nclass SimCache:\\n    \\\"\\\"\\\"Prefix-hash cache like Anthropic's: a breakpoint caches the prefix up to it.\\\"\\\"\\\"\\n    def __init__(self):\\n        self.store = set()\\n    def account(self, req):\\n        read = creation = 0\\n        prefix = hashlib.sha256()\\n        parts = [json.dumps(req[\\\"tools\\\"], sort_keys=True, ensure_ascii=False)]\\n        for blk in req[\\\"system\\\"]:\\n            parts.append(blk[\\\"text\\\"])\\n        for part in parts:\\n            prefix.update(part.encode())\\n            tok = approx_tokens(part)\\n            key = prefix.hexdigest()\\n            if key in self.store:\\n                read += tok\\n            else:\\n                creation += tok\\n                self.store.add(key)\\n        return read, creation\\n\\nclass Block:\\n    def __init__(self, t, **kw):\\n        self.type = t\\n        for k, v in kw.items():\\n            setattr(self, k, v)\\n    def model_dump(self):\\n        d = {\\\"type\\\": self.type}\\n        if self.type == \\\"tool_use\\\":\\n            d.update(id=self.id, name=self.name, input=self.input)\\n        return d\\n\\nclass Usage:\\n    def __init__(self, inp, cre, rea, out):\\n        self.input_tokens = inp; self.cache_creation_input_tokens = cre\\n        self.cache_read_input_tokens = rea; self.output_tokens = out\\n\\nclass Resp:\\n    def __init__(self, content, stop, usage):\\n        self.content = content; self.stop_reason = stop; self.usage = usage\\n\\nclass FakeLLM:\\n    \\\"\\\"\\\"Round 1: call save_fact. Round 2: plain text answer.\\\"\\\"\\\"\\n    def __init__(self, cache):\\n        self.cache = cache\\n    def create(self, **kw):\\n        read, creation = self.cache.account(kw)\\n        inp = approx_tokens(json.dumps(kw[\\\"messages\\\"], ensure_ascii=False)) + read + creation\\n        n = len(kw[\\\"messages\\\"])\\n        if n == 1:\\n            return Resp([Block(\\\"tool_use\\\", id=\\\"tu1\\\", name=\\\"save_fact\\\", input={\\\"fact\\\": \\\"verification fact\\\"})],\\n                        \\\"tool_use\\\", Usage(inp, creation, read, 20))\\n        return Resp([Block(\\\"text\\\", text=\\\"got it\\\")], \\\"end_turn\\\", Usage(inp, creation, read, 8))\\n\\ndef run(label, build_system, uid):\\n    for p in (bot.ATHLETES_FILE, bot.USAGE_LOG):\\n        if os.path.exists(p):\\n            os.remove(p)\\n    bot.build_system = build_system\\n    cache = SimCache()\\n    llm = FakeLLM(cache)\\n    bot.reply(uid, \\\"here is a durable fact about me\\\", llm=llm)   # round1: save_fact, round2: answer\\n    r1 = bot.reply(uid, \\\"thanks\\\", llm=llm)                        # follow-up, facts already changed\\n    usage = [json.loads(l) for l in open(bot.USAGE_LOG)]\\n    post_write = usage[1]   # 2nd round of msg1: right after save_fact\\n    followup = usage[2]     # next message\\n    print(f\\\"--- {label} ---\\\")\\n    for tag, u in ((\\\"round after save_fact\\\", post_write), (\\\"next message\\\", followup)):\\n        print(f\\\"{tag:24} creation={u['cache_creation_input_tokens']:5}  read={u['cache_read_input_tokens']:5}\\\")\\n    return post_write, followup\\n\\n# Old behaviour: single cached block (the pre-fix code, verbatim logic).\\ndef old_build_system(a, today):\\n    text = bot.INSTRUCTIONS + \\\"\\\\n\\\\n\\\" + bot.athlete_context(a, today)\\n    return [{\\\"type\\\": \\\"text\\\", \\\"text\\\": text, \\\"cache_control\\\": {\\\"type\\\": \\\"ephemeral\\\"}}]\\n\\nold_pw, old_fu = run(\\\"OLD (one block)\\\", old_build_system, \\\"42\\\")\\nnew_pw, new_fu = run(\\\"NEW (two blocks)\\\", bot.build_system, \\\"77\\\")\\n\\nstatic_tok = approx_tokens(bot.INSTRUCTIONS)\\ntail_tok = approx_tokens(bot.athlete_context(bot.load_athlete(\\\"77\\\"), __import__(\\\"datetime\\\").date.today()))\\nprint(f\\\"\\\\napprox sizes: static instructions={static_tok}  per-athlete tail={tail_tok}\\\")\\n\\n# 1) static block must be byte-identical across a memory write\\na = bot.load_athlete(\\\"77\\\")\\nb0_before = bot.build_system(a, __import__(\\\"datetime\\\").date.today())[0][\\\"text\\\"]\\na.facts.append(\\\"another fact\\\")\\nb0_after = bot.build_system(a, __import__(\\\"datetime\\\").date.today())[0][\\\"text\\\"]\\nassert b0_before == b0_after == bot.INSTRUCTIONS, \\\"static block changed!\\\"\\nprint(\\\"static block byte-stable across save_fact: OK\\\")\\n\\n# 2) new code: after a save_fact, static prefix still read from cache; only tail re-created\\nassert new_pw[\\\"cache_read_input_tokens\\\"] >= static_tok, \\\"static block was NOT read from cache\\\"\\nassert new_pw[\\\"cache_creation_input_tokens\\\"] <= tail_tok + 5, \\\"tail re-created larger than expected\\\"\\n# 3) old code reproduced the incident from logs/usage.jsonl: full re-creation, zero read\\nassert old_pw[\\\"cache_read_input_tokens\\\"] == 0 and old_pw[\\\"cache_creation_input_tokens\\\"] >= static_tok + tail_tok\\nprint(\\\"new code: save_fact re-creates only the tail, static prefix stays cached: OK\\\")\\nprint(\\\"old code reproduces logs/usage.jsonl (creation=~full prompt, read=0): OK\\\")\\nprint(\\\"\\\\nALL CHECKS PASSED\\\")\\nEOF\",\"timeout\":60}"}}]}
