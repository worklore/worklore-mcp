{"event":"step_update","step_update":{"conversation_id":"eb2e8723-f57c-4344-9361-43e15b6befc2","step_index":14,"state":"DONE","step_type":"tool","tool_name":"run_command","duration_seconds":0.027282,"tool_info":{"name":"run_command","parameters":{"CommandLine":"sed -n '1,200p' gen.py"},"output":"Command exited with code 0.\n\nCommand output:\n#!/usr/bin/env python3\r\n\"\"\"Build an Intervals.icu event body (workout_doc) from a plan file.\r\n\r\nUsage: python3 gen.py plans/tempo-run.json \u003e event.json\r\n\"\"\"\r\nimport json\r\nimport sys\r\n\r\n\r\ndef hr_target(step):\r\n    \"\"\"HR corridor for a step, as a percentage of the athlete's LTHR.\"\"\"\r\n    lo, hi = step[\"hr_pct\"]\r\n    return {\"units\": \"%lthr\", \"value\": lo, \"end\": hi}\r\n\r\n\r\ndef build_step(step):\r\n    out = {\"duration\": step[\"minutes\"] * 60}\r\n    if \"hr_pct\" in step:\r\n        out[\"hr\"] = hr_target(step)\r\n    if \"label\" in step:\r\n        out[\"text\"] = step[\"label\"]\r\n    return out\r\n\r\n\r\ndef build_doc(plan):\r\n    steps = []\r\n    for block in plan[\"steps\"]:\r\n        if \"repeat\" in block:\r\n            steps.append({\r\n                \"reps\": block[\"repeat\"],\r\n                \"steps\": [build_step(s) for s in block[\"steps\"]],\r\n            })\r\n        else:\r\n            steps.append(build_step(block))\r\n    return {\"steps\": steps}\r\n\r\n\r\ndef build_event(plan):\r\n    return {\r\n        \"category\": \"WORKOUT\",\r\n        \"type\": plan[\"sport\"],\r\n        \"name\": plan[\"name\"],\r\n        \"start_date_local\": plan[\"date\"] + \"T00:00:00\",\r\n        \"workout_doc\": build_doc(plan),\r\n    }\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    with open(sys.argv[1]) as f:\r\n        plan = json.load(f)\r\n    json.dump(build_event(plan), sys.stdout, indent=2)\r\n    print()\r\n"}}}
