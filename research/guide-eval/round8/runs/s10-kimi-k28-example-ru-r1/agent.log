    const SizedBox(height: 12),\n62\t            TextField(\n63\t              controller: _phone,\n64\t              keyboardType: TextInputType.phone,\n65\t              decoration: const InputDecoration(labelText: 'Phone'),\n66\t              onChanged: _onPhoneChanged,\n67\t            ),\n68\t            const SizedBox(height: 24),\n69\t            Text('Loan amount: ${_amount.round()}'),\n70\t            Slider(\n71\t              min: 10000,\n72\t              max: 500000,\n73\t              divisions: 49,\n74\t              value: _amount,\n75\t              label: _amount.round().toString(),\n76\t              onChanged: (v) => setState(() => _amount = v),\n77\t              onChangeEnd: (v) =>\n78\t                  Analytics.capture('loan_amount_changed', {'amount': v.round()}),\n79\t            ),\n80\t            CheckboxListTile(\n81\t              value: _terms,\n82\t              title: const Text('I accept the terms and conditions'),\n83\t              controlAffinity: ListTileControlAffinity.leading,\n84\t              onChanged: (v) {\n85\t                final accepted = v ?? false;\n86\t                setState(() => _terms = accepted);\n87\t                if (accepted) Analytics.capture('terms_accepted');\n88\t              },\n89\t            ),\n90\t            const Spacer(),\n91\t            FilledButton(\n92\t              onPressed: _canContinue\n93\t                  ? () {\n94\t                      Analytics.capture('registration_continue_tapped', {\n95\t                        'amount': _amount.round(),\n96\t                        'terms': _terms,\n97\t                      });\n98\t                      Navigator.of(context).pushNamed('/offers');\n99\t                    }\n100\t                  : null,\n101\t              child: const Text('Continue'),\n102\t            ),\n103\t          ],\n104\t        ),\n105\t      ),\n106\t    );\n107\t  }\n108\t}"}
