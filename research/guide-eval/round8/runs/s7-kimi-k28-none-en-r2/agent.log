{"role":"assistant","tool_calls":[{"type":"function","id":"tool_btMjDc0VffvqIA54fLfDuESi","function":{"name":"Edit","arguments":"{\"new_string\":\"def store_connection(user_id, tok):\\n    athlete = tok.get(\\\"athlete\\\") or {}\\n    # Intervals.icu tokens do not expire: its token response carries no\\n    # expires_in and no refresh_token, so only set an expiry when the\\n    # provider actually says the token is short-lived.\\n    expires_in = tok.get(\\\"expires_in\\\")\\n    expires_at = time.time() + int(expires_in) if expires_in else None\\n    if expires_at:\\n        log(f\\\"{user_id}: token expires in {int(expires_in)}s\\\")\\n    with LOCK:\\n        CONNECTIONS[user_id] = {\\n            \\\"athlete_id\\\": athlete.get(\\\"id\\\"), \\\"athlete_name\\\": athlete.get(\\\"name\\\"),\\n            \\\"access_token\\\": tok[\\\"access_token\\\"], \\\"refresh_token\\\": tok.get(\\\"refresh_token\\\"),\\n            \\\"scope\\\": tok.get(\\\"scope\\\"), \\\"expires_at\\\": expires_at, \\\"status\\\": \\\"connected\\\",\\n        }\\n    log(f\\\"{user_id}: connected as athlete {athlete.get('id')}\\\")\\n\\n\\ndef refresh_due(now):\\n    \\\"\\\"\\\"Renew tokens that are nearing expiry, or expire the unrenewable.\\\"\\\"\\\"\\n    with LOCK:\\n        for uid, c in CONNECTIONS.items():\\n            if c[\\\"status\\\"] != \\\"connected\\\" or c[\\\"expires_at\\\"] is None:\\n                continue\\n            if c[\\\"expires_at\\\"] - now > 300:\\n                continue\\n            if not c[\\\"refresh_token\\\"]:\\n                log(f\\\"{uid}: token expiry passed and no refresh token on file -> expired, reconnect\\\")\\n                c.update(status=\\\"expired, reconnect\\\", access_token=None)\\n                continue\\n            try:\\n                tok = post_form(TOKEN_URL, {\\n                    \\\"grant_type\\\": \\\"refresh_token\\\", \\\"refresh_token\\\": c[\\\"refresh_token\\\"],\\n                    \\\"client_id\\\": config.CLIENT_ID, \\\"client_secret\\\": config.CLIENT_SECRET,\\n                })\\n                c.update(access_token=tok[\\\"access_token\\\"],\\n                         refresh_token=tok.get(\\\"refresh_token\\\", c[\\\"refresh_token\\\"]),\\n                         expires_at=now + int(tok[\\\"expires_in\\\"]))\\n                log(f\\\"{uid}: token refreshed\\\")\\n            except Exception as e:\\n                log(f\\\"{uid}: refresh failed ({e}) -> expired, reconnect\\\")\\n                c.update(status=\\\"expired, reconnect\\\", access_token=None)\\n\\n\\ndef refresh_tokens():\\n    \\\"\\\"\\\"Background pass: renew access tokens shortly before they expire.\\\"\\\"\\\"\\n    while True:\\n        time.sleep(config.REFRESH_INTERVAL)\\n        refresh_due(time.time())\",\"old_string\":\"def store_connection(user_id, tok):\\n    expires_in = int(tok.get(\\\"expires_in\\\") or DEFAULT_TOKEN_TTL)\\n    refresh = tok.get(\\\"refresh_token\\\")\\n    if not refresh:\\n        log(f\\\"{user_id}: no refresh_token in response, scheduling expiry in {expires_in}s\\\")\\n    athlete = tok.get(\\\"athlete\\\") or {}\\n    with LOCK:\\n        CONNECTIONS[user_id] = {\\n            \\\"athlete_id\\\": athlete.get(\\\"id\\\"), \\\"athlete_name\\\": athlete.get(\\\"name\\\"),\\n            \\\"access_token\\\": tok[\\\"access_token\\\"], \\\"refresh_token\\\": refresh,\\n            \\\"scope\\\": tok.get(\\\"scope\\\"), \\\"expires_at\\\": time.time() + expires_in, \\\"status\\\": \\\"connected\\\",\\n        }\\n    log(f\\\"{user_id}: connected as athlete {athlete.get('id')} (expires in {expires_in}s)\\\")\\n\\n\\ndef refresh_tokens():\\n    \\\"\\\"\\\"Background pass: renew access tokens shortly before they expire.\\\"\\\"\\\"\\n    while True:\\n        time.sleep(config.REFRESH_INTERVAL)\\n        now = time.time()\\n        with LOCK:\\n            for uid, c in CONNECTIONS.items():\\n                if c[\\\"status\\\"] != \\\"connected\\\" or c[\\\"expires_at\\\"] - now > 300:\\n                    continue\\n                if not c[\\\"refresh_token\\\"]:\\n                    log(f\\\"{uid}: token expiry passed and no refresh token on file -> expired, reconnect\\\")\\n                    c.update(status=\\\"expired, reconnect\\\", access_token=None)\\n                    continue\\n                try:\\n                    tok = post_form(TOKEN_URL, {\\n                        \\\"grant_type\\\": \\\"refresh_token\\\", \\\"refresh_token\\\": c[\\\"refresh_token\\\"],\\n                        \\\"client_id\\\": config.CLIENT_ID, \\\"client_secret\\\": config.CLIENT_SECRET,\\n                    })\\n                    c.update(access_token=tok[\\\"access_token\\\"],\\n                             refresh_token=tok.get(\\\"refresh_token\\\", c[\\\"refresh_token\\\"]),\\n                             expires_at=now + int(tok[\\\"expires_in\\\"]))\\n                    log(f\\\"{uid}: token refreshed\\\")\\n                except Exception as e:\\n                    log(f\\\"{uid}: refresh failed ({e}) -> expired, reconnect\\\")\\n                    c.update(status=\\\"expired, reconnect\\\", access_token=None)\",\"path\":\"server.py\"}"}}]}
