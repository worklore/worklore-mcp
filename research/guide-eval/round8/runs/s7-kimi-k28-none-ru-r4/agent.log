{"role":"assistant","content":"Правки внесены. Теперь E2E-проверка: подниму локальный заглушечный «Intervals.icu» (чтобы ничего не отправлять наружу) и прогоню весь флоу подключения, включая фоновый refresher.","tool_calls":[{"type":"function","id":"tool_RIJKtStg4vd4W1RYhRAmgYv7","function":{"name":"Write","arguments":"{\"content\":\"#!/usr/bin/env python3\\n\\\"\\\"\\\"E2E check of the Intervals.icu connection flow against a LOCAL stub.\\n\\nNothing leaves the machine: INTERVALS_BASE points at 127.0.0.1. The stub\\nmimics the real provider: token response without expires_in/refresh_token,\\n/wellness list endpoint.\\n\\\"\\\"\\\"\\nimport json, os, sys, threading, time, urllib.parse, urllib.request\\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\\n\\nos.environ[\\\"INTERVALS_BASE\\\"] = \\\"http://127.0.0.1:8899\\\"\\nos.environ.setdefault(\\\"INTERVALS_SCOPES\\\", \\\"\\\")\\n\\nSTUB = ThreadingHTTPServer((\\\"127.0.0.1\\\", 8899), type(\\\"Stub\\\", (BaseHTTPRequestHandler,), {\\n    \\\"log_message\\\": lambda self, *a: None,\\n    \\\"do_POST\\\": lambda self: self._post(),\\n    \\\"do_GET\\\": lambda self: self._get(),\\n    \\\"_post\\\": lambda self: (\\n        setattr(self, \\\"_body\\\", json.dumps(\\n            {\\\"token_type\\\": \\\"Bearer\\\", \\\"access_token\\\": \\\"tok-live-1\\\",\\n             \\\"scope\\\": \\\"ACTIVITY:WRITE,WELLNESS:READ\\\",\\n             \\\"athlete\\\": {\\\"id\\\": \\\"i98765\\\", \\\"name\\\": \\\"C. Okafor\\\"}}\\n            if \\\"code=\\\" in self.rfile.read(int(self.headers[\\\"Content-Length\\\"])).decode()\\n            else {\\\"token_type\\\": \\\"Bearer\\\", \\\"access_token\\\": \\\"tok-rotated\\\",\\n                  \\\"expires_in\\\": 60, \\\"refresh_token\\\": \\\"re-2\\\"}).encode()),\\n        self.send_response(200), self.send_header(\\\"Content-Type\\\", \\\"application/json\\\"),\\n        self.send_header(\\\"Content-Length\\\", str(len(self._body))), self.end_headers(),\\n        self.wfile.write(self._body)),\\n    \\\"_get\\\": lambda self: (\\n        setattr(self, \\\"_b\\\", b'[{\\\"id\\\": \\\"2026-11-07\\\", \\\"weight\\\": 70.2}]'),\\n        self.send_response(200), self.send_header(\\\"Content-Type\\\", \\\"application/json\\\"),\\n        self.send_header(\\\"Content-Length\\\", str(len(self._b))), self.end_headers(),\\n        self.wfile.write(self._b)),\\n}))\\nthreading.Thread(target=STUB.serve_forever, daemon=True).start()\\n\\nimport config\\nconfig.REFRESH_INTERVAL = 1\\nimport server\\n\\nAPP = ThreadingHTTPServer((\\\"127.0.0.1\\\", config.PORT), server.Handler)\\nthreading.Thread(target=APP.serve_forever, daemon=True).start()\\nthreading.Thread(target=server.refresh_tokens, daemon=True).start()\\n\\nFAILS = []\\ndef check(name, cond, extra=\\\"\\\"):\\n    print((\\\"PASS \\\" if cond else \\\"FAIL \\\") + name + (f\\\"  [{extra}]\\\" if extra else \\\"\\\"))\\n    if not cond:\\n        FAILS.append(name)\\n\\nclass NoRedirect(urllib.request.HTTPRedirectHandler):\\n    def redirect_request(self, *a, **k):\\n        return None\\nOPENER = urllib.request.build_opener(NoRedirect)\\n\\ndef get(path, token=None, raw=False):\\n    req = urllib.request.Request(f\\\"http://127.0.0.1:{config.PORT}{path}\\\")\\n    if token:\\n        req.add_header(\\\"Authorization\\\", \\\"Bearer \\\" + token)\\n    try:\\n        r = OPENER.open(req, timeout=10)\\n        return r.status, r.headers, r.read()\\n    except urllib.error.HTTPError as e:\\n        return e.code, e.headers, e.read()\\n\\n# 1. status before connect\\ns, _, b = get(\\\"/api/intervals/status\\\", \\\"tok-okafor\\\")\\ncheck(\\\"status: not connected yet\\\", s == 200 and json.loads(b)[\\\"connected\\\"] is False)\\n\\n# 2. unauthenticated init still rejected (401), init via fetch-style call works\\ns, _, _ = get(\\\"/api/intervals/auth/init\\\")\\ncheck(\\\"auth/init without header -> 401\\\", s == 401, str(s))\\ns, _, b = get(\\\"/api/intervals/auth/init\\\", \\\"tok-okafor\\\")\\ncheck(\\\"auth/init with Bearer -> 200 JSON\\\", s == 200 and b'\\\"url\\\"' in b, str(s))\\nurl = json.loads(b)[\\\"url\\\"]\\nqs = dict(urllib.parse.parse_qsl(urllib.parse.urlsplit(url).query))\\ncheck(\\\"authorize url: no CALENDAR scopes\\\", \\\"CALENDAR\\\" not in qs.get(\\\"scope\\\", \\\"\\\"), qs.get(\\\"scope\\\", \\\"\\\"))\\ncheck(\\\"authorize url: client_id/redirect_uri/state present\\\",\\n      bool(qs.get(\\\"client_id\\\")) and bool(qs.get(\\\"redirect_uri\\\")) and bool(qs.get(\\\"state\\\")))\\n\\n# 3. OAuth callback (Intervals redirect) -> 302, connection stored non-expiring\\ns, h, _ = get(f\\\"/api/intervals/callback?code=code-1&state={urllib.parse.quote(qs['state'])}\\\")\\ncheck(\\\"callback -> 302 to /?connected=1\\\", s == 302 and h.get(\\\"Location\\\") == \\\"/?connected=1\\\",\\n      f\\\"{s} {h.get('Location')}\\\")\\nc = server.CONNECTIONS.get(\\\"u_okafor\\\", {})\\ncheck(\\\"stored token is non-expiring (expires_at None)\\\", c.get(\\\"expires_at\\\") is None, repr(c.get(\\\"expires_at\\\")))\\ncheck(\\\"stored athlete + status\\\", c.get(\\\"athlete_id\\\") == \\\"i98765\\\" and c.get(\\\"status\\\") == \\\"connected\\\")\\n\\n# 4. status + wellness through the stub\\ns, _, b = get(\\\"/api/intervals/status\\\", \\\"tok-okafor\\\")\\ncheck(\\\"status: connected\\\", s == 200 and json.loads(b)[\\\"connected\\\"] is True)\\ns, _, b = get(\\\"/api/intervals/wellness\\\", \\\"tok-okafor\\\")\\ncheck(\\\"wellness proxied from stub\\\", s == 200 and json.loads(b)[0][\\\"id\\\"] == \\\"2026-11-07\\\")\\n\\n# 5. refresher must NOT kill non-expiring connections (the 1-hour bug)\\ntime.sleep(2.5)\\ncheck(\\\"after refresher passes: still connected\\\", server.CONNECTIONS[\\\"u_okafor\\\"][\\\"status\\\"] == \\\"connected\\\")\\n\\n# 6. refresher still handles expiring tokens: refresh path\\nwith server.LOCK:\\n    server.CONNECTIONS[\\\"u_okafor\\\"].update(expires_at=time.time() + 1, refresh_token=\\\"re-1\\\")\\ntime