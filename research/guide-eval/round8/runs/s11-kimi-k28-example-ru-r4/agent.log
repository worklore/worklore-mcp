{"role":"tool","tool_call_id":"tool_1axPVUt5zbfkqze3tqdozCV9","content":"1\timport os\n2\timport sys\n3\timport unittest\n4\t\n5\tsys.path.insert(0, os.path.join(os.path.dirname(__file__), \"..\", \"src\"))\n6\tsys.path.insert(0, os.path.dirname(__file__))\n7\t\n8\timport app  # noqa: E402\n9\tfrom fake_dynamo import FakeTable  # noqa: E402\n10\t\n11\t\n12\tclass PublishTest(unittest.TestCase):\n13\t    def test_publish_stores_story(self):\n14\t        table = FakeTable()\n15\t        story = {\n16\t            \"slug\": \"why-my-cron-ran-twice\",\n17\t            \"title\": \"Why my cron ran twice\",\n18\t            \"tags\": [\"cron\", \"linux\"],\n19\t            \"body\": \"Two crontabs, one for root and one for me, both had the line.\",\n20\t        }\n21\t        stored = app.publish(table, story)\n22\t        self.assertEqual(stored[\"slug\"], \"why-my-cron-ran-twice\")\n23\t        self.assertEqual(table.get_item(Key={\"slug\": \"why-my-cron-ran-twice\"})[\"Item\"][\"title\"], \"Why my cron ran twice\")\n24\t        self.assertEqual(table.scan()[\"Count\"], 1)\n25\t\n26\t\n27\tif __name__ == \"__main__\":\n28\t    unittest.main()"}
{"role":"tool","tool_call_id":"tool_XuZ1hqcAF59So6xr81FkFcjW","content":"1\t\"\"\"In-memory stand-in for a boto3 DynamoDB Table resource.\n2\t\n3\tIt stores items in a dict and validates values the way boto3's TypeSerializer\n4\tdoes, so a test fails on the same inputs a real table would reject.\n5\t\"\"\"\n6\tfrom decimal import Decimal\n7\t\n8\t\n9\tdef _check(value, path=\"Item\"):\n10\t    if isinstance(value, bool) or value is None or isinstance(value, (int, str, bytes, Decimal)):\n11\t        return\n12\t    if isinstance(value, float):\n13\t        raise TypeError(\"Float types are not supported. Use Decimal types instead.\")\n14\t    if isinstance(value, dict):\n15\t        for k, v in value.items():\n16\t            _check(v, f\"{path}.{k}\")\n17\t        return\n18\t    if isinstance(value, (list, tuple, set, frozenset)):\n19\t        for i, v in enumerate(value):\n20\t            _check(v, f\"{path}[{i}]\")\n21\t        return\n22\t    raise TypeError(f\"Unsupported type {type(value)!r} for value at {path}\")\n23\t\n24\t\n25\tclass FakeTable:\n26\t    def __init__(self, key=\"slug\"):\n27\t        self.key = key\n28\t        self.items = {}\n29\t\n30\t    def put_item(self, Item, **kwargs):\n31\t        _check(Item)\n32\t        if self.key not in Item:\n33\t            raise ValueError(f\"item is missing the key attribute {self.key!r}\")\n34\t        self.items[Item[self.key]] = dict(Item)\n35\t        return {\"ResponseMetadata\": {\"HTTPStatusCode\": 200}}\n36\t\n37\t    def get_item(self, Key, **kwargs):\n38\t        item = self.items.get(Key[self.key])\n39\t        return {\"Item\": dict(item)} if item is not None else {}\n40\t\n41\t    def scan(self, **kwargs):\n42\t        return {\"Items\": [dict(v) for v in self.items.values()], \"Count\": len(self.items)}"}
