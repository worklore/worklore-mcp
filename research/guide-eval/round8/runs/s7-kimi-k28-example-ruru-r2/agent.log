{"role":"assistant","tool_calls":[{"type":"function","id":"tool_y3J97yzgJYHvOo5MyvZHvr1V","function":{"name":"Write","arguments":"{\"content\":\"#!/usr/bin/env python3\\n\\\"\\\"\\\"Local stand-in for Intervals.icu during testing (no external calls).\\n\\nMimics the provider's quirks: token endpoint rejects extra fields, token\\nresponse has no refresh_token / expires_in, wellness 401s for a dead token.\\n\\\"\\\"\\\"\\nimport json, threading\\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\\n\\nLAST_FIELDS = {}\\nSTATE = {\\\"token\\\": \\\"live-token\\\"}\\nLOCK = threading.Lock()\\n\\n\\nclass H(BaseHTTPRequestHandler):\\n    def log_message(self, *a):\\n        pass\\n\\n    def send_json(self, code, obj):\\n        body = json.dumps(obj).encode()\\n        self.send_response(code)\\n        self.send_header(\\\"Content-Type\\\", \\\"application/json\\\")\\n        self.send_header(\\\"Content-Length\\\", str(len(body)))\\n        self.end_headers()\\n        self.wfile.write(body)\\n\\n    def do_GET(self):\\n        if self.path == \\\"/last-token-fields\\\":\\n            return self.send_json(200, LAST_FIELDS)\\n        if self.path.startswith(\\\"/api/v1/athlete/i98765/wellness\\\"):\\n            auth = self.headers.get(\\\"Authorization\\\", \\\"\\\")\\n            with LOCK:\\n                tok = STATE[\\\"token\\\"]\\n            if auth == \\\"Bearer \\\" + tok:\\n                return self.send_json(200, {\\\"wellness\\\": [{\\\"id\\\": 1, \\\"sleep_score\\\": 87}]})\\n            return self.send_json(401, {\\\"error\\\": \\\"invalid_token\\\"})\\n        self.send_json(404, {\\\"error\\\": \\\"not found\\\"})\\n\\n    def do_POST(self):\\n        if self.path == \\\"/api/oauth/token\\\":\\n            n = int(self.headers.get(\\\"Content-Length\\\", 0))\\n            import urllib.parse\\n            fields = dict(urllib.parse.parse_qsl(self.rfile.read(n).decode()))\\n            with LOCK:\\n                LAST_FIELDS.clear()\\n                LAST_FIELDS.update(fields)\\n            # provider behavior: only client_id, client_secret, code are wanted\\n            if \\\"grant_type\\\" in fields or \\\"redirect_uri\\\" in fields:\\n                return self.send_json(400, {\\\"error\\\": \\\"invalid_request\\\"})\\n            if fields.get(\\\"code\\\") != \\\"good-code\\\":\\n                return self.send_json(400, {\\\"error\\\": \\\"bad code\\\"})\\n            return self.send_json(200, {\\n                \\\"token_type\\\": \\\"bearer\\\", \\\"access_token\\\": \\\"live-token\\\",\\n                \\\"scope\\\": \\\"ACTIVITY:WRITE,WELLNESS:READ,CALENDAR:WRITE\\\",\\n                \\\"athlete\\\": {\\\"id\\\": \\\"i98765\\\", \\\"name\\\": \\\"C. Okafor\\\"},\\n            })\\n        self.send_json(404, {\\\"error\\\": \\\"not found\\\"})\\n\\n\\nThreadingHTTPServer((\\\"127.0.0.1\\\", 8899), H).serve_forever()\\n\",\"path\":\"mock_intervals.py\"}"}}]}
