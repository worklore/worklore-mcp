POST, not a plain link: a full page navigation would lose the\\n      // Authorization header. The server returns the authorize URL as JSON.\\n      const r = await api(\\\"/api/intervals/auth/init\\\", { method: \\\"POST\\\" });\\n      window.location.assign(r.authorize_url);\\n    };\\n    const d = document.getElementById(\\\"disconnect\\\");\"}"}}]}
