{"role":"assistant","tool_calls":[{"type":"function","id":"tool_KYBW0ZxE7wcnI0eZc1FTVO0f","function":{"name":"Write","arguments":"{\"content\":\"#!/usr/bin/env python3\\n\\\"\\\"\\\"End-to-end test of the fixed Intervals.icu integration against mock_intervals.\\\"\\\"\\\"\\nimport json, urllib.parse as up, urllib.request\\n\\nB = \\\"http://127.0.0.1:18991\\\"\\nM = \\\"http://127.0.0.1:8899\\\"\\nH = {\\\"Authorization\\\": \\\"Bearer tok-okafor\\\"}\\npassed = []\\n\\n\\ndef req(method, url, headers=None, data=None):\\n    r = urllib.request.Request(url, method=method, data=data,\\n                               headers=headers or {})\\n    try:\\n        with urllib.request.urlopen(r, timeout=10) as resp:\\n            return resp.status, dict(resp.headers), resp.read().decode()\\n    except urllib.error.HTTPError as e:\\n        return e.code, dict(e.headers), e.read().decode()\\n\\n\\ndef check(name, cond, detail=\\\"\\\"):\\n    assert cond, f\\\"FAIL: {name} {detail}\\\"\\n    passed.append(name)\\n    print(f\\\"ok  - {name}\\\")\\n\\n\\n# 1. init without auth -> 401\\ns, _, b = req(\\\"POST\\\", B + \\\"/api/intervals/auth/init\\\")\\ncheck(\\\"init without token -> 401\\\", s == 401, b)\\n\\n# 2. init with auth -> authorize_url, scopes unique\\ns, _, b = req(\\\"POST\\\", B + \\\"/api/intervals/auth/init\\\", H)\\ncheck(\\\"init with token -> 200\\\", s == 200, b)\\nauth = json.loads(b)[\\\"authorize_url\\\"]\\nq = up.parse_qs(up.urlsplit(auth).query)\\nscopes = q[\\\"scope\\\"][0].split(\\\",\\\")\\nareas = [s.split(\\\":\\\")[0] for s in scopes]\\ncheck(\\\"each scope area exactly once\\\", len(areas) == len(set(areas)), scopes)\\ncheck(\\\"no READ alongside WRITE\\\", not any(s.endswith(\\\":READ\\\") and s.replace(\\\":READ\\\", \\\":WRITE\\\") in scopes for s in scopes))\\nstate = q[\\\"state\\\"][0]\\n\\n# 3. old GET init gone\\ns, _, _ = req(\\\"GET\\\", B + \\\"/api/intervals/auth/init\\\", H)\\ncheck(\\\"GET init -> 404\\\", s == 404)\\n\\n# 4. bad state rejected\\ns, _, b = req(\\\"GET\\\", B + \\\"/api/intervals/callback?code=x&state=garbage\\\")\\ncheck(\\\"callback bad state -> 400\\\", s == 400, b)\\n\\n# 5. full callback\\ns, hdr, b = req(\\\"GET\\\", B + \\\"/api/intervals/callback?code=good-code&state=\\\" + up.quote(state))\\ncheck(\\\"callback valid -> 302 to /?connected=1\\\", s == 302 and hdr.get(\\\"Location\\\") == \\\"/?connected=1\\\", f\\\"{s} {hdr.get('Location')}\\\")\\n\\n# 6. provider saw exactly client_id/client_secret/code\\ns, _, b = req(\\\"GET\\\", M + \\\"/last-token-fields\\\")\\nfields = json.loads(b)\\ncheck(\\\"token exchange fields = client_id/client_secret/code only\\\",\\n      set(fields) == {\\\"client_id\\\", \\\"client_secret\\\", \\\"code\\\"}, fields)\\n\\n# 7. connected\\ns, _, b = req(\\\"GET\\\", B + \\\"/api/intervals/status\\\", H)\\nst = json.loads(b)\\ncheck(\\\"status connected as C. Okafor / i98765\\\",\\n      s == 200 and st[\\\"connected\\\"] and st[\\\"athlete\\\"][\\\"name\\\"] == \\\"C. Okafor\\\", b)\\n\\n# 8. wellness proxy works\\ns, _, b = req(\\\"GET\\\", B + \\\"/api/intervals/wellness\\\", H)\\ncheck(\\\"wellness -> 200 with data\\\", s == 200 and \\\"sleep_score\\\" in b, b)\\n\\n# 9. token dies on provider side (revoked) -> lazy 401 handling\\nreq(\\\"POST\\\", M + \\\"/test/set-token\\\", data=b\\\"revoked\\\")\\ns, _, b = req(\\\"GET\\\", B + \\\"/api/intervals/wellness\\\", H)\\ncheck(\\\"wellness with dead token -> 409\\\", s == 409, b)\\ns, _, b = req(\\\"GET\\\", B + \\\"/api/intervals/status\\\", H)\\nst = json.loads(b)\\ncheck(\\\"status after 401 -> connected:false, reconnect\\\", not st[\\\"connected\\\"] and st[\\\"status\\\"] == \\\"reconnect\\\", b)\\n\\n# 10. reconnect flow works again (no stuck 'expired' state)\\ns, _, b = req(\\\"POST\\\", B + \\\"/api/intervals/auth/init\\\", H)\\nauth = json.loads(b)[\\\"authorize_url\\\"]\\nstate = up.parse_qs(up.urlsplit(auth).query)[\\\"state\\\"][0]\\nreq(\\\"POST\\\", M + \\\"/test/set-token\\\", data=b\\\"live-token\\\")\\ns, hdr, _ = req(\\\"GET\\\", B + \\\"/api/intervals/callback?code=good-code&state=\\\" + up.quote(state))\\ncheck(\\\"reconnect callback -> 302\\\", s == 302, str(s))\\ns, _, b = req(\\\"GET\\\", B + \\\"/api/intervals/wellness\\\", H)\\ncheck(\\\"wellness after reconnect -> 200\\\", s == 200, b)\\n\\n# 11. disconnect\\ns, _, _ = req(\\\"POST\\\", B + \\\"/api/intervals/disconnect\\\", H)\\ns, _, b = req(\\\"GET\\\", B + \\\"/api/intervals/status\\\", H)\\ncheck(\\\"disconnect -> disconnected\\\", s == 200 and not json.loads(b)[\\\"connected\\\"], b)\\n\\nprint(f\\\"\\\\nALL {len(passed)} CHECKS PASSED\\\")\\n\",\"path\":\"test_e2e.py\"}"}}]}
