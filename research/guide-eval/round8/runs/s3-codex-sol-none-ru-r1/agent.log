{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport os, pathlib, subprocess, tempfile\nroot = pathlib.Path.cwd()\nwith tempfile.TemporaryDirectory(prefix='.nightly-test-', dir=root) as tmp:\n    home = pathlib.Path(tmp)\n    for name in ('bin', 'projects/shop', 'Library/Logs'):\n        (home / name).mkdir(parents=True)\n    scripts = {\n        'notify.sh': '#\"'!/bin/sh'\"\\\\nprintf \\\"%s\\\\\\\\n\\\" \\\"\"'$1\" > \"$HOME/notice\"'\"\\\\n',\n        'security': '#\"'!/bin/sh'\"\\\\n[ \\\"\"'${KEY_MODE:-}\" = present ] || exit 44'\"\\\\nprintf \\\"%s\\\\\\\\n\\\" local-test-key\\\\n',\n        'claude': '#\"'!/bin/sh'\"\\\\ncase \\\"\"'$CLAUDE_MODE\" in'\"\\\\n success) [ \\\"\"'${ANTHROPIC_API_KEY:-}\" = local-test-key ] || exit 77; printf \"%s'\"\\\\\\\\n\\\" \\\"Review summary\\\";;\\\\n fail) printf \\\"%s\\\\\\\\n\\\" \\\"Not logged in\\\" >&2; exit 42;;\\\\n empty) exit 0;;\\\\nesac\\\\n',\n    }\n    for name, body in scripts.items():\n        p = home / 'bin' / name\n        p.write_text(body)\n        p.chmod(0o755)\n    env = os.environ.copy()\n    env.update(HOME=str(home), PATH=str(home / 'bin') + ':' + env['PATH'], KEY_MODE='present')\n    env.pop('ANTHROPIC_API_KEY', None)\n    for mode in ('success', 'fail', 'empty'):\n        env['CLAUDE_MODE'] = mode\n        result = subprocess.run(['/bin/zsh', str(root / 'bin/nightly-review.zsh')], env=env, capture_output=True, text=True)\n        print(f'{mode}: exit={result.returncode}; notice={(home / \\\"notice\\\").read_text().strip()}')\n    (home / 'projects/shop').rmdir()\n    (home / 'projects').rmdir()\n    env['CLAUDE_MODE'] = 'success'\n    result = subprocess.run(['/bin/zsh', str(root / 'bin/nightly-review.zsh')], env=env, capture_output=True, text=True)\n    print(f'missing_repo: exit={result.returncode}; notice={(home / \\\"notice\\\").read_text().strip()}')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
