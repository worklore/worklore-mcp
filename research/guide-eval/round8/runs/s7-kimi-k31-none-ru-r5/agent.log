refresh_token in response, scheduling expiry in {expires_in}s\")\nserver.py:74:            \"access_token\": tok[\"access_token\"], \"refresh_token\": refresh,\nserver.py:75:            \"scope\": tok.get(\"scope\"), \"expires_at\": time.time() + expires_in, \"status\": \"connected\",\nserver.py:77:    log(f\"{user_id}: connected as athlete {athlete.get('id')} (expires in {expires_in}s)\")\nserver.py:80:def refresh_tokens():\nserver.py:89:                if not c[\"refresh_token\"]:\nserver.py:95:                        \"grant_type\": \"refresh_token\", \"refresh_token\": c[\"refresh_token\"],\nserver.py:99:                             refresh_token=tok.get(\"refresh_token\", c[\"refresh_token\"]),\nserver.py:100:                             expires_at=now + int(tok[\"expires_in\"]))\nserver.py:167:        if url.path == \"/api/intervals/auth/init\":\nserver.py:194:                  \"scope\": config.SCOPES, \"state\": sign_state(user[\"id\"])}\nserver.py:221:        self.send_json(200, {\"connected\": True, \"status\": \"connected\", \"scope\": c[\"scope\"],\nserver.py:242:    threading.Thread(target=refresh_tokens, daemon=True).start()"}
