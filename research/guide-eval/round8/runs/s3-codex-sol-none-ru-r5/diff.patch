+ERR="$HOME/Library/Logs/nightly-review-$(date +%F).err"
 NOTIFY="$HOME/bin/notify.sh"
 
 SINCE=$(date -v-1d +%F)
@@ -15,12 +16,11 @@ Do not modify any file."
 
 cd "$REPO" || { "$NOTIFY" "nightly review: repo missing"; exit 1; }
 
-claude -p "$PROMPT" --output-format text > "$OUT"
-status=$?
-
-if [ $status -ne 0 ]; then
-  "$NOTIFY" "nightly review FAILED (exit $status), see $OUT"
-  exit $status
+if claude -p "$PROMPT" --output-format text > "$OUT" 2> "$ERR"; then
+  "$NOTIFY" "nightly review done: $(head -c 300 "$OUT")"
+else
+  claude_exit=$?
+  reason=$(head -c 300 "$ERR")
+  "$NOTIFY" "nightly review FAILED (exit $claude_exit): $reason (see $ERR)"
+  exit "$claude_exit"
 fi
