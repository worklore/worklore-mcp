block misses.\n+    blocks = [{\"type\": \"text\", \"text\": INSTRUCTIONS},\n+              {\"type\": \"text\", \"text\": athlete_profile(a, today), \"cache_control\": {\"type\": \"ephemeral\"}}]\n+    blocks += [{\"type\": \"text\", \"text\": f\"- {f}\"} for f in a.facts]\n+    if a.facts:\n+        blocks[-1] = {**blocks[-1], \"cache_control\": {\"type\": \"ephemeral\"}}\n+    return blocks\n \n # --------------------------------------------------------------------------- tools\n CORE_TOOLS = [\n@@ -164,7 +176,12 @@ def select_tools(text):\n \n def run_tool(a, name, args):\n     if name == \"save_fact\":\n-        a.facts.append(args[\"fact\"].strip())\n+        fact = \" \".join(args.get(\"fact\", \"\").split())\n+        if not fact:\n+            return \"empty fact, nothing saved\"\n+        if fact in a.facts:\n+            return \"already saved\"\n+        a.facts.append(fact)   # append only: see build_system for why\n         save_athlete(a)\n         return \"saved\"\n     if name == \"log_session\":\n M README.md\n M bot.py\n?? ANSWER.md","is_error":false}]},"parent_tool_use_id":null,"session_id":"4b34ac5c-3132-4024-bd58-874a3005a084","uuid":"60beac74-d0c5-4ede-8bd8-d221dcd2595f","timestamp":"2026-10-27T04:21:50.965Z","tool_use_result":{"stdout":"diff --git a/bot.py b/bot.py\nindex e2ff241..ca0a000 100644\n--- a/bot.py\n+++ b/bot.py\n@@ -114,23 +114,35 @@ Formatting:\n \"\"\"\n \n \n-def athlete_context(a, today):\n-    lines = [\n+def athlete_profile(a, today):\n+    \"\"\"The slow-changing part of the athlete context: no facts here.\"\"\"\n+    return \"\\n\".join([\n         f\"Today: {today.isoformat()} ({today.strftime('%A')})\",\n         f\"Athlete: {a.name} (id {a.user_id}), sport: {a.sport}\",\n         \"Zones: \" + \", \".join(f\"{k} {v}\" for k, v in a.zones.items()),\n         f\"Goal: {a.goal}\",\n-        \"Long-term facts:\",\n-    ]\n-    lines += [f\"- {f}\" for f in a.facts] or [\"- (none yet)\"]\n-    lines.append(f\"Language: {a.lang}\")\n-    return \"\\n\".join(lines)\n+        f\"Language: {a.lang}\",\n+        \"Long-term facts (none yet if no lines follow):\",\n+    ])\n \n \n def build_system(a, today):\n-    # One block, cached as a whole: instructions + per-athlete context.\n-    text = INSTRUCTIONS + \"\\n\\n\" + athlete_context(a, today)\n-    return [{\"type\": \"text\", \"text\": text, \"cache_control\": {\"type\": \"ephemeral\"}}]\n+    # Cache layout. The prefix is tools -> system blocks, so anything that changes\n+    # must come last and must only ever be appended to:\n+    #   [instructions] [profile]  <- breakpoint 1: static per athlete/day\n+    #   [- fact 1] ... [- fact N] <- breakpoint 2 on the last fact\n+    # Each fact is its own block. When save_fact appends fact N+1, the prefix up\n+    # to fact N is unchanged, and the cache lookback from breakpoint 2 (it checks\n+    # earlier block boundaries, ~20 blocks back) finds the entry written by the\n+    # previous request: only the new fact is written, not the whole prompt.\n+    # Nothing may follow the facts and facts must never be reordered or edited\n+    # in place, or every later block misses.\n+    blocks = [{\"type\": \"text\", \"text\": INSTRUCTIONS},\n+              {\"type\": \"text\", \"text\": athlete_profile(a, today), \"cache_control\": {\"type\": \"ephemeral\"}}]\n+    blocks += [{\"type\": \"text\", \"text\": f\"- {f}\"} for f in a.facts]\n+    if a.facts:\n+        blocks[-1] = {**blocks[-1], \"cache_control\": {\"type\": \"ephemeral\"}}\n+    return blocks\n \n # --------------------------------------------------------------------------- tools\n CORE_TOOLS = [\n@@ -164,7 +176,12 @@ def select_tools(text):\n \n def run_tool(a, name, args):\n     if name == \"save_fact\":\n-        a.facts.append(args[\"fact\"].strip())\n+        fact = \" \".join(args.get(\"fact\", \"\").split())\n+        if not fact:\n+            return \"empty fact, nothing saved\"\n+        if fact in a.facts:\n+            return \"already saved\"\n+        a.facts.append(fact)   # append only: see build_system for why\n         save_athlete(a)\n         return \"saved\"\n     if name == \"log_session\":\n M README.md\n M bot.py\n?? ANSWER.md","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"bashEditDiff":{"files":[{"filePath":"/private/tmp/h-izGWWB/ANSWER.md","hunks":[{"oldStart":0,"oldLines":0,"newStart":1,"newLines":51,"lines":["+# Почему save_fact сбрасывал кеш и что изменено","+","+## Причина","+`build_system` собирал **один** текстовый блок: инструкции + контекст атлета, где","+посередине стоял список фактов, а после него ещё строка `Language`. Единственный","+`cache_control` стоял на конце этого блока. Кеш Anthropic работает по точному","+префиксу (tools → system → messages), поэтому любой новый факт менял блок целиком,","+и ~1000 токенов приходилось записывать в кеш заново (`cache_read_input_tokens: 0`,","+`cache_creation_input_tokens` ≈ 1000+ в `logs/usage.jsonl`). Причём уже на 2-м","+раунде того же сообщения: `run_tool` дописывает факт в `a.facts`, и следующий","+запрос строит системный промпт заново.","+","+## Что изменено (`bot.py`)","+1. **Системный промпт разбит на блоки** в порядке «от стабильного к изменчивому»:","+   `[INSTRUCTIONS] [профиль: дата, имя, зоны, цель, язык, заголовок фактов] [- факт 1] … [- факт N]`.","+   Строка `Language` перенесена выше фактов, так что после фактов ничего нет.","+2. **Каждый факт — отдельный блок**, `cache_control` на последнем. Когда добавляется","+   факт N+1, префикс до факта N остаётся байт-в-байт прежним. API при промахе на","+   breakpoint проверяет предыдущие границы блоков (lookback ~20 блоков) и находит","+   запись, сделанную прошлым запросом. Дозаписывается только новый факт (~15–20 токенов).","+3. **Второй breakpoint — на блоке профиля.** Это страховка на случай, если lookback","+   не дотянется (вручную отредактировали или переупорядочили факты, добавили >20 разом).","+   Если префикс до этого блока короче минимума для кеша (1024 токена у Sonnet 4.5),","+   breakpoint просто ничего не делает, ошибки не будет.","+4. `save_fact` теперь **только дописывает**: нормализует пробелы, игнорирует пустые","+   строки и точные дубли (пустой текстовый блок API бы отклонил, а дубль лишь","+   раздувает промпт). Почему порядок фактов нельзя менять, объяснено в комментарии в `build_system`.","+5. README обновлён: теперь в нём описана новая схема кеширования.","+","+## Проверка","+Реальный API я не вызывал. Проверял локальной симуляцией правил кеша (запись на","+breakpoint, lookback по границам блоков) через `reply()` с фейковым LLM:","+","+| вызов | read | create |","+|---|---|---|","+| сообщение, раунд 1 | 0 | 1139 (холодный кеш) |","+| раунд 2 после save_fact | 1139+ | **~20** |","+| следующее сообщение | весь префикс | 0 |","+| ещё один save_fact → раунд 2 | 1159 | **18** |","+","+До изменений на месте «~20» было ≈1050–1100.","+","+## Что не трогал, но стоит знать","+- **Фильтрация инструментов по ключевым словам** (по NOTES.md её оставить) тоже сбрасывает","+  кеш: tools идут в префиксе раньше system, поэтому сообщение со словами «plan»/«race»","+  и т.п. переписывает весь промпт (в логе это строки с 1305/1334). Это отдельный","+  компромисс, к save_fact он не относится.","+- Строка `Today` меняется раз в сутки, а TTL кеша 5 минут, так что на кеш это не влияет.","+- После деплоя проверить по `logs/usage.jsonl`: на раунде после `save_fact`","+  `cache_read_input_tokens` должен быть ≈ размеру промпта, а `cache_creation_input_tokens`","+  должен быть порядка десятков токенов."]}],"created":true},{"filePath":"/private/tmp/h-izGWWB/README.md","hunks":[{"oldStart":12,"oldLines":5,"newStart":12,"newLines":7,"lines":[" messages on stdin (the Telegram long-polling transport, which needs"," `COACH_TELEGRAM_TOKEN`, lives in a separate deploy repo and just calls `reply()`)."," Requires Python 3.11+ and `pip install anthropic`. Prompt caching is on: the system","-prompt carries a `cache_control` marker so the tool-loop rounds and follow-up","-messages inside the 5-minute window read it from cache.","+prompt is split into blocks (instructions, profile, then one block per fact) with","+`cache_control` on the profile and on the last fact, so the tool-loop rounds and","+follow-up messages inside the 5-minute window read it from cache, and a new fact","+only adds its own block. Facts are append-only; see `build_system`."]}]}],"moreFiles":1,"changedFiles":["/private/tmp/h-izGWWB/ANSWER.md","/private/tmp/h-izGWWB/README.md","/private/tmp/h-izGWWB/__pycache__/bot.cpython-314.pyc"]}},"tool_result_meta":[{"id":"toolu_01BuLMdPzj6S2dYocRnMogGF","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
