{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"sed -n '100,170p' bot.py && python3 - <<'PY'\nimport bot, datetime\nfor uid in ('42','77'):\n a=bot.load_athlete(uid)\n blocks=bot.build_system(a,datetime.date.today())\n print(uid, len(blocks[0]['text']), len(blocks[1]['text']), len(blocks[0]['text'].split()))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"sed -n '100,170p' bot.py && python3 - <<'PY'\nimport bot, datetime\nfor uid in ('42','77'):\n a=bot.load_athlete(uid)\n blocks=bot.build_system(a,datetime.date.today())\n print(uid, len(blocks[0]['text']), len(blocks[1]['text']), len(blocks[0]['text'].split()))\nPY\"","aggregated_output":"- Warm, direct, no exclamation marks.\n- No motivational quotes.\n- Address the athlete by first name at most once per reply.\n- Reply in the athlete's language from the profile below, even if they write in another language.\n\nSafety:\n- Never advise training through chest pain, dizziness or fever.\n- Minors: refer to a coach in person.\n- If someone asks for weight-loss plans below 1500 kcal per day, decline and suggest a dietitian.\n\nFormatting:\n- Plain text. No markdown headings, no tables.\n- Lists only for a session structure (warm-up / main / cool-down).\n- Numbers with units: 45 min, 12 km, 150 bpm.\n\nUsing the athlete record:\n- Treat the profile and long-term facts as the current source of truth for this athlete.\n- Apply a saved schedule, equipment constraint, or injury history only when it is relevant to the question.\n- If a new durable detail replaces an older one, save the new detail and use it in this reply.\n- A tool result confirms only what that tool actually did; do not infer additional workout history or race results.\n- If the athlete's request conflicts with a safety rule, give the safe next step in the same brief, direct tone.\n- When a detail is missing, ask for that detail instead of filling it in from a typical training plan.\n\"\"\"\n\n\ndef athlete_profile(a):\n    lines = [\n        f\"Athlete: {a.name} (id {a.user_id}), sport: {a.sport}\",\n        \"Zones: \" + \", \".join(f\"{k} {v}\" for k, v in a.zones.items()),\n        f\"Goal: {a.goal}\",\n        f\"Language: {a.lang}\",\n    ]\n    return \"\\n\".join(lines)\n\n\ndef athlete_context(a, today):\n    lines = [\n        f\"Today: {today.isoformat()} ({today.strftime('%A')})\",\n        \"Long-term facts:\",\n    ]\n    lines += [f\"- {f}\" for f in a.facts] or [\"- (none yet)\"]\n    return \"\\n\".join(lines)\n\n\ndef build_system(a, today):\n    # Keep changing facts and the date after the cache breakpoint.\n    stable = INSTRUCTIONS + \"\\n\\n\" + athlete_profile(a)\n    return [\n        {\"type\": \"text\", \"text\": stable, \"cache_control\": {\"type\": \"ephemeral\"}},\n        {\"type\": \"text\", \"text\": athlete_context(a, today)},\n    ]\n\n# --------------------------------------------------------------------------- tools\nCORE_TOOLS = [\n    {\"name\": \"save_fact\", \"description\": \"Remember one durable fact about the athlete.\",\n     \"input_schema\": {\"type\": \"object\", \"properties\": {\"fact\": {\"type\": \"string\"}}, \"required\": [\"fact\"]}},\n    {\"name\": \"log_session\", \"description\": \"Record a completed workout.\",\n     \"input_schema\": {\"type\": \"object\", \"properties\": {\"minutes\": {\"type\": \"integer\"}, \"rpe\": {\"type\": \"integer\"},\n                                                       \"note\": {\"type\": \"string\"}}, \"required\": [\"minutes\"]}},\n]\nTOOL_GROUPS = {\n    \"plan\": ((\"plan\", \"week\", \"schedule\", \"taper\", \"build\"), [\n        {\"name\": \"plan_week\", \"description\": \"Draft a week of sessions.\",\n         \"input_schema\": {\"type\": \"object\", \"properties\": {\"hours\": {\"type\": \"number\"}, \"hard_days\": {\"type\": \"integer\"}},\n                          \"required\": [\"hours\"]}}]),\n    \"race\": ((\"race\", \"pace\", \"predict\", \"finish time\"), [\n        {\"name\": \"predict_race\", \"description\": \"Estimate a finish time from a recent effort.\",\n         \"input_schema\": {\"type\": \"object\", \"properties\": {\"distance_km\": {\"type\": \"number\"}, \"recent_minutes\": {\"type\": \"number\"}},\n                          \"required\": [\"distance_km\"]}}]),\n}\n\n42 3285 157 578\n77 3294 107 581\n","exit_code":0,"status":"completed"}}
