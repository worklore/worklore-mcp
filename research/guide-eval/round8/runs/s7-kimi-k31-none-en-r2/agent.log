1:{provider.server_port}'\\n\\nimport server\\n\\napp = ThreadingHTTPServer(('127.0.0.1', 0), server.Handler)\\napp_thread = threading.Thread(target=app.serve_forever, daemon=True)\\napp_thread.start()\\n\\n\\ndef request(method, path, token=None):\\n    conn = http.client.HTTPConnection('127.0.0.1', app.server_port, timeout=5)\\n    headers = {'Authorization': f'Bearer {token}'} if token else {}\\n    conn.request(method, path, headers=headers)\\n    response = conn.getresponse()\\n    body = response.read()\\n    result = response.status, dict(response.getheaders()), body\\n    conn.close()\\n    return result\\n\\ntry:\\n    status, _, _ = request('POST', '/api/intervals/auth/init')\\n    assert status == 401\\n\\n    status, _, body = request('POST', '/api/intervals/auth/init', 'tok-rivera')\\n    assert status == 200\\n    authorize_url = json.loads(body)['authorize_url']\\n    query = dict(urllib.parse.parse_qsl(urllib.parse.urlsplit(authorize_url).query))\\n    assert query['scope'] == 'ACTIVITY:WRITE,WELLNESS:READ,CALENDAR:WRITE'\\n    assert query['client_id'] == config.CLIENT_ID\\n    assert query['redirect_uri'] == config.REDIRECT_URI\\n    state = query['state']\\n    assert server.verify_state(state) == 'u_rivera'\\n\\n    status, headers, _ = request('GET', '/api/intervals/auth/init', 'tok-rivera')\\n    assert status == 302\\n    assert headers['Location'].startswith(config.INTERVALS_BASE + '/oauth/authorize?')\\n\\n    callback_path = '/api/intervals/callback?' + urllib.parse.urlencode({'code': 'local-code', 'state': state})\\n    status, headers, _ = request('GET', callback_path)\\n    assert status == 302 and headers['Location'] == '/?connected=1'\\n\\n    status, _, body = request('GET', '/api/intervals/status', 'tok-rivera')\\n    assert status == 200\\n    assert json.loads(body)['connected'] is True\\n    connection = server.CONNECTIONS['u_rivera']\\n    assert connection['expires_at'] is None\\n    assert connection['refresh_token'] is None\\n    assert connection['access_token'] == 'local-access-token'\\n\\n    sleeps = 0\\n    original_sleep = server.time.sleep\\n    def one_refresh_pass(_):\\n        global sleeps\\n        sleeps += 1\\n        if sleeps > 1:\\n            raise RuntimeError('stop refresh loop')\\n    server.time.sleep = one_refresh_pass\\n    try:\\n        server.refresh_tokens()\\n    except RuntimeError as error:\\n        assert str(error) == 'stop refresh loop'\\n    finally:\\n        server.time.sleep = original_sleep\\n    assert connection['status'] == 'connected'\\n    assert connection['access_token'] == 'local-access-token'\\n\\n    status, _, body = request('GET', '/api/intervals/wellness', 'tok-rivera')\\n    assert status == 200\\n    assert json.loads(body) == {'id': 'i98765', 'wellness': []}\\n    print('Local OAuth callback, status, non-expiry refresh pass, and wellness flow passed.')\\nfinally:\\n    app.shutdown()\\n    provider.shutdown()\\n    app.server_close()\\n    provider.server_close()\\nPY\",\"cwd\":\"/private/tmp/h-YBz3Dh\",\"timeout\":60}"}},{"type":"function","id":"tool_swJVQn2kZTpTjE1ij3tqwHyF","function":{"name":"Bash","arguments":"{\"command\":\"if command -v node >/dev/null 2>&1; then node --check static/app.js; else exit 0; fi\",\"cwd\":\"/private/tmp/h-YBz3Dh\",\"timeout\":60}"}}]}
