code({\"code\": \"code-1\", \"state\": q.get(\"state\", \"\")})\n            return self.reply(302, headers={\"Location\": loc})\n        if u.path.startswith(\"/api/v1/athlete/\"):\n            auth = self.headers.get(\"Authorization\", \"\")\n            tok = auth[7:] if auth.startswith(\"Bearer \") else \"\"\n            if not tok or tok in REVOKED:\n                return self.reply(401, {\"error\": \"unauthorized\"})\n            return self.reply(200, [{\"id\": \"2026-10-27\", \"soreness\": 2}])\n        self.reply(404, {\"error\": \"not found\"})\n\n    def do_POST(self):\n        u = urllib.parse.urlsplit(self.path)\n        n = int(self.headers.get(\"Content-Length\", 0))\n        f = dict(urllib.parse.parse_qsl(self.rfile.read(n).decode()))\n        if u.path == \"/api/oauth/token\":\n            if f.get(\"client_id\") != \"tricoach-dev\" or f.get(\"code\") != \"code-1\":\n                return self.reply(400, {\"error\": \"invalid_grant\"})\n            # Same shape as the Sept 19 log: no expires_in, no refresh_token.\n            return self.reply(200, {\"token_type\": \"bearer\", \"access_token\": \"tok-intervals-1\",\n                                    \"scope\": \"ACTIVITY:WRITE,WELLNESS:READ,CALENDAR:WRITE\",\n                                    \"athlete\": {\"id\": \"i98765\", \"name\": \"T. Rivera\"}})\n        self.reply(404, {\"error\": \"not found\"})\n\n\nif __name__ == \"__main__\":\n    ThreadingHTTPServer((\"127.0.0.1\", PORT), H).serve_forever()\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":8452,"cache_read_input_tokens":23851,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":8452},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d1e5ae0e-d0