mentById(\"app\");\n\nasync function api(path, opts = {}) {\n  const headers = Object.assign({ \"Authorization\": \"Bearer \" + TOKEN }, opts.headers || {});\n  const res = await fetch(path, Object.assign({}, opts, { headers }));\n  const body = await res.json().catch(() => ({}));\n  if (!res.ok) throw new Error(body.error || (\"HTTP \" + res.status));\n  return body;\n}\n\nfunction esc(s) { return String(s).replace(/[&<>\"]/g, c => ({ \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\" }[c])); }\n\nasync function render() {\n  try {\n    const me = await api(\"/api/me\");\n    const st = await api(\"/api/intervals/status\");\n    let card;\n    if (st.connected) {\n      card = `<div class=\"card\">Connected to Intervals.icu as <b>${esc(st.athlete.name)}</b>\n        (${esc(st.athlete.id)}), scope <code>${esc(st.scope)}</code>.\n        <p><button class=\"btn\" id=\"disconnect\">Disconnect</button></p></div>`;\n    } else {\n      const why = st.status && st.status !== \"disconnected\" ? `<p class=\"muted\">Status: ${esc(st.status)}</p>` : \"\";\n      card = `<div class=\"card\">Intervals.icu is not connected.${why}\n        <p><a class=\"btn\" href=\"/api/intervals/auth/init\">Connect Intervals.icu</a></p></div>`;\n    }\n    root.className = \"\";\n    root.innerHTML = `<p>Signed in as <b>${esc(me.name)}</b>.</p>${card}`;\n    const d = document.getElementById(\"disconnect\");\n    if (d) d.onclick = async () => { await api(\"/api/intervals/disconnect\", { method: \"POST\" }); render(); };\n  } catch (e) {\n    root.innerHTML = `<p class=\"card\">Error: ${esc(e.message)}</p>`;\n  }\n}\n\nrender();\n","structuredPatch":[{"oldStart":25,"oldLines":12,"newStart":25,"newLines":22,"lines":["     } else {","       const why = st.status && st.status !== \"disconnected\" ? `<p class=\"muted\">Status: ${esc(st.status)}</p>` : \"\";","       card = `<div class=\"card\">Intervals.icu is not connected.${why}","-        <p><a class=\"btn\" href=\"/api/intervals/auth/init\">Connect Intervals.icu</a></p></div>`;","+        <p><button class=\"btn\" id=\"connect\">Connect Intervals.icu</button></p></div>`;","     }","     root.className = \"\";","     root.innerHTML = `<p>Signed in as <b>${esc(me.name)}</b>.</p>${card}`;","     const d = document.getElementById(\"disconnect\");","     if (d) d.onclick = async () => { await api(\"/api/intervals/disconnect\", { method: \"POST\" }); render(); };","+    const c = document.getElementById(\"connect\");","+    // POST via fetch so the Authorization header is sent; then navigate to Intervals.","+    if (c) c.onclick = async () => {","+      try {","+        const { authorize_url } = await api(\"/api/intervals/auth/init\", { method: \"POST\" });","+        window.location.assign(authorize_url);","+      } catch (e) {","+        root.insertAdjacentHTML(\"beforeend\", `<p class=\"card\">Error: ${esc(e.message)}</p>`);","+      }","+    };","   } catch (e) {","     root.innerHTML = `<p class=\"card\">Error: ${esc(e.message)}</p>`;","   }"]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_01G3dd74wN81cGnq5MG48rqM","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
