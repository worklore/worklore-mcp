orization: Bearer tok-okafor' http://127.0.0.1:8766/api/intervals/auth/init); URL=$(echo \"$AUTH\" | python3 -c 'import json,sys;print(json.load(sys.stdin)[\"authorize_url\"])'); echo \"$URL\"\nCB=$(curl -s -o /dev/null -w '%{redirect_url}' \"$URL\"); curl -s -o /dev/null -w 'callback %{http_code} -> %{redirect_url}\\n' \"$CB\"\ncurl -s -H 'Authorization: Bearer tok-okafor' http://127.0.0.1:8766/api/intervals/status; echo\npkill -f \"server.py$\"; pkill -f fake_intervals.py; rm -rf __pycache__; python3 -m py_compile server.py && rm -rf __pycache__ && echo PY_OK","description":"Re-verify flow after URL encoding restore"}},"wire_ingest_context":{"toolu_01CydJsAiFTsRZCfWaEkrKWA":{"cwd":"/private/tmp/h-3L81lQ"}}}
