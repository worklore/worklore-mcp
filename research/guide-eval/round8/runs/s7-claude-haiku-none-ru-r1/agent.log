ctHandler):\n    def redirect_request(self, *a, **k): return None\nopener = urllib.request.build_opener(NoRedirect)\nB = f\"http://127.0.0.1:{APP_PORT}\"\ndef call(path, token=None):\n    h = {\"Authorization\": \"Bearer \" + token} if token else {}\n    try:\n        with opener.open(urllib.request.Request(B + path, headers=h)) as r:\n            return r.status, r.headers.get(\"Location\"), json.loads(r.read() or b\"{}\")\n    except urllib.error.HTTPError as e:\n        return e.code, e.headers.get(\"Location\"), json.loads(e.read() or b\"{}\")\ndef check(name, cond): print((\"PASS \" if cond else \"FAIL \") + name)\n\ns, _, _ = call(\"/api/intervals/auth/init\")\ncheck(\"auth/init without bearer -> 401\", s == 401)\ns, _, j = call(\"/api/intervals/auth/init\", \"tok-okafor\")\ncheck(\"auth/init with bearer -> 200 JSON url\", s == 200 and \"url\" in j)\nprint(\"  url:\", j.get(\"url\"))\nq = urllib.parse.parse_qs(urllib.parse.urlsplit(j[\"url\"]).query)\ncheck(\"authorize url points at oauth/authorize\", j[\"url\"].startswith(config.INTERVALS_BASE + \"/oauth/authorize?\"))\ncheck(\"scope is WELLNESS:READ\", q[\"scope\"] == [\"WELLNESS:READ\"])\ncheck(\"redirect_uri decodes to callback\", q[\"redirect_uri\"] == [config.REDIRECT_URI])\nstate = q[\"state\"][0]\n\ns, loc, _ = call(f\"/api/intervals/callback?code=abc&state={urllib.parse.quote(state)}\")\ncheck(\"callback -> 302 /?connected=1\", s == 302 and loc == \"/?connected=1\")\ns, _, st = call(\"/api/intervals/status\", \"tok-okafor\")\ncheck(\"status connected\", st.get(\"connected\") is True and st[\"athlete\"][\"id\"] == \"i1\")\ncheck(\"no fabricated expiry (expires_at None)\", server.CONNECTIONS[\"u_okafor\"][\"expires_at\"] is None)\ntime.sleep(0.5)\ns, _, st = call(\"/api/intervals/status\", \"tok-okafor\")\ncheck(\"still connected after refresher passes\", st.get(\"connected\") is True)\ns, _, w = call(\"/api/intervals/wellness\", \"tok-okafor\")\ncheck(\"wellness proxied OK\", s == 200 and w == {\"ok\":