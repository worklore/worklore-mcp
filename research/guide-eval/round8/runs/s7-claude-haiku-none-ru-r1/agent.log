{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01J1qcC84CgqaqJFd8BjiqdM","type":"tool_result","content":"app.js syntax OK\npy compile OK\n M config.py\n M server.py\n M static/app.js\ndiff --git a/config.py b/config.py\nindex 54a8144..cff55f0 100644\n--- a/config.py\n+++ b/config.py\n@@ -8,6 +8,10 @@ INTERVALS_BASE = os.environ.get(\"INTERVALS_BASE\", \"https://intervals.icu\")\n CLIENT_ID = \"tricoach-dev\"\n CLIENT_SECRET = \"s3cr3t-placeholder-0000\"\n REDIRECT_URI = f\"http://localhost:{PORT}/api/intervals/callback\"\n-SCOPES = \"ACTIVITY:READ,ACTIVITY:WRITE,WELLNESS:READ,CALENDAR:READ,CALENDAR:WRITE\"\n+# Default: only the scope the server calls (wellness). The CALENDAR/ACTIVITY scopes were\n+# added on 2026-10-02, and since then Intervals answers the authorize step with 400\n+# invalid_request (logs/support-tickets.md #219). Set INTERVALS_SCOPES to request more\n+# once the OAuth client is approved for them.\n+SCOPES = os.environ.get(\"INTERVALS_SCOPES\", \"WELLNESS:READ\")\n \n REFRESH_INTERVAL = 60      # seconds between passes of the token refresher\ndiff --git a/server.py b/server.py\nindex 351cbb7..97ffaa0 100644\n--- a/server.py\n+++ b/server.py\n@@ -12,7 +12,6 @@ import config\n STATIC = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"static\")\n TOKEN_URL = config.INTERVALS_BASE + \"/api/oauth/token\"\n AUTHORIZE_URL = config.INTERVALS_BASE + \"/oauth/authorize\"\n-DEFAULT_TOKEN_TTL = 3600   # seconds; used when the provider does not say how long a token lives\n \n # --- in-memory store -------------------------------------------------------\n USERS = {\n@@ -63,18 +62,28 @@ def exchange_code(code):\n \n \n def store_connection(user_id, tok):\n-    expires_in = int(tok.get(\"expires_in\") or DEFAULT_TOKEN_TTL)\n+    # Only trust a lifetime the provider actually sent; otherwise leave it unknown and let\n+    # a 401 from Intervals decide when the connection is over (see mark_expired).\n+    expires_in = tok.get(\"expires_in\")\n+    expires_at = time.time() + int(expires_in) if expires_in else None\n     refresh = tok.get(\"refresh_token\")\n-    if not refresh:\n-        log(f\"{user_id}: no refresh_token in response, scheduling expiry in {expires_in}s\")\n     athlete = tok.get(\"athlete\") or {}\n     with LOCK:\n         CONNECTIONS[user_id] = {\n             \"athlete_id\": athlete.get(\"id\"), \"athlete_name\": athlete.get(\"name\"),\n             \"access_token\": tok[\"access_token\"], \"refresh_token\": refresh,\n-            \"scope\": tok.get(\"scope\"), \"expires_at\": time.time() + expires_in, \"status\": \"connected\",\n+            \"scope\": tok.get(\"scope\"), \"expires_at\": expires_at, \"status\": \"connected\",\n         }\n-    log(f\"{user_id}: connected as athlete {athlete.get('id')} (expires in {expires_in}s)\")\n+    log(f\"{user_id}: connected as athlete {athlete.get('id')} \"\n+        f\"(expires_in={expires_in}, refresh_token={'yes' if refresh else 'no'})\")\n+\n+\n+def mark_expired(user_id, reason):\n+    with LOCK:\n+        c = CONNECTIONS.get(user_id)\n+        if c:\n+            c.update(status=\"expired, reconnect\", access_token=None)\n+    log(f\"{user_id}: {reason} -> expired, reconnect\")\n \n \n def refresh_tokens():\n@@ -84,7 +93,7 @@ def refresh_tokens():\n         now = time.time()\n         with LOCK:\n             for uid, c in CONNECTIONS.items():\n-                if c[\"status\"] != \"connected\" or c[\"expires_at\"] - now > 300:\n+                if c[\"status\"] != \"connected\" or c[\"expires_at\"] is None or c[\"expires_at\"] - now > 300:\n                     continue\n                 if not c[\"refresh_token\"]:\n                     log(f\"{uid}: token expiry passed and no refresh token on file -> expired, reconnect\")\n@@ -185,14 +194,15 @@ class Handler(BaseHTTPRequestHandler):\n             return\n         self.send_json(404, {\"error\": \"not found\"})\n \n-    # Step 1: build the authorize URL and send the browser to Intervals.\n+    # Step 1: return the authorize URL. The SPA fetches this with its Bearer token (a plain\n+    # link cannot send the header, which is why Connect used to get 401) and then opens it.\n     def auth_init(self):\n         user = self.require_user()\n         if not user:\n             return\n         params = {\"client_id\": config.CLIENT_ID, \"redirect_uri\": config.REDIRECT_URI,\n                   \"scope\": config.SCOPES, \"state\": sign_state(user[\"id\"])}\n-        self.redirect(AUTHORIZE_URL + \"?\" + urllib.parse.urlencode(params, safe=\":,\"))\n+        self.send_json(200, {\"url\": AUTHORIZE_URL + \"?\" + urllib.parse.urlencode(params)})\n \n     # Step 2: Intervals redirects back here with ?code=&state=.\n     def callback(self, q):\n@@ -233,6 +243,8 @@ class Handler(BaseHTTPRequestHandler):\n             code, data = intervals_get(c, \"/wellness\")\n             self.send_json(code, data)\n         except urllib.error.HTTPError as e:\n+            if e.code == 401:\n+                mark_expired(user[\"id\"], \"intervals rejected the access token\")\n             self.send_json(e.code, {\"error\": f\"intervals returned {e.code}\"})\n         except Exception as e:\n             self.send_json(502, {\"error\": str(e)})\ndiff --git a/static/app.js b/static/app.js\nindex 368922e..fbb7d90 100644\n--- a/static/app.js\n+++ b/static/app.js\n@@ -25,12 +25,21 @@ async function render() {\n     } else {\n       const why = st.status && st.status !== \"disconnected\" ? `<p class=\"muted\">Status: ${esc(st.status)}</p>` : \"\";\n       card = `<div class=\"card\">Intervals.icu is not connected.${why}\n-        <p><a class=\"btn\" href=\"/api/intervals/auth/init\">Connect Intervals.icu</a></p></div>`;\n+        <p><button class=\"btn\" id=\"connect\">Connect Intervals.icu</button></p></div>`;\n     }\n     root.className = \"\";\n     root.innerHTML = `<p>Signed in as <b>${esc(me.name)}</b>.</p>${card}`;\n     const d = document.getElementById(\"disc