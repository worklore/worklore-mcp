     \"access_token\": tok[\"access_token\"], \"refresh_token\": refresh,\n            \"scope\": tok.get(\"scope\"), \"expires_at\": expires_at, \"status\": \"connected\",\n        }\n    log(f\"{user_id}: connected as athlete {athlete.get('id')} \"\n        f\"(expires_in={expires_in}, refresh_token={'yes' if refresh else 'no'})\")\n\n\ndef mark_expired(user_id, reason):\n    with LOCK:\n        c = CONNECTIONS.get(user_id)\n        if c:\n            c.update(status=\"expired, reconnect\", access_token=None)\n    log(f\"{user_id}: {reason} -> expired, reconnect\")\n\n\ndef refresh_tokens():\n    \"\"\"Background pass: renew access tokens shortly before they expire.\"\"\"\n    while True:\n        time.sleep(config.REFRESH_INTERVAL)\n        now = time.time()\n        with LOCK:\n            for uid, c in CONNECTIONS.items():\n                if c[\"status\"] != \"connected\" or c[\"expires_at\"] is None or c[\"expires_at\"] - now > 300:\n                    continue"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":491,"cache_read_input_tokens":42786,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":491},"output_tokens":2,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"8f67b862-9345-4143-81ea-3d2e3de84ebd","uuid":"b01eb7f5-721f-4efc-8251-575cd2761b85","timestamp":"2026-10-27T02:59:49.746Z","request_id":"req_011CgRzcu3PoMD1X3yNyD7hV","wire_tool_inputs":{"toolu_0167i9uM4dR7as94pBU2X6VE":{"file_path":"/private/tmp/h-uTYqi6/server.py","old_string":"def store_connection(user_id, tok):\n    expires_in = int(tok.get(\"expires_in\") or DEFAULT_TOKEN_TTL)\n    refresh = tok.get(\"refresh_token\")\n    if not refresh:\n        log(f\"{user_id}: no refresh_token in response, scheduling expiry in {expire