body\": \"Two crontabs, one for root and one for me, both had the line.\",\ntests/test_publish.py:20:        }\ntests/test_publish.py:21:        stored = app.publish(table, story)\ntests/test_publish.py:22:        self.assertEqual(stored[\"slug\"], \"why-my-cron-ran-twice\")\ntests/test_publish.py:23:        self.assertEqual(table.get_item(Key={\"slug\": \"why-my-cron-ran-twice\"})[\"Item\"][\"title\"], \"Why my cron ran twice\")\ntests/test_publish.py:24:        self.assertEqual(table.scan()[\"Count\"], 1)\ntests/test_publish.py:27:if __name__ == \"__main__\":\ntests/test_publish.py:28:    unittest.main()\nsrc/app.py:1:\"\"\"Story library: the publish handler.\nsrc/app.py:3:Each story is stored in one DynamoDB item together with the three most similar\nsrc/app.py:4:stories already in the library (``similar``), so the reader page can show\nsrc/app.py:5:\"related\" without a query at read time.\nsrc/app.py:6:\"\"\"\nsrc/app.py:7:import json\nsrc/app.py:8:import logging\nsrc/app.py:9:import re\nsrc/app.py:10:import time\nsrc/app.py:12:log = logging.getLogger(\"stories\")\nsrc/app.py:14:TABLE_NAME = \"stories\"\nsrc/app.py:15:TOP_N = 3\nsrc/app.py:17:_WORD = re.compile(r\"[a-z0-9]+\")\nsrc/app.py:20:def words(text):\nsrc/app.py:21:    return set(_WORD.findall((text or \"\").lower()))\nsrc/app.py:24:def similarity(a, b):\nsrc/app.py:25:    \"\"\"Shared-tag ratio (Jaccard), blended with shared words of the two bodies.\"\"\"\nsrc/app.py:26:    ta, tb = set(a.get(\"tags\", [])), set(b.get(\"tags\", []))\nsrc/app.py:27:    tag_score = len(ta & tb) / len(ta | tb) if (ta | tb) else 0\nsrc/app.py:28:    wa, wb = words(a.get(\"body\")), words(b.get(\"body\"))\nsrc/app.py:29:    word_score = len(wa & wb) / len(wa | wb) if (wa | wb) else 0\nsrc/app.py:30:    return round(0.7 * tag_score + 0.3 * word_score, 4)\nsrc/app.py:33:def related(story, existing):\nsrc/app.py:34:    scored = []\nsrc/app.py:35:    for other in existing:\nsrc/app.py:36:        if other[\"slug\"] == story[\"slug\"]:\nsrc/app.py:37:            continue\nsrc/app.py:38:        scored.append({\"slug\": other[\"slug\"], \"score\": similarity(story, other)})\nsrc/app.py:39:    scored.sort(key=lambda s: s[\"score\"], reverse=True)\nsrc/app.py:40:    return scored[:TOP_N]\nsrc/app.py:43:def validate(story):\nsrc/app.py:44:    for k in (\"slug\", \"title\", \"body\"):\nsrc/app.py:45:        if not story.get(k):\nsrc/app.py:46:            raise ValueError(f\"missing field: {k}\")\nsrc/app.py:47:    if not re.fullmatch(r\"[a-z0-9-]{3,80}\", story[\"slug\"]):\nsrc/app.py:48:        raise ValueError(\"bad slug\")\nsrc/app.py:51:def publish(table, story):\nsrc/app.py:52:    \"\"\"Store ``story`` with its related stories. Returns the stored item.\"\"\"\nsrc/app.py:53:    validate(story)\nsrc/app.py:54:    existing = table.scan(TableName=TABLE_NAME).get(\"Items\", [])\nsrc/app.py:55:    item = {\nsrc/app.py:56:        \"slug\": story[\"slug\"],\nsrc/app.py:57:        \"title\": story[\"title\"],\nsrc/app.py:58:        \"tags\": sorted(set(story.get(\"tags\", []))),\nsrc/app.py:59:        \"body\": story[\"body\"],\nsrc/app.py:60:        \"published_at\": int(time.time()),\nsrc/app.py:61:        \"similar\": related(story, existing),\nsrc/app.py:62:    }\nsrc/app.py:63:    table.put_item(Item=item)\nsrc/app.py:64:    log.info(\"publish slug=%s similar=%d stored\", item[\"slug\"], len(item[\"similar\"]))\nsrc/app.py:65:    return item\nsrc/app.py:68:def handler(event, table):\nsrc/app.py:69:    \"\"\"Lambda-style entry point for POST /stories. Body is the story as JSON.\"\"\"\nsrc/app.py:70:    try:\nsrc/app.py:71:        story = json.loads(event.get(\"body\") or \"{}\")\nsrc/app.py:72:        stored = publish(table, story)\nsrc/app.py:73:        return {\"statusCode\": 201, \"body\": json.dumps({\"slug\": stored[\"slug\"]})}\nsrc/app.py:74:    except ValueError as e:\nsrc/app.py:75:        return {\"statusCode\": 400, \"body\": json.dumps({\"error\": str(e)})}\nsrc/app.py:76:    except Exception:\nsrc/app.py:77:        log.exception(\"publish failed\")\nsrc/app.py:78:        return {\"statusCode\": 500, \"body\": json.dumps({\"error\": \"Internal Server Error\"})}\ntests/fake_dynamo.py:1:\"\"\"In-memory stand-in for a boto3 DynamoDB Table resource.\ntests/fake_dynamo.py:3:It stores items in a dict and validates values the way boto3's TypeSerializer\ntests/fake_dynamo.py:4:does, so a test fails on the same inputs a real table would reject.\ntests/fake_dynamo.py:5:\"\"\"\ntests/fake_dynamo.py:6:from decimal import Decimal\ntests/fake_dynamo.py:9:def _check(value, path=\"Item\"):\ntests/fake_dynamo.py:10:    if isinstance(value, bool) or value is None or isinstance(value, (int, str, bytes, Decimal)):\ntests/fake_dynamo.py:11:        return\ntests/fake_dynamo.py:12:    if isinstance(value, float):\ntests/fake_dynamo.py:13:        raise TypeError(\"Float types are not supported. Use Decimal types instead.\")\ntests/fake_dynamo.py:14:    if isinstance(value, dict):\ntests/fake_dynamo.py:15:        for k, v in value.items():\ntests/fake_dynamo.py:16:            _check(v, f\"{path}.{k}\")\ntests/fake_dynamo.py:17:        return\ntests/fake_dynamo.py:18:    if isinstance(value, (list, tuple, set, frozenset)):\ntests/fake_dynamo.py:19:        for i, v in enumerate(value):\ntests/fake_dynamo.py:20:            _check(v, f\"{path}[{i}]\")\ntests/fake_dynamo.py:21:        return\ntests/fake_dynamo.py:22:    raise TypeError(f\"Unsupported type {type(value)!r} for value at {path}\")\ntests/fake_dynamo.py:25:class FakeTable:\ntests/fake_dynamo.py:26:    def __init__(self, key=\"slug\"):\ntests/fake_dynamo.py:27:        self.key = key\ntests/fake_dynamo.py:28:        self.items = {}\ntests/fake_dynamo.py:30:    def put_item(self, Item, **kwargs):\ntests/fake_dynamo.py:31:        _check(Item)\ntests/fake_dynamo.py:32:        if self.key not in Item:\ntests/fake_dynamo.py:33:            raise ValueError(f\"item is missing the key attribute {self.key!r}\")\ntests/fake_dynamo.py:34:        self.items[Item[self.key]] = dict(Item)\ntests/fake_dynamo.py:35:        return {\"ResponseMetadata\": {\"HTTPStatusCode\": 200}}\ntests/fake_dynamo.py:37:    def get_item(self, Key, **kwargs):\ntests/fake_dynamo.py:38:        item = self.items.get(Key[self.key])\ntests/fake_dynamo.py:39:        return {\"Item\": dict(item)} if item is not None else {}\ntests/fake_dynamo.py:41:    def scan(self, **kwargs):\ntests/fake_dynamo.py:42:        return {\"Items\": [dict(v) for v in self.items.values()], \"Count\": len(self.items)}\n","exit_code":0,"status":"completed"}}
