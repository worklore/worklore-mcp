 log = logging.getLogger("stories")
 
@@ -35,7 +36,8 @@ def related(story, existing):
     for other in existing:
         if other["slug"] == story["slug"]:
             continue
-        scored.append({"slug": other["slug"], "score": similarity(story, other)})
+        # DynamoDB's resource serializer rejects Python floats, including nested ones.
+        scored.append({"slug": other["slug"], "score": Decimal(str(similarity(story, other)))})
     scored.sort(key=lambda s: s["score"], reverse=True)
     return scored[:TOP_N]
 
