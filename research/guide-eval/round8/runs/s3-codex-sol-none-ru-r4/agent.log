{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport os, subprocess, tempfile\nroot = Path.cwd()\nwith tempfile.TemporaryDirectory(prefix='.nightly-test-', dir=root) as temp:\n    base = Path(temp)\n    home = base / 'home'\n    for name in ('bin', 'projects/shop', 'Library/Logs'):\n        (home / name).mkdir(parents=True)\n    mock = base / 'mock'\n    mock.mkdir()\n    notifier = home / 'bin/notify.sh'\n    notifier.write_text('#\"'!/bin/sh'\"\\\\nprintf \\\"%s\\\\\\\\n\\\" \\\"\"'$1\" >> \"$TEST_MESSAGES\"'\"\\\\n')\n    claude = mock / 'claude'\n    claude.write_text('#\"'!/bin/sh'\"\\\\nif [ \\\"\"'$CLAUDE_RESULT\" = fail ]; then echo \"Not logged in\" >&2; exit 7; fi'\"\\\\nprintf \\\"review summary\\\\\\\\n\\\"\\\\n')\n    notifier.chmod(0o755)\n    claude.chmod(0o755)\n    env = dict(os.environ, HOME=str(home), PATH=f'{mock}:' + os.environ['PATH'], TEST_MESSAGES=str(base / 'messages'))\n    for result in ('fail', 'success'):\n        env['CLAUDE_RESULT'] = result\n        proc = subprocess.run(['/bin/zsh', str(root / 'bin/nightly-review.zsh')], cwd=root, env=env, capture_output=True, text=True)\n        print(result, 'exit=', proc.returncode, 'stderr=', proc.stderr.strip())\n    print('notifications:', (base / 'messages').read_text().strip().splitlines())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
