@@ -128,9 +128,11 @@ def athlete_context(a, today):
 
 
 def build_system(a, today):
-    # One block, cached as a whole: instructions + per-athlete context.
-    text = INSTRUCTIONS + "\n\n" + athlete_context(a, today)
-    return [{"type": "text", "text": text, "cache_control": {"type": "ephemeral"}}]
+    # Two blocks: static instructions get their own breakpoint so a save_fact
+    # (which changes only the athlete context) doesn't evict them.
+    eph = {"type": "ephemeral"}
+    return [{"type": "text", "text": INSTRUCTIONS, "cache_control": eph},
+            {"type": "text", "text": athlete_context(a, today), "cache_control": eph}]
 
