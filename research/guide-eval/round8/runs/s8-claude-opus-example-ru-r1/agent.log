        {\"type\": \"text\", \"text\": athlete_memory(a, today),\n         \"cache_control\": {\"type\": \"ephemeral\"}},\n    ]\n\n'''\ns=s.replace(old,new)\n\ns=s.replace('''def build_request(a, messages, tools, today):\n    return {\"model\": MODEL, \"max_tokens\": MAX_TOKENS, \"system\": build_system(a, today), \"tools\": tools, \"messages\": messages}\n''','''def build_request(system, messages, tools):\n    return {\"model\": MODEL, \"max_tokens\": MAX_TOKENS, \"system\": system, \"tools\": tools, \"messages\": messages}\n''')\ns=s.replace('''    tools = select_tools(text)\n    messages = [{\"role\": \"user\", \"content\": text}]\n    for round_no in range(1, MAX_TOOL_ROUNDS + 1):\n        resp = llm.create(**build_request(a, messages, tools, today))''','''    tools = select_tools(text)\n    # Built once per message: a save_fact in round 1 must not change the prompt of round 2\n    # (the model already sees the fact in its own tool_use). The next message picks it up.\n    system = build_system(a, today)\n    messages = [{\"role\": \"user\", \"content\": text}]\n    for round_no in range(1, MAX_TOOL_ROUNDS + 1):\n        resp = llm.create(**build_request(system, messages, tools))''')\ns=s.replace('''if __name__ == \"__main__\":\n    # Local chat: python3 bot.py <user_id>; Telegram long-polling lives in telegram.py (not in this repo).\n    uid = sys.argv[1] if len(sys.argv) > 1 else \"42\"\n''','''def check_cache(user_id):\n    \"\"\"Count the tokens up to the first cache marker (core tools + static segment).\n\n    Below MIN_CACHEABLE_TOKENS the first marker is ignored by the API and every memory\n    write re-caches the whole prompt again, exactly as before the split.\n    \"\"\"\n    client = anthropic.Anthropic(api_key=os.environ[\"COACH_ANTHROPIC_KEY\"])\n    static = build_system(load_athlete(user_id), dt.date.today())[:1]\n    msgs = [{\"role\": \"user\", \"content\": \".\"}]\n    full = client.messages.count_tokens(model=MODEL, system=static, tools=CORE_T