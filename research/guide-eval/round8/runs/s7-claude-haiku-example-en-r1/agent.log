        return self.j(401, {\"error\": \"unauthorized\"})\n            return self.j(200, {\"wellness\": [{\"id\": \"2026-10-26\", \"sleepScore\": 80}]})\n        if u.path == \"/_revoke\":\n            REVOKED.update(TOKENS); return self.j(200, {\"revoked\": len(TOKENS)})\n        self.j(404, {\"error\": \"nf\"})\n    def do_POST(self):\n        n = int(self.headers.get(\"Content-Length\") or 0)\n        f = dict(urllib.parse.parse_qsl(self.rfile.read(n).decode()))\n        if self.path == \"/api/oauth/token\":\n            if set(f) - {\"client_id\", \"client_secret\", \"code\", \"grant_type\", \"redirect_uri\"} or f.get(\"client_secret\") != \"s3cr3t-placeholder-0000\" or f.get(\"code\") != \"abc\":\n                return self.j(400, {\"error\": \"invalid_request\"})\n            tok = \"tok%d\" % (len(TOKENS) + 1); TOKENS[tok] = True\n            # Real response has no expires_in and no refresh_token (per logs).\n            return self.j(200, {\"token_type\": \"bearer\", \"access_token\": tok, \"scope\": \"ACTIVITY:WRITE,WELLNESS:READ\",\n                                \"athlete\": {\"id\": \"i98765\", \"name\": \"T. Rivera\"}})\n        self.j(404, {\"error\": \"nf\"})\n\nThreadingHTTPServer((\"127.0.0.1\", 8800), H).serve_forever()\nEOF\n(python3 -I scratch/mock_intervals.py > scratch/mock.out 2>&1 &) ; sleep 1\n(INTERVALS_BASE=http://127.0.0.1:8800 python3 -I server.py > scratch/server_before.out 2>&1 &); sleep 1\necho \"--- 1. Connect link as the browser sends it (GET, no Authorization header)\"\ncurl -s -o /dev/null -w '%{http_code}\\n' http://localhost:8766/api/intervals/auth/init\necho \"--- 2. Same GET with the SPA's Bearer header, then follow to Intervals\"\nU=$(curl -s -o /dev/null -w '%{redirect_url}' -H 'Authorization: Bearer tok-rivera' http://localhost:8766/api/intervals/auth/init)\necho \"$U\"; curl -s -i \"$U\" | head -20","description":"Start mock Intervals and baseline server, reproduce failures"},"caller":{"type":"direct"}}],"container":nul