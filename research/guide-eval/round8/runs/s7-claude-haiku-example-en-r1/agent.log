ope\"),","+# and :WRITE already implies :READ. We write activities and calendar, read wellness.","+SCOPES = \"ACTIVITY:WRITE,WELLNESS:READ,CALENDAR:WRITE\""]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_0153EfVHJ23pwAeCoVCeGkVA","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
