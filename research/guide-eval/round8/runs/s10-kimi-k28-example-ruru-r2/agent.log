{"role":"tool","tool_call_id":"tool_ZB4Jah4TXvwU1eT73iHMt3fM","content":"1\tname: kredito\n2\tdescription: Consumer loan registration and offers.\n3\tpublish_to: \"none\"\n4\tversion: 1.3.0+27\n5\t\n6\tenvironment:\n7\t  sdk: ^3.5.0\n8\t\n9\tdependencies:\n10\t  flutter:\n11\t    sdk: flutter\n12\t  posthog_flutter: ^5.36.0\n13\t\n14\tdev_dependencies:\n15\t  flutter_test:\n16\t    sdk: flutter\n17\t  flutter_lints: ^5.0.0\n18\t\n19\tflutter:\n20\t  uses-material-design: true"}
{"role":"tool","tool_call_id":"tool_mdXwhRLVxObqur5vTCOu3uVz","content":"1\timport 'package:flutter/material.dart';\n2\timport 'package:posthog_flutter/posthog_flutter.dart';\n3\t\n4\timport 'analytics.dart';\n5\timport 'screens/offer_screen.dart';\n6\timport 'screens/registration_screen.dart';\n7\t\n8\tFuture<void> main() async {\n9\t  WidgetsFlutterBinding.ensureInitialized();\n10\t  await Analytics.init();\n11\t  runApp(const KreditoApp());\n12\t}\n13\t\n14\tclass KreditoApp extends StatelessWidget {\n15\t  const KreditoApp({super.key});\n16\t\n17\t  @override\n18\t  Widget build(BuildContext context) {\n19\t    return PostHogWidget(\n20\t      child: MaterialApp(\n21\t        title: 'Kredito',\n22\t        theme: ThemeData(colorSchemeSeed: Colors.green, useMaterial3: true),\n23\t        navigatorObservers: [PosthogObserver()],\n24\t        routes: {\n25\t          '/': (_) => const RegistrationScreen(),\n26\t          '/offers': (_) => const OfferScreen(),\n27\t        },\n28\t      ),\n29\t    );\n30\t  }\n31\t}"}
{"role":"tool","tool_call_id":"tool_kQTIRhBopi2Nimza2MdvGnXL","content":"1\timport 'package:flutter/material.dart';\n2\t\n3\tclass Offer {\n4\t  const Offer(this.bank, this.months, this.rate);\n5\t  final String bank;\n6\t  final int months;\n7\t  final double rate;\n8\t}\n9\t\n10\tconst _offers = [\n11\t  Offer('Norbank', 12, 9.9),\n12\t  Offer('Norbank', 24, 10.4),\n13\t  Offer('Fjordcredit', 12, 8.7),\n14\t  Offer('Fjordcredit', 36, 11.2),\n15\t  Offer('Vestkapital', 24, 9.5),\n16\t  Offer('Vestkapital', 48, 12.0),\n17\t  Offer('Sparbank', 12, 10.9),\n18\t  Offer('Sparbank', 60, 12.8),\n19\t  Offer('Nordlån', 36, 10.1),\n20\t  Offer('Nordlån', 60, 12.3),\n21\t];\n22\t\n23\tclass OfferScreen extends StatelessWidget {\n24\t  const OfferScreen({super.key});\n25\t\n26\t  @override\n27\t  Widget build(BuildContext context) {\n28\t    return Scaffold(\n29\t      appBar: AppBar(title: const Text('Offers')),\n30\t      body: ListView.builder(\n31\t        itemCount: _offers.length,\n32\t        itemBuilder: (context, i) {\n33\t          final o = _offers[i];\n34\t          return ListTile(\n35\t            leading: const Icon(Icons.account_balance),\n36\t            title: Text('${o.bank}, ${o.months} months'),\n37\t            subtitle: Text('${o.rate.toStringAsFixed(1)}% APR'),\n38\t            trailing: const Icon(Icons.chevron_right),\n39\t            onTap: () {},\n40\t          );\n41\t        },\n42\t      ),\n43\t    );\n44\t  }\n45\t}"}
{"role":"tool","tool_call_id":"tool_Idk0XZ50fIcuANB2Kc58cbDe","content":"1\timport 'package:flutter/material.dart';\n2\t\n3\tclass RegistrationScreen extends StatefulWidget {\n4\t  const RegistrationScreen({super.key});\n5\t\n6\t  @override\n7\t  State<RegistrationScreen> createState() => _RegistrationScreenState();\n8\t}\n9\t\n10\tclass _RegistrationScreenState extends State<RegistrationScreen> {\n11\t  final _email = TextEditingController();\n12\t  final _phone = TextEditingController();\n13\t  double _amount = 50000;\n14\t  bool _terms = false;\n15\t\n16\t  @override\n17\t  void dispose() {\n18\t    _email.dispose();\n19\t    _phone.dispose();\n20\t    super.dispose();\n21\t  }\n22\t\n23\t  bool get _canContinue =>\n24\t      _terms && _email.text.contains('@') && _phone.text.length >= 10;\n25\t\n26\t  @override\n27\t  Widget build(BuildContext context) {\n28\t    return Scaffold(\n29\t      appBar: AppBar(title: const Text('Register')),\n30\t      body: Padding(\n31\t        padding: const EdgeInsets.all(16),\n32\t        child: Column(\n33\t          crossAxisAlignment: CrossAxisAlignment.stretch,\n34\t          children: [\n35\t            TextField(\n36\t              controller: _email,\n37\t              keyboardType: TextInputType.emailAddress,\n38\t              decoration: const InputDecoration(labelText: 'Email'),\n39\t              onChanged: (_) => setState(() {}),\n40\t            ),\n41\t            const SizedBox(height: 12),\n42\t            TextField(\n43\t              controller: _phone,\n44\t              keyboardType: TextInputType.phone,\n45\t              decoration: const InputDecoration(labelText: 'Phone'),\n46\t              onChanged: (_) => setState(() {}),\n47\t            ),\n48\t            const SizedBox(height: 24),\n49\t            Text('Loan amount: ${_amount.round()}'),\n50\t            Slider(\n51\t              min: 10000,\n52\t              max: 500000,\n53\t              divisions: 49,\n54\t              value: _amount,\n55\t              label: _amount.round().toString(),\n56\t              onChanged: (v) => setState(() => _amount = v),\n57\t            ),\n58\t            CheckboxListTile(\n59\t              value: _terms,\n60\t              title: const Text('I accept the terms and conditions'),\n61\t              controlAffinity: ListTileControlAffinity.leading,\n62\t              onChanged: (v) => setState(() => _terms = v ?? false),\n63\t            ),\n64\t            const Spacer(),\n65\t            FilledButton(\n66\t              onPressed: _canContinue\n67\t                  ? () => Navigator.of(context).pushNamed('/offers')\n68\t                  : null,\n69\t              child: const Text('Continue'),\n70\t            ),\n71\t          ],\n72\t        ),\n73\t      ),\n74\t    );\n75\t  }\n76\t}"}
