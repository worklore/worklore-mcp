{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgS3TQDu5ATctX1v6Tj55","type":"message","role":"assistant","content":[{"type":"text","text":"I've split the system prompt into a stable block plus append-only fact blocks. Next I'm writing a test that simulates prefix caching to confirm a save no longer rewrites the cache."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4840,"cache_read_input_tokens":29752,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4840},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"f3b6e0e3-f798-4342-961d-3ea08af63fbf","uuid":"1ae79dfd-dd38-4c52-a1ee-e568cf797ac7","timestamp":"2026-10-27T03:37:02.717Z","request_id":"req_011CgS3TPxX86HDG3Q6icpV5"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgS3TQDu5ATctX1v6Tj55","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01DE2fTjqVk7PR59XMxxy9z9","name":"Bash","input":{"command":"cd /private/tmp/h-GSueMt; mkdir -p tests; cat > tests/test_prompt_cache.py <<'E'\n\"\"\"Offline check of the cache layout: a fake LLM that mimics prefix caching.\n\nThe fake splits each request into blocks (tools, then system blocks, then message\nblocks), writes a cache entry at every cache_control breakpoint and, like the API,\nlooks back up to 20 block boundaries before a breakpoint for an earlier entry.\nToken counts are approximated as chars/4; only the ratios matter here.\n\"\"\"\nimport json\nimport os\nimport sys\nimport tempfile\nimport types\nimport unittest\n\nsys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), \"..\"))\nimport bot  # noqa: E402\n\n\ndef _blocks(req):\n    out = [(json.dumps(req[\"tools\"]), False)]\n    out += [(b[\"text\"], \"cache_control\" in b) for b in req[\"system\"]]\n    for m in req[\"messages\"]:\n        content = m[\"content\"] if isinstance(m[\"content\"], list) else [{\"type\": \"text\", \"text\": m[\"content\"]}]\n        out += [(json.dumps(c), \"cache_control\" in c) for c in content]\n    return out\n\n\nclass FakeLLM:\n    def __init__(self, script):\n        self.cache = set()\n        self.script = list(script)  # per call: None (text reply) or a save_fact string\n\n    def create(self, **req):\n        blocks = _blocks(req)\n        toks = [len(t) // 4 for t, _ in blocks]\n        prefixes = [\"\\x00\".join(t for t, _ in blocks[:i + 1]) for i in range(len(blocks))]\n        read = 0\n        for i, (_, bp) in enumerate(blocks):\n            if not bp:\n                continue\n            for j in range(i, max(-1, i - 20), -1):\n                if prefixes[j] in self.cache:\n                    read = max(read, sum(toks[:j + 1]))\n                    break\n            self.cache.add(prefixes[i])\n        last_bp = max([i for i, (_, bp) in enumerate(blocks) if bp], default=-1)\n        cached_total = sum(toks[:last_bp + 1])\n        usage = types.SimpleNamespace(input_tokens=sum(toks) - cached_total, cache_read_input_tokens=read,\n                                      cache_creation_input_tokens=cached_total - read, output_tokens=10)\n        step = self.script.pop(0)\n        if step is None:\n            content = [types.SimpleNamespace(type=\"text\", text=\"ok\", model_dump=lambda: {\"type\": \"text\", \"text\": \"ok\"})]\n            stop = \"end_turn\"\n        else:\n            d = {\"type\": \"tool_use\", \"id\": f\"t{len(self.script)}\", \"name\": \"save_fact\", \"input\": {\"fact\": step}}\n            content = [types.SimpleNamespace(type=\"tool_use\", id=d[\"id\"], name=\"save_fact\", input=d[\"input\"],\n                                             model_dump=lambda d=d: d)]\n            stop = \"tool_use\"\n        return types.SimpleNamespace(content=content, stop_reason=stop, usage=usage)\n\n\nclass CacheLayoutTest(unittest.TestCase):\n    def setUp(self):\n        self.tmp = tempfile.mkdtemp()\n        bot.ATHLETES_FILE = os.path.join(self.tmp, \"athletes.json\")\n        bot.USAGE_LOG = os.path.join(self.tmp, \"usage.jsonl\")\n        bot.save_athlete(bot.Athlete(user_id=\"1\", name=\"Test\", facts=[\"Owns a Garmin 255\"]))\n\n    def usage(self):\n        with open(bot.USAGE_LOG) as f:\n            return [json.loads(l) for l in f]\n\n    def test_save_fact_keeps_prefix_cached(self):\n        llm = FakeLLM([None, \"Runs Mon/Wed/Fri\", None, None, \"Has a smart trainer\", None])\n        bot.reply(\"1\", \"hi\", llm)\n        bot.reply(\"1\", \"I run on Mon/Wed/Fri\", llm)   # save_fact, then a second round\n        bot.reply(\"1\", \"how was that\", llm)\n        bot.reply(\"1\", \"I bought a trainer\", llm)    # save_fact again\n        u = self.usage()\n        static = u[0][\"cache_creation_input_tokens\"]\n        self.assertGreater(static, 500)\n        for rec in u[1:]:\n            # after the first write nothing re-writes more than one fact's worth of tokens\n            self.assertLess(rec[\"cache_creation_input_tokens\"], 30, rec)\n            self.assertGreaterEqual(rec[\"cache_read_input_tokens\"], static, rec)\n\n    def test_facts_are_in_the_prompt(self):\n        a = bot.load_athlete(\"1\")\n        text = \"\".join(b[\"text\"] for b in bot.build_system(a, bot.dt.date(2026, 4, 18)))\n        self.assertIn(\"- Owns a Garmin 255\\n\", text)\n        self.assertIn(\"Language: en\", text)\n        self.assertLessEqual(sum(\"cache_control\" in b for b in bot.build_system(a, bot.dt.date.today())), 2)\n\n\nif __name__ == \"__main__\":\n    unittest.main()\nE\npython3 -m unittest tests/test_prompt_cache.py -v 2>&1 | tail -5; git stash -q; python3 -m unittest tests/test_prompt_cache.py 2>&1 | grep -E \"FAIL|AssertionError|OK\" | head -3; git stash pop -q; git status --short"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4840,"cache_read_input_tokens":29752,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4840},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"f3b6e0e3-f798-4342-961d-3ea08af63fbf","uuid":"11e88225-a95d-41bf-a3b2-d1d810face24","timestamp":"2026-10-27T03:37:17.307Z","request_id":"req_011CgS3TPxX86HDG3Q6icpV5","wire_tool_inputs":{"toolu_01DE2fTjqVk7PR59XMxxy9z9":{"command":"cd /private/tmp/h-GSueMt; mkdir -p tests; cat > tests/test_prompt_cache.py <<'E'\n\"\"\"Offline check of the cache layout: a fake LLM that mimics prefix caching.\n\nThe fake splits each request into blocks (tools, then system blocks, then message\nblocks), writes a cache entry at every cache_control breakpoint and, like the API,\nlooks back up to 20 block boundaries before a breakpoint for an earlier entry.\nToken counts are approximated as chars/4; only the ratios matter here.\n\"\"\"\nimport json\nimport os\nimport sys\nimport tempfile\nimport types\nimport unittest\n\nsys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), \"..\"))\nimport bot  # noqa: E402\n\n\ndef _blocks(req):\n    out = [(json.dumps(req[\"tools\"]), False)]\n    out += [(b[\"text\"], \"cache_control\" in b) for b in req[\"system\"]]\n    for m in req[\"messages\"]:\n        content = m[\"content\"] if isinstance(m[\"content\"], list) else [{\"type\": \"text\", \"text\": m[\"content\"]}]\n        out += [(json.dumps(c), \"cache_control\" in c) for c in content]\n    return out\n\n\nclass FakeLLM:\n    def __init__(self, script):\n        self.cache = set()\n        self.script = list(script)  # per call: None (text reply) or a save_fact string\n\n    def create(self, **req):\n        blocks = _blocks(req)\n        toks = [len(t) // 4 for t, _ in blocks]\n        prefixes = [\"\\x00\".join(t for t, _ in blocks[:i + 1]) for i in range(len(blocks))]\n        read = 0\n        for i, (_, bp) in enumerate(blocks):\n            if not bp:\n                continue\n            for j in range(i, max(-1, i - 20), -1):\n                if prefixes[j] in self.cache:\n                    read = max(read, sum(toks[:j + 1]))\n                    break\n            self.cache.add(prefixes[i])\n        last_bp = max([i for i, (_, bp) in enumerate(blocks) if bp], default=-1)\n        cached_total = sum(toks[:last_bp + 1])\n        usage = types.SimpleNamespace(input_tokens=sum(toks) - cached_total, cache_read_input_tokens=read,\n                                      cache_creation_input_tokens=cached_total - read, output_tokens=10)\n        step = self.script.pop(0)\n        if step is None:\n            content = [types.SimpleNamespace(type=\"text\", text=\"ok\", model_dump=lambda: {\"type\": \"text\", \"text\": \"ok\"})]\n            stop = \"end_turn\"\n        else:\n            d = {\"type\": \"tool_use\", \"id\": f\"t{len(self.script)}\", \"name\": \"save_fact\", \"input\": {\"fact\": step}}\n            content = [types.SimpleNamespace(type=\"tool_use\", id=d[\"id\"], name=\"save_fact\", input=d[\"input\"],\n                                             model_dump=lambda d=d: d)]\n            stop = \"tool_use\"\n        return types.SimpleNamespace(content=content, stop_reason=stop, usage=usage)\n\n\nclass CacheLayoutTest(unittest.TestCase):\n    def setUp(self):\n        self.tmp = tempfile.mkdtemp()\n        bot.ATHLETES_FILE = os.path.join(self.tmp, \"athletes.json\")\n        bot.USAGE_LOG = os.path.join(self.tmp, \"usage.jsonl\")\n        bot.save_athlete(bot.Athlete(user_id=\"1\", name=\"Test\", facts=[\"Owns a Garmin 255\"]))\n\n    def usage(self):\n        with open(bot.USAGE_LOG) as f:\n            return [json.loads(l) for l in f]\n\n    def test_save_fact_keeps_prefix_cached(self):\n        llm = FakeLLM([None, \"Runs Mon/Wed/Fri\", None, None, \"Has a smart trainer\", None])\n        bot.reply(\"1\", \"hi\", llm)\n        bot.reply(\"1\", \"I run on Mon/Wed/Fri\", llm)   # save_fact, then a second round\n        bot.reply(\"1\", \"how was that\", llm)\n        bot.reply(\"1\", \"I bought a trainer\", llm)    # save_fact again\n        u = self.usage()\n        static = u[0][\"cache_creation_input_tokens\"]\n        self.assertGreater(static, 500)\n        for rec in u[1:]:\n            # after the first write nothing re-writes more than one fact's worth of tokens\n            self.assertLess(rec[\"cache_creation_input_tokens\"], 30, rec)\n            self.assertGreaterEqual(rec[\"cache_read_input_tokens\"], static, rec)\n\n    def test_facts_are_in_the_prompt(self):\n        a = bot.load_athlete(\"1\")\n        text = \"\".join(b[\"text\"] for b in bot.build_system(a, bot.dt.date(2026, 4, 18)))\n        self.assert