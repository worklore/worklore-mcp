n\", text)","+        self.assertIn(\"Language: en\", text)","+        self.assertLessEqual(sum(\"cache_control\" in b for b in bot.build_system(a, bot.dt.date.today())), 2)","+","+","+if __name__ == \"__main__\":","+    unittest.main()"]}],"created":true}],"moreFiles":2,"changedFiles":["/private/tmp/h-GSueMt/__pycache__/bot.cpython-314.pyc","/private/tmp/h-GSueMt/tests/__pycache__/test_prompt_cache.cpython-314.pyc","/private/tmp/h-GSueMt/tests/test_prompt_cache.py"]}},"tool_result_meta":[{"id":"toolu_01DE2fTjqVk7PR59XMxxy9z9","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
