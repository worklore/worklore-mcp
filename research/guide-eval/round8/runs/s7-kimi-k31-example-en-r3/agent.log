{"role":"tool","tool_call_id":"tool_ShguJSWaMKdWq6MWkMtAGtfX","content":"120\t            self.send_json(401, {\"error\": \"unauthorized\"})\n121\t        return user\n122\t\n123\t    def do_GET(self):\n124\t        url = urllib.parse.urlsplit(self.path)\n125\t        q = dict(urllib.parse.parse_qsl(url.query))\n126\t        if url.path == \"/\":\n127\t            return self.send_file(\"index.html\", \"text/html; charset=utf-8\")\n128\t        if url.path.startswith(\"/static/\"):\n129\t            return self.send_file(os.path.basename(url.path), \"application/javascript\" if url.path.endswith(\".js\") else \"text/plain\")\n130\t        if url.path == \"/api/me\":\n131\t            user = self.require_user()\n132\t            return user and self.send_json(200, user)\n133\t        if url.path == \"/api/intervals/auth/init\":\n134\t            return self.auth_init()\n135\t        if url.path == \"/api/intervals/callback\":\n136\t            return self.callback(q)\n137\t        if url.path == \"/api/intervals/status\":\n138\t            return self.status()\n139\t        if url.path == \"/api/intervals/wellness\":\n140\t            return self.wellness()\n141\t        self.send_json(404, {\"error\": \"not found\"})\n142\t\n143\t    def do_POST(self):\n144\t        url = urllib.parse.urlsplit(self.path)\n145\t        if url.path == \"/api/intervals/disconnect\":\n146\t            user = self.require_user()\n147\t            if user:\n148\t                with LOCK:\n149\t                    CONNECTIONS.pop(user[\"id\"], None)\n150\t                self.send_json(200, {\"ok\": True})\n151\t            return\n152\t        self.send_json(404, {\"error\": \"not found\"})\n153\t\n154\t    # Step 1: build the authorize URL and send the browser to Intervals.\n155\t    def auth_init(self):\n156\t        user = self.require_user()\n157\t        if not user:\n158\t            return\n159\t        params = {\"client_id\": config.CLIENT_ID, \"redirect_uri\": config.REDIRECT_URI,\n160\t                  \"scope\": config.SCOPES, \"state\": sign_state(user[\"id\"])}\n161\t        self.redirect(AUTHORIZE_URL + \"?\" + urllib.parse.urlencode(params, safe=\":,\"))\n162\t\n163\t    # Step 2: Intervals redirects back here with ?code=&state=.\n164\t    def callback(self, q):\n165\t        user_id = verify_state(q.get(\"state\", \"\"))\n166\t        if not user_id or not q.get(\"code\"):\n167\t            return self.send_json(400, {\"error\": \"bad state or code\"})\n168\t        try:\n169\t            tok = exchange_code(q[\"code\"])\n170\t            store_connection(user_id, tok)\n171\t        except urllib.error.HTTPError as e:\n172\t            log(f\"{user_id}: token exchange failed: HTTP {e.code} {e.read()[:200]!r}\")\n173\t            return self.send_json(502, {\"error\": \"token exchange failed\"})\n174\t        except Exception as e:\n175\t            log(f\"{user_id}: token exchange failed: {e}\")\n176\t            return self.send_json(502, {\"error\": \"token exchange failed\"})\n177\t        self.redirect(\"/?connected=1\")\n178\t\n179\t    def status(self):\n180\t        user = self.require_user()\n181\t        if not user:\n182\t            return\n183\t        with LOCK:\n184\t            c = CONNECTIONS.get(user[\"id\"])\n185\t        if not c or c[\"status\"] != \"connected\":\n186\t            return self.send_json(200, {\"connected\": False, \"status\": c[\"status\"] if c else \"disconnected\"})\n187\t        self.send_json(200, {\"connected\": True, \"status\": \"connected\", \"scope\": c[\"scope\"],\n188\t                             \"athlete\": {\"id\": c[\"athlete_id\"], \"name\": c[\"athlete_name\"]}})\n189\t\n190\t    def wellness(self):\n191\t        user = self.require_user()\n192\t        if not user:\n193\t            return\n194\t        with LOCK:\n195\t            c = CONNECTIONS.get(user[\"id\"])\n196\t        if not c or c[\"status\"] != \"connected\":\n197\t            return self.send_json(409, {\"error\": \"intervals not connected\"})\n198\t        try:\n199\t            code, data = intervals_get(c, \"/wellness\")\n200\t            self.send_json(code, data)\n201\t        except urllib.error.HTTPError as e:\n202\t            self.send_json(e.code, {\"error\": f\"intervals returned {e.code}\"})\n203\t        except Exception as e:\n204\t            self.send_json(502, {\"error\": str(e)})\n205\t\n206\t\n207\tif __name__ == \"__main__\":\n208\t    threading.Thread(target=refresh_tokens, daemon=True).start()\n209\t    log(f\"serving on http://localhost:{config.PORT} (intervals: {config.INTERVALS_BASE})\")\n210\t    ThreadingHTTPServer((\"127.0.0.1\", config.PORT), Handler).serve_forever()"}
