{"role":"assistant","content":"I’m exercising the real HTTP endpoints against a local mock Intervals.icu server, including the callback’s exact form fields, a token response without expiry metadata, wellness access after a simulated two-hour interval, and revocation handling.","tool_calls":[{"type":"function","id":"tool_To3loHQu4BG2Bh8Kg1OJBOFN","function":{"name":"Bash","arguments":"{\"command\":\"python3 - <<'PY'\\nimport http.client\\nimport json\\nimport os\\nimport threading\\nimport time as real_time\\nimport urllib.parse\\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\\n\\nprovider_requests = []\\nrevoked = False\\n\\nclass Provider(BaseHTTPRequestHandler):\\n    def log_message(self, *args):\\n        pass\\n\\n    def reply(self, status, body):\\n        data = json.dumps(body).encode()\\n        self.send_response(status)\\n        self.send_header('Content-Type', 'application/json')\\n        self.send_header('Content-Length', str(len(data)))\\n        self.end_headers()\\n        self.wfile.write(data)\\n\\n    def do_POST(self):\\n        length = int(self.headers.get('Content-Length', 0))\\n        fields = dict(urllib.parse.parse_qsl(self.rfile.read(length).decode()))\\n        provider_requests.append((self.path, fields))\\n        if self.path != '/api/oauth/token':\\n            return self.reply(404, {'error': 'not found'})\\n        expected = {'client_id', 'client_secret', 'code'}\\n        if set(fields) != expected or fields['code'] != 'valid-code':\\n            return self.reply(400, {'error': 'invalid fields', 'fields': fields})\\n        self.reply(200, {\\n            'token_type': 'bearer',\\n            'access_token': 'perpetual-token',\\n            'scope': 'ACTIVITY:WRITE,WELLNESS:READ,CALENDAR:WRITE',\\n            'athlete': {'id': 'i98765', 'name': 'T. Rivera'},\\n        })\\n\\n    def do_GET(self):\\n        provider_requests.append((self.path, dict(self.headers)))\\n        if self.path == '/api/v1/athlete/i98765/wellness':\\n            if revoked or self.headers.get('Authorization') != 'Bearer perpetual-token':\\n                return self.reply(401, {'error': 'unauthorized'})\\n            return self.reply(200, {'wellness': [{'id': 1, 'sleepScore': 88}]})\\n        self.reply(404, {'error': 'not found'})\\n\\nprovider = ThreadingHTTPServer(('127.0.0.1', 0), Provider)\\nthreading.Thread(target=provider.serve_forever, daemon=True).start()\\nos.environ['INTERVALS_BASE'] = f'http://127.0.0.1:{provider.server_port}'\\n\\nimport server\\n\\napp = ThreadingHTTPServer(('127.0.0.1', 0), server.Handler)\\nthreading.Thread(target=app.serve_forever, daemon=True).start()\\nserver.config.REDIRECT_URI = f'http://127.0.0.1:{app.server_port}/api/intervals/callback'\\n\\n\\ndef request(method, path, token=None):\\n    conn = http.client.HTTPConnection('127.0.0.1', app.server_port, timeout=5)\\n    headers = {'Authorization': f'Bearer {token}'} if token else {}\\n    conn.request(method, path, headers=headers)\\n    response = conn.getresponse()\\n    raw = response.read()\\n    body = json.loads(raw) if raw and response.getheader('Content-Type') == 'application/json' else raw.decode()\\n    result = response.status, dict(response.getheaders()), body\\n    conn.close()\\n    return result\\n\\ntry:\\n    status, _, body = request('POST', '/api/intervals/auth/init')\\n    assert (status, body) == (401, {'error': 'unauthorized'})\\n\\n    status, _, body = request('GET', '/api/intervals/auth/init', 'tok-rivera')\\n    assert status == 404, (status, body)\\n\\n    status, _, body = request('POST', '/api/intervals/auth/init', 'tok-rivera')\\n    assert status == 200, (status, body)\\n    auth_url = urllib.parse.urlsplit(body['authorize_url'])\\n    query = dict(urllib.parse.parse_qsl(auth_url.query))\\n    assert query['scope'] == 'ACTIVITY:WRITE,WELLNESS:READ,CALENDAR:WRITE'\\n    areas = [scope.split(':')[0] for scope in query['scope'].split(',')]\\n    assert len(areas) == len(set(areas))\\n    assert server.verify_state(query['state']) == 'u_rivera'\\n\\n    callback = '/api/intervals/callback?' + urllib.parse.urlencode({'code': 'valid-code', 'state': query['state']})\\n    status, headers, _ = request('GET', callback)\\n    assert status == 302 and headers['Location'] == '/?connected=1', (status, headers)\\n    token_calls = [fields for path, fields in provider_requests if path == '/api/oauth/token']\\n    assert token_calls == [{'client_id': 'tricoach-dev', 'client_secret': 's3cr3t-placeholder-0000', 'code': 'valid-code'}]\\n\\n    status, _, body = request('GET', '/api/intervals/status', 'tok-rivera')\\n    assert status == 200 and body['connected'] is True and body['athlete']['id'] == 'i98765'\\n    connection = server.CONNECTIONS['u_rivera']\\n    assert connection['access_token'] == 'perpetual-token'\\n    assert 'expires_at' not in connection and 'refresh_token' not in connection\\n\\n    class Later:\\n        @staticmethod\\n        def time():\\n            return real_time.time() + 7200\\n        strftime = staticmethod(real_time.strftime)\\n\\n    server.time = Later\\n    status, _, body = request('GET', '/api/intervals/status', 'tok-rivera')\\n    assert status == 200 and body['connected'] is True, body\\n    server.time = real_time\\n\\n    status, _, body = request('GET', '/api/intervals/wellness', 'tok-rivera')\\n    assert status == 200 and body['wellness'][0]['sleepScore'] == 88, (status, body)\\n\\n    revoked = True\\n    status, _, body = request('GET', '/api/intervals/wellness', 'tok-rivera')\\n    assert status == 401 and 'reconnect' in body['error'], (status, body)\\n    assert server.CONNECTIONS['u_rivera']['access_token'] is None\\n    status, _, body = request('GET', '/api/intervals/status', 'tok-rivera')\\n    assert body == {'connected': False, 'status': 'revoked, reconnect'}, body\\n    status, _, body = request('GET', '/api/intervals/wellness', 'tok-rivera')\\n    assert status == 409, (status, body)\\n\\n    print('PASS: authenticated POST init; old GET rejected')\\n    print('PASS: unique ACTIVITY/WELLNESS/CALENDAR scopes and valid signed state')\\n    print('PASS: callback exchanges only client_id, client_secret, and code')\\n    print('PASS: token without expires_in/refresh_token remains connected after two hours')\\n    print('PASS: wellness uses the Bearer token and athlete id')\\n    print('PASS: provider 401 clears the token and requires reconnect')\\nfinally:\\n    server.time = real_time\\n    app.shutdown()\\n    app.server_close()\\n    provider.shutdown()\\n    provider.server_close()\\nPY\",\"cwd\":\"/private/tmp/h-RW9w0r\",\"timeout\":60}"}}]}
