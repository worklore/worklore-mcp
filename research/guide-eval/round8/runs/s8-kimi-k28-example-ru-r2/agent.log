f.id, self.input = type_, text, name, id, input\\n    def model_dump(self):\\n        d = {\\\"type\\\": self.type}\\n        if self.text is not None: d[\\\"text\\\"] = self.text\\n        else: d.update({\\\"name\\\": self.name, \\\"id\\\": self.id, \\\"input\\\": self.input})\\n        return d\\nclass Usage:\\n    input_tokens, cache_creation_input_tokens, cache_read_input_tokens, output_tokens = 10, 0, 0, 5\\nclass Resp:\\n    def __init__(self, content, stop):\\n        self.content, self.stop_reason, self.usage = content, stop, Usage()\\nclass FakeLLM:\\n    def __init__(self): self.systems = []\\n    def create(self, **kw):\\n        self.systems.append(kw[\\\"system\\\"])\\n        if len(self.systems) == 1:\\n            return Resp([Blk(\\\"tool_use\\\", name=\\\"save_fact\\\", id=\\\"t1\\\", input={\\\"fact\\\": \\\"test fact\\\"})], \\\"tool_use\\\")\\n        return Resp([Blk(\\\"text\\\", text=\\\"ok\\\")], \\\"end_turn\\\")\\n\\nllm = FakeLLM()\\nout = bot.reply(\\\"42\\\", \\\"remember this test fact\\\", llm=llm)\\nassert out == \\\"ok\\\" and len(llm.systems) == 2\\n# Round 2 after save_fact: static block identical, only the tail changed —\\n# i.e. the API would re-create only the tail segment, not the instructions.\\nassert llm.systems[1][0][\\\"text\\\"] == llm.systems[0][0][\\\"text\\\"], \\\"facts write evicted static block!\\\"\\nassert llm.systems[1][1][\\\"text\\\"] != llm.systems[0][1][\\\"text\\\"], \\\"tail should have changed\\\"\\nassert \\\"test fact\\\" in llm.systems[1][1][\\\"text\\\"]\\n\\n# 4) Fact was persisted and will be visible on the next message.\\nassert any(\\\"test fact\\\" in f for f in bot.load_athlete(\\\"42\\\").facts)\\nprint(\\\"all checks passed\\\")\\nEOF\\ncp .verify_tmp/athletes.json.bak data/athletes.json\\ncp .verify_tmp/usage.jsonl.bak logs/usage.jsonl\\nrm -rf .verify_tmp __pycache__\\ngit status --porcelain\"}"}}]}
