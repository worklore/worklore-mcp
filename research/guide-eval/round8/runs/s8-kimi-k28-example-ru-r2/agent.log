{"role":"assistant","tool_calls":[{"type":"function","id":"tool_ahvzbOEWqlVM0VJuU5ETeFwL","function":{"name":"Edit","arguments":"{\"path\":\"bot.py\",\"old_string\":\"def build_system(a, today):\\n    # One block, cached as a whole: instructions + per-athlete context.\\n    text = INSTRUCTIONS + \\\"\\\\n\\\\n\\\" + athlete_context(a, today)\\n    return [{\\\"type\\\": \\\"text\\\", \\\"text\\\": text, \\\"cache_control\\\": {\\\"type\\\": \\\"ephemeral\\\"}}]\",\"new_string\":\"def build_system(a, today):\\n    # Two cached segments: the static instructions, then the per-athlete tail\\n    # (date, profile, zones, goal, facts, language). A memory write changes only\\n    # the tail, so the instructions stay in cache instead of being re-created.\\n    return [\\n        {\\\"type\\\": \\\"text\\\", \\\"text\\\": INSTRUCTIONS, \\\"cache_control\\\": {\\\"type\\\": \\\"ephemeral\\\"}},\\n        {\\\"type\\\": \\\"text\\\", \\\"text\\\": athlete_context(a, today), \\\"cache_control\\\": {\\\"type\\\": \\\"ephemeral\\\"}},\\n    ]\"}"}}]}
