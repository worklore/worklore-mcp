{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CECc8P4q49brdMyJ5uyKVV","type":"tool_result","content":"60\t    raw = _load_all().get(str(user_id))\n61\t    if raw is None:\n62\t        return Athlete(user_id=str(user_id), name=\"athlete\")\n63\t    return Athlete(**raw)\n64\t\n65\t\n66\tdef save_athlete(a):\n67\t    allrec = _load_all()\n68\t    allrec[a.user_id] = asdict(a)\n69\t    os.makedirs(os.path.dirname(ATHLETES_FILE), exist_ok=True)\n70\t    with open(ATHLETES_FILE, \"w\") as f:\n71\t        json.dump(allrec, f, indent=1, ensure_ascii=False)\n72\t\n73\t# --------------------------------------------------------------------------- system prompt\n74\tINSTRUCTIONS = \"\"\"You are Pace, an endurance coach for recreational runners and cyclists.\n75\t\n76\tCoaching rules:\n77\t1. Answer the question that was asked before adding anything else.\n78\t2. Keep replies short: a chat message, not an article. Three paragraphs at most.\n79\t3. Prescribe training by heart-rate zone or RPE, never by pace, unless the athlete asks for pace.\n80\t4. Use the athlete's own zones from the profile below; never invent zone boundaries.\n81\t5. Easy days are easy: anything labelled recovery or Z1/Z2 must stay there.\n82\t6. Never add more than 10% weekly volume over the previous week.\n83\t7. One hard session per week for beginners, two for athletes with 3+ years of training.\n84\t8. A rest day is a session. Do not fill it.\n85\t9. If the athlete reports pain (not soreness) lasting more than two days, stop the plan and say to see a physio.\n86\t10. Do not diagnose injuries or illness. Do not give medication advice.\n87\t11. Fuelling: 30-60 g carbs per hour for sessions over 75 minutes; mention it only when relevant.\n88\t12. Sleep and stress count as training load. Ask about them when the athlete looks flat.\n89\t13. Before a goal race, the last hard session is 7-10 days out. Taper means less volume, same intensity.\n90\t14. Do not change the athlete's goal unless they ask. Mention the goal when a question is clearly off-plan.\n91\t15. When the athlete tells you something durable about themselves (injury history, schedule, preferences,\n92\t    equipment, races booked), call save_fact once with a single sentence. Do not save moods or one-off plans.\n93\t16. Do not save a fact that is already in the list below.\n94\t17. Use the plan_week tool for any weekly structure; do not write a week by hand.\n95\t18. Use log_session when the athlete reports a completed workout, then comment on it.\n96\t19. If asked for numbers you do not have (recent volume, last race), ask one question, do not guess.\n97\t20. Metric units unless the profile says otherwise.\n98\t\n99\tTone:\n100\t- Warm, direct, no exclamation marks.\n101\t- No motivational quotes.\n102\t- Address the athlete by first name at most once per reply.\n103\t- Reply in the athlete's language from the profile below, even if they write in another language.\n104\t\n105\tSafety:\n106\t- Never advise training through chest pain, dizziness or fever.\n107\t- Minors: refer to a coach in person.\n108\t- If someone asks for weight-loss plans below 1500 kcal per day, decline and suggest a dietitian.\n109\t\n110\tFormatting:\n111\t- Plain text. No markdown headings, no tables.\n112\t- Lists only for a session structure (warm-up / main / cool-down).\n113\t- Numbers with units: 45 min, 12 km, 150 bpm.\n114\t\"\"\"\n115\t\n116\t\n117\tdef athlete_context(a, today):\n118\t    lines = [\n119\t        f\"Today: {today.isoformat()} ({today.strftime('%A')})\",\n120\t        f\"Athlete: {a.name} (id {a.user_id}), sport: {a.sport}\",\n121\t        \"Zones: \" + \", \".join(f\"{k} {v}\" for k, v in a.zones.items()),\n122\t        f\"Goal: {a.goal}\",\n123\t        \"Long-term facts:\",\n124\t    ]\n125\t    lines += [f\"- {f}\" for f in a.facts] or [\"- (none yet)\"]\n126\t    lines.append(f\"Language: {a.lang}\")\n127\t    return \"\\n\".join(lines)\n128\t\n129\t\n130\tdef build_system(a, today):\n131\t    # One block, cached as a whole: instructions + per-athlete context.\n132\t    text = INSTRUCTIONS + \"\\n\\n\" + athlete_context(a, today)\n133\t    return [{\"type\": \"text\", \"text\": text, \"cache_control\": {\"type\": \"ephemeral\"}}]\n134\t\n135\t# --------------------------------------------------------------------------- tools\n136\tCORE_TOOLS = [\n137\t    {\"name\": \"save_fact\", \"description\": \"Remember one durable fact about the athlete.\",\n138\t     \"input_schema\": {\"type\": \"object\", \"properties\": {\"fact\": {\"type\": \"string\"}}, \"required\": [\"fact\"]}},\n139\t    {\"name\": \"log_session\", \"description\": \"Record a completed workout.\",\n140\t     \"input_schema\": {\"type\": \"object\", \"properties\": {\"minutes\": {\"type\": \"integer\"}, \"rpe\": {\"type\": \"integer\"},\n141\t                                                       \"note\": {\"type\": \"string\"}}, \"required\": [\"minutes\"]}},\n142\t]\n143\tTOOL_GROUPS = {\n144\t    \"plan\": ((\"plan\", \"week\", \"schedule\", \"taper\", \"build\"), [\n145\t        {\"name\": \"plan_week\", \"description\": \"Draft a week of sessions.\",\n146\t         \"input_schema\": {\"type\": \"object\", \"properties\": {\"hours\": {\"type\": \"number\"}, \"hard_days\": {\"type\": \"integer\"}},\n147\t                          \"required\": [\"hours\"]}}]),\n148\t    \"race\": ((\"race\", \"pace\", \"predict\", \"finish time\"), [\n149\t        {\"name\": \"predict_race\", \"description\": \"Estimate a finish time from a recent effort.\",\n150\t         \"input_schema\": {\"type\": \"object\", \"properties\": {\"distance_km\": {\"type\": \"number\"}, \"recent_minutes\": {\"type\": \"number\"}},\n151\t                          \"required\": [\"distance_km\"]}}]),\n152\t}\n153\t\n154\t\n155\tdef select_tools(text):\n156\t    \"\"\"Core tools always; a group is added only when the message mentions its keywords.\"\"\"\n157\t    tools = list(CORE_TOOLS)\n158\t    low = text.lower()\n159\t    for _, (keys, group) in TOOL_GROUPS.items():\n160\t        if any(k in low for k in keys):\n161\t            tools += group\n162\t    return tools\n163\t\n164\t\n165\tdef run_tool(a, name, args):\n166\t    if name == \"save_fact\":\n167\t        a.facts.append(args[\"fact\"].strip())\n168\t        save_athlete(a)\n169\t        return \"saved\"\n170\t    if name == \"log_session\":\n171\t        return f\"logged {args.get('minutes')} min\"\n172\t    if name == \"plan_week\":\n173\t        return json.dumps({\"hours\": args[\"hours\"], \"hard_days\": args.get(\"hard_days\", 1), \"sessions\": [\"Mon rest\", \"Tue Z2 45 min\", \"...\"]})\n174\t    if name == \"predict_race\":\n175\t        return json.dumps({\"distance_km\": args[\"distance_km\"], \"estimate_min\": round(args.get(\"recent_minutes\", 50) * 2.1)})\n176\t    return f\"unknown tool {name}\"\n177\t\n178\t# --------------------------------------------------------------------------- the per-message loop\n179\tdef log_usage(usage, user_id, round_no, tool=None):\n180\t    rec = {\"ts\": dt.datetime.now(dt.timezone.utc).isoformat(timespec=\"seconds\"), \"user\": user_id, \"round\": round_no,\n181\t           \"input_tokens\": usage.input_tokens, \"cache_creation_input_tokens\": usage.cache_creation_input_tokens,\n182\t           \"cache_read_input_tokens\": usage.cache_read_input_tokens, \"output_tokens\": usage.output_tokens}\n183\t    if tool:\n184\t        rec[\"tool\"] = tool\n185\t    os.makedirs(os.path.dirname(USAGE_LOG), exist_ok=True)\n186\t    with open(USAGE_LOG, \"a\") as f:\n187\t        f.write(json.dumps(rec) + \"\\n\")\n188\t\n189\t\n190\tdef build_request(a, messages, tools, today):\n191\t    return {\"model\": MODEL, \"max_tokens\": MAX_TOKENS, \"system\": build_system(a, today), \"tools\": tools, \"messages\": messages}\n192\t\n193\t\n194\tdef reply(user_id, text, llm=None):\n195\t    llm = llm or LLM()\n196\t    a = load_athlete(user_id)\n197\t    today = dt.date.today()\n198\t    tools = select_tools(text)\n199\t    messages = [{\"role\": \"user\", \"content\": text}]\n200\t    for round_no in range(1, MAX_TOOL_ROUNDS + 1):\n201\t        resp = llm.create(**build_request(a, messages, tools, today))\n202\t        used_tools = [b.name for b in resp.content if b.type == \"tool_use\"]\n203\t        log_usage(resp.usage, a.user_id, round_no, tool=\",\".join(used_tools) or None)\n204\t        if resp.stop_reason != \"tool_use\":\n205\t            return \"\".join(b.text for b in resp.content if b.type == \"text\")\n206\t        messages.append({\"role\": \"assistant\", \"content\": [b.model_dump() for b in resp.content]})\n207\t        results = [{\"type\": \"tool_result\", \"tool_use_id\": b.id, \"content\": run_tool(a, b.name, b.input)}\n208\t                   for b in resp.content if b.type == \"tool_use\"]\n209\t        messages.append({\"role\": \"user\", \"content\": results})"}]},"parent_tool_use_id":null,"session_id":"6c47f951-d02b-48dc-8a54-874d9fc427b5","uuid":"0cfe4a4a-3935-4d83-8480-8c3018855ecd","timestamp":"2026-10-27T03:41:18.748Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/h-hSg5LK/bot.py","content":"    raw = _load_all().get(str(user_id))\n    if raw is None:\n        return Athlete(user_id=str(user_id), name=\"athlete\")\n    return Athlete(**raw)\n\n\ndef save_athlete(a):\n    allrec = _load_all()\n    allrec[a.user_id] = asdict(a)\n    os.makedirs(os.path.dirname(ATHLETES_FILE), exist_ok=True)\n    with open(ATHLETES_FILE, \"w\") as f:\n        json.dump(allrec, f, indent=1, ensure_ascii=False)\n\n# --------------------------------------------------------------------------- system prompt\nINSTRUCTIONS = \"\"\"You are Pace, an endurance coach for recreational runners and cyclists.\n\nCoaching rules:\n1. Answer the question that was asked before adding anything else.\n2. Keep replies short: a chat message, not an article. Three paragraphs at most.\n3. Prescribe training by heart-rate zone or RPE, never by pace, unless the athlete asks for pace.\n4. Use the athlete's own zones from the profile below; never invent zone boundaries.\n5. Easy days are easy: anything labelled recovery or Z1/Z2 must stay there.\n6. Never add more than 10% weekly volume over the previous week.\n7. One hard session per week for beginners, two for athletes with 3+ years of training.\n8. A rest day is a session. Do not fill it.\n9. If the athlete reports pain (not soreness) lasting more than two days, stop the plan and say to see a physio.\n10. Do not diagnose injuries or illness. Do not give medication advice.\n11. Fuelling: 30-60 g carbs per hour for sessions over 75 minutes; mention it only when relevant.\n12. Sleep and stress count as training load. Ask about them when the athlete looks flat.\n13. Before a goal race, the last hard session is 7-10 days out. Taper means less volume, same intensity.\n14. Do not change the athlete's goal unless they ask. Mention the goal when a question is clearly off-plan.\n15. When the athlete tells you something durable about themselves (injury history, schedule, preferences,\n    equipment, races booked), call save_fact once with a single sentence. Do not save moods or one-off plans.\n16. Do not save a fact that is already in the list below.\n17. Use the plan_week tool for any weekly structure; do not write a week by hand.\n18. Use log_session when the athlete reports a completed workout, then comment on it.\n19. If asked for numbers you do not have (recent volume, last race), ask one question, do not guess.\n20. Metric units unless the profile says otherwise.\n\nTone:\n- Warm, direct, no exclamation marks.\n- No motivational quotes.\n- Address the athlete by first name at most once per reply.\n- Reply in the athlete's language from the profile below, even if they write in another language.\n\nSafety:\n- Never advise training through chest pain, dizziness or fever.\n- Minors: refer to a coach in person.\n- If someone asks for weight-loss plans below 1500 kcal per day, decline and suggest a dietitian.\n\nFormatting:\n- Plain text. No markdown headings, no tables.\n- Lists only for a session structure (warm-up / main / cool-down).\n- Numbers with units: 45 min, 12 km, 150 bpm.\n\"\"\"\n\n\ndef athlete_context(a, today):\n    lines = [\n        f\"Today: {today.isoformat()} ({today.strftime('%A')})\",\n        f\"Athlete: {a.name} (id {a.user_id}), sport: {a.sport}\",\n        \"Zones: \" + \", \".join(f\"{k} {v}\" for k, v in a.zones.items()),\n        f\"Goal: {a.goal}\",\n        \"Long-term facts:\",\n    ]\n    lines += [f\"- {f}\" for f in a.facts] or [\"- (none yet)\"]\n    lines.append(f\"Language: {a.lang}\")\n    return \"\\n\".join(lines)\n\n\ndef build_system(a, today):\n    # One block, cached as a whole: instructions + per-athlete context.\n    text = INSTRUCTIONS + \"\\n\\n\" + athlete_context(a, today)\n    return [{\"type\": \"text\", \"text\": text, \"cache_control\": {\"type\": \"ephemeral\"}}]\n\n# --------------------------------------------------------------------------- tools\nCORE_TOOLS = [\n    {\"name\": \"save_fact\", \"description\": \"Remember one durable fact about the athlete.\",\n     \"input_schema\": {\"type\": \"object\", \"properties\": {\"fact\": {\"type\": \"string\"}}, \"required\": [\"fact\"]}},\n    {\"name\": \"log_session\", \"description\": \"Record a completed workout.\",\n     \"input_schema\": {\"type\": \"object\", \"properties\": {\"minutes\": {\"type\": \"integer\"}, \"rpe\": {\"type\": \"integer\"},\n                                                       \"note\": {\"type\": \"string\"}}, \"required\": [\"minutes\"]}},\n]\nTOOL_GROUPS = {\n    \"plan\": ((\"plan\", \"week\", \"schedule\", \"taper\", \"build\"), [\n        {\"name\": \"plan_week\", \"description\": \"Draft a week of sessions.\",\n         \"input_schema\": {\"type\": \"object\", \"properties\": {\"hours\": {\"type\": \"number\"}, \"hard_days\": {\"type\": \"integer\"}},\n                          \"required\": [\"hours\"]}}]),\n    \"race\": ((\"race\", \"pace\", \"predict\", \"finish time\"), [\n        {\"name\": \"predict_race\", \"description\": \"Estimate a finish time from a recent effort.\",\n         \"input_schema\": {\"type\": \"object\", \"properties\": {\"distance_km\": {\"type\": \"number\"}, \"recent_minutes\": {\"type\": \"number\"}},\n                          \"required\": [\"distance_km\"]}}]),\n}\n\n\ndef select_tools(text):\n    \"\"\"Core tools always; a group is added only when the message mentions its keywords.\"\"\"\n    tools = list(CORE_TOOLS)\n    low = text.lower()\n    for _, (keys, group) in TOOL_GROUPS.items():\n        if any(k in low for k in keys):\n            tools += group\n    return tools\n\n\ndef run_tool(a, name, args):\n    if name == \"save_fact\":\n        a.facts.append(args[\"fact\"].strip())\n        save_athlete(a)\n        return \"saved\"\n    if name == \"log_session\":\n        return f\"logged {args.get('minutes')} min\"\n    if name == \"plan_week\":\n        return json.dumps({\"hours\": args[\"hours\"], \"hard_days\": args.get(\"hard_days\", 1), \"sessions\": [\"Mon rest\", \"Tue Z2 45 min\", \"...\"]})\n    if name == \"predict_race\":\n        return json.dumps({\"distance_km\": args[\"distance_km\"], \"estimate_min\": round(args.get(\"recent_minutes\", 50) * 2.1)})\n    return f\"unknown tool {name}\"\n\n# --------------------------------------------------------------------------- the per-message loop\ndef log_usage(usage, user_id, round_no, tool=None):\n    rec = {\"ts\": dt.datetime.now(dt.timezone.utc).isoformat(timespec=\"seconds\"), \"user\": user_id, \"round\": round_no,\n           \"input_tokens\": usage.input_tokens, \"cache_creation_input_tokens\": usage.cache_creation_input_tokens,\n           \"cache_read_input_tokens\": usage.cache_read_input_tokens, \"output_tokens\": usage.output_tokens}\n    if tool:\n        rec[\"tool\"] = tool\n    os.makedirs(os.path.dirname(USAGE_LOG), exist_ok=True)\n    with open(USAGE_LOG, \"a\") as f:\n        f.write(json.dumps(rec) + \"\\n\")\n\n\ndef build_request(a, messages, tools, today):\n    return {\"model\": MODEL, \"max_tokens\": MAX_TOKENS, \"system\": build_system(a, today), \"tools\": tools, \"messages\": messages}\n\n\ndef reply(user_id, text, llm=None):\n    llm = llm or LLM()\n    a = load_athlete(user_id)\n    today = dt.date.today()\n    tools = select_tools(text)\n    messages = [{\"role\": \"user\", \"content\": text}]\n    for round_no in range(1, MAX_TOOL_ROUNDS + 1):\n        resp = llm.create(**build_request(a, messages, tools, today))\n        used_tools = [b.name for b in resp.content if b.type == \"tool_use\"]\n        log_usage(resp.usage, a.user_id, round_no, tool=\",\".join(used_tools) or None)\n        if resp.stop_reason != \"tool_use\":\n            return \"\".join(b.text for b in resp.content if b.type == \"text\")\n        messages.append({\"role\": \"assistant\", \"content\": [b.model_dump() for b in resp.content]})\n        results = [{\"type\": \"tool_result\", \"tool_use_id\": b.id, \"content\": run_tool(a, b.name, b.input)}\n                   for b in resp.content if b.type == \"tool_use\"]\n        messages.append({\"role\": \"user\", \"content\": results})","numLines":150,"startLine":60,"totalLines":218}},"tool_result_meta":[{"id":"toolu_01CECc8P4q49brdMyJ5uyKVV","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
