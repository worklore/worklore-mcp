thorize\"\n./server.py:22:# user_id -> {athlete_id, athlete_name, access_token, refresh_token, scope, expires_at, status}\n./server.py:28:    print(time.strftime(\"%Y-%m-%d %H:%M:%S\"), \"[intervals]\", msg, flush=True)\n./server.py:50:# --- Intervals.icu calls ----------------------------------------------------\n./server.py:67:    refresh = tok.get(\"refresh_token\")\n./server.py:69:        log(f\"{user_id}: no refresh_token in response, scheduling expiry in {expires_in}s\")\n./server.py:74:            \"access_token\": tok[\"access_token\"], \"refresh_token\": refresh,\n./server.py:80:def refresh_tokens():\n./server.py:89:                if not c[\"refresh_token\"]:\n./server.py:95:                        \"grant_type\": \"refresh_token\", \"refresh_token\": c[\"refresh_token\"],\n./server.py:99:                             refresh_token=tok.get(\"refresh_token\", c[\"refresh_token\"]),\n./server.py:107:def intervals_get(conn, path):\n./server.py:167:        if url.path == \"/api/intervals/auth/init\":\n./server.py:169:        if url.path == \"/api/intervals/callback\":\n./server.py:171:        if url.path == \"/api/intervals/status\":\n./server.py:173:        if url.path == \"/api/intervals/wellness\":\n./server.py:179:        if url.path == \"/api/intervals/disconnect\":\n./server.py:188:    # Step 1: build the authorize URL and send the browser to Intervals.\n./server.py:197:    # Step 2: Intervals redirects back here with ?code=&state=.\n./server.py:231:            return self.send_json(409, {\"error\": \"intervals not connected\"})\n./server.py:233:            code, data = intervals_get(c, \"/wellness\")\n./server.py:236:            self.send_json(e.code, {\"error\": f\"intervals returned {e.code}\"})\n./server.py:242:    threading.Thread(target=refresh_tokens, daemon=True).start()\n./server.py:243:    log(f\"serving on http://localhost:{config.PORT} (intervals: {config.INTERVALS_BASE})\")\n","exit_code":0,"status":"completed"}}
