 log = logging.getLogger("stories")
 
@@ -22,12 +23,17 @@ def words(text):
 
 
 def similarity(a, b):
-    """Shared-tag ratio (Jaccard), blended with shared words of the two bodies."""
+    """Shared-tag ratio (Jaccard), blended with shared words of the two bodies.
+
+    DynamoDB rejects floats, so the score is a Decimal.
+    """
     ta, tb = set(a.get("tags", [])), set(b.get("tags", []))
-    tag_score = len(ta & tb) / len(ta | tb) if (ta | tb) else 0
+    tag_union = ta | tb
+    tag_score = Decimal(len(ta & tb)) / len(tag_union) if tag_union else Decimal(0)
     wa, wb = words(a.get("body")), words(b.get("body"))
-    word_score = len(wa & wb) / len(wa | wb) if (wa | wb) else 0
-    return round(0.7 * tag_score + 0.3 * word_score, 4)
+    word_union = wa | wb
+    word_score = Decimal(len(wa & wb)) / len(word_union) if word_union else Decimal(0)
+    return round(Decimal("0.7") * tag_score + Decimal("0.3") * word_score, 4)
 
 
