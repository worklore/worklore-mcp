rc\nfi\n\n# Exit 0 is not proof of work: empty output counts as failure.\nif [[ ! -s \"$OUT\" ]]; then\n  notify \"nightly review FAILED: claude exited 0 after ${dur}s but produced no output. $(head -c 300 \"$ERR\")\"\n  DONE=1\n  exit 1\nfi\n\nsummary=$(<\"$OUT\")\nnotify \"nightly review done (${dur}s): ${summary[1,300]}\"\nDONE=1\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":874,"cache_read_input_tokens":24904,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":874},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"affa2b80-125a-48bc-bdf4-17b9ed03bbc2","uuid":"580b681e-e380-4296-9e0b-c6ff5e29bc17","timestamp":"2026-10-27T05:24:12.181Z","request_id":"req_011CgSBd3vjAKaaFJDneoVYv","wire_tool_inputs":{"toolu_01PAErLv61KxKtALG5vQhQnD":{"file_path":"/private/tmp/h-OjTV0i/bin/nightly-review.zsh","content":"#!/bin/zsh\n# Nightly review of yesterday's commits, summary to Telegram.\nset -u\n\nREPO=\"$HOME/projects/shop\"\nOUT=\"$HOME/Library/Logs/nightly-review-$(date +%F).md\"\nERR=\"$HOME/Library/Logs/nightly-review-$(date +%F).err\"\nNOTIFY=\"$HOME/bin/notify.sh\"\n\n# Every notification attempt is logged; a failing notifier must not be silent.\nnotify() {\n  \"$NOTIFY\" \"$1\" || print -u2 -- \"$(date '+%F %T') notify.sh failed (rc=$?) for: $1\"\n}\n\n# Last-resort reporter: fires on any exit that did not go through the success path.\nDONE=0\nSTART=$SECONDS\ntrap 'rc=$?; (( DONE )) || notify \"nightly review FAILED unexpectedly (exit $rc) after $((SECONDS-START))s, see ~/Library/Logs/nightly-review.err\"' EXIT\n\nprint -u2 -- \"$(date '+%F %T') start (USER=${USER:-unset} HOME=$HOME)\"\n\nSINCE=$(date -v-1d +%F)\nPROMPT=\"Review the commits in this repository since $SINCE.\nFor 