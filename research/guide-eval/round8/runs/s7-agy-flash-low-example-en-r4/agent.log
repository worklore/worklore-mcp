c1f0a\"          # signs the OAuth state parameter\r\n+\r\n+# Intervals.icu OAuth client (placeholders; the real pair is in the deploy env)\r\n+INTERVALS_BASE = os.environ.get(\"INTERVALS_BASE\", \"https://intervals.icu\")\r\n+CLIENT_ID = \"tricoach-dev\"\r\n+CLIENT_SECRET = \"s3cr3t-placeholder-0000\"\r\n+REDIRECT_URI = f\"http://localhost:{PORT}/api/intervals/callback\"\r\n+SCOPES = \"ACTIVITY:READ,ACTIVITY:WRITE,WELLNESS:READ,CALENDAR:READ,CALENDAR:WRITE\"\r\n+\r\n+REFRESH_INTERVAL = 60      # seconds between passes of the token refresher\r\ndiff --git a/logs/connect-attempt.log b/logs/connect-attempt.log\r\nnew file mode 100644\r\nindex 0000000..0d4c94b\r\n--- /dev/null\r\n+++ b/logs/connect-attempt.log\r\n@@ -0,0 +1,41 @@\r\n+### 1. An athlete clicks \"Connect Intervals.icu\" (server log, 2026-10-14)\r\n+\r\n+2026-10-14 18:02:11 [http] \"GET /api/me HTTP/1.1\" 200 -\r\n+2026-10-14 18:02:11 [http] \"GET /api/intervals/status HTTP/1.1\" 200 -\r\n+2026-10-14 18:02:19 [http] GET /api/intervals/auth/init 401 (no Authorization header)\r\n+2026-10-14 18:02:19 [http] \"GET /api/intervals/auth/init HTTP/1.1\" 401 -\r\n+\r\n+    Browser dev tools, same request (document navigation):\r\n+    Request URL:     http://localhost:8766/api/intervals/auth/init\r\n+    Request Method:  GET\r\n+    Status Code:     401 Unauthorized\r\n+    Request headers: Accept: text/html,application/xhtml+xml,... / Referer: http://localhost:8766/\r\n+    Response body:   {\"error\": \"unauthorized\"}\r\n+\r\n+### 2. Building the authorize link by hand and opening it (2026-10-17)\r\n+\r\n+$ curl -s -o /dev/null -w '%{redirect_url}\\n' -H 'Authorization: Bearer tok-okafor' \\\r\n+    http://localhost:8766/api/intervals/auth/init\r\n+https://intervals.icu/oauth/authorize?client_id=tricoach-dev\u0026redirect_uri=http:%2F%2Flocalhost:8766%2Fapi%2Fintervals%2Fcallback\u0026scope=ACTIVITY:READ,ACTIVITY:WRITE,WELLNESS:READ,CALENDAR:READ,CALENDAR:WRITE\u0026state=dV9va2Fmb3I6MTc5MjY4MTAwMDpiNjM1ZjBiZjU1M2ZjZWQ0YmM4ODNjMTExZmI4MDJhMw==\r\n+\r\n+$ curl -s -i \"\u003cthat url\u003e\"\r\n+HTTP/2 400\r\n+content-type: application/json\r\n+cache-control: no-store\r\n+\r\n+{\"error\":\"invalid_request\"}\r\n+\r\n+    Same 400 in a browser (as the signed-in athlete on intervals.icu), no\r\n+    consent screen. Removing the state param or changing the redirect_uri\r\n+    gives the same body, so the body does not say which parameter it minds.\r\n+\r\n+### 3. The one connection that worked: T. Rivera, onboarding call (2026-09-19)\r\n+\r\n+2026-09-19 17:41:03 [http] \"GET /api/intervals/callback?code=a7Jk2...\u0026state=dV9yaXZlcmE6... HTTP/1.1\" 302 -\r\n+2026-09-19 17:41:04 [intervals] token response from https://intervals.icu/api/oauth/token:\r\n+{\"token_type\":\"bearer\",\"access_token\":\"9f3c1e0b4d7a...redacted...\",\"scope\":\"ACTIVITY:WRITE,WELLNESS:READ\",\"athlete\":{\"id\":\"i98765\",\"name\":\"T. Rivera\"}}\r\n+2026-09-19 17:41:04 [intervals] u_rivera: no refresh_token in response, scheduling expiry in 3600s\r\n+2026-09-19 17:41:04 [intervals] u_rivera: connected as athlete i98765 (expires in 3600s)\r\n+2026-09-19 17:44:30 [http] \"GET /api/intervals/wellness HTTP/1.1\" 200 -\r\n+2026-09-19 18:37:12 [intervals] u_rivera: token expiry passed and no refresh token on file -\u003e expired, reconnect\r\n+2026-09-20 07:12:48 [http] \"GET /api/intervals/status HTTP/1.1\" 200 -\r\ndiff --git a/logs/support-tickets.md b/logs/support-tickets.md\r\nnew file mode 100644\r\nindex 0000000..607b69e\r\n--- /dev/null\r\n+++ b/logs/support-tickets.md\r\n@@ -0,0 +1,30 @@\r\n+# Support tickets — Intervals.icu connection\r\n+\r\n+## #214 — \"Connect Intervals.icu shows Unauthorized\" (C. Okafor, 2026-10-14)\r\n+\r\n+\u003e I'm signed in, the page says \"Signed in as C. Okafor\", I click Connect\r\n+\u003e Intervals.icu and get a white page th\n\u003ctruncated 10063 of 19941 bytes from the middle of the output\u003e\nack(self, q):\r\n+        user_id = verify_state(q.get(\"state\", \"\"))\r\n+        if not user_id or not q.get(\"code\"):\r\n+            return self.send_json(400, {\"error\": \"bad state or code\"})\r\n+        try:\r\n+            tok = exchange_code(q[\"code\"])\r\n+            store_connection(user_id, tok)\r\n+        except urllib.error.HTTPError as e:\r\n+            log(f\"{user_id}: token exchange failed: HTTP {e.code} {e.read()[:200]!r}\")\r\n+            return self.send_json(502, {\"error\": \"token exchange failed\"})\r\n+        except Exception as e:\r\n+            log(f\"{user_id}: token exchange failed: {e}\")\r\n+            return self.send_json(502, {\"error\": \"token exchange failed\"})\r\n+        self.redirect(\"/?connected=1\")\r\n+\r\n+    def status(self):\r\n+        user = self.require_user()\r\n+        if not user:\r\n+            return\r\n+        with LOCK:\r\n+            c = CONNECTIONS.get(user[\"id\"])\r\n+        if not c or c[\"status\"] != \"connected\":\r\n+            return self.send_json(200, {\"connected\": False, \"status\": c[\"status\"] if c else \"disconnected\"})\r\n+        self.send_json(200, {\"connected\": True, \"status\": \"connected\", \"scope\": c[\"scope\"],\r\n+                             \"athlete\": {\"id\": c[\"athlete_id\"], \"name\": c[\"athlete_name\"]}})\r\n+\r\n+    def wellness(self):\r\n+        user = self.require_user()\r\n+        if not user:\r\n+            return\r\n+        with LOCK:\r\n+            c = CONNECTIONS.get(user[\"id\"])\r\n+        if not c or c[\"status\"] != \"connected\":\r\n+            return self.send_json(409, {\"error\": \"intervals not connected\"})\r\n+        try:\r\n+            code, data = intervals_get(c, \"/wellness\")\r\n+            self.send_json(code, data)\r\n+        except urllib.error.HTTPError as e:\r\n+            self.send_json(e.code, {\"error\": f\"intervals returned {e.code}\"})\r\n+        except Exception as e:\r\n+            self.send_json(502, {\"error\": str(e)})\r\n+\r\n+\r\n+if __name__ == \"__main__\":\r\n+    threading.Thread(target=refresh_tokens, daemon=True).start()\r\n+    log(f\"serving on http://localhost:{config.PORT} (intervals: {config.INTERVALS_BASE})\")\r\n+    ThreadingHTTPServer((\"127.0.0.1\", config.PORT), Handler).serve_forever()\r\ndiff --git a/static/app.js b/static/app.js\r\nnew file mode 100644\r\nindex 0000000..368922e\r\n--- /dev/null\r\n+++ b/static/app.js\r\n@@ -0,0 +1,39 @@\r\n+// tricoach SPA. The sign-in token lives in localStorage and travels on every\r\n+// API call via the fetch wrapper below.\r\n+const TOKEN = localStorage.getItem(\"tc_token\") || \"tok-okafor\";\r\n+const root = document.getElementById(\"app\");\r\n+\r\n+async function api(path, opts = {}) {\r\n+  const headers = Object.assign({ \"Authorization\": \"Bearer \" + TOKEN }, opts.headers || {});\r\n+  const res = await fetch(path, Object.assign({}, opts, { headers }));\r\n+  const body = await res.json().catch(() =\u003e ({}));\r\n+  if (!res.ok) throw new Error(body.error || (\"HTTP \" + res.status));\r\n+  return body;\r\n+}\r\n+\r\n+function esc(s) { return String(s).replace(/[\u0026\u003c\u003e\"]/g, c =\u003e ({ \"\u0026\": \"\u0026amp;\", \"\u003c\": \"\u0026lt;\", \"\u003e\": \"\u0026gt;\", '\"': \"\u0026quot;\" }[c])); }\r\n+\r\n+async function render() {\r\n+  try {\r\n+    const me = await api(\"/api/me\");\r\n+    const st = await api(\"/api/intervals/status\");\r\n+    let card;\r\n+    if (st.connected) {\r\n+      card = `\u003cdiv class=\"card\"\u003eConnected to Intervals.icu as \u003cb\u003e${esc(st.athlete.name)}\u003c/b\u003e\r\n+        (${esc(st.athlete.id)}), scope \u003ccode\u003e${esc(st.scope)}\u003c/code\u003e.\r\n+        \u003cp\u003e\u003cbutton class=\"btn\" id=\"disconnect\"\u003eDisconnect\u003c/button\u003e\u003c/p\u003e\u003c/div\u003e`;\r\n+    } else {\r\n+      const why = st.status \u0026\u0026 st.status !== \"disconnected\" ? `\u003cp class=\"muted\"\u003eStatus: ${esc(st.status)}\u003c/p\u003e` : \"\";\r\n+      card = `\u003cdiv class=\"card\"\u003eIntervals.icu is not connected.${why}\r\n+        \u003cp\u003e\u003ca class=\"btn\" href=\"/api/intervals/auth/init\"\u003eConnect Intervals.icu\u003c/a\u003e\u003c/p\u003e\u003c/div\u003e`;\r\n+    }\r\n+    root.className = \"\";\r\n+    root.innerHTML = `\u003cp\u003eSigned in as \u003cb\u003e${esc(me.name)}\u003c/b\u003e.\u003c/p\u003e${card}`;\r\n+    const d = document.getElementById(\"disconnect\");\r\n+    if (d) d.onclick = async () =\u003e { await api(\"/api/intervals/disconnect\", { method: \"POST\" }); render(); };\r\n+  } catch (e) {\r\n+    root.innerHTML = `\u003cp class=\"card\"\u003eError: ${esc(e.message)}\u003c/p\u003e`;\r\n+  }\r\n+}\r\n+\r\n+render();\r\ndiff --git a/static/index.html b/static/index.html\r\nnew file mode 100644\r\nindex 0000000..0da6d99\r\n--- /dev/null\r\n+++ b/static/index.html\r\n@@ -0,0 +1,18 @@\r\n+\u003c!doctype html\u003e\r\n+\u003chtml lang=\"en\"\u003e\r\n+\u003chead\u003e\r\n+\u003cmeta charset=\"utf-8\"\u003e\r\n+\u003ctitle\u003etricoach\u003c/title\u003e\r\n+\u003cstyle\u003e\r\n+  body { font: 15px/1.5 system-ui, sans-serif; margin: 2rem auto; max-width: 42rem; padding: 0 1rem; }\r\n+  .btn { display: inline-block; padding: .5rem 1rem; border-radius: 6px; background: #1d4ed8; color: #fff; text-decoration: none; border: 0; cursor: pointer; }\r\n+  .card { border: 1px solid #ddd; border-radius: 8px; padding: 1rem; margin: 1rem 0; }\r\n+  .muted { color: #666; }\r\n+\u003c/style\u003e\r\n+\u003c/head\u003e\r\n+\u003cbody\u003e\r\n+\u003ch1\u003etricoach\u003c/h1\u003e\r\n+\u003cdiv id=\"app\" class=\"muted\"\u003eLoading…\u003c/div\u003e\r\n+\u003cscript src=\"/static/app.js\"\u003e\u003c/script\u003e\r\n+\u003c/body\u003e\r\n+\u003c/html\u003e\r\n"}}}
