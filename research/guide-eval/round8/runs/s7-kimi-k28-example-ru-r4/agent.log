"); return self._json(200, {\\\"ok\\\": True})\\n        self._json(404, {\\\"error\\\": \\\"not found\\\"})\\n    def do_GET(self):\\n        if self.path == \\\"/mock/seen\\\":\\n            return self._json(200, {\\\"exchanges\\\": SEEN})\\n        if self.path.startswith(\\\"/api/v1/athlete/\\\") and self.path.endswith(\\\"/wellness\\\"):\\n            auth = self.headers.get(\\\"Authorization\\\", \\\"\\\")\\n            token = auth[7:] if auth.startswith(\\\"Bearer \\\") else \\\"\\\"\\n            if token == \\\"mock-token-1\\\" and token not in BLACKLIST:\\n                return self._json(200, {\\\"wellness\\\": [{\\\"day\\\": \\\"2026-11-07\\\", \\\"rest_hr\\\": 52}]})\\n            return self._json(401, {\\\"error\\\": \\\"invalid token\\\"})\\n        self._json(404, {\\\"error\\\": \\\"not found\\\"})\\n\\nprint(\\\"mock intervals on 8768\\\", flush=True)\\nThreadingHTTPServer((\\\"127.0.0.1\\\", 8768), H).serve_forever()\\nEOF\",\"description\":\"мок Intervals.icu на 8768\",\"run_in_background\":true}"}}]}
