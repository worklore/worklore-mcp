wellness proxy.\nserver.py:13:TOKEN_URL = config.INTERVALS_BASE + \"/api/oauth/token\"\nserver.py:14:AUTHORIZE_URL = config.INTERVALS_BASE + \"/oauth/authorize\"\nserver.py:22:# user_id -> {athlete_id, athlete_name, access_token, refresh_token, scope, expires_at, status}\nserver.py:67:    refresh = tok.get(\"refresh_token\")\nserver.py:68:    if not refresh:\nserver.py:69:        log(f\"{user_id}: no refresh_token in response, scheduling expiry in {expires_in}s\")\nserver.py:74:            \"access_token\": tok[\"access_token\"], \"refresh_token\": refresh,\nserver.py:75:            \"scope\": tok.get(\"scope\"), \"expires_at\": time.time() + expires_in, \"status\": \"connected\",\nserver.py:80:def refresh_tokens():\nserver.py:83:        time.sleep(config.REFRESH_INTERVAL)\nserver.py:89:                if not c[\"refresh_token\"]:\nserver.py:90:                    log(f\"{uid}: token expiry passed and no refresh token on file -> expired, reconnect\")\nserver.py:95:                        \"grant_type\": \"refresh_token\", \"refresh_token\": c[\"refresh_token\"],\nserver.py:99:                             refresh_token=tok.get(\"refresh_token\", c[\"refresh_token\"]),\nserver.py:101:                    log(f\"{uid}: token refreshed\")\nserver.py:103:                    log(f\"{uid}: refresh failed ({e}) -> expired, reconnect\")\nserver.py:194:                  \"scope\": config.SCOPES, \"state\": sign_state(user[\"id\"])}\nserver.py:221:        self.send_json(200, {\"connected\": True, \"status\": \"connected\", \"scope\": c[\"scope\"],\nserver.py:242:    threading.Thread(target=refresh_tokens, daemon=True).start()"}
