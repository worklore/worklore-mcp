{"role":"assistant","content":"Проверяю также сам обработчик кнопки в DOM-имитации: он должен сделать авторизованный запрос к нашему серверу и только затем открыть возвращённый URL, а не вести браузер напрямую на API.","tool_calls":[{"type":"function","id":"tool_vDIu97etSKstQ4SqrpbpL8CF","function":{"name":"Bash","arguments":"{\"command\":\"python3 - <<'PY'\\nimport json\\nimport subprocess\\nimport threading\\nimport time\\nimport urllib.error\\nimport urllib.parse\\nimport urllib.request\\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\\n\\nimport server\\n\\nprovider_requests = []\\n\\nclass Provider(BaseHTTPRequestHandler):\\n    def log_message(self, *args):\\n        pass\\n\\n    def reply(self, obj):\\n        body = json.dumps(obj).encode()\\n        self.send_response(200)\\n        self.send_header(\\\"Content-Type\\\", \\\"application/json\\\")\\n        self.send_header(\\\"Content-Length\\\", str(len(body)))\\n        self.end_headers()\\n        self.wfile.write(body)\\n\\n    def do_POST(self):\\n        fields = dict(urllib.parse.parse_qsl(self.rfile.read(int(self.headers[\\\"Content-Length\\\"])).decode()))\\n        provider_requests.append((\\\"POST\\\", self.path, fields, self.headers.get(\\\"Authorization\\\")))\\n        assert self.path == \\\"/api/oauth/token\\\"\\n        if fields[\\\"grant_type\\\"] == \\\"authorization_code\\\":\\n            assert fields[\\\"code\\\"] == \\\"local-code\\\"\\n            self.reply({\\n                \\\"access_token\\\": \\\"access-1\\\", \\\"refresh_token\\\": \\\"refresh-1\\\", \\\"expires_in\\\": 1,\\n                \\\"scope\\\": server.config.SCOPES,\\n                \\\"athlete\\\": {\\\"id\\\": \\\"i123\\\", \\\"name\\\": \\\"Local Athlete\\\"},\\n            })\\n        else:\\n            assert fields == {\\n                \\\"grant_type\\\": \\\"refresh_token\\\", \\\"refresh_token\\\": \\\"refresh-1\\\",\\n                \\\"client_id\\\": server.config.CLIENT_ID, \\\"client_secret\\\": server.config.CLIENT_SECRET,\\n            }\\n            self.reply({\\\"access_token\\\": \\\"access-2\\\"})\\n\\n    def do_GET(self):\\n        provider_requests.append((\\\"GET\\\", self.path, {}, self.headers.get(\\\"Authorization\\\")))\\n        assert self.path == \\\"/api/v1/athlete/i123/wellness\\\"\\n        assert self.headers.get(\\\"Authorization\\\") == \\\"Bearer access-2\\\"\\n        self.reply({\\\"ok\\\": True, \\\"source\\\": \\\"local-provider\\\"})\\n\\nprovider = ThreadingHTTPServer((\\\"127.0.0.1\\\", 0), Provider)\\napp = ThreadingHTTPServer((\\\"127.0.0.1\\\", 0), server.Handler)\\nprovider_port = provider.server_address[1]\\napp_port = app.server_address[1]\\nserver.TOKEN_URL = f\\\"http://127.0.0.1:{provider_port}/api/oauth/token\\\"\\nserver.AUTHORIZE_URL = f\\\"http://127.0.0.1:{provider_port}/oauth/authorize\\\"\\nserver.config.REDIRECT_URI = f\\\"http://127.0.0.1:{app_port}/api/intervals/callback\\\"\\nserver.config.REFRESH_INTERVAL = 0.02\\nthreading.Thread(target=provider.serve_forever, daemon=True).start()\\nthreading.Thread(target=app.serve_forever, daemon=True).start()\\nthreading.Thread(target=server.refresh_tokens, daemon=True).start()\\nbase = f\\\"http://127.0.0.1:{app_port}\\\"\\n\\ndef call(path, token=None):\\n    headers = {\\\"Authorization\\\": \\\"Bearer \\\" + token} if token else {}\\n    req = urllib.request.Request(base + path, headers=headers)\\n    try:\\n        with urllib.request.urlopen(req, timeout=3) as response:\\n            return response.status, response.read(), response.headers\\n    except urllib.error.HTTPError as error:\\n        return error.code, error.read(), error.headers\\n\\ntry:\\n    code, body, _ = call(\\\"/api/intervals/auth/init\\\")\\n    assert code == 401\\n\\n    code, body, _ = call(\\\"/api/intervals/auth/init\\\", \\\"tok-okafor\\\")\\n    assert code == 200\\n    auth_url = json.loads(body)[\\\"url\\\"]\\n    query = {key: values[0] for key, values in urllib.parse.parse_qs(urllib.parse.urlsplit(auth_url).query).items()}\\n    assert query[\\\"access_type\\\"] == \\\"offline\\\"\\n    assert query[\\\"scope\\\"] == \\\"ACTIVITY:READ,ACTIVITY:WRITE,WELLNESS:READ\\\"\\n    assert \\\"CALENDAR\\\" not in query[\\\"scope\\\"]\\n    assert server.verify_state(query[\\\"state\\\"]) == \\\"u_okafor\\\"\\n\\n    ui_script = r'''\\nconst fs = require(\\\"fs\\\");\\nconst app = { className: \\\"muted\\\", innerHTML: \\\"\\\" };\\nconst connect = { disabled: false, onclick: null };\\nconst error = { textContent: \\\"\\\" };\\nconst elements = { app, connect, \\\"connect-error\\\": error, disconnect: { onclick: null } };\\nglobal.document = { getElementById: id => elements[id] || null };\\nglobal.localStorage = { getItem: () => \\\"tok-okafor\\\" };\\nlet assigned = \\\"\\\";\\nglobal.window = { location: { assign: url => { assigned = url; } } };\\nconst nativeFetch = global.fetch;\\nglobal.fetch = (path, opts) => nativeFetch(\\\"http://127.0.0.1:\\\" + process.argv[1] + path, opts);\\neval(fs.readFileSync(\\\"static/app.js\\\", \\\"utf8\\\"));\\n(async () => {\\n  for (let i = 0; i < 100 && !connect.onclick; i++) await new Promise(resolve => setTimeout(resolve, 10));\\n  if (!connect.onclick) throw new Error(\\\"Connect handler was not installed\\\");\\n  await connect.onclick();\\n  const url = new URL(assigned);\\n  if (url.pathname !== \\\"/oauth/authorize\\\") throw new Error(\\\"Wrong authorize URL: \\\" + assigned);\\n  if (url.searchParams.get(\\\"access_type\\\") !== \\\"offline\\\") throw new Error(\\\"Offline access missing\\\");\\n  if (connect.disabled !== true || error.textContent !== \\\"\\\") throw new Error(\\\"Unexpected button state\\\");\\n  console.log(\\\"Connect button -> authorized init -> authorize redirect: OK\\\");\\n})().catch(error => { console.error(error); process.exit(1); });\\n'''\\n    subprocess.run([\\\"node\\\", \\\"-e\\\", ui_script, str(app_port)], check=True)\\n\\n    callback = \\\"/api/intervals/callback?\\\" + urllib.parse.urlencode({\\\"code\\\": \\\"local-code\\\", \\\"state\\\": query[\\\"state\\\"]})\\n    code, body, _ = call(callback)\\n    assert code == 200  # followed the local post-callback redirect\\n    with server.LOCK:\\n        connection = server.CONNECTIONS[\\\"u_okafor\\\"]\\n        assert connection[\\\"refresh_token\\\"] == \\\"refresh-1\\\"\\n        assert connection[\\\"status\\\"] == \\\"connected\\\"\\n\\n    deadline = time.time() + 3\\n    while time.time() < deadline:\\n        with server.LOCK:\\n            connection = server.CONNECTIONS[\\\"u_okafor\\\"]\\n            if connection[\\\"access_token\\\"] == \\\"access-2\\\":\\n                break\\n        time.sleep(0.02)\\n    with server.LOCK:\\n        connection = server.CONNECTIONS[\\\"u_okafor\\\"]\\n        assert connection[\\\"access_token\\\"] == \\\"access-2\\\"\\n        assert connection[\\\"refresh_token\\\"] == \\\"refresh-1\\\"\\n        assert connection[\\\"status\\\"] == \\\"connected\\\"\\n        assert connection[\\\"expires_at\\\"] > time.time() + 3500\\n\\n    code, body, _ = call(\\\"/api/intervals/status\\\", \\\"tok-okafor\\\")\\n    assert code == 200 and json.loads(body)[\\\"connected\\\"] is True\\n    code, body, _ = call(\\\"/api/intervals/wellness\\\", \\\"tok-okafor\\\")\\n    assert code == 200 and json.loads(body) == {\\\"ok\\\": True, \\\"source\\\": \\\"local-provider\\\"}\\n    assert any(item[0] == \\\"POST\\\" and item[2].get(\\\"grant_type\\\") == \\\"refresh_token\\\" for item in provider_requests)\\n    print(\\\"OAuth callback, refresh without expires_in, status and wellness: OK\\\")\\nfinally:\\n    app.shutdown()\\n    provider.shutdown()\\n    app.server_close()\\n    provider.server_close()\\nPY\",\"cwd\":\"/private/tmp/h-fnWNuq\",\"timeout\":30}"}}]}
