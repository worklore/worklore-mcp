{"role":"tool","tool_call_id":"tool_QJWTe5UBA3GQZWb0HTyebfQ1","content":"1\tname: kredito\n2\tdescription: Consumer loan registration and offers.\n3\tpublish_to: \"none\"\n4\tversion: 1.3.0+27\n5\t\n6\tenvironment:\n7\t  sdk: ^3.5.0\n8\t\n9\tdependencies:\n10\t  flutter:\n11\t    sdk: flutter\n12\t  posthog_flutter: ^5.36.0\n13\t\n14\tdev_dependencies:\n15\t  flutter_test:\n16\t    sdk: flutter\n17\t  flutter_lints: ^5.0.0\n18\t\n19\tflutter:\n20\t  uses-material-design: true"}
