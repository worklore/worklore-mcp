_compatible_similarity(self):\n+        table = FakeTable()\n+        first = {\n+            \"slug\": \"first-story\",\n+            \"title\": \"First story\",\n+            \"tags\": [\"python\", \"aws\"],\n+            \"body\": \"Publishing stories with DynamoDB\",\n+        }\n+        second = {\n+            \"slug\": \"second-story\",\n+            \"title\": \"Second story\",\n+            \"tags\": [\"python\", \"testing\"],\n+            \"body\": \"Testing stories with DynamoDB\",\n+        }\n+\n+        self.assertEqual(app.handler({\"body\": json.dumps(first)}, table)[\"statusCode\"], 201)\n+        self.assertEqual(app.handler({\"body\": json.dumps(second)}, table)[\"statusCode\"], 201)\n+\n+        stored = table.get_item(Key={\"slug\": \"second-story\"})[\"Item\"]\n+        self.assertEqual(\n+            stored[\"similar\"], [{\"slug\": \"first-story\", \"score\": Decimal(\"0.4133\")}]\n+        )\n+        self.assertEqual(table.scan()[\"Count\"], 2)\n+\n \n if __name__ == \"__main__\":\n     unittest.main()\n M src/app.py\n M tests/test_publish.py\n?? ANSWER.md\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_15","type":"agent_message","text":"Причина 500 — при второй публикации в `similar` появляется оценка типа `float`, которую DynamoDB не принимает. Перевёл расчёт оценки на `Decimal` и добавил тест двух последовательных публикаций. Оба теста прошли.\n\nПричина, исправление и применённые части заметки записаны в [ANSWER.md](/tmp/h-oysbOI/ANSWER.md)."}}
