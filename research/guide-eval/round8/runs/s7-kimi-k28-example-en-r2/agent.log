f do_GET(self):\\n        url = urllib.parse.urlsplit(self.path)\\n        q = dict(urllib.parse.parse_qsl(url.query))\\n        if url.path == \\\"/oauth/authorize\\\":\\n            areas = [s.split(\\\":\\\")[0] for s in q.get(\\\"scope\\\", \\\"\\\").split(\\\",\\\") if s]\\n            if len(areas) != len(set(areas)):\\n                return self.j(400, {\\\"error\\\": \\\"invalid_request\\\"})  # a.k.a. \\\"Duplicate scope\\\"\\n            loc = f\\\"{q['redirect_uri']}?code=mock-code-1&state={urllib.parse.quote(q['state'])}\\\"\\n            self.send_response(302)\\n            self.send_header(\\\"Location\\\", loc)\\n            self.end_headers()\\n            return\\n        if url.path.startswith(\\\"/api/v1/athlete/\\\"):\\n            auth = self.headers.get(\\\"Authorization\\\", \\\"\\\")\\n            tok = auth.removeprefix(\\\"Bearer \\\").strip()\\n            if tok in REVOKED or not tok:\\n                return self.j(401, {\\\"error\\\": \\\"invalid_token\\\"})\\n            return self.j(200, [{\\\"id\\\": \\\"w1\\\", \\\"athlete\\\": \\\"i98765\\\", \\\"sleep\\\": 7.5}])\\n        self.j(404, {\\\"error\\\": \\\"not found\\\"})\\n\\n    def do_POST(self):\\n        url = urllib.parse.urlsplit(self.path)\\n        if url.path == \\\"/api/oauth/token\\\":\\n            fields = dict(urllib.parse.parse_qsl(self.rfile.read(int(self.headers[\\\"Content-Length\\\"])).decode()))\\n            TOKEN_FIELDS.append(sorted(fields))\\n            if not fields.get(\\\"code\\\"):\\n                return self.j(400, {\\\"error\\\": \\\"invalid_request\\\"})\\n            return self.j(200, {\\\"token_type\\\": \\\"bearer\\\", \\\"access_token\\\": \\\"mock-at-1\\\",\\n                                \\\"scope\\\": fields.get(\\\"scope_hint\\\", \\\"ACTIVITY:WRITE,WELLNESS:READ\\\"),\\n                                \\\"athlete\\\": {\\\"id\\\": \\\"i98765\\\", \\\"name\\\": \\\"T. Rivera\\\"}})\\n        self.j(404, {\\\"error\\\": \\\"not found\\\"})\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    ThreadingHTTPServer((\\\"127.0.0.1\\\", 9876), H).serve_forever()\\n\"}"}}]}
