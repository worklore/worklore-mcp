n(set(areas)), q[\\\"scope\\\"])\\n\\n# 2. Authorize (browser navigation, no auth header) -> 302 to callback.\\nst, hdrs, _ = req(urllib.parse.urlsplit(auth_url).path + \\\"?\\\" + urllib.parse.urlsplit(auth_url).query)\\ncheck(\\\"mock authorize accepts scope (302)\\\", st == 302, str(st))\\ncb = urllib.parse.urlsplit(hdrs[\\\"Location\\\"])\\ncheck(\\\"authorize redirects to our callback\\\", cb.path == \\\"/api/intervals/callback\\\")\\n\\n# 3. Callback: no auth header; state carries identity; code exchanged.\\nst, _, body = req(cb.path + \\\"?\\\" + cb.query)\\ncheck(\\\"callback completes (302 to app)\\\", st == 302 and urllib.parse.urlsplit(dict(_)[\\\"Location\\\"] if False else hdrs.get(\\\"Location\\\", \\\"\\\")).path != \\\"/api/intervals/callback\\\", str(st))\\n\\n# 4. Status shows connected.\\nst, _, body = req(\\\"/api/intervals/status\\\", token=TOK)\\nd = json.loads(body)\\ncheck(\\\"status connected\\\", st == 200 and d.get(\\\"connected\\\") is True and d[\\\"athlete\\\"][\\\"id\\\"] == \\\"i98765\\\", body)\\n\\n# 5. Wellness proxy works.\\nst, _, body = req(\\\"/api/intervals/wellness\\\", token=TOK)\\ncheck(\\\"wellness 200 with data\\\", st == 200 and json.loads(body)[0][\\\"sleep\\\"] == 7.5, str(st))\\n\\n# 6. No expiry machinery: token response had no expires_in/refresh_token, so\\n#    a \\\"next morning\\\" poll must still be connected. (No sleep needed: the old\\n#    code scheduled expiry at store time; absence of expires_at proves the fix.)\\nst, _, body = req(\\\"/api/intervals/status\\\", token=TOK)\\ncheck(\\\"still connected (no fake 1h expiry)\\\", json.loads(body).get(\\\"connected\\\") is True, body)\\n\\n# 7. Lazy revocation: revoke at the provider, next API call must 409 + flip status.\\nimport mock_intervals\\nmock_intervals.REVOKED.add(\\\"mock-at-1\\\")\\nst, _, body = req(\\\"/api/intervals/wellness\\\", token=TOK)\\ncheck(\\\"wellness 409 after revoke\\\", st == 409, str(st))\\nst, _, body = req(\\\"/api/intervals/status\\\", token=TOK)\\nd = json.loads(body)\\ncheck(\\\"status now reconnect\\\", d.get(\\\"connected\\\") is False and d.get(\\\"status\\\") == \\\"reconnect\\\", body)\\n\\n# 8. Token exchange sent only client_id, client_secret, code.\\ncheck(\\\"token exchange fields minimal\\\",\\n      mock_intervals.TOKEN_FIELDS and all(f == [\\\"client_id\\\", \\\"client_secret\\\", \\\"code\\\"] for f in mock_intervals.TOKEN_FIELDS),\\n      str(mock_intervals.TOKEN_FIELDS))\\n\\n# 9. Full reconnect round-trip after revocation works.\\nst, _, body = req(\\\"/api/intervals/auth/init\\\", token=TOK, data=b\\\"\\\")\\nauth_url = json.loads(body)[\\\"authorize_url\\\"]\\nparts = urllib.parse.urlsplit(auth_url)\\nst, hdrs, _ = req(parts.path + \\\"?\\\" + parts.query)\\ncb = urllib.parse.urlsplit(hdrs[\\\"Location\\\"])\\nst, _, _ = req(cb.path + \\\"?\\\" + cb.query)\\nst, _, body = req(\\\"/api/intervals/status\\\", token=TOK)\\ncheck(\\\"reconnect round-trip restores connection\\\", json.loads(body).get(\\\"connected\\\") is True, body)\\n\\nprint(\\\"\\\\n%d/%d passed\\\" % (9 - len([f for f in fails]), 9))\\nraise SystemExit(1 if fails else 0)\\n\",\"path\":\"/private/tmp/h-unWmrw/.tmp-test/e2e_test.py\"}"}}]}
