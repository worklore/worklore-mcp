ublish_into_empty_table(self):\n        table = FakeTable()\n        stored = app.publish(table, CRON)\n        self.assertEqual(stored[\"slug\"], \"why-my-cron-ran-twice\")\n        self.assertEqual(table.get_item(Key={\"slug\": \"why-my-cron-ran-twice\"})[\"Item\"][\"title\"], \"Why my cron ran twice\")\n        self.assertEqual(table.scan()[\"Count\"], 1)\n        self.assertEqual(stored[\"similar\"], [])\n\n    def test_publish_into_seeded_table(self):\n        # The empty-table path never computes a score; this one does (the prod 500).\n        table = FakeTable()\n        app.publish(table, CRON)\n        stored = app.publish(table, SYSTEMD)\n        self.assertEqual(table.scan()[\"Count\"], 2)\n        similar = table.get_item(Key={\"slug\": SYSTEMD[\"slug\"]})[\"Item\"][\"similar\"]\n        self.assertEqual([s[\"slug\"] for s in similar], [CRON[\"slug\"]])\n        self.assertIsInstance(similar[0][\"score\"], Decimal)\n        self.assertGreater(similar[0][\"score\"], 0)\n        self.assertEqual(stored[\"similar\"], similar)\n\n    def test_handler_second_publish_is_201(self):\n        import json\n        table = FakeTable()\n        self.assertEqual(app.handler({\"body\": json.dumps(CRON)}, table)[\"statusCode\"], 201)\n        self.assertEqual(app.handler({\"body\": json.dumps(SYSTEMD)}, table)[\"statusCode\"], 201)\n\n    def test_publish_more_than_top_n(self):\n        table = FakeTable()\n        for i in range(app.TOP_N + 2):\n            app.publish(table, dict(CRON, slug=f\"story-{i}\", tags=[\"cron\", f\"t{i}\"]))\n        item = table.get_item(Key={\"slug\": f\"story-{app.TOP_N + 1}\"})[\"Item\"]\n        self.assertEqual(len(item[\"similar\"]), app.TOP_N)\n\n    def test_to_dynamo_converts_nested_floats(self):\n        out = app.to_dynamo({\"a\": 0.5, \"b\": [{\"c\": 0.25}], \"d\": 1, \"e\": \"x\"})\n        self.assertEqual(out, {\"a\": Decimal(\"0.5\"), \"b\": [{\"c\": Decimal(\"0.25\")}], \"d\": 1, \"e\": \"x\"})\n\n\nif __name__ == \"__main__\":\n    unittest.main()\nEOF\ngit stash -q -- src/app.py; python3 -m unittest discover tests 2>&1 | tail -3; git stash pop -q; python3 -m unittest discover tests 2>&1 | tail -3"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2288,"cache_read_input_tokens":22568,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2288},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d10586ed-66bd-4748-b16b-821ed669e4f1","uuid":"d6aea47e-36d1-4ca0-95ab-c671dc6d0164","timestamp":"2026-10-27T03:55:45.740Z","request_id":"req_011CgS4sJX9BA1uKUDjYmuwq","wire_tool_inputs":{"toolu_01CiKHvSHYZSGdKZPWzN6x2k":{"command":"cd /private/tmp/h-sohqBR && python3 - <<'EOF'\nimport re\np='src/app.py'; s=open(p).read()\ns=s.replace(\"import time\\n\",\"import time\\nfrom decimal import Decimal\\n\")\ns=s.replace('''    return round(0.7 * tag_score + 0.3 * word_score, 4)\n''','''    # Decimal, not float: DynamoDB (boto3) rejects Python floats.\n    return Decimal(str(round(0.7 * tag_score + 0.3 * word_score, 4)))\n''')\ns=s.replace('''def validate(story):''','''def to_dynamo(value):\n    \"\"\"Convert floats (at any depth) to Decimal so boto3 can serialize the item.\"\"\"\n    if isinstance(value, float):\n        return Decimal(str(value))\n    if isinstance(value, dict):\n        return {k: to_dynamo(v) for k, v in value.items()}\n    if isinstance(value, list):\n        return [to_dynamo(v) for v in value]\n    return value\n\n\ndef validate(story):''')\ns=s.replace('''    table.put_item(Item=item)''','''    item = to_dynamo(item)\n    table.put_item(Item=item)''')\nopen(p,'w').write(s)\nEOF\ncat > tests/test_publish.py <<'EOF'\nimport os\nimport sys\nimport unittest\nfrom decimal import Decimal\n\nsys.path.in