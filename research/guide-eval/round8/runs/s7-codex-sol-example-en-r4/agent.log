{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc 'git diff --check && git diff --stat && git diff'","aggregated_output":" config.py     |  4 +--\n server.py     | 96 ++++++++++++++++++++++++++---------------------------------\n static/app.js | 13 +++++++-\n 3 files changed, 55 insertions(+), 58 deletions(-)\ndiff --git a/config.py b/config.py\nindex 54a8144..d5cc0c9 100644\n--- a/config.py\n+++ b/config.py\n@@ -8,6 +8,4 @@ INTERVALS_BASE = os.environ.get(\"INTERVALS_BASE\", \"https://intervals.icu\")\n CLIENT_ID = \"tricoach-dev\"\n CLIENT_SECRET = \"s3cr3t-placeholder-0000\"\n REDIRECT_URI = f\"http://localhost:{PORT}/api/intervals/callback\"\n-SCOPES = \"ACTIVITY:READ,ACTIVITY:WRITE,WELLNESS:READ,CALENDAR:READ,CALENDAR:WRITE\"\n-\n-REFRESH_INTERVAL = 60      # seconds between passes of the token refresher\n+SCOPES = \"ACTIVITY:WRITE,WELLNESS:READ,CALENDAR:WRITE\"\ndiff --git a/server.py b/server.py\nindex 351cbb7..b5b4d62 100644\n--- a/server.py\n+++ b/server.py\n@@ -12,14 +12,13 @@ import config\n STATIC = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"static\")\n TOKEN_URL = config.INTERVALS_BASE + \"/api/oauth/token\"\n AUTHORIZE_URL = config.INTERVALS_BASE + \"/oauth/authorize\"\n-DEFAULT_TOKEN_TTL = 3600   # seconds; used when the provider does not say how long a token lives\n \n # --- in-memory store -------------------------------------------------------\n USERS = {\n     \"tok-okafor\": {\"id\": \"u_okafor\", \"name\": \"C. Okafor\"},\n     \"tok-rivera\": {\"id\": \"u_rivera\", \"name\": \"T. Rivera\"},\n }\n-# user_id -> {athlete_id, athlete_name, access_token, refresh_token, scope, expires_at, status}\n+# user_id -> {athlete_id, athlete_name, access_token, scope, status}\n CONNECTIONS = {}\n LOCK = threading.Lock()\n \n@@ -30,21 +29,28 @@ def log(msg):\n \n # --- state parameter: carries the user through the redirect -----------------\n def sign_state(user_id):\n-    payload = f\"{user_id}:{int(time.time())}\"\n-    sig = hmac.new(config.APP_SECRET.encode(), payload.encode(), hashlib.sha256).hexdigest()[:32]\n-    return base64.urlsafe_b64encode(f\"{payload}:{sig}\".encode()).decode()\n+    payload = json.dumps({\"sub\": user_id, \"purpose\": \"intervals_oauth\",\n+                          \"iat\": int(time.time())}, separators=(\",\", \":\")).encode()\n+    sig = hmac.new(config.APP_SECRET.encode(), payload, hashlib.sha256).digest()\n+    return base64.urlsafe_b64encode(payload + sig).decode()\n \n \n def verify_state(state, max_age=900):\n     try:\n-        user_id, ts, sig = base64.urlsafe_b64decode(state.encode()).decode().split(\":\")\n-    except Exception:\n-        return None\n-    payload = f\"{user_id}:{ts}\"\n-    good = hmac.new(config.APP_SECRET.encode(), payload.encode(), hashlib.sha256).hexdigest()[:32]\n-    if not hmac.compare_digest(good, sig) or time.time() - int(ts) > max_age:\n+        raw = base64.b64decode(state, altchars=b\"-_\", validate=True)\n+        payload, sig = raw[:-32], raw[-32:]\n+        good = hmac.new(config.APP_SECRET.encode(), payload, hashlib.sha256).digest()\n+        claims = json.loads(payload)\n+        now = time.time()\n+        if (not hmac.compare_digest(good, sig)\n+                or claims.get(\"purpose\") != \"intervals_oauth\"\n+                or claims.get(\"sub\") not in {u[\"id\"] for u in USERS.values()}\n+                or not isinstance(claims.get(\"iat\"), int)\n+                or not 0 <= now - claims[\"iat\"] <= max_age):\n+            return None\n+    except (ValueError, TypeError, KeyError, UnicodeDecodeError):\n         return None\n-    return user_id\n+    return claims[\"sub\"]\n \n \n # --- Intervals.icu calls ----------------------------------------------------\n@@ -57,51 +63,25 @@ def post_form(url, fields):\n \n def exchange_code(code):\n     return post_form(TOKEN_URL, {\n-        \"grant_type\": \"authorization_code\", \"client_id\": config.CLIENT_ID,\n-        \"client_secret\": config.CLIENT_SECRET, \"code\": code, \"redirect_uri\": config.REDIRECT_URI,\n+        \"client_id\": config.CLIENT_ID, \"client_secret\": config.CLIENT_SECRET, \"code\": code,\n     })\n \n \n def store_connection(user_id, tok):\n-    expires_in = int(tok.get(\"expires_in\") or DEFAULT_TOKEN_TTL)\n-    refresh = tok.get(\"refresh_token\")\n-    if not refresh:\n-        log(f\"{user_id}: no refresh_token in response, scheduling expiry in {expires_in}s\")\n     athlete = tok.get(\"athlete\") or {}\n+    athlete_id = athlete.get(\"id\")\n+    if not tok.get(\"access_token\") or not athlete_id:\n+        raise ValueError(\"token response missing access_token or athlete.id\")\n     with LOCK:\n+        previous = CONNECTIONS.get(user_id)\n+        if previous and previous[\"athlete_id\"] != athlete_id:\n+            raise ValueError(\"Intervals athlete differs from existing connection; disconnect first\")\n         CONNECTIONS[user_id] = {\n-            \"athlete_id\": athlete.get(\"id\"), \"athlete_name\": athlete.get(\"name\"),\n-            \"access_token\": tok[\"access_token\"], \"refresh_token\": refresh,\n-            \"scope\": tok.get(\"scope\"), \"expires_at\": time.time() + expires_in, \"status\": \"connected\",\n+            \"athlete_id\": athlete_id, \"athlete_name\": athlete.get(\"name\"),\n+            \"access_token\": tok[\"access_token\"], \"scope\": tok.get(\"scope\"),\n+            \"status\": \"connected\",\n         }\n-    log(f\"{user_id}: connected as athlete {athlete.get('id')} (expires in {expires_in}s)\")\n-\n-\n-def refresh_tokens():\n-    \"\"\"Background pass: renew access tokens shortly before they expire.\"\"\"\n-    while True:\n-        time.sleep(config.REFRESH_INTERVAL)\n-        now = time.time()\n-        with LOCK:\n-            for uid, c in CONNECTIONS.items():\n-                if c[\"status\"] != \"connected\" or c[\"expires_at\"] - now > 300:\n-                    continue\n-                if not c[\"refresh_token\"]:\n-                    log(f\"{uid}: token expiry passed and no refresh token on file -> expired, reconnect\")\n-                    c.update(status=\"expired, reconnect\", access_token=None)\n-                    continue\n-                try:\n-                    tok = post_form(TOKEN_URL, {\n-                        \"grant_type\": \"refresh_token\", \"refresh_token\": c[\"refresh_token\"],\n-                        \"client_id\": config.CLIENT_ID, \"client_secret\": config.CLIENT_SECRET,\n-                    })\n-                    c.update(access_token=tok[\"access_token\"],\n-                             refresh_token=tok.get(\"refresh_token\", c[\"refresh_token\"]),\n-                             expires_at=now + int(tok[\"expires_in\"]))\n-                    log(f\"{uid}: token refreshed\")\n-                except Exception as e:\n-                    log(f\"{uid}: refresh failed ({e}) -> expired, reconnect\")\n-                    c.update(status=\"expired, reconnect\", access_token=None)\n+    log(f\"{user_id}: connected as athlete {athlete_id}\")\n \n \n def intervals_get(conn, path):\n@@ -164,8 +144,6 @@ class Handler(BaseHTTPRequestHandler):\n         if url.path == \"/api/me\":\n             user = self.require_user()\n             return user and self.send_json(200, user)\n-        if url.path == \"/api/intervals/auth/init\":\n-            return self.auth_init()\n         if url.path == \"/api/intervals/callback\":\n             return self.callback(q)\n         if url.path == \"/api/intervals/status\":\n@@ -176,6 +154,8 @@ class Handler(BaseHTTPRequestHandler):\n \n     def do_POST(self):\n         url = urllib.parse.urlsplit(self.path)\n+        if url.path == \"/api/intervals/auth/init\":\n+            return self.auth_init()\n         if url.path == \"/api/intervals/disconnect\":\n             user = self.require_user()\n             if user:\n@@ -185,14 +165,14 @@ class Handler(BaseHTTPRequestHandler):\n             return\n         self.send_json(404, {\"error\": \"not found\"})\n \n-    # Step 1: build the authorize URL and send the browser to Intervals.\n+    # Step 1: return the authorize URL to the authenticated SPA request.\n     def auth_init(self):\n         user = self.require_user()\n         if not user:\n             return\n         params = {\"client_id\": config.CLIENT_ID, \"redirect_uri\": config.REDIRECT_URI,\n                   \"scope\": config.SCOPES, \"state\": sign_state(user[\"id\"])}\n-        self.redirect(AUTHORIZE_URL + \"?\" + urllib.parse.urlencode(params, safe=\":,\"))\n+        self.send_json(200, {\"authorize_url\": AUTHORIZE_URL + \"?\" + urllib.parse.urlencode(params)})\n \n     # Step 2: Intervals redirects back here with ?code=&state=.\n     def callback(self, q):\n@@ -202,6 +182,9 @@ class Handler(BaseHTTPRequestHandler):\n         try:\n             tok = exchange_code(q[\"code\"])\n             store_connection(user_id, tok)\n+        except ValueError as e:\n+            log(f\"{user_id}: connection rejected: {e}\")\n+            return self.send_json(409, {\"error\": str(e)})\n         except urllib.error.HTTPError as e:\n             log(f\"{user_id}: token exchange failed: HTTP {e.code} {e.read()[:200]!r}\")\n             return self.send_json(502, {\"error\": \"token exchange failed\"})\n@@ -233,12 +216,17 @@ class Handler(BaseHTTPRequestHandler):\n             code, data = intervals_get(c, \"/wellness\")\n             self.send_json(code, data)\n         except urllib.error.HTTPError as e:\n+            if e.code == 401:\n+                with LOCK:\n+                    current = CONNECTIONS.get(user[\"id\"])\n+                    if current is c:\n+                        current.update(status=\"reconnect\", access_token=None)\n+                return self.send_json(409, {\"error\": \"Intervals authorization revoked; reconnect\"})\n             self.send_json(e.code, {\"error\": f\"intervals returned {e.code}\"})\n         except Exception as e:\n             self.send_json(502, {\"error\": str(e)})\n \n \n if __name__ == \"__main__\":\n-    threading.Thread(target=refresh_tokens, daemon=True).start()\n     log(f\"serving on http://localhost:{config.PORT} (intervals: {config.INTERVALS_BASE})\")\n     ThreadingHTTPServer((\"127.0.0.1\", config.PORT), Handler).serve_forever()\ndiff --git a/static/app.js b/static/app.js\nindex 368922e..30bb1b2 100644\n--- a/static/app.js\n+++ b/static/app.js\n@@ -25,12 +25,23 @@ async function render() {\n     } else {\n       const why = st.status && st.status !== \"disconnected\" ? `<p class=\"muted\">Status: ${esc(st.status)}</p>` : \"\";\n       card = `<div class=\"card\">Intervals.icu is not connected.${why}\n-        <p><a class=\"btn\" href=\"/api/intervals/auth/init\">Connect Intervals.icu</a></p></div>`;\n+        <p><button class=\"btn\" id=\"connect\">Connect Intervals.icu</button></p></div>`;\n     }\n     root.className = \"\";\n     root.innerHTML = `<p>Signed in as <b>${esc(me.name)}</b>.</p>${card}`;\n     const d = document.getElementById(\"disconnect\");\n     if (d) d.onclick = async () => { await api(\"/api/intervals/disconnect\", { method: \"POST\" }); render(); };\n+    const c = document.getElementById(\"connect\");\n+    if (c) c.onclick = async () => {\n+      c.disabled = true;\n+      try {\n+        const { authorize_url } = await api(\"/api/intervals/auth/init\", { method: \"POST\" });\n+        window.location.assign(authorize_url);\n+      } catch (e) {\n+        c.disabled = false;\n+        root.insertAdjacentHTML(\"beforeend\", `<p class=\"card\">Error: ${esc(e.message)}</p>`);\n+      }\n+    };\n   } catch (e) {\n     root.innerHTML = `<p class=\"card\">Error: ${esc(e.message)}</p>`;\n   }\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"curl -Ls --max-time 12 'https://forum.intervals.icu/t/intervals-icu-oauth-support/2759.json' | python3 -c 'import json,sys; d=json.load(sys.stdin); print(\\\"\\\\n\\\".join(p.get(\\\"cooked\\\", \\\"\\\")[:4000] for p in d[\\\"post_stream\\\"][\\\"posts\\\"][:2]))'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"curl -Ls --max-time 12 'https://forum.intervals.icu/t/intervals-icu-oauth-support/2759.json' | python3 -c 'import json,sys; d=json.load(sys.stdin); print(\\\"\\\\n\\\".join(p.get(\\\"cooked\\\", \\\"\\\")[:4000] for p in d[\\\"post_stream\\\"][\\\"posts\\\"][:2]))'\"","aggregated_output":"<p>Intervals.icu uses OAuth2 for authentication to the API. OAuth allows external applications to request authorization to access an Intervals.icu user’s data. It allows users to grant and revoke API access on a per-application basis and keeps user authentication details safe.</p>\n<h2><a name=\"p-9171-creating-an-application-1\" class=\"anchor\" href=\"#p-9171-creating-an-application-1\" aria-label=\"Heading link\"></a>Creating An Application</h2>\n<p>Fill in the application form here: <a href=\"https://intervals.icu/oauth/apply\">https://intervals.icu/oauth/apply</a></p>\n<p>You need to be logged in as the Intervals.icu athlete that will own the app. This athlete will have access to the management page to edit the app, setup redirect URI’s, webhooks and other things.</p>\n<p>Your app will show up on the /settings/apps page (only for you as the owner) and you can click “Manage App” to retrieve your client_id and secret, change redirect URL’s, configure webhooks and so on.</p>\n<p><div class=\"lightbox-wrapper\"><a class=\"lightbox\" href=\"https://forum.intervals.icu/uploads/default/original/3X/2/3/2315938f281501f685fdbb3a1090b774f7a38bfd.png\" data-download-href=\"https://forum.intervals.icu/uploads/default/2315938f281501f685fdbb3a1090b774f7a38bfd\" title=\"Screenshot 2026-08-28 at 14.29.43\"><img src=\"https://forum.intervals.icu/uploads/default/optimized/3X/2/3/2315938f281501f685fdbb3a1090b774f7a38bfd_2_517x272.png\" alt=\"Screenshot 2026-08-28 at 14.29.43\" data-base62-sha1=\"50mWclBkojIYj6yDwG94R8mx2dT\" width=\"517\" height=\"272\" srcset=\"https://forum.intervals.icu/uploads/default/optimized/3X/2/3/2315938f281501f685fdbb3a1090b774f7a38bfd_2_517x272.png, https://forum.intervals.icu/uploads/default/optimized/3X/2/3/2315938f281501f685fdbb3a1090b774f7a38bfd_2_775x408.png 1.5x, https://forum.intervals.icu/uploads/default/original/3X/2/3/2315938f281501f685fdbb3a1090b774f7a38bfd.png 2x\" data-dominant-color=\"F6F5F4\"><div class=\"meta\"><svg class=\"fa d-icon d-icon-far-image svg-icon\" aria-hidden=\"true\"><use href=\"#far-image\"></use></svg><span class=\"filename\">Screenshot 2026-08-28 at 14.29.43</span><span class=\"informations\">828×436 27 KB</span><svg class=\"fa d-icon d-icon-discourse-expand svg-icon\" aria-hidden=\"true\"><use href=\"#discourse-expand\"></use></svg></div></a></div></p>\n<p>The app will have status “Pending” until it is approved. <strong>Please note that you will not be able to do the OAuth flow until it is approved</strong>. You can upload a logo, get the client ID and secret and so on.</p>\n<p>Once it has been approved, the pending tag will disappear. You will receive a system notification when this happens (delivered by email and in the Intervals.icu app).</p>\n<p>Note that it will not be visible to other users in /settings/apps, but you can send anyone you like to the OAuth consent page and begin integration.</p>\n<p><div class=\"lightbox-wrapper\"><a class=\"lightbox\" href=\"https://forum.intervals.icu/uploads/default/original/3X/8/b/8b1c72e171adc3a90c2b8a21f06e9e5bb78e3942.png\" data-download-href=\"https://forum.intervals.icu/uploads/default/8b1c72e171adc3a90c2b8a21f06e9e5bb78e3942\" title=\"Screenshot 2024-12-06 at 16.38.05\"><img src=\"https://forum.intervals.icu/uploads/default/optimized/3X/8/b/8b1c72e171adc3a90c2b8a21f06e9e5bb78e3942_2_345x172.png\" alt=\"Screenshot 2024-12-06 at 16.38.05\" data-base62-sha1=\"jQDjOoWqKseuBtarcRZCYqOswrU\" width=\"345\" height=\"172\" srcset=\"https://forum.intervals.icu/uploads/default/optimized/3X/8/b/8b1c72e171adc3a90c2b8a21f06e9e5bb78e3942_2_345x172.png, https://forum.intervals.icu/uploads/default/optimized/3X/8/b/8b1c72e171adc3a90c2b8a21f06e9e5bb78e3942_2_517x258.png 1.5x, https://forum.intervals.icu/uploads/default/optimized/3X/8/b/8b1c72e171adc3a90c2b8a21f06e9e5bb78e3942_2_690x344.png 2x\" data-dominant-color=\"F2F3F4\"><div class=\"meta\"><svg class=\"fa d-icon d-icon-far-image svg-icon\" aria-hidden=\"true\"><use href=\"#far-image\"></use></svg><span class=\"filename\">Screenshot 2024-12-06 at 16.38.05</span><span class=\"informations\">78\n<p>This is what a user sees on the /settings page when they have authorised an app:</p>\n<p><div class=\"lightbox-wrapper\"><a class=\"lightbox\" href=\"https://forum.intervals.icu/uploads/default/original/2X/8/8f03060a46d7914e9881e6f90d24dff10560db6c.png\" data-download-href=\"https://forum.intervals.icu/uploads/default/8f03060a46d7914e9881e6f90d24dff10560db6c\" title=\"Screen Shot 2021-01-30 at 17.00.16\"><img src=\"https://forum.intervals.icu/uploads/default/optimized/2X/8/8f03060a46d7914e9881e6f90d24dff10560db6c_2_345x142.png\" alt=\"Screen Shot 2021-01-30 at 17.00.16\" data-base62-sha1=\"kp8KTcje24SZI4e3Xri0vp2JuHO\" width=\"345\" height=\"142\" srcset=\"https://forum.intervals.icu/uploads/default/optimized/2X/8/8f03060a46d7914e9881e6f90d24dff10560db6c_2_345x142.png, https://forum.intervals.icu/uploads/default/optimized/2X/8/8f03060a46d7914e9881e6f90d24dff10560db6c_2_517x213.png 1.5x, https://forum.intervals.icu/uploads/default/optimized/2X/8/8f03060a46d7914e9881e6f90d24dff10560db6c_2_690x284.png 2x\" data-dominant-color=\"F3F1F1\"><div class=\"meta\"><svg class=\"fa d-icon d-icon-far-image svg-icon\" aria-hidden=\"true\"><use href=\"#far-image\"></use></svg><span class=\"filename\">Screen Shot 2021-01-30 at 17.00.16</span><span class=\"informations\">824×340 41 KB</span><svg class=\"fa d-icon d-icon-discourse-expand svg-icon\" aria-hidden=\"true\"><use href=\"#discourse-expand\"></use></svg></div></a></div></p>\n<p>Note that <a href=\"https://apps.apple.com/us/app/healthfit/id1202650514\">HealthFit</a> support for Intervals.icu is still in beta.</p>\n<p><div class=\"lightbox-wrapper\"><a class=\"lightbox\" href=\"https://forum.intervals.icu/uploads/default/original/2X/a/a5d2bc41708dfa9271521e865f0cfe7b684fd3db.png\" data-download-href=\"https://forum.intervals.icu/uploads/default/a5d2bc41708dfa9271521e865f0cfe7b684fd3db\" title=\"Screen Shot 2021-01-30 at 17.00.46\"><img src=\"https://forum.intervals.icu/uploads/default/optimized/2X/a/a5d2bc41708dfa9271521e865f0cfe7b684fd3db_2_345x246.png\" alt=\"Screen Shot 2021-01-30 at 17.00.46\" data-base62-sha1=\"nEWhqt8vSDsvjcb8YuboPnR1B4D\" width=\"345\" height=\"246\" srcset=\"https://forum.intervals.icu/uploads/default/optimized/2X/a/a5d2bc41708dfa9271521e865f0cfe7b684fd3db_2_345x246.png, https://forum.intervals.icu/uploads/default/optimized/2X/a/a5d2bc41708dfa9271521e865f0cfe7b684fd3db_2_517x369.png 1.5x, https://forum.intervals.icu/uploads/default/optimized/2X/a/a5d2bc41708dfa9271521e865f0cfe7b684fd3db_2_690x492.png 2x\" data-dominant-color=\"F3F3F3\"><div class=\"meta\"><svg class=\"fa d-icon d-icon-far-image svg-icon\" aria-hidden=\"true\"><use href=\"#far-image\"></use></svg><span class=\"filename\">Screen Shot 2021-01-30 at 17.00.46</span><span class=\"informations\">774×554 52.6 KB</span><svg class=\"fa d-icon d-icon-discourse-expand svg-icon\" aria-hidden=\"true\"><use href=\"#discourse-expand\"></use></svg></div></a></div></p>\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc \"curl -Ls --max-time 12 'https://forum.intervals.icu/t/intervals-icu-oauth-support/2759.json' | python3 -c 'import json,sys,re,html; d=json.load(sys.stdin); s=d[\\\"post_stream\\\"][\\\"posts\\\"][0][\\\"cooked\\\"]; s=re.sub(r\\\"<[\"'^>]+>\",\" \",s); s=html.unescape(s); [print(x.strip()) for x in s.splitlines() if any(k in x.lower() for k in (\"scope\", \"token\", \"authorize\", \"redirect\", \"expire\", \"refresh\", \"duplicate\"))]'\"'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc \"curl -Ls --max-time 12 'https://forum.intervals.icu/t/intervals-icu-oauth-support/2759.json' | python3 -c 'import json,sys,re,html; d=json.load(sys.stdin); s=d[\\\"post_stream\\\"][\\\"posts\\\"][0][\\\"cooked\\\"]; s=re.sub(r\\\"<[\"'^>]+>\",\" \",s); s=html.unescape(s); [print(x.strip()) for x in s.splitlines() if any(k in x.lower() for k in (\"scope\", \"token\", \"authorize\", \"redirect\", \"expire\", \"refresh\", \"duplicate\"))]'\"'\"","aggregated_output":"You need to be logged in as the Intervals.icu athlete that will own the app. This athlete will have access to the management page to edit the app, setup redirect URI’s, webhooks and other things.\nYour app will show up on the /settings/apps page (only for you as the owner) and you can click “Manage App” to retrieve your client_id and secret, change redirect URL’s, configure webhooks and so on.\nhttps://intervals.icu/oauth/authorize?client_id=<your client id>\n&redirect_uri=<your redirect uri>\n&scope=<required scopes>\nscopes to grant the application. If the user confirms then they are redirected to the redirect_uri with an\n<your redirect uri>?code=3983ed415f66413c890ca48b7cce59e4&state=...\n<your redirect uri>?error=access_denied\nYour server needs to exchange the code for an access token within 2 minutes by POSTing form data including your client_id and client_secret:\ncurl -X POST https://intervals.icu/api/oauth/token \\\nIf all goes well Intervals.icu will respond with an access token, granted scopes and the id and name of the athlete:\n\"token_type\": \"Bearer\",\n\"access_token\": \"d842c1fc25f241e5ae440d09756448a9\",\n\"scope\": \"ACTIVITY:WRITE,WELLNESS:WRITE\",\nNote that you can use “0” for the athlete id for endpoints that accept an athlete id in the path. This will use the athlete for the bearer token used to make the call.\nPKCE  is supported to protect the authorization code from interception. Generate a random  code_verifier  (43-128 chars of  A-Z a-z 0-9 - . _ ~ ) and add its challenge to the authorize URL (only  S256  is supported):\nApps that cannot keep a client_secret confidential can be flagged as public clients on the OAuth app management page. Public clients that use PKCE can omit client_secret when exchanging the code. Without PKCE the client_secret is still required (this is supported so existing apps can migrate, please switch to PKCE). The automatic  http://localhost  redirect exception does not apply to public clients, so register the exact redirect URIs you use, including any localhost ones. The port of a registered  http://localhost  or  http://127.0.0.1  redirect is ignored, so native apps can listen on any free port:\ncurl -X POST https://intervals.icu/api/oauth/token \\\nScopes\nScopes are as follows:\nFor each scope specify READ or WRITE (to update, implies READ access) and use commas to separate multiple scopes. Example:\nRevoking An Access Token\nWhen a user disconnects Intervals.icu in your app or deletes their data on your side, revoke the access token:\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc \"curl -Ls --max-time 12 'https://forum.intervals.icu/t/intervals-icu-oauth-support/2759.json' | python3 -c 'import json,sys,re,html; d=json.load(sys.stdin); s=d[\\\"post_stream\\\"][\\\"posts\\\"][0][\\\"cooked\\\"]; s=re.sub(r\\\"</(?:p|pre|h[1-6]|li)>\\\",\\\"\\\\n\\\",s); s=html.unescape(re.sub(r\\\"<[\"'^>]+>\",\"\",s)); p=s.find(\"Requesting Authorization\"); print(s[p:p+6500])'\"'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc \"curl -Ls --max-time 12 'https://forum.intervals.icu/t/intervals-icu-oauth-support/2759.json' | python3 -c 'import json,sys,re,html; d=json.load(sys.stdin); s=d[\\\"post_stream\\\"][\\\"posts\\\"][0][\\\"cooked\\\"]; s=re.sub(r\\\"</(?:p|pre|h[1-6]|li)>\\\",\\\"\\\\n\\\",s); s=html.unescape(re.sub(r\\\"<[\"'^>]+>\",\"\",s)); p=s.find(\"Requesting Authorization\"); print(s[p:p+6500])'\"'\"","aggregated_output":"Requesting Authorization To Access Intervals.icu Data For A User\n\nSend the user to:\n\nhttps://intervals.icu/oauth/authorize?client_id=<your client id>\n    &redirect_uri=<your redirect uri>\n    &scope=<required scopes>\n    &state=<optional data>\n\n\nIntervals.icu will ask the user to login and display a confirmation dialog with options to choose which\nscopes to grant the application. If the user confirms then they are redirected to the redirect_uri with an\nauthorization code and the optional state parameter:\n\n<your redirect uri>?code=3983ed415f66413c890ca48b7cce59e4&state=...\n\n\nIf they decline:\n\n<your redirect uri>?error=access_denied\n\n\nYour server needs to exchange the code for an access token within 2 minutes by POSTing form data including your client_id and client_secret:\n\ncurl -X POST https://intervals.icu/api/oauth/token \\\n    -d client_id=... \\\n    -d client_secret=... \\\n    -d code=3983ed415f66413c890ca48b7cce59e4\n\n\nIf all goes well Intervals.icu will respond with an access token, granted scopes and the id and name of the athlete:\n\n{\n    \"token_type\": \"Bearer\",\n    \"access_token\": \"d842c1fc25f241e5ae440d09756448a9\",\n    \"scope\": \"ACTIVITY:WRITE,WELLNESS:WRITE\",\n    \"athlete\": {\n        \"id\": \"2049151\",\n        \"name\": \"David (intervals.icu)\"\n    }\n}   \n\n\nTo call the API use “Authorization: Bearer d842c1fc25f241e5ae440d09756448a9” header.\n\nNote that you can use “0” for the athlete id for endpoints that accept an athlete id in the path. This will use the athlete for the bearer token used to make the call.\n\nPKCE (optional)\n\nPKCE is supported to protect the authorization code from interception. Generate a random code_verifier (43-128 chars of A-Z a-z 0-9 - . _ ~) and add its challenge to the authorize URL (only S256 is supported):\n\n    &code_challenge=<BASE64URL(SHA256(code_verifier)) without padding>\n    &code_challenge_method=S256\n\n\nThen include -d code_verifier=... when exchanging the code. If a challenge was sent, the verifier is required, and a verifier is rejected if no challenge was sent. The client_secret is still required unless your app is a public client.\n\nOnce every version of your app uses PKCE, tick “Require PKCE” on your app’s settings page. Authorizations without a code_challenge are then rejected, and so is exchanging a code without a code_verifier, even with the client_secret.\n\nPublic clients (SPA, mobile and desktop apps)\n\nApps that cannot keep a client_secret confidential can be flagged as public clients on the OAuth app management page. Public clients that use PKCE can omit client_secret when exchanging the code. Without PKCE the client_secret is still required (this is supported so existing apps can migrate, please switch to PKCE). The automatic http://localhost redirect exception does not apply to public clients, so register the exact redirect URIs you use, including any localhost ones. The port of a registered http://localhost or http://127.0.0.1 redirect is ignored, so native apps can listen on any free port:\n\ncurl -X POST https://intervals.icu/api/oauth/token \\\n    -d client_id=...\n    -d code=3983ed415f66413c890ca48b7cce59e4\n    -d code_verifier=...\n\n\nScopes\n\nScopes are as follows:\n\n\nACTIVITY: Completed rides, runs etc.\n\nWELLNESS: Weight, resting HR etc.\n\nCALENDAR: Planned workouts\n\nCHATS: Chats, groups and messages\n\nLIBRARY: Workout library\n\nSETTINGS: Athlete settings\n\n\nFor each scope specify READ or WRITE (to update, implies READ access) and use commas to separate multiple scopes. Example:\n\nACTIVITY:READ,WELLNESS:WRITE\n\n\nRequests read access to activities and read and write access to wellness data.\n\nRevoking An Access Token\n\nWhen a user disconnects Intervals.icu in your app or deletes their data on your side, revoke the access token:\n\ncurl -X DELETE \"https://intervals.icu/api/v1/disconnect-app\" \\\n -H 'authorization: Bearer d842c1fc25f241e5ae440d09756448a9'\n\n\nThis will stop webhook delivery for the athlete.\n\nYour Own Data\n\nNote that you don’t need to do all this if you just want access to your own data. Use your API key to do that.\n\nAPI Endpoints\n\n\n  \n    \n    \n    \n      API access to Intervals.icu \n  \n\nGuide\n    \n  \n  \n    Intervals.icu now has a public API for other applications. To use it you need to generate an API key in /settings (look for “Developer Settings” near the bottom). Your API key allows other applications to access your Intervals.icu data. Be careful what you do with it! If you suspect that your key may have been compromised immediately clear or re-generate it. \nBy using the API you agree to the Intervals.icu API Terms and Conditions . \nPlease not that data from Strava is not available from the API.…\n  \n\n\n","exit_code":0,"status":"completed"}}
