@@ -8,6 +8,7 @@ import json
 import logging
 import re
 import time
+from decimal import Decimal
 
 log = logging.getLogger("stories")
 
@@ -40,6 +41,22 @@ def related(story, existing):
     return scored[:TOP_N]
 
 
+def to_dynamo(value):
+    """Make ``value`` storable by boto3: DynamoDB numbers must be Decimal, never float.
+
+    Every item goes through this right before ``put_item``, so a float added
+    anywhere in the item (now or later) can't turn a publish into a 500.
+    """
+    if isinstance(value, float):
+        # via str() so 0.1234 is stored as 0.1234, not as its binary expansion
+        return Decimal(str(value))
+    if isinstance(value, dict):
+        return {k: to_dynamo(v) for k, v in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [to_dynamo(v) for v in value]
+    return value
+
+
 def validate(story):
     for k in ("slug", "title", "body"):
         if not story.get(k):
@@ -60,6 +77,7 @@ def publish(table, story):
         "published_at": int(time.time()),
         "similar": related(story, existing),
     }
+    item = to_dynamo(item)
     table.put_item(Item=item)
     log.info("publish slug=%s similar=%d stored", item["slug"], len(item["similar"]))
     return item
