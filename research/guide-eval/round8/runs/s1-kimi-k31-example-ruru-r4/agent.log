{"role":"tool","tool_call_id":"tool_kBVLNbuG5l49BkFO4l5L7hFO","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"Build an Intervals.icu event body (workout_doc) from a plan file.\n3\t\n4\tUsage: python3 gen.py plans/tempo-run.json > event.json\n5\t\"\"\"\n6\timport json\n7\timport sys\n8\t\n9\t\n10\tdef hr_target(step):\n11\t    \"\"\"HR corridor for a step, as a percentage of the athlete's LTHR.\"\"\"\n12\t    lo, hi = step[\"hr_pct\"]\n13\t    return {\"units\": \"%lthr\", \"value\": lo, \"end\": hi}\n14\t\n15\t\n16\tdef build_step(step):\n17\t    out = {\"duration\": step[\"minutes\"] * 60}\n18\t    if \"hr_pct\" in step:\n19\t        out[\"hr\"] = hr_target(step)\n20\t    if \"label\" in step:\n21\t        out[\"text\"] = step[\"label\"]\n22\t    return out\n23\t\n24\t\n25\tdef build_doc(plan):\n26\t    steps = []\n27\t    for block in plan[\"steps\"]:\n28\t        if \"repeat\" in block:\n29\t            steps.append({\n30\t                \"reps\": block[\"repeat\"],\n31\t                \"steps\": [build_step(s) for s in block[\"steps\"]],\n32\t            })\n33\t        else:\n34\t            steps.append(build_step(block))\n35\t    return {\"steps\": steps}\n36\t\n37\t\n38\tdef build_event(plan):\n39\t    return {\n40\t        \"category\": \"WORKOUT\",\n41\t        \"type\": plan[\"sport\"],\n42\t        \"name\": plan[\"name\"],\n43\t        \"start_date_local\": plan[\"date\"] + \"T00:00:00\",\n44\t        \"workout_doc\": build_doc(plan),\n45\t    }\n46\t\n47\t\n48\tif __name__ == \"__main__\":\n49\t    with open(sys.argv[1]) as f:\n50\t        plan = json.load(f)\n51\t    json.dump(build_event(plan), sys.stdout, indent=2)\n52\t    print()"}
{"role":"tool","tool_call_id":"tool_cqtRhl1mxOAdGcnV3w7eikK4","content":"1\t# tri-planner\n2\t\n3\tGenerates structured triathlon workouts and pushes them to Intervals.icu, which\n4\texports them to the athlete's Garmin watch through Garmin Connect.\n5\t\n6\t- `gen.py` turns a plan (`plans/*.json`) into the body for\n7\t  `POST /api/v1/athlete/{id}/events` (an event with `workout_doc`).\n8\t- `push.sh` posts it (needs `INTERVALS_API_KEY` and `ATHLETE_ID`).\n9\t- `readback/` holds what the API returned for the last pushed event and\n10\t  notes on what the watch displayed.\n11\t\n12\tAthlete thresholds live in Intervals (LTHR 172 for this athlete). HR targets\n13\tin plans are percentages of LTHR; Intervals converts them to bpm at export.\n14\t\n15\t```\n16\tpython3 gen.py plans/tempo-run.json > event.json\n17\t./push.sh event.json\n18\t```"}
{"role":"tool","tool_call_id":"tool_PfS5LrgyxDFoOZW1jhl1mrwV","content":"1\t#!/usr/bin/env bash\n2\t# usage: ./push.sh event.json   (needs INTERVALS_API_KEY and ATHLETE_ID)\n3\tset -eu\n4\tcurl -sS -u \"API_KEY:${INTERVALS_API_KEY}\" -H 'Content-Type: application/json' \\\n5\t  -X POST \"https://intervals.icu/api/v1/athlete/${ATHLETE_ID}/events\" \\\n6\t  --data-binary @\"$1\""}
