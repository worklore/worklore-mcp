diff --git a/Library/LaunchAgents/com.vk.nightly-review.plist b/Library/LaunchAgents/com.vk.nightly-review.plist
index c347363..d49eacf 100644
--- a/Library/LaunchAgents/com.vk.nightly-review.plist
+++ b/Library/LaunchAgents/com.vk.nightly-review.plist
@@ -24,6 +24,8 @@
   <dict>
     <key>PATH</key>
     <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
+    <key>USER</key>
+    <string>vk</string>
   </dict>
 </dict>
 </plist>
diff --git a/bin/nightly-review.zsh b/bin/nightly-review.zsh
index e0b986f..233e2eb 100755
--- a/bin/nightly-review.zsh
+++ b/bin/nightly-review.zsh
@@ -13,14 +13,20 @@ For each commit: one line on what it changes and whether anything looks risky
 End with a three-line summary I can read on my phone.
 Do not modify any file."
 
-cd "$REPO" || { "$NOTIFY" "nightly review: repo missing"; exit 1; }
+start=$SECONDS
 
-claude -p "$PROMPT" --output-format text > "$OUT"
-status=$?
+cd "$REPO" || { "$NOTIFY" "nightly review: repo missing" || true; exit 1; }
 
-if [ $status -ne 0 ]; then
-  "$NOTIFY" "nightly review FAILED (exit $status), see $OUT"
-  exit $status
+print -r -- "$PROMPT" | claude -p --output-format text > "$OUT"
+rc=$?
+
+print -r -- "nightly-review: claude exit=$rc after $((SECONDS - start))s at $(date '+%F %T')"
+
+if [ $rc -ne 0 ]; then
+  "$NOTIFY" "nightly review FAILED (exit $rc), see $OUT" \
+    || print -u2 -- "nightly-review: notify.sh itself failed (rc=$?)"
+  exit $rc
 fi
 
-"$NOTIFY" "nightly review done: $(head -c 300 "$OUT")"
+"$NOTIFY" "nightly review done: $(head -c 300 "$OUT")" \
+  || { print -u2 -- "nightly-review: notify.sh itself failed (rc=$?)"; exit 1; }
