itself failed (rc=$?)\\\"; exit 1; }\\n\"}"}},{"type":"function","id":"tool_R9rr9JstO3bjVbPJozvx1tH6","function":{"name":"Edit","arguments":"{\"path\":\"Library/LaunchAgents/com.vk.nightly-review.plist\",\"old_string\":\"    <key>PATH</key>\\n    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>\\n  </dict>\",\"new_string\":\"    <key>PATH</key>\\n    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>\\n    <key>USER</key>\\n    <string>vk</string>\\n  </dict>\"}"}}]}
