 log = logging.getLogger("stories")
 
@@ -48,6 +50,23 @@ def validate(story):
         raise ValueError("bad slug")
 
 
+def dynamodb_item(value):
+    """Convert nested Python floats to numbers accepted by boto3's Table resource."""
+    if isinstance(value, float):
+        if not math.isfinite(value):
+            raise ValueError("non-finite number in story item")
+        return Decimal(str(value))
+    if isinstance(value, dict):
+        return {key: dynamodb_item(part) for key, part in value.items()}
+    if isinstance(value, list):
+        return [dynamodb_item(part) for part in value]
+    if isinstance(value, tuple):
+        return tuple(dynamodb_item(part) for part in value)
+    if isinstance(value, (set, frozenset)):
+        return type(value)(dynamodb_item(part) for part in value)
+    return value
+
+
 def publish(table, story):
     """Store ``story`` with its related stories. Returns the stored item."""
     validate(story)
@@ -60,6 +79,7 @@ def publish(table, story):
         "published_at": int(time.time()),
         "similar": related(story, existing),
     }
+    item = dynamodb_item(item)
     table.put_item(Item=item)
     log.info("publish slug=%s similar=%d stored", item["slug"], len(item["similar"]))
     return item
