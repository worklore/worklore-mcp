tokens, u.cache_read_input_tokens, u.output_tokens = plain, created, read, 12\\n    return u\\n\\nclass Block:\\n    def __init__(self, **kw): self.__dict__.update(kw)\\n    def model_dump(self):\\n        return {k: v for k, v in self.__dict__.items() if v is not None}\\n\\nclass Resp:\\n    def __init__(self, blocks, stop, usage):\\n        self.content, self.stop_reason, self.usage = blocks, stop, usage\\n\\nclass FakeLLM:\\n    def create(self, **kw):\\n        u = usage_for(kw[\\\"system\\\"], kw[\\\"tools\\\"], kw[\\\"messages\\\"])\\n        last = kw[\\\"messages\\\"][-1][\\\"content\\\"]\\n        text = last if isinstance(last, str) else \\\" \\\".join(r.get(\\\"content\\\", \\\"\\\") for r in last if isinstance(r, dict))\\n        low = text.lower()\\n        if \\\"remember\\\" in low:\\n            return Resp([Block(type=\\\"tool_use\\\", id=\\\"t1\\\", name=\\\"save_fact\\\", input={\\\"fact\\\": \\\"Race in May\\\"}, text=None)], \\\"tool_use\\\", u)\\n        if \\\"plan\\\" in low:\\n            return Resp([Block(type=\\\"tool_use\\\", id=\\\"t2\\\", name=\\\"plan_week\\\", input={\\\"hours\\\": 5}, text=None)], \\\"tool_use\\\", u)\\n        return Resp([Block(type=\\\"text\\\", text=\\\"ok\\\", id=None, name=None, input=None)], \\\"end_turn\\\", u)\\n\\ndef run_conversation():\\n    records.clear()\\n    bot.reply(\\\"42\\\", \\\"Remember that I have a race in May\\\", llm=FakeLLM())\\n    bot.reply(\\\"42\\\", \\\"Great, thanks\\\", llm=FakeLLM())\\n    bot.reply(\\\"42\\\", \\\"Can you plan my week?\\\", llm=FakeLLM())\\n    return list(records)\\n\\ntry:\\n    # --- OLD behavior: single cached block (pre-fix) ---\\n    def old_build_system(a, today):\\n        text = bot.INSTRUCTIONS + \\\"\\\\n\\\\n\\\" + bot.athlete_context(a, today)\\n        return [{\\\"type\\\": \\\"text\\\", \\\"text\\\": text, \\\"cache_control\\\": {\\\"type\\\": \\\"ephemeral\\\"}}]\\n    orig = bot.build_system\\n    bot.build_system = old_build_system\\n    CACHE.clear()\\n    old = run_conversation()\\n\\n    # --- NEW behavior: two cached blocks ---\\n    bot.build_system = orig\\n    CACHE.clear()\\n    new = run_conversation()\\n\\n    labels = [\\\"msg1 r1 (save_fact)\\\", \\\"msg1 r2\\\", \\\"msg2 r1\\\", \\\"msg3 r1 (plan_week)\\\", \\\"msg3 r2\\\"]\\n    print(f\\\"{'call':<22} {'OLD created/read':>16} {'NEW created/read':>16}\\\")\\n    for lab, o, n in zip(labels, old, new):\\n        print(f\\\"{lab:<22} {o['created']:>7}/{o['read']:<8} {n['created']:>7}/{n['read']:<8}\\\")\\n\\n    static_tok = tok(bot.INSTRUCTIONS)\\n    print(f\\\"\\\\nstatic instructions block ~{static_tok} fake tokens\\\")\\n    after_save = new[1]\\n    assert after_save[\\\"read\\\"] >= static_tok, \\\"after save_fact, static block must be read from cache\\\"\\n    assert after_save[\\\"created\\\"] < old[1][\\\"created\\\"], \\\"after save_fact, new code must create less cache\\\"\\n    print(\\\"OK: after save_fact the static block stays cached; only the tail is re-created\\\")\\nfinally:\\n    with open(bot.ATHLETES_FILE, \\\"w\\\") as f:\\n        f.write(athletes_snapshot)\\nEOF\",\"cwd\":\"/private/tmp/h-Miz2Gf\"}"}}]}
