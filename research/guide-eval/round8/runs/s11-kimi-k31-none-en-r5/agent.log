{"role":"tool","tool_call_id":"tool_wuUU6pSyaAAmqjugOKdHxqvN","content":"1\t\"\"\"Story library: the publish handler.\n2\t\n3\tEach story is stored in one DynamoDB item together with the three most similar\n4\tstories already in the library (``similar``), so the reader page can show\n5\t\"related\" without a query at read time.\n6\t\"\"\"\n7\timport json\n8\timport logging\n9\timport re\n10\timport time\n11\tfrom decimal import Decimal\n12\t\n13\tlog = logging.getLogger(\"stories\")\n14\t\n15\tTABLE_NAME = \"stories\"\n16\tTOP_N = 3\n17\t\n18\t_WORD = re.compile(r\"[a-z0-9]+\")\n19\t\n20\t\n21\tdef words(text):\n22\t    return set(_WORD.findall((text or \"\").lower()))\n23\t\n24\t\n25\tdef similarity(a, b):\n26\t    \"\"\"Shared-tag ratio (Jaccard), blended with shared words of the two bodies.\"\"\"\n27\t    ta, tb = set(a.get(\"tags\", [])), set(b.get(\"tags\", []))\n28\t    tag_score = len(ta & tb) / len(ta | tb) if (ta | tb) else 0\n29\t    wa, wb = words(a.get(\"body\")), words(b.get(\"body\"))\n30\t    word_score = len(wa & wb) / len(wa | wb) if (wa | wb) else 0\n31\t    return round(0.7 * tag_score + 0.3 * word_score, 4)\n32\t\n33\t\n34\tdef related(story, existing):\n35\t    scored = []\n36\t    for other in existing:\n37\t        if other[\"slug\"] == story[\"slug\"]:\n38\t            continue\n39\t        scored.append({\"slug\": other[\"slug\"], \"score\": similarity(story, other)})\n40\t    scored.sort(key=lambda s: s[\"score\"], reverse=True)\n41\t    return scored[:TOP_N]\n42\t\n43\t\n44\tdef validate(story):\n45\t    for k in (\"slug\", \"title\", \"body\"):"}
