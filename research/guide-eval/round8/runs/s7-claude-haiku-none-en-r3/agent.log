       CONNECTIONS[uid].update(","+                        access_token=tok[\"access_token\"],","+                        refresh_token=tok.get(\"refresh_token\", c[\"refresh_token\"]),","+                        expires_at=time.time() + int(expires_in) if expires_in else None)","+                log(f\"{uid}: token refreshed\")","+            except Exception as e:","+                log(f\"{uid}: refresh failed ({e}) -> expired, reconnect\")","+                mark_expired(uid)"," "," ","+def mark_expired(uid):","+    with LOCK:","+        if uid in CONNECTIONS:","+            CONNECTIONS[uid].update(status=\"expired, reconnect\", access_token=None)","+","+"," def intervals_get(conn, path):","     req = urllib.request.Request(f\"{config.INTERVALS_BASE}/api/v1/athlete/{conn['athlete_id']}{path}\",","                                  headers={\"Authorization\": \"Bearer \" + conn[\"access_token\"]})"]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_01WQVUoBge7TAsQrxxtqkUFA","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
