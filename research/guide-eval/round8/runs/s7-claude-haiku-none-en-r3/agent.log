">Status: ${esc(st.status)}</p>` : \"\";\n      card = `<div class=\"card\">Intervals.icu is not connected.${why}\n        <p><a class=\"btn\" href=\"/api/intervals/auth/init\">Connect Intervals.icu</a></p></div>`;\n    }\n    root.className = \"\";\n    root.innerHTML = `<p>Signed in as <b>${esc(me.name)}</b>.</p>${card}`;\n    const d = document.getElementById(\"disconnect\");\n    if (d) d.onclick = async () => { await api(\"/api/intervals/disconnect\", { method: \"POST\" }); render(); };\n  } catch (e) {\n    root.innerHTML = `<p class=\"card\">Error: ${esc(e.message)}</p>`;\n  }\n}\n\nrender();\n","structuredPatch":[{"oldStart":25,"oldLines":7,"newStart":25,"newLines":7,"lines":["     } else {","       const why = st.status && st.status !== \"disconnected\" ? `<p class=\"muted\">Status: ${esc(st.status)}</p>` : \"\";","       card = `<div class=\"card\">Intervals.icu is not connected.${why}","-        <p><a class=\"btn\" href=\"/api/intervals/auth/init\">Connect Intervals.icu</a></p></div>`;","+        <p><button class=\"btn\" id=\"connect\">Connect Intervals.icu</button></p></div>`;","     }","     root.className = \"\";","     root.innerHTML = `<p>Signed in as <b>${esc(me.name)}</b>.</p>${card}`;"]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_01DhJycCUQcRQS71TuBZe8hM","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
