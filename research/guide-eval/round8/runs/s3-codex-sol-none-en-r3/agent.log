{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport os, subprocess, tempfile\nroot = Path.cwd()\nwith tempfile.TemporaryDirectory(prefix='.nightly-test-', dir=root) as td:\n    base = Path(td)\n    home = base / 'home'\n    (home / 'projects/shop').mkdir(parents=True)\n    (home / 'Library/Logs').mkdir(parents=True)\n    (home / 'bin').mkdir(parents=True)\n    mocks = base / 'mocks'\n    mocks.mkdir()\n    (mocks / 'claude').write_text('#\"'!/bin/sh'\"\\\\nprintf \\\"%s\\\\\\\\n\\\" \\\"Not logged in · Please run /login\\\" >&2\\\\nexit 1\\\\n')\n    (mocks / 'claude').chmod(0o755)\n    (home / 'bin/notify.sh').write_text('#\"'!/bin/sh'\"\\\\nprintf \\\"%s\\\\\\\\n\\\" \\\"\"'$1\" >> \"$HOME/notifications\"'\"\\\\n')\n    (home / 'bin/notify.sh').chmod(0o755)\n    env = dict(os.environ, HOME=str(home), PATH=str(mocks) + ':' + os.environ['PATH'])\n    script = root / 'bin/nightly-review.zsh'\n    failed = subprocess.run(['/bin/zsh', str(script)], env=env, capture_output=True, text=True)\n    notice = (home / 'notifications').read_text()\n    assert failed.returncode == 1, failed\n    assert 'FAILED (exit 1)' in notice, notice\n    assert 'read-only variable' not in failed.stderr, failed.stderr\n    (mocks / 'claude').write_text('#\"'!/bin/sh'\"\\\\nprintf \\\"%s\\\\\\\\n\\\" \\\"Review summary\\\"\\\\n')\n    succeeded = subprocess.run(['/bin/zsh', str(script)], env=env, capture_output=True, text=True)\n    assert succeeded.returncode == 0, succeeded\n    assert 'nightly review done: Review summary' in (home / 'notifications').read_text()\n    (mocks / 'claude').write_text('#\"'!/bin/sh'\"\\\\nexit 0\\\\n')\n    empty = subprocess.run(['/bin/zsh', str(script)], env=env, capture_output=True, text=True)\n    assert empty.returncode == 1, empty\n    assert 'produced no summary' in (home / 'notifications').read_text()\n    print('nightly-review: failure, success, and empty-output paths passed')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
