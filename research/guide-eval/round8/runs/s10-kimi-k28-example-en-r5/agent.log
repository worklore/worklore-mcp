{"role":"tool","tool_call_id":"tool_EZ6MAIAgNxKnj64qDETxuIN9","content":"1\timport 'package:flutter/material.dart';\n2\timport 'package:posthog_flutter/posthog_flutter.dart';\n3\t\n4\timport 'analytics.dart';\n5\timport 'screens/offer_screen.dart';\n6\timport 'screens/registration_screen.dart';\n7\t\n8\tFuture<void> main() async {\n9\t  WidgetsFlutterBinding.ensureInitialized();\n10\t  await Analytics.init();\n11\t  runApp(const KreditoApp());\n12\t}\n13\t\n14\tclass KreditoApp extends StatelessWidget {\n15\t  const KreditoApp({super.key});\n16\t\n17\t  @override\n18\t  Widget build(BuildContext context) {\n19\t    return PostHogWidget(\n20\t      child: MaterialApp(\n21\t        title: 'Kredito',\n22\t        theme: ThemeData(colorSchemeSeed: Colors.green, useMaterial3: true),\n23\t        navigatorObservers: [PosthogObserver()],\n24\t        routes: {\n25\t          '/': (_) => const RegistrationScreen(),\n26\t          '/offers': (_) => const OfferScreen(),\n27\t        },\n28\t      ),\n29\t    );\n30\t  }\n31\t}"}
