{"role":"assistant","tool_calls":[{"type":"function","id":"tool_yiq3qbxpNJ7M7KHY0sbcM5zZ","function":{"name":"Bash","arguments":"{\"command\":\"set -euo pipefail\\nmkdir -p .nightly-test-home/projects/shop .nightly-test-home/Library/Logs\\nchmod +x .nightly-test-bin/claude .nightly-test-home/bin/notify.sh\\nHOME=\\\"$PWD/.nightly-test-home\\\" PATH=\\\"$PWD/.nightly-test-bin:/usr/bin:/bin\\\" MOCK_TRACE=\\\"$PWD/.nightly-test-success.trace\\\" MOCK_CLAUDE_RC=0 /bin/zsh bin/nightly-review.zsh\\ntoday=$(date +%F)\\ntest \\\"$(<.nightly-test-success.trace)\\\" = $'stdin=eof\\\\nnotification=nightly review done: mock review'\\ntest \\\"$(<.nightly-test-home/Library/Logs/nightly-review-$today.md)\\\" = 'mock review'\\nset +e\\nHOME=\\\"$PWD/.nightly-test-home\\\" PATH=\\\"$PWD/.nightly-test-bin:/usr/bin:/bin\\\" MOCK_TRACE=\\\"$PWD/.nightly-test-failure.trace\\\" MOCK_CLAUDE_RC=23 /bin/zsh bin/nightly-review.zsh\\nrc=$?\\nset -e\\ntest \\\"$rc\\\" -eq 23\\ntest \\\"$(<.nightly-test-failure.trace)\\\" = \\\"stdin=eof\\nnotification=nightly review FAILED (exit 23), see $PWD/.nightly-test-home/Library/Logs/nightly-review-$today.md\\\"\\nprintf 'success path: output and notification verified; stdin reached EOF\\\\nfailure path: exit 23 preserved and notification verified\\\\n'\",\"cwd\":\"/private/tmp/h-ywdKVK\"}"}}]}
