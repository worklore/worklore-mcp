{"role":"tool","tool_call_id":"tool_o5ZXXUhE9j10lYj728xa3OiO","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"tricoach backend: sign-in, Intervals.icu OAuth connection, wellness proxy.\n3\t\n4\tStdlib only. State is in memory (same shape as the prod tables).\n5\t\"\"\"\n6\timport base64, hashlib, hmac, json, os, threading, time\n7\timport urllib.error, urllib.parse, urllib.request\n8\tfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\n9\t\n10\timport config\n11\t\n12\tSTATIC = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"static\")\n13\tTOKEN_URL = config.INTERVALS_BASE + \"/api/oauth/token\"\n14\tAUTHORIZE_URL = config.INTERVALS_BASE + \"/oauth/authorize\"\n15\t\n16\t# --- in-memory store -------------------------------------------------------\n17\tUSERS = {\n18\t    \"tok-okafor\": {\"id\": \"u_okafor\", \"name\": \"C. Okafor\"},\n19\t    \"tok-rivera\": {\"id\": \"u_rivera\", \"name\": \"T. Rivera\"},\n20\t}\n21\t# user_id -> {athlete_id, athlete_name, access_token, scope, status}\n22\tCONNECTIONS = {}\n23\tLOCK = threading.Lock()\n24\t\n25\t\n26\tdef log(msg):\n27\t    print(time.strftime(\"%Y-%m-%d %H:%M:%S\"), \"[intervals]\", msg, flush=True)\n28\t\n29\t\n30\t# --- state parameter: carries the user through the redirect -----------------\n31\tdef sign_state(user_id):\n32\t    payload = f\"{user_id}:{int(time.time())}\"\n33\t    sig = hmac.new(config.APP_SECRET.encode(), payload.encode(), hashlib.sha256).hexdigest()[:32]\n34\t    return base64.urlsafe_b64encode(f\"{payload}:{sig}\".encode()).decode()\n35\t\n36\t\n37\tdef verify_state(state, max_age=900):\n38\t    try:\n39\t        user_id, ts, sig = base64.urlsafe_b64decode(state.encode()).decode().split(\":\")\n40\t    except Exception:\n41\t        return None\n42\t    payload = f\"{user_id}:{ts}\"\n43\t    good = hmac.new(config.APP_SECRET.encode(), payload.encode(), hashlib.sha256).hexdigest()[:32]\n44\t    if not hmac.compare_digest(good, sig) or time.time() - int(ts) > max_age:\n45\t        return None\n46\t    return user_id\n47\t\n48\t\n49\t# --- Intervals.icu calls ----------------------------------------------------\n50\tdef post_form(url, fields):\n51\t    data = urllib.parse.urlencode(fields).encode()\n52\t    req = urllib.request.Request(url, data=data, headers={\"Accept\": \"application/json\"})\n53\t    with urllib.request.urlopen(req, timeout=15) as r:\n54\t        return json.loads(r.read().decode())\n55\t\n56\t\n57\tdef exchange_code(code):\n58\t    # Intervals.icu wants only these three fields: no grant_type, no redirect_uri.\n59\t    return post_form(TOKEN_URL, {\n60\t        \"client_id\": config.CLIENT_ID, \"client_secret\": config.CLIENT_SECRET, \"code\": code,\n61\t    })\n62\t\n63\t\n64\tdef store_connection(user_id, tok):\n65\t    athlete = tok.get(\"athlete\") or {}\n66\t    with LOCK:\n67\t        CONNECTIONS[user_id] = {\n68\t            \"athlete_id\": athlete.get(\"id\"), \"athlete_name\": athlete.get(\"name\"),\n69\t            \"access_token\": tok[\"access_token\"], \"scope\": tok.get(\"scope\"), \"status\": \"connected\",\n70\t        }\n71\t    log(f\"{user_id}: connected as athlete {athlete.get('id')}\")\n72\t\n73\t\n74\tdef intervals_get(conn, path):\n75\t    req = urllib.request.Request(f\"{config.INTERVALS_BASE}/api/v1/athlete/{conn['athlete_id']}{path}\",\n76\t                                 headers={\"Authorization\": \"Bearer \" + conn[\"access_token\"]})\n77\t    with urllib.request.urlopen(req, timeout=15) as r:\n78\t        return r.status, json.loads(r.read().decode())\n79\t\n80\t\n81\t# --- HTTP ---------------------------------------------------------------------\n82\tclass Handler(BaseHTTPRequestHandler):\n83\t    def log_message(self, fmt, *args):\n84\t        print(time.strftime(\"%Y-%m-%d %H:%M:%S\"), \"[http]\", fmt % args, flush=True)\n85\t\n86\t    def send_json(self, code, obj):\n87\t        body = json.dumps(obj).encode()\n88\t        self.send_response(code)\n89\t        self.send_header(\"Content-Type\", \"application/json\")\n90\t        self.send_header(\"Content-Length\", str(len(body)))\n91\t        self.end_headers()\n92\t        self.wfile.write(body)\n93\t\n94\t    def send_file(self, name, ctype):\n95\t        p = os.path.join(STATIC, name)\n96\t        if not os.path.isfile(p):\n97\t            return self.send_json(404, {\"error\": \"not found\"})\n98\t        with open(p, \"rb\") as f:\n99\t            body = f.read()\n100\t        self.send_response(200)\n101\t        self.send_header(\"Content-Type\", ctype)\n102\t        self.send_header(\"Content-Length\", str(len(body)))\n103\t        self.end_headers()\n104\t        self.wfile.write(body)\n105\t\n106\t    def redirect(self, url):\n107\t        self.send_response(302)\n108\t        self.send_header(\"Location\", url)\n109\t        self.end_headers()\n110\t\n111\t    def current_user(self):\n112\t        auth = self.headers.get(\"Authorization\", \"\")\n113\t        if not auth.startswith(\"Bearer \"):\n114\t            return None\n115\t        return USERS.get(auth[7:].strip())\n116\t\n117\t    def require_user(self):\n118\t        user = self.current_user()\n119\t        if user is None:\n120\t            self.log_message(\"%s %s 401 (no Authorization header)\", self.command, self.path)\n121\t            self.send_json(401, {\"error\": \"unauthorized\"})\n122\t        return user\n123\t\n124\t    def do_GET(self):\n125\t        url = urllib.parse.urlsplit(self.path)\n126\t        q = dict(urllib.parse.parse_qsl(url.query))\n127\t        if url.path == \"/\":\n128\t            return self.send_file(\"index.html\", \"text/html; charset=utf-8\")\n129\t        if url.path.startswith(\"/static/\"):\n130\t            return self.send_file(os.path.basename(url.path), \"application/javascript\" if url.path.endswith(\".js\") else \"text/plain\")\n131\t        if url.path == \"/api/me\":\n132\t            user = self.require_user()\n133\t            return user and self.send_json(200, user)\n134\t        if url.path == \"/api/intervals/callback\":\n135\t            return self.callback(q)\n136\t        if url.path == \"/api/intervals/status\":\n137\t            return self.status()\n138\t        if url.path == \"/api/intervals/wellness\":\n139\t            return self.wellness()\n140\t        self.send_json(404, {\"error\": \"not found\"})\n141\t\n142\t    def do_POST(self):\n143\t        url = urllib.parse.urlsplit(self.path)\n144\t        if url.path == \"/api/intervals/auth/init\":\n145\t            return self.auth_init()\n146\t        if url.path == \"/api/intervals/disconnect\":\n147\t            user = self.require_user()\n148\t            if user:\n149\t                with LOCK:\n150\t                    CONNECTIONS.pop(user[\"id\"], None)\n151\t                self.send_json(200, {\"ok\": True})\n152\t            return\n153\t        self.send_json(404, {\"error\": \"not found\"})\n154\t\n155\t    # Step 1: build the authorize URL and hand it to the SPA, which navigates\n156\t    # the browser there. Must be a POST: only fetch/XHR carries the auth\n157\t    # header, a plain link navigation would arrive here unauthenticated.\n158\t    def auth_init(self):\n159\t        user = self.require_user()\n160\t        if not user:\n161\t            return\n162\t        params = {\"client_id\": config.CLIENT_ID, \"redirect_uri\": config.REDIRECT_URI,\n163\t                  \"scope\": config.SCOPES, \"state\": sign_state(user[\"id\"])}\n164\t        self.send_json(200, {\"authorize_url\": AUTHORIZE_URL + \"?\" + urllib.parse.urlencode(params, safe=\":,\")})\n165\t\n166\t    # Step 2: Intervals redirects back here with ?code=&state=.\n167\t    def callback(self, q):\n168\t        user_id = verify_state(q.get(\"state\", \"\"))\n169\t        if not user_id or not q.get(\"code\"):\n170\t            return self.send_json(400, {\"error\": \"bad state or code\"})\n171\t        try:\n172\t            tok = exchange_code(q[\"code\"])\n173\t            sto