hod, headers=headers)\\n    try:\\n        with urllib.request.urlopen(req, timeout=10) as r:\\n            return r.status, dict(r.headers), r.read().decode()\\n    except urllib.error.HTTPError as e:\\n        return e.code, dict(e.headers), e.read().decode()\\n\\n\\nclass Stub(BaseHTTPRequestHandler):\\n    def log_message(self, *a):\\n        pass\\n\\n    def _json(self, code, obj):\\n        body = json.dumps(obj).encode()\\n        self.send_response(code)\\n        self.send_header(\\\"Content-Type\\\", \\\"application/json\\\")\\n        self.send_header(\\\"Content-Length\\\", str(len(body)))\\n        self.end_headers()\\n        self.wfile.write(body)\\n\\n    def do_GET(self):\\n        url = urllib.parse.urlsplit(self.path)\\n        if url.path == \\\"/oauth/authorize\\\":\\n            q = dict(urllib.parse.parse_qsl(url.query))\\n            areas = [s.split(\\\":\\\")[0] for s in q.get(\\\"scope\\\", \\\"\\\").split(\\\",\\\") if s]\\n            if len(areas) != len(set(areas)):\\n                return self._json(400, {\\\"error\\\": \\\"Duplicate scope\\\"})\\n            loc = f\\\"{q['redirect_uri']}?code=code-okafor&state={urllib.parse.quote(q['state'])}\\\"\\n            self.send_response(302)\\n            self.send_header(\\\"Location\\\", loc)\\n            self.end_headers()\\n            return\\n        if url.path.startswith(\\\"/api/v1/athlete/\\\"):\\n            auth = self.headers.get(\\\"Authorization\\\", \\\"\\\")\\n            if auth == \\\"Bearer tok-revoked\\\":\\n                return self._json(401, {\\\"error\\\": \\\"invalid_token\\\"})\\n            if auth.startswith(\\\"Bearer at-\\\"):\\n                return self._json(200, [{\\\"day\\\": \\\"2026-11-07\\\", \\\"weight\\\": 70.1}])\\n            return self._json(401, {\\\"error\\\": \\\"missing token\\\"})\\n        self._json(404, {\\\"error\\\": \\\"not found\\\"})\\n\\n    def do_POST(self):\\n        if self.path == \\\"/api/oauth/token\\\":\\n            f