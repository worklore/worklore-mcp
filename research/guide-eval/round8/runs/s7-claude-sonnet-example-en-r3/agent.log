xpires_at\"] - now > 300','c[\"status\"] != \"connected\" or c[\"expires_at\"] is None or c[\"expires_at\"] - now > 300')\ns=s.replace('DEFAULT_TOKEN_TTL = 3600   # seconds; used when the provider does not say how long a token lives\\n','')\ns=s.replace('''        if url.path == \"/api/intervals/auth/init\":\n            return self.auth_init()\n''','')\ns=s.replace('''    def do_POST(self):\n        url = urllib.parse.urlsplit(self.path)\n''','''    def do_POST(self):\n        url = urllib.parse.urlsplit(self.path)\n        if url.path == \"/api/intervals/auth/init\":\n            return self.auth_init()\n''')\ns=s.replace('''        self.redirect(AUTHORIZE_URL + \"?\" + urllib.parse.urlencode(params, safe=\":,\"))''','''        # Returned as JSON: a full-page navigation would not carry the Authorization header.\n        self.send_json(200, {\"authorize_url\": AUTHORIZE_URL + \"?\" + urllib.parse.urlencode(params, safe=\":,\")})''')\ns=s.replace('''            self.send_json(e.code, {\"error\": f\"intervals returned {e.code}\"})''','''            if e.code == 401:  # revoked by the athlete: token is dead, ask to reconnect\n                with LOCK:\n                    c.update(status=\"expired, reconnect\", access_token=None)\n                log(f\"{user['id']}: Intervals returned 401 -> reconnect\")\n            self.send_json(e.code, {\"error\": f\"intervals returned {e.code}\"})''')\nopen('server.py','w').write(s)\na=open('static/app.js').read()\na=a.replace('<a class=\"btn\" href=\"/api/intervals/auth/init\">Connect Intervals.icu</a>','<button class=\"btn\" id=\"connect\">Connect Intervals.icu</button>')\na=a.replace('    const d = document.getElementById(\"disconnect\");','''    const cb = document.getElementById(\"connect\");\n    if (cb) cb.onclick = async () => {\n      try {\n        const r = await api(\"/api/intervals/auth/init\", { method: \"POST\" });\n        window.location.assign(r.authorize_url);\n      } catch (e) { root.innerHTML = `<p class=\"card\">Error: ${esc(e.message)}</p>`; }\n    };\n    const d = document.getElementById(\"disconnect\");''')\nopen('static/app.js','w').write(a)\nE\npython3 -I -m py_compile server.py && git diff --stat\ncat > ANSWER.md <<'E'\n# Causes and fixes\n\n1. **Connect button 401s for everyone.** It was a plain `<a href>` to `GET /api/intervals/auth/init`. A page navigation doesn't send the `Authorization: Bearer` header the SPA keeps in localStorage, so the server returned `{\"error\":\"unauthorized\"}`. Fix: init is now an authenticated `POST` returning `{authorize_url}`. The button uses `api()` (fetch with the header) and then calls `window.location.assign(...)` (`server.py`, `static/app.js`).\n2. **Authorize URL rejected with 400 `invalid_request` (since the 2026-10-02 calendar sync).** The scope was `ACTIVITY:READ,ACTIVITY:WRITE,...,CALENDAR:READ,CALENDAR:WRITE`. Intervals rejects naming an area twice because `:WRITE` implies `:READ` (\"Duplicate scope\"). Fix: `ACTIVITY:WRITE,WELLNESS:READ,CALENDAR:WRITE` (`config.py`). This is inferred from the logs and the note. I couldn't test it against the real Intervals.\n3. **Connection \"expired\" after an hour.** Intervals tokens have no `refresh_token` or `expires_in` and last until revoked. The code invented a 3600s TTL (`DEFAULT_TOKEN_TTL`), and the refresher then marked the token expired and wiped it. Fix: no expiry when the provider gives none (`expires_at=None`, and the refresher skips those). Revocation is now handled lazily: a 401 from Intervals marks the connection \"expired, reconnect\".\n4. **Token exchange sent extra fields** (`grant_type`, `redirect_uri`). It now sends only `client_id`, `client_secret` and `code`, per the note. I couldn't verify this against the real service.\n\n## Colleague's note: what applied\n- Applied: points 1 (no refresh/expiry, lazy 401 handling), 2 (Duplicate scope), 3 (minimal exchange; the `athlete` object in the response was already used), 4 (POST init). I also added the account-mismatch guard on reconnect.\n- Not applied: switching `state` to a JWT with a `purpose` claim (the existing HMAC-signed state with a 15-minute TTL already does the job), and encryption at rest (the store here is in memory; do it when moving to Postgres).\n\nNot tested against a live Intervals.icu account. I only syntax-checked the code.\nE"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5381,"cache_read_input_tokens":24325,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5381},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d0f97d04-2530-4584-b74d-7292894fa142","uuid":"ff8fc578-8c1e-4ee6-89ae-0c845f184a78","timestamp":"2026-10-27T03:08:10.874Z","request_id":"req_011CgS1F284D133ArZ1JNL99","wire_tool_inputs":{"toolu_017WUeLYnJEZS6RMfAn1J9MX":{"command":"cd /tmp/h-YizG8E; python3 - <<'E'\nimport re\nc=open('config.py').read()\nc=c.replace('SCOPES = \"ACTIVITY:READ,ACTIVITY:WRITE,WELLNESS:READ,CALENDAR:READ,CALENDAR:WRITE\"','# each area at most once; :WRITE implies :READ (duplicates -> \"Duplicate scope\"/invalid_request)\\nSCOPES = \"ACTIVITY:WRITE,WELLNESS:READ,CALENDAR:WRITE\"')\nopen('config.py','w').write(c)\ns=open('server.py').read()\ns=s.replace('''        \"grant_type\": \"authorization_code\", \"client_id\": config.CLIENT_ID,\n        \"client_secret\": config.CLIENT_SECRET, \"code\": code, \"redirect_uri\": config.REDIRECT_URI,\n    })''','''        \"client_id\": config.CLIENT_ID, \"client_secret\": config.CLIENT_SECRET, \"code\": code,\n    })''')\ns=s.replace('''    expires_in = int(tok.get(\"expires_in\") or DEFAULT_TOKEN_TTL)\n    refresh = tok.get(\"refresh_token\")\n    if not refresh:\n        log(f\"{user_id}: no refresh_token in response, scheduling expiry in {expires_in}s\")\n    athlete = tok.get(\"athlete\") or {}\n    with LOCK:\n''','''    # Intervals tokens never expire and have no refresh_token; they live until revoked.\n    expires_in = int(tok[\"expires_in\"]) if tok.get(\"expires_in\") else None\n    refresh = tok.get(\"refresh_token\")\n    athlete = tok.get(\"athlete\") or {}\n    with LOCK:\n        old = CONNECTIONS.get(user_id)\n        if old and old.get(\"athlete_id\") and old[\"athlete_id\"] != athlete.get(\"id\"):\n            raise ValueError(\"athlete mismatch on reconnect\")\n''')\ns=s.replace('\"expires_at\": time.time() + expires_in,','\"expires_at\": time.time() + expires_in if expires_in else None,')\ns=s.replace('(expires in {expires_in}s)\")','(expires in {expires_in or \"never\"})\")')\ns=s.replace('c[\"status\"] != \"connected\" or c[\"expires_at\"] - now > 300','c[\"status\"] != \"connected\" or c[\"expires_at\"] is None or c[\"expires_at\"] - now > 300')\ns=s.replace('DEFAULT_TOKEN_TTL = 3600   # seconds; used when the provider does not say how long a token lives\\n','')\ns=s.replace('''        if url.path == \"/api/intervals/auth/init\":\n            return self.auth_init()\n''','')\ns=s.replace('''    def do_POST(self):\n        url = urllib.parse.urlsplit(self.path)\n''','''    def do_POST(self):\n        url = urllib.parse.urlsplit(self.path)\n        if url.path == \"/api/intervals/auth/init\":\n            return self.auth_init()\n''')\ns=s.replace('''        self.redirect(AUTHORIZE_URL + \"?\" + urllib.parse.urlencode(params, safe=\":,\"))''','''        # Returned as JSON: a full-page navigation would not carry the Authorization header.\n        self.send_json(200, {\"authorize_url\": AUTHORIZE_URL + \"?\" + urllib.parse.urlencode(params, safe=\":,\")})''')\ns=s.replace('''            self.send_json(e.code, {\"error\": f\"intervals returned {e.code}\"})''','''            if e.code == 401:  # revoked by the athlete: token is dead, ask to reconnect\n                with LOCK:\n        