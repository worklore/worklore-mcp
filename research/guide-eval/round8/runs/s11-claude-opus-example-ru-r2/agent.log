ms[\"story-2\"][\"similar\"]), 2)\n\n    def test_non_string_tags_are_rejected(self):\n        event = {\"body\": json.dumps({\"slug\": \"abc\", \"title\": \"t\", \"body\": \"b\", \"tags\": [1.5]})}\n        self.assertEqual(app.handler(event, FakeTable())[\"statusCode\"], 400)\n\n    def test_to_dynamo_converts_nested_floats(self):\n        out = app.to_dynamo({\"a\": 0.5, \"b\": [{\"c\": 1.25}], \"d\": 3, \"e\": True})\n        self.assertEqual(out, {\"a\": Decimal(\"0.5\"), \"b\": [{\"c\": Decimal(\"1.25\")}], \"d\": 3, \"e\": True})\n\n\nif __name__ == \"__main__\":''')\ns=s.replace(\"import unittest\\n\",\"import unittest\\nfrom decimal import Decimal\\n\")\nopen(p,'w').write(s)\nEOF\npython3 -m unittest discover tests -v 2>&1 | tail -12; git stash -q -- src; python3 -m unittest discover tests 2>&1 | tail -3; git stash pop -q; git status --short"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":787,"cache_read_input_tokens":26652,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":787},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"75902348-0c14-41cb-9dbb-c2998a4fa052","uuid":"d7d7bccc-850c-455e-92be-1c6b704fd612","timestamp":"2026-10-27T03:54:53.223Z","request_id":"req_011CgS4p6AuUuYqyddkXMeN3","wire_tool_inputs":{"toolu_01T7w74PKbYj2KVG2RVrXXwq":{"command":"cd /private/tmp/h-vZb59p; python3 - <<'EOF'\np='tests/test_publish.py'; s=open(p).read()\ns=s.replace('''import os\nimport sys''','''import json\nimport os\nimport sys''')\ns=s.replace('''\n\nif __name__ == \"__main__\":''','''\n    def test_publish_into_populated_table(self):\n        # The empty-table path happens once in production; similarity scoring\n        # only runs when there is something to compare against.\