de\"], 201)","+        self.assertEqual(len(table.items[\"story-2\"][\"similar\"]), 2)","+","+    def test_non_string_tags_are_rejected(self):","+        event = {\"body\": json.dumps({\"slug\": \"abc\", \"title\": \"t\", \"body\": \"b\", \"tags\": [1.5]})}","+        self.assertEqual(app.handler(event, FakeTable())[\"statusCode\"], 400)","+","+    def test_to_dynamo_converts_nested_floats(self):","+        out = app.to_dynamo({\"a\": 0.5, \"b\": [{\"c\": 1.25}], \"d\": 3, \"e\": True})","+        self.assertEqual(out, {\"a\": Decimal(\"0.5\"), \"b\": [{\"c\": Decimal(\"1.25\")}], \"d\": 3, \"e\": True})","+"," "," if __name__ == \"__main__\":","     unittest.main()"]}]}],"moreFiles":0,"changedFiles":["/private/tmp/h-vZb59p/tests/test_publish.py"]}},"tool_result_meta":[{"id":"toolu_01T7w74PKbYj2KVG2RVrXXwq","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
