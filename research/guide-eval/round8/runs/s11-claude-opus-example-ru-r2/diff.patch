+
+def to_dynamo(value):
+    """Make ``value`` storable by boto3: floats become Decimal, recursively.
+
+    The last line of defence for any computed number (scores, averages, ratios)
+    that reaches ``put_item``; boto3 raises TypeError on float.
+    """
+    if isinstance(value, float):
+        return Decimal(str(value))
+    if isinstance(value, dict):
+        return {k: to_dynamo(v) for k, v in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [to_dynamo(v) for v in value]
+    return value
 
 
