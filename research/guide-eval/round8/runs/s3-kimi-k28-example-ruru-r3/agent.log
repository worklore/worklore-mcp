{"role":"tool","tool_call_id":"tool_oB1i8BCSUWCNU3FdRNomYIKr","content":"exit=1\n--- notifications:\nnightly review done: FAKE SUMMARY\nnightly review: repo missing\ndiff --git a/Library/LaunchAgents/com.vk.nightly-review.plist b/Library/LaunchAgents/com.vk.nightly-review.plist\nindex c347363..ade4f34 100644\n--- a/Library/LaunchAgents/com.vk.nightly-review.plist\n+++ b/Library/LaunchAgents/com.vk.nightly-review.plist\n@@ -24,6 +24,10 @@\n   <dict>\n     <key>PATH</key>\n     <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>\n+    <key>HOME</key>\n+    <string>/Users/vk</string>\n+    <key>USER</key>\n+    <string>vk</string>\n   </dict>\n </dict>\n </plist>\ndiff --git a/bin/nightly-review.zsh b/bin/nightly-review.zsh\nindex e0b986f..ffa6e19 100755\n--- a/bin/nightly-review.zsh\n+++ b/bin/nightly-review.zsh\n@@ -13,14 +13,17 @@ For each commit: one line on what it changes and whether anything looks risky\n End with a three-line summary I can read on my phone.\n Do not modify any file.\"\n \n+started=$(date +%s)\n+\n cd \"$REPO\" || { \"$NOTIFY\" \"nightly review: repo missing\"; exit 1; }\n \n-claude -p \"$PROMPT\" --output-format text > \"$OUT\"\n-status=$?\n+print -r -- \"$PROMPT\" | claude -p --output-format text > \"$OUT\"\n+rc=$?\n \n-if [ $status -ne 0 ]; then\n-  \"$NOTIFY\" \"nightly review FAILED (exit $status), see $OUT\"\n-  exit $status\n+if [ $rc -ne 0 ]; then\n+  \"$NOTIFY\" \"nightly review FAILED (exit $rc), see $OUT\"\n+  exit $rc\n fi\n \n \"$NOTIFY\" \"nightly review done: $(head -c 300 \"$OUT\")\"\n+print -r -- \"run took $(( $(date +%s) - started ))s\"\n"}
