.pumpAndSettle();\n    debugPrint('EVENTS:\\n${events().join('\\n')}');\n    final evs = events();\n    expect(evs.where((e) => e.startsWith('registration_email_started')).length, 1);\n    expect(evs.where((e) => e.startsWith('registration_phone_started')).length, 1);\n    expect(evs.where((e) => e.startsWith('terms_accepted')).length, 2);\n    expect(evs.any((e) => e.startsWith('loan_amount_changed')), isTrue);\n    expect(evs.any((e) => e.startsWith('registration_continue_tapped')), isTrue);\n    expect(evs.any((e) => e.startsWith('offers_scrolled')), isTrue);\n  });\n}\nEOF\nflutter test test/events_tmp_test.dart 2>&1 | tail -40; echo \"exit=${PIPESTATUS[0]}\"","description":"Run temporary widget test capturing analytics calls"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1898,"cache_read_input_tokens":33763,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1898},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9b66a26d-8da3-466f-90fb-242d7701811d","uuid":"3a957a94-aa46-49ba-962a-d1d1f38a09d6","timestamp":"2026-10-27T04:56:17.879Z","request_id":"req_011CgS9VxLw5PF5mq5dvFpEd","wire_tool_inputs":{"toolu_017jjzXc7gxC3VVRFMWCVoAu":{"command":"cd /private/tmp/h-mZIvQL && export PATH=\"$HOME/development/flutter/bin:$PATH\" && mkdir -p test && cat > test/events_tmp_test.dart <<'EOF'\nimport 'package:flutter/foundation.dart';\nimport 'package:flutter/material.dart';\nimport 'package:flutter/services.dart';\nimport 'package:flutter_test/flutter_test.dart';\nimport 'package:kredito/screens/offer_screen.dart';\nimport 'package:kredito/screens/registration_screen.dart';\n\nvoid main() {\n  final calls = <MethodCall>[];\n  setUp(() {\n    calls.clear();\n    TestDefaultBinaryMessenger