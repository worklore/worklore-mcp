{"role":"tool","tool_call_id":"tool_Wutdq3G9jAqVw4pLR0uttb7l","content":"diff --git a/src/app.py b/src/app.py\nindex db49c5e..3614fff 100644\n--- a/src/app.py\n+++ b/src/app.py\n@@ -22,12 +22,12 @@ def words(text):\n \n \n def similarity(a, b):\n-    \"\"\"Shared-tag ratio (Jaccard), blended with shared words of the two bodies.\"\"\"\n+    \"\"\"Shared-tag percentage (Jaccard), blended with shared words of the two bodies.\"\"\"\n     ta, tb = set(a.get(\"tags\", [])), set(b.get(\"tags\", []))\n     tag_score = len(ta & tb) / len(ta | tb) if (ta | tb) else 0\n     wa, wb = words(a.get(\"body\")), words(b.get(\"body\"))\n     word_score = len(wa & wb) / len(wa | wb) if (wa | wb) else 0\n-    return round(0.7 * tag_score + 0.3 * word_score, 4)\n+    return int(round(100 * (0.7 * tag_score + 0.3 * word_score)))\n \n \n def related(story, existing):\ndiff --git a/tests/test_publish.py b/tests/test_publish.py\nindex 6c9ac44..0a3028f 100644\n--- a/tests/test_publish.py\n+++ b/tests/test_publish.py\n@@ -23,6 +23,28 @@ class PublishTest(unittest.TestCase):\n         self.assertEqual(table.get_item(Key={\"slug\": \"why-my-cron-ran-twice\"})[\"Item\"][\"title\"], \"Why my cron ran twice\")\n         self.assertEqual(table.scan()[\"Count\"], 1)\n \n+    def test_publish_with_existing_story_stores_integer_similarity_scores(self):\n+        table = FakeTable()\n+        first = {\n+            \"slug\": \"first-story\",\n+            \"title\": \"First story\",\n+            \"tags\": [\"cron\", \"linux\"],\n+            \"body\": \"Two crontabs had the same line.\",\n+        }\n+        second = {\n+            \"slug\": \"second-story\",\n+            \"title\": \"Second story\",\n+            \"tags\": [\"cron\", \"linux\"],\n+            \"body\": \"Two crontabs had the same line.\",\n+        }\n+        app.publish(table, first)\n+\n+        stored = app.publish(table, second)\n+\n+        self.assertEqual(stored[\"similar\"], [{\"slug\": \"first-story\", \"score\": 100}])\n+        self.assertIsInstance(stored[\"similar\"][0][\"score\"], int)\n+        self.assertEqual(table.scan()[\"Count\"], 2)\n+\n \n if __name__ == \"__main__\":\n     unittest.main()\n"}
