{"role":"tool","tool_call_id":"tool_uIKeVFpCiso4gleMC6ms6Aa3","content":"1\t#!/usr/bin/env bash\n2\t# usage: ./push.sh event.json   (needs INTERVALS_API_KEY and ATHLETE_ID)\n3\tset -eu\n4\tcurl -sS -u \"API_KEY:${INTERVALS_API_KEY}\" -H 'Content-Type: application/json' \\\n5\t  -X POST \"https://intervals.icu/api/v1/athlete/${ATHLETE_ID}/events\" \\\n6\t  --data-binary @\"$1\""}
