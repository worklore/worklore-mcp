{"role":"tool","tool_call_id":"tool_GH9dVz19I9V1TcvlzJOogsfl","content":"1\t\"\"\"In-memory stand-in for a boto3 DynamoDB Table resource.\n2\t\n3\tIt stores items in a dict and validates values the way boto3's TypeSerializer\n4\tdoes, so a test fails on the same inputs a real table would reject.\n5\t\"\"\"\n6\tfrom decimal import Decimal\n7\t\n8\t\n9\tdef _check(value, path=\"Item\"):\n10\t    if isinstance(value, bool) or value is None or isinstance(value, (int, str, bytes, Decimal)):\n11\t        return\n12\t    if isinstance(value, float):\n13\t        raise TypeError(\"Float types are not supported. Use Decimal types instead.\")\n14\t    if isinstance(value, dict):\n15\t        for k, v in value.items():\n16\t            _check(v, f\"{path}.{k}\")\n17\t        return\n18\t    if isinstance(value, (list, tuple, set, frozenset)):\n19\t        for i, v in enumerate(value):\n20\t            _check(v, f\"{path}[{i}]\")\n21\t        return\n22\t    raise TypeError(f\"Unsupported type {type(value)!r} for value at {path}\")\n23\t\n24\t\n25\tclass FakeTable:\n26\t    def __init__(self, key=\"slug\"):\n27\t        self.key = key\n28\t        self.items = {}\n29\t\n30\t    def put_item(self, Item, **kwargs):\n31\t        _check(Item)\n32\t        if self.key not in Item:\n33\t            raise ValueError(f\"item is missing the key attribute {self.key!r}\")\n34\t        self.items[Item[self.key]] = dict(Item)\n35\t        return {\"ResponseMetadata\": {\"HTTPStatusCode\": 200}}\n36\t\n37\t    def get_item(self, Key, **kwargs):\n38\t        item = self.items.get(Key[self.key])\n39\t        return {\"Item\": dict(item)} if item is not None else {}\n40\t\n41\t    def scan(self, **kwargs):\n42\t        return {\"Items\": [dict(v) for v in self.items.values()], \"Count\": len(self.items)}"}
{"role":"tool","tool_call_id":"tool_t7YkK28gvkZFR34UnJKpcB6H","content":"1\t\"\"\"Story library: the publish handler.\n2\t\n3\tEach story is stored in one DynamoDB item together with the three most similar\n4\tstories already in the library (``similar``), so the reader page can show\n5\t\"related\" without a query at read time.\n6\t\"\"\"\n7\timport json\n8\timport logging\n9\timport re\n10\timport time\n11\t\n12\tlog = logging.getLogger(\"stories\")\n13\t\n14\tTABLE_NAME = \"stories\"\n15\tTOP_N = 3\n16\t\n17\t_WORD = re.compile(r\"[a-z0-9]+\")\n18\t\n19\t\n20\tdef words(text):\n21\t    return set(_WORD.findall((text or \"\").lower()))\n22\t\n23\t\n24\tdef similarity(a, b):\n25\t    \"\"\"Shared-tag ratio (Jaccard), blended with shared words of the two bodies.\"\"\"\n26\t    ta, tb = set(a.get(\"tags\", [])), set(b.get(\"tags\", []))\n27\t    tag_score = len(ta & tb) / len(ta | tb) if (ta | tb) else 0\n28\t    wa, wb = words(a.get(\"body\")), words(b.get(\"body\"))\n29\t    word_score = len(wa & wb) / len(wa | wb) if (wa | wb) else 0\n30\t    return round(0.7 * tag_score + 0.3 * word_score, 4)\n31\t\n32\t\n33\tdef related(story, existing):\n34\t    scored = []\n35\t    for other in existing:\n36\t        if other[\"slug\"] == story[\"slug\"]:\n37\t            continue\n38\t        scored.append({\"slug\": other[\"slug\"], \"score\": similarity(story, other)})\n39\t    scored.sort(key=lambda s: s[\"score\"], reverse=True)\n40\t    return scored[:TOP_N]\n41\t\n42\t\n43\tdef validate(story):\n44\t    for k in (\"slug\", \"title\", \"body\"):\n45\t        if not story.get(k):\n46\t            raise ValueError(f\"missing field: {k}\")\n47\t    if not re.fullmatch(r\"[a-z0-9-]{3,80}\", story[\"slug\"]):\n48\t        raise ValueError(\"bad slug\")\n49\t\n50\t\n51\tdef publish(table, story):\n52\t    \"\"\"Store ``story`` with its related stories. Returns the stored item.\"\"\"\n53\t    validate(story)\n54\t    existing = table.scan(TableName=TABLE_NAME).get(\"Items\", [])\n55\t    item = {\n56\t        \"slug\": story[\"slug\"],\n57\t        \"title\": story[\"title\"],\n58\t        \"tags\": sorted(set(story.get(\"tags\", []))),\n59\t        \"body\": story[\"body\"],\n60\t        \"published_at\": int(time.time()),\n61\t        \"similar\": related(story, existing),\n62\t    }\n63\t    table.put_item(Item=item)\n64\t    log.info(\"publish slug=%s similar=%d stored\", item[\"slug\"], len(item[\"similar\"]))\n65\t    return item\n66\t\n67\t\n68\tdef handler(event, table):\n69\t    \"\"\"Lambda-style entry point for POST /stories. Body is the story as JSON.\"\"\"\n70\t    try:\n71\t        story = json.loads(event.get(\"body\") or \"{}\")\n72\t        stored = publish(table, story)\n73\t        return {\"statusCode\": 201, \"body\": json.dumps({\"slug\": stored[\"slug\"]})}\n74\t    except ValueError as e:\n75\t        return {\"statusCode\": 400, \"body\": json.dumps({\"error\": str(e)})}\n76\t    except Exception:\n77\t        log.exception(\"publish failed\")\n78\t        return {\"statusCode\": 500, \"body\": json.dumps({\"error\": \"Internal Server Error\"})}"}
