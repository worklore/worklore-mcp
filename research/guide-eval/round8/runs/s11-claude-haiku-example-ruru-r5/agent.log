{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YP8i6UfEvAKo8hd4VFqF49","type":"tool_result","content":"1\t\"\"\"Story library: the publish handler.\n2\t\n3\tEach story is stored in one DynamoDB item together with the three most similar\n4\tstories already in the library (``similar``), so the reader page can show\n5\t\"related\" without a query at read time.\n6\t\"\"\"\n7\timport json\n8\timport logging\n9\timport re\n10\timport time\n11\t\n12\tlog = logging.getLogger(\"stories\")\n13\t\n14\tTABLE_NAME = \"stories\"\n15\tTOP_N = 3\n16\t\n17\t_WORD = re.compile(r\"[a-z0-9]+\")\n18\t\n19\t\n20\tdef words(text):\n21\t    return set(_WORD.findall((text or \"\").lower()))\n22\t\n23\t\n24\tdef similarity(a, b):\n25\t    \"\"\"Shared-tag ratio (Jaccard), blended with shared words of the two bodies.\"\"\"\n26\t    ta, tb = set(a.get(\"tags\", [])), set(b.get(\"tags\", []))\n27\t    tag_score = len(ta & tb) / len(ta | tb) if (ta | tb) else 0\n28\t    wa, wb = words(a.get(\"body\")), words(b.get(\"body\"))\n29\t    word_score = len(wa & wb) / len(wa | wb) if (wa | wb) else 0\n30\t    return round(0.7 * tag_score + 0.3 * word_score, 4)\n31\t\n32\t\n33\tdef related(story, existing):\n34\t    scored = []\n35\t    for other in existing:\n36\t        if other[\"slug\"] == story[\"slug\"]:\n37\t            continue\n38\t        scored.append({\"slug\": other[\"slug\"], \"score\": similarity(story, other)})\n39\t    scored.sort(key=lambda s: s[\"score\"], reverse=True)\n40\t    return scored[:TOP_N]\n41\t\n42\t\n43\tdef validate(story):\n44\t    for k in (\"slug\", \"title\", \"body\"):\n45\t        if not story.get(k):\n46\t            raise ValueError(f\"missing field: {k}\")\n47\t    if not re.fullmatch(r\"[a-z0-9-]{3,80}\", story[\"slug\"]):\n48\t        raise ValueError(\"bad slug\")\n49\t\n50\t\n51\tdef publish(table, story):\n52\t    \"\"\"Store ``story`` with its related stories. Returns the stored item.\"\"\"\n53\t    validate(story)\n54\t    existing = table.scan(TableName=TABLE_NAME).get(\"Items\", [])\n55\t    item = {\n56\t        \"slug\": story[\"slug\"],\n57\t        \"title\": story[\"title\"],\n58\t        \"tags\": sorted(set(story.get(\"tags\", []))),\n59\t        \"body\": story[\"body\"],\n60\t        \"published_at\": int(time.time()),\n61\t        \"similar\": related(story, existing),\n62\t    }\n63\t    table.put_item(Item=item)\n64\t    log.info(\"publish slug=%s similar=%d stored\", item[\"slug\"], len(item[\"similar\"]))\n65\t    return item\n66\t\n67\t\n68\tdef handler(event, table):\n69\t    \"\"\"Lambda-style entry point for POST /stories. Body is the story as JSON.\"\"\"\n70\t    try:\n71\t        story = json.loads(event.get(\"body\") or \"{}\")\n72\t        stored = publish(table, story)\n73\t        return {\"statusCode\": 201, \"body\": json.dumps({\"slug\": stored[\"slug\"]})}\n74\t    except ValueError as e:\n75\t        return {\"statusCode\": 400, \"body\": json.dumps({\"error\": str(e)})}\n76\t    except Exception:\n77\t        log.exception(\"publish failed\")\n78\t        return {\"statusCode\": 500, \"body\": json.dumps({\"error\": \"Internal Server Error\"})}\n79\t"}]},"parent_tool_use_id":null,"session_id":"10d16950-6b20-49bd-b9cc-7168b34567c4","uuid":"5fc262f3-a32e-489f-8e0f-f530b75db75a","timestamp":"2026-10-27T05:01:35.993Z","tool_use_result":{"type":"text","file":{"filePath":"/private/tmp/h-BxqV6a/src/app.py","content":"\"\"\"Story library: the publish handler.\n\nEach story is stored in one DynamoDB item together with the three most similar\nstories already in the library (``similar``), so the reader page can show\n\"related\" without a query at read time.\n\"\"\"\nimport json\nimport logging\nimport re\nimport time\n\nlog = logging.getLogger(\"stories\")\n\nTABLE_NAME = \"stories\"\nTOP_N = 3\n\n_WORD = re.compile(r\"[a-z0-9]+\")\n\n\ndef words(text):\n    return set(_WORD.findall((text or \"\").lower()))\n\n\ndef similarity(a, b):\n    \"\"\"Shared-tag ratio (Jaccard), blended with shared words of the two bodies.\"\"\"\n    ta, tb = set(a.get(\"tags\", [])), set(b.get(\"tags\", []))\n    tag_score = len(ta & tb) / len(ta | tb) if (ta | tb) else 0\n    wa, wb = words(a.get(\"body\")), words(b.get(\"body\"))\n    word_score = len(wa & wb) / len(wa | wb) if (wa | wb) else 0\n    return round(0.7 * tag_score + 0.3 * word_score, 4)\n\n\ndef related(story, existing):\n    scored = []\n    for other in existing:\n        if other[\"slug\"] == story[\"slug\"]:\n            continue\n        scored.append({\"slug\": other[\"slug\"], \"score\": similarity(story, other)})\n    scored.sort(key=lambda s: s[\"score\"], reverse=True)\n    return scored[:TOP_N]\n\n\ndef validate(story):\n    for k in (\"slug\", \"title\", \"body\"):\n        if not story.get(k):\n            raise ValueError(f\"missing field: {k}\")\n    if not re.fullmatch(r\"[a-z0-9-]{3,80}\", story[\"slug\"]):\n        raise ValueError(\"bad slug\")\n\n\ndef publish(table, story):\n    \"\"\"Store ``story`` with its related stories. Returns the stored item.\"\"\"\n    validate(story)\n    existing = table.scan(TableName=TABLE_NAME).get(\"Items\", [])\n    item = {\n        \"slug\": story[\"slug\"],\n        \"title\": story[\"title\"],\n        \"tags\": sorted(set(story.get(\"tags\", []))),\n        \"body\": story[\"body\"],\n        \"published_at\": int(time.time()),\n        \"similar\": related(story, existing),\n    }\n    table.put_item(Item=item)\n    log.info(\"publish slug=%s similar=%d stored\", item[\"slug\"], len(item[\"similar\"]))\n    return item\n\n\ndef handler(event, table):\n    \"\"\"Lambda-style entry point for POST /stories. Body is the story as JSON.\"\"\"\n    try:\n        story = json.loads(event.get(\"body\") or \"{}\")\n        stored = publish(table, story)\n        return {\"statusCode\": 201, \"body\": json.dumps({\"slug\": stored[\"slug\"]})}\n    except ValueError as e:\n        return {\"statusCode\": 400, \"body\": json.dumps({\"error\": str(e)})}\n    except Exception:\n        log.exception(\"publish failed\")\n        return {\"statusCode\": 500, \"body\": json.dumps({\"error\": \"Internal Server Error\"})}\n","numLines":79,"startLine":1,"totalLines":79}},"tool_result_meta":[{"id":"toolu_01YP8i6UfEvAKo8hd4VFqF49","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
