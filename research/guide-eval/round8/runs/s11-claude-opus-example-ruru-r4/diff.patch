 import time
+from decimal import Decimal
 
 log = logging.getLogger("stories")
 
@@ -48,6 +49,23 @@ def validate(story):
         raise ValueError("bad slug")
 
 
+def to_dynamo(value):
+    """Make ``value`` storable in DynamoDB: every float becomes a Decimal.
+
+    boto3 rejects Python floats outright ("Float types are not supported"), and
+    any arithmetic (ratios, averages, round()) yields floats. Everything that
+    goes into put_item passes through here, so a new computed field cannot
+    reintroduce the bug. str() keeps the short repr (0.4567, not 0.45669999...).
+    """
+    if isinstance(value, float):
+        return Decimal(str(value))
+    if isinstance(value, dict):
+        return {k: to_dynamo(v) for k, v in value.items()}
+    if isinstance(value, list):
+        return [to_dynamo(v) for v in value]
+    return value
+
+
 def publish(table, story):
     """Store ``story`` with its related stories. Returns the stored item."""
     validate(story)
@@ -60,6 +78,7 @@ def publish(table, story):
         "published_at": int(time.time()),
         "similar": related(story, existing),
     }
+    item = to_dynamo(item)
     table.put_item(Item=item)
     log.info("publish slug=%s similar=%d stored", item["slug"], len(item["similar"]))
     return item
