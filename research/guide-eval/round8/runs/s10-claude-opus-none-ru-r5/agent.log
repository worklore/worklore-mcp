            ),\n            CheckboxListTile(\n              value: _terms,\n              title: const Text('I accept the terms and conditions'),\n              controlAffinity: ListTileControlAffinity.leading,\n              onChanged: (v) => setState(() => _terms = v ?? false),\n            ),\n            const Spacer(),\n            FilledButton(\n              onPressed: _canContinue\n                  ? () => Navigator.of(context).pushNamed('/offers')\n                  : null,\n              child: const Text('Continue'),\n            ),\n          ],\n        ),\n      ),\n    );\n  }\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01Kp4goCim7XtD8ncVAQZKtK","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
