{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc 'cat \"bin/nightly-review.zsh\"'","aggregated_output":"#!/bin/zsh\n# Nightly review of yesterday's commits, summary to Telegram.\nset -u\n\nREPO=\"$HOME/projects/shop\"\nOUT=\"$HOME/Library/Logs/nightly-review-$(date +%F).md\"\nNOTIFY=\"$HOME/bin/notify.sh\"\n\nSINCE=$(date -v-1d +%F)\nPROMPT=\"Review the commits in this repository since $SINCE.\nFor each commit: one line on what it changes and whether anything looks risky\n(migrations, auth, payments, deleted tests).\nEnd with a three-line summary I can read on my phone.\nDo not modify any file.\"\n\ncd \"$REPO\" || { \"$NOTIFY\" \"nightly review: repo missing\"; exit 1; }\n\nclaude -p \"$PROMPT\" --output-format text > \"$OUT\"\nstatus=$?\n\nif [ $status -ne 0 ]; then\n  \"$NOTIFY\" \"nightly review FAILED (exit $status), see $OUT\"\n  exit $status\nfi\n\n\"$NOTIFY\" \"nightly review done: $(head -c 300 \"$OUT\")\"\n","exit_code":0,"status":"completed"}}
