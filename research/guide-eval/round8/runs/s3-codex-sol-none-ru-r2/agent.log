{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport os, pathlib, shutil, subprocess, tempfile\nwith tempfile.TemporaryDirectory(dir=os.getcwd(), prefix='.nightly-test.') as temp:\n    home = pathlib.Path(temp)\n    for path in ('bin', 'mockbin', 'projects/shop', 'Library/Logs'):\n        (home / path).mkdir(parents=True)\n    shutil.copy2('bin/nightly-review.zsh', home / 'bin/nightly-review.zsh')\n    mocks = {\n        'bin/notify.sh': '#\"'!/bin/sh'\"\\\\nprintf \\\"%s\\\\\\\\n\\\" \\\"\"'$1\" >> \"$HOME/notifications\"'\"\\\\n',\n        'mockbin/security': '#\"'!/bin/sh'\"\\\\nprintf \\\"test-api-key\\\\\\\\n\\\"\\\\n',\n        'mockbin/claude': '#\"'!/bin/sh'\"\\\\n[ \\\"\"'$ANTHROPIC_API_KEY\" = test-api-key ] || exit 90'\"\\\\nif [ \\\"\"'${MOCK_CLAUDE_EXIT:-0}\" -ne 0 ]; then printf \"mock claude failure'\"\\\\\\\\n\\\" >&2; exit \\\"\"'$MOCK_CLAUDE_EXIT\"; fi'\"\\\\nprintf \\\"mock review\\\\\\\\n\\\"\\\\n',\n    }\n    for path, body in mocks.items():\n        target = home / path\n        target.write_text(body)\n        target.chmod(0o755)\n    env = dict(os.environ, HOME=str(home), PATH=str(home / 'mockbin') + ':' + os.environ['PATH'])\n    failed = subprocess.run(['/bin/zsh', str(home / 'bin/nightly-review.zsh')], env=dict(env, MOCK_CLAUDE_EXIT='42'), capture_output=True, text=True)\n    succeeded = subprocess.run(['/bin/zsh', str(home / 'bin/nightly-review.zsh')], env=env, capture_output=True, text=True)\n    messages = (home / 'notifications').read_text().splitlines()\n    print('failure exit:', failed.returncode, 'success exit:', succeeded.returncode)\n    print('notifications:', messages)\n    print('failure stderr:', failed.stderr.strip())\n    assert failed.returncode == 42 and succeeded.returncode == 0 and len(messages) == 2\n    assert 'FAILED (exit 42)' in messages[0] and 'mock review' in messages[1]\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
