                            \\\"scope\\\": \\\"ACTIVITY:WRITE,WELLNESS:READ,CALENDAR:WRITE\\\",\\n                                    \\\"athlete\\\": athlete})\\n        self._json(404, {\\\"error\\\": \\\"not found\\\"})\\n\\n    def do_GET(self):\\n        if self.path.startswith(\\\"/api/v1/athlete/i11111/wellness\\\"):\\n            if MODE == \\\"revoked\\\" or self.headers.get(\\\"Authorization\\\") != \\\"Bearer \\\" + TOK:\\n                return self._json(401, {\\\"error\\\": \\\"invalid_token\\\"})\\n            return self._json(200, [{\\\"date\\\": \\\"2026-11-08\\\", \\\"sleep_score\\\": 88}])\\n        self._json(404, {\\\"error\\\": \\\"not found\\\"})\\n\\n\\nThreadingHTTPServer((\\\"127.0.0.1\\\", 8799), H).serve_forever()\\n\",\"path\":\"stub_intervals.py\"}"}}]}
