pen('/tmp/event-check.json'))\ndef walk(steps):\n    for s in steps:\n        if 'hr' in s: assert 'value' not in s['hr'] and 'start' in s['hr'], s\n        if 'steps' in s: walk(s['steps'])\nwalk(d['workout_doc']['steps']); print('ok: no value keys')\n\" && rm /tmp/event-check.json","description":"Regenerate plan body and check HR keys"}},"wire_ingest_context":{"toolu_01MYXccNPRFcsCqvPpeyJ1bN":{"cwd":"/private/tmp/h-bqSRIn"}}}
