{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nfrom pathlib import Path\nfrom tempfile import TemporaryDirectory\nimport os, subprocess\nroot = Path.cwd()\nwith TemporaryDirectory(prefix='nightly-review-test-', dir=root) as directory:\n    base = Path(directory)\n    home = base / 'home'\n    for part in ('projects/shop', 'Library/Logs', 'bin'):\n        (home / part).mkdir(parents=True)\n    path = base / 'path'\n    path.mkdir()\n    notifier = home / 'bin/notify.sh'\n    notifier.write_text('#\"'!/bin/sh'\"\\\\nprintf \\\"%s\\\\\\\\n\\\" \\\"\"'$1\" >> \"$HOME/notifications\"'\"\\\\n')\n    agent = path / 'claude'\n    agent.write_text('#\"'!/bin/sh'\"\\\\ncase \\\"\"'$CLAUDE_TEST_MODE\" in'\"\\\\n  success) printf \\\"review summary\\\\\\\\n\\\"; exit 0 ;;\\\\n  failure) printf \\\"test failure\\\\\\\\n\\\" >&2; exit 7 ;;\\\\n  empty) exit 0 ;;\\\\nesac\\\\n')\n    notifier.chmod(0o755)\n    agent.chmod(0o755)\n    for mode in ('success', 'failure', 'empty'):\n        env = dict(os.environ, HOME=str(home), PATH=str(path) + ':' + os.environ['PATH'], CLAUDE_TEST_MODE=mode)\n        run = subprocess.run(['/bin/zsh', 'bin/nightly-review.zsh'], env=env, text=True, capture_output=True)\n        notice = (home / 'notifications').read_text().splitlines()[-1] if (home / 'notifications').exists() else '<none>'\n        print(f'{mode}: exit={run.returncode}, notification={notice}')\n        if run.stderr:\n            print(f'  stderr={run.stderr.strip()}')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
