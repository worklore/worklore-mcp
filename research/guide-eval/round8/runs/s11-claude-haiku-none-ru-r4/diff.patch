 log = logging.getLogger("stories")
 
@@ -40,6 +41,20 @@ def related(story, existing):
     return scored[:TOP_N]
 
 
+def to_dynamo(value):
+    """Convert floats to Decimal, recursively: DynamoDB rejects Python floats.
+
+    ``str()`` first so 0.1 becomes Decimal("0.1") instead of its binary expansion.
+    """
+    if isinstance(value, float):
+        return Decimal(str(value))
+    if isinstance(value, dict):
+        return {k: to_dynamo(v) for k, v in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [to_dynamo(v) for v in value]
+    return value
+
