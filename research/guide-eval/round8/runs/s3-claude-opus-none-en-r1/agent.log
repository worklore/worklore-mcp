diff:*)\" \\\n  > \"$OUT\"\nrc=$?   # `status` is a read-only special parameter in zsh\n\nif (( rc != 0 )); then\n  notify \"nightly review FAILED (exit $rc), see $OUT and ~/Library/Logs/nightly-review.err\"\n  exit $rc\nfi\n\nsummary=$(<\"$OUT\")\nnotify \"nightly review done: ${summary[1,300]}\"\nEOF\ncat > bin/notify.sh <<'EOF'\n#!/bin/bash\n# usage: notify.sh \"message\"  — sends a Telegram message to me.\nset -eu\n: \"${TG_BOT_TOKEN:=$(security find-generic-password -s tg-bot -w)}\"\nCHAT_ID=123456789\n# --fail-with-body: make Telegram API errors (bad token, bad text) a non-zero exit\n# and show the reason in stderr instead of discarding it.\ncurl -sS --fail-with-body -X POST \"https://api.telegram.org/bot${TG_BOT_TOKEN}/sendMessage\" \\\n  -d chat_id=\"$CHAT_ID\" --data-urlencode text=\"$1\" > /dev/null\nEOF\nzsh -n bin/nightly-review.zsh && bash -n bin/notify.sh && echo ok"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2481,"cache_read_input_tokens":20475,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2481},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"1083ca97-8eff-4772-9574-a882564683cd","uuid":"5ed9fb60-6f08-4988-8505-7ffb336d8246","timestamp":"2026-10-27T02:40:21.297Z","request_id":"req_011CgRy7QsKp7akrxxcxm3ck","wire_tool_inputs":{"toolu_01ALCSZdU5qxa1ShBWt4x7PP":{"command":"cd /private/tmp/h-a6gg20; cat > bin/nightly-review.zsh <<'EOF'\n#!/bin/zsh\n# Nightly review of yesterday's commits, summary to Telegram.\nset -u\n\n# launchd gives us no locale; needed so the summary is truncated on\n# character (not byte) boundaries and stays valid UTF-8 for Telegram.\nexport LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8\n\nREPO=\"$HOME/projects/shop\"\nOUT=\"$HOME/Library/Logs/