{"role":"tool","tool_call_id":"tool_8BiVC1BbjKpocMvwhIGToobf","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"tricoach backend: sign-in, Intervals.icu OAuth connection, wellness proxy.\n3\t\n4\tStdlib only. State is in memory (same shape as the prod tables).\n5\t\"\"\"\n6\timport base64, hashlib, hmac, json, os, threading, time\n7\timport urllib.error, urllib.parse, urllib.request\n8\tfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\n9\t\n10\timport config\n11\t\n12\tSTATIC = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"static\")\n13\tTOKEN_URL = config.INTERVALS_BASE + \"/api/oauth/token\"\n14\tAUTHORIZE_URL = config.INTERVALS_BASE + \"/oauth/authorize\"\n15\t# When the token response carries no expires_in the token is treated as\n16\t# long-lived: it stays \"connected\" until the Intervals API answers 401.\n17\t\n18\t# --- in-memory store -------------------------------------------------------\n19\tUSERS = {\n20\t    \"tok-okafor\": {\"id\": \"u_okafor\", \"name\": \"C. Okafor\"},\n21\t    \"tok-rivera\": {\"id\": \"u_rivera\", \"name\": \"T. Rivera\"},\n22\t}\n23\t# user_id -> {athlete_id, athlete_name, access_token, refresh_token, scope,\n24\t#              expires_at (None if the provider did not state a lifetime), status}\n25\tCONNECTIONS = {}\n26\tLOCK = threading.Lock()\n27\t\n28\t\n29\tdef log(msg):\n30\t    print(time.strftime(\"%Y-%m-%d %H:%M:%S\"), \"[intervals]\", msg, flush=True)\n31\t\n32\t\n33\t# --- state parameter: carries the user through the redirect -----------------\n34\tdef sign_state(user_id):\n35\t    payload = f\"{user_id}:{int(time.time())}\"\n36\t    sig = hmac.new(config.APP_SECRET.encode(), payload.encode(), hashlib.sha256).hexdigest()[:32]\n37\t    return base64.urlsafe_b64encode(f\"{payload}:{sig}\".encode()).decode()\n38\t\n39\t\n40\tdef verify_state(state, max_age=900):\n41\t    try:\n42\t        user_id, ts, sig = base64.urlsafe_b64decode(state.encode()).decode().split(\":\")\n43\t    except Exception:\n44\t        return None\n45\t    payload = f\"{user_id}:{ts}\"\n46\t    good = hmac.new(config.APP_SECRET.encode(), payload.encode(), hashlib.sha256).hexdigest()[:32]\n47\t    if not hmac.compare_digest(good, sig) or time.time() - int(ts) > max_age:\n48\t        return None\n49\t    return user_id\n50\t\n51\t\n52\t# --- Intervals.icu calls ----------------------------------------------------\n53\tdef post_form(url, fields):\n54\t    data = urllib.parse.urlencode(fields).encode()\n55\t    req = urllib.request.Request(url, data=data, headers={\"Accept\": \"application/json\"})\n56\t    with urllib.request.urlopen(req, timeout=15) as r:\n57\t        return json.loads(r.read().decode())\n58\t\n59\t\n60\tdef exchange_code(code):\n61\t    return post_form(TOKEN_URL, {\n62\t        \"grant_type\": \"authorization_code\", \"client_id\": config.CLIENT_ID,\n63\t        \"client_secret\": config.CLIENT_SECRET, \"code\": code, \"redirect_uri\": config.REDIRECT_URI,\n64\t    })\n65\t\n66\t\n67\tdef store_connection(user_id, tok):\n68\t    expires_in = tok.get(\"expires_in\")\n69\t    refresh = tok.get(\"refresh_token\")\n70\t    if expires_in:\n71\t        expires_at = time.time() + int(expires_in)\n72\t    else:\n73\t        # The provider did not say how long the token lives (Intervals.icu can\n74\t        # omit expires_in); do not invent an expiry, keep it until a 401 says so.\n75\t        expires_at = None\n76\t    if not refresh:\n77\t        log(f\"{user_id}: no refresh_token in response\")\n78\t    athlete = tok.get(\"athlete\") or {}\n79\t    with LOCK:\n80\t        CONNECTIONS[user_id] = {\n81\t            \"athlete_id\": athlete.get(\"id\"), \"athlete_name\": athlete.get(\"name\"),\n82\t            \"access_token\": tok[\"access_token\"], \"refresh_token\": refresh,\n83\t            \"scope\": tok.get(\"scope\"), \"expires_at\": expires_at, \"status\": \"connected\",\n84\t        }\n85\t    log(f\"{user_id}: connected as athlete {athlete.get('id')}\")\n86\t\n87\t\n88\tdef refresh_tokens():\n89\t    \"\"\"Background pass: renew access tokens shortly before they expire.\"\"\"\n90\t    while True:\n91\t        time.sleep(config.REFRESH_INTERVAL)\n92\t        now = time.time()\n93\t        with LOCK:\n94\t            for uid, c in CONNECTIONS.items():\n95\t                if c[\"status\"] != \"connected\" or c[\"expires_at\"] is None:\n96\t                    continue\n97\t                if c[\"expires_at\"] - now > 300:\n98\t                    continue\n99\t                if not c[\"refresh_token\"]:\n100\t                    log(f\"{uid}: token expired and no refresh token on file -> expired, reconnect\")\n101\t                    c.update(status=\"expired, reconnect\", access_token=None)\n102\t                    continue\n103\t                try:\n104\t                    tok = post_form(TOKEN_URL, {\n105\t                        \"grant_type\": \"refresh_token\", \"refresh_token\": c[\"refresh_token\"],\n106\t                        \"client_id\": config.CLIENT_ID, \"client_secret\": config.CLIENT_SECRET,\n107\t                    })\n108\t                    c.update(access_token=tok[\"access_token\"],\n109\t                             refresh_token=tok.get(\"refresh_token\", c[\"refresh_token\"]))\n110\t                    if tok.get(\"expires_in\"):\n111\t                        c[\"expires_at\"] = now + int(tok[\"expires_in\"])\n112\t                    log(f\"{uid}: token refreshed\")\n113\t                except Exception as e:\n114\t                    log(f\"{uid}: refresh failed ({e}) -> expired, reconnect\")\n115\t                    c.update(status=\"expired, reconnect\", access_token=None)\n116\t\n117\t\n118\tdef intervals_get(conn, path):\n119\t    req = urllib.request.Request(f\"{config.INTERVALS_BASE}/api/v1/athlete/{conn['athlete_id']}{path}\",\n120\t                                 headers={\"Authorization\": \"Bearer \" + conn[\"access_token\"]})"}
