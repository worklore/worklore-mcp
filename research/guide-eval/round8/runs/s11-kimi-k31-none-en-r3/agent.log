{"role":"tool","tool_call_id":"tool_qML6kRZdkaNkr40DyW5pdYE7","content":"diff --git a/src/app.py b/src/app.py\nindex db49c5e..c18364f 100644\n--- a/src/app.py\n+++ b/src/app.py\n@@ -8,6 +8,7 @@ import json\n import logging\n import re\n import time\n+from decimal import Decimal\n \n log = logging.getLogger(\"stories\")\n \n@@ -35,7 +36,8 @@ def related(story, existing):\n     for other in existing:\n         if other[\"slug\"] == story[\"slug\"]:\n             continue\n-        scored.append({\"slug\": other[\"slug\"], \"score\": similarity(story, other)})\n+        score = Decimal(str(similarity(story, other)))\n+        scored.append({\"slug\": other[\"slug\"], \"score\": score})\n     scored.sort(key=lambda s: s[\"score\"], reverse=True)\n     return scored[:TOP_N]\n \ndiff --git a/tests/test_publish.py b/tests/test_publish.py\nindex 6c9ac44..c3b02ae 100644\n--- a/tests/test_publish.py\n+++ b/tests/test_publish.py\n@@ -1,6 +1,8 @@\n+import json\n import os\n import sys\n import unittest\n+from decimal import Decimal\n \n sys.path.insert(0, os.path.join(os.path.dirname(__file__), \"..\", \"src\"))\n sys.path.insert(0, os.path.dirname(__file__))\n@@ -23,6 +25,33 @@ class PublishTest(unittest.TestCase):\n         self.assertEqual(table.get_item(Key={\"slug\": \"why-my-cron-ran-twice\"})[\"Item\"][\"title\"], \"Why my cron ran twice\")\n         self.assertEqual(table.scan()[\"Count\"], 1)\n \n+    def test_second_publish_stores_related_scores(self):\n+        table = FakeTable()\n+        stories = [\n+            {\n+                \"slug\": \"first-story\",\n+                \"title\": \"First story\",\n+                \"tags\": [\"cron\"],\n+                \"body\": \"A cron story.\",\n+            },\n+            {\n+                \"slug\": \"second-story\",\n+                \"title\": \"Second story\",\n+                \"tags\": [\"cron\"],\n+                \"body\": \"A cron story.\",\n+            },\n+        ]\n+\n+        for story in stories:\n+            response = app.handler({\"body\": json.dumps(story)}, table)\n+            self.assertEqual(response[\"statusCode\"], 201)\n+\n+        stored = table.get_item(Key={\"slug\": \"second-story\"})[\"Item\"]\n+        self.assertEqual(\n+            stored[\"similar\"],\n+            [{\"slug\": \"first-story\", \"score\": Decimal(\"1.0\")}],\n+        )\n+\n \n if __name__ == \"__main__\":\n     unittest.main()\n"}
