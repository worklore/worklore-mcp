init\necho \"--- 2. POST init\"; AU=$(curl -s -X POST -H 'Authorization: Bearer tok-rivera' $B/api/intervals/auth/init); echo \"$AU\"\nURL=$(echo \"$AU\" | python3 -c 'import sys,json;print(json.load(sys.stdin)[\"authorize_url\"])')\necho \"scope: $(python3 -c 'import sys,urllib.parse as u;print(u.parse_qs(u.urlsplit(sys.argv[1]).query)[\"scope\"][0])' \"$URL\")\"\nSTATE=$(python3 -c 'import sys,urllib.parse as u;print(u.parse_qs(u.urlsplit(sys.argv[1]).query)[\"state\"][0])' \"$URL\")\necho \"--- 3. callback (expect 302 /?connected=1)\"; curl -s -o /dev/null -w '%{http_code} %{redirect_url}\\n' \"$B/api/intervals/callback?code=abc&state=$(python3 -c 'import sys,urllib.parse as u;print(u.quote(sys.argv[1]))' \"$STATE\")\"\necho \"--- 4. status (expect connected)\"; curl -s -H 'Authorization: Bearer tok-rivera' $B/api/intervals/status; echo\necho \"--- 5. wellness (expect 200 + data)\"; curl -s -w ' %{http_code}\\n' -H 'Authorization: Bearer tok-rivera' $B/api/intervals/wellness\necho \"--- 6. revoke upstream, wellness again (expect 409 and status flips)\"; curl -s -X POST http://127.0.0.1:9999/revoke; echo\ncurl -s -w ' %{http_code}\\n' -H 'Authorization: Bearer tok-rivera' $B/api/intervals/wellness\ncurl -s -H 'Authorization: Bearer tok-rivera' $B/api/intervals/status; echo\necho \"--- 7. unauth POST init (expect 401)\"; curl -s -w ' %{http_code}\\n' -X POST $B/api/intervals/auth/init\necho \"--- 8. server log\"; cat /tmp/h-Fst1i1-server.out\nkill $SRV_PID $MOCK_PID 2>/dev/null; wait 2>/dev/null; rm -f /tmp/h-Fst1i1-server.out; find . -name __pycache__ -exec rm -rf {} +; git status --short","description":"Run OAuth flow test against mock Intervals on spare port"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":771,"cache_read_input_tokens":45371,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":771},"output_tokens":8,"service_t