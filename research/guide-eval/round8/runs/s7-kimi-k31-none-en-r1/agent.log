({ id: \\\"u_okafor\\\", name: \\\"C. Okafor\\\" }) };\\n    }\\n    if (path === \\\"/api/intervals/status\\\") {\\n      return { ok: true, json: async () => ({ connected: false, status: \\\"disconnected\\\" }) };\\n    }\\n    if (path === \\\"/api/intervals/auth/init\\\") {\\n      assert.strictEqual(opts.headers.Authorization, \\\"Bearer tok-okafor\\\");\\n      return { ok: true, json: async () => ({ url: \\\"http://local.test/oauth/authorize?state=signed\\\" }) };\\n    }\\n    throw new Error(\\\"Unexpected fetch: \\\" + path);\\n  },\\n};\\nvm.createContext(context);\\nvm.runInContext(fs.readFileSync(\\\"static/app.js\\\", \\\"utf8\\\"), context);\\nsetImmediate(async () => {\\n  assert.strictEqual(typeof connect.onclick, \\\"function\\\");\\n  await connect.onclick();\\n  assert.strictEqual(assignedUrl, \\\"http://local.test/oauth/authorize?state=signed\\\");\\n  assert.strictEqual(connect.disabled, true);\\n  console.log(\\\"PASS: SPA Connect click sends bearer auth and navigates to the returned authorize URL\\\");\\n});\\nJS\",\"cwd\":\"/private/tmp/h-bGSv4j\",\"timeout\":60}"}}]}
