{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019Zd2hb5spZ7ENTbk1xEV2W","type":"tool_result","content":"The file /private/tmp/h-TJ90hX/src/app.py has been updated successfully."}]},"parent_tool_use_id":null,"session_id":"43800d2a-a29f-45b9-af23-f931366d2d3f","uuid":"7274d5b8-259c-4df5-bb84-87ebbb86dc8d","timestamp":"2026-10-27T05:00:25.632Z","tool_use_result":{"filePath":"/private/tmp/h-TJ90hX/src/app.py","oldString":"def publish(table, story):\n    \"\"\"Store ``story`` with its related stories. Returns the stored item.\"\"\"\n    validate(story)\n    existing = table.scan(TableName=TABLE_NAME).get(\"Items\", [])\n    item = {\n        \"slug\": story[\"slug\"],\n        \"title\": story[\"title\"],\n        \"tags\": sorted(set(story.get(\"tags\", []))),\n        \"body\": story[\"body\"],\n        \"published_at\": int(time.time()),\n        \"similar\": related(story, existing),\n    }\n    table.put_item(Item=item)","newString":"def dynamo_safe(value):\n    \"\"\"Recursively replace floats with ``Decimal``: boto3 refuses floats in items.\"\"\"\n    if isinstance(value, float):\n        return Decimal(str(value))\n    if isinstance(value, dict):\n        return {k: dynamo_safe(v) for k, v in value.items()}\n    if isinstance(value, (list, tuple)):\n        return [dynamo_safe(v) for v in value]\n    return value\n\n\ndef publish(table, story):\n    \"\"\"Store ``story`` with its related stories. Returns the stored item.\"\"\"\n    validate(story)\n    existing = table.scan(TableName=TABLE_NAME).get(\"Items\", [])\n    item = dynamo_safe({\n        \"slug\": story[\"slug\"],\n        \"title\": story[\"title\"],\n        \"tags\": sorted(set(story.get(\"tags\", []))),\n        \"body\": story[\"body\"],\n        \"published_at\": int(time.time()),\n        \"similar\": related(story, existing),\n    })\n    table.put_item(Item=item)","originalFile":"\"\"\"Story library: the publish handler.\n\nEach story is stored in one DynamoDB item together with the three most similar\nstories already in the library (``similar``), so the reader page can show\n\"related\" without a query at read time.\n\"\"\"\nimport json\nimport logging\nimport re\nimport time\nfrom decimal import Decimal\n\nlog = logging.getLogger(\"stories\")\n\nTABLE_NAME = \"stories\"\nTOP_N = 3\n\n_WORD = re.compile(r\"[a-z0-9]+\")\n\n\ndef words(text):\n    return set(_WORD.findall((text or \"\").lower()))\n\n\ndef similarity(a, b):\n    \"\"\"Shared-tag ratio (Jaccard), blended with shared words of the two bodies.\n\n    Returns a ``Decimal``: DynamoDB (boto3) rejects Python floats in items.\n    \"\"\"\n    ta, tb = set(a.get(\"tags\", [])), set(b.get(\"tags\", []))\n    tag_score = len(ta & tb) / len(ta | tb) if (ta | tb) else 0\n    wa, wb = words(a.get(\"body\")), words(b.get(\"body\"))\n    word_score = len(wa & wb) / len(wa | wb) if (wa | wb) else 0\n    return Decimal(str(round(0.7 * tag_score + 0.3 * word_score, 4)))\n\n\ndef related(story, existing):\n    scored = []\n    for other in existing:\n        if other[\"slug\"] == story[\"slug\"]:\n            continue\n        scored.append({\"slug\": other[\"slug\"], \"score\": similarity(story, other)})\n    scored.sort(key=lambda s: s[\"score\"], reverse=True)\n    return scored[:TOP_N]\n\n\ndef validate(story):\n    for k in (\"slug\", \"title\", \"body\"):\n        if not story.get(k):\n            raise ValueError(f\"missing field: {k}\")\n    if not re.fullmatch(r\"[a-z0-9-]{3,80}\", story[\"slug\"]):\n        raise ValueError(\"bad slug\")\n\n\ndef publish(table, story):\n    \"\"\"Store ``story`` with its related stories. Returns the stored item.\"\"\"\n    validate(story)\n    existing = table.scan(TableName=TABLE_NAME).get(\"Items\", [])\n    item = {\n        \"slug\": story[\"slug\"],\n        \"title\": story[\"title\"],\n        \"tags\": sorted(set(story.get(\"tags\", []))),\n        \"body\": story[\"body\"],\n        \"published_at\": int(time.time()),\n        \"similar\": related(story, existing),\n    }\n    table.put_item(Item=item)\n    log.info(\"publish slug=%s similar=%d stored\", item[\"slug\"], len(item[\"similar\"]))\n    return item\n\n\ndef handler(event, table):\n    \"\"\"Lambda-style entry point for POST /stories. Body is the story as JSON.\"\"\"\n    try:\n        story = json.loads(event.get(\"body\") or \"{}\")\n        stored = publish(table, story)\n        return {\"statusCode\": 201, \"body\": json.dumps({\"slug\": stored[\"slug\"]})}\n    except ValueError as e:\n        return {\"statusCode\": 400, \"body\": json.dumps({\"error\": str(e)})}\n    except Exception:\n        log.exception(\"publish failed\")\n        return {\"statusCode\": 500, \"body\": json.dumps({\"error\": \"Internal Server Error\"})}\n","structuredPatch":[{"oldStart":52,"oldLines":18,"newStart":52,"newLines":29,"lines":["         raise ValueError(\"bad slug\")"," "," ","+def dynamo_safe(value):","+    \"\"\"Recursively replace floats with ``Decimal``: boto3 refuses floats in items.\"\"\"","+    if isinstance(value, float):","+        return Decimal(str(value))","+    if isinstance(value, dict):","+        return {k: dynamo_safe(v) for k, v in value.items()}","+    if isinstance(value, (list, tuple)):","+        return [dynamo_safe(v) for v in value]","+    return value","+","+"," def publish(table, story):","     \"\"\"Store ``story`` with its related stories. Returns the stored item.\"\"\"","     validate(story)","     existing = table.scan(TableName=TABLE_NAME).get(\"Items\", [])","-    item = {","+    item = dynamo_safe({","         \"slug\": story[\"slug\"],","         \"title\": story[\"title\"],","         \"tags\": sorted(set(story.get(\"tags\", []))),","         \"body\": story[\"body\"],","         \"published_at\": int(time.time()),","         \"similar\": related(story, existing),","-    }","+    })","     table.put_item(Item=item)","     log.info(\"publish slug=%s similar=%d stored\", item[\"slug\"], len(item[\"similar\"]))","     return item"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"tool_result_meta":[{"id":"toolu_019Zd2hb5spZ7ENTbk1xEV2W","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
