{"event":"step_update","step_update":{"conversation_id":"8e82b9ba-765f-43c2-9333-b24d581ddfcb","step_index":29,"state":"DONE","step_type":"tool","tool_name":"run_command","duration_seconds":0.108554,"tool_info":{"name":"run_command","parameters":{"CommandLine":"git diff"},"output":"Command exited with code 0.\n\nCommand output:\ndiff --git a/src/app.py b/src/app.py\r\nindex db49c5e..af4bb08 100644\r\n--- a/src/app.py\r\n+++ b/src/app.py\r\n@@ -8,6 +8,7 @@ import json\r\n import logging\r\n import re\r\n import time\r\n+from decimal import Decimal\r\n \r\n log = logging.getLogger(\"stories\")\r\n \r\n@@ -27,7 +28,7 @@ def similarity(a, b):\r\n     tag_score = len(ta \u0026 tb) / len(ta | tb) if (ta | tb) else 0\r\n     wa, wb = words(a.get(\"body\")), words(b.get(\"body\"))\r\n     word_score = len(wa \u0026 wb) / len(wa | wb) if (wa | wb) else 0\r\n-    return round(0.7 * tag_score + 0.3 * word_score, 4)\r\n+    return Decimal(str(round(0.7 * tag_score + 0.3 * word_score, 4)))\r\n \r\n \r\n def related(story, existing):\r\ndiff --git a/tests/test_publish.py b/tests/test_publish.py\r\nindex 6c9ac44..a954988 100644\r\n--- a/tests/test_publish.py\r\n+++ b/tests/test_publish.py\r\n@@ -1,3 +1,4 @@\r\n+import json\r\n import os\r\n import sys\r\n import unittest\r\n@@ -23,6 +24,50 @@ class PublishTest(unittest.TestCase):\r\n         self.assertEqual(table.get_item(Key={\"slug\": \"why-my-cron-ran-twice\"})[\"Item\"][\"title\"], \"Why my cron ran twice\")\r\n         self.assertEqual(table.scan()[\"Count\"], 1)\r\n \r\n+    def test_publish_second_story_succeeds_with_similarity_scores(self):\r\n+        table = FakeTable()\r\n+        story1 = {\r\n+            \"slug\": \"why-my-cron-ran-twice\",\r\n+            \"title\": \"Why my cron ran twice\",\r\n+            \"tags\": [\"cron\", \"linux\"],\r\n+            \"body\": \"Two crontabs, one for root and one for me, both had the line.\",\r\n+        }\r\n+        story2 = {\r\n+            \"slug\": \"another-cron-adventure\",\r\n+            \"title\": \"Another cron adventure\",\r\n+            \"tags\": [\"cron\", \"monitoring\"],\r\n+            \"body\": \"Crontab debugging in production on linux systems.\",\r\n+        }\r\n+        app.publish(table, story1)\r\n+        stored2 = app.publish(table, story2)\r\n+        self.assertEqual(stored2[\"slug\"], \"another-cron-adventure\")\r\n+        self.assertEqual(len(stored2[\"similar\"]), 1)\r\n+        self.assertEqual(stored2[\"similar\"][0][\"slug\"], \"why-my-cron-ran-twice\")\r\n+        self.assertEqual(table.scan()[\"Count\"], 2)\r\n+\r\n+    def test_handler_publish_twice(self):\r\n+        table = FakeTable()\r\n+        event1 = {\r\n+            \"body\": json.dumps({\r\n+                \"slug\": \"story-one\",\r\n+                \"title\": \"Story One\",\r\n+                \"tags\": [\"test\"],\r\n+                \"body\": \"Body one\",\r\n+            })\r\n+        }\r\n+        event2 = {\r\n+            \"body\": json.dumps({\r\n+                \"slug\": \"story-two\",\r\n+                \"title\": \"Story Two\",\r\n+                \"tags\": [\"test\"],\r\n+                \"body\": \"Body two\",\r\n+            })\r\n+        }\r\n+        res1 = app.handler(event1, table)\r\n+        self.assertEqual(res1[\"statusCode\"], 201)\r\n+        res2 = app.handler(event2, table)\r\n+        self.assertEqual(res2[\"statusCode\"], 201)\r\n+\r\n \r\n if __name__ == \"__main__\":\r\n     unittest.main()\r\n"}}}
