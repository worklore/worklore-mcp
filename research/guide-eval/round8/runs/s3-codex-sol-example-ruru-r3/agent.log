{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport os, pathlib, subprocess, tempfile\nroot = pathlib.Path.cwd()\nwith tempfile.TemporaryDirectory(prefix='.nightly-test.', dir=root) as temp:\n    base = pathlib.Path(temp)\n    home = base / 'home'\n    for path in ('projects/shop', 'Library/Logs', 'bin'):\n        (home / path).mkdir(parents=True)\n    tools = base / 'tools'\n    tools.mkdir()\n    agent = tools / 'claude'\n    agent.write_text('#\"'!/bin/sh'\"\\\\ncat > \\\"\"'$HOME/prompt\"'\"\\\\ncase \\\"\"'$MOCK_RESULT\" in'\"\\\\n success) printf \\\"Review summary\\\\\\\\n\\\" ;;\\\\n failure) echo \\\"mock agent failure\\\" >&2; exit 7 ;;\\\\n empty) : ;;\\\\nesac\\\\n')\n    agent.chmod(0o755)\n    notifier = home / 'bin/notify.sh'\n    notifier.write_text('#\"'!/bin/sh'\"\\\\nprintf \\\"%s\\\\\\\\n\\\" \\\"\"'$1\" >> \"$HOME/notifications\"'\"\\\\n')\n    notifier.chmod(0o755)\n    for mode in ('success', 'failure', 'empty'):\n        env = dict(os.environ, HOME=str(home), PATH=f'{tools}:{os.environ[\\\"PATH\\\"]}', MOCK_RESULT=mode)\n        proc = subprocess.run(['/bin/zsh', str(root / 'bin/nightly-review.zsh')], cwd=root, env=env, capture_output=True, text=True)\n        notification = (home / 'notifications').read_text().splitlines()[-1]\n        print(f'{mode}: exit={proc.returncode}, notification={notification}')\n        print(f'  stderr={proc.stderr.strip()}')\n    print('prompt first line:', (home / 'prompt').read_text().splitlines()[0])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
