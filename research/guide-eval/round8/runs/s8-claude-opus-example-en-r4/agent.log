en(kw[\"tools\"])","+        marks = [n_tools + i + 1 for i, b in enumerate(kw[\"system\"]) if \"cache_control\" in b]","+        size = lambda n: sum(len(u) for u in units[:n]) // 4","+        key = lambda n: \"\\x00\".join(units[:n])","+        hit = 0","+        for m in marks:","+            for n in range(m, max(m - LOOKBACK, 0) - 1, -1):","+                if key(n) in self.cache:","+                    hit = max(hit, n)","+                    break","+        for m in marks:","+            self.cache.add(key(m))","+        read = size(hit)","+        created = size(marks[-1]) - read if marks else 0","+        self.usage.append((read, created))","+        usage = NS(input_tokens=size(len(units)) - size(marks[-1]) if marks else size(len(units)),","+                   cache_creation_input_tokens=created, cache_read_input_tokens=read, output_tokens=1)","+        step = self.script.pop(0)","+        if step is None:","+            return NS(stop_reason=\"end_turn\", usage=usage, content=[NS(type=\"text\", text=\"ok\")])","+        name, args = step","+        block = NS(type=\"tool_use\", id=\"t1\", name=name, input=args)","+        block.model_dump = lambda: {\"type\": \"tool_use\", \"id\": \"t1\", \"name\": name, \"input\": args}","+        return NS(stop_reason=\"tool_use\", usage=usage, content=[block])","+","+","+class CacheLayoutTest(unittest.TestCase):","+    def setUp(self):","+        self.tmp = tempfile.mkdtemp()","+        bot.ATHLETES_FILE = os.path.join(self.tmp, \"athletes.json\")","+        bot.USAGE_LOG = os.path.join(self.tmp, \"usage.jsonl\")","+        bot.save_athlete(bot.Athlete(user_id=\"42\", name=\"Marta\", facts=[\"Runs before work, 06:30, Mon/Wed/Fri\"]))","+","+    def test_static_block_is_stable(self):","+        a = bot.load_athlete(\"42\")","+        s1 = bot.build_system(a, dt.date(2026, 4, 18))","+        a.facts.append(\"Owns a Garmin 255\")","+        s2 = bot.build_system(a, dt.date(2026, 4, 19))","+        self.assertEqual(s1[0], s2[0])","+        self.assertEqual(s1[:-1], [s2[0]] + [_strip(b) if i else b for i, b in enumerate(s2[1:-2], 1)] + [s1[-2]])","+","+    def test_save_fact_recaches_only_the_new_fact(self):","+        llm = FakeLLM([None,                                       # msg 1: warm the cache","+                       (\"save_fact\", {\"fact\": \"Has a 10k race booked on 2026-05-10\"}), None,   # msg 2","+                       None])                                      # msg 3: follow-up","+        for text in (\"hi\", \"I booked a 10k\", \"thanks\"):","+            bot.reply(\"42\", text, llm=llm)","+        full = llm.usage[0][1]","+        _, (r_save, c_save), (r_after, c_after), (r_next, c_next) = llm.usage","+        self.assertEqual(c_save, 0)","+        self.assertLess(c_after, 0.05 * full, llm.usage)          # round after save_fact: just the fact","+        self.assertGreater(r_after, 0.95 * full, llm.usage)","+        self.assertEqual(c_next, 0)","+","+    def test_new_day_busts_nothing(self):","+        a = bot.load_athlete(\"42\")","+        llm = FakeLLM([None, None])","+        for day in (dt.date(2026, 4, 18), dt.date(2026, 4, 19)):","+            llm.create(**bot.build_request(a, [{\"role\": \"user\", \"content\": \"hi\"}], bot.select_tools(\"hi\"), day))","+        self.assertEqual(llm.usage[1][1], 0)","+","+","+if __name__ == \"__main__\":","+    unittest.main()"]}],"created":true}],"moreFiles":2,"changedFiles":["/private/tmp/h-ULZ9U2/__pycache__/bot.cpython-314.pyc","/private/tmp/h-ULZ9U2/tests/__pycache__/test_cache_layout.cpython-314.pyc","/private/tmp/h-ULZ9U2/tests/test_cache_layout.py"]}},"tool_result_meta":[{"id":"toolu_01XTftwfP6Uvu6LbfKhrnbXe","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
