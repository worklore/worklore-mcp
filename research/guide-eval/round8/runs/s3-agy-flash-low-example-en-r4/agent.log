r\n+    \u003ckey\u003ePATH\u003c/key\u003e\r\n+    \u003cstring\u003e/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin\u003c/string\u003e\r\n+  \u003c/dict\u003e\r\n+\u003c/dict\u003e\r\n+\u003c/plist\u003e\r\ndiff --git a/Library/Logs/nightly-review.err b/Library/Logs/nightly-review.err\r\nnew file mode 100644\r\nindex 0000000..c95ae56\r\n--- /dev/null\r\n+++ b/Library/Logs/nightly-review.err\r\n@@ -0,0 +1,12 @@\r\n+Not logged in · Please run /login\r\n+/Users/vk/bin/nightly-review.zsh:19: read-only variable: status\r\n+Not logged in · Please run /login\r\n+/Users/vk/bin/nightly-review.zsh:19: read-only variable: status\r\n+Not logged in · Please run /login\r\n+/Users/vk/bin/nightly-review.zsh:19: read-only variable: status\r\n+Not logged in · Please run /login\r\n+/Users/vk/bin/nightly-review.zsh:19: read-only variable: status\r\n+Not logged in · Please run /login\r\n+/Users/vk/bin/nightly-review.zsh:19: read-only variable: status\r\n+Not logged in · Please run /login\r\n+/Users/vk/bin/nightly-review.zsh:19: read-only variable: status\r\ndiff --git a/Library/Logs/nightly-review.out b/Library/Logs/nightly-review.out\r\nnew file mode 100644\r\nindex 0000000..e69de29\r\ndiff --git a/README.md b/README.md\r\nnew file mode 100644\r\nindex 0000000..6e189da\r\n--- /dev/null\r\n+++ b/README.md\r\n@@ -0,0 +1,18 @@\r\n+# nightly-review (snapshot of my home dir, the relevant bits)\r\n+\r\n+A launchd user agent runs `bin/nightly-review.zsh` every night at 02:30. The\r\n+script asks a headless coding agent to review yesterday's commits in\r\n+~/projects/shop and sends me the summary (or a failure note) over Telegram\r\n+via `bin/notify.sh`.\r\n+\r\n+Layout, relative to my home:\r\n+\r\n+- `Library/LaunchAgents/com.vk.nightly-review.plist` — loaded with\r\n+  `launchctl bootstrap gui/$UID ...` on 2026-10-12\r\n+- `bin/nightly-review.zsh` — the job\r\n+- `bin/notify.sh` — Telegram notifier (works when run by hand)\r\n+- `Library/Logs/` — where the plist points stdout/stderr\r\n+- `launchctl-print.txt` — output of `launchctl print gui/501/com.vk.nightly-review`, captured 2026-10-18 09:10\r\n+\r\n+I have received nothing on Telegram since it was loaded: no summaries, no\r\n+failure notes.\r\ndiff --git a/bin/nightly-review.zsh b/bin/nightly-review.zsh\r\nnew file mode 100755\r\nindex 0000000..e0b986f\r\n--- /dev/null\r\n+++ b/bin/nightly-review.zsh\r\n@@ -0,0 +1,26 @@\r\n+#!/bin/zsh\r\n+# Nightly review of yesterday's commits, summary to Telegram.\r\n+set -u\r\n+\r\n+REPO=\"$HOME/projects/shop\"\r\n+OUT=\"$HOME/Library/Logs/nightly-review-$(date +%F).md\"\r\n+NOTIFY=\"$HOME/bin/notify.sh\"\r\n+\r\n+SINCE=$(date -v-1d +%F)\r\n+PROMPT=\"Review the commits in this repository since $SINCE.\r\n+For each commit: one line on what it changes and whether anything looks risky\r\n+(migrations, auth, payments, deleted tests).\r\n+End with a three-line summary I can read on my phone.\r\n+Do not modify any file.\"\r\n+\r\n+cd \"$REPO\" || { \"$NOTIFY\" \"nightly review: repo missing\"; exit 1; }\r\n+\r\n+claude -p \"$PROMPT\" --output-format text \u003e \"$OUT\"\r\n+status=$?\r\n+\r\n+if [ $status -ne 0 ]; then\r\n+  \"$NOTIFY\" \"nightly review FAILED (exit $status), see $OUT\"\r\n+  exit $status\r\n+fi\r\n+\r\n+\"$NOTIFY\" \"nightly review done: $(head -c 300 \"$OUT\")\"\r\ndiff --git a/bin/notify.sh b/bin/notify.sh\r\nnew file mode 100755\r\nindex 0000000..818e531\r\n--- /dev/null\r\n+++ b/bin/notify.sh\r\n@@ -0,0 +1,7 @@\r\n+#!/bin/bash\r\n+# usage: notify.sh \"message\"  — sends a Telegram message to me.\r\n+set -eu\r\n+: \"${TG_BOT_TOKEN:=$(security find-generic-password -s tg-bot -w)}\"\r\n+CHAT_ID=123456789\r\n+curl -sS -X POST \"https://api.telegram.org/bot${TG_BOT_TOKEN}/sendMessage\" \\\r\n+  -d chat_id=\"$CHAT_ID\" --data-urlencode text=\"$1\" \u003e /dev/null\r\ndiff --git a/launchctl-print.txt b/launchctl-print.txt\r\nnew file mode 100644\r\nindex 0000000..5454375\r\n--- /dev/null\r\n+++ b/launchctl-print.txt\r\n@@ -0,0 +1,49 @@\r\n+gui/501/com.vk.nightly-review = {\r\n+\tactive count = 0\r\n+\tpath = /Users/vk/Library/LaunchAgents/com.vk.nightly-review.plist\r\n+\ttype = LaunchAgent\r\n+\tstate = waiting\r\n+\r\n+\tprogram = /bin/zsh\r\n+\targuments = {\r\n+\t\t/bin/zsh\r\n+\t\t/Users/vk/bin/nightly-review.zsh\r\n+\t}\r\n+\r\n+\tstdout path = /Users/vk/Library/Logs/nightly-review.out\r\n+\tstderr path = /Users/vk/Library/Logs/nightly-review.err\r\n+\tdefault environment = {\r\n+\t\tPATH =\u003e /usr/bin:/bin:/usr/sbin:/sbin\r\n+\t}\r\n+\r\n+\tenvironment = {\r\n+\t\tPATH =\u003e /opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin\r\n+\t\tXPC_SERVICE_NAME =\u003e com.vk.nightly-review\r\n+\t}\r\n+\r\n+\tdomain = gui/501 [100005]\r\n+\tminimum runtime = 10\r\n+\texit timeout = 5\r\n+\truns = 6\r\n+\tlast exit code = 1\r\n+\r\n+\tevent triggers = {\r\n+\t\tcom.vk.nightly-review.StartCalendarInterval =\u003e {\r\n+\t\t\tkeep alive = 0\r\n+\t\t\tservice = com.vk.nightly-review\r\n+\t\t\tname = com.vk.nightly-review.StartCalendarInterval\r\n+\t\t\tdescriptor = {\r\n+\t\t\t\t\"Hour\" =\u003e 2\r\n+\t\t\t\t\"Minute\" =\u003e 30\r\n+\t\t\t}\r\n+\t\t}\r\n+\t}\r\n+\r\n+\tspawn type = daemon (3)\r\n+\tproperties = {\r\n+\t\tpartial import = 0\r\n+\t\tlaunchd bundle = 0\r\n+\t\ttrusted = 0\r\n+\t\ton demand = 1\r\n+\t}\r\n+}\r\n"}}}
