{"role":"tool","tool_call_id":"tool_Tx2PuSZY0cFH03TiGpdCjm5I","content":"1\t#!/bin/bash\n2\t# usage: notify.sh \"message\"  — sends a Telegram message to me.\n3\tset -eu\n4\t: \"${TG_BOT_TOKEN:=$(security find-generic-password -s tg-bot -w)}\"\n5\tCHAT_ID=123456789\n6\tcurl -sS -X POST \"https://api.telegram.org/bot${TG_BOT_TOKEN}/sendMessage\" \\\n7\t  -d chat_id=\"$CHAT_ID\" --data-urlencode text=\"$1\" > /dev/null"}
{"role":"tool","tool_call_id":"tool_g8dToL381Pn3ZhBweL3lqvpF","content":"1\t#!/bin/zsh\n2\t# Nightly review of yesterday's commits, summary to Telegram.\n3\tset -u\n4\t\n5\tREPO=\"$HOME/projects/shop\"\n6\tOUT=\"$HOME/Library/Logs/nightly-review-$(date +%F).md\"\n7\tNOTIFY=\"$HOME/bin/notify.sh\"\n8\t\n9\tSINCE=$(date -v-1d +%F)\n10\tPROMPT=\"Review the commits in this repository since $SINCE.\n11\tFor each commit: one line on what it changes and whether anything looks risky\n12\t(migrations, auth, payments, deleted tests).\n13\tEnd with a three-line summary I can read on my phone.\n14\tDo not modify any file.\"\n15\t\n16\tcd \"$REPO\" || { \"$NOTIFY\" \"nightly review: repo missing\"; exit 1; }\n17\t\n18\tclaude -p \"$PROMPT\" --output-format text > \"$OUT\"\n19\tstatus=$?\n20\t\n21\tif [ $status -ne 0 ]; then\n22\t  \"$NOTIFY\" \"nightly review FAILED (exit $status), see $OUT\"\n23\t  exit $status\n24\tfi\n25\t\n26\t\"$NOTIFY\" \"nightly review done: $(head -c 300 \"$OUT\")\""}
