diff --git a/bin/nightly-review.zsh b/bin/nightly-review.zsh
index e0b986f..3a54625 100755
--- a/bin/nightly-review.zsh
+++ b/bin/nightly-review.zsh
@@ -13,14 +13,26 @@ For each commit: one line on what it changes and whether anything looks risky
 End with a three-line summary I can read on my phone.
 Do not modify any file."
 
-cd "$REPO" || { "$NOTIFY" "nightly review: repo missing"; exit 1; }
+notify() {
+  "$NOTIFY" "$1" || print -u2 -- "nightly-review: notify.sh failed to send: $1"
+}
 
-claude -p "$PROMPT" --output-format text > "$OUT"
-status=$?
+start=$SECONDS
 
-if [ $status -ne 0 ]; then
-  "$NOTIFY" "nightly review FAILED (exit $status), see $OUT"
-  exit $status
+cd "$REPO" || { notify "nightly review: repo missing"; exit 1; }
+
+print -r -- "$PROMPT" | claude -p --output-format text > "$OUT"
+rc=$?
+
+if [ $rc -ne 0 ]; then
+  notify "nightly review FAILED (exit $rc), see $OUT"
+  exit $rc
+fi
+
+if [ ! -s "$OUT" ]; then
+  notify "nightly review FAILED: claude exited 0 but wrote nothing to $OUT"
+  exit 1
 fi
 
-"$NOTIFY" "nightly review done: $(head -c 300 "$OUT")"
+print -u2 -- "nightly review finished in $(( SECONDS - start ))s"
+notify "nightly review done: $(head -c 300 "$OUT")"
