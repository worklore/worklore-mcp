hed)","+        last = messages[-1][\"content\"]","+        if isinstance(last, str) and last.startswith(\"remember:\"):","+            content = [types.SimpleNamespace(type=\"tool_use\", name=\"save_fact\", id=\"t1\", input={\"fact\": last[9:]},","+                                             model_dump=lambda: {\"type\": \"tool_use\", \"id\": \"t1\", \"name\": \"save_fact\", \"input\": {}})]","+            stop = \"tool_use\"","+        else:","+            content, stop = [types.SimpleNamespace(type=\"text\", text=\"ok\")], \"end_turn\"","+        u = types.SimpleNamespace(input_tokens=uncached, cache_creation_input_tokens=creation,","+                                  cache_read_input_tokens=read, output_tokens=1)","+        return types.SimpleNamespace(content=content, stop_reason=stop, usage=u)","+","+","+def main():","+    import tempfile, shutil","+    tmp = tempfile.mkdtemp()","+    shutil.copy(bot.ATHLETES_FILE, os.path.join(tmp, \"athletes.json\"))","+    bot.ATHLETES_FILE = os.path.join(tmp, \"athletes.json\")","+    log = []","+    bot.log_usage = lambda usage, uid, rnd, tool=None: log.append((rnd, tool, usage.cache_read_input_tokens,","+                                                                  usage.cache_creation_input_tokens, usage.input_tokens))","+    llm = FakeLLM()","+    for msg in [\"hi\", \"how was my run\", \"remember: Has a 10k race on May 3\", \"thanks\", \"remember: Prefers trails\", \"ok\"]:","+        bot.reply(\"42\", msg, llm=llm)","+    print(f\"{'round':>5} {'tool':>10} {'read':>6} {'create':>6} {'input':>6}\")","+    for r in log:","+        print(f\"{r[0]:>5} {str(r[1]):>10} {r[2]:>6} {r[3]:>6} {r[4]:>6}\")","+    shutil.rmtree(tmp)","+","+","+if __name__ == \"__main__\":","+    main()"]}],"created":true},{"filePath":"/private/tmp/h-Rgfh5i/tests/sim_cache.py","hunks":[{"oldStart":0,"oldLines":0,"newStart":1,"newLines":76,"lines":["+\"\"\"Offline check of prompt-cache behaviour, no API calls.","+","+Mimics Anthropic prefix c