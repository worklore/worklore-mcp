ls\", \"ok\"]:\n        bot.reply(\"42\", msg, llm=llm)\n    print(f\"{'round':>5} {'tool':>10} {'read':>6} {'create':>6} {'input':>6}\")\n    for r in log:\n        print(f\"{r[0]:>5} {str(r[1]):>10} {r[2]:>6} {r[3]:>6} {r[4]:>6}\")\n    shutil.rmtree(tmp)\n\n\nif __name__ == \"__main__\":\n    main()\nEOF\necho NEW; python3 -I tests/sim_cache.py\ngit stash -q && cp tests/sim_cache.py /tmp/h-Rgfh5i/.sim_old.py 2>/dev/null; echo OLD; python3 -I tests/sim_cache.py; git stash pop -q; git status --short"}},"wire_ingest_context":{"toolu_01ULQyptZwUgDLf4puiQPDTG":{"cwd":"/private/tmp/h-Rgfh5i"}}}
