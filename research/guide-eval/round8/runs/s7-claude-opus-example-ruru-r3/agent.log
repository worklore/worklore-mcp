осится, поэтому не добавлял.\n\nНа портах 8766 и 8777 уже работали чужие экземпляры `server.py`. Я их не трогал, а тесты гонял на свободных портах и временные файлы потом удалил. Изменения в `server.py`, `config.py` и `static/app.js` не закоммичены.","ttft_ms":4268,"type":"result","duration_ms":142514,"uuid":"336378b2-1f89-4798-9574-98f55b2eef8e","ttft_stream_ms":3237,"time_to_request_ms":36,"first_content_frame_ms":3237,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":26,"outputTokens":12280,"cacheReadInputTokens":462469,"cacheCreationInputTokens":30469,"webSearchRequests":0,"costUSD":0.5819498,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":1894,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}}}
