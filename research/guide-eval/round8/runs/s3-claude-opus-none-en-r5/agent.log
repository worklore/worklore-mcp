only special parameter in zsh\n\nif (( rc != 0 )); then\n  notified=1\n  \"$NOTIFY\" \"nightly review FAILED (exit $rc): $(tail -c 300 \"$OUT\" 2>/dev/null)\"\n  exit $rc\nfi\n\nnotified=1\n\"$NOTIFY\" \"nightly review done: $(head -c 300 \"$OUT\")\"\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1374,"cache_read_input_tokens":22948,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1374},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"08166898-89f0-48be-8d74-6026838d486f","uuid":"45648896-8c8c-4f40-b433-20fd8bba95ed","timestamp":"2026-10-27T05:20:32.463Z","request_id":"req_011CgSBM1sk26y7fVcV4foyA","wire_tool_inputs":{"toolu_01SqrT7zrFN31uxzQCy6owar":{"file_path":"/private/tmp/h-LnVWJZ/bin/nightly-review.zsh","content":"#!/bin/zsh\n# Nightly review of yesterday's commits, summary to Telegram.\nset -u\n\nREPO=\"$HOME/projects/shop\"\nOUT=\"$HOME/Library/Logs/nightly-review-$(date +%F).md\"\nNOTIFY=\"$HOME/bin/notify.sh\"\n\n# launchd does not source ~/.zshrc, so whatever auth the interactive shell has\n# is not available here. Use a long-lived token from `claude setup-token`,\n# stored once with:\n#   security add-generic-password -a \"$USER\" -s claude-code-oauth -w '<token>'\nif [[ -z \"${CLAUDE_CODE_OAUTH_TOKEN:-}\" && -z \"${ANTHROPIC_API_KEY:-}\" ]]; then\n  CLAUDE_CODE_OAUTH_TOKEN=$(security find-generic-password -s claude-code-oauth -w 2>/dev/null) \\\n    && export CLAUDE_CODE_OAUTH_TOKEN\nfi\n\n# Any unexpected exit before the final notification still sends a failure note.\nnotified=0\nTRAPEXIT() {\n  local rc=$?\n  if (( ! notified )); then\n    \"$NOTIFY\" \"nightly review FAILED unexpectedly (exit $rc), see ~/Library/Logs/nightly-review.err\"\n  fi\n}\n\nSINCE=$