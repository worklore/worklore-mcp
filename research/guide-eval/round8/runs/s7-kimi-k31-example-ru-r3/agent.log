 code, body, _ = request('/api/intervals/auth/init', 'POST', auth)\\n    assert code == 200\\n    authorize = urllib.parse.urlsplit(body['authorize_url'])\\n    params = dict(urllib.parse.parse_qsl(authorize.query))\\n    assert authorize.scheme + '://' + authorize.netloc + authorize.path == server.AUTHORIZE_URL\\n    assert params['scope'] == config.SCOPES\\n    assert server.verify_state(params['state']) == 'u_okafor'\\n\\n    code, body, headers = request('/api/intervals/callback?' + urllib.parse.urlencode({\\n        'code': 'test-code', 'state': params['state'],\\n    }))\\n    assert code == 302, body\\n    assert headers['Location'] == '/?connected=1'\\n    assert calls == [(server.TOKEN_URL, {\\n        'client_id': config.CLIENT_ID,\\n        'client_secret': config.CLIENT_SECRET,\\n        'code': 'test-code',\\n    })]\\n    connection = server.CONNECTIONS['u_okafor']\\n    assert connection['status'] == 'connected'\\n    assert connection['access_token'] == 'perpetual-token'\\n    assert 'expires_at' not in connection and 'refresh_token' not in connection\\n\\n    code, body, _ = request('/api/intervals/status', headers=auth)\\n    assert code == 200 and body['connected'] is True\\n    assert body['athlete']['id'] == 'i123'\\n\\n    server.intervals_get = lambda conn, path: (200, {'path': path, 'athlete': conn['athlete_id']})\\n    code, body, _ = request('/api/intervals/wellness', headers=auth)\\n    assert (code, body) == (200, {'path': '/wellness', 'athlete': 'i123'})\\n\\n    def revoked(conn, path):\\n        raise urllib.error.HTTPError('http://local.test', 401, 'Unauthorized', {}, io.BytesIO(b'{}'))\\n    server.intervals_get = revoked\\n    code, body, _ = request('/api/intervals/wellness', headers=auth)\\n    assert code == 401\\n    assert server.CONNECTIONS['u_okafor']['access_token'] is None\\n    code, body, _ = request('/api/intervals/status', headers=auth)\\n    assert body == {'connected': False, 'status': 'revoked, reconnect'}\\n\\n    code, body, _ = request('/api/intervals/auth/init', 'POST', auth)\\n    state = dict(urllib.parse.parse_qsl(urllib.parse.urlsplit(body['authorize_url']).query))['state']\\n    athlete_id = 'i999'\\n    code, body, _ = request('/api/intervals/callback?' + urllib.parse.urlencode({\\n        'code': 'other-account', 'state': state,\\n    }))\\n    assert code == 409\\n    assert server.CONNECTIONS['u_okafor']['athlete_id'] == 'i123'\\n\\n    print('PASS: local OAuth init/callback/token/storage/wellness/401/mismatch flow')\\nfinally:\\n    httpd.shutdown()\\n    httpd.server_close()\\n    thread.join()\\nPY\",\"cwd\":\"/private/tmp/h-Tpzz6H\",\"timeout\":60}"}}]}
