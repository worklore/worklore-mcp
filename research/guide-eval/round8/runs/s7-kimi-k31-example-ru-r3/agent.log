thorize_url})\n \n     # Step 2: Intervals redirects back here with ?code=&state=.\n     def callback(self, q):\n@@ -201,6 +167,11 @@ class Handler(BaseHTTPRequestHandler):\n             return self.send_json(400, {\"error\": \"bad state or code\"})\n         try:\n             tok = exchange_code(q[\"code\"])\n+            athlete_id = (tok.get(\"athlete\") or {}).get(\"id\")\n+            with LOCK:\n+                existing = CONNECTIONS.get(user_id)\n+            if existing and existing.get(\"athlete_id\") and existing[\"athlete_id\"] != athlete_id:\n+                return self.send_json(409, {\"error\": \"Intervals.icu account does not match the connected athlete\"})\n             store_connection(user_id, tok)\n         except urllib.error.HTTPError as e:\n             log(f\"{user_id}: token exchange failed: HTTP {e.code} {e.read()[:200]!r}\")\n@@ -233,12 +204,17 @@ class Handler(BaseHTTPRequestHandler):\n             code, data = intervals_get(c, \"/wellness\")\n             self.send_json(code, data)\n         except urllib.error.HTTPError as e:\n+            if e.code == 401:\n+                with LOCK:\n+                    if CONNECTIONS.get(user[\"id\"]) is c:\n+                        c.update(status=\"revoked, reconnect\", access_token=None)\n+                log(f\"{user['id']}: Intervals.icu returned 401 -> revoked, reconnect\")\n+                return self.send_json(401, {\"error\": \"Intervals.icu authorization was revoked; reconnect\"})\n             self.send_json(e.code, {\"error\": f\"intervals returned {e.code}\"})\n         except Exception as e:\n             self.send_json(502, {\"error\": str(e)})\n \n \n if __name__ == \"__main__\":\n-    threading.Thread(target=refresh_tokens, daemon=True).start()\n     log(f\"serving on http://localhost:{config.PORT} (intervals: {config.INTERVALS_BASE})\")\n     ThreadingHTTPServer((\"127.0.0.1\", config.PORT), Handler).serve_forever()\ndiff --git a/static/app.js b/static/app.js\nindex 368922e..11