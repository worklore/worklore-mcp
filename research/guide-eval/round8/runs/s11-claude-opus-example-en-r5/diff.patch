 import logging
 import re
 import time
+from decimal import Decimal
 
 log = logging.getLogger("stories")
 
@@ -40,6 +41,22 @@ def related(story, existing):
     return scored[:TOP_N]
 
 
+def to_dynamo(value):
+    """Convert ``value`` into something boto3 can serialize for DynamoDB.
+
+    DynamoDB numbers must be int or Decimal; boto3 rejects Python floats.
+    Floats become Decimal via ``str()`` so 0.1234 is stored as 0.1234, not as
+    its binary expansion. Applied to every item right before ``put_item``.
+    """
+    if isinstance(value, float):
+        return Decimal(str(value))
+    if isinstance(value, dict):
+        return {k: to_dynamo(v) for k, v in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [to_dynamo(v) for v in value]
+    return value
+
+
