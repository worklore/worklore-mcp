{"role":"tool","tool_call_id":"tool_99zrWvtUJr8qqFTgATSn1VUR","content":"110\t\n111\t    def redirect(self, url):\n112\t        self.send_response(302)\n113\t        self.send_header(\"Location\", url)\n114\t        self.end_headers()\n115\t\n116\t    def current_user(self):\n117\t        auth = self.headers.get(\"Authorization\", \"\")\n118\t        if not auth.startswith(\"Bearer \"):\n119\t            return None\n120\t        return USERS.get(auth[7:].strip())\n121\t\n122\t    def require_user(self):\n123\t        user = self.current_user()\n124\t        if user is None:\n125\t            self.log_message(\"%s %s 401 (no Authorization header)\", self.command, self.path)\n126\t            self.send_json(401, {\"error\": \"unauthorized\"})\n127\t        return user\n128\t\n129\t    def do_GET(self):\n130\t        url = urllib.parse.urlsplit(self.path)\n131\t        q = dict(urllib.parse.parse_qsl(url.query))\n132\t        if url.path == \"/\":\n133\t            return self.send_file(\"index.html\", \"text/html; charset=utf-8\")\n134\t        if url.path.startswith(\"/static/\"):\n135\t            return self.send_file(os.path.basename(url.path), \"application/javascript\" if url.path.endswith(\".js\") else \"text/plain\")\n136\t        if url.path == \"/api/me\":\n137\t            user = self.require_user()\n138\t            return user and self.send_json(200, user)\n139\t        if url.path == \"/api/intervals/auth/init\":\n140\t            return self.auth_init()\n141\t        if url.path == \"/api/intervals/callback\":\n142\t            return self.callback(q)\n143\t        if url.path == \"/api/intervals/status\":\n144\t            return self.status()\n145\t        if url.path == \"/api/intervals/wellness\":\n146\t            return self.wellness()\n147\t        self.send_json(404, {\"error\": \"not found\"})\n148\t\n149\t    def do_POST(self):\n150\t        url = urllib.parse.urlsplit(self.path)\n151\t        if url.path == \"/api/intervals/disconnect\":\n152\t            user = self.require_user()\n153\t            if user:\n154\t                with LOCK:\n155\t                    CONNECTIONS.pop(user[\"id\"], None)\n156\t                self.send_json(200, {\"ok\": True})\n157\t            return\n158\t        self.send_json(404, {\"error\": \"not found\"})\n159\t\n160\t    # Step 1: build the authorize URL and send the browser to Intervals.\n161\t    def auth_init(self):\n162\t        user = self.require_user()\n163\t        if not user:\n164\t            return\n165\t        params = {\"client_id\": config.CLIENT_ID, \"redirect_uri\": config.REDIRECT_URI,\n166\t                  \"scope\": config.SCOPES, \"state\": sign_state(user[\"id\"])}\n167\t        self.redirect(AUTHORIZE_URL + \"?\" + urllib.parse.urlencode(params, safe=\":,\"))\n168\t\n169\t    # Step 2: Intervals redirects back here with ?code=&state=.\n170\t    def callback(self, q):\n171\t        user_id = verify_state(q.get(\"state\", \"\"))\n172\t        if not user_id or not q.get(\"code\"):\n173\t            return self.send_json(400, {\"error\": \"bad state or code\"})\n174\t        try:\n175\t            tok = exchange_code(q[\"code\"])\n176\t            store_connection(user_id, tok)\n177\t        except urllib.error.HTTPError as e:\n178\t            log(f\"{user_id}: token exchange failed: HTTP {e.code} {e.read()[:200]!r}\")\n179\t            return self.send_json(502, {\"error\": \"token exchange failed\"})\n180\t        except Exception as e:\n181\t            log(f\"{user_id}: token exchange failed: {e}\")\n182\t            return self.send_json(502, {\"error\": \"token exchange failed\"})\n183\t        self.redirect(\"/?connected=1\")\n184\t\n185\t    def status(self):\n186\t        user = self.require_user()\n187\t        if not user:\n188\t            return\n189\t        with LOCK:\n190\t            c = CONNECTIONS.get(user[\"id\"])\n191\t        if not c or c[\"status\"] != \"connected\":\n192\t            return self.send_json(200, {\"connected\": False, \"status\": c[\"status\"] if c else \"disconnected\"})\n193\t        self.send_json(200, {\"connected\": True, \"status\": \"connected\", \"scope\": c[\"scope\"],\n194\t                             \"athlete\": {\"id\": c[\"athlete_id\"], \"name\": c[\"athlete_name\"]}})\n195\t\n196\t    def wellness(self):\n197\t        user = self.require_user()\n198\t        if not user:\n199\t            return\n200\t        with LOCK:\n201\t            c = CONNECTIONS.get(user[\"id\"])\n202\t        if not c or c[\"status\"] != \"connected\":\n203\t            return self.send_json(409, {\"error\": \"intervals not connected\"})\n204\t        try:\n205\t            code, data = intervals_get(c, \"/wellness\")\n206\t            self.send_json(code, data)\n207\t        except urllib.error.HTTPError as e:\n208\t            self.send_json(e.code, {\"error\": f\"intervals returned {e.code}\"})\n209\t        except Exception as e:\n210\t            self.send_json(502, {\"error\": str(e)})\n211\t\n212\t\n213\tif __name__ == \"__main__\":\n214\t    threading.Thread(target=refresh_tokens, daemon=True).start()\n215\t    log(f\"serving on http://localhost:{config.PORT} (intervals: {config.INTERVALS_BASE})\")\n216\t    ThreadingHTTPServer((\"127.0.0.1\", config.PORT), Handler).serve_forever()"}
