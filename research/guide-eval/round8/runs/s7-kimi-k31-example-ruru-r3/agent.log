erve_forever, daemon=True).start()\\nbase = \\\"http://127.0.0.1:%d\\\" % app.server_port\\nclass NoRedirect(urllib.request.HTTPRedirectHandler):\\n    def redirect_request(self, *args): return None\\nopener = urllib.request.build_opener(NoRedirect)\\ndef call(path, method=\\\"GET\\\", auth=True):\\n    req = urllib.request.Request(base + path, method=method,\\n                                 headers={\\\"Authorization\\\": \\\"Bearer tok-okafor\\\"} if auth else {})\\n    try:\\n        with opener.open(req) as response:\\n            raw = response.read().decode()\\n            return response.status, dict(response.headers), json.loads(raw) if raw else None\\n    except urllib.error.HTTPError as error:\\n        raw = error.read().decode()\\n        return error.code, dict(error.headers), json.loads(raw) if raw else None\\n\\ndef check(name, condition, details):\\n    if not condition: raise AssertionError(f\\\"{name}: {details!r}\\\")\\n    print(\\\"PASS\\\", name)\\n\\ntry:\\n    result = call(\\\"/api/intervals/auth/init\\\", auth=False)\\n    check(\\\"unauthorized POST init\\\", result[0] == 401, result)\\n    result = call(\\\"/api/intervals/auth/init\\\")\\n    check(\\\"old GET init disabled\\\", result[0] == 404, result)\\n    result = call(\\\"/api/intervals/auth/init\\\", method=\\\"POST\\\")\\n    check(\\\"POST init\\\", result[0] == 200, result)\\n    query = dict(urllib.parse.parse_qsl(urllib.parse.urlsplit(result[2][\\\"authorize_url\\\"]).query))\\n    check(\\\"scopes\\\", query[\\\"scope\\\"] == \\\"ACTIVITY:WRITE,WELLNESS:READ,CALENDAR:WRITE\\\", query)\\n    check(\\\"state\\\", server.verify_state(query[\\\"state\\\"]) == \\\"u_okafor\\\", query[\\\"state\\\"])\\n    path = \\\"/api/intervals/callback?\\\" + urllib.parse.urlencode({\\\"code\\\": \\\"local-code\\\", \\\"state\\\": query[\\\"state\\\"]})\\n    result = call(path, auth=False)\\n    check(\\\"callback\\\", result[0] == 302 and result[1].get(\\\"Location\\\") == \\\"/?connected=1\\\", result)\\n    expected = {\\\"client_id\\\": server.config.CLIENT_ID, \\\"client_secret\\\": server.config.CLIENT_SECRET, \\\"code\\\": \\\"local-code\\\"}\\n    check(\\\"token fields\\\", state[\\\"fields\\\"] == expected, state[\\\"fields\\\"])\\n    result = call(\\\"/api/intervals/status\\\")\\n    check(\\\"connected status\\\", result[0] == 200 and result[2][\\\"connected\\\"] and result[2][\\\"athlete\\\"][\\\"id\\\"] == \\\"i98765\\\", result)\\n    connection = server.CONNECTIONS[\\\"u_okafor\\\"]\\n    check(\\\"no artificial expiry\\\", \\\"expires_at\\\" not in connection and \\\"refresh_token\\\" not in connection, connection)\\n    result = call(\\\"/api/intervals/wellness\\\")\\n    check(\\\"wellness\\\", result[0] == 200 and result[2] == {\\\"wellness\\\": [{\\\"id\\\": 1}]}, result)\\n    state[\\\"revoked\\\"] = True\\n    result = call(\\\"/api/intervals/wellness\\\")\\n    check(\\\"revoked API response\\\", result[0] == 409, result)\\n    result = call(\\\"/api/intervals/status\\\")\\n    check(\\\"reconnect status\\\", result[0] == 200 and result[2] == {\\\"connected\\\": False, \\\"status\\\": \\\"revoked, reconnect\\\"}, result)\\n    check(\\\"token cleared\\\", server.CONNECTIONS[\\\"u_okafor\\\"][\\\"access_token\\\"] is None, server.CONNECTIONS)\\nfinally:\\n    app.shutdown(); provider.shutdown(); app.server_close(); provider.server_close()\\nPY\",\"cwd\":\"/private/tmp/h-xkg2kz\",\"timeout\":60}"}}]}
