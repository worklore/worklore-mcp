p \"$PROMPT\" --output-format text > \"$OUT\"\nstatus=$?\n\nif [ $status -ne 0 ]; then\n  \"$NOTIFY\" \"nightly review FAILED (exit $status), see $OUT\"\n  exit $status\nfi\n\n\"$NOTIFY\" \"nightly review done: $(head -c 300 \"$OUT\")\"\n","structuredPatch":[{"oldStart":15,"oldLines":12,"newStart":15,"newLines":23,"lines":[" "," cd \"$REPO\" || { \"$NOTIFY\" \"nightly review: repo missing\"; exit 1; }"," ","-claude -p \"$PROMPT\" --output-format text > \"$OUT\"","-status=$?","+# `status` is read-only in zsh: assigning to it kills the script before the","+# notification below runs. Use rc instead.","+# </dev/null: under launchd stdin may be open, and claude would wait on it.","+start=$SECONDS","+claude -p \"$PROMPT\" --output-format text < /dev/null > \"$OUT\"","+rc=$?","+echo \"$(date '+%F %T') exit=$rc duration=$((SECONDS - start))s\""," ","-if [ $status -ne 0 ]; then","-  \"$NOTIFY\" \"nightly review FAILED (exit $status), see $OUT\"","-  exit $status","+if [ $rc -ne 0 ]; then","+  \"$NOTIFY\" \"nightly review FAILED (exit $rc), see $OUT\"","+  exit $rc"," fi"," ","+# exit 0 with empty output is still a failure","+if [ ! -s \"$OUT\" ]; then","+  \"$NOTIFY\" \"nightly review FAILED (empty output), see $OUT\"","+  exit 1","+fi","+"," \"$NOTIFY\" \"nightly review done: $(head -c 300 \"$OUT\")\""]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"tool_result_meta":[{"id":"toolu_01ER1vBqoQn61FVrVGcNuV8j","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
