","old_string":"claude -p \"$PROMPT\" --output-format text > \"$OUT\"\nstatus=$?\n\nif [ $status -ne 0 ]; then\n  \"$NOTIFY\" \"nightly review FAILED (exit $status), see $OUT\"\n  exit $status\nfi\n\n\"$NOTIFY\" \"nightly review done: $(head -c 300 \"$OUT\")\"","new_string":"# `status` is read-only in zsh: assigning to it kills the script before the\n# notification below runs. Use rc instead.\n# </dev/null: under launchd stdin may be open, and claude would wait on it.\nstart=$SECONDS\nclaude -p \"$PROMPT\" --output-format text < /dev/null > \"$OUT\"\nrc=$?\necho \"$(date '+%F %T') exit=$rc duration=$((SECONDS - start))s\"\n\nif [ $rc -ne 0 ]; then\n  \"$NOTIFY\" \"nightly review FAILED (exit $rc), see $OUT\"\n  exit $rc\nfi\n\n# exit 0 with empty output is still a failure\nif [ ! -s \"$OUT\" ]; then\n  \"$NOTIFY\" \"nightly review FAILED (empty output), see $OUT\"\n  exit 1\nfi\n\n\"$NOTIFY\" \"nightly review done: $(head -c 300 \"$OUT\")\""}}}
