diff --git a/bin/nightly-review.zsh b/bin/nightly-review.zsh
index e0b986f..6bdd8b0 100755
--- a/bin/nightly-review.zsh
+++ b/bin/nightly-review.zsh
@@ -15,12 +15,23 @@ Do not modify any file."
 
 cd "$REPO" || { "$NOTIFY" "nightly review: repo missing"; exit 1; }
 
-claude -p "$PROMPT" --output-format text > "$OUT"
-status=$?
+# `status` is read-only in zsh: assigning to it kills the script before the
+# notification below runs. Use rc instead.
+# </dev/null: under launchd stdin may be open, and claude would wait on it.
+start=$SECONDS
+claude -p "$PROMPT" --output-format text < /dev/null > "$OUT"
+rc=$?
+echo "$(date '+%F %T') exit=$rc duration=$((SECONDS - start))s"
 
-if [ $status -ne 0 ]; then
-  "$NOTIFY" "nightly review FAILED (exit $status), see $OUT"
-  exit $status
+if [ $rc -ne 0 ]; then
+  "$NOTIFY" "nightly review FAILED (exit $rc), see $OUT"
+  exit $rc
+fi
+
+# exit 0 with empty output is still a failure
+if [ ! -s "$OUT" ]; then
+  "$NOTIFY" "nightly review FAILED (empty output), see $OUT"
+  exit 1
 fi
 
 "$NOTIFY" "nightly review done: $(head -c 300 "$OUT")"
