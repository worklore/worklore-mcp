{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011CgRy1KUCgD3epRwSGwcNr","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_017s8EsYy9UszXaBAgpecf49","name":"Write","input":{"file_path":"/private/tmp/h-Z4EoSw/test/tmp_analytics_events_test.dart","content":"import 'package:flutter/material.dart';\nimport 'package:flutter/services.dart';\nimport 'package:flutter_test/flutter_test.dart';\nimport 'package:kredito/screens/offer_screen.dart';\nimport 'package:kredito/screens/registration_screen.dart';\n\nconst _channel = MethodChannel('posthog_flutter');\n\nvoid main() {\n  late List<MethodCall> calls;\n\n  setUp(() {\n    calls = [];\n    TestDefaultBinaryMessengerBinding.instance.defaultBinaryMessenger\n        .setMockMethodCallHandler(_channel, (call) async {\n      calls.add(call);\n      return null;\n    });\n  });\n\n  tearDown(() {\n    TestDefaultBinaryMessengerBinding.instance.defaultBinaryMessenger\n        .setMockMethodCallHandler(_channel, null);\n  });\n\n  List<MethodCall> captured(String event) => calls\n      .where((c) => c.method == 'capture' && c.arguments['event'] == event)\n      .toList();\n\n  Future<void> pumpApp(WidgetTester tester) => tester.pumpWidget(\n        MaterialApp(\n          home: const RegistrationScreen(),\n          routes: {'/offers': (_) => const OfferScreen()},\n        ),\n      );\n\n  testWidgets('email and phone start events fire once per screen visit',\n      (tester) async {\n    await pumpApp(tester);\n    final email = find.widgetWithText(TextField, 'Email');\n    final phone = find.widgetWithText(TextField, 'Phone');\n\n    for (final s in ['a', 'ab', 'abc', 'abcd@x.com']) {\n      await tester.enterText(email, s);\n    }\n    for (final s in ['1', '12', '123456789012']) {\n      await tester.enterText(phone, s);\n    }\n    await tester.pump();\n\n    expect(captured('registration_email_started'), hasLength(1));\n    expect(captured('registration_phone_started'), hasLength(1));\n    // No PII in properties.\n    expect(captured('registration_email_started').single.arguments['properties'],\n        isNull);\n  });\n\n  testWidgets('loan amount fires once per drag with the final amount',\n      (tester) async {\n    await pumpApp(tester);\n    final slider = find.byType(Slider);\n    await tester.drag(slider, const Offset(120, 0));\n    await tester.pump();\n\n    final events = captured('loan_amount_changed');\n    expect(events, hasLength(1));\n    final amount = events.single.arguments['properties']['amount'] as int;\n    expect(amount, isNot(50000));\n    expect(amount, inInclusiveRange(10000, 500000));\n  });\n\n  testWidgets('terms fires on tick only, continue carries amount and terms',\n      (tester) async {\n    await pumpApp(tester);\n    await tester.enterText(find.widgetWithText(TextField, 'Email'), 'a@b.c');\n    await tester.enterText(\n        find.widgetWithText(TextField, 'Phone'), '1234567890');\n    final box = find.byType(CheckboxListTile);\n    await tester.tap(box);\n    await tester.pump();\n    await tester.tap(box); // untick\n    await tester.pump();\n    await tester.tap(box); // tick again\n    await tester.pump();\n\n    expect(captured('terms_accepted'), hasLength(2));\n\n    await tester.tap(find.widgetWithText(FilledButton, 'Continue'));\n    await tester.pumpAndSettle();\n\n    final cont = captured('registration_continue_tapped');\n    expect(cont, hasLength(1));\n    expect(cont.single.arguments['properties'],\n        {'amount': 50000, 'terms': true});\n    // Navigated to offers.\n    expect(find.text('Offers'), findsOneWidget);\n  });\n\n  testWidgets('offers scroll fires once per scroll end with pixel offset',\n      (tester) async {\n    await pumpApp(tester);\n    await tester.enterText(find.widgetWithText(TextField, 'Email'), 'a@b.c');\n    await tester.enterText(\n        find.widgetWithText(TextField, 'Phone'), '1234567890');\n    await tester.tap(find.byType(CheckboxListTile));\n    await tester.pump();\n    await tester.tap(find.widgetWithText(FilledButton, 'Continue'));\n    await tester.pumpAndSettle();\n\n    await tester.drag(find.byType(ListView), const Offset(0, -300));\n    await tester.pumpAndSettle();\n\n    final events = captured('offers_scrolled');\n    expect(events, hasLength(1));\n    final offset = events.single.arguments['properties']['offset'];\n    expect(offset, isA<double>());\n    expect(offset as double, greaterThan(0));\n  });\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2783,"cache_read_input_tokens":37242,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2783},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"5ad94870-3c61-4453-91aa-26892d809584","uuid":"eff8c148-58ff-47c9-a07c-59e79499bbe4","timestamp":"2026-10-27T02:38:44.454Z","request_id":"req_011CgRy1KDa44SK4fmFkRzdG","wire_tool_inputs":{"toolu_017s8EsYy9UszXaBAgpecf49":{"file_path":"/private/tmp/h-Z4EoSw/test/tmp_analytics_events_test.dart","content":"import 'package:flutter/material.dart';\nimport 'package:flutter/services.dart';\nimport 'package:flutter_test/flutter_test.dart';\nimport 'package:kredito/screens/offer_screen.dart';\nimport 'package:kredito/screens/registration_screen.dart';\n\nconst _channel = MethodChannel('posthog_flutter');\n\nvoid main() {\n  late List<MethodCall> calls;\n\n  setUp(() {\n    calls = [];\n    TestDefaultBinaryMessengerBinding.instance.defaultBinaryMessenger\n        .setMockMethodCallHandler(_channel, (call) async {\n      calls.add(call);\n      return null;\n    });\n  });\n\n  tearDown(() {\n    TestDefaultBinaryMessengerBinding.instance.defaultBinaryMessenger\n        .setMockMethodCallHandler(_channel, null);\n  });\n\n  List<Met