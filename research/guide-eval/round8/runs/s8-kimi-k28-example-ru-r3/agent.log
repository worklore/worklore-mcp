e-stable across save_fact\\\"\\nassert s1[1][\\\"text\\\"] != s2[1][\\\"text\\\"] and \\\"test fact\\\" in s2[1][\\\"text\\\"], \\\"tail must change after save_fact\\\"\\nassert r1[\\\"tools\\\"] == r2[\\\"tools\\\"], \\\"tools stay byte-stable within a message\\\"\\n\\n# static block identical across athletes and days; only the tail differs\\nsys_a = bot.build_system(bot.load_athlete(\\\"42\\\"), dt.date(2026, 11, 8))\\nsys_b = bot.build_system(bot.load_athlete(\\\"77\\\"), dt.date(2026, 4, 18))\\nassert sys_a[0][\\\"text\\\"] == sys_b[0][\\\"text\\\"]\\nassert sys_a[1][\\\"text\\\"] != sys_b[1][\\\"text\\\"]\\nassert \\\"2026-11-08\\\" not in sys_a[0][\\\"text\\\"] and \\\"Marta\\\" not in sys_a[0][\\\"text\\\"], \\\"no interpolated values in static block\\\"\\n\\nprint(\\\"all checks passed\\\")\\nEOF\"}"}}]}
