 post_form(TOKEN_URL, {\n                        \"grant_type\": \"refresh_token\", \"refresh_token\": c[\"refresh_token\"],\n                        \"client_id\": config.CLIENT_ID, \"client_secret\": config.CLIENT_SECRET,\n                    })\n                    c.update(access_token=tok[\"access_token\"],\n                             refresh_token=tok.get(\"refresh_token\", c[\"refresh_token\"]),\n                             expires_at=now + int(tok[\"expires_in\"]))\n                    log(f\"{uid}: token refreshed\")\n                except Exception as e:\n                    log(f\"{uid}: refresh failed ({e}) -> expired, reconnect\")\n                    c.update(status=\"expired, reconnect\", access_token=None)\n\n\ndef intervals_get(conn, path):","new_string":"def exchange_code(code):\n    return post_form(TOKEN_URL, {\n        \"grant_type\": \"authorization_code\", \"client_id\": config.CLIENT_ID,\n        \"client_secret\": config.CLIENT_SECRET, \"code\": code, \"redirect_uri\": config.REDIRECT_URI,\n    })\n\n\ndef store_connection(user_id, tok):\n    # Intervals issues no refresh_token and no expires_in: the access token lives until the\n    # athlete revokes the app. Nothing to schedule here; a 401 from the API is what marks it dead.\n    athlete = tok.get(\"athlete\") or {}\n    with LOCK:\n        CONNECTIONS[user_id] = {\n            \"athlete_id\": athlete.get(\"id\"), \"athlete_name\": athlete.get(\"name\"),\n            \"access_token\": tok[\"access_token\"], \"scope\": tok.get(\"scope\"), \"status\": \"connected\",\n        }\n    log(f\"{user_id}: connected as athlete {athlete.get('id')} (scope {tok.get('scope')})\")\n\n\ndef intervals_get(conn, path):"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":613,"cache_read_input_tokens":42370,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":613},"output