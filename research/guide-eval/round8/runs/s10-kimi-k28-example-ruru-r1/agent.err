name: kredito
description: Consumer loan registration and offers.
publish_to: "none"
version: 1.3.0+27

environment:
  sdk: ^3.5.0

dependencies:
  flutter:
    sdk: flutter
  posthog_flutter: ^5.36.0

dev_dependencies:
  flutter_test:
    sdk: flutter
  flutter_lints: ^5.0.0

flutter:
  uses-material-design: true
