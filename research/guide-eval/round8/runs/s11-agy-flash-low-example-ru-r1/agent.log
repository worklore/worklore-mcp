{"event":"step_update","step_update":{"conversation_id":"90d5951e-c55a-4668-be51-c1032b758a2d","step_index":28,"state":"DONE","step_type":"tool","tool_name":"run_command","duration_seconds":0.081117,"tool_info":{"name":"run_command","parameters":{"CommandLine":"git diff"},"output":"Command exited with code 0.\n\nCommand output:\ndiff --git a/src/app.py b/src/app.py\r\nindex db49c5e..5931a84 100644\r\n--- a/src/app.py\r\n+++ b/src/app.py\r\n@@ -4,6 +4,7 @@ Each story is stored in one DynamoDB item together with the three most similar\r\n stories already in the library (``similar``), so the reader page can show\r\n \"related\" without a query at read time.\r\n \"\"\"\r\n+from decimal import Decimal\r\n import json\r\n import logging\r\n import re\r\n@@ -27,7 +28,7 @@ def similarity(a, b):\r\n     tag_score = len(ta \u0026 tb) / len(ta | tb) if (ta | tb) else 0\r\n     wa, wb = words(a.get(\"body\")), words(b.get(\"body\"))\r\n     word_score = len(wa \u0026 wb) / len(wa | wb) if (wa | wb) else 0\r\n-    return round(0.7 * tag_score + 0.3 * word_score, 4)\r\n+    return Decimal(str(round(0.7 * tag_score + 0.3 * word_score, 4)))\r\n \r\n \r\n def related(story, existing):\r\ndiff --git a/tests/test_publish.py b/tests/test_publish.py\r\nindex 6c9ac44..2de96bd 100644\r\n--- a/tests/test_publish.py\r\n+++ b/tests/test_publish.py\r\n@@ -23,6 +23,45 @@ class PublishTest(unittest.TestCase):\r\n         self.assertEqual(table.get_item(Key={\"slug\": \"why-my-cron-ran-twice\"})[\"Item\"][\"title\"], \"Why my cron ran twice\")\r\n         self.assertEqual(table.scan()[\"Count\"], 1)\r\n \r\n+    def test_publish_second_story_succeeds(self):\r\n+        table = FakeTable()\r\n+        story1 = {\r\n+            \"slug\": \"why-my-cron-ran-twice\",\r\n+            \"title\": \"Why my cron ran twice\",\r\n+            \"tags\": [\"cron\", \"linux\"],\r\n+            \"body\": \"Two crontabs, one for root and one for me, both had the line.\",\r\n+        }\r\n+        story2 = {\r\n+            \"slug\": \"dynamodb-crash-second-write\",\r\n+            \"title\": \"DynamoDB crash on second write\",\r\n+            \"tags\": [\"dynamodb\", \"cron\"],\r\n+            \"body\": \"The first write survived, but the second one failed due to float similarity scores.\",\r\n+        }\r\n+        app.publish(table, story1)\r\n+        stored2 = app.publish(table, story2)\r\n+        self.assertEqual(len(stored2[\"similar\"]), 1)\r\n+        self.assertEqual(stored2[\"similar\"][0][\"slug\"], \"why-my-cron-ran-twice\")\r\n+        self.assertEqual(table.scan()[\"Count\"], 2)\r\n+\r\n+    def test_handler_second_publish_returns_201(self):\r\r\n+        table = FakeTable()\r\n+        story1 = {\r\n+            \"slug\": \"first-story\",\r\n+            \"title\": \"First Story\",\r\n+            \"tags\": [\"test\"],\r\n+            \"body\": \"Hello world\",\r\n+        }\r\n+        story2 = {\r\n+            \"slug\": \"second-story\",\r\n+            \"title\": \"Second Story\",\r\n+            \"tags\": [\"test\"],\r\n+            \"body\": \"Hello world again\",\r\n+        }\r\n+        res1 = app.handler({\"body\": app.json.dumps(story1)}, table)\r\n+        self.assertEqual(res1[\"statusCode\"], 201)\r\n+        res2 = app.handler({\"body\": app.json.dumps(story2)}, table)\r\n+        self.assertEqual(res2[\"statusCode\"], 201)\r\n+\r\n \r\n if __name__ == \"__main__\":\r\n     unittest.main()\r\n"}}}
