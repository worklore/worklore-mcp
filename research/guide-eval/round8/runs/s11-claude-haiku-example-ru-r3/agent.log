{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NRPRQJuEFGy1NyShNDVxoB","type":"tool_result","content":"The file /private/tmp/h-9e5Hha/src/app.py has been updated successfully."}]},"parent_tool_use_id":null,"session_id":"6fdb8cfb-ab73-468f-8762-3b018399044d","uuid":"cf3ab0ff-45a1-47a0-a09d-744e6f796d1f","timestamp":"2026-10-27T03:51:58.999Z","tool_use_result":{"filePath":"/private/tmp/h-9e5Hha/src/app.py","oldString":"    table.put_item(Item=to_dynamo(item))\n    log.info(\"publish slug=%s similar=%d stored\", item[\"slug\"], len(item[\"similar\"]))\n    return item","newString":"    item = to_dynamo(item)\n    table.put_item(Item=item)\n    log.info(\"publish slug=%s similar=%d stored\", item[\"slug\"], len(item[\"similar\"]))\n    return item","originalFile":"\"\"\"Story library: the publish handler.\n\nEach story is stored in one DynamoDB item together with the three most similar\nstories already in the library (``similar``), so the reader page can show\n\"related\" without a query at read time.\n\"\"\"\nimport json\nimport logging\nimport re\nimport time\nfrom decimal import Decimal\n\nlog = logging.getLogger(\"stories\")\n\nTABLE_NAME = \"stories\"\nTOP_N = 3\n\n_WORD = re.compile(r\"[a-z0-9]+\")\n\n\ndef words(text):\n    return set(_WORD.findall((text or \"\").lower()))\n\n\ndef similarity(a, b):\n    \"\"\"Shared-tag ratio (Jaccard), blended with shared words of the two bodies.\"\"\"\n    ta, tb = set(a.get(\"tags\", [])), set(b.get(\"tags\", []))\n    tag_score = len(ta & tb) / len(ta | tb) if (ta | tb) else 0\n    wa, wb = words(a.get(\"body\")), words(b.get(\"body\"))\n    word_score = len(wa & wb) / len(wa | wb) if (wa | wb) else 0\n    return round(0.7 * tag_score + 0.3 * word_score, 4)\n\n\ndef related(story, existing):\n    scored = []\n    for other in existing:\n        if other[\"slug\"] == story[\"slug\"]:\n            continue\n        scored.append({\"slug\": other[\"slug\"], \"score\": similarity(story, other)})\n    scored.sort(key=lambda s: s[\"score\"], reverse=True)\n    return scored[:TOP_N]\n\n\ndef to_dynamo(value):\n    \"\"\"Return ``value`` with every float replaced by a Decimal.\n\n    DynamoDB (boto3) rejects Python floats. Scores are computed as floats, and\n    they only show up once the table has other stories to compare with, so this\n    runs on every item right before ``put_item``.\n    \"\"\"\n    if isinstance(value, float):\n        return Decimal(str(value))\n    if isinstance(value, dict):\n        return {k: to_dynamo(v) for k, v in value.items()}\n    if isinstance(value, (list, tuple)):\n        return [to_dynamo(v) for v in value]\n    return value\n\n\ndef validate(story):\n    for k in (\"slug\", \"title\", \"body\"):\n        if not story.get(k):\n            raise ValueError(f\"missing field: {k}\")\n    if not re.fullmatch(r\"[a-z0-9-]{3,80}\", story[\"slug\"]):\n        raise ValueError(\"bad slug\")\n\n\ndef publish(table, story):\n    \"\"\"Store ``story`` with its related stories. Returns the stored item.\"\"\"\n    validate(story)\n    existing = table.scan(TableName=TABLE_NAME).get(\"Items\", [])\n    item = {\n        \"slug\": story[\"slug\"],\n        \"title\": story[\"title\"],\n        \"tags\": sorted(set(story.get(\"tags\", []))),\n        \"body\": story[\"body\"],\n        \"published_at\": int(time.time()),\n        \"similar\": related(story, existing),\n    }\n    table.put_item(Item=to_dynamo(item))\n    log.info(\"publish slug=%s similar=%d stored\", item[\"slug\"], len(item[\"similar\"]))\n    return item\n\n\ndef handler(event, table):\n    \"\"\"Lambda-style entry point for POST /stories. Body is the story as JSON.\"\"\"\n    try:\n        story = json.loads(event.get(\"body\") or \"{}\")\n        stored = publish(table, story)\n        return {\"statusCode\": 201, \"body\": json.dumps({\"slug\": stored[\"slug\"]})}\n    except ValueError as e:\n        return {\"statusCode\": 400, \"body\": json.dumps({\"error\": str(e)})}\n    except Exception:\n        log.exception(\"publish failed\")\n        return {\"statusCode\": 500, \"body\": json.dumps({\"error\": \"Internal Server Error\"})}\n","structuredPatch":[{"oldStart":77,"oldLines":7,"newStart":77,"newLines":8,"lines":["         \"published_at\": int(time.time()),","         \"similar\": related(story, existing),","     }","-    table.put_item(Item=to_dynamo(item))","+    item = to_dynamo(item)","+    table.put_item(Item=item)","     log.info(\"publish slug=%s similar=%d stored\", item[\"slug\"], len(item[\"similar\"]))","     return item"," "]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"tool_result_meta":[{"id":"toolu_01NRPRQJuEFGy1NyShNDVxoB","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
