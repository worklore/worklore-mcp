can()[\"Count\"], 3)\n\n    def test_to_dynamo_converts_nested_floats(self):\n        out = app.to_dynamo({\"a\": 0.5, \"b\": [{\"c\": 0.25}], \"d\": 3, \"e\": \"x\"})\n        self.assertEqual(out, {\"a\": Decimal(\"0.5\"), \"b\": [{\"c\": Decimal(\"0.25\")}], \"d\": 3, \"e\": \"x\"})\n"}}}
