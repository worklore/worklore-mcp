he"," whole prefix (tools, then system blocks) up to it, only if that prefix is at least"," MIN_CACHE_TOKENS; a hit needs the prefix to be identical byte for byte. Token","-counts are a chars/3.3 estimate plus a tool-use overhead, calibrated so the","+counts are a chars/3.6 estimate plus a tool-use overhead, calibrated so the"," default prompt lands near the ~1024-1046 tokens seen in logs/usage.jsonl."," \"\"\""," import json, os, shutil, sys, tempfile, types"]},{"oldStart":12,"oldLines":8,"newStart":13,"newLines":8,"lines":[" import bot"," "," MIN_CACHE_TOKENS = 1024          # Sonnet 4.5","-tok = lambda s: round(len(s) / 3.3)","-TOOL_OVERHEAD = 220","+tok = lambda s: round(len(s) / 3.6)","+TOOL_OVERHEAD = 150"," "," "," class FakeLLM:"]},{"oldStart":51,"oldLines":7,"newStart":52,"newLines":16,"lines":["         return types.SimpleNamespace(content=[text], stop_reason=\"end_turn\", usage=usage)"," "," ","+def naive_two_markers(a, today, n_cached):","+    \"\"\"The obvious fix: marker after INSTRUCTIONS, marker after the athlete context.\"\"\"","+    return [{\"type\": \"text\", \"text\": bot.INSTRUCTIONS, \"cache_control\": {\"type\": \"ephemeral\"}},","+            {\"type\": \"text\", \"text\": bot.athlete_profile(a, a.facts) + \"\\n\" + bot.volatile_tail(today, []),","+             \"cache_control\": {\"type\": \"ephemeral\"}}]","+","+"," def main():","+    if \"--naive\" in sys.argv:","+        bot.build_system = naive_two_markers","     tmp = tempfile.mkdtemp()","     bot.ATHLETES_FILE = os.path.join(tmp, \"athletes.json\")","     bot.USAGE_LOG = os.path.join(tmp, \"usage.jsonl\")"]},{"oldStart":65,"oldLines":8,"newStart":75,"newLines":10,"lines":["         print(f\"round {r['round']} tool={r.get('tool') or '-':12} create={r['cache_creation_input_tokens']:5} \"","               f\"read={r['cache_read_input_tokens']:5} uncached={r['input_tokens']:4}\")","     creates = [r[\"cache_creation_input_tokens\"] for r in rows]","-    assert creates[0] > 0 and sum(creat