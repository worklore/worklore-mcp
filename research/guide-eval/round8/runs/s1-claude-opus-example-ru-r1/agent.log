uild_doc(plan),\n    }\n\n\nif __name__ == \"__main__\":\n    with open(sys.argv[1]) as f:\n        plan = json.load(f)\n    json.dump(build_event(plan), sys.stdout, indent=2)\n    print()\n","structuredPatch":[{"oldStart":10,"oldLines":7,"newStart":10,"newLines":10,"lines":[" def hr_target(step):","     \"\"\"HR corridor for a step, as a percentage of the athlete's LTHR.\"\"\"","     lo, hi = step[\"hr_pct\"]","-    return {\"units\": \"%lthr\", \"value\": lo, \"end\": hi}","+    # \"start\" (not \"value\") makes Intervals export an Instant-HR corridor in","+    # bpm; {value, end} is exported as a Lap-HR target that the watch snaps","+    # to its own HR zones.","+    return {\"units\": \"%lthr\", \"start\": lo, \"end\": hi}"," "," "," def build_step(step):"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"tool_result_meta":[{"id":"toolu_01VLFoRRszVEu5YfF75XWEzt","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
