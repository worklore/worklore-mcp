{"role":"tool","tool_call_id":"tool_vp6648bimhrRokzsTLs8hb1Z","content":"105\t            body = f.read()\n106\t        self.send_response(200)\n107\t        self.send_header(\"Content-Type\", ctype)\n108\t        self.send_header(\"Content-Length\", str(len(body)))\n109\t        self.end_headers()\n110\t        self.wfile.write(body)\n111\t\n112\t    def redirect(self, url):\n113\t        self.send_response(302)\n114\t        self.send_header(\"Location\", url)\n115\t        self.end_headers()\n116\t\n117\t    def current_user(self):\n118\t        auth = self.headers.get(\"Authorization\", \"\")\n119\t        if not auth.startswith(\"Bearer \"):\n120\t            return None\n121\t        return USERS.get(auth[7:].strip())\n122\t\n123\t    def require_user(self):\n124\t        user = self.current_user()\n125\t        if user is None:\n126\t            self.log_message(\"%s %s 401 (no Authorization header)\", self.command, self.path)\n127\t            self.send_json(401, {\"error\": \"unauthorized\"})\n128\t        return user\n129\t\n130\t    def do_GET(self):\n131\t        url = urllib.parse.urlsplit(self.path)\n132\t        q = dict(urllib.parse.parse_qsl(url.query))\n133\t        if url.path == \"/\":\n134\t            return self.send_file(\"index.html\", \"text/html; charset=utf-8\")\n135\t        if url.path.startswith(\"/static/\"):\n136\t            return self.send_file(os.path.basename(url.path), \"application/javascript\" if url.path.endswith(\".js\") else \"text/plain\")\n137\t        if url.path == \"/api/me\":\n138\t            user = self.require_user()\n139\t            return user and self.send_json(200, user)\n140\t        if url.path == \"/api/intervals/auth/init\":\n141\t            return self.auth_init()\n142\t        if url.path == \"/api/intervals/callback\":\n143\t            return self.callback(q)\n144\t        if url.path == \"/api/intervals/status\":\n145\t            return self.status()\n146\t        if url.path == \"/api/intervals/wellness\":\n147\t            return self.wellness()\n148\t        self.send_json(404, {\"error\": \"not found\"})\n149\t\n150\t    def do_POST(self):\n151\t        url = urllib.parse.urlsplit(self.path)\n152\t        if url.path == \"/api/intervals/disconnect\":\n153\t            user = self.require_user()\n154\t            if user:\n155\t                with LOCK:\n156\t                    CONNECTIONS.pop(user[\"id\"], None)\n157\t                self.send_json(200, {\"ok\": True})\n158\t            return\n159\t        self.send_json(404, {\"error\": \"not found\"})\n160\t\n161\t    # Step 1: build the authorize URL and send the browser to Intervals.\n162\t    def auth_init(self):\n163\t        user = self.require_user()\n164\t        if not user:\n165\t            return\n166\t        params = {\"client_id\": config.CLIENT_ID, \"redirect_uri\": config.REDIRECT_URI,\n167\t                  \"scope\": config.SCOPES, \"state\": sign_state(user[\"id\"])}\n168\t        self.redirect(AUTHORIZE_URL + \"?\" + urllib.parse.urlencode(params, safe=\":,\"))\n169\t\n170\t    # Step 2: Intervals redirects back here with ?code=&state=.\n171\t    def callback(self, q):\n172\t        user_id = verify_state(q.get(\"state\", \"\"))\n173\t        if not user_id or not q.get(\"code\"):\n174\t            return self.send_json(400, {\"error\": \"bad state or code\"})\n175\t        try:\n176\t            tok = exchange_code(q[\"code\"])\n177\t            store_connection(user_id, tok)\n178\t        except urllib.error.HTTPError as e:\n179\t            log(f\"{user_id}: token exchange failed: HTTP {e.code} {e.read()[:200]!r}\")\n180\t            return self.send_json(502, {\"error\": \"token exchange failed\"})\n181\t        except Exception as e:\n182\t            log(f\"{user_id}: token exchange failed: {e}\")\n183\t            return self.send_json(502, {\"error\": \"token exchange failed\"})\n184\t        self.redirect(\"/?connected=1\")\n185\t\n186\t    def status(self):\n187\t        user = self.require_user()\n188\t        if not user:\n189\t            return\n190\t        with LOCK:\n191\t            c = CONNECTIONS.get(user[\"id\"])\n192\t        if not c or c[\"status\"] != \"connected\":\n193\t            return self.send_json(200, {\"connected\": False, \"status\": c[\"status\"] if c else \"disconnected\"})\n194\t        self.send_json(200, {\"connected\": True, \"status\": \"connected\", \"scope\": c[\"scope\"],\n195\t                             \"athlete\": {\"id\": c[\"athlete_id\"], \"name\": c[\"athlete_name\"]}})\n196\t\n197\t    def wellness(self):\n198\t        user = self.require_user()\n199\t        if not user:\n200\t            return\n201\t        with LOCK:\n202\t            c = CONNECTIONS.get(user[\"id\"])\n203\t        if not c or c[\"status\"] != \"connected\":\n204\t            return self.send_json(409, {\"error\": \"intervals not connected\"})\n205\t        try:\n206\t            code, data = intervals_get(c, \"/wellness\")\n207\t            self.send_json(code, data)\n208\t        except urllib.error.HTTPError as e:\n209\t            self.send_json(e.code, {\"error\": f\"intervals returned {e.code}\"})\n210\t        except Exception as e:\n211\t            self.send_json(502, {\"error\": str(e)})\n212\t\n213\t\n214\tif __name__ == \"__main__\":\n215\t    threading.Thread(target=refresh_tokens, daemon=True).start()\n216\t    log(f\"serving on http://localhost:{config.PORT} (intervals: {config.INTERVALS_BASE})\")\n217\t    ThreadingHTTPServer((\"127.0.0.1\", config.PORT), Handler).serve_forever()"}
