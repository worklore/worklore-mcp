{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport os, shutil, subprocess, tempfile\nwith tempfile.TemporaryDirectory(prefix='.nightly-test-', dir='.') as tmp:\n    home = Path(tmp).resolve()\n    for name in ('bin', 'projects/shop', 'Library/Logs', 'mock-bin'):\n        (home / name).mkdir(parents=True)\n    shutil.copy2('bin/nightly-review.zsh', home / 'bin/nightly-review.zsh')\n    notifier = home / 'bin/notify.sh'\n    notifier.write_text('#\"'!/bin/sh'\"\\\\nprintf \\\"%s\\\\\\\\n\\\" \\\"\"'$1\" >> \"$HOME/notifications\"'\"\\\\n[ \\\"\"'${MOCK_NOTIFY_FAIL:-0}\" -eq 0 ]'\"\\\\n')\n    notifier.chmod(0o755)\n    agent = home / 'mock-bin/claude'\n    agent.write_text('#\"'!/bin/sh'\"\\\\n[ \\\"\"'$(wc -c < /dev/stdin | tr -d \" \")\" -eq 0 ] || exit 9'\"\\\\ncase \\\"\"'$MOCK_MODE\" in'\"\\\\n success) printf \\\"review summary\\\\\\\\n\\\"; exit 0 ;;\\\\n failure) echo \\\"mock agent error\\\" >&2; exit 7 ;;\\\\n empty) exit 0 ;;\\\\nesac\\\\n')\n    agent.chmod(0o755)\n    for scenario, mode, notify_fail in [('success','success','0'),('failure','failure','0'),('empty','empty','0'),('notify_failure','success','1')]:\n        messages = home / 'notifications'\n        messages.unlink(missing_ok=True)\n        env = dict(os.environ, HOME=str(home), PATH=f'{home / \\\"mock-bin\\\"}:{os.environ[\\\"PATH\\\"]}', MOCK_MODE=mode, MOCK_NOTIFY_FAIL=notify_fail)\n        proc = subprocess.run(['/bin/zsh', str(home / 'bin/nightly-review.zsh')], env=env, capture_output=True, text=True)\n        print(f'{scenario}: exit={proc.returncode}; message={messages.read_text().strip() if messages.exists() else \\\"none\\\"}; log={proc.stderr.splitlines()[-1]}')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
