сь их ошибка «Input must be provided…»: в нашем логе её нет.\n\nИзменения не закоммичены.","ttft_ms":2790,"type":"result","duration_ms":109973,"uuid":"d60ba637-ca18-4763-a241-41abb3aee07e","ttft_stream_ms":2303,"time_to_request_ms":35,"first_content_frame_ms":2304,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":16,"outputTokens":9738,"cacheReadInputTokens":206470,"cacheCreationInputTokens":17541,"webSearchRequests":0,"costUSD":0.37644599999999995,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":2805,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}}}
