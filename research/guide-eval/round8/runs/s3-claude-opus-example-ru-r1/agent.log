E=$(date -v-1d +%F)","+PROMPT=\"Review the commits in this repository since $SINCE.","+For each commit: one line on what it changes and whether anything looks risky","+(migrations, auth, payments, deleted tests).","+End with a three-line summary I can read on my phone.","+Do not modify any file.\"","+","+cd \"$REPO\" || fail \"repo missing: $REPO\"","+","+# Prompt goes in via stdin: no multi-line argument, and claude never waits on","+# an inherited stdin.","+print -r -- \"$PROMPT\" | claude -p --output-format text > \"$OUT\" 2> \"$CLAUDE_ERR\"","+rc=$?   # never `status=`: it is a read-only zsh builtin and kills the script","+elapsed=$(( SECONDS - START ))","+cat \"$CLAUDE_ERR\" >&2","+log \"claude exit $rc after ${elapsed}s, $(wc -c < \"$OUT\" | tr -d ' ') bytes in $OUT\"","+","+if (( rc != 0 )); then","+  fail \"claude exit $rc after ${elapsed}s: $(tail -n 3 \"$CLAUDE_ERR\" | head -c 500)\"","+fi","+if [[ ! -s \"$OUT\" ]]; then","+  fail \"claude exit 0 but empty output after ${elapsed}s, see $OUT\"","+fi","+","+# The prompt asks for the summary at the end, so send the tail, not the head.","+summary=$(tail -n 5 \"$OUT\")","+DONE=1","+\"$NOTIFY\" \"nightly review done (${elapsed}s):","+${summary[1,1500]}\" || { log \"notify.sh failed on success message\"; exit 1 }","+log \"done\""]}],"created":true}],"moreFiles":2,"changedFiles":["/private/tmp/h-ukedsC/.t/a.zsh","/private/tmp/h-ukedsC/.t/fakebin/claude","/private/tmp/h-ukedsC/.t/home/Library/Logs/nightly-review-2026-10-26.claude.err","/private/tmp/h-ukedsC/.t/home/Library/Logs/nightly-review-2026-10-26.md","/private/tmp/h-ukedsC/.t/home/bin/nightly-review.zsh","/private/tmp/h-ukedsC/.t/home/bin/notify.sh","/private/tmp/h-ukedsC/.t/home/notified"]}},"tool_result_meta":[{"id":"toolu_01BNTwJB7HvijUWBWh52cej5","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
