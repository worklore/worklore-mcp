{"role":"assistant","tool_calls":[{"type":"function","id":"tool_OjcnNdauIB5ubv1Lg3wJiuyq","function":{"name":"Read","arguments":"{\"path\":\"server.py\",\"line_offset\":115,\"n_lines\":140}"}},{"type":"function","id":"tool_Mav2z33q2mGtz4Ej0BKBp84q","function":{"name":"Read","arguments":"{\"path\":\"static/app.js\"}"}}]}
{"role":"tool","tool_call_id":"tool_OjcnNdauIB5ubv1Lg3wJiuyq","content":"115\t        self.send_response(302)\n116\t        self.send_header(\"Location\", url)\n117\t        self.end_headers()\n118\t\n119\t    def current_user(self):\n120\t        auth = self.headers.get(\"Authorization\", \"\")\n121\t        if not auth.startswith(\"Bearer \"):\n122\t            return None\n123\t        return USERS.get(auth[7:].strip())\n124\t\n125\t    def require_user(self):\n126\t        user = self.current_user()\n127\t        if user is None:\n128\t            self.log_message(\"%s %s 401 (no Authorization header)\", self.command, self.path)\n129\t            self.send_json(401, {\"error\": \"unauthorized\"})\n130\t        return user\n131\t\n132\t    def do_GET(self):\n133\t        url = urllib.parse.urlsplit(self.path)\n134\t        q = dict(urllib.parse.parse_qsl(url.query))\n135\t        if url.path == \"/\":\n136\t            return self.send_file(\"index.html\", \"text/html; charset=utf-8\")\n137\t        if url.path.startswith(\"/static/\"):\n138\t            return self.send_file(os.path.basename(url.path), \"application/javascript\" if url.path.endswith(\".js\") else \"text/plain\")\n139\t        if url.path == \"/api/me\":\n140\t            user = self.require_user()\n141\t            return user and self.send_json(200, user)\n142\t        if url.path == \"/api/intervals/auth/init\":\n143\t            return self.auth_init()\n144\t        if url.path == \"/api/intervals/callback\":\n145\t            return self.callback(q)\n146\t        if url.path == \"/api/intervals/status\":\n147\t            return self.status()\n148\t        if url.path == \"/api/intervals/wellness\":\n149\t            return self.wellness()\n150\t        self.send_json(404, {\"error\": \"not found\"})\n151\t\n152\t    def do_POST(self):\n153\t        url = urllib.parse.urlsplit(self.path)\n154\t        if url.path == \"/api/intervals/disconnect\":\n155\t            user = self.require_user()\n156\t            if user:\n157\t                with LOCK:\n158\t                    CONNECTIONS.pop(user[\"id\"], None)\n159\t                self.send_json(200, {\"ok\": True})\n160\t            return\n161\t        self.send_json(404, {\"error\": \"not found\"})\n162\t\n163\t    # Step 1: build the authorize URL and send the browser to Intervals.\n164\t    def auth_init(self):\n165\t        user = self.require_user()\n166\t        if not user:\n167\t            return\n168\t        params = {\"client_id\": config.CLIENT_ID, \"redirect_uri\": config.REDIRECT_URI,\n169\t                  \"scope\": config.SCOPES, \"state\": sign_state(user[\"id\"])}\n170\t        self.redirect(AUTHORIZE_URL + \"?\" + urllib.parse.urlencode(params, safe=\":,\"))\n171\t\n172\t    # Step 2: Intervals redirects back here with ?code=&state=.\n173\t    def callback(self, q):\n174\t        user_id = verify_state(q.get(\"state\", \"\"))\n175\t        if not user_id or not q.get(\"code\"):\n176\t            return self.send_json(400, {\"error\": \"bad state or code\"})\n177\t        try:\n178\t            tok = exchange_code(q[\"code\"])\n179\t            store_connection(user_id, tok)\n180\t        except urllib.error.HTTPError as e:\n181\t            log(f\"{user_id}: token exchange failed: HTTP {e.code} {e.read()[:200]!r}\")\n182\t            return self.send_json(502, {\"error\": \"token exchange failed\"})\n183\t        except Exception as e:\n184\t            log(f\"{user_id}: token exchange failed: {e}\")\n185\t            return self.send_json(502, {\"error\": \"token exchange failed\"})\n186\t        self.redirect(\"/?connected=1\")\n187\t\n188\t    def status(self):\n189\t        user = self.require_user()\n190\t        if not user:\n191\t            return\n192\t        with LOCK:\n193\t            c = CONNECTIONS.get(user[\"id\"])\n194\t        if not c or c[\"status\"] != \"connected\":\n195\t            return self.send_json(200, {\"connected\": False, \"status\": c[\"status\"] if c else \"disconnected\"})\n196\t        self.send_json(200, {\"connected\": True, \"status\": \"connected\", \"scope\": c[\"scope\"],\n197\t                             \"athlete\": {\"id\": c[\"athlete_id\"], \"name\": c[\"athlete_name\"]}})\n198\t\n199\t    def wellness(self):\n200\t        user = self.require_user()\n201\t        if not user:\n202\t            return\n203\t        with LOCK:\n204\t            c = CONNECTIONS.get(user[\"id\"])\n205\t        if not c or c[\"status\"] != \"connected\":\n206\t            return self.send_json(409, {\"error\": \"intervals not connected\"})\n207\t        try:\n208\t            code, data = intervals_get(c, \"/wellness\")\n209\t            self.send_json(code, data)\n210\t        except urllib.error.HTTPError as e:\n211\t            self.send_json(e.code, {\"error\": f\"intervals returned {e.code}\"})\n212\t        except Exception as e:\n213\t            self.send_json(502, {\"error\": str(e)})\n214\t\n215\t\n216\tif __name__ == \"__main__\":\n217\t    threading.Thread(target=refresh_tokens, daemon=True).start()\n218\t    log(f\"serving on http://localhost:{config.PORT} (intervals: {config.INTERVALS_BASE})\")\n219\t    ThreadingHTTPServer((\"127.0.0.1\", config.PORT), Handler).serve_forever()"}
{"role":"tool","tool_call_id":"tool_Mav2z33q2mGtz4Ej0BKBp84q","content":"1\t// tricoach SPA. The sign-in token lives in localStorage and travels on every\n2\t// API call via the fetch wrapper below.\n3\tconst TOKEN = localStorage.getItem(\"tc_token\") || \"tok-okafor\";\n4\tconst root = document.getElementById(\"app\");\n5\t\n6\tasync function api(path, opts = {}) {\n7\t  const headers = Object.assign({ \"Authorization\": \"Bearer \" + TOKEN }, opts.headers || {});\n8\t  const res = await fetch(path, Object.assign({}, opts, { headers }));\n9\t  const body = await res.json().catch(() => ({}));\n10\t  if (!res.ok) throw new Error(body.error || (\"HTTP \" + res.status));\n11\t  return body;\n12\t}\n13\t\n14\tfunction esc(s) { return String(s).replace(/[&<>\"]/g, c => ({ \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\" }[c])); }\n15\t\n16\tasync function render() {\n17\t  try {\n18\t    const me = await api(\"/api/me\");\n19\t    const st = await api(\"/api/intervals/status\");\n20\t    let card;\n21\t    if (st.connected) {\n22\t      card = `<div class=\"card\">Connected to Intervals.icu as <b>${esc(st.athlete.name)}</b>\n23\t        (${esc(st.athlete.id)}), scope <code>${esc(st.scope)}</code>.\n24\t        <p><button class=\"btn\" id=\"disconnect\">Disconnect</button></p></div>`;\n25\t    } else {\n26\t      const why = st.status && st.status !== \"disconnected\" ? `<p class=\"muted\">Status: ${esc(st.status)}</p>` : \"\";\n27\t      card = `<div class=\"card\">Intervals.icu is not connected.${why}\n28\t        <p><button class=\"btn\" id=\"connect\">Connect Intervals.icu</button></p>\n29\t        <p class=\"muted\" id=\"connect-error\"></p></div>`;\n30\t    }\n31\t    root.className = \"\";\n32\t    root.innerHTML = `<p>Signed in as <b>${esc(me.name)}</b>.</p>${card}`;\n33\t    const d = document.getElementById(\"disconnect\");\n34\t    if (d) d.onclick = async () => { await api(\"/api/intervals/disconnect\", { method: \"POST\" }); render(); };\n35\t  } catch (e) {\n36\t    root.innerHTML = `<p class=\"card\">Error: ${esc(e.message)}</p>`;\n37\t  }\n38\t}\n39\t\n40\trender();"}
