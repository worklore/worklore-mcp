{"role":"tool","tool_call_id":"tool_xpC8mHmD4nca2PoDsgv9ZpL2","content":"diff --git a/config.py b/config.py\nindex 54a8144..d5cc0c9 100644\n--- a/config.py\n+++ b/config.py\n@@ -8,6 +8,4 @@ INTERVALS_BASE = os.environ.get(\"INTERVALS_BASE\", \"https://intervals.icu\")\n CLIENT_ID = \"tricoach-dev\"\n CLIENT_SECRET = \"s3cr3t-placeholder-0000\"\n REDIRECT_URI = f\"http://localhost:{PORT}/api/intervals/callback\"\n-SCOPES = \"ACTIVITY:READ,ACTIVITY:WRITE,WELLNESS:READ,CALENDAR:READ,CALENDAR:WRITE\"\n-\n-REFRESH_INTERVAL = 60      # seconds between passes of the token refresher\n+SCOPES = \"ACTIVITY:WRITE,WELLNESS:READ,CALENDAR:WRITE\"\ndiff --git a/server.py b/server.py\nindex 351cbb7..e21aa31 100644\n--- a/server.py\n+++ b/server.py\n@@ -12,14 +12,12 @@ import config\n STATIC = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"static\")\n TOKEN_URL = config.INTERVALS_BASE + \"/api/oauth/token\"\n AUTHORIZE_URL = config.INTERVALS_BASE + \"/oauth/authorize\"\n-DEFAULT_TOKEN_TTL = 3600   # seconds; used when the provider does not say how long a token lives\n-\n # --- in-memory store -------------------------------------------------------\n USERS = {\n     \"tok-okafor\": {\"id\": \"u_okafor\", \"name\": \"C. Okafor\"},\n     \"tok-rivera\": {\"id\": \"u_rivera\", \"name\": \"T. Rivera\"},\n }\n-# user_id -> {athlete_id, athlete_name, access_token, refresh_token, scope, expires_at, status}\n+# user_id -> {athlete_id, athlete_name, access_token, scope, status}\n CONNECTIONS = {}\n LOCK = threading.Lock()\n \n@@ -30,19 +28,21 @@ def log(msg):\n \n # --- state parameter: carries the user through the redirect -----------------\n def sign_state(user_id):\n-    payload = f\"{user_id}:{int(time.time())}\"\n+    payload = f\"{user_id}:intervals_oauth:{int(time.time())}\"\n     sig = hmac.new(config.APP_SECRET.encode(), payload.encode(), hashlib.sha256).hexdigest()[:32]\n     return base64.urlsafe_b64encode(f\"{payload}:{sig}\".encode()).decode()\n \n \n def verify_state(state, max_age=900):\n     try:\n-        user_id, ts, sig = base64.urlsafe_b64decode(state.encode()).decode().split(\":\")\n+        user_id, purpose, ts, sig = base64.urlsafe_b64decode(state.encode()).decode().split(\":\")\n+        ts = int(ts)\n     except Exception:\n         return None\n-    payload = f\"{user_id}:{ts}\"\n+    payload = f\"{user_id}:{purpose}:{ts}\"\n     good = hmac.new(config.APP_SECRET.encode(), payload.encode(), hashlib.sha256).hexdigest()[:32]\n-    if not hmac.compare_digest(good, sig) or time.time() - int(ts) > max_age:\n+    age = time.time() - ts\n+    if purpose != \"intervals_oauth\" or not hmac.compare_digest(good, sig) or not 0 <= age <= max_age:\n         return None\n     return user_id\n \n@@ -57,51 +57,26 @@ def post_form(url, fields):\n \n def exchange_code(code):\n     return post_form(TOKEN_URL, {\n-        \"grant_type\": \"authorization_code\", \"client_id\": config.CLIENT_ID,\n-        \"client_secret\": config.CLIENT_SECRET, \"code\": code, \"redirect_uri\": config.REDIRECT_URI,\n+        \"client_id\": config.CLIENT_ID, \"client_secret\": config.CLIENT_SECRET, \"code\": code,\n     })\n \n \n+class AccountMismatchError(Exception):\n+    pass\n+\n+\n def store_connection(user_id, tok):\n-    expires_in = int(tok.get(\"expires_in\") or DEFAULT_TOKEN_TTL)\n-    refresh = tok.get(\"refresh_token\")\n-    if not refresh:\n-        log(f\"{user_id}: no refresh_token in response, scheduling expiry in {expires_in}s\")\n     athlete = tok.get(\"athlete\") or {}\n+    athlete_id = athlete.get(\"id\")\n     with LOCK:\n+        existing = CONNECTIONS.get(user_id)\n+        if existing and existing.get(\"athlete_id\") and existing[\"athlete_id\"] != athlete_id:\n+            raise AccountMismatchError()\n         CONNECTIONS[user_id] = {\n-            \"athlete_id\": athlete.get(\"id\"), \"athlete_name\": athlete.get(\"name\"),\n-            \"access_token\": tok[\"access_token\"], \"refresh_token\": refresh,\n-            \"scope\": tok.get(\"scope\"), \"expires_at\": time.time() + expires_in, \"status\": \"connected\",\n+            \"athlete_id\": athlete_id, \"athlete_name\": athlete.get(\"name\"),\n+            \"access_token\": tok[\"access_token\"], \"scope\": tok.get(\"scope\"), \"status\": \"connected\",\n         }\n-    log(f\"{user_id}: connected as athlete {athlete.get('id')} (expires in {expires_in}s)\")\n-\n-\n-def refresh_tokens():\n-    \"\"\"Background pass: renew access tokens shortly before they expire.\"\"\"\n-    while True:\n-        time.sleep(config.REFRESH_INTERVAL)\n-        now = time.time()\n-        with LOCK:\n-            for uid, c in CONNECTIONS.items():\n-                if c[\"status\"] != \"connected\" or c[\"expires_at\"] - now > 300:\n-                    continue\n-                if not c[\"refresh_token\"]:\n-                    log(f\"{uid}: token expiry passed and no refresh token on file -> expired, reconnect\")\n-                    c.update(status=\"expired, reconnect\", access_token=None)\n-                    continue\n-                try:\n-                    tok = post_form(TOKEN_URL, {\n-                        \"grant_type\": \"refresh_token\", \"refresh_token\": c[\"refresh_token\"],\n-                        \"client_id\": config.CLIENT_ID, \"client_secret\": config.CLIENT_SECRET,\n-                    })\n-                    c.update(access_token=tok[\"access_token\"],\n-                             refresh_token=tok.get(\"refresh_token\", c[\"refresh_token\"]),\n-                             expires_at=now + int(tok[\"expires_in\"]))\n-                    log(f\"{uid}: token refreshed\")\n-                except Exception as e:\n-                    log(f\"{uid}: refresh failed ({e}) -> expired, reconnect\")\n-                    c.update(status=\"expired, reconnect\", access_token=None)\n+    log(f\"{user_id}: connected as athlete {athlete_id}\")\n \n \n def intervals_get(conn, path):\n@@ -164,8 +139,6 @@ class Handler(BaseHTTPRequestHandler):\n         if url.path == \"/api/me\":\n             user = self.require_user()\n             return user and self.send_json(200, user)\n-        if url.path == \"/api/intervals/auth/init\":\n-            return self.auth_init()\n         if url.path == \"/api/intervals/callback\":\n             return self.callback(q)\n         if url.path == \"/api/intervals/status\":\n@@ -176,6 +149,8 @@ class Handler(BaseHTTPRequestHandler):\n \n     def do_POST(self):\n         url = urllib.parse.urlsplit(self.path)\n+        if url.path == \"/api/intervals/auth/init\":\n+            return self.auth_init()\n         if url.path == \"/api/intervals/disconnect\":\n             user = self.require_user()\n             if user:\n@@ -185,14 +160,15 @@ class Handler(BaseHTTPRequestHandler):\n             return\n         self.send_json(404, {\"error\": \"not found\"})\n \n-    # Step 1: build the authorize URL and send the browser to Intervals.\n+    # Step 1: return the authorize URL to the authenticated SPA request.\n     def auth_init(self):\n         user = self.require_user()\n         if not user:\n             return\n         params = {\"client_id\": config.CLIENT_ID, \"redirect_uri\": config.REDIRECT_URI,\n                   \"scope\": config.SCOPES, \"state\": sign_state(user[\"id\"])}\n-        self.redirect(AUTHORIZE_URL + \"?\" + urllib.parse.urlencode(params, safe=\":,\"))\n+        authorize_url = AUTHORIZE_URL + \"?\" + urllib.parse.urlencode(params, safe=\":,\")\n+        self.send_json(200, {\"authorize_url\": authorize_url})\n \n     # Step 2: Intervals redirects back here with ?code=&state=.\n     def callback(self, q):\n@@ -202,6 +178,8 @@ class Handler(BaseHTTPRequestHandler):\n         try:\n             tok = exchange_code(q[\"code\"])\n             store_connection(user_id, tok)\n+        except AccountMismatchError:\n+            return self.send_json(409, {\"error\": \"different Intervals.icu athlete; disconnect first\"})\n         except urllib.error.HTTPError as e:\n             log(f\"{user_id}: token exchange failed: HTTP {e.code} {e.read()[:200]!r}\")\n             return self.send_json(502, {\"error\": \"token exchange failed\"})\n@@ -233,12 +211,17 @@ class Handler(BaseHTTPRequestHandler):\n             code, data = intervals_get(c, \"/wellness\")\n             self.send_json(code, data)\n         except urllib.error.HTTPError as e:\n-            self.send_json(e.code, {\"error\": f\"intervals returned {e.code}\"})\n+            if e.code == 401:\n+                with LOCK:\n+                    if CONNECTIONS.get(user[\"id\"]) is c:\n+                        c.update(status=\"revoked, reconnect\", access_token=None)\n+                self.send_json(401, {\"error\": \"Intervals.icu access revoked; reconnect\"})\n+            else:\n+                self.send_json(e.code, {\"error\": f\"intervals returned {e.code}\"})\n         except Exception as e:\n             self.send_json(502, {\"error\": str(e)})\n \n \n if __name__ == \"__main__\":\n-    threading.Thread(target=refresh_tokens, daemon=True).start()\n     log(f\"serving on http://localhost:{config.PORT} (intervals: {config.INTERVALS_BASE})\")\n     ThreadingHTTPServer((\"127.0.0.1\", config.PORT), Handler).serve_forever()\ndiff --git a/static/app.js b/static/app.js\nindex 368922e..8a982ad 100644\n--- a/static/app.js\n+++ b/static/app.js\n@@ -25,12 +25,24 @@ async function render() {\n     } else {\n       const why = st.status && st.status !== \"disconnected\" ? `<p class=\"muted\">Status: ${esc(st.status)}</p>` : \"\";\n       card = `<div class=\"card\">Intervals.icu is not connected.${why}\n-        <p><a class=\"btn\" href=\"/api/intervals/auth/init\">Connect Intervals.icu</a></p></div>`;\n+        <p><button class=\"btn\" id=\"connect\">Connect Intervals.icu</button></p>\n+        <p class=\"muted\" id=\"connect-error\"></p></div>`;\n     }\n     root.className = \"\";\n     root.innerHTML = `<p>Signed in as <b>${esc(me.name)}</b>.</p>${card}`;\n     const d = document.getElementById(\"disconnect\");\n     if (d) d.onclick = async () => { await api(\"/api/intervals/disconnect\", { method: \"POST\" }); render(); };\n+    const c = document.getElementById(\"connect\");\n+    if (c) c.onclick = async () => {\n+      c.disabled = true;\n+      try {\n+        const data = await api(\"/api/intervals/auth/init\", { method: \"POST\" });\n+        window.location.assign(data.authorize_url);\n+      } catch (e) {\n+        c.disabled = false;\n+        document.getElementById(\"connect-error\").textContent = e.message;\n+      }\n+    };\n   } catch (e) {\n     root.innerHTML = `<p class=\"card\">Error: ${esc(e.message)}</p>`;\n   }\n M config.py\n M server.py\n M static/app.js\n?? __pycache__/\n"}
