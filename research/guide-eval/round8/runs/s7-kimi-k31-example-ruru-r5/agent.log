{"role":"assistant","content":"Проверка покроет не только успешное подключение: отдельно убеждаюсь, что обмен отправляет ровно три поля, подключение не получает искусственный TTL, а ответ 401 переводит приложение в состояние повторного подключения.","tool_calls":[{"type":"function","id":"tool_OXIZPvkWlPskpQTIiEtbI3wM","function":{"name":"Bash","arguments":"{\"command\":\"python3 - <<'PY'\\nimport http.client\\nimport json\\nimport threading\\nimport urllib.parse\\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\\n\\nimport config\\n\\nclass Provider(BaseHTTPRequestHandler):\\n    token_requests = []\\n    revoked = False\\n    wellness_calls = 0\\n\\n    def log_message(self, *args):\\n        pass\\n\\n    def send_json(self, status, body):\\n        raw = json.dumps(body).encode()\\n        self.send_response(status)\\n        self.send_header(\\\"Content-Type\\\", \\\"application/json\\\")\\n        self.send_header(\\\"Content-Length\\\", str(len(raw)))\\n        self.end_headers()\\n        self.wfile.write(raw)\\n\\n    def do_POST(self):\\n        assert self.path == \\\"/api/oauth/token\\\"\\n        fields = urllib.parse.parse_qs(self.rfile.read(int(self.headers[\\\"Content-Length\\\"])).decode())\\n        self.token_requests.append(fields)\\n        if set(fields) != {\\\"client_id\\\", \\\"client_secret\\\", \\\"code\\\"}:\\n            return self.send_json(400, {\\\"error\\\": \\\"unexpected token fields\\\"})\\n        code = fields[\\\"code\\\"][0]\\n        athlete = {\\\"id\\\": \\\"i-other\\\", \\\"name\\\": \\\"Other\\\"} if code == \\\"code-other\\\" else {\\\"id\\\": \\\"i123\\\", \\\"name\\\": \\\"C. Okafor\\\"}\\n        self.send_json(200, {\\\"token_type\\\": \\\"bearer\\\", \\\"access_token\\\": \\\"token-\\\" + code,\\n                             \\\"scope\\\": config.SCOPES, \\\"athlete\\\": athlete})\\n\\n    def do_GET(self):\\n        self.wellness_calls += 1\\n        if self.revoked:\\n            return self.send_json(401, {\\\"error\\\": \\\"revoked\\\"})\\n        if self.path != \\\"/api/v1/athlete/i123/wellness\\\" or not self.headers.get(\\\"Authorization\\\", \\\"\\\").startswith(\\\"Bearer token-code-\\\"):\\n            return self.send_json(401, {\\\"error\\\": \\\"bad token\\\"})\\n        self.send_json(200, {\\\"wellness\\\": \\\"ok\\\"})\\n\\nprovider = ThreadingHTTPServer((\\\"127.0.0.1\\\", 0), Provider)\\nthreading.Thread(target=provider.serve_forever, daemon=True).start()\\nconfig.INTERVALS_BASE = f\\\"http://127.0.0.1:{provider.server_port}\\\"\\nimport server\\napp = ThreadingHTTPServer((\\\"127.0.0.1\\\", 0), server.Handler)\\nthreading.Thread(target=app.serve_forever, daemon=True).start()\\n\\n\\ndef request(method, path, auth=True):\\n    conn = http.client.HTTPConnection(\\\"127.0.0.1\\\", app.server_port, timeout=5)\\n    headers = {\\\"Authorization\\\": \\\"Bearer tok-okafor\\\"} if auth else {}\\n    conn.request(method, path, headers=headers)\\n    response = conn.getresponse()\\n    raw = response.read()\\n    body = json.loads(raw) if raw and response.getheader(\\\"Content-Type\\\") == \\\"application/json\\\" else {}\\n    result = response.status, response.getheader(\\\"Location\\\"), body\\n    conn.close()\\n    return result\\n\\ntry:\\n    assert request(\\\"GET\\\", \\\"/api/intervals/auth/init\\\")[0] == 404\\n    assert request(\\\"POST\\\", \\\"/api/intervals/auth/init\\\", auth=False)[0] == 401\\n    status, _, body = request(\\\"POST\\\", \\\"/api/intervals/auth/init\\\")\\n    assert status == 200\\n    query = urllib.parse.parse_qs(urllib.parse.urlsplit(body[\\\"authorize_url\\\"]).query)\\n    assert query[\\\"scope\\\"] == [\\\"ACTIVITY:WRITE,WELLNESS:READ,CALENDAR:WRITE\\\"]\\n    assert len(query[\\\"scope\\\"][0].split(\\\",\\\")) == len(set(query[\\\"scope\\\"][0].split(\\\",\\\")))\\n    state = query[\\\"state\\\"][0]\\n    assert server.verify_state(state) == \\\"u_okafor\\\"\\n    assert server.verify_state(state, max_age=-1) is None\\n    assert server.verify_state(\\\"not-valid-state\\\") is None\\n\\n    callback = \\\"/api/intervals/callback?\\\" + urllib.parse.urlencode({\\\"code\\\": \\\"code-1\\\", \\\"state\\\": state})\\n    status, location, _ = request(callback, auth=False)\\n    assert (status, location) == (302, \\\"/?connected=1\\\")\\n    assert len(Provider.token_requests) == 1\\n    status, _, body = request(\\\"GET\\\", \\\"/api/intervals/status\\\")\\n    assert status == 200 and body[\\\"connected\\\"] and body[\\\"athlete\\\"][\\\"id\\\"] == \\\"i123\\\"\\n    connection = server.CONNECTIONS[\\\"u_okafor\\\"]\\n    assert \\\"expires_at\\\" not in connection and \\\"refresh_token\\\" not in connection\\n    assert not hasattr(server, \\\"refresh_tokens\\\")\\n    assert request(\\\"GET\\\", \\\"/api/intervals/wellness\\\")[2] == {\\\"wellness\\\": \\\"ok\\\"}\\n\\n    status, _, body = request(\\\"POST\\\", \\\"/api/intervals/auth/init\\\")\\n    other_state = urllib.parse.parse_qs(urllib.parse.urlsplit(body[\\\"authorize_url\\\"]).query)[\\\"state\\\"][0]\\n    mismatch = \\\"/api/intervals/callback?\\\" + urllib.parse.urlencode({\\\"code\\\": \\\"code-other\\\", \\\"state\\\": other_state})\\n    assert request(mismatch, auth=False)[0] == 409\\n    assert server.CONNECTIONS[\\\"u_okafor\\\"][\\\"access_token\\\"] == \\\"token-code-1\\\"\\n\\n    Provider.revoked = True\\n    assert request(\\\"GET\\\", \\\"/api/intervals/wellness\\\")[0] == 401\\n    status, _, body = request(\\\"GET\\\", \\\"/api/intervals/status\\\")\\n    assert body == {\\\"connected\\\": False, \\\"status\\\": \\\"revoked, reconnect\\\"}\\n    assert server.CONNECTIONS[\\\"u_okafor\\\"][\\\"access_token\\\"] is None\\n    calls = Provider.wellness_calls\\n    assert request(\\\"GET\\\", \\\"/api/intervals/wellness\\\")[0] == 409\\n    assert Provider.wellness_calls == calls\\n\\n    status, _, body = request(\\\"POST\\\", \\\"/api/intervals/auth/init\\\")\\n    reconnect_state = urllib.parse.parse_qs(urllib.parse.urlsplit(body[\\\"authorize_url\\\"]).query)[\\\"state\\\"][0]\\n    reconnect = \\\"/api/intervals/callback?\\\" + urllib.parse.urlencode({\\\"code\\\": \\\"code-3\\\", \\\"state\\\": reconnect_state})\\n    assert request(reconnect, auth=False)[0] == 302\\n    Provider.revoked = False\\n    assert request(\\\"GET\\\", \\\"/api/intervals/wellness\\\")[2] == {\\\"wellness\\\": \\\"ok\\\"}\\n    print(\\\"Local OAuth integration checks: PASS\\\")\\nfinally:\\n    app.shutdown()\\n    provider.shutdown()\\n    app.server_close()\\n    provider.server_close()\\nPY\",\"cwd\":\"/private/tmp/h-jtD4Cy\",\"timeout\":60}"}}]}
