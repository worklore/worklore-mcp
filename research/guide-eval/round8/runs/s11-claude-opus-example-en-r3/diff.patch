 """
 import json
 import logging
+import math
 import re
 import time
+from decimal import Decimal
 
 log = logging.getLogger("stories")
 
@@ -40,6 +42,24 @@ def related(story, existing):
     return scored[:TOP_N]
 
 
+def to_dynamo(value):
+    """Convert ``value`` into something boto3 can serialize.
+
+    DynamoDB has no float type and boto3 raises TypeError on any Python float,
+    so every float (however deeply nested) becomes a Decimal here, at the write
+    boundary. Non-finite floats have no DynamoDB representation and are rejected.
+    """
+    if isinstance(value, float):
+        if not math.isfinite(value):
+            raise ValueError(f"non-finite number cannot be stored: {value!r}")
+        return Decimal(str(value))
+    if isinstance(value, dict):
+        return {k: to_dynamo(v) for k, v in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [to_dynamo(v) for v in value]
+    return value
+
+
 def validate(story):
     for k in ("slug", "title", "body"):
         if not story.get(k):
@@ -52,14 +72,14 @@ def publish(table, story):
     """Store ``story`` with its related stories. Returns the stored item."""
     validate(story)
     existing = table.scan(TableName=TABLE_NAME).get("Items", [])
-    item = {
+    item = to_dynamo({
         "slug": story["slug"],
         "title": story["title"],
         "tags": sorted(set(story.get("tags", []))),
         "body": story["body"],
         "published_at": int(time.time()),
         "similar": related(story, existing),
-    }
+    })
     table.put_item(Item=item)
     log.info("publish slug=%s similar=%d stored", item["slug"], len(item["similar"]))
     return item
