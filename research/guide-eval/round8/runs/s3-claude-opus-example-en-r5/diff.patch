+# Never let a broken notifier be silent: log its failure to stderr (launchd log).
+notify() { "$NOTIFY" "$1" || print -u2 -- "$(date '+%F %T') notify.sh failed (rc=$?): $1"; }
+
+START=$SECONDS
+print -u2 -- "$(date '+%F %T') nightly-review start (USER=${USER:-unset})"
+
