-    return [{"type": "text", "text": text, "cache_control": {"type": "ephemeral"}}]
+    # Layout matters for the prompt cache, which is a prefix hash checked at block boundaries:
+    #   [INSTRUCTIONS, cached]  byte-identical for every athlete and every day
+    #   [athlete header]        profile, language, date
+    #   [one block per fact]    append-only: save_fact adds a block at the very end
+    # The breakpoint sits on the last block. After save_fact the new last block is a miss,
+    # but the API's lookback finds the previous request's breakpoint one block earlier and
+    # reads everything up to it from cache, so only the new fact is written to cache.
+    # Nothing volatile may go after the facts, or every save_fact would move it.
+    # The marker on INSTRUCTIONS lets athletes share the static prefix; the API ignores it
+    # while tools + INSTRUCTIONS are below the model's minimum cacheable length (1024 for Sonnet 4.5).
+    blocks = [
+        {"type": "text", "text": INSTRUCTIONS, "cache_control": {"type": "ephemeral"}},
+        {"type": "text", "text": athlete_context(a, today)},
+    ]
+    blocks += [{"type": "text", "text": f"- {f}"} for f in a.facts] or [{"type": "text", "text": "- (none yet)"}]
+    blocks[-1]["cache_control"] = {"type": "ephemeral"}
+    return blocks
 
