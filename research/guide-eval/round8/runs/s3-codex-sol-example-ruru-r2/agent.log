{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport os, pathlib, subprocess, tempfile\nscript = pathlib.Path.cwd() / 'bin/nightly-review.zsh'\nwith tempfile.TemporaryDirectory(prefix='.nightly-test.', dir=pathlib.Path.cwd()) as root:\n    base = pathlib.Path(root)\n    home = base / 'home'\n    for sub in ('bin', 'projects/shop', 'Library/Logs'):\n        (home / sub).mkdir(parents=True)\n    mockbin = base / 'mockbin'\n    mockbin.mkdir()\n    claude = mockbin / 'claude'\n    claude.write_text('#\"'!/bin/sh'\"\\\\ncase \\\"\"'$MOCK_CLAUDE_CASE\" in'\"\\\\n success) printf \\\"Review summary\\\\\\\\n\\\";;\\\\n error) printf \\\"Not logged in\\\\\\\\n\\\" >&2; exit 7;;\\\\n empty) exit 0;;\\\\nesac\\\\n')\n    claude.chmod(0o755)\n    notify = home / 'bin/notify.sh'\n    notify.write_text('#\"'!/bin/sh'\"\\\\nprintf \\\"%s\\\\\\\\n\\\" \\\"\"'$1\" >> \"$MOCK_MESSAGES\"'\"\\\\n[ \\\"\"'${MOCK_NOTIFY_FAIL:-0}\" -eq 0 ]'\"\\\\n')\n    notify.chmod(0o755)\n    messages = base / 'messages'\n    env = dict(os.environ, HOME=str(home), PATH=f'{mockbin}:{os.environ[\\\"PATH\\\"]}', MOCK_MESSAGES=str(messages))\n    for scenario in ('success', 'error', 'empty'):\n        messages.write_text('')\n        result = subprocess.run(['/bin/zsh', str(script)], env=dict(env, MOCK_CLAUDE_CASE=scenario), text=True, capture_output=True)\n        notice = messages.read_text().strip()\n        print(f'{scenario}: exit={result.returncode}; notice={notice\"'!r}; stderr={result.stderr.strip()!r}'\"')\n        assert result.returncode == {'success':0, 'error':7, 'empty':1}[scenario]\n        assert ('FAILED' in notice) == (scenario \"'!= '\"'success')\n    messages.write_text('')\n    result = subprocess.run(['/bin/zsh', str(script)], env=dict(env, MOCK_CLAUDE_CASE='success', MOCK_NOTIFY_FAIL='1'), text=True, capture_output=True)\n    print(f'notify-fail: exit={result.returncode}; stderr={result.stderr.strip()\"'!r}'\"')\n    assert result.returncode == 1 and 'notification failed' in result.stderr\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
