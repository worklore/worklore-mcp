id)\n        if old and old[\"athlete_id\"] and old[\"athlete_id\"] != athlete.get(\"id\"):\n            raise ValueError(f\"athlete mismatch: stored {old['athlete_id']}, got {athlete.get('id')}\")\n        CONNECTIONS[user_id] = {\n            \"athlete_id\": athlete.get(\"id\"), \"athlete_name\": athlete.get(\"name\"),\n            \"access_token\": tok[\"access_token\"], \"scope\": tok.get(\"scope\"), \"status\": \"connected\",\n        }\n    log(f\"{user_id}: connected as athlete {athlete.get('id')}\")\n\n\n'''+s[b:]\n# routing\ns=s.replace('''        if url.path == \"/api/intervals/auth/init\":\n            return self.auth_init()\n''','')\ns=s.replace('''    def do_POST(self):\n        url = urllib.parse.urlsplit(self.path)\n''','''    def do_POST(self):\n        url = urllib.parse.urlsplit(self.path)\n        if url.path == \"/api/intervals/auth/init\":\n            return self.auth_init()\n''')\ns=s.replace('        self.redirect(AUTHORIZE_URL + \"?\" + urllib.parse.urlencode(params, safe=\":,\"))','        self.send_json(200, {\"authorize_url\": AUTHORIZE_URL + \"?\" + urllib.parse.urlencode(params, safe=\":,\")})')\ns=s.replace('# Step 1: build the authorize URL and send the browser to Intervals.','# Step 1: authenticated XHR POST (a plain link cannot carry the Authorization header);\\n    # returns the authorize URL for the SPA to navigate to.')\ns=s.replace('''        except Exception as e:\n            log(f\"{user_id}: token exchange failed: {e}\")''','''        except ValueError as e:\n            log(f\"{user_id}: {e}\")\n            return self.send_json(409, {\"error\": \"different Intervals athlete than the one already connected\"})\n        except Exception as e:\n            log(f\"{user_id}: token exchange failed: {e}\")''')\ns=s.replace('''        except urllib.error.HTTPError as e:\n            self.send_json(e.code, {\"error\": f\"intervals returned {e.code}\"})''','''        except urllib.error.HTTPError as e:\n            if e.code == 401:  # revoked by the athlete: clear token, ask to reconnect\n                with LOCK:\n                    CONNECTIONS.pop(user[\"id\"], None)\n                return self.send_json(401, {\"error\": \"intervals token revoked, reconnect\"})\n            self.send_json(e.code, {\"error\": f\"intervals returned {e.code}\"})''')\ns=s.replace('    threading.Thread(target=refresh_tokens, daemon=True).start()\\n','')\nopen('server.py','w').write(s)\n\nj=open('static/app.js').read()\nj=j.replace('<p><a class=\"btn\" href=\"/api/intervals/auth/init\">Connect Intervals.icu</a></p>','<p><button class=\"btn\" id=\"connect\">Connect Intervals.icu</button></p>')\nj=j.replace('    const d = document.getElementById(\"disconnect\");','''    const cb = document.getElementById(\"connect\");\n    if (cb) cb.onclick = async () => {\n      const r = await api(\"/api/intervals/auth/init\", { method: \"POST\" });\n      window.location.assign(r.authorize_url);\n    };\n    const d = document.getElementById(\"disconnect\");''')\nopen('static/app.js','w').write(j)\nEOF\ngrep -n \"refresh\\|DEFAULT_TOKEN\" server.py; python3 -m py_compile server.py config.py && echo ok\ncat > ANSWER.md <<'EOF'\n# Причины и исправления\n\n1. **Кнопка Connect давала 401.** Это была ссылка `<a href=\"/api/intervals/auth/init\">` (GET): полная навигация не отправляет заголовок `Authorization`, который SPA держит в localStorage. Теперь init — аутентифицированный `POST`, возвращает `{authorize_url}`, фронтенд делает `window.location.assign(...)` (`server.py`, `static/app.js`).\n2. **Authorize отвечал 400 `invalid_request` (ручная ссылка).** В scope были и `ACTIVITY:READ`, и `ACTIVITY:WRITE`, и `CALENDAR:READ` + `CALENDAR:WRITE` — после добавления календаря 2026-10-02 это дало «Duplicate scope». `:WRITE` подразумевает `:READ`; теперь `ACTIVITY:WRITE,WELLNESS:READ,CALENDAR:WRITE` (`config.py`).\n3. **Подключение «протухало» через час.** У Intervals нет `refresh_token` и `expires_in`: токен бессрочный до отзыва. Код 