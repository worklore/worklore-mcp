me.sleep(config.REFRESH_INTERVAL)","         now = time.time()","         with LOCK:","             for uid, c in CONNECTIONS.items():","-                if c[\"status\"] != \"connected\" or c[\"expires_at\"] - now > 300:","+                if c[\"status\"] != \"connected\" or c[\"expires_at\"] is None or c[\"expires_at\"] - now > 300:","                     continue","                 if not c[\"refresh_token\"]:","                     log(f\"{uid}: token expiry passed and no refresh token on file -> expired, reconnect\")"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"tool_result_meta":[{"id":"toolu_014v5rurMNthZjA1Pb5s3Mba","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
