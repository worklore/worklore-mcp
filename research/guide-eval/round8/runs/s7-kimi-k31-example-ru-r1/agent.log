{"role":"tool","tool_call_id":"tool_ZE919ZafKyyZp3poKJopGde2","content":"90\t        return r.status, json.loads(r.read().decode())\n91\t\n92\t\n93\t# --- HTTP ---------------------------------------------------------------------\n94\tclass Handler(BaseHTTPRequestHandler):\n95\t    def log_message(self, fmt, *args):\n96\t        print(time.strftime(\"%Y-%m-%d %H:%M:%S\"), \"[http]\", fmt % args, flush=True)\n97\t\n98\t    def send_json(self, code, obj):\n99\t        body = json.dumps(obj).encode()\n100\t        self.send_response(code)\n101\t        self.send_header(\"Content-Type\", \"application/json\")\n102\t        self.send_header(\"Content-Length\", str(len(body)))\n103\t        self.end_headers()\n104\t        self.wfile.write(body)\n105\t\n106\t    def send_file(self, name, ctype):\n107\t        p = os.path.join(STATIC, name)\n108\t        if not os.path.isfile(p):\n109\t            return self.send_json(404, {\"error\": \"not found\"})\n110\t        with open(p, \"rb\") as f:\n111\t            body = f.read()\n112\t        self.send_response(200)\n113\t        self.send_header(\"Content-Type\", ctype)\n114\t        self.send_header(\"Content-Length\", str(len(body)))\n115\t        self.end_headers()\n116\t        self.wfile.write(body)\n117\t\n118\t    def redirect(self, url):\n119\t        self.send_response(302)\n120\t        self.send_header(\"Location\", url)\n121\t        self.end_headers()\n122\t\n123\t    def current_user(self):\n124\t        auth = self.headers.get(\"Authorization\", \"\")\n125\t        if not auth.startswith(\"Bearer \"):\n126\t            return None\n127\t        return USERS.get(auth[7:].strip())\n128\t\n129\t    def require_user(self):\n130\t        user = self.current_user()\n131\t        if user is None:\n132\t            self.log_message(\"%s %s 401 (no Authorization header)\", self.command, self.path)\n133\t            self.send_json(401, {\"error\": \"unauthorized\"})\n134\t        return user\n135\t\n136\t    def do_GET(self):\n137\t        url = urllib.parse.urlsplit(self.path)\n138\t        q = dict(urllib.parse.parse_qsl(url.query))\n139\t        if url.path == \"/\":\n140\t            return self.send_file(\"index.html\", \"text/html; charset=utf-8\")\n141\t        if url.path.startswith(\"/static/\"):\n142\t            return self.send_file(os.path.basename(url.path), \"application/javascript\" if url.path.endswith(\".js\") else \"text/plain\")\n143\t        if url.path == \"/api/me\":\n144\t            user = self.require_user()\n145\t            return user and self.send_json(200, user)\n146\t        if url.path == \"/api/intervals/auth/init\":\n147\t            return self.auth_init()\n148\t        if url.path == \"/api/intervals/callback\":\n149\t            return self.callback(q)\n150\t        if url.path == \"/api/intervals/status\":\n151\t            return self.status()\n152\t        if url.path == \"/api/intervals/wellness\":\n153\t            return self.wellness()\n154\t        self.send_json(404, {\"error\": \"not found\"})\n155\t\n156\t    def do_POST(self):\n157\t        url = urllib.parse.urlsplit(self.path)\n158\t        if url.path == \"/api/intervals/disconnect\":\n159\t            user = self.require_user()\n160\t            if user:\n161\t                with LOCK:\n162\t                    CONNECTIONS.pop(user[\"id\"], None)\n163\t                self.send_json(200, {\"ok\": True})\n164\t            return\n165\t        self.send_json(404, {\"error\": \"not found\"})\n166\t\n167\t    # Step 1: build the authorize URL and send the browser to Intervals.\n168\t    def auth_init(self):\n169\t        user = self.require_user()\n170\t        if not user:\n171\t            return\n172\t        params = {\"client_id\": config.CLIENT_ID, \"redirect_uri\": config.REDIRECT_URI,\n173\t                  \"scope\": config.SCOPES, \"state\": sign_state(user[\"id\"])}\n174\t        self.redirect(AUTHORIZE_URL + \"?\" + urllib.parse.urlencode(params, safe=\":,\"))\n175\t\n176\t    # Step 2: Intervals redirects back here with ?code=&state=.\n177\t    def callback(self, q):\n178\t        user_id = verify_state(q.get(\"state\", \"\"))\n179\t        if not user_id or not q.get(\"code\"):\n180\t            return self.send_json(400, {\"error\": \"bad state or code\"})\n181\t        try:\n182\t            tok = exchange_code(q[\"code\"])\n183\t            store_connection(user_id, tok)\n184\t        except urllib.error.HTTPError as e:\n185\t            log(f\"{user_id}: token exchange failed: HTTP {e.code} {e.read()[:200]!r}\")\n186\t            return self.send_json(502, {\"error\": \"token exchange failed\"})\n187\t        except Exception as e:\n188\t            log(f\"{user_id}: token exchange failed: {e}\")\n189\t            return self.send_json(502, {\"error\": \"token exchange failed\"})\n190\t        self.redirect(\"/?connected=1\")\n191\t\n192\t    def status(self):\n193\t        user = self.require_user()\n194\t        if not user:\n195\t            return\n196\t        with LOCK:\n197\t            c = CONNECTIONS.get(user[\"id\"])\n198\t        if not c or c[\"status\"] != \"connected\":\n199\t            return self.send_json(200, {\"connected\": False, \"status\": c[\"status\"] if c else \"disconnected\"})\n200\t        self.send_json(200, {\"connected\": True, \"status\": \"connected\", \"scope\": c[\"scope\"],\n201\t                             \"athlete\": {\"id\": c[\"athlete_id\"], \"name\": c[\"athlete_name\"]}})\n202\t\n203\t    def wellness(self):\n204\t        user = self.require_user()\n205\t        if not user:\n206\t            return\n207\t        with LOCK:\n208\t            c = CONNECTIONS.get(user[\"id\"])\n209\t        if not c or c[\"status\"] != \"connected\":\n210\t            return self.send_json(409, {\"error\": \"intervals not connected\"})\n211\t        try:\n212\t            code, data = intervals_get(c, \"/wellness\")\n213\t            self.send_json(code, data)\n214\t        except urllib.error.HTTPError as e:\n215\t            self.send_json(e.code, {\"error\": f\"intervals returned {e.code}\"})\n216\t        except Exception as e:\n217\t            self.send_json(502, {\"error\": str(e)})\n218\t\n219\t\n220\tif __name__ == \"__main__\":\n221\t    threading.Thread(target=refresh_tokens, daemon=True).start()\n222\t    log(f\"serving on http://localhost:{config.PORT} (intervals: {config.INTERVALS_BASE})\")\n223\t    ThreadingHTTPServer((\"127.0.0.1\", config.PORT), Handler).serve_forever()"}
