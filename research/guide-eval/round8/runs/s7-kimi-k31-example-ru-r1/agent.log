{"role":"assistant","tool_calls":[{"type":"function","id":"tool_dAvc7ZNgUBgiC7Qp04rsiyU0","function":{"name":"Bash","arguments":"{\"command\":\"python3 - <<'PY'\\nimport http.client\\nimport json\\nimport threading\\nimport time\\nimport urllib.parse\\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\\nfrom unittest import mock\\n\\nimport server\\n\\n\\nclass ProviderHandler(BaseHTTPRequestHandler):\\n    def log_message(self, fmt, *args):\\n        pass\\n\\n    def send_json(self, status, body):\\n        data = json.dumps(body).encode()\\n        self.send_response(status)\\n        self.send_header('Content-Type', 'application/json')\\n        self.send_header('Content-Length', str(len(data)))\\n        self.end_headers()\\n        self.wfile.write(data)\\n\\n    def do_POST(self):\\n        assert self.path == '/api/oauth/token'\\n        body = self.rfile.read(int(self.headers.get('Content-Length', 0))).decode()\\n        self.server.token_requests.append(dict(urllib.parse.parse_qsl(body)))\\n        self.send_json(200, {\\n            'token_type': 'bearer',\\n            'access_token': self.server.next_token,\\n            'scope': 'ACTIVITY:WRITE,WELLNESS:READ,CALENDAR:WRITE',\\n            'athlete': {'id': self.server.athlete_id, 'name': 'T. Rivera'},\\n        })\\n\\n    def do_GET(self):\\n        self.server.api_requests.append({\\n            'path': self.path,\\n            'authorization': self.headers.get('Authorization'),\\n        })\\n        if self.server.revoked:\\n            return self.send_json(401, {'error': 'revoked'})\\n        assert self.path == '/api/v1/athlete/i98765/wellness'\\n        self.send_json(200, {'wellness': [{'id': 1}]})\\n\\n\\nprovider = ThreadingHTTPServer(('127.0.0.1', 0), ProviderHandler)\\nprovider.token_requests = []\\nprovider.api_requests = []\\nprovider.revoked = False\\nprovider.athlete_id = 'i98765'\\nprovider.next_token = 'token-a'\\nprovider_base = f'http://127.0.0.1:{provider.server_port}'\\n\\nserver.CONNECTIONS.clear()\\nserver.TOKEN_URL = provider_base + '/api/oauth/token'\\nserver.AUTHORIZE_URL = provider_base + '/oauth/authorize'\\nserver.config.INTERVALS_BASE = provider_base\\napp = ThreadingHTTPServer(('127.0.0.1', 0), server.Handler)\\nserver.config.REDIRECT_URI = f'http://127.0.0.1:{app.server_port}/api/intervals/callback'\\n\\nthreads = [\\n    threading.Thread(target=provider.serve_forever, daemon=True),\\n    threading.Thread(target=app.serve_forever, daemon=True),\\n]\\nfor thread in threads:\\n    thread.start()\\n\\n\\ndef request(method, path, authenticated=True):\\n    conn = http.client.HTTPConnection('127.0.0.1', app.server_port, timeout=5)\\n    headers = {'Authorization': 'Bearer tok-rivera'} if authenticated else {}\\n    conn.request(method, path, body=b'' if method == 'POST' else None, headers=headers)\\n    response = conn.getresponse()\\n    raw = response.read()\\n    result = (response.status, dict(response.getheaders()), json.loads(raw) if raw else None)\\n    conn.close()\\n    return result\\n\\n\\ndef connect(expected_status=302):\\n    status, _, init = request('POST', '/api/intervals/auth/init')\\n    assert status == 200\\n    query = dict(urllib.parse.parse_qsl(urllib.parse.urlsplit(init['authorize_url']).query))\\n    status, headers, _ = request(\\n        'GET',\\n        '/api/intervals/callback?' + urllib.parse.urlencode({'code': 'auth-code', 'state': query['state']}),\\n        authenticated=False,\\n    )\\n    assert status == expected_status\\n    return query\\n\\n\\ntry:\\n    status, _, body = request('POST', '/api/intervals/auth/init', authenticated=False)\\n    assert (status, body) == (401, {'error': 'unauthorized'})\\n    status, _, _ = request('GET', '/api/intervals/auth/init')\\n    assert status == 404\\n\\n    status, _, init = request('POST', '/api/intervals/auth/init')\\n    assert status == 200\\n    authorize = urllib.parse.urlsplit(init['authorize_url'])\\n    query = dict(urllib.parse.parse_qsl(authorize.query))\\n    assert query['scope'] == 'ACTIVITY:WRITE,WELLNESS:READ,CALENDAR:WRITE'\\n    areas = [scope.split(':')[0] for scope in query['scope'].split(',')]\\n    assert len(areas) == len(set(areas))\\n    assert server.verify_state(query['state']) == 'u_rivera'\\n    with mock.patch.object(server.time, 'time', return_value=time.time() + 901):\\n        assert server.verify_state(query['state']) is None\\n\\n    callback_path = '/api/intervals/callback?' + urllib.parse.urlencode({\\n        'code': 'auth-code', 'state': query['state'],\\n    })\\n    status, headers, _ = request('GET', callback_path, authenticated=False)\\n    assert status == 302 and headers['Location'] == '/?connected=1'\\n    assert provider.token_requests[-1] == {\\n        'client_id': server.config.CLIENT_ID,\\n        'client_secret': server.config.CLIENT_SECRET,\\n        'code': 'auth-code',\\n    }\\n    connection = server.CONNECTIONS['u_rivera']\\n    assert connection['access_token'] == 'token-a'\\n    assert 'expires_at' not in connection and 'refresh_token' not in connection\\n\\n    status, _, status_body = request('GET', '/api/intervals/status')\\n    assert status == 200 and status_body['connected'] is True\\n    assert status_body['athlete']['id'] == 'i98765'\\n    status, _, wellness = request('GET', '/api/intervals/wellness')\\n    assert status == 200 and wellness == {'wellness': [{'id': 1}]}\\n    assert provider.api_requests[-1] == {\\n        'path': '/api/v1/athlete/i98765/wellness',\\n        'authorization': 'Bearer token-a',\\n    }\\n\\n    provider.revoked = True\\n    status, _, body = request('GET', '/api/intervals/wellness')\\n    assert status == 409 and 'reconnect' in body['error']\\n    assert server.CONNECTIONS['u_rivera']['access_token'] is None\\n    status, _, status_body = request('GET', '/api/intervals/status')\\n    assert status_body == {'connected': False, 'status': 'revoked, reconnect'}\\n\\n    provider.revoked = False\\n    provider.next_token = 'token-b'\\n    connect()\\n    assert server.CONNECTIONS['u_rivera']['access_token'] == 'token-b'\\n    assert server.CONNECTIONS['u_rivera']['status'] == 'connected'\\n\\n    provider.athlete_id = 'i-other'\\n    provider.next_token = 'token-c'\\n    connect(expected_status=409)\\n    assert server.CONNECTIONS['u_rivera']['athlete_id'] == 'i98765'\\n    assert server.CONNECTIONS['u_rivera']['access_token'] == 'token-b'\\n\\n    status, _, body = request('GET', '/api/intervals/callback?code=bad&state=bad', authenticated=False)\\n    assert status == 400 and body == {'error': 'bad state or code'}\\n\\n    print('PASS: authenticated POST init and legacy GET rejection')\\n    print('PASS: unique scopes, signed 15-minute state, standard-lite token exchange')\\n    print('PASS: perpetual token storage, athlete identity, wellness Bearer request')\\n    print('PASS: lazy 401 revocation handling, reconnect, account-mismatch guard')\\nfinally:\\n    app.shutdown()\\n    provider.shutdown()\\n    app.server_close()\\n    provider.server_close()\\n    for thread in threads:\\n        thread.join(timeout=5)\\nPY\",\"cwd\":\"/private/tmp/h-2HAP5O\",\"timeout\":60}"}}]}
