sert.strictEqual(init.opts.method, 'POST');\\n  assert.strictEqual(init.opts.headers.Authorization, 'Bearer tok-rivera');\\n  assert.strictEqual(redirectedTo, 'http://127.0.0.1/oauth/authorize?state=signed');\\n  assert.strictEqual(connect.disabled, true);\\n\\n  failInit = true;\\n  await connect.onclick();\\n  assert.strictEqual(connect.disabled, false);\\n  assert.strictEqual(connectError.textContent, 'Connect failed: unauthorized');\\n  console.log('PASS: SPA Connect uses authorized fetch POST and redirects to authorize_url');\\n  console.log('PASS: SPA restores the button and shows an error when init fails');\\n})().catch(error => {\\n  console.error(error);\\n  process.exitCode = 1;\\n});\\nJS\\nelse\\n  echo 'Node.js is unavailable; skipped SPA event-handler check'\\nfi\",\"cwd\":\"/private/tmp/h-2HAP5O\",\"timeout\":60}"}}]}
