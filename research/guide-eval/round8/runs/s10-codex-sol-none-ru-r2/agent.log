{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,180p' lib/screens/registration_screen.dart && sed -n '1,180p' lib/screens/offer_screen.dart\"","aggregated_output":"import 'dart:async';\n\nimport 'package:flutter/material.dart';\n\nimport '../analytics.dart';\n\nclass RegistrationScreen extends StatefulWidget {\n  const RegistrationScreen({super.key});\n\n  @override\n  State<RegistrationScreen> createState() => _RegistrationScreenState();\n}\n\nclass _RegistrationScreenState extends State<RegistrationScreen> {\n  final _email = TextEditingController();\n  final _phone = TextEditingController();\n  double _amount = 50000;\n  bool _terms = false;\n  bool _emailStarted = false;\n  bool _phoneStarted = false;\n  bool _amountChangedDuringDrag = false;\n\n  @override\n  void dispose() {\n    _email.dispose();\n    _phone.dispose();\n    super.dispose();\n  }\n\n  bool get _canContinue =>\n      _terms && _email.text.contains('@') && _phone.text.length >= 10;\n\n  void _onEmailChanged(String value) {\n    if (!_emailStarted && value.isNotEmpty) {\n      _emailStarted = true;\n      unawaited(Analytics.capture('registration_email_started'));\n    }\n    setState(() {});\n  }\n\n  void _onPhoneChanged(String value) {\n    if (!_phoneStarted && value.isNotEmpty) {\n      _phoneStarted = true;\n      unawaited(Analytics.capture('registration_phone_started'));\n    }\n    setState(() {});\n  }\n\n  @override\n  Widget build(BuildContext context) {\n    return Scaffold(\n      appBar: AppBar(title: const Text('Register')),\n      body: Padding(\n        padding: const EdgeInsets.all(16),\n        child: Column(\n          crossAxisAlignment: CrossAxisAlignment.stretch,\n          children: [\n            TextField(\n              controller: _email,\n              keyboardType: TextInputType.emailAddress,\n              decoration: const InputDecoration(labelText: 'Email'),\n              onChanged: _onEmailChanged,\n            ),\n            const SizedBox(height: 12),\n            TextField(\n              controller: _phone,\n              keyboardType: TextInputType.phone,\n              decoration: const InputDecoration(labelText: 'Phone'),\n              onChanged: _onPhoneChanged,\n            ),\n            const SizedBox(height: 24),\n            Text('Loan amount: ${_amount.round()}'),\n            Slider(\n              min: 10000,\n              max: 500000,\n              divisions: 49,\n              value: _amount,\n              label: _amount.round().toString(),\n              onChanged: (value) {\n                if (value != _amount) {\n                  _amountChangedDuringDrag = true;\n                  setState(() => _amount = value);\n                }\n              },\n              onChangeEnd: (value) {\n                if (_amountChangedDuringDrag) {\n                  unawaited(Analytics.capture(\n                    'loan_amount_changed',\n                    {'amount': value.round()},\n                  ));\n                  _amountChangedDuringDrag = false;\n                }\n              },\n            ),\n            CheckboxListTile(\n              value: _terms,\n              title: const Text('I accept the terms and conditions'),\n              controlAffinity: ListTileControlAffinity.leading,\n              onChanged: (value) {\n                final accepted = value ?? false;\n                if (accepted && !_terms) {\n                  unawaited(Analytics.capture('terms_accepted'));\n                }\n                setState(() => _terms = accepted);\n              },\n            ),\n            const Spacer(),\n            FilledButton(\n              onPressed: _canContinue\n                  ? () {\n                      unawaited(Analytics.capture(\n                        'registration_continue_tapped',\n                        {'amount': _amount.round(), 'terms': _terms},\n                      ));\n                      Navigator.of(context).pushNamed('/offers');\n                    }\n                  : null,\n              child: const Text('Continue'),\n            ),\n          ],\n        ),\n      ),\n    );\n  }\n}\nimport 'dart:async';\n\nimport 'package:flutter/material.dart';\n\nimport '../analytics.dart';\n\nclass Offer {\n  const Offer(this.bank, this.months, this.rate);\n  final String bank;\n  final int months;\n  final double rate;\n}\n\nconst _offers = [\n  Offer('Norbank', 12, 9.9),\n  Offer('Norbank', 24, 10.4),\n  Offer('Fjordcredit', 12, 8.7),\n  Offer('Fjordcredit', 36, 11.2),\n  Offer('Vestkapital', 24, 9.5),\n  Offer('Vestkapital', 48, 12.0),\n  Offer('Sparbank', 12, 10.9),\n  Offer('Sparbank', 60, 12.8),\n  Offer('Nordlån', 36, 10.1),\n  Offer('Nordlån', 60, 12.3),\n];\n\nclass OfferScreen extends StatefulWidget {\n  const OfferScreen({super.key});\n\n  @override\n  State<OfferScreen> createState() => _OfferScreenState();\n}\n\nclass _OfferScreenState extends State<OfferScreen> {\n  bool _didScroll = false;\n\n  bool _onScroll(ScrollNotification notification) {\n    if (notification is ScrollUpdateNotification &&\n        notification.scrollDelta != 0) {\n      _didScroll = true;\n    } else if (notification is ScrollEndNotification && _didScroll) {\n      _didScroll = false;\n      unawaited(Analytics.capture(\n        'offers_scrolled',\n        {'offset': notification.metrics.pixels.toDouble()},\n      ));\n    }\n    return false;\n  }\n\n  @override\n  Widget build(BuildContext context) {\n    return Scaffold(\n      appBar: AppBar(title: const Text('Offers')),\n      body: NotificationListener<ScrollNotification>(\n        onNotification: _onScroll,\n        child: ListView.builder(\n          itemCount: _offers.length,\n          itemBuilder: (context, i) {\n            final o = _offers[i];\n            return ListTile(\n              leading: const Icon(Icons.account_balance),\n              title: Text('${o.bank}, ${o.months} months'),\n              subtitle: Text('${o.rate.toStringAsFixed(1)}% APR'),\n              trailing: const Icon(Icons.chevron_right),\n              onTap: () {},\n            );\n          },\n        ),\n      ),\n    );\n  }\n}\n","exit_code":0,"status":"completed"}}
