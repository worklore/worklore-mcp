{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"python3 -m py_compile server.py config.py\npython3 - <<'PY'\nimport json, threading, urllib.request, urllib.error, urllib.parse\nfrom http.server import ThreadingHTTPServer\nimport server, config\n\nserver.CONNECTIONS.clear()\nhttp = ThreadingHTTPServer(('127.0.0.1', 0), server.Handler)\nthreading.Thread(target=http.serve_forever, daemon=True).start()\nbase = f'http://127.0.0.1:{http.server_port}'\ntry:\n    try:\n        urllib.request.urlopen(base + '/api/intervals/auth/init')\n        raise AssertionError('anonymous init should fail')\n    except urllib.error.HTTPError as e:\n        assert e.code == 401\n    req = urllib.request.Request(base + '/api/intervals/auth/init', headers={'Authorization': 'Bearer tok-okafor'})\n    data = json.load(urllib.request.urlopen(req))\n    url = urllib.parse.urlsplit(data['authorize_url'])\n    params = urllib.parse.parse_qs(url.query)\n    assert 'CALENDAR' not in params['scope'][0]\n    assert params['scope'][0] == config.SCOPES\n    assert server.verify_state(params['state'][0]) == 'u_okafor'\n    server.store_connection('u_rivera', {'access_token':'test', 'scope':'ACTIVITY:WRITE,WELLNESS:READ', 'athlete':{'id':'i98765','name':'T. Rivera'}})\n    assert server.CONNECTIONS['u_rivera']['expires_at'] is None\n    req = urllib.request.Request(base + '/api/intervals/status', headers={'Authorization': 'Bearer tok-rivera'})\n    assert json.load(urllib.request.urlopen(req))['connected'] is True\n    print('Local OAuth init, scope, state, and no-expiry checks passed')\nfinally:\n    http.shutdown()\nPY\nnode --check static/app.js\ngit diff --check\ngit status --short\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
