in/notify.sh\"\n\nSINCE=$(date -v-1d +%F)\nPROMPT=\"Review the commits in this repository since $SINCE.\nFor each commit: one line on what it changes and whether anything looks risky\n(migrations, auth, payments, deleted tests).\nEnd with a three-line summary I can read on my phone.\nDo not modify any file.\"\n\ncd \"$REPO\" || { \"$NOTIFY\" \"nightly review: repo missing\"; exit 1; }\n\nclaude -p \"$PROMPT\" --output-format text > \"$OUT\"\nstatus=$?\n\nif [ $status -ne 0 ]; then\n  \"$NOTIFY\" \"nightly review FAILED (exit $status), see $OUT\"\n  exit $status\nfi\n\n\"$NOTIFY\" \"nightly review done: $(head -c 300 \"$OUT\")\"\n","structuredPatch":[{"oldStart":13,"oldLines":14,"newStart":13,"newLines":27,"lines":[" End with a three-line summary I can read on my phone."," Do not modify any file.\""," ","+START=$(date +%s)","+echo \"$(date '+%F %T') start\"","+"," cd \"$REPO\" || { \"$NOTIFY\" \"nightly review: repo missing\"; exit 1; }"," ","-claude -p \"$PROMPT\" --output-format text > \"$OUT\"","-status=$?","+# Prompt goes through stdin, not argv: no multi-line argument parsing, and claude never waits on an open stdin.","+print -r -- \"$PROMPT\" | claude -p --output-format text > \"$OUT\"","+# Not `status`: it is read-only in zsh, and that assignment used to kill the script before any notification.","+rc=$?","+DURATION=$(( $(date +%s) - START ))","+echo \"$(date '+%F %T') claude exit=$rc duration=${DURATION}s\""," ","-if [ $status -ne 0 ]; then","-  \"$NOTIFY\" \"nightly review FAILED (exit $status), see $OUT\"","-  exit $status","+if [ $rc -ne 0 ]; then","+  \"$NOTIFY\" \"nightly review FAILED (exit $rc after ${DURATION}s), see $OUT\"","+  exit $rc"," fi"," ","+# Exit 0 is not proof of work: an empty summary is a failure too.","+if [ ! -s \"$OUT\" ]; then","+  \"$NOTIFY\" \"nightly review: claude exited 0 but $OUT is empty (after ${DURATION}s)\"","+  exit 1","+fi","+"," \"$NOTIFY\" \"nightly review done: $(head -c 300 \"$OUT\")\""]}],"userModified":false,"replace