diff --git a/bin/nightly-review.zsh b/bin/nightly-review.zsh
index e0b986f..6fac0b9 100755
--- a/bin/nightly-review.zsh
+++ b/bin/nightly-review.zsh
@@ -5,6 +5,7 @@ set -u
 REPO="$HOME/projects/shop"
 OUT="$HOME/Library/Logs/nightly-review-$(date +%F).md"
 NOTIFY="$HOME/bin/notify.sh"
+START=$(date +%s)
 
 SINCE=$(date -v-1d +%F)
 PROMPT="Review the commits in this repository since $SINCE.
@@ -15,12 +16,19 @@ Do not modify any file."
 
 cd "$REPO" || { "$NOTIFY" "nightly review: repo missing"; exit 1; }
 
-claude -p "$PROMPT" --output-format text > "$OUT"
-status=$?
+claude -p "$PROMPT" --output-format text < /dev/null > "$OUT"
+rc=$?
+elapsed=$(( $(date +%s) - START ))
+print -r -- "nightly review: claude exit $rc after ${elapsed}s; output $OUT"
 
-if [ $status -ne 0 ]; then
-  "$NOTIFY" "nightly review FAILED (exit $status), see $OUT"
-  exit $status
+if (( rc != 0 )); then
+  "$NOTIFY" "nightly review FAILED (exit $rc, ${elapsed}s), see $OUT"
+  exit $rc
 fi
 
-"$NOTIFY" "nightly review done: $(head -c 300 "$OUT")"
+if [[ ! -s "$OUT" ]]; then
+  "$NOTIFY" "nightly review FAILED (empty output after ${elapsed}s), see $OUT"
+  exit 1
+fi
+
+"$NOTIFY" "nightly review done (${elapsed}s): $(head -c 300 "$OUT")"
