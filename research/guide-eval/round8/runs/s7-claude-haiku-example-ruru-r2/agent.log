         c.update(access_token=tok[\"access_token\"],\n                             refresh_token=tok.get(\"refresh_token\", c[\"refresh_token\"]),\n                             expires_at=now + int(tok[\"expires_in\"]))\n                    log(f\"{uid}: token refreshed\")\n                except Exception as e:\n                    log(f\"{uid}: refresh failed ({e}) -> expired, reconnect\")\n                    c.update(status=\"expired, reconnect\", access_token=None)\n","new_string":"# Intervals issues no refresh_token and no expires_in: the token stays valid until\n# the athlete revokes the app. So we don't guess an expiry; a 401 from the API is the\n# only signal, handled in mark_expired().\ndef store_connection(user_id, tok):\n    athlete = tok.get(\"athlete\") or {}\n    with LOCK:\n        CONNECTIONS[user_id] = {\n            \"athlete_id\": athlete.get(\"id\"), \"athlete_name\": athlete.get(\"name\"),\n            \"access_token\": tok[\"access_token\"], \"scope\": tok.get(\"scope\"), \"status\": \"connected\",\n        }\n    log(f\"{user_id}: connected as athlete {athlete.get('id')}\")\n\n\ndef mark_expired(user_id):\n    log(f\"{user_id}: Intervals rejected the token (401) -> expired, reconnect\")\n    with LOCK:\n        c = CONNECTIONS.get(user_id)\n        if c:\n            c.update(status=\"expired, reconnect\", access_token=None)\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":8803,"cache_read_input_tokens":33007,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":8803},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"eb973276-0cfe-47de-9539-ef243e899561","uuid":"96f37848-d281-4016-816f-aa24cf75d431","timestamp":"2026-10-27T03:40:19.026Z","request_id":"req_