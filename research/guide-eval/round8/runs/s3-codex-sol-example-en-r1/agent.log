{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport os, subprocess, tempfile\n\nscript = Path('bin/nightly-review.zsh').resolve()\nwith tempfile.TemporaryDirectory(dir='.') as root:\n    home = Path(root).resolve()\n    for folder in ('bin', 'projects/shop', 'Library/Logs'):\n        (home / folder).mkdir(parents=True)\n    claude = home / 'bin/claude'\n    claude.write_text('''#\"'!/bin/sh\ncase \"$SCENARIO\" in\n  agent_failure) echo '\"'Not logged in' >&2; exit 7 ;;\n  empty) exit 0 ;;\n  *) printf 'review summary\\\\\\\\n'; exit 0 ;;\nesac\n''')\n    notify = home / 'bin/notify.sh'\n    notify.write_text('''#\"'!/bin/sh\nprintf '\"'%s\\\\\\\\n' \\\"\"'$1\" >> \"$HOME/notifications\"\nif [ \"$SCENARIO\" = notify_failure ]; then exit 9; fi\n'\"''')\n    claude.chmod(0o755)\n    notify.chmod(0o755)\n    for scenario, expected in [('success', 0), ('agent_failure', 7), ('empty', 1), ('notify_failure', 1)]:\n        note = home / 'notifications'\n        note.unlink(missing_ok=True)\n        env = dict(os.environ, HOME=str(home), PATH=f'{home / \\\"bin\\\"}:{os.environ[\\\"PATH\\\"]}', SCENARIO=scenario)\n        result = subprocess.run(['/bin/zsh', str(script)], env=env, capture_output=True, text=True)\n        message = note.read_text().strip() if note.exists() else '<none>'\n        print(f'{scenario}: rc={result.returncode}, notification={message\"'!r}, stderr={result.stderr.strip()!r}'\"')\n        assert result.returncode == expected, scenario\n        assert ('FAILED' in message) == (scenario in ('agent_failure', 'empty')), scenario\n        assert 'notification failed' in result.stderr if scenario == 'notify_failure' else True\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
