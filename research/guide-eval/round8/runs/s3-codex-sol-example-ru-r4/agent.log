{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nfrom pathlib import Path\nfrom tempfile import TemporaryDirectory\nimport os, subprocess\nroot = Path.cwd()\nscript = root / 'bin/nightly-review.zsh'\nwith TemporaryDirectory(dir=root, prefix='.nightly-test-') as td:\n    home = Path(td)\n    for p in ('projects/shop', 'Library/Logs', 'bin'):\n        (home / p).mkdir(parents=True)\n    notifier = home / 'bin/notify.sh'\n    notifier.write_text('#\"'!/bin/sh'\"\\\\nprintf \\\"%s\\\\\\\\n\\\" \\\"\"'$1\" >> \"$HOME/messages\"'\"\\\\n[ \\\"\"'$MOCK_NOTIFY_FAIL\" != 1 ]'\"\\\\n')\n    notifier.chmod(0o755)\n    agent = home / 'bin/claude'\n    agent.write_text('#\"'!/bin/sh'\"\\\\nif read line; then echo \\\"unexpected stdin\\\" >&2; exit 9; fi\\\\ncase \\\"\"'$MOCK_MODE\" in'\"\\\\n fail) echo \\\"simulated auth error\\\" >&2; exit 7;;\\\\n empty) exit 0;;\\\\n success) echo \\\"review summary\\\";;\\\\nesac\\\\n')\n    agent.chmod(0o755)\n    env = dict(os.environ, HOME=str(home), PATH=str(home / 'bin') + ':' + os.environ['PATH'], MOCK_NOTIFY_FAIL='0')\n    cases = [('fail', '0', 7, 'FAILED'), ('empty', '0', 1, 'FAILED'), ('success', '0', 0, 'done'), ('success', '1', 1, 'notification failed')]\n    for mode, notify_fail, expected_rc, expected_text in cases:\n        (home / 'messages').unlink(missing_ok=True)\n        result = subprocess.run(['/bin/zsh', str(script)], env={**env, 'MOCK_MODE':mode, 'MOCK_NOTIFY_FAIL':notify_fail}, text=True, capture_output=True)\n        messages = (home / 'messages').read_text() if (home / 'messages').exists() else ''\n        combined = messages + result.stderr\n        assert result.returncode == expected_rc, (mode, result.returncode, result.stderr)\n        assert expected_text in combined, (mode, combined)\n        print(f'{mode}, notify_fail={notify_fail}: exit={result.returncode}, message={messages.strip()\"'!r}'\"')\nPY\"","aggregated_output":"","exit_code":null