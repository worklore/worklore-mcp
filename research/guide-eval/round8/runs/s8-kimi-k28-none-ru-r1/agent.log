[1][\\\"text\\\"] != r1[\\\"system\\\"][1][\\\"text\\\"], \\\"dynamic block should carry the change\\\"\\nprint(\\\"cached prefix byte-identical across save_fact -> cache hit, only the tail is reprocessed\\\")\\n\\n# 3) full tool loop with a fake LLM: save_fact mid-loop must not error\\ncalls = {\\\"n\\\": 0}\\nclass FakeUsage:\\n    input_tokens = 10; cache_creation_input_tokens = 0\\n    cache_read_input_tokens = 1000; output_tokens = 5\\nclass FakeBlock:\\n    def __init__(self, t): self.type = t; self.name = None; self.id = \\\"x\\\"; self.input = {\\\"fact\\\": \\\"test\\\"}; self._t = t\\n    def model_dump(self): return {\\\"type\\\": self.type}\\n    @property\\n    def text(self): return \\\"done \\\" if self.type == \\\"text\\\" else \\\"\\\"\\nclass FakeResp:\\n    def __init__(self, tool):\\n        self.content = [FakeBlock(\\\"tool_use\\\")] if tool else [FakeBlock(\\\"text\\\")]\\n        self.stop_reason = \\\"tool_use\\\" if tool else \\\"end_turn\\\"\\n        self.usage = FakeUsage()\\nclass FakeLLM:\\n    def create(self, **kw):\\n        calls[\\\"n\\\"] += 1\\n        assert kw[\\\"system\\\"][0].get(\\\"cache_control\\\"), \\\"static block must carry the marker\\\"\\n        assert not kw[\\\"system\\\"][1].get(\\\"cache_control\\\"), \\\"dynamic block must stay unmarked\\\"\\n        return FakeResp(tool=calls[\\\"n\\\"] == 1)\\n\\nbot.log_usage = lambda *args, **kw: None   # keep logs/usage.jsonl untouched\\nbot.save_athlete = lambda a: None          # keep data/athletes.json untouched\\nout = bot.reply(\\\"42\\\", \\\"remember this\\\", llm=FakeLLM())\\nassert out == \\\"done \\\" and calls[\\\"n\\\"] == 2\\nprint(\\\"tool loop end-to-end OK: 2 rounds, save_fact inside the loop, reply returned\\\")\\nEOF\"}"}}]}
