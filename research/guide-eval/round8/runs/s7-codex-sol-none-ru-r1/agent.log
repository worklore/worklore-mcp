grant_type\": \"refresh_token\", \"refresh_token\": c[\"refresh_token\"],\n-                        \"client_id\": config.CLIENT_ID, \"client_secret\": config.CLIENT_SECRET,\n-                    })\n+            log(f\"{uid}: token expired without a refresh token -> reconnect\")\n+            continue\n+        try:\n+            tok = post_form(TOKEN_URL, {\n+                \"grant_type\": \"refresh_token\", \"refresh_token\": c[\"refresh_token\"],\n+                \"client_id\": config.CLIENT_ID, \"client_secret\": config.CLIENT_SECRET,\n+            })\n+            expires_in = tok.get(\"expires_in\")\n+            with LOCK:\n+                if CONNECTIONS.get(uid) is c and c[\"status\"] == \"connected\":\n                     c.update(access_token=tok[\"access_token\"],\n                              refresh_token=tok.get(\"refresh_token\", c[\"refresh_token\"]),\n-                             expires_at=now + int(tok[\"expires_in\"]))\n-                    log(f\"{uid}: token refreshed\")\n-                except Exception as e:\n-                    log(f\"{uid}: refresh failed ({e}) -> expired, reconnect\")\n+                             expires_at=time.time() + int(expires_in) if expires_in is not None else None)\n+            log(f\"{uid}: token refreshed\")\n+        except Exception as e:\n+            with LOCK:\n+                if CONNECTIONS.get(uid) is c and c[\"status\"] == \"connected\":\n                     c.update(status=\"expired, reconnect\", access_token=None)\n+            log(f\"{uid}: refresh failed ({e}) -> expired, reconnect\")\n \n \n def intervals_get(conn, path):\n@@ -185,14 +197,15 @@ class Handler(BaseHTTPRequestHandler):\n             return\n         self.send_json(404, {\"error\": \"not found\"})\n \n-    # Step 1: build the authorize URL and send the browser to Intervals.\n+    # Step 1: return the authorize URL to the authenticated SPA request.\n+    # A document navigation cannot include the SPA's Bearer token.\n     def auth_init(self):\n         user = self.require_user()\n         if not user:\n             return\n         params = {\"client_id\": config.CLIENT_ID, \"redirect_uri\": config.REDIRECT_URI,\n                   \"scope\": config.SCOPES, \"state\": sign_state(user[\"id\"])}\n-        self.redirect(AUTHORIZE_URL + \"?\" + urllib.parse.urlencode(params, safe=\":,\"))\n+        self.send_json(200, {\"authorize_url\": AUTHORIZE_URL + \"?\" + urllib.parse.urlencode(params)})\n \n     # Step 2: Intervals redirects back here with ?code=&state=.\n     def callback(self, q):\n@@ -233,6 +246,10 @@ class Handler(BaseHTTPRequestHandler):\n             code, data = intervals_get(c, \"/wellness\")\n             self.send_json(code, data)\n         except urllib.error.HTTPError as e:\n+            if e.code == 401:\n+                with LOCK:\n+                    if CONNECTIONS.get(user[\"id\"]) is c:\n+                        c.update(status=\"expired, reconnect\", access_token=None)\n             self.send_json(e.code, {\"error\": f\"intervals returned {e.code}\"})\n         except Exception as e:\n             self.send_json(502, {\"error\": str(e)})\ndiff --git a/static/app.js b/static/app.js\nindex 368922e..adfa5b6 100644\n--- a/static/app.js\n+++ b/static/app.js\n@@ -25,12 +25,23 @@ async function render() {\n     } else {\n       const why = st.status && st.status !== \"disconnected\" ? `<p class=\"muted\">Status: ${esc(st.status)}</p>` : \"\";\n       card = `<div class=\"card\">Intervals.icu is not connected.${why}\n-        <p><a class=\"btn\" href=\"/api/intervals/auth/init\">Connect Intervals.icu</a></p></div>`;\n+        <p><button class=\"btn\" id=\"connect\">Connect Intervals.icu</button></p></div>`;\n     }\n     root.className = \"\";\n     root.innerHTML = `<p>Signed in as <b>${esc(me.name)}</b>.</p>${card}`;\n     const d = document.getElementById(\"disconnect\");\n     if (d) d.onclick = async () => { await api(\"/api/intervals/disconnect\", { method: \"POST\" }); render(); };\n+    const c = document.getElementById(\"connect\");\n+    if (c) c.onclick = async () => {\n+      c.disabled = true;\n+      try {\n+        const { authorize_url } = await api(\"/api/intervals/auth/init\");\n+        window.location.assign(authorize_url);\n+      } catch (e) {\n+        c.disabled = false;\n+        root.insertAdjacentHTML(\"beforeend\", `<p class=\"card\">Error: ${esc(e.message)}</p>`);\n+      }\n+    };\n   } catch (e) {\n     root.innerHTML = `<p class=\"card\">Error: ${esc(e.message)}</p>`;\n   }\n# Причины неисправности Intervals.icu\n\n1. Кнопка `Connect Intervals.icu` была обычной ссылкой на `/api/intervals/auth/init`. Переход браузера по ссылке не использует `fetch`-обёртку приложения и не добавляет `Authorization: Bearer ...`. Сервер поэтому отвечал `401`, что прямо видно в `logs/connect-attempt.log`. Теперь кнопка сначала запрашивает URL авторизации через `api()` с токеном приложения, затем открывает полученный URL.\n\n2. В запрос OAuth добавили `CALENDAR:READ` и `CALENDAR:WRITE`. После этого Intervals.icu стал отвечать `400 invalid_request` до экрана согласия; до изменения работал набор `ACTIVITY:WRITE,WELLNESS:READ`. Календарные разрешения в таком виде для этого OAuth-запроса не подходят. Возвращён ранее работавший набор: `ACTIVITY:WRITE,WELLNESS:READ`. Запланированные тренировки записываются как активности.\n\n3. Ответ с токеном у Rivera не содержал ни `expires_in`, ни `refresh_token`, но код назначал ему срок жизни 3600 секунд. Фоновый процесс затем объявлял действующее подключение истёкшим примерно через час. Теперь срок жизни устанавливается только по явному `expires_in` от провайдера. Если провайдер вернёт `401` при запросе wellness, подключение помечается как требующее повторного согласия. Для токенов с явным сроком жизни обновление по `refresh_token` сохранено.\n\nПроверка: `python3 -m unittest -v test_intervals.py` — локальные тесты подключения, callback, срока жизни, обновления и отзыва доступа; `node --check static/app.js`; `git diff --check`. К Intervals.icu и другим внешним сервисам запросы не отправлялись.\n","exit_code":0,"status":"completed"}}
