ntrol marker. Tail (tools+messages) is billed as fresh input.\\\"\\\"\\\"\\n    def __init__(s): s.seen = {}\\n    def create(s, **kw):\\n        segs, cur = [], []\\n        for blk in kw[\\\"system\\\"]:\\n            cur.append(blk[\\\"text\\\"])\\n            if blk.get(\\\"cache_control\\\"):\\n                segs.append(\\\"\\\\n\\\".join(cur)); cur = []\\n        tail = [\\\"\\\\n\\\".join(cur)] + [str(t) for t in kw[\\\"tools\\\"]] + [str(m) for m in kw[\\\"messages\\\"]]\\n        cr = cc = 0\\n        for i, seg in enumerate(segs):\\n            if s.seen.get(i) == seg: cr += len(seg.split())\\n            else: s.seen[i] = seg; cc += len(seg.split())\\n        fresh = sum(len(t.split()) for t in tail)\\n        n_results = sum(1 for m in kw[\\\"messages\\\"] for c in (m[\\\"content\\\"] if isinstance(m[\\\"content\\\"], list) else [])\\n                        if isinstance(c, dict) and c.get(\\\"type\\\") == \\\"tool_result\\\")\\n        if n_results == 0:\\n            return R([B(\\\"tool_use\\\", id=\\\"tu1\\\", name=\\\"save_fact\\\", input={\\\"fact\\\": \\\"New fact from save_fact\\\"})],\\n                     \\\"tool_use\\\", U(fresh, cc, cr, 12))\\n        return R([B(\\\"text\\\", text=\\\"ok\\\")], \\\"end_turn\\\", U(fresh, cc, cr, 6))\\n\\nfake = FakeLLM()\\nout1 = bot.reply(\\\"42\\\", \\\"remember this\\\", llm=fake)        # round1: save_fact -> round2 rebuilds system with new fact\\nout2 = bot.reply(\\\"42\\\", \\\"and one more thing\\\", llm=fake)   # next message, facts changed\\nprint(\\\"replies:\\\", out1, \\\"/\\\", out2)\\nassert out1 == \\\"ok\\\" and out2 == \\\"ok\\\"\\n\\n# 4) compare against the OLD behavior: one combined block, single marker\\nold = [{\\\"type\\\": \\\"text\\\", \\\"text\\\": bot.INSTRUCTIONS + \\\"\\\\n\\\\n\\\" + bot.athlete_context(a, today),\\n        \\\"cache_control\\\": {\\\"type\\\": \\\"ephemeral\\\"}}]\\ninst_words = len(bot.INSTRUCTIONS.split())\\nprint(f\\\"instructions block: ~{inst_words} w