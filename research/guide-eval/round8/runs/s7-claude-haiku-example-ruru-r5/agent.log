         c.update(access_token=tok[\"access_token\"],\n                             refresh_token=tok.get(\"refresh_token\", c[\"refresh_token\"]),\n                             expires_at=now + int(tok[\"expires_in\"]))\n                    log(f\"{uid}: token refreshed\")\n                except Exception as e:\n                    log(f\"{uid}: refresh failed ({e}) -> expired, reconnect\")\n                    c.update(status=\"expired, reconnect\", access_token=None)\n\n\ndef intervals_get","new_string":"def store_connection(user_id, tok):\n    athlete = tok.get(\"athlete\") or {}\n    with LOCK:\n        CONNECTIONS[user_id] = {\n            \"athlete_id\": athlete.get(\"id\"), \"athlete_name\": athlete.get(\"name\"),\n            \"access_token\": tok[\"access_token\"], \"scope\": tok.get(\"scope\"), \"status\": \"connected\",\n        }\n    log(f\"{user_id}: connected as athlete {athlete.get('id')} (no expiry given)\")\n\n\ndef mark_revoked(user_id):\n    \"\"\"Called when Intervals answers 401: the athlete revoked the app or the token is gone.\"\"\"\n    with LOCK:\n        c = CONNECTIONS.get(user_id)\n        if c:\n            c.update(status=\"expired, reconnect\", access_token=None)\n    log(f\"{user_id}: Intervals rejected the token (401) -> expired, reconnect\")\n\n\ndef intervals_get"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6635,"cache_read_input_tokens":38086,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":6635},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"7acde84c-9778-4091-b733-f33e5c9df5dc","uuid":"03fcebcb-0a15-4979-9124-9be383c01fde","timestamp":"2026-10-27T05:26:10.898Z","request_id":"req_011CgSBn18Z2bV4BuDZRyWPb","wire_tool_inputs":{"toolu