es_at, \"status\": \"connected\",\n        }\n    log(f\"{user_id}: connected as athlete {athlete.get('id')} scope {tok.get('scope')} \"\n        f\"({'expires in %ss' % expires_in if expires_in else 'no expiry'})\")\n''')\nrep('''    \"\"\"Background pass: renew access tokens shortly before they expire.\"\"\"\n    while True:\n        time.sleep(config.REFRESH_INTERVAL)\n        now = time.time()\n        with LOCK:\n            for uid, c in CONNECTIONS.items():\n                if c[\"status\"] != \"connected\" or c[\"expires_at\"] - now > 300:\n                    continue\n                if not c[\"refresh_token\"]:\n                    log(f\"{uid}: token expiry passed and no refresh token on file -> expired, reconnect\")\n                    c.update(status=\"expired, reconnect\", access_token=None)\n                    continue\n                try:\n                    tok = post_form(TOKEN_URL, {\n                        \"grant_type\": \"refresh_token\", \"refresh_token\": c[\"refresh_token\"],\n                        \"client_id\": config.CLIENT_ID, \"client_secret\": config.CLIENT_SECRET,\n                    })\n                    c.update(access_token=tok[\"access_token\"],\n                             refresh_token=tok.get(\"refresh_token\", c[\"refresh_token\"]),\n                             expires_at=now + int(tok[\"expires_in\"]))\n                    log(f\"{uid}: token refreshed\")\n                except Exception as e:\n                    log(f\"{uid}: refresh failed ({e}) -> expired, reconnect\")\n                    c.update(status=\"expired, reconnect\", access_token=None)\n''','''    \"\"\"Background pass: renew access tokens shortly before they expire.\n\n    Only applies to tokens that came with an expires_in and a refresh_token;\n    non-expiring tokens (the Intervals.icu norm) are left alone.\n    \"\"\"\n    while True:\n        time.sleep(config.REFRESH_INTERVAL)\n        now = time.time()\n        with LOCK:\n            due = [(uid, c[\"refresh_token\"]) for uid, c in CONNECTIONS.items()\n                   if c[\"status\"] == \"connected\" and c[\"expires_at\"] is not None\n                   and c[\"refresh_token\"] and c[\"expires_at\"] - now <= 300]\n        for uid, refresh in due:   # network calls outside the lock\n            try:\n                tok = post_form(TOKEN_URL, {\n                    \"grant_type\": \"refresh_token\", \"refresh_token\": refresh,\n                    \"client_id\": config.CLIENT_ID, \"client_secret\": config.CLIENT_SECRET,\n                })\n            except urllib.error.HTTPError as e:\n                if e.code in (400, 401):   # refresh token rejected: the grant is gone\n                    log(f\"{uid}: refresh rejected (HTTP {e.code}) -> expired, reconnect\")\n                    mark_expired(uid)\n                else:\n                    log(f\"{uid}: refresh failed (HTTP {e.code}), will retry\")\n                continue\n            except Exception as e:\n                log(f\"{uid}: refresh failed ({e}), will retry\")\n                continue\n            expires_in = tok.get(\"expires_in\")\n            with LOCK:\n                c = CONNECTIONS.get(uid)\n                if c and c[\"refresh_token\"] == refresh:\n                    c.update(access_token=tok[\"access_token\"],\n                             refresh_token=tok.get(\"refresh_token\", refresh),\n                             expires_at=time.time() + int(expires_in) if expires_in else None)\n            log(f\"{uid}: token refreshed\")\n\n\ndef mark_expired(user_id):\n    with LOCK:\n        c = CONNECTIONS.get(user_id)\n        if c:\n            c.update(status=\"expired, reconnect\", access_token=None)\n''')\nrep('''    # Step 1: build the authorize URL and send the browser to Intervals.\n    def auth_init(self):\n        user = self.require_user()\n        if not user:\n            return\n        params = {\"client_id\": config.CLIENT_ID, \"redirect_uri\": config.REDIRECT_URI,\n                  \"scope\": config.SCOPES, \"state\": sign_state(user[\"id\"])}\n        self.redirect(AUTHORIZE_URL + \"?\" + urllib.parse.urlencode(params, safe=\":,\"))\n''','''    # Step 1: build the authorize URL. The SPA fetches this with its Bearer\n    # token (a plain link/navigation cannot carry the Authorization header)\n    # and then sends the browser to the returned URL itself.\n    def auth_init(self):\n        user = self.require_user()\n        if not user:\n            return\n        params = {\"client_id\": config.CLIENT_ID, \"redirect_uri\": config.REDIRECT_URI,\n                  \"scope\": config.SCOPES, \"state\": sign_state(user[\"id\"])}\n        self.send_json(200, {\"authorize_url\": AUTHORIZE_URL + \"?\" + urllib.parse.urlencode(params, safe=\":,\")})\n''')\nrep('''        except urllib.error.HTTPError as e:\n            self.send_json(e.code, {\"error\": f\"intervals returned {e.code}\"})''','''        except urllib.error.HTTPError as e:\n            if e.code == 401:   # token revoked on the Intervals side\n                log(f\"{user['id']}: Intervals rejected the token (401) -> expired, reconnect\")\n                mark_expired(user[\"id\"])\n            self.send_json(e.code, {\"error\": f\"intervals returned {e.code}\"})''')\nopen(p,'w').write(s)\n\np='config.py'; s=open(p).read()\ns=s.replace('''SCOPES = \"ACTIVITY:READ,ACTIVITY:WRITE,WELLNESS:READ,CALENDAR:READ,CALENDAR:WRITE\"''','''# One entry per area: Intervals.icu scopes are AREA:READ or AREA:WRITE, WRITE\n# already includes READ, and naming an area twice gets the authorize request\n# rejected with invalid_request.\nSCOPES = \"ACTIVITY:WRITE,WELLNESS:READ,CALENDAR:WRITE\"''')\nopen(p,'w').write(s)\n\np='static/app.js'; s=open(p).read()\ns=s.replace('''<p><a class=\"btn\" href=\"/api/intervals/auth/init\">Connect Intervals.icu</a></p></div>`;''','''<p><button class=\"btn\" id=\"connect\">Connect Intervals.icu</button></p></div>`;''')\ns=s.replace('''    const