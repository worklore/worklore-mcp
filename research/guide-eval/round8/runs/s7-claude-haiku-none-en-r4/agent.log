(\"u_rivera\", {\"access_token\":\"x\",\"scope\":\"ACTIVITY:WRITE,WELLNESS:READ\",\"athlete\":{\"id\":\"i98765\",\"name\":\"T. Rivera\"}})\nc = server.CONNECTIONS[\"u_rivera\"]; print(\"no-expiry:\", c[\"expires_at\"], c[\"status\"])\n# simulate a long time passing: refresher must leave it alone\nserver.refresh_tokens.__globals__  # noqa\nnow = time.time() + 10*3600\nfor uid, c in server.CONNECTIONS.items():\n    if c[\"status\"] == \"connected\" and c[\"expires_at\"] is not None and c[\"expires_at\"] - now <= 300: print(\"WOULD EXPIRE\", uid)\nprint(\"refresher skips no-expiry token: ok\")\n# token with expires_in: refresh path expiry\nserver.store_connection(\"u_okafor\", {\"access_token\":\"y\",\"expires_in\":7200,\"athlete\":{\"id\":\"i1\"}})\nprint(\"with expires_in:\", round(server.CONNECTIONS[\"u_okafor\"][\"expires_at\"]-time.time()))\nprint(\"expiry_from none:\", server.expiry_from({}, time.time()))\nEOF\necho \"--- server log ---\"; cat /tmp/h-IfiaKz/srv.log","description":"Compile, run server, curl endpoints, check expiry logic"}},"wire_ingest_context":{"toolu_01CyxwHynMhEx9TykodiPuGe":{"cwd":"/private/tmp/h-IfiaKz"}}}
