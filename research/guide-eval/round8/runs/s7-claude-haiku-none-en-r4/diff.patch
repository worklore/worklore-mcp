+// A plain link cannot send the Authorization header, so ask the API for the
+// authorize URL with the token and then send the browser there.
+async function connect() {
+  try {
+    const { url } = await api("/api/intervals/auth/init", { method: "POST" });
+    location.href = url;
+  } catch (e) {
+    root.insertAdjacentHTML("beforeend", `<p class="card">Error: ${esc(e.message)}</p>`);
+  }
+}
+
 render();
