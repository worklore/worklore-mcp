{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport os, pathlib, shutil, subprocess, tempfile\nroot = pathlib.Path.cwd()\nwith tempfile.TemporaryDirectory(dir=root) as td:\n    home = pathlib.Path(td)\n    (home/'bin').mkdir()\n    (home/'projects/shop').mkdir(parents=True)\n    (home/'Library/Logs').mkdir(parents=True)\n    shutil.copy2(root/'bin/nightly-review.zsh', home/'bin/nightly-review.zsh')\n    (home/'bin/notify.sh').write_text('#\"'!/bin/sh'\"\\\\nprintf \\\"%s\\\\\\\\n\\\" \\\"\"'$1\" >> \"$HOME/messages\"'\"\\\\n')\n    (home/'bin/notify.sh').chmod(0o755)\n    mockbin = home/'mockbin'; mockbin.mkdir()\n    claude = mockbin/'claude'\n    env = {**os.environ, 'HOME': str(home), 'PATH': str(mockbin)+':'+os.environ['PATH']}\n    for name, body, expected_code, expected_text in [\n        ('auth failure', '#\"'!/bin/sh'\"\\\\necho \\\"Not logged in · Please run /login\\\" >&2\\\\nexit 1\\\\n', 1, 'FAILED (Claude exit 1)'),\n        ('success', '#\"'!/bin/sh'\"\\\\necho \\\"Review complete\\\"\\\\n', 0, 'done: Review complete'),\n        ('empty output', '#\"'!/bin/sh'\"\\\\nexit 0\\\\n', 1, 'FAILED (Claude returned an empty review)'),\n    ]:\n        claude.write_text(body); claude.chmod(0o755)\n        (home/'messages').unlink(missing_ok=True)\n        result = subprocess.run(['/bin/zsh', str(home/'bin/nightly-review.zsh')], env=env, capture_output=True, text=True)\n        messages = (home/'messages').read_text() if (home/'messages').exists() else ''\n        assert result.returncode == expected_code, (name, result.returncode, result.stderr)\n        assert expected_text in messages, (name, messages, result.stderr)\n        print(f'{name}: exit {result.returncode}; notification present')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
