{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport json\nimport subprocess\n\nplan = json.load(open('plans/tempo-run.json'))\nevent = json.loads(subprocess.check_output(['python3', 'gen.py', 'plans/tempo-run.json']))\n\ndef flatten(plan_steps, generated_steps):\n    for source, output in zip(plan_steps, generated_steps, strict=True):\n        if 'repeat' in source:\n            assert output['reps'] == source['repeat']\n            yield from flatten(source['steps'], output['steps'])\n        else:\n            assert output['duration'] == source['minutes'] * 60\n            assert output['text'] == source['label']\n            if 'hr_pct' in source:\n                lo, hi = source['hr_pct']\n                assert output['hr'] == {'units': '%lthr', 'start': lo, 'end': hi}\n                yield source['label'], lo, hi\n\nchecked = list(flatten(plan['steps'], event['workout_doc']['steps']))\nassert len(checked) == 4\nprint('Validated HR start/end, percentages, durations, labels, and repeat count:', checked)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
