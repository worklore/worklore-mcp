{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport io, json, urllib.parse\nfrom unittest.mock import patch\nimport config, server\nfrom http.server import ThreadingHTTPServer\nfrom threading import Thread\n\nassert len({s.split(':')[0] for s in config.SCOPES.split(',')}) == len(config.SCOPES.split(','))\nserver.store_connection('u_rivera', {'access_token':'sample','athlete':{'id':'i98765','name':'T. Rivera'},'scope':config.SCOPES})\nassert 'expires_at' not in server.CONNECTIONS['u_rivera']\nassert 'refresh_token' not in server.CONNECTIONS['u_rivera']\nhttp = ThreadingHTTPServer(('127.0.0.1', 0), server.Handler)\nthread = Thread(target=http.serve_forever, daemon=True); thread.start()\nbase = 'http://127.0.0.1:%d' % http.server_port\nimport urllib.request, urllib.error\ntry:\n    req = urllib.request.Request(base + '/api/intervals/auth/init', headers={'Authorization':'Bearer tok-okafor','Accept':'application/json'})\n    with urllib.request.urlopen(req) as res: data=json.load(res)\n    parsed=urllib.parse.urlsplit(data['authorize_url'])\n    assert parsed.path == '/oauth/authorize'\n    assert urllib.parse.parse_qs(parsed.query)['scope'] == [config.SCOPES]\n    assert server.verify_state(urllib.parse.parse_qs(parsed.query)['state'][0]) == 'u_okafor'\n    req = urllib.request.Request(base + '/api/intervals/status', headers={'Authorization':'Bearer tok-rivera'})\n    with urllib.request.urlopen(req) as res: assert json.load(res)['connected']\n    try: urllib.request.urlopen(base + '/api/intervals/auth/init')\n    except urllib.error.HTTPError as e: assert e.code == 401\n    else: raise AssertionError('unauthenticated request succeeded')\nfinally:\n    http.shutdown(); http.server_close()\nprint('local OAuth flow checks passed')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
