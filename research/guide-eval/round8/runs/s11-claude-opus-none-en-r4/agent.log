(self):","+        table = FakeTable()","+        for i in range(6):","+            story = {\"slug\": f\"story-{i}\", \"title\": f\"Story {i}\",","+                     \"tags\": [\"a\", f\"t{i % 2}\"], \"body\": f\"shared words and {i}\"}","+            self.assertEqual(app.handler({\"body\": json.dumps(story)}, table)[\"statusCode\"], 201)","+        self.assertEqual(table.scan()[\"Count\"], 6)","+        self.assertEqual(len(table.get_item(Key={\"slug\": \"story-5\"})[\"Item\"][\"similar\"]), 3)","+","+    def test_to_dynamo_converts_nested_floats(self):","+        out = app.to_dynamo({\"a\": [{\"s\": 0.7}], \"b\": 1, \"c\": True})","+        self.assertEqual(out, {\"a\": [{\"s\": Decimal(\"0.7\")}], \"b\": 1, \"c\": True})","+        with self.assertRaises(ValueError):","+            app.to_dynamo({\"x\": float(\"nan\")})","+"," "," if __name__ == \"__main__\":","     unittest.main()"]}]}],"moreFiles":0,"changedFiles":["/private/tmp/h-2neSdE/src/app.py","/private/tmp/h-2neSdE/tests/test_publish.py"]}},"tool_result_meta":[{"id":"toolu_01SWHuBjSTWm4aB8M2uxNzZH","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
