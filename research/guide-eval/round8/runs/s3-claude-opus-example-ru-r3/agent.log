xit 0 is not proof of work: an empty report is a failure too.\nif [ ! -s \"$OUT\" ]; then\n  notify \"nightly review FAILED: claude exited 0 after ${ELAPSED}s but $OUT is empty\"\n  exit 1\nfi\n\nnotify \"nightly review done (${ELAPSED}s): $(head -c 300 \"$OUT\")\"\nlog \"done\"\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1054,"cache_read_input_tokens":24900,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1054},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"794bc304-d468-437e-99c6-21fcb6b80ecd","uuid":"be4f7859-4174-4b03-86c6-ab08a9fd6254","timestamp":"2026-10-27T04:03:35.414Z","request_id":"req_011CgS5UY2DfsjXkKemQNf6d","wire_tool_inputs":{"toolu_01CYRZwgAyfdHCL949idAKGo":{"file_path":"/private/tmp/h-RFklFe/bin/nightly-review.zsh","content":"#!/bin/zsh\n# Nightly review of yesterday's commits, summary to Telegram.\nset -u\n\nREPO=\"$HOME/projects/shop\"\nOUT=\"$HOME/Library/Logs/nightly-review-$(date +%F).md\"\nNOTIFY=\"$HOME/bin/notify.sh\"\n\nlog() { print -r -- \"$(date '+%F %T') nightly-review: $*\" >&2; }\n\n# Never stay silent: if the notifier itself fails, at least leave a trace in the log.\nnotify() {\n  \"$NOTIFY\" \"$1\" || log \"notify.sh FAILED (exit $?) for message: $1\"\n}\n\nlog \"start (USER=${USER:-<unset>} HOME=$HOME)\"\nSTART=$SECONDS\n\nSINCE=$(date -v-1d +%F)\nPROMPT=\"Review the commits in this repository since $SINCE.\nFor each commit: one line on what it changes and whether anything looks risky\n(migrations, auth, payments, deleted tests).\nEnd with a three-line summary I can read on my phone.\nDo not modify any file.\"\n\ncd \"$REPO\" || { log \"repo missing: $REPO\"; notify \"nightly review: repo missing ($REPO)\"; exit 1; }\n\nERR_TMP=$(mk