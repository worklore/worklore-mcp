+def assert_no_floats(value, path="item"):
+    """Fail early (and name the field) if a float would reach DynamoDB."""
+    if isinstance(value, float):
+        raise TypeError(f"float at {path}; use int or Decimal")
+    if isinstance(value, dict):
+        for k, v in value.items():
+            assert_no_floats(v, f"{path}.{k}")
+    elif isinstance(value, (list, tuple)):
+        for i, v in enumerate(value):
+            assert_no_floats(v, f"{path}[{i}]")
+
