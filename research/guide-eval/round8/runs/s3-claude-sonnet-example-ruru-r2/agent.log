type = daemon (3)\n\tproperties = {\n\t\tpartial import = 0\n\t\tlaunchd bundle = 0\n\t\ttrusted = 0\n\t\ton demand = 1\n\t}\n}\n=== bin/nightly-review.zsh\n#!/bin/zsh\n# Nightly review of yesterday's commits, summary to Telegram.\nset -u\n\nREPO=\"$HOME/projects/shop\"\nOUT=\"$HOME/Library/Logs/nightly-review-$(date +%F).md\"\nNOTIFY=\"$HOME/bin/notify.sh\"\n\nSINCE=$(date -v-1d +%F)\nPROMPT=\"Review the commits in this repository since $SINCE.\nFor each commit: one line on what it changes and whether anything looks risky\n(migrations, auth, payments, deleted tests).\nEnd with a three-line summary I can read on my phone.\nDo not modify any file.\"\n\ncd \"$REPO\" || { \"$NOTIFY\" \"nightly review: repo missing\"; exit 1; }\n\nclaude -p \"$PROMPT\" --output-format text > \"$OUT\"\nstatus=$?\n\nif [ $status -ne 0 ]; then\n  \"$NOTIFY\" \"nightly review FAILED (exit $status), see $OUT\"\n  exit $status\nfi\n\n\"$NOTIFY\" \"nightly review done: $(head -c 300 \"$OUT\")\"\n=== bin/notify.sh\n#!/bin/bash\n# usage: notify.sh \"message\"  — sends a Telegram message to me.\nset -eu\n: \"${TG_BOT_TOKEN:=$(security find-generic-password -s tg-bot -w)}\"\nCHAT_ID=123456789\ncurl -sS -X POST \"https://api.telegram.org/bot${TG_BOT_TOKEN}/sendMessage\" \\\n  -d chat_id=\"$CHAT_ID\" --data-urlencode text=\"$1\" > /dev/null\n=== Library/Logs/nightly-review.err\nNot logged in · Please run /login\n/Users/vk/bin/nightly-review.zsh:19: read-only variable: status\nNot logged in · Please run /login\n/Users/vk/bin/nightly-review.zsh:19: read-only variable: status\nNot logged in · Please run /login\n/Users/vk/bin/nightly-review.zsh:19: read-only variable: status\nNot logged in · Please run /login\n/Users/vk/bin/nightly-review.zsh:19: read-only variable: status\nNot logged in · Please run /login\n/Users/vk/bin/nightly-review.zsh:19: read-only variable: status\nNot logged in · Please run /login\n/Users/vk/bin/nightly-review.zsh:19: read-only variable: status\n=== Library/Logs/nightly-review.o