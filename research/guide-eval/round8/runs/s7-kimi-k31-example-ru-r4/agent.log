{"role":"assistant","content":"Проверяю полный поток на локальном имитаторе Intervals.icu: клик по Connect, callback и обмен кода, получение wellness, повторное подключение после 401 и защиту от смены чужого athlete ID. Это позволит проверить интеграцию без обращения к внешнему сервису.","tool_calls":[{"type":"function","id":"tool_XsFQwLceyDUC4tD9qStPvVs6","function":{"name":"Bash","arguments":"{\"command\":\"python3 - <<'PY'\\nimport json\\nimport subprocess\\nimport threading\\nimport urllib.error\\nimport urllib.parse\\nimport urllib.request\\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\\n\\nimport server\\n\\nprovider_state = {\\\"revoked\\\": False, \\\"athlete_id\\\": \\\"i98765\\\", \\\"token_posts\\\": []}\\n\\n\\nclass Provider(BaseHTTPRequestHandler):\\n    def log_message(self, fmt, *args):\\n        pass\\n\\n    def send_json(self, status, value):\\n        body = json.dumps(value).encode()\\n        self.send_response(status)\\n        self.send_header(\\\"Content-Type\\\", \\\"application/json\\\")\\n        self.send_header(\\\"Content-Length\\\", str(len(body)))\\n        self.end_headers()\\n        self.wfile.write(body)\\n\\n    def do_GET(self):\\n        url = urllib.parse.urlsplit(self.path)\\n        query = dict(urllib.parse.parse_qsl(url.query))\\n        if url.path == \\\"/oauth/authorize\\\":\\n            scopes = query[\\\"scope\\\"].split(\\\",\\\")\\n            areas = [scope.split(\\\":\\\")[0] for scope in scopes]\\n            if len(areas) != len(set(areas)):\\n                return self.send_json(400, {\\\"error\\\": \\\"Duplicate scope\\\"})\\n            callback = query[\\\"redirect_uri\\\"] + \\\"?\\\" + urllib.parse.urlencode({\\n                \\\"code\\\": \\\"local-code\\\", \\\"state\\\": query[\\\"state\\\"],\\n            })\\n            self.send_response(302)\\n            self.send_header(\\\"Location\\\", callback)\\n            self.end_headers()\\n            return\\n        if url.path == \\\"/api/v1/athlete/i98765/wellness\\\":\\n            if provider_state[\\\"revoked\\\"] or self.headers.get(\\\"Authorization\\\") != \\\"Bearer local-access-token\\\":\\n                return self.send_json(401, {\\\"error\\\": \\\"revoked\\\"})\\n            return self.send_json(200, {\\\"wellness\\\": \\\"ok\\\"})\\n        self.send_json(404, {\\\"error\\\": \\\"not found\\\"})\\n\\n    def do_POST(self):\\n        if urllib.parse.urlsplit(self.path).path != \\\"/api/oauth/token\\\":\\n            return self.send_json(404, {\\\"error\\\": \\\"not found\\\"})\\n        length = int(self.headers.get(\\\"Content-Length\\\", \\\"0\\\"))\\n        fields = {key: values[0] for key, values in urllib.parse.parse_qs(\\n            self.rfile.read(length).decode()).items()}\\n        provider_state[\\\"token_posts\\\"].append(fields)\\n        if set(fields) != {\\\"client_id\\\", \\\"client_secret\\\", \\\"code\\\"} or fields[\\\"code\\\"] != \\\"local-code\\\":\\n            return self.send_json(400, {\\\"error\\\": \\\"bad token fields\\\"})\\n        self.send_json(200, {\\n            \\\"token_type\\\": \\\"bearer\\\",\\n            \\\"access_token\\\": \\\"local-access-token\\\",\\n            \\\"scope\\\": \\\"ACTIVITY:WRITE,WELLNESS:READ,CALENDAR:WRITE\\\",\\n            \\\"athlete\\\": {\\\"id\\\": provider_state[\\\"athlete_id\\\"], \\\"name\\\": \\\"T. Rivera\\\"},\\n        })\\n\\n\\nclass NoRedirect(urllib.request.HTTPRedirectHandler):\\n    def redirect_request(self, req, fp, code, msg, headers, newurl):\\n        return None\\n\\n\\ndef request(opener, url, method=\\\"GET\\\", auth=True):\\n    headers = {\\\"Authorization\\\": \\\"Bearer tok-okafor\\\"} if auth else {}\\n    req = urllib.request.Request(url, data=b\\\"\\\" if method == \\\"POST\\\" else None,\\n                                 headers=headers, method=method)\\n    try:\\n        response = opener.open(req, timeout=5)\\n    except urllib.error.HTTPError as error:\\n        response = error\\n    body = response.read().decode()\\n    return response.status, response.headers, body\\n\\n\\nprovider = ThreadingHTTPServer((\\\"127.0.0.1\\\", 0), Provider)\\nprovider_base = f\\\"http://127.0.0.1:{provider.server_port}\\\"\\napp = ThreadingHTTPServer((\\\"127.0.0.1\\\", 0), server.Handler)\\napp_base = f\\\"http://127.0.0.1:{app.server_port}\\\"\\nserver.config.INTERVALS_BASE = provider_base\\nserver.config.REDIRECT_URI = app_base + \\\"/api/intervals/callback\\\"\\nserver.TOKEN_URL = provider_base + \\\"/api/oauth/token\\\"\\nserver.AUTHORIZE_URL = provider_base + \\\"/oauth/authorize\\\"\\nthreads = [threading.Thread(target=service.serve_forever, daemon=True)\\n           for service in (provider, app)]\\nfor thread in threads:\\n    thread.start()\\n\\ntry:\\n    frontend_script = r'''\\nconst assert = require(\\\"node:assert/strict\\\");\\nconst fs = require(\\\"node:fs\\\");\\nconst vm = require(\\\"node:vm\\\");\\nconst base = process.argv[1];\\nconst elements = {};\\nconst root = { className: \\\"muted\\\", innerHTML: \\\"\\\" };\\nglobal.localStorage = { getItem: () => \\\"tok-okafor\\\" };\\nglobal.document = { getElementById(id) {\\n  if (id === \\\"app\\\") return root;\\n  if (!root.innerHTML.includes(`id=\\\"${id}\\\"`)) return null;\\n  if (!elements[id]) elements[id] = { disabled: false, textContent: \\\"\\\" };\\n  return elements[id];\\n} };\\nlet assigned = null;\\nglobal.window = { location: { assign(url) { assigned = url; } } };\\nconst realFetch = global.fetch;\\nglobal.fetch = (path, options) => realFetch(base + path, options);\\n(async () => {\\n  vm.runInThisContext(fs.readFileSync(\\\"static/app.js\\\", \\\"utf8\\\"));\\n  for (let i = 0; i < 100 && !elements.connect?.onclick; i++) {\\n    await new Promise(resolve => setTimeout(resolve, 10));\\n  }\\n  assert.equal(typeof elements.connect?.onclick, \\\"function\\\");\\n  await elements.connect.onclick();\\n  assert.ok(assigned.startsWith(\\\"http://127.0.0.1:\\\"));\\n  assert.ok(assigned.includes(\\\"/oauth/authorize?\\\"));\\n  console.log(\\\"frontend Connect: authenticated POST and redirect OK\\\");\\n})().catch(error => { console.error(error); process.exitCode = 1; });\\n'''\\n    frontend = subprocess.run([\\\"node\\\", \\\"-e\\\", frontend_script, app_base],\\n                              text=True, capture_output=True, timeout=15)\\n    assert frontend.returncode == 0, frontend.stdout + frontend.stderr\\n    print(frontend.stdout.strip())\\n\\n    opener = urllib.request.build_opener(NoRedirect)\\n    status, _, _ = request(opener, app_base + \\\"/api/intervals/auth/init\\\", \\\"POST\\\", auth=False)\\n    assert status == 401\\n    status, _, _ = request(opener, app_base + \\\"/api/intervals/auth/init\\\")\\n    assert status == 404\\n\\n    def begin_oauth():\\n        status, _, body = request(opener, app_base + \\\"/api/intervals/auth/init\\\", \\\"POST\\\")\\n        assert status == 200, body\\n        authorize_url = json.loads(body)[\\\"authorize_url\\\"]\\n        query = dict(urllib.parse.parse_qsl(urllib.parse.urlsplit(authorize_url).query))\\n        areas = [scope.split(\\\":\\\")[0] for scope in query[\\\"scope\\\"].split(\\\",\\\")]\\n        assert len(areas) == len(set(areas))\\n        assert query[\\\"scope\\\"] == \\\"ACTIVITY:WRITE,WELLNESS:READ,CALENDAR:WRITE\\\"\\n        assert server.verify_state(query[\\\"state\\\"]) == \\\"u_okafor\\\"\\n        assert server.verify_state(query[\\\"state\\\"], max_age=-1) is None\\n        status, headers, _ = request(opener, authorize_url, auth=False)\\n        assert status == 302\\n        return headers[\\\"Location\\\"]\\n\\n    callback_url = begin_oauth()\\n    status, headers, _ = request(opener, callback_url, auth=False)\\n    assert status == 302 and headers[\\\"Location\\\"] == \\\"/?connected=1\\\"\\n    assert provider_state[\\\"token_posts\\\"][-1].keys() == {\\\"client_id\\\", \\\"client_secret\\\", \\\"code\\\"}\\n    connection = server.CONNECTIONS[\\\"u_okafor\\\"]\\n    assert connection[\\\"access_token\\\"] == \\\"local-access-token\\\"\\n    assert \\\"expires_at\\\" not in connection and \\\"refresh_token\\\" not in connection\\n\\n    status, _, body = request(opener, app_base + \\\"/api/intervals/status\\\")\\n    assert status == 200 and json.loads(body)[\\\"connected\\\"] is True\\n    status, _, body = request(opener, app_base + \\\"/api/intervals/wellness\\\")\\n    assert status == 200 and json.loads(body) == {\\\"wellness\\\": \\\"ok\\\"}\\n\\n    provider_state[\\\"revoked\\\"] = True\\n    status, _, _ = request(opener, app_base + \\\"/api/intervals/wellness\\\")\\n    assert status == 401\\n    status, _, body = request(opener, app_base + \\\"/api/intervals/status\\\")\\n    assert json.loads(body) == {\\\"connected\\\": False, \\\"status\\\": \\\"revoked, reconnect\\\"}\\n    assert server.CONNECTIONS[\\\"u_okafor\\\"][\\\"access_token\\\"] is None\\n\\n    provider_state[\\\"revoked\\\"] = False\\n    provider_state[\\\"athlete_id\\\"] = \\\"someone-else\\\"\\n    status, _, body = request(opener, begin_oauth(), auth=False)\\n    assert status == 409, body\\n    assert server.CONNECTIONS[\\\"u_okafor\\\"][\\\"athlete_id\\\"] == \\\"i98765\\\"\\n    assert server.CONNECTIONS[\\\"u_okafor\\\"][\\\"access_token\\\"] is None\\n\\n    provider_state[\\\"athlete_id\\\"] = \\\"i98765\\\"\\n    status, headers, _ = request(opener, begin_oauth(), auth=False)\\n    assert status == 302 and headers[\\\"Location\\\"] == \\\"/?connected=1\\\"\\n    status, _, body = request(opener, app_base + \\\"/api/intervals/status\\\")\\n    assert json.loads(body)[\\\"connected\\\"] is True\\n\\n    status, _, _ = request(opener, app_base + \\\"/api/intervals/callback?code=local-code&state=bad\\\", auth=False)\\n    assert status == 400\\n    print(\\\"OAuth callback, exact token fields, perpetual token storage, wellness, 401 recovery, and athlete guard OK\\\")\\nfinally:\\n    app.shutdown()\\n    provide