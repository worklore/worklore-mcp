([\\\"node\\\", \\\"-e\\\", frontend_script, app_base],\\n                              text=True, capture_output=True, timeout=15)\\n    assert frontend.returncode == 0, frontend.stdout + frontend.stderr\\n    print(frontend.stdout.strip())\\n\\n    opener = urllib.request.build_opener(NoRedirect)\\n    status, _, _ = request(opener, app_base + \\\"/api/intervals/auth/init\\\", \\\"POST\\\", auth=False)\\n    assert status == 401\\n    status, _, _ = request(opener, app_base + \\\"/api/intervals/auth/init\\\")\\n    assert status == 404\\n\\n    def begin_oauth():\\n        status, _, body = request(opener, app_base + \\\"/api/intervals/auth/init\\\", \\\"POST\\\")\\n        assert status == 200, body\\n        authorize_url = json.loads(body)[\\\"authorize_url\\\"]\\n        query = dict(urllib.parse.parse_qsl(urllib.parse.urlsplit(authorize_url).query))\\n        areas = [scope.split(\\\":\\\")[0] for scope in query[\\\"scope\\\"].split(\\\",\\\")]\\n        assert len(areas) == len(set(areas))\\n        assert query[\\\"scope\\\"] == \\\"ACTIVITY:WRITE,WELLNESS:READ,CALENDAR:WRITE\\\"\\n        assert server.verify_state(query[\\\"state\\\"]) == \\\"u_okafor\\\"\\n        assert server.verify_state(query[\\\"state\\\"], max_age=-1) is None\\n        status, headers, _ = request(opener, authorize_url, auth=False)\\n        assert status == 302\\n        return headers[\\\"Location\\\"]\\n\\n    callback_url = begin_oauth()\\n    status, headers, _ = request(opener, callback_url, auth=False)\\n    assert status == 302 and headers[\\\"Location\\\"] == \\\"/?connected=1\\\"\\n    assert provider_state[\\\"token_posts\\\"][-1].keys() == {\\\"client_id\\\", \\\"client_secret\\\", \\\"code\\\"}\\n    connection = server.CONNECTIONS[\\\"u_okafor\\\"]\\n    assert connection[\\\"access_token\\\"] == \\\"local-access-token\\\"\\n    assert \\\"expires_at\\\" not in connection and \\\"refresh_token\\\" not in connection\\n\\n    status, _, body = request(opener, app_base + \\\"/api/intervals/status\\\")\\n    assert status == 200 and json.loads(body)[\\\"connected\\\"] is True\\n    status, _, body = request(opener, app_base + \\\"/api/intervals/wellness\\\")\\n    assert status == 200 and json.loads(body) == {\\\"wellness\\\": \\\"ok\\\"}\\n\\n    provider_state[\\\"revoked\\\"] = True\\n    status, _, _ = request(opener, app_base + \\\"/api/intervals/wellness\\\")\\n    assert status == 401\\n    status, _, body = request(opener, app_base + \\\"/api/intervals/status\\\")\\n    assert json.loads(body) == {\\\"connected\\\": False, \\\"status\\\": \\\"revoked, reconnect\\\"}\\n    assert server.CONNECTIONS[\\\"u_okafor\\\"][\\\"access_token\\\"] is None\\n\\n    provider_state[\\\"revoked\\\"] = False\\n    provider_state[\\\"athlete_id\\\"] = \\\"someone-else\\\"\\n    status, _, body = request(opener, begin_oauth(), auth=False)\\n    assert status == 409, body\\n    assert server.CONNECTIONS[\\\"u_okafor\\\"][\\\"athlete_id\\\"] == \\\"i98765\\\"\\n    assert server.CONNECTIONS[\\\"u_okafor\\\"][\\\"access_token\\\"] is None\\n\\n    provider_state[\\\"athlete_id\\\"] = \\\"i98765\\\"\\n    status, headers, _ = request(opener, begin_oauth(), auth=False)\\n    assert status == 302 and headers[\\\"Location\\\"] == \\\"/?connected=1\\\"\\n    status, _, body = request(opener, app_base + \\\"/api/intervals/status\\\")\\n    assert json.loads(body)[\\\"connected\\\"] is True\\n\\n    status, _, _ = request(opener, app_base + \\\"/api/intervals/callback?code=local-code&state=bad\\\", auth=False)\\n    assert status == 400\\n    print(\\\"OAuth callback, exact token fields, perpetual token storage, wellness, 401 recovery, and athlete guard OK\\\")\\nfinally:\\n    app.shutdown()\\n    provider.shutdown()\\n    app.server_close()\\n    provider.server_close()\\n    for thread in threads:\\n        thread.join()\\nPY\",\"cwd\":\"/private/tmp/h-lqzFi1\",\"timeout\":60}"}}]}
