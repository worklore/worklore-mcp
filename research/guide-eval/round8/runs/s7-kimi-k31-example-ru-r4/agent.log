{"role":"tool","tool_call_id":"tool_G1fS5NlRcXrBmBrnCFHOVWcX","content":"120\t\n121\t    def current_user(self):\n122\t        auth = self.headers.get(\"Authorization\", \"\")\n123\t        if not auth.startswith(\"Bearer \"):\n124\t            return None\n125\t        return USERS.get(auth[7:].strip())\n126\t\n127\t    def require_user(self):\n128\t        user = self.current_user()\n129\t        if user is None:\n130\t            self.log_message(\"%s %s 401 (no Authorization header)\", self.command, self.path)\n131\t            self.send_json(401, {\"error\": \"unauthorized\"})\n132\t        return user\n133\t\n134\t    def do_GET(self):\n135\t        url = urllib.parse.urlsplit(self.path)\n136\t        q = dict(urllib.parse.parse_qsl(url.query))\n137\t        if url.path == \"/\":\n138\t            return self.send_file(\"index.html\", \"text/html; charset=utf-8\")\n139\t        if url.path.startswith(\"/static/\"):\n140\t            return self.send_file(os.path.basename(url.path), \"application/javascript\" if url.path.endswith(\".js\") else \"text/plain\")\n141\t        if url.path == \"/api/me\":\n142\t            user = self.require_user()\n143\t            return user and self.send_json(200, user)\n144\t        if url.path == \"/api/intervals/auth/init\":\n145\t            return self.auth_init()\n146\t        if url.path == \"/api/intervals/callback\":\n147\t            return self.callback(q)\n148\t        if url.path == \"/api/intervals/status\":\n149\t            return self.status()\n150\t        if url.path == \"/api/intervals/wellness\":\n151\t            return self.wellness()\n152\t        self.send_json(404, {\"error\": \"not found\"})\n153\t\n154\t    def do_POST(self):\n155\t        url = urllib.parse.urlsplit(self.path)\n156\t        if url.path == \"/api/intervals/disconnect\":\n157\t            user = self.require_user()\n158\t            if user:\n159\t                with LOCK:\n160\t                    CONNECTIONS.pop(user[\"id\"], None)\n161\t                self.send_json(200, {\"ok\": True})\n162\t            return\n163\t        self.send_json(404, {\"error\": \"not found\"})\n164\t\n165\t    # Step 1: build the authorize URL and send the browser to Intervals.\n166\t    def auth_init(self):\n167\t        user = self.require_user()\n168\t        if not user:\n169\t            return\n170\t        params = {\"client_id\": config.CLIENT_ID, \"redirect_uri\": config.REDIRECT_URI,\n171\t                  \"scope\": config.SCOPES, \"state\": sign_state(user[\"id\"])}\n172\t        self.redirect(AUTHORIZE_URL + \"?\" + urllib.parse.urlencode(params, safe=\":,\"))\n173\t\n174\t    # Step 2: Intervals redirects back here with ?code=&state=.\n175\t    def callback(self, q):\n176\t        user_id = verify_state(q.get(\"state\", \"\"))\n177\t        if not user_id or not q.get(\"code\"):\n178\t            return self.send_json(400, {\"error\": \"bad state or code\"})\n179\t        try:\n180\t            tok = exchange_code(q[\"code\"])\n181\t            store_connection(user_id, tok)\n182\t        except urllib.error.HTTPError as e:\n183\t            log(f\"{user_id}: token exchange failed: HTTP {e.code} {e.read()[:200]!r}\")\n184\t            return self.send_json(502, {\"error\": \"token exchange failed\"})\n185\t        except Exception as e:\n186\t            log(f\"{user_id}: token exchange failed: {e}\")\n187\t            return self.send_json(502, {\"error\": \"token exchange failed\"})\n188\t        self.redirect(\"/?connected=1\")\n189\t\n190\t    def status(self):\n191\t        user = self.require_user()\n192\t        if not user:\n193\t            return\n194\t        with LOCK:\n195\t            c = CONNECTIONS.get(user[\"id\"])\n196\t        if not c or c[\"status\"] != \"connected\":\n197\t            return self.send_json(200, {\"connected\": False, \"status\": c[\"status\"] if c else \"disconnected\"})\n198\t        self.send_json(200, {\"connected\": True, \"status\": \"connected\", \"scope\": c[\"scope\"],\n199\t                             \"athlete\": {\"id\": c[\"athlete_id\"], \"name\": c[\"athlete_name\"]}})\n200\t\n201\t    def wellness(self):\n202\t        user = self.require_user()\n203\t        if not user:\n204\t            return\n205\t        with LOCK:\n206\t            c = CONNECTIONS.get(user[\"id\"])\n207\t        if not c or c[\"status\"] != \"connected\":\n208\t            return self.send_json(409, {\"error\": \"intervals not connected\"})\n209\t        try:\n210\t            code, data = intervals_get(c, \"/wellness\")\n211\t            self.send_json(code, data)\n212\t        except urllib.error.HTTPError as e:\n213\t            self.send_json(e.code, {\"error\": f\"intervals returned {e.code}\"})\n214\t        except Exception as e:\n215\t            self.send_json(502, {\"error\": str(e)})\n216\t\n217\t\n218\tif __name__ == \"__main__\":\n219\t    threading.Thread(target=refresh_tokens, daemon=True).start()\n220\t    log(f\"serving on http://localhost:{config.PORT} (intervals: {config.INTERVALS_BASE})\")\n221\t    ThreadingHTTPServer((\"127.0.0.1\", config.PORT), Handler).serve_forever()"}
