+from decimal import Decimal
 
 log = logging.getLogger("stories")
 
@@ -15,6 +16,7 @@ TABLE_NAME = "stories"
 TOP_N = 3
 
 _WORD = re.compile(r"[a-z0-9]+")
+_SCORE_STEP = Decimal("0.0001")
 
 
 def words(text):
@@ -22,12 +24,15 @@ def words(text):
 
 
 def similarity(a, b):
-    """Shared-tag ratio (Jaccard), blended with shared words of the two bodies."""
+    """Shared-tag ratio (Jaccard), blended with shared words of the two bodies.
+
+    Returned as a Decimal with 4 places: DynamoDB (boto3) rejects Python floats.
+    """
     ta, tb = set(a.get("tags", [])), set(b.get("tags", []))
     tag_score = len(ta & tb) / len(ta | tb) if (ta | tb) else 0
     wa, wb = words(a.get("body")), words(b.get("body"))
     word_score = len(wa & wb) / len(wa | wb) if (wa | wb) else 0
-    return round(0.7 * tag_score + 0.3 * word_score, 4)
+    return Decimal(repr(0.7 * tag_score + 0.3 * word_score)).quantize(_SCORE_STEP)
 
 
 def related(story, existing):
@@ -48,6 +53,23 @@ def validate(story):
         raise ValueError("bad slug")
 
 
+def to_dynamo(value):
+    """Convert floats anywhere in ``value`` to Decimal, as DynamoDB requires.
+
+    Applied to every item right before put_item, so a float added to the item
+    later cannot turn a publish into a 500 again.
+    """
+    if isinstance(value, float):
+        if value != value or value in (float("inf"), float("-inf")):
+            raise ValueError("non-finite number cannot be stored")
+        return Decimal(repr(value))
+    if isinstance(value, dict):
+        return {k: to_dynamo(v) for k, v in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [to_dynamo(v) for v in value]
+    return value
+
+
 def publish(table, story):
     """Store ``story`` with its related stories. Returns the stored item."""
     validate(story)
