t. A save_fact only changes the small\\n    # second block, so the static instructions keep their cache entry instead\\n    # of being re-created at write price after every memory write.\\n    return [\\n        {\\\"type\\\": \\\"text\\\", \\\"text\\\": INSTRUCTIONS + \\\"\\\\n\\\\n\\\" + profile_context(a),\\n         \\\"cache_control\\\": {\\\"type\\\": \\\"ephemeral\\\"}},\\n        {\\\"type\\\": \\\"text\\\", \\\"text\\\": facts_context(a, today),\\n         \\\"cache_control\\\": {\\\"type\\\": \\\"ephemeral\\\"}},\\n    ]\"}"}}]}
