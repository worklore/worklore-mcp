{"role":"tool","tool_call_id":"tool_1pMdqqCjEpEmtltpOdl0aTL8","content":"58\t    return post_form(TOKEN_URL, {\n59\t        \"grant_type\": \"authorization_code\", \"client_id\": config.CLIENT_ID,\n60\t        \"client_secret\": config.CLIENT_SECRET, \"code\": code, \"redirect_uri\": config.REDIRECT_URI,\n61\t    })\n62\t\n63\t\n64\tdef store_connection(user_id, tok):\n65\t    expires_in = int(tok.get(\"expires_in\") or DEFAULT_TOKEN_TTL)\n66\t    refresh = tok.get(\"refresh_token\")\n67\t    if not refresh:\n68\t        log(f\"{user_id}: no refresh_token in response, scheduling expiry in {expires_in}s\")\n69\t    athlete = tok.get(\"athlete\") or {}\n70\t    with LOCK:\n71\t        CONNECTIONS[user_id] = {\n72\t            \"athlete_id\": athlete.get(\"id\"), \"athlete_name\": athlete.get(\"name\"),\n73\t            \"access_token\": tok[\"access_token\"], \"refresh_token\": refresh,\n74\t            \"scope\": tok.get(\"scope\"), \"expires_at\": time.time() + expires_in, \"status\": \"connected\",\n75\t        }\n76\t    log(f\"{user_id}: connected as athlete {athlete.get('id')} (expires in {expires_in}s)\")\n77\t\n78\t\n79\tdef refresh_tokens():\n80\t    \"\"\"Background pass: renew access tokens shortly before they expire.\"\"\"\n81\t    while True:\n82\t        time.sleep(config.REFRESH_INTERVAL)\n83\t        now = time.time()\n84\t        with LOCK:\n85\t            for uid, c in CONNECTIONS.items():\n86\t                if c[\"status\"] != \"connected\" or c[\"expires_at\"] - now > 300:\n87\t                    continue\n88\t                if not c[\"refresh_token\"]:\n89\t                    log(f\"{uid}: token expiry passed and no refresh token on file -> expired, reconnect\")\n90\t                    c.update(status=\"expired, reconnect\", access_token=None)\n91\t                    continue\n92\t                try:\n93\t                    tok = post_form(TOKEN_URL, {\n94\t                        \"grant_type\": \"refresh_token\", \"refresh_token\": c[\"refresh_token\"],\n95\t                        \"client_id\": config.CLIENT_ID, \"client_secret\": config.CLIENT_SECRET,\n96\t                    })\n97\t                    c.update(access_token=tok[\"access_token\"],\n98\t                             refresh_token=tok.get(\"refresh_token\", c[\"refresh_token\"]),\n99\t                             expires_at=now + int(tok[\"expires_in\"]))\n100\t                    log(f\"{uid}: token refreshed\")\n101\t                except Exception as e:\n102\t                    log(f\"{uid}: refresh failed ({e}) -> expired, reconnect\")\n103\t                    c.update(status=\"expired, reconnect\", access_token=None)\n104\t\n105\t\n106\tdef intervals_get(conn, path):\n107\t    req = urllib.request.Request(f\"{config.INTERVALS_BASE}/api/v1/athlete/{conn['athlete_id']}{path}\",\n108\t                                 headers={\"Authorization\": \"Bearer \" + conn[\"access_token\"]})\n109\t    with urllib.request.urlopen(req, timeout=15) as r:\n110\t        return r.status, json.loads(r.read().decode())\n111\t\n112\t\n113\t# --- HTTP ---------------------------------------------------------------------\n114\tclass Handler(BaseHTTPRequestHandler):\n115\t    def log_message(self, fmt, *args):\n116\t        print(time.strftime(\"%Y-%m-%d %H:%M:%S\"), \"[http]\", fmt % args, flush=True)\n117\t\n118\t    def send_json(self, code, obj):\n119\t        body = json.dumps(obj).encode()\n120\t        self.send_response(code)\n121\t        self.send_header(\"Content-Type\", \"application/json\")\n122\t        self.send_header(\"Content-Length\", str(len(body)))\n123\t        self.end_headers()\n124\t        self.wfile.write(body)\n125\t\n126\t    def send_file(self, name, ctype):\n127\t        p = os.path.join(STATIC, name)\n128\t        if not os.path.isfile(p):\n129\t            return self.send_json(404, {\"error\": \"not found\"})\n130\t        with open(p, \"rb\") as f:\n131\t            body = f.read()\n132\t        self.send_response(200)\n133\t        self.send_header(\"Content-Type\", ctype)\n134\t        self.send_header(\"Content-Length\", str(len(body)))\n135\t        self.end_headers()\n136\t        self.wfile.write(body)\n137\t\n138\t    def redirect(self, url):\n139\t        self.send_response(302)\n140\t        self.send_header(\"Location\", url)\n141\t        self.end_headers()\n142\t\n143\t    def current_user(self):\n144\t        auth = self.headers.get(\"Authorization\", \"\")\n145\t        if not auth.startswith(\"Bearer \"):\n146\t            return None\n147\t        return USERS.get(auth[7:].strip())\n148\t\n149\t    def require_user(self):\n150\t        user = self.current_user()\n151\t        if user is None:\n152\t            self.log_message(\"%s %s 401 (no Authorization header)\", self.command, self.path)\n153\t            self.send_json(401, {\"error\": \"unauthorized\"})\n154\t        return user\n155\t\n156\t    def do_GET(self):\n157\t        url = urllib.parse.urlsplit(self.path)\n158\t        q = dict(urllib.parse.parse_qsl(url.query))\n159\t        if url.path == \"/\":\n160\t            return self.send_file(\"index.html\", \"text/html; charset=utf-8\")\n161\t        if url.path.startswith(\"/static/\"):\n162\t            return self.send_file(os.path.basename(url.path), \"application/javascript\" if url.path.endswith(\".js\") else \"text/plain\")\n163\t        if url.path == \"/api/me\":\n164\t            user = self.require_user()\n165\t            return user and self.send_json(200, user)\n166\t        if url.path == \"/api/intervals/auth/init\":\n167\t            return self.auth_init()\n168\t        if url.path == \"/api/intervals/callback\":\n169\t            return self.callback(q)\n170\t        if url.path == \"/api/intervals/status\":\n171\t            return self.status()\n172\t        if url.path == \"/api/intervals/wellness\":\n173\t            return self.wellness()\n174\t        self.send_json(404, {\"error\": \"not found\"})\n175\t\n176\t    def do_POST(self):\n177\t        url = urllib.parse.urlsplit(self.path)\n178\t        if url.path == \"/api/intervals/disconnect\":\n179\t            user = self.require_user()\n180\t            if user:\n181\t                with LOCK:\n182\t                    CONNECTIONS.pop(user[\"id\"], None)\n183\t                self.send_json(200, {\"ok\": True})\n184\t            return\n185\t        self.send_json(404, {\"error\": \"not found\"})\n186\t\n187\t    # Step 1: build the authorize URL and send the browser to Intervals.\n188\t    def auth_init(self):\n189\t        user = self.require_user()\n190\t        if not user:\n191\t            return\n192\t        params = {\"client_id\": config.CLIENT_ID, \"redirect_uri\": config.REDIRECT_URI,\n193\t                  \"scope\": config.SCOPES, \"state\": sign_state(user[\"id\"])}\n194\t        self.redirect(AUTHORIZE_URL + \"?\" + urllib.parse.urlencode(params, safe=\":,\"))\n195\t\n196\t    # Step 2: Intervals redirects back here with ?code=&state=.\n197\t    def callback(self, q):\n198\t        user_id = verify_state(q.get(\"state\", \"\"))\n199\t        if not user_id or not q.get(\"code\"):\n200\t            return self.send_json(400, {\"error\": \"bad state or code\"})\n201\t        try:\n202\t            tok = exchange_code(q[\"code\"])"}
