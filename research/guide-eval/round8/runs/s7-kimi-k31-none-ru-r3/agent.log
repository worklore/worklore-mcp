{"role":"assistant","tool_calls":[{"type":"function","id":"tool_PmLLVzIQmrjfVo90NipHW59Y","function":{"name":"Bash","arguments":"{\"command\":\"python3 -m py_compile server.py config.py && if command -v node >/dev/null 2>&1; then node --check static/app.js; fi\",\"cwd\":\"/private/tmp/h-bj3Dlg\",\"timeout\":60}"}},{"type":"function","id":"tool_L5eOjiaOLLDi9UwHDZbXMMmt","function":{"name":"Bash","arguments":"{\"command\":\"python3 - <<'PY'\\nimport json\\nimport threading\\nimport time\\nimport urllib.error\\nimport urllib.parse\\nimport urllib.request\\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\\n\\nimport config\\nimport server\\n\\nprovider_requests = []\\n\\nclass Provider(BaseHTTPRequestHandler):\\n    def log_message(self, *args):\\n        pass\\n\\n    def send_json(self, status, body):\\n        payload = json.dumps(body).encode()\\n        self.send_response(status)\\n        self.send_header(\\\"Content-Type\\\", \\\"application/json\\\")\\n        self.send_header(\\\"Content-Length\\\", str(len(payload)))\\n        self.end_headers()\\n        self.wfile.write(payload)\\n\\n    def do_POST(self):\\n        assert self.path == \\\"/api/oauth/token\\\"\\n        size = int(self.headers[\\\"Content-Length\\\"])\\n        form = dict(urllib.parse.parse_qsl(self.rfile.read(size).decode()))\\n        provider_requests.append(form)\\n        assert form[\\\"grant_type\\\"] == \\\"authorization_code\\\"\\n        assert form[\\\"code\\\"] == \\\"local-code\\\"\\n        assert form[\\\"redirect_uri\\\"] == config.REDIRECT_URI\\n        self.send_json(200, {\\n            \\\"token_type\\\": \\\"bearer\\\",\\n            \\\"access_token\\\": \\\"local-access-token\\\",\\n            \\\"scope\\\": \\\"ACTIVITY:WRITE,WELLNESS:READ\\\",\\n            \\\"athlete\\\": {\\\"id\\\": \\\"i98765\\\", \\\"name\\\": \\\"T. Rivera\\\"},\\n        })\\n\\n    def do_GET(self):\\n        assert self.path == \\\"/api/v1/athlete/i98765/wellness\\\"\\n        assert self.headers[\\\"Authorization\\\"] == \\\"Bearer local-access-token\\\"\\n        self.send_json(200, {\\\"id\\\": \\\"i98765\\\", \\\"wellness\\\": \\\"ok\\\"})\\n\\nclass NoRedirect(urllib.request.HTTPRedirectHandler):\\n    def redirect_request(self, req, fp, code, msg, headers, newurl):\\n        return None\\n\\nprovider = ThreadingHTTPServer((\\\"127.0.0.1\\\", 0), Provider)\\napp = ThreadingHTTPServer((\\\"127.0.0.1\\\", 0), server.Handler)\\nbase = f\\\"http://127.0.0.1:{app.server_address[1]}\\\"\\nconfig.REDIRECT_URI = base + \\\"/api/intervals/callback\\\"\\nserver.TOKEN_URL = f\\\"http://127.0.0.1:{provider.server_address[1]}/api/oauth/token\\\"\\nserver.AUTHORIZE_URL = f\\\"http://127.0.0.1:{provider.server_address[1]}/oauth/authorize\\\"\\nthreads = [threading.Thread(target=s.serve_forever, daemon=True) for s in (provider, app)]\\nfor thread in threads:\\n    thread.start()\\n\\nopener = urllib.request.build_opener(NoRedirect)\\n\\ndef request(path, authenticated=True):\\n    req = urllib.request.Request(base + path)\\n    if authenticated:\\n        req.add_header(\\\"Authorization\\\", \\\"Bearer tok-rivera\\\")\\n    return opener.open(req, timeout=2)\\n\\ntry:\\n    try:\\n        request(\\\"/api/intervals/auth/init\\\", authenticated=False)\\n        raise AssertionError(\\\"unauthenticated auth init unexpectedly succeeded\\\")\\n    except urllib.error.HTTPError as e:\\n        assert e.code == 401\\n\\n    with request(\\\"/api/intervals/auth/init\\\") as response:\\n        assert response.status == 200\\n        auth = json.load(response)\\n    query = dict(urllib.parse.parse_qsl(urllib.parse.urlsplit(auth[\\\"url\\\"]).query))\\n    assert query[\\\"response_type\\\"] == \\\"code\\\"\\n    assert query[\\\"client_id\\\"] == config.CLIENT_ID\\n    assert query[\\\"redirect_uri\\\"] == config.REDIRECT_URI\\n    assert query[\\\"scope\\\"] == config.SCOPES\\n    assert server.verify_state(query[\\\"state\\\"]) == \\\"u_rivera\\\"\\n\\n    callback = \\\"/api/intervals/callback?\\\" + urllib.parse.urlencode({\\n        \\\"code\\\": \\\"local-code\\\", \\\"state\\\": query[\\\"state\\\"],\\n    })\\n    try:\\n        request(callback, authenticated=False)\\n        raise AssertionError(\\\"callback unexpectedly did not redirect\\\")\\n    except urllib.error.HTTPError as e:\\n        assert e.code == 302\\n        assert e.headers[\\\"Location\\\"] == \\\"/?connected=1\\\"\\n\\n    assert len(provider_requests) == 1\\n    with request(\\\"/api/intervals/status\\\") as response:\\n        status = json.load(response)\\n    assert status == {\\n        \\\"connected\\\": True,\\n        \\\"status\\\": \\\"connected\\\",\\n        \\\"scope\\\": \\\"ACTIVITY:WRITE,WELLNESS:READ\\\",\\n        \\\"athlete\\\": {\\\"id\\\": \\\"i98765\\\", \\\"name\\\": \\\"T. Rivera\\\"},\\n    }\\n    connection = server.CONNECTIONS[\\\"u_rivera\\\"]\\n    assert connection[\\\"expires_at\\\"] is None\\n    assert connection[\\\"refresh_token\\\"] is None\\n\\n    config.REFRESH_INTERVAL = 0.01\\n    threading.Thread(target=server.refresh_tokens, daemon=True).start()\\n    time.sleep(0.15)\\n    config.REFRESH_INTERVAL = 60\\n    assert server.CONNECTIONS[\\\"u_rivera\\\"][\\\"status\\\"] == \\\"connected\\\"\\n    assert server.CONNECTIONS[\\\"u_rivera\\\"][\\\"access_token\\\"] == \\\"local-access-token\\\"\\n\\n    with request(\\\"/api/intervals/wellness\\\") as response:\\n        assert response.status == 200\\n        assert json.load(response)[\\\"wellness\\\"] == \\\"ok\\\"\\n    print(\\\"local OAuth end-to-end: PASS\\\")\\nfinally:\\n    app.shutdown()\\n    provider.shutdown()\\n    app.server_close()\\n    provider.server_close()\\nPY\",\"cwd\":\"/private/tmp/h-bj3Dlg\",\"timeout\":60}"}}]}
