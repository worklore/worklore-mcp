-    return round(0.7 * tag_score + 0.3 * word_score, 4)
+    return Decimal(repr(round(0.7 * tag_score + 0.3 * word_score, 4)))
 
 
 def related(story, existing):
@@ -40,6 +45,27 @@ def related(story, existing):
     return scored[:TOP_N]
 
 
+def dynamo_safe(value):
+    """Return ``value`` with every float replaced by an equal Decimal.
+
+    boto3 refuses floats ("Float types are not supported"), so anything computed
+    (ratios, averages, rounded scores) must not reach put_item as a float. This
+    is applied to the whole item right before the write so a new computed field
+    cannot reintroduce the crash. NaN/inf have no DynamoDB representation.
+    """
+    if isinstance(value, bool):
+        return value
+    if isinstance(value, float):
+        if value != value or value in (float("inf"), float("-inf")):
+            raise TypeError(f"cannot store non-finite number {value!r}")
+        return Decimal(repr(value))
+    if isinstance(value, dict):
+        return {k: dynamo_safe(v) for k, v in value.items()}
+    if isinstance(value, list):
+        return [dynamo_safe(v) for v in value]
+    return value
+
+
 def validate(story):
