{"role":"tool","tool_call_id":"tool_blAkE4xyBTlSAxYQDqRWLLbl","content":"1\timport 'package:flutter/material.dart';\n2\t\n3\timport '../analytics.dart';\n4\t\n5\tclass RegistrationScreen extends StatefulWidget {\n6\t  const RegistrationScreen({super.key});\n7\t\n8\t  @override\n9\t  State<RegistrationScreen> createState() => _RegistrationScreenState();\n10\t}\n11\t\n12\tclass _RegistrationScreenState extends State<RegistrationScreen> {\n13\t  final _email = TextEditingController();\n14\t  final _phone = TextEditingController();\n15\t  double _amount = 50000;\n16\t  bool _terms = false;\n17\t  bool _emailStartedFired = false;\n18\t  bool _phoneStartedFired = false;\n19\t  bool _termsAcceptedFired = false;\n20\t\n21\t  @override\n22\t  void dispose() {\n23\t    _email.dispose();\n24\t    _phone.dispose();\n25\t    super.dispose();\n26\t  }\n27\t\n28\t  bool get _canContinue =>\n29\t      _terms && _email.text.contains('@') && _phone.text.length >= 10;\n30\t\n31\t  @override\n32\t  Widget build(BuildContext context) {\n33\t    return Scaffold(\n34\t      appBar: AppBar(title: const Text('Register')),\n35\t      body: Padding(\n36\t        padding: const EdgeInsets.all(16),\n37\t        child: Column(\n38\t          crossAxisAlignment: CrossAxisAlignment.stretch,\n39\t          children: [\n40\t            TextField(\n41\t              controller: _email,\n42\t              keyboardType: TextInputType.emailAddress,\n43\t              decoration: const InputDecoration(labelText: 'Email'),\n44\t              onChanged: (_) {\n45\t                if (!_emailStartedFired) {\n46\t                  _emailStartedFired = true;\n47\t                  Analytics.capture('registration_email_started');\n48\t                }\n49\t                setState(() {});\n50\t              },\n51\t            ),\n52\t            const SizedBox(height: 12),\n53\t            TextField(\n54\t              controller: _phone,\n55\t              keyboardType: TextInputType.phone,\n56\t              decoration: const InputDecoration(labelText: 'Phone'),\n57\t              onChanged: (_) {\n58\t                if (!_phoneStartedFired) {\n59\t                  _phoneStartedFired = true;\n60\t                  Analytics.capture('registration_phone_started');\n61\t                }\n62\t                setState(() {});\n63\t              },\n64\t            ),\n65\t            const SizedBox(height: 24),\n66\t            Text('Loan amount: ${_amount.round()}'),\n67\t            Slider(\n68\t              min: 10000,\n69\t              max: 500000,\n70\t              divisions: 49,\n71\t              value: _amount,\n72\t              label: _amount.round().toString(),\n73\t              onChanged: (v) => setState(() => _amount = v),\n74\t              onChangeEnd: (v) =>\n75\t                  Analytics.capture('loan_amount_changed', {'amount': v.round()}),\n76\t            ),\n77\t            CheckboxListTile(\n78\t              value: _terms,\n79\t              title: const Text('I accept the terms and conditions'),\n80\t              controlAffinity: ListTileControlAffinity.leading,\n81\t              onChanged: (v) {\n82\t                final accepted = v ?? false;\n83\t                if (accepted && !_termsAcceptedFired) {\n84\t                  _termsAcceptedFired = true;\n85\t                  Analytics.capture('terms_accepted');\n86\t                }\n87\t                setState(() => _terms = accepted);\n88\t              },\n89\t            ),\n90\t            const Spacer(),\n91\t            FilledButton(\n92\t              onPressed: _canContinue\n93\t                  ? () {\n94\t                      Analytics.capture('registration_continue_tapped', {\n95\t                        'amount': _amount.round(),\n96\t                        'terms': _terms,\n97\t                      });\n98\t                      Navigator.of(context).pushNamed('/offers');\n99\t                    }\n100\t                  : null,\n101\t              child: const Te