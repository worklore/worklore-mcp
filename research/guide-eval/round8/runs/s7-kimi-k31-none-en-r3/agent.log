{"role":"tool","tool_call_id":"tool_8TuATfsqVv5tY3YQDwg2w9St","content":"diff --git a/config.py b/config.py\nindex 54a8144..655b8d9 100644\n--- a/config.py\n+++ b/config.py\n@@ -8,6 +8,6 @@ INTERVALS_BASE = os.environ.get(\"INTERVALS_BASE\", \"https://intervals.icu\")\n CLIENT_ID = \"tricoach-dev\"\n CLIENT_SECRET = \"s3cr3t-placeholder-0000\"\n REDIRECT_URI = f\"http://localhost:{PORT}/api/intervals/callback\"\n-SCOPES = \"ACTIVITY:READ,ACTIVITY:WRITE,WELLNESS:READ,CALENDAR:READ,CALENDAR:WRITE\"\n+SCOPES = \"ACTIVITY:READ ACTIVITY:WRITE WELLNESS:READ CALENDAR:READ CALENDAR:WRITE\"\n \n REFRESH_INTERVAL = 60      # seconds between passes of the token refresher\ndiff --git a/server.py b/server.py\nindex 351cbb7..4fc36a6 100644\n--- a/server.py\n+++ b/server.py\n@@ -12,8 +12,6 @@ import config\n STATIC = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"static\")\n TOKEN_URL = config.INTERVALS_BASE + \"/api/oauth/token\"\n AUTHORIZE_URL = config.INTERVALS_BASE + \"/oauth/authorize\"\n-DEFAULT_TOKEN_TTL = 3600   # seconds; used when the provider does not say how long a token lives\n-\n # --- in-memory store -------------------------------------------------------\n USERS = {\n     \"tok-okafor\": {\"id\": \"u_okafor\", \"name\": \"C. Okafor\"},\n@@ -63,18 +61,17 @@ def exchange_code(code):\n \n \n def store_connection(user_id, tok):\n-    expires_in = int(tok.get(\"expires_in\") or DEFAULT_TOKEN_TTL)\n+    expires_in = tok.get(\"expires_in\")\n+    expires_at = time.time() + int(expires_in) if expires_in is not None else None\n     refresh = tok.get(\"refresh_token\")\n-    if not refresh:\n-        log(f\"{user_id}: no refresh_token in response, scheduling expiry in {expires_in}s\")\n     athlete = tok.get(\"athlete\") or {}\n     with LOCK:\n         CONNECTIONS[user_id] = {\n             \"athlete_id\": athlete.get(\"id\"), \"athlete_name\": athlete.get(\"name\"),\n             \"access_token\": tok[\"access_token\"], \"refresh_token\": refresh,\n-            \"scope\": tok.get(\"scope\"), \"expires_at\": time.time() + expires_in, \"status\": \"connected\",\n+            \"scope\": tok.get(\"scope\"), \"expires_at\": expires_at, \"status\": \"connected\",\n         }\n-    log(f\"{user_id}: connected as athlete {athlete.get('id')} (expires in {expires_in}s)\")\n+    log(f\"{user_id}: connected as athlete {athlete.get('id')}\")\n \n \n def refresh_tokens():\n@@ -84,7 +81,8 @@ def refresh_tokens():\n         now = time.time()\n         with LOCK:\n             for uid, c in CONNECTIONS.items():\n-                if c[\"status\"] != \"connected\" or c[\"expires_at\"] - now > 300:\n+                if (c[\"status\"] != \"connected\" or c[\"expires_at\"] is None\n+                        or c[\"expires_at\"] - now > 300):\n                     continue\n                 if not c[\"refresh_token\"]:\n                     log(f\"{uid}: token expiry passed and no refresh token on file -> expired, reconnect\")\n@@ -185,14 +183,15 @@ class Handler(BaseHTTPRequestHandler):\n             return\n         self.send_json(404, {\"error\": \"not found\"})\n \n-    # Step 1: build the authorize URL and send the browser to Intervals.\n+    # Step 1: return the authorize URL for the authenticated SPA to open.\n     def auth_init(self):\n         user = self.require_user()\n         if not user:\n             return\n         params = {\"client_id\": config.CLIENT_ID, \"redirect_uri\": config.REDIRECT_URI,\n                   \"scope\": config.SCOPES, \"state\": sign_state(user[\"id\"])}\n-        self.redirect(AUTHORIZE_URL + \"?\" + urllib.parse.urlencode(params, safe=\":,\"))\n+        authorize_url = AUTHORIZE_URL + \"?\" + urllib.parse.urlencode(params)\n+        self.send_json(200, {\"authorize_url\": authorize_url})\n \n     # Step 2: Intervals redirects back here with ?code=&state=.\n     def callback(self, q):\ndiff --git a/static/app.js b/static/app.js\nindex 368922e..14fe92e 100644\n--- a/static/app.js\n+++ b/static/app.js\n@@ -25,10 +25,20 @@ async function render() {\n     } else {\n       const why = st.status && st.status !== \"disconnected\" ? `<p class=\"muted\">Status: ${esc(st.status)}</p>` : \"\";\n       card = `<div class=\"card\">Intervals.icu is not connected.${why}\n-        <p><a class=\"btn\" href=\"/api/intervals/auth/init\">Connect Intervals.icu</a></p></div>`;\n+        <p><button class=\"btn\" id=\"connect\">Connect Intervals.icu</button></p></div>`;\n     }\n     root.className = \"\";\n     root.innerHTML = `<p>Signed in as <b>${esc(me.name)}</b>.</p>${card}`;\n+    const connect = document.getElementById(\"connect\");\n+    if (connect) connect.onclick = async () => {\n+      connect.disabled = true;\n+      try {\n+        const auth = await api(\"/api/intervals/auth/init\");\n+        window.location.assign(auth.authorize_url);\n+      } catch (e) {\n+        root.innerHTML = `<p class=\"card\">Error: ${esc(e.message)}</p>`;\n+      }\n+    };\n     const d = document.getElementById(\"disconnect\");\n     if (d) d.onclick = async () => { await api(\"/api/intervals/disconnect\", { method: \"POST\" }); render(); };\n   } catch (e) {\n"}
{"role":"assistant","content":"I’m also exercising the actual JavaScript button handler with a mocked browser DOM, so the check covers the original click path rather than only the backend endpoints. All provider calls are redirected to the local mock.","tool_calls":[{"type":"function","id":"tool_yKIQBJrJbZg9CJNPgLZaEKgC","function":{"name":"Bash","arguments":"{\"command\":\"python3 - <<'PY'\\nimport json\\nimport os\\nimport subprocess\\nimport threading\\nimport time\\nimport urllib.error\\nimport urllib.parse\\nimport urllib.request\\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\\n\\nprovider = ThreadingHTTPServer((\\\"127.0.0.1\\\", 0), BaseHTTPRequestHandler)\\nprovider_port = provider.server_address[1]\\nos.environ[\\\"INTERVALS_BASE\\\"] = f\\\"http://127.0.0.1:{provider_port}\\\"\\n\\nimport config\\nimport server\\n\\nexpected_scopes = [\\n    \\\"ACTIVITY:READ\\\", \\\"ACTIVITY:WRITE\\\", \\\"WELLNESS:READ\\\",\\n    \\\"CALENDAR:READ\\\", \\\"CALENDAR:WRITE\\\",\\n]\\ntoken_requests = []\\n\\nclass ProviderHandler(BaseHTTPRequestHandler):\\n    def log_message(self, *args):\\n        pass\\n\\n    def json_response(self, code, body):\\n        data = json.dumps(body).encode()\\n        self.send_response(code)\\n        self.send_header(\\\"Content-Type\\\", \\\"application/json\\\")\\n        self.send_header(\\\"Content-Length\\\", str(len(data)))\\n        self.end_headers()\\n        self.wfile.write(data)\\n\\n    def do_GET(self):\\n        url = urllib.parse.urlsplit(self.path)\\n        if url.path == \\\"/oauth/authorize\\\":\\n            q = dict(urllib.parse.parse_qsl(url.query))\\n            if q.get(\\\"scope\\\", \\\"\\\").split() != expected_scopes or \\\",\\\" in q.get(\\\"scope\\\", \\\"\\\"):\\n                return self.json_response(400, {\\\"error\\\": \\\"invalid_request\\\"})\\n            callback = q[\\\"redirect_uri\\\"] + \\\"?\\\" + urllib.parse.urlencode({\\n                \\\"code\\\": \\\"local-code\\\", \\\"state\\\": q[\\\"state\\\"],\\n            })\\n            self.send_response(302)\\n            self.send_header(\\\"Location\\\", callback)\\n            self.end_headers()\\n            return\\n        if url.path == \\\"/api/v1/athlete/i98765/wellness\\\":\\n            if self.headers.get(\\\"Authorization\\\") != \\\"Bearer local-access-token\\\":\\n                return self.json_response(401, {\\\"error\\\": \\\"bad token\\\"})\\n            return self.json_response(200, {\\\"wellness\\\": \\\"ok\\\"})\\n        self.json_response(404, {\\\"error\\\": \\\"not found\\\"})\\n\\n    def do_POST(self):\\n        if self.path != \\\"/api/oauth/token\\\":\\n            return self.json_response(404, {\\\"error\\\": \\\"not found\\\"})\\n        fields = dict(urllib.parse.parse_qsl(self.rfile.read(int(self.headers[\\\"Content-Length\\\"])).decode()))\\n        token_requests.append(fields)\\n        if fields.get(\\\"grant_type\\\") != \\\"authorization_code\\\" or fields.get(\\\"code\\\") != \\\"local-code\\\":\\n            return self.json_response(400, {\\\"error\\\": \\\"bad grant\\\"})\\n        self.json_response(200, {\\n            \\\"token_type\\\": \\\"bearer\\\",\\n            \\\"access_token\\\": \\\"local-access-token\\\",\\n            \\\"scope\\\": config.SCOPES,\\n            \\\"athlete\\\": {\\\"id\\\": \\\"i98765\\\", \\\"name\\\": \\\"Local Athlete\\\"},\\n        })\\n\\nprovider.RequestHandlerClass = ProviderHandler\\nthreading.Thread(target=provider.serve_forever, daemon=True).start()\\n\\napp = ThreadingHTTPServer((\\\"127.0.0.1\\\", 0), server.Handler)\\napp_port = app.server_address[1]\\napp_base = f\\\"http://127.0.0.1:{app_port}\\\"\\nconfig.REDIRECT_URI = app_base + \\\"/api/intervals/callback\\\"\\nthreading.Thread(target=app.serve_forever, daemon=True).start()\\nconfig.REFRESH_INTERVAL = 0.01\\nthreading.Thread(target=server.refresh_tokens, daemon=True).start()\\n\\nbrowser_script = r'''\\nconst fs = require(\\\"fs\\\");\\nconst realFetch = global.fetch;\\nconst appUrl = process.env.APP_URL;\\nconst authHeaders = [];\\nconst elements = {};\\nconst root = { className: \\\"muted\\\" };\\nObject.defineProperty(root, \\\"innerHTML\\\", {\\n  get() { return this.html; },\\n  set(value) {\\n    this.html = value;\\n    if (value.includes('id=\\\"connect\\\"')) elements.connect = { disabled: false };\\n  }\\n});\\nglobal.localStorage = { getItem: () => \\\"tok-okafor\\\" };\\nglobal.document = {\\n  getElementById(id) {\\n    if (id === \\\"app\\\") return root;\\n    return elements[id] || null;\\n  }\\n};\\nlet redirected = null;\\nglobal.window = { location: { assign(url) { redirected = url; } } };\\nglobal.fetch = (path, opts) => {\\n  authHeaders.push(opts.headers.Authorization);\\n  return realFetch(new URL(path, appUrl), opts);\\n};\\neval(fs.readFileSync(\\\"static/app.js\\\", \\\"utf8\\\"));\\n(async () => {\\n  for (let i = 0; i < 100 && !elements.connect; i++) await new Promise(r => setTimeout(r, 10));\\n  if (!elements.connect) throw new Error(\\\"Connect button did not render: \\\" + root.innerHTML);\\n  await elements.connect.onclick();\\n  if (!redirected) throw new Error(\\\"Connect did not navigate to authorize URL\\\");\\n  if (authHeaders.length !== 3 || authHeaders.some(h => h !== \\\"Bearer tok-okafor\\\")) {\\n    throw new Error(\\\"An SPA API call omitted authentication: \\\" + JSON.stringify(authHeaders));\\n  }\\n  console.log(redirected);\\n})().catch(e => { console.error(e); process.exit(1); });\\n'''\\ntry:\\n    result = subprocess.run(\\n        [\\\"node\\\", \\\"-e\\\", browser_script],\\n        env=dict(os.environ, APP_URL=app_base),\\n        text=True, capture_output=True, timeout=10, check=True,\\n    )\\n    authorize_url = result.stdout.strip()\\n    query = dict(urllib.parse.parse_qsl(urllib.parse.urlsplit(authorize_url).query))\\n    assert query[\\\"scope\\\"].split() == expected_scopes\\n    assert query[\\\"redirect_uri\\\"] == config.REDIRECT_URI\\n\\n    class NoRedirect(urllib.request.HTTPRedirectHandler):\\n        def redirect_request(self, *args):\\n            return None\\n\\n    no_redirect = urllib.request.build_opener(NoRedirect)\\n    def redirect_location(url):\\n        try:\\n            no_redirect.open(url)\\n        except urllib.error.HTTPError as e:\\n            assert e.code == 302, e.code\\n            return e.headers[\\\"Location\\\"]\\n        raise AssertionError(\\\"Expected redirect\\\")\\n\\n    callback_url = redirect_location(authorize_url)\\n    assert redirect_location(callback_url) == \\\"/?connected=1\\\"\\n    assert len(token_requests) == 1\\n\\n    request = urllib.request.Request(\\n        app_base + \\\"/api/intervals/status\\\",\\n        headers={\\\"Authorization\\\": \\\"Bearer tok-okafor\\\"},\\n    )\\n    with urllib.request.urlopen(request) as response:\\n        status = json.load(response)\\n    assert status[\\\"connected\\\"] is True\\n    assert status[\\\"athlete\\\"][\\\"id\\\"] == \\\"i98765\\\"\\n\\n    connection = server.CONNECTIONS[\\\"u_okafor\\\"]\\n    assert connection[\\\"expires_at\\\"] is None\\n    assert connection[\\\"refresh_token\\\"] is None\\n    time.sleep(0.05)\\n    assert server.CONNECTIONS[\\\"u_okafor\\\"][\\\"status\\\"] == \\\"connected\\\"\\n    assert server.CONNECTIONS[\\\"u_okafor\\\"][\\\"access_token\\\"] == \\\"local-access-token\\\"\\n    assert len(token_requests) == 1\\n\\n    request = urllib.request.Request(\\n        app_base + \\\"/api/intervals/wellness\\\",\\n        headers={\\\"Authorization\\\": \\\"Bearer tok-okafor\\\"},\\n    )\\n    with urllib.request.urlopen(request) as response:\\n        assert json.load(response) == {\\\"wellness\\\": \\\"ok\\\"}\\n\\n    try:\\n        urllib.request.urlopen(app_base + \\\"/api/intervals/auth/init\\\")\\n    except urllib.error.HTTPError as e:\\n        assert e.code == 401\\n    else:\\n        raise AssertionError(\\\"Unauthenticated initiation should remain forbidden\\\")\\n\\n    print(\\\"End-to-end OAuth and non-expiring token checks passed (loopback only)\\\")\\nfinally:\\n    app.shutdown()\\n    provider.shutdown()\\n    app.server_close()\\n    provider.server_close()\\nPY\",\"cwd\":\"/private/tmp/h-YNpeZ5\",\"timeout\":30}"}}]}
