{"role":"tool","tool_call_id":"tool_rksWIlBiiXdRiqVYLWWgZkqv","content":"58\t        \"grant_type\": \"authorization_code\", \"client_id\": config.CLIENT_ID,\n59\t        \"client_secret\": config.CLIENT_SECRET, \"code\": code, \"redirect_uri\": config.REDIRECT_URI,\n60\t    })\n61\t\n62\t\n63\tdef store_connection(user_id, tok):\n64\t    expires_in = int(tok.get(\"expires_in\") or DEFAULT_TOKEN_TTL)\n65\t    refresh = tok.get(\"refresh_token\")\n66\t    if not refresh:\n67\t        log(f\"{user_id}: no refresh_token in response, scheduling expiry in {expires_in}s\")\n68\t    athlete = tok.get(\"athlete\") or {}\n69\t    with LOCK:\n70\t        CONNECTIONS[user_id] = {\n71\t            \"athlete_id\": athlete.get(\"id\"), \"athlete_name\": athlete.get(\"name\"),\n72\t            \"access_token\": tok[\"access_token\"], \"refresh_token\": refresh,\n73\t            \"scope\": tok.get(\"scope\"), \"expires_at\": time.time() + expires_in, \"status\": \"connected\",\n74\t        }\n75\t    log(f\"{user_id}: connected as athlete {athlete.get('id')} (expires in {expires_in}s)\")\n76\t\n77\t\n78\tdef refresh_tokens():\n79\t    \"\"\"Background pass: renew access tokens shortly before they expire.\"\"\"\n80\t    while True:\n81\t        time.sleep(config.REFRESH_INTERVAL)\n82\t        now = time.time()\n83\t        with LOCK:\n84\t            for uid, c in CONNECTIONS.items():\n85\t                if c[\"status\"] != \"connected\" or c[\"expires_at\"] - now > 300:\n86\t                    continue\n87\t                if not c[\"refresh_token\"]:\n88\t                    log(f\"{uid}: token expiry passed and no refresh token on file -> expired, reconnect\")\n89\t                    c.update(status=\"expired, reconnect\", access_token=None)\n90\t                    continue\n91\t                try:\n92\t                    tok = post_form(TOKEN_URL, {\n93\t                        \"grant_type\": \"refresh_token\", \"refresh_token\": c[\"refresh_token\"],\n94\t                        \"client_id\": config.CLIENT_ID, \"client_secret\": config.CLIENT_SECRET,\n95\t                    })\n96\t                    c.update(access_token=tok[\"access_token\"],\n97\t                             refresh_token=tok.get(\"refresh_token\", c[\"refresh_token\"]),\n98\t                             expires_at=now + int(tok[\"expires_in\"]))\n99\t                    log(f\"{uid}: token refreshed\")\n100\t                except Exception as e:\n101\t                    log(f\"{uid}: refresh failed ({e}) -> expired, reconnect\")\n102\t                    c.update(status=\"expired, reconnect\", access_token=None)\n103\t\n104\t\n105\tdef intervals_get(conn, path):\n106\t    req = urllib.request.Request(f\"{config.INTERVALS_BASE}/api/v1/athlete/{conn['athlete_id']}{path}\",\n107\t                                 headers={\"Authorization\": \"Bearer \" + conn[\"access_token\"]})\n108\t    with urllib.request.urlopen(req, timeout=15) as r:\n109\t        return r.status, json.loads(r.read().decode())\n110\t\n111\t\n112\t# --- HTTP ---------------------------------------------------------------------\n113\tclass Handler(BaseHTTPRequestHandler):\n114\t    def log_message(self, fmt, *args):\n115\t        print(time.strftime(\"%Y-%m-%d %H:%M:%S\"), \"[http]\", fmt % args, flush=True)\n116\t\n117\t    def send_json(self, code, obj):\n118\t        body = json.dumps(obj).encode()\n119\t        self.send_response(code)\n120\t        self.send_header(\"Content-Type\", \"application/json\")\n121\t        self.send_header(\"Content-Length\", str(len(body)))\n122\t        self.end_headers()\n123\t        self.wfile.write(body)\n124\t\n125\t    def send_file(self, name, ctype):\n126\t        p = os.path.join(STATIC, name)\n127\t        if not os.path.isfile(p):\n128\t            return self.send_json(404, {\"error\": \"not found\"})\n129\t        with open(p, \"rb\") as f:\n130\t            body = f.read()\n131\t        self.send_response(200)\n132\t        self.send_header(\"Content-Type\", ctype)\n133\t        self.send_header(\"Content-Length\", str(len(body)))\n134\t        self.end_headers()\n135\t        self.wfile.write(body)\n136\t\n137\t    def redirect(self, url):\n138\t        self.send_response(302)\n139\t        self.send_header(\"Location\", url)\n140\t        self.end_headers()\n141\t\n142\t    def current_user(self):\n143\t        auth = self.headers.get(\"Authorization\", \"\")\n144\t        if not auth.startswith(\"Bearer \"):\n145\t            return None\n146\t        return USERS.get(auth[7:].strip())\n147\t\n148\t    def require_user(self):\n149\t        user = self.current_user()\n150\t        if user is None:\n151\t            self.log_message(\"%s %s 401 (no Authorization header)\", self.command, self.path)\n152\t            self.send_json(401, {\"error\": \"unauthorized\"})\n153\t        return user\n154\t\n155\t    def do_GET(self):\n156\t        url = urllib.parse.urlsplit(self.path)\n157\t        q = dict(urllib.parse.parse_qsl(url.query))\n158\t        if url.path == \"/\":\n159\t            return self.send_file(\"index.html\", \"text/html; charset=utf-8\")\n160\t        if url.path.startswith(\"/static/\"):\n161\t            return self.send_file(os.path.basename(url.path), \"application/javascript\" if url.path.endswith(\".js\") else \"text/plain\")\n162\t        if url.path == \"/api/me\":\n163\t            user = self.require_user()\n164\t            return user and self.send_json(200, user)\n165\t        if url.path == \"/api/intervals/auth/init\":\n166\t            return self.auth_init()\n167\t        if url.path == \"/api/intervals/callback\":\n168\t            return self.callback(q)\n169\t        if url.path == \"/api/intervals/status\":\n170\t            return self.status()\n171\t        if url.path == \"/api/intervals/wellness\":\n172\t            return self.wellness()\n173\t        self.send_json(404, {\"error\": \"not found\"})\n174\t\n175\t    def do_POST(self):\n176\t        url = urllib.parse.urlsplit(self.path)\n177\t        if url.path == \"/api/intervals/disconnect\":\n178\t            user = self.require_user()\n179\t            if user:\n180\t                with LOCK:\n181\t                    CONNECTIONS.pop(user[\"id\"], None)\n182\t                self.send_json(200, {\"ok\": True})\n183\t            return\n184\t        self.send_json(404, {\"error\": \"not found\"})\n185\t\n186\t    # Step 1: build the authorize URL and send the browser to Intervals.\n187\t    def auth_init(self):\n188\t        user = self.require_user()\n189\t        if not user:\n190\t            return\n191\t        params = {\"client_id\": config.CLIENT_ID, \"redirect_uri\": config.REDIRECT_URI,\n192\t                  \"scope\": config.SCOPES, \"state\": sign_state(user[\"id\"])}\n193\t        self.redirect(AUTHORIZE_URL + \"?\" + urllib.parse.urlencode(params, safe=\":,\"))\n194\t\n195\t    # Step 2: Intervals redirects back here with ?code=&state=.\n196\t    def callback(self, q):\n197\t        user_id = verify_state(q.get(\"state\", \"\"))\n198\t        if not user_id or not q.get(\"code\"):\n199\t            return self.send_json(400, {\"error\": \"bad state or code\"})\n200\t        try:\n201\t            tok = exchange_code(q[\"code\"])\n202\t            store_connection(user_id, tok)"}
