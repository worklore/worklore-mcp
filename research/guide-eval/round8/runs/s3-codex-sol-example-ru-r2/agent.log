{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport os, pathlib, shutil, subprocess, tempfile\nroot = pathlib.Path.cwd()\ntmp = pathlib.Path(tempfile.mkdtemp(prefix='.nightly-test-', dir=root))\ntry:\n    (tmp/'bin').mkdir()\n    (tmp/'projects/shop').mkdir(parents=True)\n    (tmp/'Library/Logs').mkdir(parents=True)\n    shutil.copy2(root/'bin/nightly-review.zsh', tmp/'bin/nightly-review.zsh')\n    (tmp/'bin/claude').write_text('#\"'!/bin/sh'\"\\\\ncat > \\\"\"'$HOME/stdin.txt\"'\"\\\\ncase \\\"\"'$MODE\" in'\"\\\\n  success) printf \\\"Review complete\\\\\\\\n\\\";;\\\\n  empty) :;;\\\\n  fail) echo \\\"Not logged in\\\" >&2; exit 7;;\\\\nesac\\\\n')\n    (tmp/'bin/notify.sh').write_text('#\"'!/bin/sh'\"\\\\nprintf \\\"%s\\\\\\\\n\\\" \\\"\"'$1\" >> \"$HOME/messages.txt\"'\"\\\\n[ \\\"\"'${NOTIFY_FAIL:-0}\" != 1 ]'\"\\\\n')\n    for f in ('claude', 'notify.sh'):\n        (tmp/'bin'/f).chmod(0o755)\n    for mode, notify_fail, expected_rc, expected_message in [\n        ('success', '0', 0, 'nightly review done:'),\n        ('fail', '0', 7, 'nightly review FAILED:'),\n        ('empty', '0', 1, 'nightly review FAILED:'),\n        ('success', '1', 1, 'nightly review done:'),\n    ]:\n        (tmp/'messages.txt').unlink(missing_ok=True)\n        env = dict(os.environ, HOME=str(tmp), PATH=str(tmp/'bin') + ':' + os.environ['PATH'], MODE=mode, NOTIFY_FAIL=notify_fail)\n        result = subprocess.run(['/bin/zsh', str(tmp/'bin/nightly-review.zsh')], env=env, capture_output=True, text=True)\n        messages = (tmp/'messages.txt').read_text() if (tmp/'messages.txt').exists() else ''\n        stdin = (tmp/'stdin.txt').read_text()\n        assert result.returncode == expected_rc, (mode, result.returncode, result.stderr)\n        assert expected_message in messages, (mode, messages)\n        assert stdin == '', (mode, stdin)\n        print(f'{mode}, notify_fail={notify_fail}: exit={result.returncode}; message={expected_message}; stdin=closed')\nfinally:\n    shutil.rmtree(tmp)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
