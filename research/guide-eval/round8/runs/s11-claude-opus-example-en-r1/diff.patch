     return round(0.7 * tag_score + 0.3 * word_score, 4)
 
 
+def to_dynamo(value):
+    """Make ``value`` storable by boto3: floats (which it rejects) become Decimals.
+
+    Applied to every item right before ``put_item`` so a float added anywhere in
+    the item, now or later, can't reach DynamoDB.
+    """
+    if isinstance(value, bool):
+        return value
+    if isinstance(value, float):
+        if value != value or value in (float("inf"), float("-inf")):
+            raise ValueError("non-finite number cannot be stored")
+        return Decimal(str(value))
+    if isinstance(value, dict):
+        return {k: to_dynamo(v) for k, v in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [to_dynamo(v) for v in value]
+    return value
+
+
