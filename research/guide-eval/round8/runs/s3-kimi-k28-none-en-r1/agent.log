{"role":"tool","tool_call_id":"tool_WSCBPe3heee7vmmAm20i7qGB","content":"1\t#!/bin/zsh\n2\t# Nightly review of yesterday's commits, summary to Telegram.\n3\tset -u\n4\t\n5\tREPO=\"$HOME/projects/shop\"\n6\tOUT=\"$HOME/Library/Logs/nightly-review-$(date +%F).md\"\n7\tNOTIFY=\"$HOME/bin/notify.sh\"\n8\t\n9\t# Optional headless credentials for claude (ANTHROPIC_API_KEY or\n10\t# CLAUDE_CODE_OAUTH_TOKEN), kept out of the plist. See ANSWER.md.\n11\t[ -f \"$HOME/.config/nightly-review.env\" ] && source \"$HOME/.config/nightly-review.env\"\n12\t\n13\tSINCE=$(date -v-1d +%F)\n14\tPROMPT=\"Review the commits in this repository since $SINCE.\n15\tFor each commit: one line on what it changes and whether anything looks risky\n16\t(migrations, auth, payments, deleted tests).\n17\tEnd with a three-line summary I can read on my phone.\n18\tDo not modify any file.\"\n19\t\n20\tcd \"$REPO\" || { \"$NOTIFY\" \"nightly review: repo missing\"; exit 1; }\n21\t\n22\tclaude -p \"$PROMPT\" --output-format text > \"$OUT\"\n23\trc=$?\n24\t\n25\tif [ $rc -ne 0 ]; then\n26\t  \"$NOTIFY\" \"nightly review FAILED (exit $rc), see $OUT\"\n27\t  exit $rc\n28\tfi\n29\t\n30\t\"$NOTIFY\" \"nightly review done: $(head -c 300 \"$OUT\")\""}
{"role":"tool","tool_call_id":"tool_KH9NQm7lSqBmin2W4n35Yasw","content":"1\t#!/bin/bash\n2\t# usage: notify.sh \"message\"  — sends a Telegram message to me.\n3\tset -eu\n4\tTG_BOT_TOKEN=$(security find-generic-password -s tg-bot -w) || {\n5\t  echo \"notify.sh: could not read the 'tg-bot' item from the keychain\" >&2\n6\t  exit 1\n7\t}\n8\tCHAT_ID=123456789\n9\tcurl -sS -X POST \"https://api.telegram.org/bot${TG_BOT_TOKEN}/sendMessage\" \\\n10\t  -d chat_id=\"$CHAT_ID\" --data-urlencode text=\"$1\" > /dev/null"}
