arker\\\"\\nassert sys1[0][\\\"text\\\"] == sys2[0][\\\"text\\\"] == bot.INSTRUCTIONS, \\\"instructions block changed after save_fact!\\\"\\nassert sys2[1][\\\"text\\\"] != sys1[1][\\\"text\\\"], \\\"context block should have changed\\\"\\nassert \\\"Prefers morning swims\\\" in sys2[1][\\\"text\\\"], \\\"new fact missing from context block\\\"\\nprint(\\\"context tail before:\\\", repr(sys1[1][\\\"text\\\"][-60:]))\\nprint(\\\"context tail after :\\\", repr(sys2[1][\\\"text\\\"][-60:]))\\n\\n# instructions must be identical across users and dates too\\nimport datetime as dt\\na42 = bot.load_athlete(\\\"42\\\"); a77 = bot.load_athlete(\\\"77\\\")\\nfor s in [bot.build_system(a42, dt.date(2026, 11, 9))[0], bot.build_system(a77, dt.date(2026, 4, 18))[0]]:\\n    assert s[\\\"text\\\"] == bot.INSTRUCTIONS\\nprint(\\\"instructions byte-identical across users/dates: OK\\\")\\n\\nos.remove(bot.ATHLETES_FILE); os.remove(bot.USAGE_LOG)\\nprint(\\\"ALL CHECKS PASSED\\\")\\nEOF\"}"}}]}
