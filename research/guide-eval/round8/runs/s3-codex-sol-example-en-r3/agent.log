{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nfrom pathlib import Path\nfrom tempfile import TemporaryDirectory\nimport os, shutil, subprocess\nroot = Path.cwd()\nwith TemporaryDirectory(dir=root) as tmp:\n    home = Path(tmp)\n    (home / 'bin').mkdir()\n    (home / 'projects/shop').mkdir(parents=True)\n    (home / 'Library/Logs').mkdir(parents=True)\n    shutil.copy2(root / 'bin/nightly-review.zsh', home / 'bin/nightly-review.zsh')\n    notifier = home / 'bin/notify.sh'\n    notifier.write_text('#\"'!/bin/sh'\"\\\\nprintf \\\"%s\\\\\\\\n\\\" \\\"\"'$1\" >> \"$HOME/messages\"'\"\\\\nexit \\\"\"'${NOTIFY_RC:-0}\"'\"\\\\n')\n    notifier.chmod(0o755)\n    claude = home / 'bin/claude'\n    claude.write_text('#\"'!/bin/sh'\"\\\\n[ \\\"\"'$1\" = \"-p\" ] || exit 97'\"\\\\n[ -n \\\"\"'$2\" ] || exit 98'\"\\\\n[ \"'! -t 0 ] || exit 99'\"\\\\n[ -z \\\"\"'$(cat)\" ] || exit 96'\"\\\\nprintf \\\"%s\\\" \\\"\"'${CLAUDE_TEXT:-summary}\"'\"\\\\nexit \\\"\"'${CLAUDE_RC:-0}\"'\"\\\\n')\n    claude.chmod(0o755)\n    env = dict(os.environ, HOME=str(home), PATH=f'{home / \\\"bin\\\"}:{os.environ[\\\"PATH\\\"]}')\n    def run(name, overrides, expected_rc, expected_message):\n        (home / 'messages').unlink(missing_ok=True)\n        result = subprocess.run(['/bin/zsh', str(home / 'bin/nightly-review.zsh')], env={**env, **overrides}, capture_output=True, text=True)\n        messages = (home / 'messages').read_text() if (home / 'messages').exists() else ''\n        assert result.returncode == expected_rc, (name, result.returncode, result.stderr)\n        assert expected_message in messages, (name, messages, result.stderr)\n        print(f'{name}: exit {result.returncode}, notification present')\n    run('success', {}, 0, 'nightly review done: summary')\n    run('agent failure', {'CLAUDE_RC':'7'}, 7, 'nightly review FAILED (exit 7)')\n    run('empty output', {'CLAUDE_TEXT':'', 'CLAUDE_RC':'0'}, 0, 'nightly review done: summary') if False else None\n    (home / 'bin/claude').write_text('#\"'!/bin/sh'\"\\\\nexit 0\\\\n')\n    run('empty output', {}, 1, 'nightly review FAILED: empty summary')\n    (home / 'projects/shop').rmdir()\n    run('missing repo', {}, 1, 'nightly review FAILED: repo missing')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
