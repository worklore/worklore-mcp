{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc 'git diff --check && git diff'","aggregated_output":"diff --git a/README.md b/README.md\nindex 31b0941..adfbd17 100644\n--- a/README.md\n+++ b/README.md\n@@ -9,8 +9,13 @@ exports them to the athlete's Garmin watch through Garmin Connect.\n - `readback/` holds what the API returned for the last pushed event and\n   notes on what the watch displayed.\n \n-Athlete thresholds live in Intervals (LTHR 172 for this athlete). HR targets\n-in plans are percentages of LTHR; Intervals converts them to bpm at export.\n+Set `lthr_bpm` in each plan to the athlete's current LTHR (172 in the example).\n+HR ranges in `hr_pct` are percentages of that value. The generator converts\n+them to whole bpm and writes the exact corridor into each step's text. It does\n+not send a structured HR target: the observed Garmin export maps `%lthr`\n+targets to the watch's zone bands, while a prior `bpm` target export displayed\n+values 100 bpm too high. The watch therefore shows the planned corridor as an\n+instruction, without HR target alerts.\n \n ```\n python3 gen.py plans/tempo-run.json > event.json\ndiff --git a/gen.py b/gen.py\nindex be0b3bc..e954f36 100755\n--- a/gen.py\n+++ b/gen.py\n@@ -5,33 +5,43 @@ Usage: python3 gen.py plans/tempo-run.json > event.json\n \"\"\"\n import json\n import sys\n+from decimal import Decimal, ROUND_HALF_UP\n \n \n-def hr_target(step):\n-    \"\"\"HR corridor for a step, as a percentage of the athlete's LTHR.\"\"\"\n-    lo, hi = step[\"hr_pct\"]\n-    return {\"units\": \"%lthr\", \"value\": lo, \"end\": hi}\n+def bpm(percent, lthr_bpm):\n+    \"\"\"Round a percentage of LTHR to the nearest whole beat per minute.\"\"\"\n+    return int((Decimal(str(percent)) * Decimal(str(lthr_bpm)) / 100).quantize(\n+        Decimal(\"1\"), rounding=ROUND_HALF_UP\n+    ))\n \n \n-def build_step(step):\n+def build_step(step, lthr_bpm):\n     out = {\"duration\": step[\"minutes\"] * 60}\n+    label = step.get(\"label\", \"\")\n     if \"hr_pct\" in step:\n-        out[\"hr\"] = hr_target(step)\n-    if \"label\" in step:\n-        out[\"text\"] = step[\"label\"]\n+        lo, hi = step[\"hr_pct\"]\n+        if not 0 < lo <= hi:\n+            raise ValueError(f\"invalid hr_pct range: {step['hr_pct']}\")\n+        corridor = f\"{bpm(lo, lthr_bpm)}–{bpm(hi, lthr_bpm)} bpm\"\n+        label = f\"{label} ({corridor})\" if label else corridor\n+    if label:\n+        out[\"text\"] = label\n     return out\n \n \n def build_doc(plan):\n+    lthr_bpm = plan[\"lthr_bpm\"]\n+    if lthr_bpm <= 0:\n+        raise ValueError(\"lthr_bpm must be positive\")\n     steps = []\n     for block in plan[\"steps\"]:\n         if \"repeat\" in block:\n             steps.append({\n                 \"reps\": block[\"repeat\"],\n-                \"steps\": [build_step(s) for s in block[\"steps\"]],\n+                \"steps\": [build_step(s, lthr_bpm) for s in block[\"steps\"]],\n             })\n         else:\n-            steps.append(build_step(block))\n+            steps.append(build_step(block, lthr_bpm))\n     return {\"steps\": steps}\n \n \ndiff --git a/plans/tempo-run.json b/plans/tempo-run.json\nindex 8a4a545..baa8cdf 100644\n--- a/plans/tempo-run.json\n+++ b/plans/tempo-run.json\n@@ -2,6 +2,7 @@\n   \"name\": \"Tempo run 45\",\n   \"sport\": \"Run\",\n   \"date\": \"2026-10-20\",\n+  \"lthr_bpm\": 172,\n   \"steps\": [\n     {\"label\": \"Warm-up easy\", \"minutes\": 10, \"hr_pct\": [68, 75]},\n     {\"repeat\": 3, \"steps\": [\n","exit_code":0,"status":"completed"}}
