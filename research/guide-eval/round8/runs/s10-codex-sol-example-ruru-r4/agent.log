"'Shortening…'\"'\"' : '\"'\"'Shorter'\"'\"',\\012                    dense: true,\\012                    busy: shortening,\\012                    onTap: state.busy || state.posting ? null : onShorter,\\012                  ),\"\"\"),\\012(\"\"\"                HbChip(\\012                  key: const Key('\"'\"'thread.redraft'\"'\"'),\\012                  label: '\"'\"'Redraft'\"'\"',\\012                  dense: true,\\012                  leading: Ms(\\012                    Symbols.refresh_rounded,\\012                    size: 16,\\012                    color: c.muted,\\012                  ),\\012                  onTap: state.busy ? null : onRedraft,\\012                ),\"\"\",\"\"\"                HbChip(\\012                  key: const Key('\"'\"'thread.redraft'\"'\"'),\\012                  label: redrafting ? '\"'\"'Redrafting…'\"'\"' : '\"'\"'Redraft'\"'\"',\\012                  dense: true,\\012                  busy: redrafting,\\012                  leading: Ms(\\012                    Symbols.refresh_rounded,\\012                    size: 16,\\012                    color: c.muted,\\012                  ),\\012                  onTap: state.busy || state.posting ? null : onRedraft,\\012                ),\"\"\"),\\012(\"\"\"                    onTap: state.busy ? null : onAskCode,\"\"\",\"\"\"                    onTap: state.busy || state.posting ? null : onAskCode,\"\"\"),\\012(\"\"\"        final over = DraftLimit.isOver(text.text, limit);\\012        final checks = DraftChecks.parse(text.text);\"\"\",\"\"\"        final over = DraftLimit.isOver(text.text, limit);\\012        final checks = DraftChecks.parse(text.text);\\012        final shortening = state.drafting == DraftVariant.shorter;\\012        final redrafting =\\012            state.drafting == DraftVariant.redraft && !state.draftingLonger;\"\"\"),\\012]\\012for a,b in reps:\\012    assert a in s, a; s=s.replace(a,b)\\012\\012old=\"\"\"/// The draft text field: starts at the top\"\"