{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc 'rg --files && git status --short && cat pubspec.yaml && cat lib/main.dart'","aggregated_output":"analysis_options.yaml\nREADME.md\npubspec.yaml\nlib/analytics.dart\nlib/main.dart\ndocs/EVENTS.md\nlib/screens/offer_screen.dart\nlib/screens/registration_screen.dart\nname: kredito\ndescription: Consumer loan registration and offers.\npublish_to: \"none\"\nversion: 1.3.0+27\n\nenvironment:\n  sdk: ^3.5.0\n\ndependencies:\n  flutter:\n    sdk: flutter\n  posthog_flutter: ^5.36.0\n\ndev_dependencies:\n  flutter_test:\n    sdk: flutter\n  flutter_lints: ^5.0.0\n\nflutter:\n  uses-material-design: true\nimport 'package:flutter/material.dart';\nimport 'package:posthog_flutter/posthog_flutter.dart';\n\nimport 'analytics.dart';\nimport 'screens/offer_screen.dart';\nimport 'screens/registration_screen.dart';\n\nFuture<void> main() async {\n  WidgetsFlutterBinding.ensureInitialized();\n  await Analytics.init();\n  runApp(const KreditoApp());\n}\n\nclass KreditoApp extends StatelessWidget {\n  const KreditoApp({super.key});\n\n  @override\n  Widget build(BuildContext context) {\n    return PostHogWidget(\n      child: MaterialApp(\n        title: 'Kredito',\n        theme: ThemeData(colorSchemeSeed: Colors.green, useMaterial3: true),\n        navigatorObservers: [PosthogObserver()],\n        routes: {\n          '/': (_) => const RegistrationScreen(),\n          '/offers': (_) => const OfferScreen(),\n        },\n      ),\n    );\n  }\n}\n","exit_code":0,"status":"completed"}}
