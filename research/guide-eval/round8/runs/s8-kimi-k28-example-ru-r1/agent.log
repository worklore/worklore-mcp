{"role":"assistant","content":"Проверяю. Живые вызовы API запрещены правилами, поэтому проверю локально: синтаксис, структуру запросов через стаб-LLM и поведение префиксного кеша через симуляцию (старая vs новая сборка промпта на одном сценарии).","tool_calls":[{"type":"function","id":"tool_21f6zABTMM9nQWNoczmmTVNd","function":{"name":"Bash","arguments":"{\"command\":\"python3 -m py_compile bot.py && python3 - <<'EOF'\\nimport json, os, shutil, sys, tempfile, datetime as dt\\nsys.path.insert(0, os.getcwd())\\nimport bot\\n\\nFAILED = []\\ndef check(name, cond):\\n    print((\\\"PASS  \\\" if cond else \\\"FAIL  \\\") + name)\\n    if not cond:\\n        FAILED.append(name)\\n\\ndef approx_tokens(s):\\n    return max(1, (len(s) + 3) // 4)\\n\\nclass CacheSim:\\n    \\\"\\\"\\\"Tiny model of Anthropic prefix caching: cacheable prefixes end at each\\n    cache_control marker; a request reads the longest stored prefix it matches\\n    and creates cache from the match point to the last marker.\\\"\\\"\\\"\\n    def __init__(self):\\n        self.entries = set()\\n    def account(self, tools, system):\\n        parts = [json.dumps(tools, sort_keys=True, separators=(\\\",\\\", \\\":\\\"))]\\n        prefixes = []\\n        for blk in system:\\n            parts.append(blk[\\\"text\\\"])\\n            if blk.get(\\\"cache_control\\\"):\\n                prefixes.append(\\\"\\\".join(parts))\\n        hit = \\\"\\\"\\n        for p in prefixes:          # prefixes are nested; keep the longest match\\n            if p in self.entries:\\n                hit = p\\n        full = prefixes[-1]\\n        read = approx_tokens(hit)\\n        creation = 0 if hit == full else approx_tokens(full[len(hit):])\\n        self.entries.update(prefixes)\\n        return read, creation\\n\\nclass Block:\\n    def __init__(self, type, **kw):\\n        self.type = type\\n        self.__dict__.update(kw)\\n    def model_dump(self):\\n        return dict(self.__dict__)\\n\\nclass Usage:\\n    input_tokens = 60\\n    cache_creation_input_tokens = 0\\n    cache_read_input_tokens = 0\\n    output_tokens = 25\\n\\nclass Resp:\\n    def __init__(self, blocks, stop):\\n        self.content = blocks\\n        self.stop_reason = stop\\n        self.usage = Usage()\\n\\nclass FakeLLM:\\n    def __init__(self, script):\\n        self._script = list(script)\\n        self.requests = []\\n    def create(self, **kw):\\n        self.requests.append(kw)\\n        blocks, stop = self._script.pop(0)\\n        return Resp(blocks, stop)\\n\\ndef old_build_system(a, today):\\n    text = bot.INSTRUCTIONS + \\\"\\\\n\\\\n\\\" + bot.athlete_context(a, today)\\n    return [{\\\"type\\\": \\\"text\\\", \\\"text\\\": text, \\\"cache_control\\\": {\\\"type\\\": \\\"ephemeral\\\"}}]\\n\\nNEW_BUILD_SYSTEM = bot.build_system\\nORIG_ATHLETES_FILE, ORIG_LOG_USAGE = bot.ATHLETES_FILE, bot.log_usage\\n\\ndef run_scenario():\\n    tmp = tempfile.mkdtemp(prefix=\\\".cachetest_\\\", dir=\\\".\\\")\\n    try:\\n        shutil.copy(os.path.join(\\\"data\\\", \\\"athletes.json\\\"), os.path.join(tmp, \\\"athletes.json\\\"))\\n        bot.ATHLETES_FILE = os.path.join(tmp, \\\"athletes.json\\\")\\n        bot.log_usage = lambda usage, user_id, round_no, tool=None: None\\n        save_block = Block(\\\"tool_use\\\", id=\\\"tu_1\\\", name=\\\"save_fact\\\",\\n                           input={\\\"fact\\\": \\\"Races parkrun every Saturday\\\"})\\n        llm = FakeLLM([\\n            ([save_block], \\\"tool_use\\\"),\\n            ([Block(\\\"text\\\", text=\\\"Noted, parkrun Saturdays.\\\")], \\\"end_turn\\\"),\\n            ([Block(\\\"text\\\", text=\\\"Glad to help.\\\")], \\\"end_turn\\\"),\\n            ([Block(\\\"text\\\", text=\\\"Hallo Jonas.\\\")], \\\"end_turn\\\"),\\n        ])\\n        bot.reply(\\\"42\\\", \\\"I race parkrun every Saturday\\\", llm=llm)\\n        bot.reply(\\\"42\\\", \\\"thanks\\\", llm=llm)\\n        bot.reply(\\\"77\\\", \\\"hallo\\\", llm=llm)   # second athlete in the same 5-min window\\n        sim = CacheSim()\\n        accounting = [sim.account(r[\\\"tools\\\"], r[\\\"system\\\"]) for r in llm.requests]\\n        return llm.requests, accounting\\n    finally:\\n        shutil.rmtree(tmp)\\n        bot.ATHLETES_FILE, bot.log_usage = ORIG_ATHLETES_FILE, ORIG_LOG_USAGE\\n\\nbot.build_system = old_build_system\\nreqs_old, acc_old = run_scenario()\\nbot.build_system = NEW_BUILD_SYSTEM\\nreqs_new, acc_new = run_scenario()\\n\\n# ---- structural checks on the new request shape ----\\nsys_new = [r[\\\"system\\\"] for r in reqs_new]\\ncheck(\\\"new: 4 requests captured\\\", len(reqs_new) == 4)\\ncheck(\\\"new: system is 2 blocks\\\", all(len(s) == 2 for s in sys_new))\\ncheck(\\\"new: both blocks carry cache_control ephemeral\\\",\\n      all(b.get(\\\"cache_control\\\") == {\\\"type\\\": \\\"ephemeral\\\"} for s in sys_new for b in s))\\ncheck(\\\"new: block 1 is the raw INSTRUCTIONS constant on every call\\\",\\n      all(s[0][\\\"text\\\"] == bot.INSTRUCTIONS for s in sys_new))\\ncheck(\\\"new: tail before save_fact lacks the fact\\\",\\n      \\\"parkrun\\\" not in sys_new[0][1][\\\"text\\\"])\\ncheck(\\\"new: tail right after save_fact has the fact\\\",\\n      \\\"parkrun\\\" in sys_new[1][1][\\\"text\\\"])\\ncheck(\\\"new: next message tail identical to post-save tail\\\",\\n      sys_new[1][1][\\\"text\\\"] == sys_new[2][1][\\\"text\\\"])\\ncheck(\\\"new: second athlete's tail differs, instructions identical\\\",\\n      sys_new[3][1][\\\"text\\\"] != sys_new[2][1][\\\"text\\\"] and sys_new[3][0][\\\"text\\\"] == bot.INSTRUCTIONS)\\na0 = bot.load_athlete(\\\"42\\\"); a0.facts = a0.facts[:-1]\\ncheck(\\\"new: rendered prompt byte-identical to previous single-block version\\\",\\n      sys_new[0][0][\\\"text\\\"] + sys_new[0][1][\\\"text\\\"]\\n      == bot.INSTRUCTIONS + \\\"\\\\n\\\\n\\\" + bot.athlete_context(a0, dt.date.today()))\\ntools_dump = [json.dumps(r[\\\"tools\\\"], sort_keys=True) for r in reqs_new]\\ncheck(\\\"tools byte-stable within the scenario\\\", len(set(tools_dump)) == 1)\\n\\n# ---- prefix-cache accounting: new (two-segment) layout ----\\nr0, r1, r2, r3 = [x[0] for x in acc_new]\\nc0, c1, c2, c3 = [x[1] for x in acc_new]\\nfull = r0 + c0\\nprint(f\\\"\\\\nnew layout (approx tokens): req0(read={r0}, create={c0})  req1-after-save_fact(read={r1}, create={c1})  \\\"\\n      f\\\"req2(read={r2}, create={c2})  req3-other-user(read={r3}, create={c3})\\\")\\ncheck(\\\"new: first call creates the full cache\\\", r0 == 0 and c0 > 0)\\ncheck(\\\"new: save_fact keeps static prefix cached (read covers bulk)\\\",\\n      full > 0 and r1 >= 0.6 * full)\\ncheck(\\\"new: save_fact re-creates only the tail (<< full prompt)\\\",\\n      0 < c1 <= 0.35 * full)\\ncheck(\\\"new: follow-up message reads everything\\\", c2 == 0 and r2 == full)\\ncheck(\\\"new: second athlete shares the cached static prefix\\\", r3 == r1 and c3 == c1)\\n\\n# ---- same scenario, old (single-block) layout: reproduces the bug ----\\no_r1, o_c1 = acc_old[1]\\no_r3, o_c3 = acc_old[3]\\no_full = acc_old[0][1]\\nprint(f\\\"old layout (approx tokens): req1-after-save_fact(read={o_r1}, create={o_c1})  \\\"\\n      f\\\"req3-other-user(read={o_r3}, create={o_c3})\\\")\\ncheck(\\\"old: save_fact evicts everything (reproduces logs/usage.jsonl)\\\", o_r1 == 0 and o_c1 >= 0.9 * o_full)\\ncheck(\\\"old: no cross-user static sharing\\\", o_r3 == 0)\\ncheck(\\\"old vs new: creation right after save_fact shrinks\\\",\\n      c1 < o_c1 and acc_old[1][0] == 0 and r1 > 0)\\n\\nprint()\\nif FAILED:\\n    print(f\\\"{len(FAILED)} CHECK(S) FAILED\\\")\\n    sys.exit(1)\\nprint(\\\"ALL CHECKS PASSED\\\")\\nEOF\"}"}}]}
