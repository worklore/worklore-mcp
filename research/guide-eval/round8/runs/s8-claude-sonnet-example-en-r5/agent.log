 - <<'E'\ns=open('bot.py').read()\nold=s[s.index(\"def build_system\"):s.index(\"# ---------------------------------------------------------------------------\", s.index(\"def build_system\"))]\nnew='''def build_system(a, today):\n    # Two cached segments. The instructions are byte-identical for everyone, so a\n    # save_fact (which rewrites the tail) leaves that prefix valid. Keep anything\n    # per-user, per-day or per-write out of INSTRUCTIONS.\n    return [\n        {\"type\": \"text\", \"text\": INSTRUCTIONS, \"cache_control\": {\"type\": \"ephemeral\"}},\n        {\"type\": \"text\", \"text\": athlete_context(a, today), \"cache_control\": {\"type\": \"ephemeral\"}},\n    ]\n\n'''\nopen('bot.py','w').write(s.replace(old,new))\nE\npython3 -I - <<'E'\nimport sys;sys.path.insert(0,'/tmp/h-Fsn7Uo')\nimport bot,datetime as dt\na=bot.load_athlete('42');t=dt.date.today()\nx=bot.build_system(a,t);a.facts.append(\"new\");y=bot.build_system(a,t)\nprint(x[0]==y[0],x[1]==y[1],len(x))\nE"}}}
