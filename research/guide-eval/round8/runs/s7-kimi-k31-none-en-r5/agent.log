"scope\"), \"expires_at\": time.time() + expires_in, \"status\": \"connected\",\n+            \"scope\": tok.get(\"scope\"), \"expires_at\": expires_at, \"status\": \"connected\",\n         }\n-    log(f\"{user_id}: connected as athlete {athlete.get('id')} (expires in {expires_in}s)\")\n+    lifetime = f\"expires in {expires_in}s\" if expires_in is not None else \"no expiry supplied\"\n+    log(f\"{user_id}: connected as athlete {athlete.get('id')} ({lifetime})\")\n \n \n def refresh_tokens():\n@@ -84,7 +83,8 @@ def refresh_tokens():\n         now = time.time()\n         with LOCK:\n             for uid, c in CONNECTIONS.items():\n-                if c[\"status\"] != \"connected\" or c[\"expires_at\"] - now > 300:\n+                if (c[\"status\"] != \"connected\" or c[\"expires_at\"] is None\n+                        or c[\"expires_at\"] - now > 300):\n                     continue\n                 if not c[\"refresh_token\"]:\n                     log(f\"{uid}: token expiry passed and no refresh token on file -> expired, reconnect\")\n@@ -185,14 +185,15 @@ class Handler(BaseHTTPRequestHandler):\n             return\n         self.send_json(404, {\"error\": \"not found\"})\n \n-    # Step 1: build the authorize URL and send the browser to Intervals.\n+    # Step 1: return the authorize URL for the SPA to open in the browser.\n     def auth_init(self):\n         user = self.require_user()\n         if not user:\n             return\n         params = {\"client_id\": config.CLIENT_ID, \"redirect_uri\": config.REDIRECT_URI,\n                   \"scope\": config.SCOPES, \"state\": sign_state(user[\"id\"])}\n-        self.redirect(AUTHORIZE_URL + \"?\" + urllib.parse.urlencode(params, safe=\":,\"))\n+        url = AUTHORIZE_URL + \"?\" + urllib.parse.urlencode(params, safe=\":,\")\n+        self.send_json(200, {\"authorize_url\": url})\n \n     # Step 2: Intervals redirects back here with ?code=&state=.\n     def callback(self, q):\ndiff --git a/static/app.js b/static/app.js\nindex 368922e..910245b 100644\n--- a/static/app.js\n+++ b/static/app.js\n@@ -25,10 +25,15 @@ async function render() {\n     } else {\n       const why = st.status && st.status !== \"disconnected\" ? `<p class=\"muted\">Status: ${esc(st.status)}</p>` : \"\";\n       card = `<div class=\"card\">Intervals.icu is not connected.${why}\n-        <p><a class=\"btn\" href=\"/api/intervals/auth/init\">Connect Intervals.icu</a></p></div>`;\n+        <p><button class=\"btn\" id=\"connect\">Connect Intervals.icu</button></p></div>`;\n     }\n     root.className = \"\";\n     root.innerHTML = `<p>Signed in as <b>${esc(me.name)}</b>.</p>${card}`;\n+    const c = document.getElementById(\"connect\");\n+    if (c) c.onclick = async () => {\n+      const auth = await api(\"/api/intervals/auth/init\");\n+      window.location.assign(auth.authorize_url);\n+    };\n     const d = document.getElementById(\"disconnect\");\n     if (d) d.onclick = async () => { await api(\"/api/intervals/disconnect\", { method: \"POST\" }); render(); };\n   } catch (e) {\n"}
