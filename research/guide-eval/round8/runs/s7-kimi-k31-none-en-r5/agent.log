{"role":"assistant","tool_calls":[{"type":"function","id":"tool_UbfQLggST3zG4eU4RpcSKfKn","function":{"name":"Bash","arguments":"{\"command\":\"python3 - <<'PY'\\nimport json\\nimport os\\nimport threading\\nimport time\\nimport urllib.error\\nimport urllib.parse\\nimport urllib.request\\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\\n\\nclass Provider(BaseHTTPRequestHandler):\\n    def log_message(self, *args):\\n        pass\\n    def do_GET(self):\\n        q = dict(urllib.parse.parse_qsl(urllib.parse.urlsplit(self.path).query))\\n        scopes = q.get('scope', '').split(',')\\n        bases = [s.split(':')[0] for s in scopes]\\n        if len(bases) != len(set(bases)):\\n            body = b'{\\\"error\\\":\\\"invalid_request\\\"}'\\n            self.send_response(400)\\n        else:\\n            body = b'{}'\\n            self.send_response(200)\\n        self.send_header('Content-Length', str(len(body)))\\n        self.end_headers()\\n        self.wfile.write(body)\\n    def do_POST(self):\\n        body = json.dumps({\\n            'token_type': 'bearer', 'access_token': 'local-token',\\n            'scope': 'ACTIVITY:WRITE,WELLNESS:READ',\\n            'athlete': {'id': 'local-athlete', 'name': 'Local Athlete'}\\n        }).encode()\\n        self.send_response(200)\\n        self.send_header('Content-Type', 'application/json')\\n        self.send_header('Content-Length', str(len(body)))\\n        self.end_headers()\\n        self.wfile.write(body)\\n\\nprovider = ThreadingHTTPServer(('127.0.0.1', 0), Provider)\\nthreading.Thread(target=provider.serve_forever, daemon=True).start()\\nos.environ['INTERVALS_BASE'] = f'http://127.0.0.1:{provider.server_port}'\\nimport server\\napp = ThreadingHTTPServer(('127.0.0.1', 0), server.Handler)\\nthreading.Thread(target=app.serve_forever, daemon=True).start()\\nbase = f'http://127.0.0.1:{app.server_port}'\\n\\nclass NoRedirect(urllib.request.HTTPRedirectHandler):\\n    def redirect_request(self, *args):\\n        return None\\nopener = urllib.request.build_opener(NoRedirect)\\n\\ntry:\\n    opener.open(base + '/api/intervals/auth/init')\\nexcept urllib.error.HTTPError as e:\\n    print('Connect navigation without bearer header:', e.code)\\n\\nreq = urllib.request.Request(base + '/api/intervals/auth/init', headers={'Authorization': 'Bearer tok-okafor'})\\ntry:\\n    opener.open(req)\\nexcept urllib.error.HTTPError as e:\\n    location = e.headers['Location']\\n    print('Authorized init:', e.code)\\ntry:\\n    urllib.request.urlopen(location)\\nexcept urllib.error.HTTPError as e:\\n    print('Provider authorize response:', e.code, e.read().decode())\\n\\nbefore = time.time()\\nserver.store_connection('u_okafor', server.exchange_code('local-code'))\\nprint('Invented token lifetime (seconds):', round(server.CONNECTIONS['u_okafor']['expires_at'] - before))\\napp.shutdown()\\nprovider.shutdown()\\nPY\",\"cwd\":\"/private/tmp/h-qVSFoN\",\"timeout\":60}"}}]}
