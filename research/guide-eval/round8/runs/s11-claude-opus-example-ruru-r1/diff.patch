+from decimal import Decimal
 
 log = logging.getLogger("stories")
 
@@ -27,7 +28,8 @@ def similarity(a, b):
     tag_score = len(ta & tb) / len(ta | tb) if (ta | tb) else 0
     wa, wb = words(a.get("body")), words(b.get("body"))
     word_score = len(wa & wb) / len(wa | wb) if (wa | wb) else 0
-    return round(0.7 * tag_score + 0.3 * word_score, 4)
+    # DynamoDB rejects Python floats; keep the score a Decimal from the start.
+    return Decimal(str(round(0.7 * tag_score + 0.3 * word_score, 4)))
 
 
 def related(story, existing):
@@ -40,6 +42,17 @@ def related(story, existing):
     return scored[:TOP_N]
 
 
+def to_dynamo(value):
+    """Convert every float in ``value`` to Decimal: boto3 refuses floats."""
+    if isinstance(value, float):
+        return Decimal(str(value))
+    if isinstance(value, dict):
+        return {k: to_dynamo(v) for k, v in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [to_dynamo(v) for v in value]
+    return value
+
+
 def validate(story):
     for k in ("slug", "title", "body"):
         if not story.get(k):
@@ -60,6 +73,7 @@ def publish(table, story):
         "published_at": int(time.time()),
         "similar": related(story, existing),
     }
+    item = to_dynamo(item)
     table.put_item(Item=item)
     log.info("publish slug=%s similar=%d stored", item["slug"], len(item["similar"]))
     return item
