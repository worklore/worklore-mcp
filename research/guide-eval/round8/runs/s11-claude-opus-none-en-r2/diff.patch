+    return Decimal(str(round(0.7 * tag_score + 0.3 * word_score, 4)))
 
 
 def related(story, existing):
@@ -40,6 +42,22 @@ def related(story, existing):
     return scored[:TOP_N]
 
 
+def to_dynamo(value):
+    """Return ``value`` with every float replaced by a Decimal.
+
+    boto3 refuses floats ("Float types are not supported"), so every item goes
+    through this before ``put_item``; a float added to an item later can't 500.
+    ``Decimal(str(x))`` keeps the short repr and avoids boto3's Inexact error.
+    """
+    if isinstance(value, float):
+        return Decimal(str(value))
+    if isinstance(value, dict):
+        return {k: to_dynamo(v) for k, v in value.items()}
+    if isinstance(value, list):
+        return [to_dynamo(v) for v in value]
+    return value
+
+
 def validate(story):
