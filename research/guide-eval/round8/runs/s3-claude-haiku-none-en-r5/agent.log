I can read on my phone.\nDo not modify any file.\"\n\ncd \"$REPO\" || { \"$NOTIFY\" \"nightly review: repo missing\"; exit 1; }\n\n# stderr goes to its own file: launchd's err log is the only place it lands otherwise.\nclaude -p \"$PROMPT\" --output-format text > \"$OUT\" 2> \"$ERR\"\nclaude_rc=$?\n\n# A zero exit with no output is still a failure: nothing to summarize.\nif [ $claude_rc -ne 0 ] || [ ! -s \"$OUT\" ]; then\n  code=$claude_rc\n  [ $code -eq 0 ] && code=1\n  \"$NOTIFY\" \"nightly review FAILED (exit $code): $(head -c 200 \"$ERR\") -- see $ERR\"\n  exit $code\nfi\n\n\"$NOTIFY\" \"nightly review done: $(head -c 300 \"$OUT\")\"\n","structuredPatch":[{"oldStart":36,"oldLines":7,"newStart":36,"newLines":9,"lines":[" if [ $claude_rc -ne 0 ] || [ ! -s \"$OUT\" ]; then","   code=$claude_rc","   [ $code -eq 0 ] && code=1","-  \"$NOTIFY\" \"nightly review FAILED (exit $code): $(head -c 200 \"$ERR\") -- see $ERR\"","+  reason=$(head -c 200 \"$ERR\")","+  [ -n \"$reason\" ] || reason=\"no output from claude\"","+  \"$NOTIFY\" \"nightly review FAILED (exit $code): $reason -- see $ERR\"","   exit $code"," fi"," "]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_01GSqENrJ99Gw5wQDbn5FsEN","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
