g>$\n  </array>$\n  <key>StartCalendarInterval</key>$\n  <dict>$\n    <key>Hour</key>$\n    <integer>2</integer>$\n    <key>Minute</key>$\n    <integer>30</integer>$\n  </dict>$\n  <key>StandardOutPath</key>$\n  <string>/Users/vk/Library/Logs/nightly-review.out</string>$\n  <key>StandardErrorPath</key>$\n  <string>/Users/vk/Library/Logs/nightly-review.err</string>$\n  <key>EnvironmentVariables</key>$\n  <dict>$\n    <key>PATH</key>$\n    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>$\n  </dict>$\n</dict>$\n</plist>$\n=== Library/Logs/nightly-review.out\n=== Library/Logs/nightly-review.err\nNot logged in M-BM-7 Please run /login$\n/Users/vk/bin/nightly-review.zsh:19: read-only variable: status$\nNot logged in M-BM-7 Please run /login$\n/Users/vk/bin/nightly-review.zsh:19: read-only variable: status$\nNot logged in M-BM-7 Please run /login$\n/Users/vk/bin/nightly-review.zsh:19: read-only variable: status$\nNot logged in M-BM-7 Please run /login$\n/Users/vk/bin/nightly-review.zsh:19: read-only variable: status$\nNot logged in M-BM-7 Please run /login$\n/Users/vk/bin/nightly-review.zsh:19: read-only variable: status$\nNot logged in M-BM-7 Please run /login$\n/Users/vk/bin/nightly-review.zsh:19: read-only variable: status$\n\nLibrary/LaunchAgents:\ntotal 4\ndrwxr-xr-x 3 valentinakoniukhova wheel  96 Oct 27 02:05 .\ndrwxr-xr-x 4 valentinakoniukhova wheel 128 Oct 27 02:05 ..\n-rw-r--r-- 1 valentinakoniukhova wheel 853 Oct 27 02:05 com.vk.nightly-review.plist\n\nLibrary/Logs:\ntotal 4\ndrwxr-xr-x 4 valentinakoniukhova wheel 128 Oct 27 02:05 .\ndrwxr-xr-x 4 valentinakoniukhova wheel 128 Oct 27 02:05 ..\n-rw-r--r-- 1 valentinakoniukhova wheel 594 Oct 27 02:05 nightly-review.err\n-rw-r--r-- 1 valentinakoniukhova wheel   0 Oct 27 02:05 nightly-review.out\n\nbin:\ntotal 8\ndrwxr-xr-x 4 valentinakoniukhova wheel 128 Oct 27 02:05 .\ndrwx------ 7 valentinakoniukhova wheel 224 Oct 27 02:05 ..\n-rwxr-xr-x 1 valentinakoniukhova wheel 772 Oct 27 02:05 nightly-review.z