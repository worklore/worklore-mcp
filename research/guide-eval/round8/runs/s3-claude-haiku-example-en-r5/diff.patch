diff --git a/bin/nightly-review.zsh b/bin/nightly-review.zsh
index e0b986f..7b3c747 100755
--- a/bin/nightly-review.zsh
+++ b/bin/nightly-review.zsh
@@ -15,12 +15,19 @@ Do not modify any file."
 
 cd "$REPO" || { "$NOTIFY" "nightly review: repo missing"; exit 1; }
 
-claude -p "$PROMPT" --output-format text > "$OUT"
-status=$?
+# `status` is read-only in zsh (alias of $?), so use rc.
+# stdin is closed: the prompt is an argument, and claude must not wait on stdin.
+START=$SECONDS
+claude -p "$PROMPT" --output-format text < /dev/null > "$OUT"
+rc=$?
+ELAPSED=$((SECONDS - START))
+BYTES=$(wc -c < "$OUT" | tr -d ' ')
+echo "$(date '+%F %T') claude exit=$rc seconds=$ELAPSED bytes=$BYTES"
 
-if [ $status -ne 0 ]; then
-  "$NOTIFY" "nightly review FAILED (exit $status), see $OUT"
-  exit $status
+# exit 0 with an empty output is also a failure.
+if [ $rc -ne 0 ] || [ "$BYTES" -eq 0 ]; then
+  "$NOTIFY" "nightly review FAILED (claude exit $rc, ${ELAPSED}s, $BYTES bytes), see $OUT"
+  exit 1
 fi
 
-"$NOTIFY" "nightly review done: $(head -c 300 "$OUT")"
+"$NOTIFY" "nightly review done (${ELAPSED}s): $(head -c 300 "$OUT")"
diff --git a/bin/notify.sh b/bin/notify.sh
index 818e531..f52c436 100755
--- a/bin/notify.sh
+++ b/bin/notify.sh
@@ -2,6 +2,11 @@
 # usage: notify.sh "message"  — sends a Telegram message to me.
 set -eu
 : "${TG_BOT_TOKEN:=$(security find-generic-password -s tg-bot -w)}"
+if [ -z "$TG_BOT_TOKEN" ]; then
+  echo "notify.sh: no Telegram bot token (keychain item tg-bot missing or locked)" >&2
+  exit 1
+fi
 CHAT_ID=123456789
-curl -sS -X POST "https://api.telegram.org/bot${TG_BOT_TOKEN}/sendMessage" \
+# -f: HTTP errors (bad token, etc.) must fail the script, not vanish into /dev/null.
+curl -fsS -X POST "https://api.telegram.org/bot${TG_BOT_TOKEN}/sendMessage" \
   -d chat_id="$CHAT_ID" --data-urlencode text="$1" > /dev/null
