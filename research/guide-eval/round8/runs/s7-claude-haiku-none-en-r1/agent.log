     \"client_id\": config.CLIENT_ID, \"client_secret\": config.CLIENT_SECRET,","+                })","+            except Exception as e:","+                mark_expired(uid, f\"refresh failed ({e})\")","+                continue","+            with LOCK:","+                if uid in CONNECTIONS:","+                    CONNECTIONS[uid].update(access_token=tok[\"access_token\"],","+                                            refresh_token=tok.get(\"refresh_token\", c[\"refresh_token\"]),","+                                            expires_at=expiry_from(tok))","+            log(f\"{uid}: token refreshed\")"," "," "," def intervals_get(conn, path):"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"tool_result_meta":[{"id":"toolu_01BmHHjCLpAiwy3yQ7w5ZCpi","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
