{"role":"tool","tool_call_id":"tool_OI7cLKSu5PdpzJ9ngzgh6n84","content":"1\timport 'package:flutter/material.dart';\n2\t\n3\timport '../analytics.dart';\n4\t\n5\tclass RegistrationScreen extends StatefulWidget {\n6\t  const RegistrationScreen({super.key});\n7\t\n8\t  @override\n9\t  State<RegistrationScreen> createState() => _RegistrationScreenState();\n10\t}\n11\t\n12\tclass _RegistrationScreenState extends State<RegistrationScreen> {\n13\t  final _email = TextEditingController();\n14\t  final _phone = TextEditingController();\n15\t  double _amount = 50000;\n16\t  bool _terms = false;\n17\t  bool _emailStartedFired = false;\n18\t  bool _phoneStartedFired = false;\n19\t\n20\t  @override\n21\t  void dispose() {\n22\t    _email.dispose();\n23\t    _phone.dispose();\n24\t    super.dispose();\n25\t  }\n26\t\n27\t  bool get _canContinue =>\n28\t      _terms && _email.text.contains('@') && _phone.text.length >= 10;\n29\t\n30\t  @override\n31\t  Widget build(BuildContext context) {\n32\t    return Scaffold(\n33\t      appBar: AppBar(title: const Text('Register')),\n34\t      body: Padding(\n35\t        padding: const EdgeInsets.all(16),\n36\t        child: Column(\n37\t          crossAxisAlignment: CrossAxisAlignment.stretch,\n38\t          children: [\n39\t            TextField(\n40\t              controller: _email,\n41\t              keyboardType: TextInputType.emailAddress,\n42\t              decoration: const InputDecoration(labelText: 'Email'),\n43\t              onChanged: (_) {\n44\t                setState(() {});\n45\t                if (!_emailStartedFired) {\n46\t                  _emailStartedFired = true;\n47\t                  Analytics.capture('registration_email_started');\n48\t                }\n49\t              },\n50\t            ),\n51\t            const SizedBox(height: 12),\n52\t            TextField(\n53\t              controller: _phone,\n54\t              keyboardType: TextInputType.phone,\n55\t              decoration: const InputDecoration(labelText: 'Phone'),\n56\t              onChanged: (_) {\n57\t                setState(() {});\n58\t                if (!_phoneStartedFired) {\n59\t                  _phoneStartedFired = true;\n60\t                  Analytics.capture('registration_phone_started');\n61\t                }\n62\t              },\n63\t            ),\n64\t            const SizedBox(height: 24),\n65\t            Text('Loan amount: ${_amount.round()}'),\n66\t            Slider(\n67\t              min: 10000,\n68\t              max: 500000,\n69\t              divisions: 49,\n70\t              value: _amount,\n71\t              label: _amount.round().toString(),\n72\t              onChanged: (v) => setState(() => _amount = v),\n73\t              onChangeEnd: (v) =>\n74\t                  Analytics.capture('loan_amount_changed', {'amount': v.round()}),\n75\t            ),\n76\t            CheckboxListTile(\n77\t              value: _terms,\n78\t              title: const Text('I accept the terms and conditions'),\n79\t              controlAffinity: ListTileControlAffinity.leading,\n80\t              onChanged: (v) {\n81\t                setState(() => _terms = v ?? false);\n82\t                if (v ?? false) {\n83\t                  Analytics.capture('terms_accepted');\n84\t                }\n85\t              },\n86\t            ),\n87\t            const Spacer(),\n88\t            FilledButton(\n89\t              onPressed: _canContinue\n90\t                  ? () {\n91\t                      Analytics.capture('registration_continue_tapped', {\n92\t                        'amount': _amount.round(),\n93\t                        'terms': _terms,\n94\t                      });\n95\t                      Navigator.of(context).pushNamed('/offers');\n96\t                    }\n97\t                  : null,\n98\t              child: const Text('Continue'),\n99\t            ),\n100\t          ],\n101\t        ),\n102\t      ),\n103\t    );\n104\t  }\n105\t}"}
