     word_score = len(wa & wb) / len(wa | wb) if (wa | wb) else 0
-    return round(0.7 * tag_score + 0.3 * word_score, 4)
+    # Integer percent: DynamoDB (boto3) rejects Python floats.
+    return round(100 * (0.7 * tag_score + 0.3 * word_score))
 
 
 def related(story, existing):
@@ -40,6 +42,17 @@ def related(story, existing):
     return scored[:TOP_N]
 
 
+def dynamo_safe(value):
+    """Recursively convert floats to Decimal so no float reaches boto3."""
+    if isinstance(value, float):
+        return Decimal(str(value))
+    if isinstance(value, dict):
+        return {k: dynamo_safe(v) for k, v in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [dynamo_safe(v) for v in value]
+    return value
+
+
 def validate(story):
     for k in ("slug", "title", "body"):
         if not story.get(k):
@@ -60,7 +73,7 @@ def publish(table, story):
         "published_at": int(time.time()),
         "similar": related(story, existing),
     }
-    table.put_item(Item=item)
+    table.put_item(Item=dynamo_safe(item))
     log.info("publish slug=%s similar=%d stored", item["slug"], len(item["similar"]))
     return item
 
