t in REVOKED:\n                return self.reply(200, [{\"id\": \"2026-10-27\", \"hrv\": 60}])\n            return self.reply(401, {\"error\": \"unauthorized\"})\n        if u.path == \"/_revoke\":\n            REVOKED.update(ACCESS); return self.reply(200, {\"revoked\": True})\n        self.reply(404, {\"error\": \"nf\"})\n    def do_POST(self):\n        n = int(self.headers.get(\"Content-Length\", 0))\n        f = dict(urllib.parse.parse_qsl(self.rfile.read(n).decode()))\n        print(\"[mock] token form fields:\", sorted(f), flush=True)\n        if f.get(\"grant_type\") == \"refresh_token\":\n            return self.reply(400, {\"error\": \"invalid_grant\"})\n        if f.get(\"client_id\") and f.get(\"client_secret\") and f.get(\"code\"):\n            return self.reply(200, {\"token_type\": \"bearer\", \"access_token\": \"tok_1\",\n                                    \"scope\": \"ACTIVITY:WRITE,WELLNESS:READ,CALENDAR:WRITE\",\n                                    \"athlete\": {\"id\": \"i98765\", \"name\": \"T. Rivera\"}})\n        self.reply(400, {\"error\": \"invalid_request\"})\nhttp.server.ThreadingHTTPServer((\"127.0.0.1\", PORT), H).serve_forever()\nEOF\n(python3 mock_intervals.py 9999 > mock.log 2>&1 &) ; sleep 1; curl -s -o /dev/null -w '%{http_code}\\n' http://127.0.0.1:9999/_revoke; curl -s -o /dev/null -w '%{http_code}\\n' http://127.0.0.1:9999/_revoke","description":"Set up scratch baseline copy and local mock Intervals"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":8870,"cache_read_input_tokens":23832,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":8870},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"1fb927fd-060b-4dca-ba58-87421c200a5e","uuid":"0d315123-