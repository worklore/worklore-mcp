{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nfrom pathlib import Path\nfrom tempfile import TemporaryDirectory\nimport os, subprocess\nroot = Path.cwd()\nwith TemporaryDirectory(prefix='.nightly-test.', dir=root) as tmp:\n    base = Path(tmp)\n    home = base / 'home'\n    for path in ('projects/shop', 'Library/Logs', 'bin'):\n        (home / path).mkdir(parents=True)\n    mockbin = base / 'mockbin'\n    mockbin.mkdir()\n    notify = home / 'bin/notify.sh'\n    notify.write_text('#\"'!/bin/sh'\"\\\\nprintf \\\"%s\\\\\\\\n\\\" \\\"\"'$1\" >> \"$HOME/messages\"'\"\\\\n')\n    notify.chmod(0o755)\n    claude = mockbin / 'claude'\n    claude.write_text('''#\"'!/bin/sh\n[ \"$1\" = '\"'-p' ] || exit 99\n[ \\\"\"'$3\" = '\"'--output-format' ] || exit 98\n[ \\\"\"'$4\" = '\"'text' ] || exit 97\n[ \"'! -t 0 ] || exit 96\ncase \"$CASE\" in\n  fail) echo '\"'Not logged in' >&2; exit 7 ;;\n  empty) exit 0 ;;\n  success) printf '%s\\\\\\\\n' 'Reviewed commit abc: no issue' ;;\nesac\n''')\n    claude.chmod(0o755)\n    for scenario in ('fail', 'empty', 'success'):\n        (home / 'messages').write_text('')\n        env = os.environ | {'HOME': str(home), 'PATH': f'{mockbin}:{os.environ[\\\"PATH\\\"]}', 'CASE': scenario}\n        result = subprocess.run(['/bin/zsh', str(root / 'bin/nightly-review.zsh')], cwd=root, env=env, capture_output=True, text=True)\n        print(f'{scenario}: exit={result.returncode}; message={(home / \\\"messages\\\").read_text().strip()}; stderr={result.stderr.strip()}')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
