eat\"],\n                \"steps\": [build_step(s) for s in block[\"steps\"]],\n            })\n        else:\n            steps.append(build_step(block))\n    return {\"steps\": steps}\n\n\ndef build_event(plan):\n    return {\n        \"category\": \"WORKOUT\",\n        \"type\": plan[\"sport\"],\n        \"name\": plan[\"name\"],\n        \"start_date_local\": plan[\"date\"] + \"T00:00:00\",\n        \"workout_doc\": build_doc(plan),\n    }\n\n\nif __name__ == \"__main__\":\n    with open(sys.argv[1]) as f:\n        plan = json.load(f)\n    json.dump(build_event(plan), sys.stdout, indent=2)\n    print()\n","structuredPatch":[{"oldStart":8,"oldLines":9,"newStart":8,"newLines":15,"lines":[" "," "," def hr_target(step):","-    \"\"\"HR corridor for a step, as a percentage of the athlete's LTHR.\"\"\"","+    \"\"\"HR corridor for a step, as a percentage of the athlete's LTHR.","+","+    The lower bound must be keyed \"start\", not \"value\": with \"value\" the FIT","+    export treats the target as a lap-HR zone target and the watch clamps it","+    to its own zones. \"start\"/\"end\" gives an instant-HR corridor, which the","+    watch shows as the raw bpm Intervals computed from its stored LTHR.","+    \"\"\"","     lo, hi = step[\"hr_pct\"]","-    return {\"units\": \"%lthr\", \"value\": lo, \"end\": hi}","+    return {\"units\": \"%lthr\", \"start\": lo, \"end\": hi}"," "," "," def build_step(step):"]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_01FxrAttBNjrEY6UEC8SsQrk","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
