 log = logging.getLogger("stories")
 
@@ -40,6 +41,22 @@ def related(story, existing):
     return scored[:TOP_N]
 
 
+def to_dynamo(value):
+    """Return ``value`` with every float replaced by ``Decimal``.
+
+    DynamoDB rejects Python floats. Converting through ``str`` keeps the
+    decimal digits (``Decimal(0.1)`` would carry binary noise). Applied at the
+    write boundary, so any float computed anywhere in an item is covered.
+    """
+    if isinstance(value, float):
+        return Decimal(str(value))
+    if isinstance(value, dict):
+        return {k: to_dynamo(v) for k, v in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [to_dynamo(v) for v in value]
+    return value
+
+
 def validate(story):
     for k in ("slug", "title", "body"):
         if not story.get(k):
@@ -60,7 +77,7 @@ def publish(table, story):
         "published_at": int(time.time()),
         "similar": related(story, existing),
     }
-    table.put_item(Item=item)
+    table.put_item(Item=to_dynamo(item))
     log.info("publish slug=%s similar=%d stored", item["slug"], len(item["similar"]))
     return item
 
