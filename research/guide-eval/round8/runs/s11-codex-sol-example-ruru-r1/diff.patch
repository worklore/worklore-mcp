+def dynamodb_safe(value):
+    """Convert computed floats, including nested ones, before a DynamoDB write."""
+    if isinstance(value, float):
+        if not math.isfinite(value):
+            raise ValueError("non-finite number cannot be stored in DynamoDB")
+        return Decimal(str(value))
+    if isinstance(value, dict):
+        return {key: dynamodb_safe(item) for key, item in value.items()}
+    if isinstance(value, list):
+        return [dynamodb_safe(item) for item in value]
+    if isinstance(value, tuple):
+        return tuple(dynamodb_safe(item) for item in value)
+    if isinstance(value, (set, frozenset)):
+        return type(value)(dynamodb_safe(item) for item in value)
+    return value
+
+
 def publish(table, story):
     """Store ``story`` with its related stories. Returns the stored item."""
     validate(story)
     existing = table.scan(TableName=TABLE_NAME).get("Items", [])
