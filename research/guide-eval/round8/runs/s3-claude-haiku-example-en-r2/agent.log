CE.\nFor each commit: one line on what it changes and whether anything looks risky\n(migrations, auth, payments, deleted tests).\nEnd with a three-line summary I can read on my phone.\nDo not modify any file.\"\n\ncd \"$REPO\" || { \"$NOTIFY\" \"nightly review: repo missing\"; exit 1; }\n\nclaude -p \"$PROMPT\" --output-format text > \"$OUT\"\nstatus=$?\n\nif [ $status -ne 0 ]; then\n  \"$NOTIFY\" \"nightly review FAILED (exit $status), see $OUT\"\n  exit $status\nfi\n\n\"$NOTIFY\" \"nightly review done: $(head -c 300 \"$OUT\")\"\n","structuredPatch":[{"oldStart":13,"oldLines":14,"newStart":13,"newLines":23,"lines":[" End with a three-line summary I can read on my phone."," Do not modify any file.\""," ","+START=$SECONDS","+echo \"$(date '+%F %T') nightly review start\"","+"," cd \"$REPO\" || { \"$NOTIFY\" \"nightly review: repo missing\"; exit 1; }"," ","-claude -p \"$PROMPT\" --output-format text > \"$OUT\"","-status=$?","+# zsh treats `status` as a read-only variable: assigning to it kills the script,","+# so the notifier below never ran. Use `rc`.","+# </dev/null: the prompt is an argument, so claude must not wait on stdin.","+claude -p \"$PROMPT\" --output-format text > \"$OUT\" < /dev/null","+rc=$?","+echo \"$(date '+%F %T') claude exited $rc after $((SECONDS - START))s\""," ","-if [ $status -ne 0 ]; then","-  \"$NOTIFY\" \"nightly review FAILED (exit $status), see $OUT\"","-  exit $status","+# exit 0 with no output is still a failure: nothing was reviewed.","+if [ $rc -ne 0 ] || [ ! -s \"$OUT\" ]; then","+  \"$NOTIFY\" \"nightly review FAILED (exit $rc), see $OUT\"","+  exit 1"," fi"," "," \"$NOTIFY\" \"nightly review done: $(head -c 300 \"$OUT\")\"","+echo \"$(date '+%F %T') nightly review done in $((SECONDS - START))s\""]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_01LSE2o97mdL6BwsbT8YdB3d","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
