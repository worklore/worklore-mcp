+from decimal import Decimal
 
 log = logging.getLogger("stories")
 
@@ -30,6 +31,22 @@ def similarity(a, b):
     return round(0.7 * tag_score + 0.3 * word_score, 4)
 
 
+def to_dynamo(value):
+    """Make ``value`` storable by boto3: DynamoDB has no float type.
+
+    Every float anywhere in the item becomes a Decimal. ``str()`` first, so
+    0.1 becomes Decimal("0.1"), not the 55-digit binary expansion that
+    DynamoDB rejects (it keeps at most 38 significant digits).
+    """
+    if isinstance(value, float):
+        return Decimal(str(value))
+    if isinstance(value, dict):
+        return {k: to_dynamo(v) for k, v in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [to_dynamo(v) for v in value]
+    return value
+
+
 def related(story, existing):
     scored = []
     for other in existing:
@@ -60,6 +77,7 @@ def publish(table, story):
         "published_at": int(time.time()),
         "similar": related(story, existing),
     }
+    item = to_dynamo(item)
     table.put_item(Item=item)
     log.info("publish slug=%s similar=%d stored", item["slug"], len(item["similar"]))
     return item
