 log = logging.getLogger("stories")
 
@@ -27,7 +28,9 @@ def similarity(a, b):
     tag_score = len(ta & tb) / len(ta | tb) if (ta | tb) else 0
     wa, wb = words(a.get("body")), words(b.get("body"))
     word_score = len(wa & wb) / len(wa | wb) if (wa | wb) else 0
-    return round(0.7 * tag_score + 0.3 * word_score, 4)
+    # DynamoDB (boto3) rejects Python floats, and this score is stored in the
+    # item, so return it as a Decimal rather than a float.
+    return Decimal(str(round(0.7 * tag_score + 0.3 * word_score, 4)))
 
 
 def related(story, existing):
@@ -40,12 +43,30 @@ def related(story, existing):
     return scored[:TOP_N]
 
 
+def to_dynamo(value):
+    """Return ``value`` with every float converted to Decimal, recursively.
+
+    boto3 refuses floats anywhere in an item, so this is applied to every item
+    right before ``put_item``; a float added to the item later can't 500.
+    """
+    if isinstance(value, float):
+        return Decimal(str(value))
+    if isinstance(value, dict):
+        return {k: to_dynamo(v) for k, v in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [to_dynamo(v) for v in value]
+    return value
+
+
 def validate(story):
     for k in ("slug", "title", "body"):
         if not story.get(k):
             raise ValueError(f"missing field: {k}")
     if not re.fullmatch(r"[a-z0-9-]{3,80}", story["slug"]):
         raise ValueError("bad slug")
+    tags = story.get("tags", [])
+    if not isinstance(tags, list) or not all(isinstance(t, str) for t in tags):
+        raise ValueError("tags must be a list of strings")
 
 
 def publish(table, story):
@@ -60,6 +81,7 @@ def publish(table, story):
         "published_at": int(time.time()),
         "similar": related(story, existing),
     }
+    item = to_dynamo(item)
     table.put_item(Item=item)
     log.info("publish slug=%s similar=%d stored", item["slug"], len(item["similar"]))
     return item
