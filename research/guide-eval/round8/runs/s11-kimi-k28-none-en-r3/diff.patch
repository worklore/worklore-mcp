@@ -8,6 +8,7 @@ import json
 import logging
 import re
 import time
+from decimal import Decimal, ROUND_HALF_UP
 
 log = logging.getLogger("stories")
 
@@ -22,12 +23,17 @@ def words(text):
 
 
 def similarity(a, b):
-    """Shared-tag ratio (Jaccard), blended with shared words of the two bodies."""
+    """Shared-tag ratio (Jaccard), blended with shared words of the two bodies.
+
+    Returns a Decimal: DynamoDB items cannot contain floats, and these scores
+    are stored on the item in ``similar``.
+    """
     ta, tb = set(a.get("tags", [])), set(b.get("tags", []))
-    tag_score = len(ta & tb) / len(ta | tb) if (ta | tb) else 0
+    tag_score = Decimal(len(ta & tb)) / len(ta | tb) if (ta | tb) else Decimal(0)
     wa, wb = words(a.get("body")), words(b.get("body"))
-    word_score = len(wa & wb) / len(wa | wb) if (wa | wb) else 0
-    return round(0.7 * tag_score + 0.3 * word_score, 4)
+    word_score = Decimal(len(wa & wb)) / len(wa | wb) if (wa | wb) else Decimal(0)
+    blend = Decimal("0.7") * tag_score + Decimal("0.3") * word_score
+    return blend.quantize(Decimal("0.0001"), rounding=ROUND_HALF_UP)
 
 
