{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NqxLCPe3VAv3euwBi5SE1b","type":"tool_result","content":"\"\"\"Story library: the publish handler.\n\nEach story is stored in one DynamoDB item together with the three most similar\nstories already in the library (``similar``), so the reader page can show\n\"related\" without a query at read time.\n\"\"\"\nimport json\nimport logging\nimport re\nimport time\n\nlog = logging.getLogger(\"stories\")\n\nTABLE_NAME = \"stories\"\nTOP_N = 3\n\n_WORD = re.compile(r\"[a-z0-9]+\")\n\n\ndef words(text):\n    return set(_WORD.findall((text or \"\").lower()))\n\n\ndef similarity(a, b):\n    \"\"\"Shared-tag ratio (Jaccard), blended with shared words of the two bodies.\"\"\"\n    ta, tb = set(a.get(\"tags\", [])), set(b.get(\"tags\", []))\n    tag_score = len(ta & tb) / len(ta | tb) if (ta | tb) else 0\n    wa, wb = words(a.get(\"body\")), words(b.get(\"body\"))\n    word_score = len(wa & wb) / len(wa | wb) if (wa | wb) else 0\n    return round(0.7 * tag_score + 0.3 * word_score, 4)\n\n\ndef related(story, existing):\n    scored = []\n    for other in existing:\n        if other[\"slug\"] == story[\"slug\"]:\n            continue\n        scored.append({\"slug\": other[\"slug\"], \"score\": similarity(story, other)})\n    scored.sort(key=lambda s: s[\"score\"], reverse=True)\n    return scored[:TOP_N]\n\n\ndef validate(story):\n    for k in (\"slug\", \"title\", \"body\"):\n        if not story.get(k):\n            raise ValueError(f\"missing field: {k}\")\n    if not re.fullmatch(r\"[a-z0-9-]{3,80}\", story[\"slug\"]):\n        raise ValueError(\"bad slug\")\n\n\ndef publish(table, story):\n    \"\"\"Store ``story`` with its related stories. Returns the stored item.\"\"\"\n    validate(story)\n    existing = table.scan(TableName=TABLE_NAME).get(\"Items\", [])\n    item = {\n        \"slug\": story[\"slug\"],\n        \"title\": story[\"title\"],\n        \"tags\": sorted(set(story.get(\"tags\", []))),\n        \"body\": story[\"body\"],\n        \"published_at\": int(time.time()),\n        \"similar\": related(story, existing),\n    }\n    table.put_item(Item=item)\n    log.info(\"publish slug=%s similar=%d stored\", item[\"slug\"], len(item[\"similar\"]))\n    return item\n\n\ndef handler(event, table):\n    \"\"\"Lambda-style entry point for POST /stories. Body is the story as JSON.\"\"\"\n    try:\n        story = json.loads(event.get(\"body\") or \"{}\")\n        stored = publish(table, story)\n        return {\"statusCode\": 201, \"body\": json.dumps({\"slug\": stored[\"slug\"]})}\n    except ValueError as e:\n        return {\"statusCode\": 400, \"body\": json.dumps({\"error\": str(e)})}\n    except Exception:\n        log.exception(\"publish failed\")\n        return {\"statusCode\": 500, \"body\": json.dumps({\"error\": \"Internal Server Error\"})}\n\"\"\"In-memory stand-in for a boto3 DynamoDB Table resource.\n\nIt stores items in a dict and validates values the way boto3's TypeSerializer\ndoes, so a test fails on the same inputs a real table would reject.\n\"\"\"\nfrom decimal import Decimal\n\n\ndef _check(value, path=\"Item\"):\n    if isinstance(value, bool) or value is None or isinstance(value, (int, str, bytes, Decimal)):\n        return\n    if isinstance(value, float):\n        raise TypeError(\"Float types are not supported. Use Decimal types instead.\")\n    if isinstance(value, dict):\n        for k, v in value.items():\n            _check(v, f\"{path}.{k}\")\n        return\n    if isinstance(value, (list, tuple, set, frozenset)):\n        for i, v in enumerate(value):\n            _check(v, f\"{path}[{i}]\")\n        return\n    raise TypeError(f\"Unsupported type {type(value)!r} for value at {path}\")\n\n\nclass FakeTable:\n    def __init__(self, key=\"slug\"):\n        self.key = key\n        self.items = {}\n\n    def put_item(self, Item, **kwargs):\n        _check(Item)\n        if self.key not in Item:\n            raise ValueError(f\"item is missing the key attribute {self.key!r}\")\n        self.items[Item[self.key]] = dict(Item)\n        return {\"ResponseMetadata\": {\"HTTPStatusCode\": 200}}\n\n    def get_item(self, Key, **kwargs):\n        item = self.items.get(Key[self.key])\n        return {\"Item\": dict(item)} if item is not None else {}\n\n    def scan(self, **kwargs):\n        return {\"Items\": [dict(v) for v in self.items.values()], \"Count\": len(self.items)}\nimport os\nimport sys\nimport unittest\n\nsys.path.insert(0, os.path.join(os.path.dirname(__file__), \"..\", \"src\"))\nsys.path.insert(0, os.path.dirname(__file__))\n\nimport app  # noqa: E402\nfrom fake_dynamo import FakeTable  # noqa: E402\n\n\nclass PublishTest(unittest.TestCase):\n    def test_publish_stores_story(self):\n        table = FakeTable()\n        story = {\n            \"slug\": \"why-my-cron-ran-twice\",\n            \"title\": \"Why my cron ran twice\",\n            \"tags\": [\"cron\", \"linux\"],\n            \"body\": \"Two crontabs, one for root and one for me, both had the line.\",\n        }\n        stored = app.publish(table, story)\n        self.assertEqual(stored[\"slug\"], \"why-my-cron-ran-twice\")\n        self.assertEqual(table.get_item(Key={\"slug\": \"why-my-cron-ran-twice\"})[\"Item\"][\"title\"], \"Why my cron ran twice\")\n        self.assertEqual(table.scan()[\"Count\"], 1)\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n# stories-api\n\nA small story library behind `POST /stories` (Lambda + DynamoDB table `stories`,\npartition key `slug`). `src/app.py` is the whole service: `handler()` parses\nthe request and `publish()` stores the story together with its three most\nsimilar existing stories (`similar: [{slug, score}]`), so the reader page can\nshow \"related\" without any query at read time. `logs/error.log` is the\nproduction log from the first two publishes after the deploy.\n\nTests use an in-memory table (`tests/fake_dynamo.py`) that validates items the\nway boto3 does, so no AWS account is needed. Run them with\n`python3 -m unittest discover tests` from the repo root.\n__pycache__/\n*.pyc","is_error":false}]},"parent_tool_use_id":null,"session_id":"8e2afece-b2a0-4960-86d9-c25e4ebf1d18","uuid":"25d29fdf-de8a-46fc-94ad-49f3d1cf3476","timestamp":"2026-10-27T05:13:16.914Z","tool_use_result":{"stdout":"\"\"\"Story library: the publish handler.\n\nEach story is stored in one DynamoDB item together with the three most similar\nstories already in the library (``similar``), so the reader page can show\n\"related\" without a query at read time.\n\"\"\"\nimport json\nimport logging\nimport re\nimport time\n\nlog = logging.getLogger(\"stories\")\n\nTABLE_NAME = \"stories\"\nTOP_N = 3\n\n_WORD = re.compile(r\"[a-z0-9]+\")\n\n\ndef words(text):\n    return set(_WORD.findall((text or \"\").lower()))\n\n\ndef similarity(a, b):\n    \"\"\"Shared-tag ratio (Jaccard), blended with shared words of the two bodies.\"\"\"\n    ta, tb = set(a.get(\"tags\", [])), set(b.get(\"tags\", []))\n    tag_score = len(ta & tb) / len(ta | tb) if (ta | tb) else 0\n    wa, wb = words(a.get(\"body\")), words(b.get(\"body\"))\n    word_score = len(wa & wb) / len(wa | wb) if (wa | wb) else 0\n    return round(0.7 * tag_score + 0.3 * word_score, 4)\n\n\ndef related(story, existing):\n    scored = []\n    for other in existing:\n        if other[\"slug\"] == story[\"slug\"]:\n            continue\n        scored.append({\"slug\": other[\"slug\"], \"score\": similarity(story, other)})\n    scored.sort(key=lambda s: s[\"score\"], reverse=True)\n    return scored[:TOP_N]\n\n\ndef validate(story):\n    for k in (\"slug\", \"title\", \"body\"):\n        if not story.get(k):\n            raise ValueError(f\"missing field: {k}\")\n    if not re.fullmatch(r\"[a-z0-9-]{3,80}\", story[\"slug\"]):\n        raise ValueError(\"bad slug\")\n\n\ndef publish(table, story):\n    \"\"\"Store ``story`` with its related stories. Returns the stored item.\"\"\"\n    validate(story)\n    existing = ta