{"role":"assistant","content":"Now the token-lifetime fix — `store_connection` and the refresher:","tool_calls":[{"type":"function","id":"tool_EEpuFG604JwMddcICK4CQmxU","function":{"name":"Edit","arguments":"{\"path\":\"server.py\",\"old_string\":\"def store_connection(user_id, tok):\\n    expires_in = int(tok.get(\\\"expires_in\\\") or DEFAULT_TOKEN_TTL)\\n    refresh = tok.get(\\\"refresh_token\\\")\\n    if not refresh:\\n        log(f\\\"{user_id}: no refresh_token in response, scheduling expiry in {expires_in}s\\\")\\n    athlete = tok.get(\\\"athlete\\\") or {}\\n    with LOCK:\\n        CONNECTIONS[user_id] = {\\n            \\\"athlete_id\\\": athlete.get(\\\"id\\\"), \\\"athlete_name\\\": athlete.get(\\\"name\\\"),\\n            \\\"access_token\\\": tok[\\\"access_token\\\"], \\\"refresh_token\\\": refresh,\\n            \\\"scope\\\": tok.get(\\\"scope\\\"), \\\"expires_at\\\": time.time() + expires_in, \\\"status\\\": \\\"connected\\\",\\n        }\\n    log(f\\\"{user_id}: connected as athlete {athlete.get('id')} (expires in {expires_in}s)\\\")\",\"new_string\":\"def store_connection(user_id, tok):\\n    # Intervals.icu reports no expires_in and issues no refresh_token: its\\n    # access tokens do not expire, so a missing expires_in means \\\"no expiry\\\".\\n    # Never invent a TTL — that is what killed connections after an hour.\\n    raw = tok.get(\\\"expires_in\\\")\\n    expires_at = time.time() + int(raw) if raw is not None else None\\n    athlete = tok.get(\\\"athlete\\\") or {}\\n    with LOCK:\\n        CONNECTIONS[user_id] = {\\n            \\\"athlete_id\\\": athlete.get(\\\"id\\\"), \\\"athlete_name\\\": athlete.get(\\\"name\\\"),\\n            \\\"access_token\\\": tok[\\\"access_token\\\"], \\\"refresh_token\\\": tok.get(\\\"refresh_token\\\"),\\n            \\\"scope\\\": tok.get(\\\"scope\\\"), \\\"expires_at\\\": expires_at, \\\"status\\\": \\\"connected\\\",\\n        }\\n    if expires_at is None:\\n        log(f\\\"{user_id}: connected as athlete {athlete.get('id')} (token does not expire)\\\")\\n    else:\\n        log(f\\\"{user_id}: connected as athlete {athlete.get('id')} (expires in {raw}s)\\\")\"}"}}]}
