{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nfrom pathlib import Path\nfrom tempfile import TemporaryDirectory\nimport os, subprocess\nroot = Path.cwd()\nwith TemporaryDirectory(prefix='.nightly-test-', dir=root) as tmp:\n    base = Path(tmp)\n    home = base / 'home'\n    for path in (home / 'projects/shop', home / 'Library/Logs', home / 'bin', base / 'mock'):\n        path.mkdir(parents=True, exist_ok=True)\n    notifier = home / 'bin/notify.sh'\n    notifier.write_text('#\"'!/bin/sh'\"\\\\nprintf \\\"%s\\\\\\\\n\\\" \\\"\"'$1\" >> \"$HOME/notifications\"'\"\\\\n')\n    agent = base / 'mock/claude'\n    agent.write_text('''#\"'!/bin/sh\n[ \"$(cat | wc -c | tr -d '\"' ')\\\" = 0 ] || exit 9\ncase \\\"\"'$TEST_CASE\" in\n  failed) echo '\"'Not logged in' >&2; exit 7 ;;\n  empty) exit 0 ;;\n  success) printf 'Reviewed two commits.\\\\\\\\n'; exit 0 ;;\nesac\n''')\n    notifier.chmod(0o755)\n    agent.chmod(0o755)\n    for case, expected_rc, expected_message in (\n        ('failed', 7, 'FAILED (exit 7)'),\n        ('empty', 1, 'FAILED (empty summary)'),\n        ('success', 0, 'done: Reviewed two commits.'),\n    ):\n        env = dict(os.environ, HOME=str(home), PATH=f\\\"{base / 'mock'}:{os.environ['PATH']}\\\", TEST_CASE=case)\n        run = subprocess.run(['/bin/zsh', str(root / 'bin/nightly-review.zsh')], env=env, capture_output=True, text=True)\n        message = (home / 'notifications').read_text().splitlines()[-1]\n        assert run.returncode == expected_rc, (case, run.returncode, run.stderr)\n        assert expected_message in message, (case, message)\n        print(f'{case}: exit={run.returncode}; notification={message}')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
