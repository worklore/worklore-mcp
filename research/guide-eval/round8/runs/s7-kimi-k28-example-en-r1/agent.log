ib.parse.quote(expired)}\\\")\\n        check(\\\"callback with expired state rejected\\\", s == 400, str(s))\\n\\n        s, h, _ = flow(\\\"tok-okafor\\\", \\\"code-okafor-1\\\")\\n        check(\\\"callback connects (302)\\\", s == 302 and h.get(\\\"Location\\\") == \\\"/?connected=1\\\", f\\\"{s} {h.get('Location')}\\\")\\n\\n        s, _, body = req(\\\"GET\\\", \\\"/api/intervals/status\\\", token=\\\"tok-okafor\\\")\\n        check(\\\"status connected as i12345\\\", s == 200 and body.get(\\\"connected\\\") and body[\\\"athlete\\\"][\\\"id\\\"] == \\\"i12345\\\", str(body))\\n\\n        s, _, body = req(\\\"GET\\\", \\\"/api/intervals/wellness\\\", token=\\\"tok-okafor\\\")\\n        check(\\\"wellness proxy works\\\", s == 200 and body[0][\\\"athlete_id\\\"] == \\\"i12345\\\", str(body))\\n\\n        # reconnect flow returning a DIFFERENT athlete -> guard must reject, keep old connection\\n        s, _, body = flow(\\\"tok-okafor\\\", \\\"code-okafor-2\\\")\\n        check(\\\"account mismatch rejected with 409\\\", s == 409 and \\\"mismatch\\\" in body.get(\\\"error\\\", \\\"\\\"), f\\\"{s} {body}\\\")\\n        s, _, body = req(\\\"GET\\\", \\\"/api/intervals/status\\\", token=\\\"tok-okafor\\\")\\n        check(\\\"original connection untouched after mismatch\\\", body.get(\\\"connected\\\") and body[\\\"athlete\\\"][\\\"id\\\"] == \\\"i12345\\\")\\n\\n        # same athlete again -> allowed\\n        s, _, _ = flow(\\\"tok-okafor\\\", \\\"code-okafor-1\\\")\\n        check(\\\"reconnect with same athlete allowed\\\", s == 302, str(s))\\n\\n        # token exchange requests seen by the fake: exactly the three fields\\n        check(\\\"exchange sends only client_id/secret/code\\\",\\n              all(set(f) == {\\\"client_id\\\", \\\"client_secret\\\", \\\"code\\\"} for f in EXCHANGE_FIELDS),\\n              str(EXCHANGE_FIELDS))\\n\\n        # simulate athlete revoking the app at Intervals -> next API call 401s\\n        REVOKED.update(t for t in VALID_