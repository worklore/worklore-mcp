ts.append('Trains for a marathon in October')   # in-memory only, what save_fact does before save_athlete\nafter = bot.build_system(a, today)\nassert before[0] == after[0], 'static block changed'\nassert before[1] != after[1], 'context should reflect the new fact'\nassert 'cache_control' in before[0] and 'cache_control' not in before[1]\nassert after[1]['text'].count('Trains for a marathon') == 1\nprint('static block identical across save_fact: OK')\nprint('next day, same facts -> static still identical:', bot.build_system(a, dt.date(2026,4,19))[0] == after[0])\nprint('markers:', [('cache_control' in b) for b in after])\n\" && git diff --stat","description":"Verify static block is stable across save_fact and day change"}},"wire_ingest_context":{"toolu_01Dqdttr5yRC619DTtpjzNqg":{"cwd":"/private/tmp/h-T7vHgu"}}}
