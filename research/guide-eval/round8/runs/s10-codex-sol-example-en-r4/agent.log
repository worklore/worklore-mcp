           const SizedBox(height: 12),\n             TextField(\n               controller: _phone,\n               keyboardType: TextInputType.phone,\n               decoration: const InputDecoration(labelText: 'Phone'),\n-              onChanged: (_) => setState(() {}),\n+              onChanged: (_) {\n+                if (!_phoneStarted) {\n+                  _phoneStarted = true;\n+                  Analytics.capture('registration_phone_started');\n+                }\n+                setState(() {});\n+              },\n             ),\n             const SizedBox(height: 24),\n             Text('Loan amount: ${_amount.round()}'),\n@@ -54,17 +70,33 @@ class _RegistrationScreenState extends State<RegistrationScreen> {\n               value: _amount,\n               label: _amount.round().toString(),\n               onChanged: (v) => setState(() => _amount = v),\n+              onChangeEnd: (v) => Analytics.capture(\n+                'loan_amount_changed',\n+                {'amount': v.round()},\n+              ),\n             ),\n             CheckboxListTile(\n               value: _terms,\n               title: const Text('I accept the terms and conditions'),\n               controlAffinity: ListTileControlAffinity.leading,\n-              onChanged: (v) => setState(() => _terms = v ?? false),\n+              onChanged: (v) {\n+                final accepted = v ?? false;\n+                if (accepted && !_terms) {\n+                  Analytics.capture('terms_accepted');\n+                }\n+                setState(() => _terms = accepted);\n+              },\n             ),\n             const Spacer(),\n             FilledButton(\n               onPressed: _canContinue\n-                  ? () => Navigator.of(context).pushNamed('/offers')\n+                  ? () {\n+                      Analytics.capture('registration_continue_tapped', {\n+                        'amount': _amount.round(),\n+                        'terms': _terms,\n+               