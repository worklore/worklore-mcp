,\n  \"type\": \"Run\",\n  \"name\": \"Tempo run 45\",\n  \"start_date_local\": \"2026-10-20T00:00:00\",\n  \"workout_doc\": {\n    \"steps\": [\n      {\n        \"duration\": 600,\n        \"hr\": {\n          \"units\": \"%lthr\",\n          \"value\": 68,\n          \"end\": 75\n        },\n        \"text\": \"Warm-up easy\"\n      },\n      {\n        \"reps\": 3,\n        \"steps\": [\n          {\n            \"duration\": 480,\n            \"hr\": {\n              \"units\": \"%lthr\",\n              \"value\": 88,\n              \"end\": 93\n            },\n            \"text\": \"Tempo\"\n          },\n          {\n            \"duration\": 120,\n            \"hr\": {\n              \"units\": \"%lthr\",\n              \"value\": 75,\n              \"end\": 82\n            },\n            \"text\": \"Float\"\n          }\n        ]\n      },\n      {\n        \"duration\": 300,\n        \"hr\": {\n          \"units\": \"%lthr\",\n          \"value\": 65,\n          \"end\": 72\n        },\n        \"text\": \"Cool-down\"\n      }\n    ]\n  }\n}\n2d2bb9a base\n","exit_code":0,"status":"completed"}}
