{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc 'cat readback/event-184233-as-sent.json && cat push.sh && git log --oneline -5'","aggregated_output":"{\n  \"category\": \"WORKOUT\",\n  \"type\": \"Run\",\n  \"name\": \"Tempo run 45\",\n  \"start_date_local\": \"2026-10-20T00:00:00\",\n  \"workout_doc\": {\n    \"steps\": [\n      {\n        \"duration\": 600,\n        \"hr\": {\n          \"units\": \"%lthr\",\n          \"value\": 68,\n          \"end\": 75\n        },\n        \"text\": \"Warm-up easy\"\n      },\n      {\n        \"reps\": 3,\n        \"steps\": [\n          {\n            \"duration\": 480,\n            \"hr\": {\n              \"units\": \"%lthr\",\n              \"value\": 88,\n              \"end\": 93\n            },\n            \"text\": \"Tempo\"\n          },\n          {\n            \"duration\": 120,\n            \"hr\": {\n              \"units\": \"%lthr\",\n              \"value\": 75,\n              \"end\": 82\n            },\n            \"text\": \"Float\"\n          }\n        ]\n      },\n      {\n        \"duration\": 300,\n        \"hr\": {\n          \"units\": \"%lthr\",\n          \"value\": 65,\n          \"end\": 72\n        },\n        \"text\": \"Cool-down\"\n      }\n    ]\n  }\n}\n#!/usr/bin/env bash\n# usage: ./push.sh event.json   (needs INTERVALS_API_KEY and ATHLETE_ID)\nset -eu\ncurl -sS -u \"API_KEY:${INTERVALS_API_KEY}\" -H 'Content-Type: application/json' \\\n  -X POST \"https://intervals.icu/api/v1/athlete/${ATHLETE_ID}/events\" \\\n  --data-binary @\"$1\"\n951a7f7 base\n","exit_code":0,"status":"completed"}}
