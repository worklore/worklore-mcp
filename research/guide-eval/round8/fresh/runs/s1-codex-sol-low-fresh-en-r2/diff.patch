+def describe_step(step):
+    """Emit a step in Intervals.icu's workout description grammar."""
+    target = ""
+    if "hr_pct" in step:
+        lo, hi = step["hr_pct"]
+        target = f" {lo}-{hi}% LTHR"
+    label = f"{step['label']} " if step.get("label") else ""
+    return f"- {label}{step['minutes']}m{target}"
+
+
+def build_description(plan):
+    blocks = []
+    for block in plan["steps"]:
+        if "repeat" in block:
+            blocks.append("\n".join(
+                [f"{block['repeat']}x"] +
+                [describe_step(step) for step in block["steps"]]
+            ))
+        else:
+            blocks.append(describe_step(block))
+    return "\n\n".join(blocks)
 
 
