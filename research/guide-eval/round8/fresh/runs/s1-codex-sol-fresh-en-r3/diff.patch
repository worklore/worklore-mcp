+def description_step(step):
+    """Emit Intervals' workout text so its exporter parses the same HR range."""
+    parts = ["-", step.get("label", ""), f'{step["minutes"]}m']
+    if "hr_pct" in step:
+        lo, hi = step["hr_pct"]
+        parts.extend((f"{lo}-{hi}% LTHR", "hr=1s"))
+    return " ".join(part for part in parts if part)
+
+
+def build_description(plan):
+    blocks = []
+    for block in plan["steps"]:
+        if "repeat" in block:
+            blocks.append("\n".join([f'{block["repeat"]}x'] + [
+                description_step(step) for step in block["steps"]
+            ]))
+        else:
+            blocks.append(description_step(block))
+    return "\n\n".join(blocks)
 
 
