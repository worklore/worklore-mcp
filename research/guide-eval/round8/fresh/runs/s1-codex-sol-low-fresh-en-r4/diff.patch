+def description_step(step):
+    label = step.get("label", "")
+    minutes = step["minutes"]
+    duration = f"{minutes}m"
+    target = ""
+    if "hr_pct" in step:
+        lo, hi = step["hr_pct"]
+        target = f" {lo}-{hi}% LTHR hr=1s"
+    return f"- {' '.join(part for part in (label, duration) if part)}{target}"
+
+
+def build_description(plan):
+    blocks = []
+    for block in plan["steps"]:
+        if "repeat" in block:
+            blocks.append("\n".join([f'{block["repeat"]}x',
+                                     *(description_step(s) for s in block["steps"])]))
+        else:
+            blocks.append(description_step(block))
+    return "\n\n".join(blocks)
 
 
