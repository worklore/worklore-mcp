{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc 'python3 gen.py plans/tempo-run.json'","aggregated_output":"{\n  \"category\": \"WORKOUT\",\n  \"type\": \"Run\",\n  \"name\": \"Tempo run 45\",\n  \"start_date_local\": \"2026-10-20T00:00:00\",\n  \"description\": \"- Warm-up easy 10m 68-75% LTHR hr=1s\\n\\n3x\\n- Tempo 8m 88-93% LTHR hr=1s\\n- Float 2m 75-82% LTHR hr=1s\\n\\n- Cool-down 5m 65-72% LTHR hr=1s\",\n  \"workout_doc\": {\n    \"target\": \"HR\",\n    \"steps\": [\n      {\n        \"duration\": 600,\n        \"hr\": {\n          \"units\": \"%lthr\",\n          \"start\": 68,\n          \"end\": 75\n        },\n        \"text\": \"Warm-up easy\"\n      },\n      {\n        \"reps\": 3,\n        \"steps\": [\n          {\n            \"duration\": 480,\n            \"hr\": {\n              \"units\": \"%lthr\",\n              \"start\": 88,\n              \"end\": 93\n            },\n            \"text\": \"Tempo\"\n          },\n          {\n            \"duration\": 120,\n            \"hr\": {\n              \"units\": \"%lthr\",\n              \"start\": 75,\n              \"end\": 82\n            },\n            \"text\": \"Float\"\n          }\n        ]\n      },\n      {\n        \"duration\": 300,\n        \"hr\": {\n          \"units\": \"%lthr\",\n          \"start\": 65,\n          \"end\": 72\n        },\n        \"text\": \"Cool-down\"\n      }\n    ]\n  }\n}\n","exit_code":0,"status":"completed"}}
