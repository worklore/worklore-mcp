\\s]+/|/home/[^/\\s]+/|\"\r\n161:     r\"/etc/|/Library/)\", re.I)\r\n162: # The agent's drop-in skills directory: installing a skill *into* it is the\r\n163: # standard, documented way skills are added — structurally distinct from\r\n164: # editing existing agent config/startup (CLAUDE.md, settings.json, shell rc).\r\n165: SKILLS_DIR = re.compile(r\"(?:\\.claude|\\.codex|\\.cursor)/skills/\", re.I)\r\n166: # A genuine outbound call. curl/wget count only alongside a URL (so prose like\r\n167: # \"auto-curl\" doesn't match); code HTTP clients count on their own.\r\n168: SHELL_FETCH = re.compile(r\"(?\u003c![\\w-])(?:curl|wget)\\b\", re.I)\r\n169: CODE_CALL = re.compile(\r\n170:     r\"\\b(?:fetch\\(|requests\\.(?:get|post|put|delete|request|head)|\"\r\n171:     r\"urllib|urlopen|httpx?\\.|http\\.client|axios|XMLHttpRequest|Net::HTTP|\"\r\n172:     r\"WebClient|HttpClient|Invoke-WebRequest|iwr)\\b\", re.I)\r\n173: # A real file-write via an explicit API/command. Deliberately excludes bare\r\n174: # '\u003e'/'\u003e' redirects — they collide with markdown blockquotes (\"\u003e text\") and\r\n175: # type arrows (\"-\u003e T\"); an append to a config file is still caught by\r\n176: # WRITE_CTX above.\r\n177: FILE_WRITE = re.compile(\r\n178:     r\"(?:open\\([^)]*['\\\"][wa]\\+?['\\\"]|write_text|writeFile|fs\\.write(?:File|Sync)?|\"\r\n179:     r\"\\btee\\s|\\bsed\\s+-i|Add-Content|Set-Content|\\brm\\s+-|\\bmv\\s+[~./\\w]|\"\r\n180:     r\"\\bcp\\s+[~./\\w])\", re.I)\r\n181: \r\n182: SEV_RANK = {\"info\": 0, \"local\": 1, \"network\": 2, \"elevated\": 3, \"opaque\": 4}\r\n183: TIER_OF_SEV = {0: \"T0\", 1: \"T1\", 2: \"T2\", 3: \"T3\", 4: \"T4\"}\r\n184: TIER_LABEL = {\r\n185:     \"T0\": \"Inert — no scanned capability strings; instructional text only\",\r\n186:     \"T1\": \"Local — runs bundled code / writes files, no network\",\r\n187:     \"T2\": \"Network — makes outbound calls (endpoints listed)\",\r\n188:     \"T3\": \"Elevated — persistence, secrets, privilege, or destructive actions\",\r\n189:     \"T4\": \"Opaque — fetches/decodes code at runtime; cannot be statically reviewed\",\r\n190: }\r\n191: \r\n192: \r\n193: @dataclass\r\n194: class Finding:\r\n195:     category: str\r\n196:     severity: str\r\n197:     why: str\r\n198:     file: str\r\n199:     line: int\r\n200:     evidence: str\r\n201:     # Which detection backend produced this. skill-xray does not compete on\r\n202:     # detection — it is a disclosure + provenance layer, and an external\r\n203:     # scanner (e.g. claude-skill-antivirus, snyk) can feed findings in as\r\n204:     # another backend. See docs/backends.md for the adapter contract; the\r\n205:     # severity a backend reports is mapped onto our tiers, and its own\r\n206:     # \"safe / do not install\" verdict is deliberately dropped.\r\n207:     backend: str = \"builtin\"\r\n208: \r\n209: \r\n210: @dataclass\r\n211: class Report:\r\n212:     artifact: str\r\n213:     sha256: str\r\n214:     files_scanned: int\r\n215:     tier: str\r\n216:     tier_label: str\r\n217:     backends: list[str] = field(default_factory=lambda: [\"builtin\"])\r\n218:     endpoints: list[str] = field(default_factory=list)\r\n219:     findings: list[dict] = field(default_factory=list)\r\n220:     # Behavioral red flags found in the TEXT (prompt-injection / deception /\r\n"}}}
