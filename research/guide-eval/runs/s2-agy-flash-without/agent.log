{"event":"step_update","step_update":{"conversation_id":"87c10415-c3ac-4cc7-b659-56d319aac03a","step_index":32,"state":"DONE","step_type":"tool","tool_name":"run_command","duration_seconds":0.111463,"tool_info":{"name":"run_command","parameters":{"CommandLine":"git log -p -n 5"},"output":"\u003ctruncated 1 lines\u003e\n+        \"stats\": {\"views\": 37, \"rating\": 4.5, \"revisions\": [1, 2, 3]},\r\n+        \"tags\": [\"work\", \"q4\"],\r\n+    },\r\n+    \"n2\": {\r\n+        \"id\": \"n2\",\r\n+        \"title\": \"Groceries\",\r\n+        \"word_count\": 18,\r\n+        \"stats\": {\"views\": 3, \"rating\": 3.0, \"revisions\": [1]},\r\n+        \"tags\": [\"home\"],\r\n+    },\r\n+}\r\n+\r\n+\r\n+def _to_dynamo(value):\r\n+    \"\"\"What boto3's TypeDeserializer does to numbers: Decimal, everywhere.\"\"\"\r\n+    if isinstance(value, bool):\r\r\n+        return value\r\n+    if isinstance(value, (int, float)):\r\n+        return Decimal(str(value))\r\n+    if isinstance(value, dict):\r\n+        return {k: _to_dynamo(v) for k, v in value.items()}\r\n+    if isinstance(value, list):\r\n+        return [_to_dynamo(v) for v in value]\r\n+    return value\r\n+\r\n+\r\n+class DynamoStore:\r\n+    \"\"\"Production store (simulated DynamoDB table).\"\"\"\r\n+\r\n+    def __init__(self, items=None):\r\n+        self._items = copy.deepcopy(items if items is not None else SEED)\r\n+\r\n+    def get(self, note_id):\r\n+        item = self._items.get(note_id)\r\n+        return _to_dynamo(copy.deepcopy(item)) if item is not None else None\r\n+\r\n+    def scan(self):\r\n+        return [_to_dynamo(copy.deepcopy(i)) for i in self._items.values()]\r\n+\r\n+\r\n+class FakeStore:\r\n+    \"\"\"In-memory store for tests.\"\"\"\r\n+\r\n+    def __init__(self, items=None):\r\n+        self._items = copy.deepcopy(items if items is not None else SEED)\r\n+\r\n+    def get(self, note_id):\r\n+        item = self._items.get(note_id)\r\n+        return copy.deepcopy(item) if item is not None else None\r\n+\r\n+    def scan(self):\r\n+        return [copy.deepcopy(i) for i in self._items.values()]\r\n+\r\n+\r\n+def get_store():\r\n+    if os.environ.get(\"PRODUCTION_DB\") == \"1\":\r\n+        return DynamoStore()\r\n+    return FakeStore()\r\ndiff --git a/server.py b/server.py\r\nnew file mode 100644\r\nindex 0000000..ff9e4bd\r\n--- /dev/null\r\n+++ b/server.py\r\n@@ -0,0 +1,116 @@\r\n+\"\"\"Minimal MCP server: JSON-RPC 2.0 over a single entry point.\"\"\"\r\n+import json\r\n+\r\n+import db\r\n+import tools\r\n+\r\n+PROTOCOL_VERSION = \"2025-06-18\"\r\n+\r\n+NOTE_SCHEMA = {\r\n+    \"type\": \"object\",\r\n+    \"properties\": {\r\n+        \"id\": {\"type\": \"string\"},\r\n+        \"title\": {\"type\": \"string\"},\r\n+        \"word_count\": {\"type\": \"integer\"},\r\n+        \"stats\": {\r\n+            \"type\": \"object\",\r\n+            \"properties\": {\r\n+                \"views\": {\"type\": \"integer\"},\r\n+                \"rating\": {\"type\": \"number\"},\r\n+                \"revisions\": {\"type\": \"array\", \"items\": {\"type\": \"integer\"}},\r\n+            },\r\n+            \"required\": [\"views\", \"rating\", \"revisions\"],\r\n+        },\r\n+        \"tags\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}},\r\n+    },\r\n+    \"required\": [\"id\", \"title\", \"word_count\", \"stats\", \"tags\"],\r\n+}\r\n+\r\n+LIST_SCHEMA = {\r\n+    \"type\": \"object\",\r\n+    \"properties\": {\r\n+        \"notes\": {\r\n+            \"type\": \"array\",\r\n+            \"items\": {\r\n+                \"type\": \"object\",\r\n+                \"properties\": {\r\n+                    \"id\": {\"type\": \"string\"},\r\n+                    \"title\": {\"type\": \"string\"},\r\n+                    \"word_count\": {\"type\": \"integer\"},\r\n+                },\r\n+                \"required\": [\"id\", \"title\", \"word_count\"],\r\n+            },\r\n+        },\r\n+        \"count\": {\"type\": \"integer\"},\r\n+    },\r\n+    \"required\": [\"notes\", \"count\"],\r\n+}\r\n+\r\n+TOOLS = [\r\n+    {\r\n+        \"name\": \"get_note\",\r\n+        \"description\": \"Fetch one note by id, with its stats.\",\r\n+        \"inputSchema\": {\r\n+            \"type\": \"object\",\r\n+            \"properties\": {\"note_id\": {\"type\": \"string\"}},\r\n+            \"required\": [\"note_id\"],\r\n+        },\r\n+        \"outputSchema\": NOTE_SCHEMA,\r\n+    },\r\n+    {\r\n+        \"name\": \"list_notes\",\r\n+        \"description\": \"List notes, optionally filtered by tag.\",\r\n+        \"inputSchema\": {\r\n+            \"type\": \"object\",\r\n+            \"properties\": {\"tag\": {\"type\": \"string\"}},\r\n+        },\r\n+        \"outputSchema\": LIST_SCHEMA,\r\n+    },\r\n+]\r\n+\r\n+_store = None\r\n+\r\n+\r\n+def _get_store():\r\n+    global _store\r\n+    if _store is None:\r\n+        _store = db.get_store()\r\n+    return _store\r\n+\r\n+\r\n+def _call_tool(name, arguments):\r\n+    store = _get_store()\r\n+    try:\r\n+        if name == \"get_note\":\r\n+            data = tools.get_note(store, arguments[\"note_id\"])\r\n+        elif name == \"list_notes\":\r\n+            data = tools.list_notes(store, arguments.get(\"tag\"))\r\n+        else:\r\n+            return {\"isError\": True, \"content\": [{\"type\": \"text\", \"text\": f\"unknown tool {name}\"}]}\r\n+        return {\r\n+            \"content\": [{\"type\": \"text\", \"text\": json.dumps(data)}],\r\n+            \"structuredContent\": data,\r\n+        }\r\n+    except Exception as exc:  # keep the server up; report the failure to the client\r\n+        return {\"isError\": True, \"content\": [{\"type\": \"text\", \"text\": str(exc)}]}\r\n+\r\n+\r\n+def handle(request_json):\r\n+    req = json.loads(request_json)\r\n+    method = req.get(\"method\")\r\n+    rid = req.get(\"id\")\r\n+    if method == \"initialize\":\r\n+        result = {\r\n+            \"protocolVersion\": PROTOCOL_VERSION,\r\n+            \"capabilities\": {\"tools\": {}},\r\n+            \"serverInfo\": {\"name\": \"notes-mcp\", \"version\": \"0.3.1\"},\r\n+        }\r\n+    elif method == \"tools/list\":\r\n+        result = {\"tools\": TOOLS}\r\n+    elif method == \"tools/call\":\r\n+        params = req.get(\"params\", {})\r\n+        result = _call_tool(params.get(\"name\"), params.get(\"arguments\", {}))\r\n+    else:\r\n+        return json.dumps({\"jsonrpc\": \"2.0\", \"id\": rid,\r\n+                           \"error\": {\"code\": -32601, \"message\": f\"method not found: {method}\"}})\r\n+    return json.dumps({\"jsonrpc\": \"2.0\", \"id\": rid, \"result\": result})\r\ndiff --git a/tests/__init__.py b/tests/__init__.py\r\nnew file mode 100644\r\nindex 0000000..e69de29\r\ndiff --git a/tests/test_tools.py b/tests/test_tools.py\r\nnew file mode 100644\r\nindex 0000000..f6b5953\r\n--- /dev/null\r\n+++ b/tests/test_tools.py\r\n@@ -0,0 +1,42 @@\r\n+import unittest\r\n+\r\n+import db\r\n+import tools\r\n+\r\n+\r\n+class GetNoteTest(unittest.TestCase):\r\n+    def setUp(self):\r\n+        self.store = db.FakeStore()\r\n+\r\n+    def test_returns_note(self):\r\n+        note = tools.get_note(self.store, \"n1\")\r\n+        self.assertEqual(note[\"title\"], \"Ship the importer\")\r\n+        self.assertEqual(note[\"word_count\"], 412)\r\n+        self.assertEqual(note[\"stats\"][\"views\"], 37)\r\n+\r\n+    def test_missing_note_raises(self):\r\n+        with self.assertRaises(KeyError):\r\n+            tools.get_note(self.store, \"nope\")\r\n+\r\n+\r\n+class ListNotesTest(unittest.TestCase):\r\n+    def setUp(self):\r\n+        self.store = db.FakeStore()\r\n+\r\n+    def test_lists_all(self):\r\n+        out = tools.list_notes(self.store)\r\n+        self.assertEqual(out[\"count\"], 2)\r\n+        self.assertEqual([n[\"id\"] for n in out[\"notes\"]], [\"n1\", \"n2\"])\r\n+\r\n+    def test_filters_by_tag(self):\r\n+        out = tools.list_notes(self.store, tag=\"home\")\r\n+        self.assertEqual(out[\"count\"], 1)\r\n+        self.assertEqual(out[\"notes\"][0][\"title\"], \"Groceries\")\r\n+\r\n+    def test_word_count_is_int(self):\r\n+        out = tools.list_notes(self.store)\r\n+        self.assertIsInstance(out[\"notes\"][0][\"word_count\"], int)\r\n+\r\n+\r\n+if __name__ == \"__main__\":\r\n+    unittest.main()\r\ndiff --git a/tools.py b/tools.py\r\nnew file mode 100644\r\nindex 0000000..988963a\r\n--- /dev/null\r\n+++ b/tools.py\r\n@@ -0,0 +1,29 @@\r\n+\"\"\"Tool implementations. Each takes the store and the tool arguments, returns a dict.\"\"\"\r\n+\r\n+\r\n+def _coerce(note):\r\n+    # DynamoDB hands numbers back as Decimal; make the obvious ones JSON-friendly.\r\n+    note = dict(note)\r\n+    if \"word_count\" in note:\r\n+        note[\"word_count\"] = int(note[\"word_count\"])\r\n+    return note\r\n+\r\n+\r\n+def get_note(store, note_id):\r\n+    note = store.get(note_id)\r\n+    if note is None:\r\n+        raise KeyError(f\"no note {note_id!r}\")\r\n+    return _coerce(note)\r\n+\r\n+\r\n+def list_notes(store, tag=None):\r\n+    notes = [_coerce(n) for n in store.scan()]\r\n+    if tag:\r\n+        notes = [n for n in notes if tag in n.get(\"tags\", [])]\r\n+    return {\r\n+        \"notes\": [\r\n+            {\"id\": n[\"id\"], \"title\": n[\"title\"], \"word_count\": n[\"word_count\"]}\r\n+            for n in sorted(notes, key=lambda n: n[\"id\"])\r\n+        ],\r\n+        \"count\": len(notes),\r\n+    }\r\n"}}}
