ithout/repo/tests/test_tools.py","hunks":[{"oldStart":1,"oldLines":3,"newStart":1,"newLines":4,"lines":["+import json"," import unittest"," "," import db"]},{"oldStart":38,"oldLines":5,"newStart":39,"newLines":22,"lines":["         self.assertIsInstance(out[\"notes\"][0][\"word_count\"], int)"," "," ","+class DynamoStoreTest(unittest.TestCase):","+    \"\"\"The production store returns Decimal for every number, nested included.\"\"\"","+","+    def setUp(self):","+        self.store = db.DynamoStore()","+","+    def test_get_note_has_no_decimals(self):","+        note = tools.get_note(self.store, \"n1\")","+        self.assertEqual(json.loads(json.dumps(note)), db.SEED[\"n1\"])","+        self.assertIsInstance(note[\"stats\"][\"views\"], int)","+        self.assertIsInstance(note[\"stats\"][\"rating\"], float)","+        self.assertTrue(all(type(r) is int for r in note[\"stats\"][\"revisions\"]))","+","+    def test_list_notes_matches_fake_store(self):","+        self.assertEqual(tools.list_notes(self.store), tools.list_notes(db.FakeStore()))","+","+"," if __name__ == \"__main__\":","     unittest.main()"]}]}],"moreFiles":0,"changedFiles":["/private/tmp/claude-501/-Users-valentinakoniukhova-projects-worklore/3bfdd3c9-cfe2-4fd1-a8b7-ce52b613a3aa/scratchpad/story-eval/runs/s2-claude-without/repo/tests/test_tools.py"]}}}
