{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc 'cat journal.py && cat tests/test_journal.py'","aggregated_output":"\"\"\"daybook journal backend (in-memory store for this service).\"\"\"\nfrom datetime import datetime, timezone\nfrom zoneinfo import ZoneInfo\n\n_POSTS = []\n\n\ndef reset():\n    _POSTS.clear()\n\n\ndef _utcnow():\n    return datetime.now(timezone.utc)\n\n\ndef publish(entry, client_tz, now=None):\n    \"\"\"Store a new post.\n\n    entry: {\"author\": str, \"title\": str, \"body\": str}\n    client_tz: IANA zone reported by the author's browser, e.g. \"Europe/Berlin\".\n    now: server clock override (aware datetime), used by tests.\n    \"\"\"\n    now = now or _utcnow()\n    post = dict(entry)\n    post[\"client_tz\"] = client_tz\n    post[\"created_at\"] = now.astimezone(timezone.utc).isoformat()\n    # Dates are always generated on the server, in UTC, so they are consistent.\n    post[\"date\"] = now.astimezone(timezone.utc).date().isoformat()\n    _POSTS.append(post)\n    return post\n\n\ndef display_date(post, viewer_tz):\n    \"\"\"Date shown on a post card, converted to the viewer's zone.\n\n    Anchored at noon UTC so the conversion can never flip the calendar day.\n    \"\"\"\n    noon = datetime.fromisoformat(post[\"date\"] + \"T12:00:00+00:00\")\n    return noon.astimezone(ZoneInfo(viewer_tz)).date().isoformat()\n\n\ndef feed():\n    \"\"\"Home feed, newest first.\"\"\"\n    return sorted(_POSTS, key=lambda p: (p[\"date\"], p[\"author\"]), reverse=True)\nimport unittest\nfrom datetime import datetime, timezone\n\nimport journal\n\n\ndef at(s):\n    return datetime.fromisoformat(s).replace(tzinfo=timezone.utc)\n\n\nclass JournalTest(unittest.TestCase):\n    def setUp(self):\n        journal.reset()\n\n    def test_publish_stores_post(self):\n        p = journal.publish({\"author\": \"kim\", \"title\": \"t\", \"body\": \"b\"}, \"UTC\",\n                            now=at(\"2026-03-10T12:00:00\"))\n        self.assertEqual(p[\"title\"], \"t\")\n        self.assertEqual(p[\"date\"], \"2026-03-10\")\n\n    def test_display_date_utc_viewer(self):\n        p = journal.publish({\"author\": \"kim\", \"title\": \"t\", \"body\": \"b\"}, \"UTC\",\n                            now=at(\"2026-03-10T12:00:00\"))\n        self.assertEqual(journal.display_date(p, \"UTC\"), \"2026-03-10\")\n\n    def test_display_date_berlin_midday(self):\n        p = journal.publish({\"author\": \"lena\", \"title\": \"t\", \"body\": \"b\"}, \"Europe/Berlin\",\n                            now=at(\"2026-03-10T09:00:00\"))\n        self.assertEqual(journal.display_date(p, \"Europe/Berlin\"), \"2026-03-10\")\n\n    def test_feed_newest_first(self):\n        journal.publish({\"author\": \"kim\", \"title\": \"old\", \"body\": \"\"}, \"UTC\",\n                        now=at(\"2026-03-09T12:00:00\"))\n        journal.publish({\"author\": \"kim\", \"title\": \"new\", \"body\": \"\"}, \"UTC\",\n                        now=at(\"2026-03-10T12:00:00\"))\n        self.assertEqual([p[\"title\"] for p in journal.feed()], [\"new\", \"old\"])\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n","exit_code":0,"status":"completed"}}
