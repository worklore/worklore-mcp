{"event":"step_update","step_update":{"conversation_id":"64beaa93-65a4-45d6-8fbd-d2b228b5137c","step_index":40,"state":"DONE","step_type":"tool","tool_name":"run_command","duration_seconds":0.17521,"tool_info":{"name":"run_command","parameters":{"CommandLine":"git diff"},"output":"diff --git a/journal.py b/journal.py\r\nindex b0453dc..6e40cff 100644\r\n--- a/journal.py\r\n+++ b/journal.py\r\n@@ -31,12 +31,17 @@ def publish(entry, client_tz, now=None):\r\n \r\n \r\n def display_date(post, viewer_tz):\r\n-    \"\"\"Date shown on a post card, converted to the viewer's zone.\r\n-\r\n-    Anchored at noon UTC so the conversion can never flip the calendar day.\r\n-    \"\"\"\r\n+    \"\"\"Date shown on a post card, converted to the viewer's zone.\"\"\"\r\n+    tz = ZoneInfo(viewer_tz) if isinstance(viewer_tz, str) else viewer_tz\r\n+    if \"created_at\" in post:\r\n+        created = post[\"created_at\"]\r\n+        if isinstance(created, str):\r\n+            created = datetime.fromisoformat(created)\r\n+        if created.tzinfo is None:\r\n+            created = created.replace(tzinfo=timezone.utc)\r\n+        return created.astimezone(tz).date().isoformat()\r\n     noon = datetime.fromisoformat(post[\"date\"] + \"T12:00:00+00:00\")\r\n-    return noon.astimezone(ZoneInfo(viewer_tz)).date().isoformat()\r\n+    return noon.astimezone(tz).date().isoformat()\r\n \r\n \r\n def feed():\r\ndiff --git a/tests/test_journal.py b/tests/test_journal.py\r\nindex febff36..b71d01f 100644\r\n--- a/tests/test_journal.py\r\n+++ b/tests/test_journal.py\r\n@@ -35,6 +35,27 @@ class JournalTest(unittest.TestCase):\r\n                         now=at(\"2026-03-10T12:00:00\"))\r\n         self.assertEqual([p[\"title\"] for p in journal.feed()], [\"new\", \"old\"])\r\n \r\n+    def test_display_date_berlin_late_night(self):\r\n+        # 23:30 UTC on March 10 is 00:30 on March 11 in Europe/Berlin\r\n+        p = journal.publish({\"author\": \"lena\", \"title\": \"t\", \"body\": \"b\"}, \"Europe/Berlin\",\r\n+                            now=at(\"2026-03-10T23:30:00\"))\r\n+        self.assertEqual(journal.display_date(p, \"Europe/Berlin\"), \"2026-03-11\")\r\n+        self.assertEqual(journal.display_date(p, \"UTC\"), \"2026-03-10\")\r\n+\r\n+    def test_display_date_pacific_evening(self):\r\n+        # 04:00 UTC on March 11 is 20:00 on March 10 in America/Los_Angeles\r\n+        p = journal.publish({\"author\": \"sam\", \"title\": \"t\", \"body\": \"b\"}, \"America/Los_Angeles\",\r\n+                            now=at(\"2026-03-11T04:00:00\"))\r\n+        self.assertEqual(journal.display_date(p, \"America/Los_Angeles\"), \"2026-03-10\")\r\n+        self.assertEqual(journal.display_date(p, \"UTC\"), \"2026-03-11\")\r\n+\r\n+    def test_display_date_tokyo_morning(self):\r\n+        # 16:00 UTC on March 10 is 01:00 on March 11 in Asia/Tokyo\r\n+        p = journal.publish({\"author\": \"ken\", \"title\": \"t\", \"body\": \"b\"}, \"Asia/Tokyo\",\r\n+                            now=at(\"2026-03-10T16:00:00\"))\r\n+        self.assertEqual(journal.display_date(p, \"Asia/Tokyo\"), \"2026-03-11\")\r\n+        self.assertEqual(journal.display_date(p, \"UTC\"), \"2026-03-10\")\r\n+\r\n \r\n if __name__ == \"__main__\":\r\n     unittest.main()\r\n"}}}
