{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc 'cat tools.py && cat db.py'","aggregated_output":"\"\"\"Tool implementations. Each takes the store and the tool arguments, returns a dict.\"\"\"\n\n\ndef _coerce(note):\n    # DynamoDB hands numbers back as Decimal; make the obvious ones JSON-friendly.\n    note = dict(note)\n    if \"word_count\" in note:\n        note[\"word_count\"] = int(note[\"word_count\"])\n    return note\n\n\ndef get_note(store, note_id):\n    note = store.get(note_id)\n    if note is None:\n        raise KeyError(f\"no note {note_id!r}\")\n    return _coerce(note)\n\n\ndef list_notes(store, tag=None):\n    notes = [_coerce(n) for n in store.scan()]\n    if tag:\n        notes = [n for n in notes if tag in n.get(\"tags\", [])]\n    return {\n        \"notes\": [\n            {\"id\": n[\"id\"], \"title\": n[\"title\"], \"word_count\": n[\"word_count\"]}\n            for n in sorted(notes, key=lambda n: n[\"id\"])\n        ],\n        \"count\": len(notes),\n    }\n\"\"\"Storage layer.\n\nDynamoStore stands in for the real DynamoDB table (boto3 resource API). Like the\nreal boto3 TypeDeserializer, every number it hands back -- at any depth -- is a\ndecimal.Decimal. FakeStore is the in-memory store the unit tests use.\n\"\"\"\nimport copy\nimport os\nfrom decimal import Decimal\n\nSEED = {\n    \"n1\": {\n        \"id\": \"n1\",\n        \"title\": \"Ship the importer\",\n        \"word_count\": 412,\n        \"stats\": {\"views\": 37, \"rating\": 4.5, \"revisions\": [1, 2, 3]},\n        \"tags\": [\"work\", \"q4\"],\n    },\n    \"n2\": {\n        \"id\": \"n2\",\n        \"title\": \"Groceries\",\n        \"word_count\": 18,\n        \"stats\": {\"views\": 3, \"rating\": 3.0, \"revisions\": [1]},\n        \"tags\": [\"home\"],\n    },\n}\n\n\ndef _to_dynamo(value):\n    \"\"\"What boto3's TypeDeserializer does to numbers: Decimal, everywhere.\"\"\"\n    if isinstance(value, bool):\n        return value\n    if isinstance(value, (int, float)):\n        return Decimal(str(value))\n    if isinstance(value, dict):\n        return {k: _to_dynamo(v) for k, v in value.items()}\n    if isinstance(value, list):\n        return [_to_dynamo(v) for v in value]\n    return value\n\n\nclass DynamoStore:\n    \"\"\"Production store (simulated DynamoDB table).\"\"\"\n\n    def __init__(self, items=None):\n        self._items = copy.deepcopy(items if items is not None else SEED)\n\n    def get(self, note_id):\n        item = self._items.get(note_id)\n        return _to_dynamo(copy.deepcopy(item)) if item is not None else None\n\n    def scan(self):\n        return [_to_dynamo(copy.deepcopy(i)) for i in self._items.values()]\n\n\nclass FakeStore:\n    \"\"\"In-memory store for tests.\"\"\"\n\n    def __init__(self, items=None):\n        self._items = copy.deepcopy(items if items is not None else SEED)\n\n    def get(self, note_id):\n        item = self._items.get(note_id)\n        return copy.deepcopy(item) if item is not None else None\n\n    def scan(self):\n        return [copy.deepcopy(i) for i in self._items.values()]\n\n\ndef get_store():\n    if os.environ.get(\"PRODUCTION_DB\") == \"1\":\n        return DynamoStore()\n    return FakeStore()\n","exit_code":0,"status":"completed"}}
