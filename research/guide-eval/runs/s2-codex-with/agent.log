{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/zsh -lc 'cat server.py'","aggregated_output":"\"\"\"Minimal MCP server: JSON-RPC 2.0 over a single entry point.\"\"\"\nimport json\n\nimport db\nimport tools\n\nPROTOCOL_VERSION = \"2025-06-18\"\n\nNOTE_SCHEMA = {\n    \"type\": \"object\",\n    \"properties\": {\n        \"id\": {\"type\": \"string\"},\n        \"title\": {\"type\": \"string\"},\n        \"word_count\": {\"type\": \"integer\"},\n        \"stats\": {\n            \"type\": \"object\",\n            \"properties\": {\n                \"views\": {\"type\": \"integer\"},\n                \"rating\": {\"type\": \"number\"},\n                \"revisions\": {\"type\": \"array\", \"items\": {\"type\": \"integer\"}},\n            },\n            \"required\": [\"views\", \"rating\", \"revisions\"],\n        },\n        \"tags\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}},\n    },\n    \"required\": [\"id\", \"title\", \"word_count\", \"stats\", \"tags\"],\n}\n\nLIST_SCHEMA = {\n    \"type\": \"object\",\n    \"properties\": {\n        \"notes\": {\n            \"type\": \"array\",\n            \"items\": {\n                \"type\": \"object\",\n                \"properties\": {\n                    \"id\": {\"type\": \"string\"},\n                    \"title\": {\"type\": \"string\"},\n                    \"word_count\": {\"type\": \"integer\"},\n                },\n                \"required\": [\"id\", \"title\", \"word_count\"],\n            },\n        },\n        \"count\": {\"type\": \"integer\"},\n    },\n    \"required\": [\"notes\", \"count\"],\n}\n\nTOOLS = [\n    {\n        \"name\": \"get_note\",\n        \"description\": \"Fetch one note by id, with its stats.\",\n        \"inputSchema\": {\n            \"type\": \"object\",\n            \"properties\": {\"note_id\": {\"type\": \"string\"}},\n            \"required\": [\"note_id\"],\n        },\n        \"outputSchema\": NOTE_SCHEMA,\n    },\n    {\n        \"name\": \"list_notes\",\n        \"description\": \"List notes, optionally filtered by tag.\",\n        \"inputSchema\": {\n            \"type\": \"object\",\n            \"properties\": {\"tag\": {\"type\": \"string\"}},\n        },\n        \"outputSchema\": LIST_SCHEMA,\n    },\n]\n\n_store = None\n\n\ndef _get_store():\n    global _store\n    if _store is None:\n        _store = db.get_store()\n    return _store\n\n\ndef _call_tool(name, arguments):\n    store = _get_store()\n    try:\n        if name == \"get_note\":\n            data = tools.get_note(store, arguments[\"note_id\"])\n        elif name == \"list_notes\":\n            data = tools.list_notes(store, arguments.get(\"tag\"))\n        else:\n            return {\"isError\": True, \"content\": [{\"type\": \"text\", \"text\": f\"unknown tool {name}\"}]}\n        return {\n            \"content\": [{\"type\": \"text\", \"text\": json.dumps(data)}],\n            \"structuredContent\": data,\n        }\n    except Exception as exc:  # keep the server up; report the failure to the client\n        return {\"isError\": True, \"content\": [{\"type\": \"text\", \"text\": str(exc)}]}\n\n\ndef handle(request_json):\n    req = json.loads(request_json)\n    method = req.get(\"method\")\n    rid = req.get(\"id\")\n    if method == \"initialize\":\n        result = {\n            \"protocolVersion\": PROTOCOL_VERSION,\n            \"capabilities\": {\"tools\": {}},\n            \"serverInfo\": {\"name\": \"notes-mcp\", \"version\": \"0.3.1\"},\n        }\n    elif method == \"tools/list\":\n        result = {\"tools\": TOOLS}\n    elif method == \"tools/call\":\n        params = req.get(\"params\", {})\n        result = _call_tool(params.get(\"name\"), params.get(\"arguments\", {}))\n    else:\n        return json.dumps({\"jsonrpc\": \"2.0\", \"id\": rid,\n                           \"error\": {\"code\": -32601, \"message\": f\"method not found: {method}\"}})\n    return json.dumps({\"jsonrpc\": \"2.0\", \"id\": rid, \"result\": result})\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc 'cat tests/test_tools.py'","aggregated_output":"import unittest\n\nimport db\nimport tools\n\n\nclass GetNoteTest(unittest.TestCase):\n    def setUp(self):\n        self.store = db.FakeStore()\n\n    def test_returns_note(self):\n        note = tools.get_note(self.store, \"n1\")\n        self.assertEqual(note[\"title\"], \"Ship the importer\")\n        self.assertEqual(note[\"word_count\"], 412)\n        self.assertEqual(note[\"stats\"][\"views\"], 37)\n\n    def test_missing_note_raises(self):\n        with self.assertRaises(KeyError):\n            tools.get_note(self.store, \"nope\")\n\n\nclass ListNotesTest(unittest.TestCase):\n    def setUp(self):\n        self.store = db.FakeStore()\n\n    def test_lists_all(self):\n        out = tools.list_notes(self.store)\n        self.assertEqual(out[\"count\"], 2)\n        self.assertEqual([n[\"id\"] for n in out[\"notes\"]], [\"n1\", \"n2\"])\n\n    def test_filters_by_tag(self):\n        out = tools.list_notes(self.store, tag=\"home\")\n        self.assertEqual(out[\"count\"], 1)\n        self.assertEqual(out[\"notes\"][0][\"title\"], \"Groceries\")\n\n    def test_word_count_is_int(self):\n        out = tools.list_notes(self.store)\n        self.assertIsInstance(out[\"notes\"][0][\"word_count\"], int)\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc 'cat README.md'","aggregated_output":"# notes-mcp\n\nA tiny MCP server (JSON-RPC 2.0) exposing two tools over a notes store.\n\n- `server.py` — `handle(request_json: str) -> str`, the single entry point. The HTTP\n  layer (not included) passes the raw request body in and writes the returned string out.\n- `tools.py` — tool implementations.\n- `db.py` — storage. In production the store is backed by DynamoDB (`DynamoStore`);\n  tests use `FakeStore`. `get_store()` picks DynamoStore when `PRODUCTION_DB=1`.\n\nRun tests: `python3 -m unittest discover -s tests`\n","exit_code":0,"status":"completed"}}
