{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Y37KdrKoXq1Rcvo4V2L5M6","type":"tool_result","content":"\"\"\"Storage layer.\n\nDynamoStore stands in for the real DynamoDB table (boto3 resource API). Like the\nreal boto3 TypeDeserializer, every number it hands back -- at any depth -- is a\ndecimal.Decimal. FakeStore is the in-memory store the unit tests use.\n\"\"\"\nimport copy\nimport os\nfrom decimal import Decimal\n\nSEED = {\n    \"n1\": {\n        \"id\": \"n1\",\n        \"title\": \"Ship the importer\",\n        \"word_count\": 412,\n        \"stats\": {\"views\": 37, \"rating\": 4.5, \"revisions\": [1, 2, 3]},\n        \"tags\": [\"work\", \"q4\"],\n    },\n    \"n2\": {\n        \"id\": \"n2\",\n        \"title\": \"Groceries\",\n        \"word_count\": 18,\n        \"stats\": {\"views\": 3, \"rating\": 3.0, \"revisions\": [1]},\n        \"tags\": [\"home\"],\n    },\n}\n\n\ndef _to_dynamo(value):\n    \"\"\"What boto3's TypeDeserializer does to numbers: Decimal, everywhere.\"\"\"\n    if isinstance(value, bool):\n        return value\n    if isinstance(value, (int, float)):\n        return Decimal(str(value))\n    if isinstance(value, dict):\n        return {k: _to_dynamo(v) for k, v in value.items()}\n    if isinstance(value, list):\n        return [_to_dynamo(v) for v in value]\n    return value\n\n\nclass DynamoStore:\n    \"\"\"Production store (simulated DynamoDB table).\"\"\"\n\n    def __init__(self, items=None):\n        self._items = copy.deepcopy(items if items is not None else SEED)\n\n    def get(self, note_id):\n        item = self._items.get(note_id)\n        return _to_dynamo(copy.deepcopy(item)) if item is not None else None\n\n    def scan(self):\n        return [_to_dynamo(copy.deepcopy(i)) for i in self._items.values()]\n\n\nclass FakeStore:\n    \"\"\"In-memory store for tests.\"\"\"\n\n    def __init__(self, items=None):\n        self._items = copy.deepcopy(items if items is not None else SEED)\n\n    def get(self, note_id):\n        item = self._items.get(note_id)\n        return copy.deepcopy(item) if item is not None else None\n\n    def scan(self):\n        return [copy.deepcopy(i) for i in self._items.values()]\n\n\ndef get_store():\n    if os.environ.get(\"PRODUCTION_DB\") == \"1\":\n        return DynamoStore()\n    return FakeStore()\n\"\"\"Minimal MCP server: JSON-RPC 2.0 over a single entry point.\"\"\"\nimport json\n\nimport db\nimport tools\n\nPROTOCOL_VERSION = \"2025-06-18\"\n\nNOTE_SCHEMA = {\n    \"type\": \"object\",\n    \"properties\": {\n        \"id\": {\"type\": \"string\"},\n        \"title\": {\"type\": \"string\"},\n        \"word_count\": {\"type\": \"integer\"},\n        \"stats\": {\n            \"type\": \"object\",\n            \"properties\": {\n                \"views\": {\"type\": \"integer\"},\n                \"rating\": {\"type\": \"number\"},\n                \"revisions\": {\"type\": \"array\", \"items\": {\"type\": \"integer\"}},\n            },\n            \"required\": [\"views\", \"rating\", \"revisions\"],\n        },\n        \"tags\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}},\n    },\n    \"required\": [\"id\", \"title\", \"word_count\", \"stats\", \"tags\"],\n}\n\nLIST_SCHEMA = {\n    \"type\": \"object\",\n    \"properties\": {\n        \"notes\": {\n            \"type\": \"array\",\n            \"items\": {\n                \"type\": \"object\",\n                \"properties\": {\n                    \"id\": {\"type\": \"string\"},\n                    \"title\": {\"type\": \"string\"},\n                    \"word_count\": {\"type\": \"integer\"},\n                },\n                \"required\": [\"id\", \"title\", \"word_count\"],\n            },\n        },\n        \"count\": {\"type\": \"integer\"},\n    },\n    \"required\": [\"notes\", \"count\"],\n}\n\nTOOLS = [\n    {\n        \"name\": \"get_note\",\n        \"description\": \"Fetch one note by id, with its stats.\",\n        \"inputSchema\": {\n            \"type\": \"object\",\n            \"properties\": {\"note_id\": {\"type\": \"string\"}},\n            \"required\": [\"note_id\"],\n        },\n        \"outputSchema\": NOTE_SCHEMA,\n    },\n    {\n        \"name\": \"list_notes\",\n        \"description\": \"List notes, optionally filtered by tag.\",\n        \"inputSchema\": {\n            \"type\": \"object\",\n            \"properties\": {\"tag\": {\"type\": \"string\"}},\n        },\n        \"outputSchema\": LIST_SCHEMA,\n    },\n]\n\n_store = None\n\n\ndef _get_store():\n    global _store\n    if _store is None:\n        _store = db.get_store()\n    return _store\n\n\ndef _call_tool(name, arguments):\n    store = _get_store()\n    try:\n        if name == \"get_note\":\n            data = tools.get_note(store, arguments[\"note_id\"])\n        elif name == \"list_notes\":\n            data = tools.list_notes(store, arguments.get(\"tag\"))\n        else:\n            return {\"isError\": True, \"content\": [{\"type\": \"text\", \"text\": f\"unknown tool {name}\"}]}\n        return {\n            \"content\": [{\"type\": \"text\", \"text\": json.dumps(data)}],\n            \"structuredContent\": data,\n        }\n    except Exception as exc:  # keep the server up; report the failure to the client\n        return {\"isError\": True, \"content\": [{\"type\": \"text\", \"text\": str(exc)}]}\n\n\ndef handle(request_json):\n    req = json.loads(request_json)\n    method = req.get(\"method\")\n    rid = req.get(\"id\")\n    if method == \"initialize\":\n        result = {\n            \"protocolVersion\": PROTOCOL_VERSION,\n            \"capabilities\": {\"tools\": {}},\n            \"serverInfo\": {\"name\": \"notes-mcp\", \"version\": \"0.3.1\"},\n        }\n    elif method == \"tools/list\":\n        result = {\"tools\": TOOLS}\n    elif method == \"tools/call\":\n        params = req.get(\"params\", {})\n        result = _call_tool(params.get(\"name\"), params.get(\"arguments\", {}))\n    else:\n        return json.dumps({\"jsonrpc\": \"2.0\", \"id\": rid,\n                           \"error\": {\"code\": -32601, \"message\": f\"method not found: {method}\"}})\n    return json.dumps({\"jsonrpc\": \"2.0\", \"id\": rid, \"result\": result})\n\"\"\"Tool implementations. Each takes the store and the tool arguments, returns a dict.\"\"\"\n\n\ndef _coerce(note):\n    # DynamoDB hands numbers back as Decimal; make the obvious ones JSON-friendly.\n    note = dict(note)\n    if \"word_count\" in note:\n        note[\"word_count\"] = int(note[\"word_count\"])\n    return note\n\n\ndef get_note(store, note_id):\n    note = store.get(note_id)\n    if note is None:\n        raise KeyError(f\"no note {note_id!r}\")\n    return _coerce(note)\n\n\ndef list_notes(store, tag=None):\n    notes = [_coerce(n) for n in store.scan()]\n    if tag:\n        notes = [n for n in notes if tag in n.get(\"tags\", [])]\n    return {\n        \"notes\": [\n            {\"id\": n[\"id\"], \"title\": n[\"title\"], \"word_count\": n[\"word_count\"]}\n            for n in sorted(notes, key=lambda n: n[\"id\"])\n        ],\n        \"count\": len(notes),\n    }\nimport unittest\n\nimport db\nimport tools\n\n\nclass GetNoteTest(unittest.TestCase):\n    def setUp(self):\n        self.store = db.FakeStore()\n\n    def test_returns_note(self):\n        note = tools.get_note(self.store, \"n1\")\n        self.assertEqual(note[\"title\"], \"Ship the importer\")\n        self.assertEqual(note[\"word_count\"], 412)\n        self.assertEqual(note[\"stats\"][\"views\"], 37)\n\n    def test_missing_note_raises(self):\n        with self.assertRaises(KeyError):\n            tools.get_note(self.store, \"nope\")\n\n\nclass ListNotesTest(unittest.TestCase):\n    def setUp(self):\n        self.store = db.FakeStore()\n\n    def test_lists_all(self):\n        out = tools.list_notes(self.store)\n        self.assertEqual(out[\"count\"], 2)\n        self.assertEqual([n[\"id\"] for n in out[\"notes\"]], [\"n1\", \"n2\"])\n\n    def test_filters_by_tag(self):\n        out = tools.list_notes(self.store, tag=\"home\")\n        self.assertEqual(out[\"count\"], 1)\n        self.assertEqual(out[\"notes\"][0][\"title\"], \"Groceries\")\n\n    def test_word_count_is_int(self):\n        out = tools.list_notes(self.store)\n        self.assertIsInstance(out[\"notes\"][0][\"word_count\"], int)\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n__pycache__/\n*.pyc\nRan 5 tests in 0.000s\n\nOK","is_error":false}]},"parent_tool_use_id":null,"session_id":"9564e703-eeac-498d-9656-dadf2e675a07","uuid":"4ebec055-e0d0-4323-a7a4-184495273910","timestamp":"2026-10-04T01:55:17.329Z","tool_use_result":{"stdout":"\"\"\"Storage layer.\n\nDynamoStore stands in for the real DynamoDB table (boto3 resource API). Like the\nreal boto3 TypeDeserializer, every number it hands back -- at any depth -- is a\ndecimal.Decimal. FakeStore is the in-memory store the unit tests use.\n\"\"\"\nimport copy\nimport os\nfrom decimal import Decimal\n\nSEED = {\n    \"n1\": {\n        \"id\": \"n1\",\n        \"title\": \"Ship the importer\",\n        \"word_count\": 412,\n        \"stats\": {\"views\": 37, \"rating\": 4.5, \"revisions\": [1, 2, 3]},\n        \"tags\": [\"work\", \"q4\"],\n    },\n    \"n2\": {\n        \"id\": \"n2\",\n        \"title\": \"Groceries\",\n        \"word_count\": 18,\n        \"stats\": {\"views\": 3, \"rating\": 3.0, \"revisions\": [1]},\n        \"tags\": [\"home\"],\n    },\n}\n\n\ndef _to_dynamo(value):\n    \"\"\"What boto3's TypeDeserializer does to numbers: Decimal, everywhere.\"\"\"\n    if isinstance(value, bool):\n        return value\n    if isinstance(value, (int, float)):\n        return Decimal(str(value))\n    if isinstance(value, dict):\n        return {k: _to_dynamo(v) for k, v in value.items()}\n    if isinstance(value, list):\n        return [_to_dynamo(v) for v in value]\n    return value\n\n\nclass DynamoStore:\n    \"\"\"Production store (simulated DynamoDB table).\"\"\"