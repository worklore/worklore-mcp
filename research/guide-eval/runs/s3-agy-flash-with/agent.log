{"event":"step_update","step_update":{"conversation_id":"f266c1f8-0908-4331-9b39-5ad151d8de71","step_index":30,"state":"DONE","step_type":"tool","tool_name":"run_command","duration_seconds":0.156725,"tool_info":{"name":"run_command","parameters":{"CommandLine":"git diff"},"output":"diff --git a/journal.py b/journal.py\r\nindex b0453dc..0cbb10d 100644\r\n--- a/journal.py\r\n+++ b/journal.py\r\n@@ -13,32 +13,55 @@ def _utcnow():\r\n     return datetime.now(timezone.utc)\r\n \r\n \r\n-def publish(entry, client_tz, now=None):\r\n+def publish(entry, client_tz=None, now=None, date=None):\r\n     \"\"\"Store a new post.\r\n \r\n-    entry: {\"author\": str, \"title\": str, \"body\": str}\r\n-    client_tz: IANA zone reported by the author's browser, e.g. \"Europe/Berlin\".\r\n+    entry: {\"author\": str, \"title\": str, \"body\": str, \"date\": str (optional)}\r\n+    client_tz: optional IANA zone reported by the author's browser.\r\n     now: server clock override (aware datetime), used by tests.\r\n+    date: author's local calendar date override if not in entry.\r\n     \"\"\"\r\n     now = now or _utcnow()\r\n+    if now.tzinfo is None:\r\n+        now = now.replace(tzinfo=timezone.utc)\r\n+    utc_now = now.astimezone(timezone.utc)\r\n+\r\n     post = dict(entry)\r\n-    post[\"client_tz\"] = client_tz\r\n-    post[\"created_at\"] = now.astimezone(timezone.utc).isoformat()\r\n-    # Dates are always generated on the server, in UTC, so they are consistent.\r\n-    post[\"date\"] = now.astimezone(timezone.utc).date().isoformat()\r\n+    if client_tz is not None:\r\n+        post[\"client_tz\"] = client_tz\r\n+\r\n+    received_at_str = utc_now.isoformat()\r\n+    post[\"received_at\"] = received_at_str\r\n+    post[\"created_at\"] = received_at_str\r\n+\r\n+    # Date is content (author's local calendar date), treated as an opaque string.\r\n+    if date is not None:\r\n+        post[\"date\"] = str(date)\r\n+    elif \"date\" in post and post[\"date\"] is not None:\r\n+        post[\"date\"] = str(post[\"date\"])\r\n+    else:\r\n+        post[\"date\"] = utc_now.date().isoformat()\r\n+\r\n     _POSTS.append(post)\r\n     return post\r\n \r\n \r\n-def display_date(post, viewer_tz):\r\n-    \"\"\"Date shown on a post card, converted to the viewer's zone.\r\n+def display_date(post, viewer_tz=None):\r\n+    \"\"\"Date shown on a post card, displayed exactly as written.\"\"\"\r\n+    return post[\"date\"]\r\n \r\n-    Anchored at noon UTC so the conversion can never flip the calendar day.\r\n-    \"\"\"\r\n-    noon = datetime.fromisoformat(post[\"date\"] + \"T12:00:00+00:00\")\r\n-    return noon.astimezone(ZoneInfo(viewer_tz)).date().isoformat()\r\n+\r\n+def _sort_key(p):\r\n+    r = p.get(\"received_at\")\r\n+    if r is not None:\r\n+        if isinstance(r, datetime):\r\n+            if r.tzinfo is None:\r\n+                r = r.replace(tzinfo=timezone.utc)\r\n+            r = r.astimezone(timezone.utc).isoformat()\r\n+        return (str(r), str(p.get(\"date\", \"\")), str(p.get(\"author\", \"\")))\r\n+    return (str(p.get(\"date\", \"\")), str(p.get(\"date\", \"\")), str(p.get(\"author\", \"\")))\r\n \r\n \r\n def feed():\r\n     \"\"\"Home feed, newest first.\"\"\"\r\n-    return sorted(_POSTS, key=lambda p: (p[\"date\"], p[\"author\"]), reverse=True)\r\n+    return sorted(_POSTS, key=_sort_key, reverse=True)\r\ndiff --git a/tests/test_journal.py b/tests/test_journal.py\r\nindex febff36..d948d6c 100644\r\n--- a/tests/test_journal.py\r\n+++ b/tests/test_journal.py\r\n@@ -36,5 +36,49 @@ class JournalTest(unittest.TestCase):\r\n         self.assertEqual([p[\"title\"] for p in journal.feed()], [\"new\", \"old\"])\r\n \r\r\n \r\n+    def test_author_local_dates_and_feed_ordering_different_timezones(self):\r\n+        # 23:30 local in Tokyo (UTC+9) on 2026-07-31 -\u003e 14:30 UTC on 2026-07-31\r\n+        tokyo_post = journal.publish(\r\n+            {\"author\": \"tokyo_author\", \"title\": \"Tokyo\", \"body\": \"Evening in Tokyo\", \"date\": \"2026-07-31\"},\r\n+            client_tz=\"Asia/Tokyo\",\r\n+            now=at(\"2026-07-31T14:30:00\"),\r\n+        )\r\n+        # 23:30 local in Buenos Aires (UTC-3) on 2026-07-31 -\u003e 02:30 UTC on 2026-08-01\r\n+        ba_post = journal.publish(\r\n+            {\"author\": \"ba_author\", \"title\": \"Buenos Aires\", \"body\": \"Evening in BA\", \"date\": \"2026-07-31\"},\r\n+            client_tz=\"America/Argentina/Buenos_Aires\",\r\n+            now=at(\"2026-08-01T02:30:00\"),\r\n+        )\r\n+\r\n+        # Each author sees their own local calendar date as written\r\n+        self.assertEqual(journal.display_date(tokyo_post, \"Asia/Tokyo\"), \"2026-07-31\")\r\n+        self.assertEqual(journal.display_date(ba_post, \"America/Argentina/Buenos_Aires\"), \"2026-07-31\")\r\n+\r\n+        # Viewers across any timezone see the author's local date without conversion\r\n+        self.assertEqual(journal.display_date(tokyo_post, \"America/Argentina/Buenos_Aires\"), \"2026-07-31\")\r\n+        self.assertEqual(journal.display_date(ba_post, \"Asia/Tokyo\"), \"2026-07-31\")\r\n+        self.assertEqual(journal.display_date(ba_post, \"UTC\"), \"2026-07-31\")\r\n+        self.assertEqual(journal.display_date(tokyo_post), \"2026-07-31\")\r\n+\r\n+        # Feed order matches submission order (newest first: BA submitted later in real time)\r\n+        feed_authors = [p[\"author\"] for p in journal.feed()]\r\n+        self.assertEqual(feed_authors, [\"ba_author\", \"tokyo_author\"])\r\n+\r\n+    def test_feed_ordering_fallback_to_date(self):\r\n+        # Posts without received_at fall back to date\r\n+        p1 = {\"author\": \"a\", \"title\": \"day1\", \"body\": \"\", \"date\": \"2026-07-30\"}\r\n+        p2 = {\"author\": \"b\", \"title\": \"day2\", \"body\": \"\", \"date\": \"2026-07-31\"}\r\n+        journal._POSTS.extend([p1, p2])\r\n+        self.assertEqual([p[\"title\"] for p in journal.feed()], [\"day2\", \"day1\"])\r\n+\r\n+    def test_received_at_stamped_on_publish(self):\r\n+        p = journal.publish(\r\n+            {\"author\": \"kim\", \"title\": \"t\", \"body\": \"b\", \"date\": \"2026-07-31\"},\r\n+            now=at(\"2026-07-31T14:30:00\"),\r\n+        )\r\n+        self.assertEqual(p[\"received_at\"], \"2026-07-31T14:30:00+00:00\")\r\n+        self.assertEqual(p[\"date\"], \"2026-07-31\")\r\n+\r\n+\r\n if __name__ == \"__main__\":\r\n     unittest.main()\r\n"}}}
