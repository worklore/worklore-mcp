;; OS-level fence for the two OpenRouter lanes (codex-oss, vibe-devstral), same idea as kimi-sandbox.sb: the agent has a
;; real shell and everything it prints goes to OpenRouter and the model host, so the real home must be unreachable.
;; The only things read from it are Vibe's own install (pipx venv and its launcher). Network stays open. HOME via -D.
(version 1)
(allow default)
(deny file-read-data (subpath (param "HOME")))
(deny file-write* (subpath (param "HOME")))
(allow file-read-data (subpath (string-append (param "HOME") "/.local/pipx")))
(allow file-read-data (literal (string-append (param "HOME") "/.local/bin/vibe")))
(deny process-exec (literal "/bin/launchctl") (literal "/usr/bin/security") (literal "/usr/bin/osascript"))
