y.rates[quote]\r\n+console.log(`1 ${base} = ${rate.toFixed(4)} ${quote}`)\r\ndiff --git a/tsconfig.json b/tsconfig.json\r\nnew file mode 100644\r\nindex 0000000..58eeedd\r\n--- /dev/null\r\n+++ b/tsconfig.json\r\n@@ -0,0 +1,13 @@\r\n+{\r\n+  \"compilerOptions\": {\r\n+    \"target\": \"ES2022\",\r\n+    \"module\": \"NodeNext\",\r\n+    \"moduleResolution\": \"NodeNext\",\r\n+    \"strict\": true,\r\n+    \"noEmit\": true,\r\n+    \"skipLibCheck\": true,\r\n+    \"allowImportingTsExtensions\": true,\r\n+    \"types\": [\"node\"]\r\n+  },\r\n+  \"include\": [\"src\"]\r\n+}\r\n"}}}
