new file mode 100644
index 0000000..47729a9
--- /dev/null
+++ b/ANSWER.md
@@ -0,0 +1,7 @@
+# Codex sandboxed lane
+
+Added `codex-sandboxed` to `run.sh`. It runs the same `codex exec` command and writes the same run artifacts as `codex`, but launches it through `sandbox-exec` with `sandbox/agent.sb` and a temporary HOME/CODEX_HOME. The lane copies `auth.json` and `config.toml`, when present, into the temporary Codex directory before launch and deletes that directory afterward.
+
+Updated `sandbox/agent.sb` to take an `AGENT_INSTALL` path. The Kimi lane passes its existing install path; the Codex lane passes its temporary Codex directory. The profile continues to deny access to the real home outside that lane-specific exception.
+
+Verified with `bash -n run.sh`, a sandbox profile launch, and `git diff --check`. I did not run an agent task.
diff --git a/run.sh b/run.sh
index c41ad67..86db3b5 100755
--- a/run.sh
+++ b/run.sh
@@ -1,6 +1,7 @@
 #!/usr/bin/env bash
 # usage: run.sh <task> <lane> [rep]
 # lanes: codex   Codex CLI, unsandboxed
+#        codex-sandboxed Codex CLI under sandbox/agent.sb, scratch HOME
 #        kimi    Kimi Code under sandbox/agent.sb (no reading or writing the real home), scratch HOME
 set -u
 D="$(cd "$(dirname "$0")" && pwd)"
@@ -15,10 +16,25 @@ codex_run() {
       -o "$R/final.txt" "$P" < /dev/null > "$R/agent.log" 2> "$R/agent.err" )
 }
 
+codex_sandboxed_run() {
+  local REAL="$HOME" SH rc
+  SH=$(mktemp -d /tmp/chome-XXXXXX)
+  mkdir -p "$SH/.codex"
+  for file in auth.json config.toml; do
+    if [[ -f "$REAL/.codex/$file" ]]; then
+      cp "$REAL/.codex/$file" "$SH/.codex/$file"
+    fi
+  done
+  ( cd "$W" && export HOME="$SH" CODEX_HOME="$SH/.codex" && sandbox-exec -D HOME="$REAL" -D AGENT_INSTALL="$SH/.codex" -f "$D/sandbox/agent.sb" \
+      timeout $TO codex exec --skip-git-repo-check --dangerously-bypass-approvals-and-sandbox -C "$W" --json \
+      -o "$R/final.txt" "$P" < /dev/null > "$R/agent.log" 2> "$R/agent.err" )
+  rc=$?; rm -rf "$SH"; return $rc
+}
+
 # Kimi's output goes to Moonshot: its shell runs under sandbox/agent.sb with an empty scratch HOME.
 kimi_run() {
   local REAL="$HOME" SH; SH=$(mktemp -d /tmp/khome-XXXXXX)
-  ( cd "$W" && export HOME="$SH" && sandbox-exec -D HOME="$REAL" -f "$D/sandbox/agent.sb" \
+  ( cd "$W" && export HOME="$SH" && sandbox-exec -D HOME="$REAL" -D AGENT_INSTALL="$REAL/.kimi-code" -f "$D/sandbox/agent.sb" \
       env KIMI_CODE_HOME="$REAL/.kimi-code" timeout $TO "$REAL/.kimi-code/bin/kimi" -p "$P" --output-format stream-json \
       < /dev/null > "$R/agent.log" 2> "$R/agent.err" )
   local rc=$?; rm -rf "$SH"; return $rc
@@ -27,6 +43,7 @@ kimi_run() {
 start=$(date +%s)
 case $A in
   codex) codex_run;;
+  codex-sandboxed) codex_sandboxed_run;;
   kimi)  kimi_run;;
   *) echo "unknown lane $A"; exit 2;;
 esac
diff --git a/sandbox/agent.sb b/sandbox/agent.sb
index 3a517dd..b165702 100644
--- a/sandbox/agent.sb
+++ b/sandbox/agent.sb
@@ -1,9 +1,10 @@
 ;; OS-level fence for lanes whose output leaves the machine: the agent has a real shell, so the real home must be
-;; unreachable. Only the agent's own install is opened. Network stays open. HOME is passed with -D HOME=<real home>.
+;; unreachable. Only the agent's own install is opened. Network stays open.
+;; HOME is the real home; AGENT_INSTALL is the lane's allowed install path.
 (version 1)
 (allow default)
 (deny file-read-data (subpath (param "HOME")))
 (deny file-write* (subpath (param "HOME")))
-(allow file-read-data (subpath (string-append (param "HOME") "/.kimi-code")))
-(allow file-write* (subpath (string-append (param "HOME") "/.kimi-code")))
+(allow file-read-data (subpath (param "AGENT_INSTALL")))
+(allow file-write* (subpath (param "AGENT_INSTALL")))
 (deny process-exec (literal "/bin/launchctl") (literal "/usr/bin/security") (literal "/usr/bin/osascript"))
