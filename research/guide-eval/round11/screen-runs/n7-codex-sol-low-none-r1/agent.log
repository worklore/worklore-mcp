quest, type CosignState, type CosignVerification, type CustodyMigrationChain, type CustodyMigrationState, type DistributionClaimBody, type DistributionClaimContent, type DistributionRule, type DistributionRulesState, type EarnBuild, type EarnBuildBody, type EarnBuildContent, type EarnOpportunitiesContent, type EarnOpportunity, type EarnPosition, type EarnPositionParams, type EarnProviderId, type EarnProvidersContent, type EarnTxParams, type EarnWithdrawUnit, type EnabledAssetRecord, type EnabledAssetsState, type EncryptedCardSecrets, FreighterAdapter, type InteractiveAuthAdapter, type KeyManager, type KeyManagerOptions, type KycDecisionStatus, type KycFlow, type KycLevel, type KycProvider, type KycStartBody, type KycStartResponse, type KycStatus, type KycStatusContent, type LocalStorageAdapterOptions, type LogLevel, type NetworkState, OnStorageDegrade, POLLAR_CORE_VERSION, type PasskeyCeremony, type PasskeyMode, type PasskeySigner, type PendingConfirmation, type PollarAdapter, type PollarAdapters, type PollarApiClient, PollarApiError, type PollarApplicationConfigContent, type PollarApplicationConfigResponse, type PollarAuthMethod, type PollarAuthProvider, PollarClient, type PollarClientConfig, PollarFlowError, type PollarLogger, type PollarLoginOptions, PollarNetworkError, type PollarPersistedSession, type PollarPersistedWallet, type PollarRetryConfig, type PollarUserProfile, type ProviderAuthState, type ProviderRegistration, type ProviderRegistrationSubmitted, type PublicEcJwk, type RampAsset, RampChain, type RampDirection, type RampFailure, type RampFiat, type RampFiatInstructions, type RampField, type RampLegKind, type RampOrder, type RampOrderLeg, type RampOrderLegStep, type RampOrderRequest, type RampOrderState, type RampOrdersPage, type RampOrdersQuery, type RampPendingAction, type RampQuote, type RampQuoteLeg, type RampQuoteRejection, type RampQuoteRequest, type RampQuoteRequirement, type RampQuotesResponse, type RampRoute, type RampRoutesResponse, type RampScannable, type RampSignatureAction, type RampSigningHandler, type RampWalletSetup, type RampWalletSetupChain, type RampWalletStep, type RecoveryPasskeyCeremony, type RecoveryState, type RegistryCheck, type RegistryCheckEdit, type RegistryCheckPrefill, type RegistryCheckSubmitted, type RequirementForm, type RequirementFormAnswerError, type RequirementFormAnswers, type RequirementFormField, type RequirementFormSubmitted, type RulePeriod, type SendPaymentParams, type Sep10Proof, type Sep10SignParams, type SessionInfo, type SessionsState, type SetupRecognition, type SignAuthEntryOptions, type SignAuthEntryOutcome, type SignAuthEntryResponse, type SignMessageOptions, type SignMessageResponse, type SignOutcome, type SignTransactionOptions, type SignTransactionResponse, type SolanaSignInInput, type SolanaSignInOutput, type SolanaSignMessageResponse, type StellarBalance, StellarClient, type StellarClientConfig, type StellarMessageProof, type StellarNetwork, type StellarSepApi, Storage, type SubmitOutcome, type SwapConfigContent, type SwapProvider, type SwapQuote, type SwapQuoteBody, type SwapQuoteContent, type SwapQuoteParams, type SwapToken, type SwapTokensContent, type SwapVenue, type TransactionState, type TrustlineOutcome, type TxBuildBody, type TxBuildContent, type TxBuildResponse, type TxBuildSignSubmitBody, type TxBuildSignSubmitContent, type TxBuildSignSubmitResponse, type TxErrorPhase, type TxHistoryContent, type TxHistoryParams, type TxHistoryRecord, type TxHistoryState, type TxSignAndSendBody, type TxSignBody, type TxSignContent, type TxSignResponse, type TxSignSendResponse, type TxSubmitSignedBody, WALLET_NOT_READY_CODE, WALLET_REQUIRED_CODE, type WalletAdapter, type WalletAdapterMeta, type WalletAssetsAnswer, type WalletAssetsContent, type WalletBalanceAnswer, type WalletBalanceContent, type WalletBalanceRecord, type WalletBalanceState, type WalletChain, type WalletId, type WalletInfo, type WalletProvisioning, WalletType, WebCryptoKeyManager, appUnavailableMessage, assertRampStellarSigner, buildEarnTx, buildProof, canonicalEcJwk, claimDistributionRule, compressedPublicKeyHex, computeJwkThumbprint, cosignRefusalMessage, createCardFunding, createCardHolder, createCardSecretsSession, createLocalStorageAdapter, createLogger, createMemoryAdapter, createRampOrder, defaultKeyManager, defaultStorage, describeRampAction, encodeStamp, fromBaseUnits, getAppRequirements, getCardBalance, getCardDepositAddresses, getCardFunding, getCardHolder, getCardOccupations, getCardProviderRegistration, getCardProviders, getCardRequirements, getCardSecrets, getCardSecretsPublicKey, getCardTransactions, getCards, getEarnOpportunities, getEarnPosition, getEarnProviders, getKycProviders, getKycStatus, getProviderRegistration, getRampOrder, getRampRoutes, getRegistryCheck, getRequirementForm, getSwapConfig, getSwapTokens, isInteractiveAuthAdapter, isPollarApiError, isPollarClient, isPollarNetworkError, isRampOrderSettled, isValidSession, isWalletNotReady, isWalletRequired, issueCard, listCardFundings, listDistributionRules, listRampOrders, normalizeHtu, openCardSecrets, pollKycDecision, pollKycStatus, pollRampOrder, type paths as pollarPaths, quoteRamp, quoteSwap, rampCountries, rampFieldError, rampFieldValid, rampLegNote, rampLegStatus, rampLegTimeLeft, rampLegTitle, rampNextApproval, rampNoRouteText, rampOrderReceive, rampOrderResolutionText, rampOrderStopped, rampQuoteFields, rampRailLabel, rampRequirementCopy, rampResolutionText, rampStepStatusText, rampStepTitle, rampTrustlineAsset, rampTrustlineErrorText, rampWalletStep, rawSignatureToDer, recognizedSetupRequest, resolveKyc, startKyc, stellarAccountBytes, stellarTransactionHashHex, submitCardFundingSignature, submitCardKyc, submitCardProviderRegistration, submitProviderRegistration, submitRampLegSignature, submitRegistryCheck, submitRequirementForm, toBaseUnits, transactionErrorMessage };\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,105p' node_modules/@pollar/core/README.md; sed -n '760,815p' node_modules/@pollar/core/README.md; sed -n '17565,17600p' node_modules/@pollar/core/dist/index.d.mts; sed -n '17440,17470p' node_modules/@pollar/core/dist/index.d.mts; sed -n '16530,16555p' node_modules/@pollar/core/dist/index.d.mts\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,105p' node_modules/@pollar/core/README.md; sed -n '760,815p' node_modules/@pollar/core/README.md; sed -n '17565,17600p' node_modules/@pollar/core/dist/index.d.mts; sed -n '17440,17470p' node_modules/@pollar/core/dist/index.d.mts; sed -n '16530,16555p' node_modules/@pollar/core/dist/index.d.mts\"","aggregated_output":"# @pollar/core\n\nCore SDK for [Pollar](https://pollar.xyz) — authentication and transaction utilities for Stellar and Solana applications.\n\n## Solana\n\nPollar runs on Solana end to end for wallets and payments:\n\n- **Sign in** with Phantom, Solflare or Backpack (Sign In With Solana, via `@pollar/solana-wallet-standard-adapter`), or\n  with email / Google / GitHub to get a **Pollar-managed Solana wallet**, with no seed phrase.\n- **Turnkey co-signed wallets** (mainnet): every signature is a 2-of-2 vote between the user's device and Pollar, and the\n  device verifies the transaction, including Solana CCTP burns, before it votes.\n- **Hold, send and receive SOL and SPL tokens** with `sendPayment()` and the drop-in React modals, with **app-sponsored\n  fees** and token accounts created for the recipient.\n- **Fiat on/off-ramps to Solana**: Bolivia (BOB, via Stereum + CCTP) and Brazil (BRL via Pix, PagFinance).\n\n> **0.12.0** calls sdk-api **`/v3`** (`baseUrl` stays an origin) and warns once on a `Deprecation` header.\n> **Ramps are orders**: `getRampRoutes(direction)`, `quoteRamp`, `rampQuoteFields`, `createRampOrder`,\n> `getRampOrder`, `listRampOrders`, `pollRampOrder` and `signRampLeg` replace the 0.11.x ramp methods, a ramp leg\n> is signed only through a handler the app registers (`registerRampSigningHandler`, `assertRampStellarSigner`),\n> and `@pollar/core/ramps` defines a server-side ramp provider adapter. **Wallets the user holds**:\n> `createWallet({ custody })`, `client.cosign.switchCustody()`, `client.cosign.recovery` (passkeys, email code,\n> device enrollment, phrase export) and `client.cosign.migrateWallets()` for a custodial wallet moving to\n> Turnkey. The device proposes each co-signed activity (`verify()` returns `proposal`). `confirmation`\n> defaults to `'prompt'` and follows the app's dashboard; the stricter policy wins. **Breaking**; see\n> [UPGRADE.md](../../UPGRADE.md).\n>\n> Earlier: **0.11.5**. **Turnkey co-signed wallets** and a\n> **confirmation policy**: `config.confirmation` `'auto'` (default; a co-signed wallet's device verifies\n> against Turnkey and votes on its own) or `'prompt'` (every signature waits for the user, through\n> `onConfirmationRequest()`); `config.cosignManual` keeps the raw `{ status: 'cosign_pending', request }`\n> flow; `client.cosign` verifies Stellar, Solana and Polygon requests on the device before voting. Also\n> `retryRampTransaction()`, `transactionErrorMessage()`, and Solana sends from a wallet the user signs\n> with. See [UPGRADE.md](../../UPGRADE.md).\n>\n> Earlier: **0.11.4**. **KYC by ramp corridor**: the v2 ramp quote\n> types `requirementsRequired` (the first step a route still needs) and `unavailable` (providers that\n> failed to quote just now); new requirement methods (`getAppRequirements`, `getRequirementForm` /\n> `submitRequirementForm`, `getRegistryCheck` / `submitRegistryCheck`, `getProviderRegistration` /\n> `submitProviderRegistration`); corridor-scoped KYC (`corridorId` on the status, providers and\n> resolve calls); typed KYC errors (`PollarApiError`), `KycStatus` gains `'expired'`, and\n> `pollKycDecision()` returns the settled read. **Behaviour change:** `pollKycStatus()` now also returns\n> on manual review (`'pending'`) and on expiry (`'expired'`) - see [UPGRADE.md](../../UPGRADE.md).\n> Licensed under Apache-2.0 from this release.\n>\n> **Wallet provisioning** (non-breaking). The platform now creates an end-user's Stellar account\n> **in the background** instead of inside `POST /auth/login`, so a login returns before the\n> account is on the ledger. New API for that window: `wallet.provisioning`\n> (`'READY' | 'CREATING' | 'FAILED'`) on `getWallet()` / `getWallets()` and the persisted session\n>\n> - the ACCOUNT only, never trustlines; `onWalletStateChange(cb)`, which fires on the transition\n>   and replays the current value on subscribe, the same contract as `onAuthStateChange`;\n>   `refreshWalletState()` for a host that knows better than a timer; and `isWalletNotReady()` +\n>   `WALLET_NOT_READY_CODE`, which name the `SDK_WALLET_NOT_READY` (409) the server returns for an\n>   on-chain operation attempted before the account lands. The client polls `GET /v3/wallet/state`\n>   while a wallet is `CREATING` and stops on `READY`/`FAILED`, on logout and on `destroy()`.\n>   Also: **a DPoP proof the server rejects over clock skew is re-signed instead of clearing the\n>   session** - an `iat-skew` 401 on `/auth/refresh` was logging the user out even though the same\n>   response had just taught the client the right offset; the learned offset is now persisted next\n>   to the nonce. Every request carries **`x-pollar-sdk`** (`core/<version> <web|rn|node>`), which\n>   needs an sdk-api that lists it in CORS `allowHeaders`. New config: `loginTimeoutMs` (45s),\n>   replacing the 10s `requestTimeoutMs` on login alone.\n>\n> **Cards** (additive): `getCardProviders()`, `getCardRequirements()`, `createCardHolder()`,\n> `submitCardKyc()`, `issueCard()`, `getCards()`, `getCardBalance()`, `getCardTransactions()`,\n> `fundCard()` and the rest of the card methods. `revealCardSecrets()` decrypts the card number and\n> CVC on the device with a one-shot key the server never sees, on WebCrypto or in plain JavaScript\n> on React Native. **Wallets on demand**: for an app that creates wallets on demand or never, a\n> session without a wallet restores as signed in (`provisioning: 'NONE'`), `hasWallet()` says\n> whether there is one on any chain, `createWallet()` creates it, and `isWalletRequired()` names the\n> `SDK_WALLET_REQUIRED` a signing call returns without one.\n>\n> Earlier: **0.11.3** was a patch focused on session resilience. A session\n> **survives reloads when the DPoP keypair fails to persist**: the persisted session records\n> the thumbprint of the key its tokens are bound to (`dpopJkt`), a mismatch is detected\n> locally instead of looping through 401s, and clearing a session no longer destroys the\n> keypair. `logout()` cancels a login still in flight, never destroys a session created while\n> it runs, rotates the keypair only when it still owns the teardown, and propagates to\n> sibling clients in the same document. Shared session-row writes are serialized and\n> ownership-gated, and the last server-issued `DPoP-Nonce` is persisted. New public API:\n> `setPasskeyDefaults()` on `PollarClient`, and `isPollarClient(value)`, a type guard that\n> recognizes a client even across duplicate copies of this package (`instanceof` cannot).\n>\n> Earlier: **0.11.2** added `client.stellar` — **SEP-53 message** and **SEP-10 challenge** ownership\n> proofs. External wallets sign client-side through their adapter (new optional\n> `signStellarMessage` on `WalletAdapter`; Freighter implements it, Albedo has no SEP-53\n> support), embedded wallets sign server-side, and both return the same `sep53` scheme so a\n> verifier treats them alike. Also: `@stellar/freighter-api` bumped to 6.0.0. Non-breaking.\n> New exported types: `StellarSepApi`, `StellarMessageProof`, `Sep10SignParams`, `Sep10Proof`,\n> `SignMessageOptions`, `SignMessageResponse`.\n>\n> Earlier: **0.11.1** reworked the multichain wallet responses. **Breaking:**\n> `WalletBalanceRecord.balance` and `.available` are `string | null` - `null` means the chain\n> could not be read, and must render as unavailable rather than as `0`. Every chain reports its\n> native coin plus each token the app enabled (0.11.0 reported only the native token off\n> Stellar), and balances gained `decimals`, `limit` and `sponsored`. `signTx` accepts\n> `skipSponsorship`. **0.11.0** went multichain\n> (Solana joins Stellar) and moved every request to the `/v2` API. **0.10.0** unified external wallets into `walletAdapters: WalletAdapter[]` and\n> removed the singular `walletAdapter` resolver and `client.loginWallet()`.\n>\n> See [UPGRADE.md](../../UPGRADE.md) for migration steps and the\n> [CHANGELOG](../../CHANGELOG.md) for the full version history before upgrading.\n\n## Installation\n\n\nA ramp is an order of one or more legs that Pollar runs server-side: the\nprovider's leg (fiat in or out), and a swap or a bridge when the asset or chain\nthe user wants is not the provider's. Pick a pair from the routes, quote it,\nturn the quote the user accepts into an order, and follow the order.\n\n```ts\nimport { describeRampAction, rampQuoteFields } from '@pollar/core';\n\nconst { routes } = await client.getRampRoutes('ONRAMP');\nconst { fiat, asset } = routes[0];\nconst { quotes, rejected } = await client.quoteRamp({\n  direction: 'ONRAMP',\n  fiat: { currency: fiat.currency, rail: fiat.rail, country: fiat.country },\n  asset: { code: asset.code, identifier: asset.identifier, chain: asset.chain },\n  amount: { value: '100', denomination: 'in' }, // 'out' fixes what the user receives\n});\n// Ask the user for rampQuoteFields(quotes[0]) and send the answers as `payee`.\nconst order = await client.createRampOrder({ quoteId: quotes[0].quoteId, payee: { name: 'Ana Perez' } });\nawait client.pollRampOrder(order.id, { onUpdate: (o) => render(describeRampAction(o)) });\n```\n\n- `pendingAction` says what the order waits for: `FIAT_PAYMENT` (a QR, already\n  rendered in `instructions.scannable`, or bank details), `SIGNATURE` (sign with\n  `signRampLeg(orderId, actionId)` from an explicit Authorize),\n  `COSIGN_APPROVAL` (vote on it like any co-sign request) or `KYC` (a link).\n- `nextPollAfter` is when to read the order again; `pollRampOrder` follows it\n  and stops once the order settles.\n- A failure carries `resolutionAction`; `rampResolutionText(failure)` turns it\n  into what the user can do. `rampLegTitle` and `rampLegStatus` describe each leg.\n- A payee the provider would refuse answers `400 VALIDATION_ERROR` with the\n  reason in `body.message`; a quote with no route answers `422\nSDK_RAMPS_NO_ROUTE` with `body.rejected`.\n- `listRampOrders({ pending: 'true' })` returns the orders waiting on the user.\n\n### Ramp adapters\n\nTo build a provider package for Pollar's backend, use `RampAdapter`, `defineRampAdapter` and `defineRampAdapterRegistration` from `@pollar/core` or `@pollar/core/ramps`. Install its server registration in the backend; its rails then appear in the routes above. Pollar retains credentials, persistence, lifecycle and reconciliation. See the [server registration guide](../../docs/development/custom-ramp-adapters.md), [provider implementation](../../examples/custom-ramp/adapter.ts) and [application example](../../examples/custom-ramp/client.ts).\n\n`RampChain` is a closed enum (`STELLAR`, `POLYGON`, `SOLANA`), independent of\nwallet networks. Use `RampChain.POLYGON` or `'POLYGON'` for a quote filter,\nroute asset or signer registration. Chain and network are separate fields;\nlowercase names, unknown chains and CAIP-2 identifiers are rejected. Adding\nanother chain requires a backend enum migration and an updated SDK contract.\nExact amount strings keep their precision and formatting.\n\nRegister a signer for each chain/encoding pair a leg may ask for with `registerRampSigningHandler(chain, encoding, async action => signedPayload)`, `STELLAR`/`xdr` included: core has no built-in ramp signer. In a Stellar signer, `assertRampStellarSigner(action, address)` refuses a transaction that does not spend from `address` (or a SEP-10 login that is not the anchor's challenge for it). Handlers must validate the payload and authorized wallet account, chain and network before returning a signed payload without broadcasting it. Polling never invokes signing.\n\nThe backend lists only the routes its configured rails, venues and bridges can run.\n\n---\n\n### Earn (yield vaults + lending)\n\nUnified access to DeFindex vaults and Blend pools behind one provider-selected API. `getEarnProviders()` returns the\nyield providers this app exposes (an empty array means Earn is disabled — hide any Earn UI); `getEarnOpportunities()`\ntype KycStatusContent = paths['/kyc/status']['get']['responses'][200]['content']['application/json']['content'];\ntype KycProvider = paths['/kyc/providers']['get']['responses'][200]['content']['application/json']['content']['providers'][number];\ntype KycStartBody = NonNullable<paths['/kyc/start']['post']['requestBody']>['content']['application/json'];\ntype KycStartResponse = paths['/kyc/start']['post']['responses'][200]['content']['application/json']['content'];\n/** Closed ramp chain catalog, independent of wallet networks. */\ndeclare const RampChain: Readonly<{\n    readonly STELLAR: \"STELLAR\";\n    readonly POLYGON: \"POLYGON\";\n    readonly SOLANA: \"SOLANA\";\n}>;\ntype RampChain = (typeof RampChain)[keyof typeof RampChain];\ntype RampsGet<P extends '/ramps/routes' | '/ramps/orders' | '/ramps/orders/{id}'> = paths[P]['get']['responses'][200]['content']['application/json']['content'];\ntype RampDirection = NonNullable<paths['/ramps/routes']['get']['parameters']['query']>['direction'];\n/** The fiat and asset pairs the app can ramp between in a direction, each with the legs of its shortest path. */\ntype RampRoutesResponse = RampsGet<'/ramps/routes'>;\ntype RampRoute = RampRoutesResponse['routes'][number];\ntype RampFiat = RampRoute['fiat'];\ntype RampAsset = RampRoute['asset'];\ntype RampLegKind = RampRoute['legs'][number];\ntype RampQuoteRequest = NonNullable<paths['/ramps/quotes']['post']['requestBody']>['content']['application/json'];\ntype RampQuotesResponse = paths['/ramps/quotes']['post']['responses'][200]['content']['application/json']['content'];\n/** One route quoted leg by leg; `quotes` come best first. */\ntype RampQuote = RampQuotesResponse['quotes'][number];\ntype RampQuoteLeg = RampQuote['legs'][number];\n/** A value the user fills in before the order; its answer goes in `payee` under `key`. */\ntype RampField = RampQuoteLeg['requiredFields'][number];\n/** A route that was planned and dropped, with why (`failure.resolutionAction`). */\ntype RampQuoteRejection = RampQuotesResponse['rejected'][number];\n/** The verification step a dropped route waits on: complete it (KYC, form, registry check, registration), then quote again. */\ntype RampQuoteRequirement = NonNullable<RampQuoteRejection['requirement']>;\ntype RampOrderRequest = NonNullable<paths['/ramps/orders']['post']['requestBody']>['content']['application/json'];\n/** An order with every leg, what it waits for (`pendingAction`) and when to read it again (`nextPollAfter`). */\ntype RampOrder = RampsGet<'/ramps/orders/{id}'>;\ntype RampOrderLeg = RampOrder['legs'][number];\ntype RampOrderLegStep = RampOrderLeg['steps'][number];\ntype RampPendingAction = NonNullable<RampOrder['pendingAction']>;\n * describe trustlines and stay Stellar-only; `decimals` is carried by Polygon and\n * Solana tokens, which need it to format raw amounts.\n *\n * `balance` is null when the chain could not be read - an unreachable RPC, not an\n * empty wallet. Render it as unavailable rather than as zero.\n */\ninterface WalletBalanceRecord {\n    chain?: WalletChain;\n    type?: 'native' | 'token' | 'credit_alphanum4' | 'credit_alphanum12';\n    code: string;\n    issuer?: string;\n    decimals?: number;\n    balance: string | null;\n    available: string | null;\n    limit?: string;\n    enabledInApp?: boolean;\n    trustlineRemoved?: boolean;\n    /** Solana only: the app fronts this token's transfer fee (`sponsor_transfer`). */\n    sponsored?: boolean;\n}\n/**\n * The authenticated user's balances. v2 is multichain: `balances` is the flat\n * list of assets across every chain the app is provisioned on, each tagged with\n * its `chain`. `multichain` is true when more than one chain is present, which is\n * the signal the UI uses to show a per-asset network tag. `exists` is true when\n * any chain holds an account/balance; `network` / `publicKey` reflect the Stellar\n * wallet (the primary chain).\n */\ninterface WalletBalanceContent {\n    publicKey: string;\n    network: string;\n            address: string;\n        } | null;\n    };\n}\ninterface PollarClientConfig {\n    stellarNetwork?: StellarNetwork;\n    baseUrl?: string;\n    apiKey: string;\n    /**\n     * Pluggable storage. Defaults to `defaultStorage()` on web (localStorage\n     * with memory fallback). On RN you must inject one of the adapters from\n     * `@pollar/core/adapters/expo` or `@pollar/core/adapters/react-native-keychain`.\n     */\n    storage?: Storage;\n    /**\n     * Max time (ms) a single SDK HTTP attempt waits before aborting and rejecting\n     * with a {@link PollarNetworkError} (`code: 'SDK_NETWORK_TIMEOUT'`).\n     *\n     * `fetch` has no timeout of its own, so without this a transient connection\n     * stall (e.g. a dropped TCP SYN on a flaky mobile network at cold start) hangs\n     * the request forever - it neither resolves nor rejects, trapping any caller\n     * that `await`s it (a returning user stuck on the splash screen). Bounding it\n     * lets the request fail fast so the caller can recover (retry, or fall back to\n     * a cached token).\n     *\n     * Defaults to `10000` (10s). Set `0` to disable (NOT recommended - restores\n","exit_code":0,"status":"completed"}}
