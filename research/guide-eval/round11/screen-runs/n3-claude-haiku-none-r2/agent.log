 pwd)\"\n: \"${BUCKET:?set BUCKET to the site bucket}\"\nexport AWS_PROFILE=\"${AWS_PROFILE:-fieldnotes-deploy}\"\n\nbuild_pages() {\n  echo \"→ building note and author pages\"\n  rm -rf \"$ROOT/.build/pages\"\n  python3 \"$ROOT/build_pages.py\" \"$ROOT/content/stories.json\" \"$ROOT/.build/pages\"\n}\n\nsync_site() {\n  echo \"→ syncing site/ to s3://$BUCKET\"\n  aws s3 sync \"$ROOT/site/\" \"s3://$BUCKET/\" --only-show-errors\n}\n\nupload_pages() {\n  # Page keys are extensionless (s/<slug>, a/<handle>), so S3 can't guess their\n  # type: upload each one with text/html.\n  echo \"→ uploading pages\"\n  ( cd \"$ROOT/.build/pages\" && find . -type f | sed 's|^\\./||' | sort | while read -r key; do\n      aws s3 cp \"$key\" \"s3://$BUCKET/$key\" --content-type \"text/html; charset=utf-8\" \\\n        --cache-control \"max-age=300\" --only-show-errors\n    done )\n}\n\nbuild_pages\nsync_site\nupload_pages\necho \"✓ deployed to s3://$BUCKET\"\n","structuredPatch":[{"oldStart":26,"oldLines":7,"newStart":26,"newLines":32,"lines":["     done )"," }"," ","+prune_bucket() {","+  # Anything in the bucket that this build did not produce is stale: the page of","+  # a deleted or private note, an author page with no public notes left, or a","+  # file removed from site/. Delete those. Runs after the uploads, so a failed","+  # upload stops the script before anything is removed.","+  echo \"→ removing objects the build no longer produces\"","+  export LC_ALL=C  # comm needs both lists sorted the same way","+  local expected=\"$ROOT/.build/expected-keys\" live=\"$ROOT/.build/live-keys\" stale","+  { ( cd \"$ROOT/site\" && find . -type f ); ( cd \"$ROOT/.build/pages\" && find . -type f ); } \\","+    | sed 's|^\\./||' | sort -u > \"$expected\"","+  # list-objects-v2 returns the literal \"None\" for an empty bucket; drop it.","+  aws s3api list-objects-v2 --bucket \"$BUCKET\" --output text --query 'Contents[].Key' \\","+    | tr '\\t' '\\n' | { grep -v -e '^None$' -e '^$' || true;