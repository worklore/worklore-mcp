i-docs/src/01_effect/04_errors/20_reason-errors.ts\nnode_modules/effect/ai-docs/src/01_effect/07_pubsub/10_pubsub.ts\nnode_modules/effect/ai-docs/src/01_effect/07_pubsub/index.md\nv26.13.0\n","exit_code":0,"status":"completed"}}
