{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"rg -n -F 'Reading API keys from the macOS Keychain' /Users/valentinakoniukhova/.local/pipx/venvs/mistral-vibe/lib/python3.14/site-packages/vibe; sed -n '1,130p' /Users/valentinakoniukhova/.local/pipx/venvs/mistral-vibe/lib/python3.14/site-packages/vibe/utils/api_keys.py; sed -n '150,260p' /Users/valentinakoniukhova/.local/pipx/venvs/mistral-vibe/lib/python3.14/site-packages/vibe/setup/auth/api_key_persistence.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"rg -n -F 'Reading API keys from the macOS Keychain' /Users/valentinakoniukhova/.local/pipx/venvs/mistral-vibe/lib/python3.14/site-packages/vibe; sed -n '1,130p' /Users/valentinakoniukhova/.local/pipx/venvs/mistral-vibe/lib/python3.14/site-packages/vibe/utils/api_keys.py; sed -n '150,260p' /Users/valentinakoniukhova/.local/pipx/venvs/mistral-vibe/lib/python3.14/site-packages/vibe/setup/auth/api_key_persistence.py\"","aggregated_output":"from __future__ import annotations\n\nfrom collections.abc import Iterator, Mapping\nfrom contextlib import contextmanager\nfrom contextvars import ContextVar\nfrom dataclasses import dataclass\nfrom enum import StrEnum\nimport os\nfrom types import MappingProxyType\n\nfrom vibe.utils.keyring import get_api_key_from_keyring\nfrom vibe.utils.oidc_marker import oidc_enabled\nfrom vibe.utils.secrets import holding_secrets\n\n\nclass ApiKeySource(StrEnum):\n    \"\"\"The places ``resolve_api_key`` looks, in the order it looks.\"\"\"\n\n    SESSION = \"session\"\n    ENVIRONMENT = \"environment\"\n    KEYRING = \"keyring\"\n    OIDC = \"oidc\"\n\n\n@dataclass(frozen=True, slots=True)\nclass ApiKeyOrigin:\n    \"\"\"Where one resolved key came from, and under which name.\n\n    ``env_var`` keys both sources, so it alone cannot say which answered. The\n    pair can, and the difference is what a user acts on: an environment\n    variable may hold a value they never set, while a keyring key is replaced\n    by running setup again.\n    \"\"\"\n\n    source: ApiKeySource\n    env_var: str\n\n    def describe(self) -> str:\n        match self.source:\n            case ApiKeySource.SESSION:\n                return f\"the run's credential {self.env_var}\"\n            case ApiKeySource.ENVIRONMENT:\n                return f\"env var {self.env_var}\"\n            case ApiKeySource.KEYRING:\n                return \"the keyring\"\n            case ApiKeySource.OIDC:\n                return \"the CLI OIDC session\"\n\n\n# The credentials of the code running in this context, by environment variable\n# name. Asyncio tasks and to_thread workers inherit it, so one process can run\n# sessions that each send their own key.\n_session_credentials: ContextVar[Mapping[str, str] | None] = ContextVar(\n    \"session_credentials\", default=None\n)\n\n\n@contextmanager\ndef session_credentials(values: Mapping[str, str]) -> Iterator[None]:\n    \"\"\"Resolve API keys from ``values`` first, inside this context only.\n\n    ``values`` maps an environment variable name, as a provider's\n    ``api_key_env_var`` names it, to its value. They are never written to\n    ``os.environ``, and the logs redact them while the context lasts. Must be\n    entered and left in the same context, as a ``ContextVar`` is.\n    \"\"\"\n    with holding_secrets(values.values()):\n        token = _session_credentials.set(MappingProxyType(dict(values)))\n        try:\n            yield\n        finally:\n            _session_credentials.reset(token)\n\n\ndef active_api_key(\n    *, env_value: str | None, keyring_value: str | None\n) -> tuple[ApiKeySource, str] | None:\n    \"\"\"The winning credential and its source, or ``None`` when neither holds one.\n\n    The precedence rule shared by resolution and ``/status``: a truthy\n    environment value wins, otherwise the keyring decides. Inputs are\n    already-collected values, so callers own when (and whether) the keyring\n    is read — resolution touches it only when the environment holds nothing.\n    \"\"\"\n    if env_value:\n        return ApiKeySource.ENVIRONMENT, env_value\n    if keyring_value:\n        return ApiKeySource.KEYRING, keyring_value\n    return None\n\n\ndef resolve_api_key_with_origin(env_key: str) -> tuple[str, ApiKeyOrigin] | None:\n    \"\"\"The key for ``env_key`` and where it was read from, or ``None``.\n\n    The one place the precedence lives, so a key and its reported origin can\n    never disagree: the session's credentials, then ``active_api_key``'s\n    env-wins rule. The keyring read goes through its process-wide cache, so\n    asking again after a failed call costs nothing — and happens only when\n    neither the session nor the environment holds a value.\n    \"\"\"\n    if not env_key:\n        return None\n    if env_key == \"MISTRAL_API_KEY\" and oidc_enabled():\n        from vibe.setup.auth._oidc_runtime import stored_oidc_credential\n\n        token = stored_oidc_credential()\n        return (token, ApiKeyOrigin(ApiKeySource.OIDC, env_key)) if token else None\n    credentials = _session_credentials.get()\n    if credentials is not None and (token := credentials.get(env_key)):\n        return token, ApiKeyOrigin(ApiKeySource.SESSION, env_key)\n    env_value = os.environ.get(env_key)\n    keyring_value = None if env_value else get_api_key_from_keyring(env_key)\n    resolved = active_api_key(env_value=env_value, keyring_value=keyring_value)\n    if resolved is None:\n        return None\n    source, token = resolved\n    return token, ApiKeyOrigin(source, env_key)\n\n\ndef resolve_api_key(env_key: str) -> str | None:\n    resolved = resolve_api_key_with_origin(env_key)\n    return resolved[0] if resolved else None\n\n    provider: ProviderConfig\n    console_base_url: str | None = None\n    vibe_base_url: str | None = None\n\n\n@dataclass(frozen=True, slots=True)\nclass ProviderCredentialsPersistResult:\n    \"\"\"Per-field outcome of a batched persist call.\n\n    ``None`` means \"not requested\" (caller passed ``None`` on the request);\n    ``True``/``False`` means \"attempted, succeeded/failed\".\n    \"\"\"\n\n    provider: bool\n    console_base_url: bool | None = None\n    vibe_base_url: bool | None = None\n\n    @property\n    def all_requested_succeeded(self) -> bool:\n        return (\n            self.provider\n            and self.console_base_url is not False\n            and self.vibe_base_url is not False\n        )\n\n    def first_failure(self) -> str | None:\n        if not self.provider:\n            return \"provider\"\n        if self.console_base_url is False:\n            return \"console_base_url\"\n        if self.vibe_base_url is False:\n            return \"vibe_base_url\"\n        return None\n\n\ndef persist_provider_to_config(provider: ProviderConfig) -> bool:\n    \"\"\"Sync wrapper around ``apply_provider_to_config`` for legacy callers.\n\n    Production code should prefer :func:`persist_provider_credentials`, which\n    batches multiple field writes against a single orchestrator.\n    \"\"\"\n    orchestrator = run_sync(build_default_orchestrator())\n    return run_sync(apply_provider_to_config(orchestrator, provider))\n\n\nasync def persist_provider_credentials(\n    request: ProviderCredentialsPersistRequest, *, reason: str = \"onboarding\"\n) -> ProviderCredentialsPersistResult:\n    \"\"\"Persist provider + optional console/vibe URLs against a single orchestrator.\n\n    Writes run sequentially against one orchestrator instance so we don't pay\n    three separate config-build round-trips. Partial failure is reported per\n    field so callers can tell the user which pieces of state did/didn't land.\n    \"\"\"\n    orchestrator = await build_default_orchestrator()\n    provider_ok = await apply_provider_to_config(\n        orchestrator, request.provider, reason=reason\n    )\n    console_ok: bool | None = None\n    if request.console_base_url is not None:\n        console_ok = await apply_console_base_url(\n            orchestrator, request.console_base_url, reason=reason\n        )\n    vibe_ok: bool | None = None\n    if request.vibe_base_url is not None:\n        vibe_ok = await apply_vibe_base_url(\n            orchestrator, request.vibe_base_url, reason=reason\n        )\n    return ProviderCredentialsPersistResult(\n        provider=provider_ok, console_base_url=console_ok, vibe_base_url=vibe_ok\n    )\n\n\ndef persist_api_key(\n    provider: ProviderConfig,\n    api_key: str,\n    *,\n    launch_context: LaunchContext | None = None,\n    custom_domain: bool = False,\n    orchestrator: ConfigOrchestrator[VibeConfigSchema] | None = None,\n) -> str:\n    env_key = provider.api_key_env_var\n    if not env_key:\n        return \"env_var_error:<empty>\"\n    try:\n        os.environ[env_key] = api_key\n    except ValueError:\n        return f\"env_var_error:{env_key}\"\n    try:\n        set_api_key_in_keyring(env_key, api_key)\n    except KeyringError:\n        try:\n            _save_api_key_to_env_file(env_key, api_key)\n        except (OSError, ValueError) as err:\n            # Nothing persisted, so the value lives only in this process's\n            # environment; /status reports it as the process environment.\n            return f\"save_error:{err}\"\n        else:\n            record_env_value_origin(env_key, api_key, EnvValueOrigin.VIBE_HOME_ENV_FILE)\n    else:\n        record_env_value_origin(env_key, api_key, EnvValueOrigin.OS_KEYRING)\n        # The key is safely stored in the keyring; drop any stale plaintext copy.\n        try:\n            _remove_api_key_from_env_file(env_key)\n        except (OSError, ValueError) as err:\n            logger.error(\n                \"Failed to remove stale plaintext API key from env file\", exc_info=err\n            )\n    if provider.backend == Backend.MISTRAL:\n        try:\n","exit_code":0,"status":"completed"}}
