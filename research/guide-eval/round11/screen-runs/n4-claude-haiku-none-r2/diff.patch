-Codex logs in with an API key from the environment (`CODEX_API_KEY`), so it
-needs nothing from the home folder.
+The profile takes the one real-home path a lane may open as `-D OPEN=<path>`:
+kimi opens `~/.kimi-code`, `codex-sandboxed` opens its scratch dir.
+
+The plain `codex` lane logs in with the ChatGPT login in `~/.codex`.
diff --git a/run.sh b/run.sh
index c41ad67..0c2fcb5 100755
--- a/run.sh
+++ b/run.sh
@@ -1,7 +1,9 @@
 #!/usr/bin/env bash
 # usage: run.sh <task> <lane> [rep]
-# lanes: codex   Codex CLI, unsandboxed
-#        kimi    Kimi Code under sandbox/agent.sb (no reading or writing the real home), scratch HOME
+# lanes: codex            Codex CLI, unsandboxed
+#        codex-sandboxed  the same Codex run under sandbox/agent.sb (no reading or writing the real home), scratch HOME;
+#                         needs CODEX_API_KEY in the environment, since the ChatGPT login lives in the real home
+#        kimi             Kimi Code under sandbox/agent.sb (no reading or writing the real home), scratch HOME
 set -u
 D="$(cd "$(dirname "$0")" && pwd)"
 T=$1; A=$2; REP=${3:-1}
@@ -15,10 +17,21 @@ codex_run() {
       -o "$R/final.txt" "$P" < /dev/null > "$R/agent.log" 2> "$R/agent.err" )
 }
 
+# Same Codex run, but its process and shell run under sandbox/agent.sb with an empty scratch HOME and CODEX_HOME.
+# Nothing under the real home is opened (OPEN is the scratch dir), so auth comes from CODEX_API_KEY, not ~/.codex.
+codex_sandboxed_run() {
+  local REAL="$HOME" SH; SH=$(mktemp -d /tmp/chome-XXXXXX); mkdir -p "$SH/.codex"
+  ( cd "$W" && export HOME="$SH" CODEX_HOME="$SH/.codex" && sandbox-exec -D HOME="$REAL" -D OPEN="$SH" -f "$D/sandbox/agent.sb" \
+      timeout $TO codex exec --skip-git-repo-check --dangerously-bypass-approvals-and-sandbox -C "$W" --json \
+      -o "$R/final.txt" "$P" < /dev/null > "$R/agent.log" 2> "$R/agent.err" )
+  local rc=$?; rm -rf "$SH"; return $rc
+}
+
 # Kimi's output goes to Moonshot: its shell runs under sandbox/agent.sb with an empty scratch HOME.
+# Its only real-home path in the profile is its own install, ~/.kimi-code.
 kimi_run() {
   local REAL="$HOME" SH; SH=$(mktemp -d /tmp/khome-XXXXXX)
-  ( cd "$W" && export HOME="$SH" && sandbox-exec -D HOME="$REAL" -f "$D/sandbox/agent.sb" \
+  ( cd "$W" && export HOME="$SH" && sandbox-exec -D HOME="$REAL" -D OPEN="$REAL/.kimi-code" -f "$D/sandbox/agent.sb" \
       env KIMI_CODE_HOME="$REAL/.kimi-code" timeout $TO "$REAL/.kimi-code/bin/kimi" -p "$P" --output-format stream-json \
       < /dev/null > "$R/agent.log" 2> "$R/agent.err" )
   local rc=$?; rm -rf "$SH"; return $rc
@@ -27,6 +40,9 @@ kimi_run() {
 start=$(date +%s)
 case $A in
   codex) codex_run;;
+  codex-sandboxed)
+    [ -n "${CODEX_API_KEY:-}" ] || { echo "codex-sandboxed needs CODEX_API_KEY set (the ChatGPT login in the real home is out of its reach)" >&2; rm -rf "$W"; exit 2; }
+    codex_sandboxed_run;;
   kimi)  kimi_run;;
   *) echo "unknown lane $A"; exit 2;;
 esac
diff --git a/sandbox/agent.sb b/sandbox/agent.sb
index 3a517dd..a16cb84 100644
--- a/sandbox/agent.sb
+++ b/sandbox/agent.sb
@@ -1,9 +1,11 @@
 ;; OS-level fence for lanes whose output leaves the machine: the agent has a real shell, so the real home must be
-;; unreachable. Only the agent's own install is opened. Network stays open. HOME is passed with -D HOME=<real home>.
+;; unreachable. HOME is the real home (-D HOME=<real home>). OPEN is the one path under it that the lane's own
+;; install needs (-D OPEN=<path>): kimi passes ~/.kimi-code; codex passes a scratch dir, so nothing under the real
+;; home is opened. Network stays open.
 (version 1)
 (allow default)
 (deny file-read-data (subpath (param "HOME")))
 (deny file-write* (subpath (param "HOME")))
-(allow file-read-data (subpath (string-append (param "HOME") "/.kimi-code")))
-(allow file-write* (subpath (string-append (param "HOME") "/.kimi-code")))
+(allow file-read-data (subpath (param "OPEN")))
+(allow file-write* (subpath (param "OPEN")))
 (deny process-exec (literal "/bin/launchctl") (literal "/usr/bin/security") (literal "/usr/bin/osascript"))
