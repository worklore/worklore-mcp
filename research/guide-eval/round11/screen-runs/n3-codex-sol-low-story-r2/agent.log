{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc 'bash -n deploy.sh && python3 -m py_compile build_pages.py && git diff --check && git diff -- deploy.sh'","aggregated_output":"diff --git a/deploy.sh b/deploy.sh\nindex 431ef02..d946cab 100755\n--- a/deploy.sh\n+++ b/deploy.sh\n@@ -13,7 +13,34 @@ build_pages() {\n \n sync_site() {\n   echo \"→ syncing site/ to s3://$BUCKET\"\n-  aws s3 sync \"$ROOT/site/\" \"s3://$BUCKET/\" --only-show-errors\n+  # Generated pages live under these prefixes and are uploaded separately.\n+  aws s3 sync \"$ROOT/site/\" \"s3://$BUCKET/\" --delete \\\n+    --exclude 's/*' --exclude 'a/*' --only-show-errors\n+}\n+\n+remove_stale_pages() {\n+  echo \"→ removing stale note and author pages\"\n+  python3 - \"$ROOT/.build/pages\" \"$BUCKET\" <<'PY'\n+import json\n+import pathlib\n+import subprocess\n+import sys\n+\n+pages, bucket = pathlib.Path(sys.argv[1]), sys.argv[2]\n+current = {str(path.relative_to(pages)) for path in pages.rglob('*') if path.is_file()}\n+for prefix in ('s/', 'a/'):\n+    result = subprocess.run(\n+        ['aws', 's3api', 'list-objects-v2', '--bucket', bucket, '--prefix', prefix,\n+         '--query', 'Contents[].Key', '--output', 'json'],\n+        check=True, capture_output=True, text=True,\n+    )\n+    for key in json.loads(result.stdout) or []:\n+        if key not in current:\n+            subprocess.run(\n+                ['aws', 's3api', 'delete-object', '--bucket', bucket, '--key', key],\n+                check=True, stdout=subprocess.DEVNULL,\n+            )\n+PY\n }\n \n upload_pages() {\n@@ -29,4 +56,5 @@ upload_pages() {\n build_pages\n sync_site\n upload_pages\n+remove_stale_pages\n echo \"✓ deployed to s3://$BUCKET\"\n","exit_code":0,"status":"completed"}}
