{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc 'cat deploy.sh && cat build_pages.py'","aggregated_output":"#!/usr/bin/env bash\n# Deploy the site to S3. CI runs this on every push to main with BUCKET set.\nset -euo pipefail\nROOT=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\n: \"${BUCKET:?set BUCKET to the site bucket}\"\nexport AWS_PROFILE=\"${AWS_PROFILE:-fieldnotes-deploy}\"\n\nbuild_pages() {\n  echo \"→ building note and author pages\"\n  rm -rf \"$ROOT/.build/pages\"\n  python3 \"$ROOT/build_pages.py\" \"$ROOT/content/stories.json\" \"$ROOT/.build/pages\"\n}\n\nsync_site() {\n  echo \"→ syncing site/ to s3://$BUCKET\"\n  aws s3 sync \"$ROOT/site/\" \"s3://$BUCKET/\" --only-show-errors\n}\n\nupload_pages() {\n  # Page keys are extensionless (s/<slug>, a/<handle>), so S3 can't guess their\n  # type: upload each one with text/html.\n  echo \"→ uploading pages\"\n  ( cd \"$ROOT/.build/pages\" && find . -type f | sed 's|^\\./||' | sort | while read -r key; do\n      aws s3 cp \"$key\" \"s3://$BUCKET/$key\" --content-type \"text/html; charset=utf-8\" \\\n        --cache-control \"max-age=300\" --only-show-errors\n    done )\n}\n\nbuild_pages\nsync_site\nupload_pages\necho \"✓ deployed to s3://$BUCKET\"\n\"\"\"Prerender one page per public note (s/<slug>) and per author with a public note (a/<handle>).\nusage: build_pages.py content/stories.json .build/pages\"\"\"\nimport html, json, os, sys\n\nsrc, out = sys.argv[1], sys.argv[2]\nstories = [s for s in json.load(open(src)) if s.get(\"visibility\", \"public\") == \"public\"]\n\ndef page(title, body):\n    return (f\"<!doctype html><html><head><meta charset=utf-8><title>{html.escape(title)} · fieldnotes</title>\"\n            f\"<link rel=stylesheet href=/style.css></head><body>{body}<script src=/app.js></script></body></html>\\n\")\n\ndef write(key, text):\n    p = os.path.join(out, key)\n    os.makedirs(os.path.dirname(p), exist_ok=True)\n    with open(p, \"w\") as f:\n        f.write(text)\n\nauthors = {}\nfor s in stories:\n    write(f\"s/{s['slug']}\", page(s[\"title\"], f\"<h1>{html.escape(s['title'])}</h1><p>{html.escape(s['summary'])}</p>\"\n                                 f\"<p>by <a href=/a/{s['author']}>{s['author']}</a></p>\"))\n    authors.setdefault(s[\"author\"], []).append(s)\nfor handle, mine in authors.items():\n    items = \"\".join(f\"<li><a href=/s/{s['slug']}>{html.escape(s['title'])}</a></li>\" for s in mine)\n    write(f\"a/{handle}\", page(handle, f\"<h1>{handle}</h1><ul>{items}</ul>\"))\nprint(f\"  {len(stories)} notes, {len(authors)} authors\")\n","exit_code":0,"status":"completed"}}
