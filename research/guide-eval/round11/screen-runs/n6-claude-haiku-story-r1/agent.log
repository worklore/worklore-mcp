 operatorId,\n        new Timestamp(validStartSeconds, 0),\n      ),\n    )\n    .freeze();\n\n  await transaction.sign(operatorKey);\n\n  const bytes = transaction.toBytes();\n  process.stdout.write(Buffer.from(bytes).toString(\"hex\") + \"\\n\");\n}\n\nmain().catch((err: unknown) => {\n  console.error(err instanceof Error ? err.message : err);\n  process.exit(1);\n});\n","structuredPatch":[{"oldStart":29,"oldLines":8,"newStart":29,"newLines":8,"lines":["   const nodeAccountId = AccountId.fromString(\"0.0.3\");"," ","   const transaction = new TransferTransaction()","-    .addHbarTransfer(operatorId, Hbar.from(-1))","-    .addHbarTransfer(recipientId, Hbar.from(1))","+    .addHbarTransfer(operatorId, Hbar.from(-1, HbarUnit.Hbar))","+    .addHbarTransfer(recipientId, Hbar.from(1, HbarUnit.Hbar))","     .setTransactionMemo(\"invoice 42\")","     .setNodeAccountIds([nodeAccountId])","     .setTransactionId("]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_0181GygLXV4L7pgiTKdt4YYk","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
