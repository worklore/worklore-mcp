{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018AFRkamczkV5CcE2XvfC3A","type":"tool_result","content":"     1\tfrom __future__ import annotations\n     2\t\n     3\tfrom collections.abc import Iterator, Mapping\n     4\tfrom contextlib import contextmanager\n     5\tfrom contextvars import ContextVar\n     6\tfrom dataclasses import dataclass\n     7\tfrom enum import StrEnum\n     8\timport os\n     9\tfrom types import MappingProxyType\n    10\t\n    11\tfrom vibe.utils.keyring import get_api_key_from_keyring\n    12\tfrom vibe.utils.oidc_marker import oidc_enabled\n    13\tfrom vibe.utils.secrets import holding_secrets\n    14\t\n    15\t\n    16\tclass ApiKeySource(StrEnum):\n    17\t    \"\"\"The places ``resolve_api_key`` looks, in the order it looks.\"\"\"\n    18\t\n    19\t    SESSION = \"session\"\n    20\t    ENVIRONMENT = \"environment\"\n    21\t    KEYRING = \"keyring\"\n    22\t    OIDC = \"oidc\"\n    23\t\n    24\t\n    25\t@dataclass(frozen=True, slots=True)\n    26\tclass ApiKeyOrigin:\n    27\t    \"\"\"Where one resolved key came from, and under which name.\n    28\t\n    29\t    ``env_var`` keys both sources, so it alone cannot say which answered. The\n    30\t    pair can, and the difference is what a user acts on: an environment\n    31\t    variable may hold a value they never set, while a keyring key is replaced\n    32\t    by running setup again.\n    33\t    \"\"\"\n    34\t\n    35\t    source: ApiKeySource\n    36\t    env_var: str\n    37\t\n    38\t    def describe(self) -> str:\n    39\t        match self.source:\n    40\t            case ApiKeySource.SESSION:\n    41\t                return f\"the run's credential {self.env_var}\"\n    42\t            case ApiKeySource.ENVIRONMENT:\n    43\t                return f\"env var {self.env_var}\"\n    44\t            case ApiKeySource.KEYRING:\n    45\t                return \"the keyring\"\n    46\t            case ApiKeySource.OIDC:\n    47\t                return \"the CLI OIDC session\"\n    48\t\n    49\t\n    50\t# The credentials of the code running in this context, by environment variable\n    51\t# name. Asyncio tasks and to_thread workers inherit it, so one process can run\n    52\t# sessions that each send their own key.\n    53\t_session_credentials: ContextVar[Mapping[str, str] | None] = ContextVar(\n    54\t    \"session_credentials\", default=None\n    55\t)\n    56\t\n    57\t\n    58\t@contextmanager\n    59\tdef session_credentials(values: Mapping[str, str]) -> Iterator[None]:\n    60\t    \"\"\"Resolve API keys from ``values`` first, inside this context only.\n    61\t\n    62\t    ``values`` maps an environment variable name, as a provider's\n    63\t    ``api_key_env_var`` names it, to its value. They are never written to\n    64\t    ``os.environ``, and the logs redact them while the context lasts. Must be\n    65\t    entered and left in the same context, as a ``ContextVar`` is.\n    66\t    \"\"\"\n    67\t    with holding_secrets(values.values()):\n    68\t        token = _session_credentials.set(MappingProxyType(dict(values)))\n    69\t        try:\n    70\t            yield\n    71\t        finally:\n    72\t            _session_credentials.reset(token)\n    73\t\n    74\t\n    75\tdef active_api_key(\n    76\t    *, env_value: str | None, keyring_value: str | None\n    77\t) -> tuple[ApiKeySource, str] | None:\n    78\t    \"\"\"The winning credential and its source, or ``None`` when neither holds one.\n    79\t\n    80\t    The precedence rule shared by resolution and ``/status``: a truthy\n    81\t    environment value wins, otherwise the keyring decides. Inputs are\n    82\t    already-collected values, so callers own when (and whether) the keyring\n    83\t    is read — resolution touches it only when the environment holds nothing.\n    84\t    \"\"\"\n    85\t    if env_value:\n    86\t        return ApiKeySource.ENVIRONMENT, env_value\n    87\t    if keyring_value:\n    88\t        return ApiKeySource.KEYRING, keyring_value\n    89\t    return None\n    90\t\n    91\t\n    92\tdef resolve_api_key_with_origin(env_key: str) -> tuple[str, ApiKeyOrigin] | None:\n    93\t    \"\"\"The key for ``env_key`` and where it was read from, or ``None``.\n    94\t\n    95\t    The one place the precedence lives, so a key and its reported origin can\n    96\t    never disagree: the session's credentials, then ``active_api_key``'s\n    97\t    env-wins rule. The keyring read goes through its process-wide cache, so\n    98\t    asking again after a failed call costs nothing — and happens only when\n    99\t    neither the session nor the environment holds a value.\n   100\t    \"\"\"\n   101\t    if not env_key:\n   102\t        return None\n   103\t    if env_key == \"MISTRAL_API_KEY\" and oidc_enabled():\n   104\t        from vibe.setup.auth._oidc_runtime import stored_oidc_credential\n   105\t\n   106\t        token = stored_oidc_credential()\n   107\t        return (token, ApiKeyOrigin(ApiKeySource.OIDC, env_key)) if token else None\n   108\t    credentials = _session_credentials.get()\n   109\t    if credentials is not None and (token := credentials.get(env_key)):\n   110\t        return token, ApiKeyOrigin(ApiKeySource.SESSION, env_key)\n   111\t    env_value = os.environ.get(env_key)\n   112\t    keyring_value = None if env_value else get_api_key_from_keyring(env_key)\n   113\t    resolved = active_api_key(env_value=env_value, keyring_value=keyring_value)\n   114\t    if resolved is None:\n   115\t        return None\n   116\t    source, token = resolved\n   117\t    return token, ApiKeyOrigin(source, env_key)\n   118\t\n   119\t\n   120\tdef resolve_api_key(env_key: str) -> str | None:\n   121\t    resolved = resolve_api_key_with_origin(env_key)\n   122\t    return resolved[0] if resolved else None\n====\nShell cwd was reset to /private/tmp/h-qAfXrU","is_error":false}]},"parent_tool_use_id":null,"session_id":"14780817-9f36-48c4-9af1-d2368aca1ec0","uuid":"89b