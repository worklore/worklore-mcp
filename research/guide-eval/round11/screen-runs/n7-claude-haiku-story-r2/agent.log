{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UFwEEedDRiYQoT3ZKFZbnS","type":"tool_result","content":"        } | null;\n        github: {\n            id: string;\n        } | null;\n        wallet: {\n            address: string;\n        } | null;\n    };\n}\ninterface PollarClientConfig {\n    stellarNetwork?: StellarNetwork;\n    baseUrl?: string;\n    apiKey: string;\n    /**\n     * Pluggable storage. Defaults to `defaultStorage()` on web (localStorage\n     * with memory fallback). On RN you must inject one of the adapters from\n     * `@pollar/core/adapters/expo` or `@pollar/core/adapters/react-native-keychain`.\n     */\n    storage?: Storage;\n    /**\n     * Max time (ms) a single SDK HTTP attempt waits before aborting and rejecting\n     * with a {@link PollarNetworkError} (`code: 'SDK_NETWORK_TIMEOUT'`).\n     *\n     * `fetch` has no timeout of its own, so without this a transient connection\n     * stall (e.g. a dropped TCP SYN on a flaky mobile network at cold start) hangs\n     * the request forever - it neither resolves nor rejects, trapping any caller\n     * that `await`s it (a returning user stuck on the splash screen). Bounding it\n     * lets the request fail fast so the caller can recover (retry, or fall back to\n     * a cached token).\n     *\n     * Defaults to `10000` (10s). Set `0` to disable (NOT recommended - restores\n     * the unbounded-hang behavior).\n     */\n    requestTimeoutMs?: number;\n    /**\n     * Per-request timeout (ms) applied to the submit-family tx calls\n----SETTRUST\n     */\n    refreshAssets(): Promise<void>;\n    /**\n     * Establishes (omit `limit`) or removes (`limit: '0'`) a trustline for an asset.\n     *\n     * The app config decides who pays, server-side - the SDK never pre-decides.\n     * Sponsorship is **on by default** (the app covers the 0.5 XLM reserve + fee\n     * when eligible); pass `skipSponsorship` to force the user's own wallet to pay,\n     * mirroring the opt-out on the payment / swap / contract fee-bump surfaces. The\n     * route is by wallet type, and each server endpoint sponsors-or-self-pays:\n     *  - **Embedded** (internal wallet, no adapter) -> one call to\n     *    `/wallet/assets/trustline`: the server signs the way the wallet's signer\n     *    allows. A custodial wallet is sponsored or self-paid and submitted there,\n     *    returning the refreshed asset list; a co-signed one answers with the\n     *    request its device approves, settled like any other co-signed send.\n     *  - **External/adapter** -> `/wallet/assets/trustline/build` returns a\n     *    `changeTrust` XDR (sponsor-signed when covered, or a plain self-pay one\n     *    otherwise); the user's own wallet adds the trustor signature and submits.\n     *  - **`skipSponsorship`** -> a plain self-pay `change_trust` via {@link runTx},\n     *    bypassing the sponsoring endpoints for both wallet types.\n     *\n     * Does not refresh on its own - callers should `refreshAssets()` afterwards.\n     */\n    setTrustline(asset: {\n        code: string;\n        issuer: string;\n    }, opts?: {\n        limit?: string;\n        /**\n         * Force self-pay even when the app would sponsor the trustline - the\n         * opt-out that mirrors `skipSponsorship` on the payment / swap / contract\n         * fee-bump surfaces.\n         */\n        skipSponsorship?: boolean;\n    }): Promise<TrustlineOutcome>;\n    /** A refused trustline call, with the API's code so a UI can say what to do about it. */\n    private _trustlineError;\n    /**\n     * Create this wallet's account on the Stellar network when it doesn't exist\n     * yet. For EXTERNAL wallets (Freighter / client-side Privy) whose key the\n     * platform doesn't hold: the server builds a sponsored `createAccount` (the new\n----PKYC\n        cardProviderId?: string;\n    }): Promise<KycStatusContent>;\n    pollKycStatus(providerId: string, opts?: {\n        intervalMs?: number;\n        timeoutMs?: number;\n        corridorId?: string;\n        cardProviderId?: string;\n    }): Promise<KycStatus>;\n    /** The fiat and asset pairs the app can ramp between in a direction. Nothing is quoted. */\n    getRampRoutes(direction: RampDirection): Promise<RampRoutesResponse>;\n    /** Every route between the fiat and the asset, quoted leg by leg, best first. */\n    quoteRamp(body: RampQuoteRequest): Promise<RampQuotesResponse>;\n    /**\n     * Turns a quote the user accepted into an order. `payee` holds a value for each\n     * of the quote's `requiredFields` (`rampQuoteFields`); a missing or wrong one is\n     * refused before anything moves. The same quote always answers the same order.\n----QUOTE\nindex.d.ts:17243:type TrustlineOutcome = {\nindex.d.ts:17476:type WalletBalanceAnswer = paths['/wallet/balance']['get']['responses'][200]['content']['application/json']['content'];\nindex.d.ts:17479:type WalletBalanceState = {\nindex.d.ts:17577:type RampDirection = NonNullable<paths['/ramps/routes']['get']['parameters']['query']>['direction'];\nindex.d.ts:17581:type RampFiat = RampRoute['fiat'];\nindex.d.ts:17582:type RampAsset = RampRoute['asset'];\nindex.d.ts:17584:type RampQuoteRequest = NonNullable<paths['/ramps/quotes']['post']['requestBody']>['content']['application/json'];\nindex.d.ts:17585:type RampQuotesResponse = paths['/ramps/quotes']['post']['responses'][200]['content']['application/json']['content'];\nindex.d.ts:17587:type RampQuote = RampQuotesResponse['quotes'][number];\nindex.d.ts:17588:type RampQuoteLeg = RampQuote['legs'][number];\nindex.d.ts:17592:type RampQuoteRejection = RampQuotesResponse['rejected'][number];\nindex.d.ts:17594:type RampQuoteRequirement = NonNullable<RampQuoteRejection['requirement']>;\nindex.d.ts:20370:export { AUTH_ERROR_CODES, type AdapterFn, AlbedoAdapter, type AppRequirementStep, type AppRequirements, type AuthErrorCode, type AuthOpenContext, type AuthOption, type AuthProviderContext, type AuthState, type AuthUrlOpener