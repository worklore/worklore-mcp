 )}\r\n+      \u003cbutton onClick={() =\u003e void enableUsdc(getClient())}\u003eAccept USDC\u003c/button\u003e\r\n+      \u003cbutton onClick={async () =\u003e setRate(await bestTopUpRate(getClient(), 10_000))}\u003eAdd money\u003c/button\u003e\r\n+      {rate !== null \u0026\u0026 \u003cp\u003e1 USDC = {rate} ARS\u003c/p\u003e}\r\n+    \u003c/section\u003e\r\n+  );\r\n+}\r\ndiff --git a/src/balances.ts b/src/balances.ts\r\nnew file mode 100644\r\nindex 0000000..726bb11\r\n--- /dev/null\r\n+++ b/src/balances.ts\r\n@@ -0,0 +1,6 @@\r\n+import type { WalletBalanceRecord } from '@pollar/core';\r\n+\r\n+/** One line per asset for the wallet screen, e.g. \"USDC 12.50\". */\r\n+export function balanceLines(records: WalletBalanceRecord[]): string[] {\r\n+  return records.map((r) =\u003e `${r.type === 'native' ? 'XLM' : r.code} ${parseFloat(r.balance).toFixed(2)}`);\r\n+}\r\ndiff --git a/src/kyc.ts b/src/kyc.ts\r\nnew file mode 100644\r\nindex 0000000..73c46d9\r\n--- /dev/null\r\n+++ b/src/kyc.ts\r\n@@ -0,0 +1,16 @@\r\n+import type { PollarClient } from '@pollar/core';\r\n+\r\n+/** Waits for the identity check and returns the line the wallet screen shows. */\r\n+export async function kycMessage(client: PollarClient, providerId: string): Promise\u003cstring\u003e {\r\n+  const status = await client.pollKycStatus(providerId, { intervalMs: 3000, timeoutMs: 120_000 });\r\n+  switch (status) {\r\n+    case 'approved':\r\n+      return 'Verified';\r\n+    case 'rejected':\r\n+      return 'Verification failed';\r\n+    case 'pending':\r\n+      return 'Still being checked';\r\n+    case 'none':\r\n+      return 'Not started';\r\n+  }\r\n+}\r\ndiff --git a/src/pollar.ts b/src/pollar.ts\r\nnew file mode 100644\r\nindex 0000000..1c66673\r\n--- /dev/null\r\n+++ b/src/pollar.ts\r\n@@ -0,0 +1,9 @@\r\n+import type { PollarClientConfig } from '@pollar/core';\r\n+\r\n+export const pollarConfig: PollarClientConfig = {\r\n+  apiKey: 'pub_testnet_tipjar_demo',\r\n+  stellarNetwork: 'testnet',\r\n+  baseUrl: 'https://sdk.api.pollar.xyz/v1',\r\n+};\r\n+\r\n+export const USDC = { code: 'USDC', issuer: 'GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5' };\r\ndiff --git a/src/ramp.ts b/src/ramp.ts\r\nnew file mode 100644\r\nindex 0000000..77fc171\r\n--- /dev/null\r\n+++ b/src/ramp.ts\r\n@@ -0,0 +1,7 @@\r\n+import type { PollarClient } from '@pollar/core';\r\n+\r\n+/** \"Add money\": the best rate for topping up the wallet with Argentine pesos, or null if no provider quotes. */\r\n+export async function bestTopUpRate(client: PollarClient, pesos: number): Promise\u003cnumber | null\u003e {\r\n+  const res = await client.getRampsQuote({ country: 'AR', currency: 'ARS', amount: pesos, direction: 'onramp' });\r\n+  return res.quotes[0]?.rate ?? null;\r\n+}\r\ndiff --git a/src/trust.ts b/src/trust.ts\r\nnew file mode 100644\r\nindex 0000000..baddeb4\r\n--- /dev/null\r\n+++ b/src/trust.ts\r\n@@ -0,0 +1,8 @@\r\n+import type { PollarClient } from '@pollar/core';\r\n+import { USDC } from './pollar';\r\n+\r\n+/** Lets the wallet hold USDC; the app sponsors the reserve. */\r\n+export async function enableUsdc(client: PollarClient): Promise\u003cboolean\u003e {\r\n+  const outcome = await client.setTrustline(USDC, { sponsored: true });\r\n+  return outcome.status === 'success';\r\n+}\r\ndiff --git a/tsconfig.json b/tsconfig.json\r\nnew file mode 100644\r\nindex 0000000..bb35da5\r\n--- /dev/null\r\n+++ b/tsconfig.json\r\n@@ -0,0 +1,8 @@\r\n+{\r\n+  \"compilerOptions\": {\r\n+    \"target\": \"ES2022\", \"module\": \"ESNext\", \"moduleResolution\": \"Bundler\",\r\n+    \"jsx\": \"react-jsx\", \"strict\": true, \"noImplicitReturns\": true,\r\n+    \"skipLibCheck\": true, \"noEmit\": true, \"lib\": [\"ES2022\", \"DOM\"]\r\n+  },\r\n+  \"include\": [\"src\"]\r\n+}\r\n"}}}
