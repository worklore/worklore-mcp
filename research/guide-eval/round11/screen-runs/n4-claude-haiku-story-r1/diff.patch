 T=$1; A=$2; REP=${3:-1}
@@ -15,6 +16,24 @@ codex_run() {
       -o "$R/final.txt" "$P" < /dev/null > "$R/agent.log" 2> "$R/agent.err" )
 }
 
+# The codex lane's run under sandbox/agent.sb, as kimi does it. Codex keeps its state in CODEX_HOME, a scratch folder
+# in /tmp; its config and login are copied in for the run. The copied login is readable by the agent's shell too,
+# since Codex must hold it to call the API. -o writes into scratch, not the run folder: the profile denies writes
+# under the real home, and Codex exits 0 even when its -o write is refused, so the file is copied out afterwards.
+codex_sandbox_run() {
+  local REAL="$HOME" CH OUT rc
+  CH=$(mktemp -d /tmp/codex-home-XXXXXX); OUT=$(mktemp -d /tmp/codex-out-XXXXXX)
+  cp "$REAL/.codex/config.toml" "$REAL/.codex/auth.json" "$CH/" || { echo "cannot copy codex config/login from $REAL/.codex"; rm -rf "$CH" "$OUT"; return 1; }
+  ( cd "$W" && export HOME="$CH" CODEX_HOME="$CH" && sandbox-exec -D HOME="$REAL" -f "$D/sandbox/agent.sb" \
+      timeout $TO codex exec --skip-git-repo-check --dangerously-bypass-approvals-and-sandbox -C "$W" --json \
+      -o "$OUT/final.txt" "$P" < /dev/null > "$R/agent.log" 2> "$R/agent.err" )
+  rc=$?
+  cp "$OUT/final.txt" "$R/final.txt" 2>/dev/null
+  [ -s "$R/final.txt" ] || echo "warning: no final message in $R/final.txt" >&2
+  grep -q "Operation not permitted" "$R/agent.err" && echo "warning: 'Operation not permitted' in $R/agent.err" >&2
+  rm -rf "$CH" "$OUT"; return $rc
+}
+
 # Kimi's output goes to Moonshot: its shell runs under sandbox/agent.sb with an empty scratch HOME.
 kimi_run() {
   local REAL="$HOME" SH; SH=$(mktemp -d /tmp/khome-XXXXXX)
@@ -27,6 +46,7 @@ kimi_run() {
 start=$(date +%s)
 case $A in
   codex) codex_run;;
+  codex-sandboxed) codex_sandbox_run;;
   kimi)  kimi_run;;
   *) echo "unknown lane $A"; exit 2;;
 esac
