{"event":"step_update","step_update":{"conversation_id":"b9dc1e72-c4a6-4fca-859a-3b7f424fbf85","step_index":42,"state":"DONE","step_type":"tool","tool_name":"run_command","duration_seconds":0.191633,"tool_info":{"name":"run_command","parameters":{"CommandLine":"node -e \"\nconst fs = require('fs');\nconst lines = fs.readFileSync('node_modules/@pollar/core/dist/index.d.mts', 'utf8').split('\\n');\nconsole.log('--- RampQuoteRequest ---');\nfor (let i = 0; i \u003c lines.length; i++) {\n  if (lines[i].includes('interface RampQuoteRequest') || lines[i].includes('type RampQuoteRequest')) {\n    console.log(lines.slice(i, i + 35).join('\\n'));\n    break;\n  }\n}\n\""},"output":"Command exited with code 0.\n\nCommand output:\n--- RampQuoteRequest ---\r\ntype RampQuoteRequest = NonNullable\u003cpaths['/ramps/quotes']['post']['requestBody']\u003e['content']['application/json'];\r\ntype RampQuotesResponse = paths['/ramps/quotes']['post']['responses'][200]['content']['application/json']['content'];\r\n/** One route quoted leg by leg; `quotes` come best first. */\r\ntype RampQuote = RampQuotesResponse['quotes'][number];\r\ntype RampQuoteLeg = RampQuote['legs'][number];\r\n/** A value the user fills in before the order; its answer goes in `payee` under `key`. */\r\ntype RampField = RampQuoteLeg['requiredFields'][number];\r\n/** A route that was planned and dropped, with why (`failure.resolutionAction`). */\r\ntype RampQuoteRejection = RampQuotesResponse['rejected'][number];\r\n/** The verification step a dropped route waits on: complete it (KYC, form, registry check, registration), then quote again. */\r\ntype RampQuoteRequirement = NonNullable\u003cRampQuoteRejection['requirement']\u003e;\r\ntype RampOrderRequest = NonNullable\u003cpaths['/ramps/orders']['post']['requestBody']\u003e['content']['application/json'];\r\n/** An order with every leg, what it waits for (`pendingAction`) and when to read it again (`nextPollAfter`). */\r\ntype RampOrder = RampsGet\u003c'/ramps/orders/{id}'\u003e;\r\ntype RampOrderLeg = RampOrder['legs'][number];\r\ntype RampOrderLegStep = RampOrderLeg['steps'][number];\r\ntype RampPendingAction = NonNullable\u003cRampOrder['pendingAction']\u003e;\r\ntype RampSignatureAction = Extract\u003cRampPendingAction, {\r\n    kind: 'SIGNATURE';\r\n}\u003e;\r\n/** How to pay the fiat side: a QR (its code already rendered in `scannable`) or bank coordinates. */\r\ntype RampFiatInstructions = Extract\u003cRampPendingAction, {\r\n    kind: 'FIAT_PAYMENT';\r\n}\u003e['instructions'];\r\n/**\r\n * A code to scan, rendered by the server so no QR encoder is needed. A Pollar-made\r\n * SVG (`image.inlineSafe`) uses `currentColor` and can be injected as markup; a\r\n * provider's bitmap goes through `\u003cimg src=\"data:...\"\u003e`. Show `payload` as text\r\n * when `payloadLabel` is set: a phone cannot scan its own screen.\r\n */\r\ntype RampScannable = NonNullable\u003cExtract\u003cRampFiatInstructions, {\r\r\n    kind: 'qr';\r\n}\u003e['scannable']\u003e;\r\ntype RampFailure = NonNullable\u003cRampOrder['failure']\u003e;\r\ntype RampOrdersQuery = NonNullable\u003cpaths['/ramps/orders']['get']['parameters']['query']\u003e;\r\n"}}}
