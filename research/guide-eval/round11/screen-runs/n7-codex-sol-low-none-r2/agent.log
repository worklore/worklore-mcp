{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"sed -n '14254,14325p;17550,17610p;18890,18945p;20060,20132p' node_modules/@pollar/core/dist/index.d.ts\"","aggregated_output":"    postRampsQuotes: {\n        parameters: {\n            query?: never;\n            header?: never;\n            path?: never;\n            cookie?: never;\n        };\n        requestBody: {\n            content: {\n                \"application/json\": {\n                    /** @enum {string} */\n                    direction: \"ONRAMP\" | \"OFFRAMP\";\n                    fiat: {\n                        currency: string;\n                        /** @enum {string} */\n                        rail: \"SPEI\" | \"PIX\" | \"PSE\" | \"ACH\" | \"BREB\" | \"QR\" | \"BANK_TRANSFER\" | \"CASH\" | \"CARD\" | \"HOSTED\";\n                        country: string;\n                    };\n                    asset: {\n                        code: string;\n                        identifier: string | null;\n                        /** @enum {string} */\n                        chain: \"STELLAR\" | \"POLYGON\" | \"SOLANA\";\n                    };\n                    amount: {\n                        value: string;\n                        /** @enum {string} */\n                        denomination: \"in\" | \"out\";\n                    };\n                };\n            };\n        };\n        responses: {\n            /** @description Quotes, best first. */\n            200: {\n                headers: {\n                    [name: string]: unknown;\n                };\n                content: {\n                    \"application/json\": {\n                        /** @constant */\n                        code: \"SDK_RAMPS_QUOTES\";\n                        /** @constant */\n                        success: true;\n                        content: {\n                            quotes: {\n                                quoteId: string;\n                                expiresAt: string;\n                                amountIn: string;\n                                amountOut: string;\n                                etaSeconds: number | null;\n                                legs: {\n                                    index: number;\n                                    /** @enum {string} */\n                                    kind: \"PROVIDER_ONRAMP\" | \"PROVIDER_OFFRAMP\" | \"SWAP\" | \"BRIDGE\";\n                                    from: {\n                                        /** @constant */\n                                        kind: \"asset\";\n                                        code: string;\n                                        identifier: string | null;\n                                        /** @enum {string} */\n                                        chain: \"STELLAR\" | \"POLYGON\" | \"SOLANA\";\n                                    } | {\n                                        /** @constant */\n                                        kind: \"fiat\";\n                                        currency: string;\n                                        /** @enum {string} */\n                                        rail: \"SPEI\" | \"PIX\" | \"PSE\" | \"ACH\" | \"BREB\" | \"QR\" | \"BANK_TRANSFER\" | \"CASH\" | \"CARD\" | \"HOSTED\";\n                                        country: string;\n                                    };\n                                    to: {\n                                        /** @constant */\n} | {\n    step: 'loaded';\n    params: TxHistoryParams;\n    data: TxHistoryContent;\n} | {\n    step: 'error';\n    params: TxHistoryParams;\n    message: string;\n};\ntype KycLevel = 'basic' | 'intermediate' | 'enhanced';\ntype KycStatus = 'none' | 'pending' | 'approved' | 'rejected' | 'expired';\ntype KycDecisionStatus = 'pending' | 'manual_review' | 'approved' | 'rejected' | 'expired';\ntype KycFlow = 'iframe' | 'form' | 'redirect';\n/** One read of GET /kyc/status. `status` is what gates the user; `decisionStatus`\n *  and `reviewReason` say why a `pending` is pending (e.g. held for manual review). */\ntype KycStatusContent = paths['/kyc/status']['get']['responses'][200]['content']['application/json']['content'];\ntype KycProvider = paths['/kyc/providers']['get']['responses'][200]['content']['application/json']['content']['providers'][number];\ntype KycStartBody = NonNullable<paths['/kyc/start']['post']['requestBody']>['content']['application/json'];\ntype KycStartResponse = paths['/kyc/start']['post']['responses'][200]['content']['application/json']['content'];\n/** Closed ramp chain catalog, independent of wallet networks. */\ndeclare const RampChain: Readonly<{\n    readonly STELLAR: \"STELLAR\";\n    readonly POLYGON: \"POLYGON\";\n    readonly SOLANA: \"SOLANA\";\n}>;\ntype RampChain = (typeof RampChain)[keyof typeof RampChain];\ntype RampsGet<P extends '/ramps/routes' | '/ramps/orders' | '/ramps/orders/{id}'> = paths[P]['get']['responses'][200]['content']['application/json']['content'];\ntype RampDirection = NonNullable<paths['/ramps/routes']['get']['parameters']['query']>['direction'];\n/** The fiat and asset pairs the app can ramp between in a direction, each with the legs of its shortest path. */\ntype RampRoutesResponse = RampsGet<'/ramps/routes'>;\ntype RampRoute = RampRoutesResponse['routes'][number];\ntype RampFiat = RampRoute['fiat'];\ntype RampAsset = RampRoute['asset'];\ntype RampLegKind = RampRoute['legs'][number];\ntype RampQuoteRequest = NonNullable<paths['/ramps/quotes']['post']['requestBody']>['content']['application/json'];\ntype RampQuotesResponse = paths['/ramps/quotes']['post']['responses'][200]['content']['application/json']['content'];\n/** One route quoted leg by leg; `quotes` come best first. */\ntype RampQuote = RampQuotesResponse['quotes'][number];\ntype RampQuoteLeg = RampQuote['legs'][number];\n/** A value the user fills in before the order; its answer goes in `payee` under `key`. */\ntype RampField = RampQuoteLeg['requiredFields'][number];\n/** A route that was planned and dropped, with why (`failure.resolutionAction`). */\ntype RampQuoteRejection = RampQuotesResponse['rejected'][number];\n/** The verification step a dropped route waits on: complete it (KYC, form, registry check, registration), then quote again. */\ntype RampQuoteRequirement = NonNullable<RampQuoteRejection['requirement']>;\ntype RampOrderRequest = NonNullable<paths['/ramps/orders']['post']['requestBody']>['content']['application/json'];\n/** An order with every leg, what it waits for (`pendingAction`) and when to read it again (`nextPollAfter`). */\ntype RampOrder = RampsGet<'/ramps/orders/{id}'>;\ntype RampOrderLeg = RampOrder['legs'][number];\ntype RampOrderLegStep = RampOrderLeg['steps'][number];\ntype RampPendingAction = NonNullable<RampOrder['pendingAction']>;\ntype RampSignatureAction = Extract<RampPendingAction, {\n    kind: 'SIGNATURE';\n}>;\n/** How to pay the fiat side: a QR (its code already rendered in `scannable`) or bank coordinates. */\ntype RampFiatInstructions = Extract<RampPendingAction, {\n    kind: 'FIAT_PAYMENT';\n}>['instructions'];\n/**\n * A code to scan, rendered by the server so no QR encoder is needed. A Pollar-made\n * SVG (`image.inlineSafe`) uses `currentColor` and can be injected as markup; a\n    private _flattenAssets;\n    /**\n     * General-purpose balance lookup for ANY wallet on ANY network - not scoped\n     * to this application. Enumerates the account's real on-chain holdings via\n     * Horizon (server-side) and returns the data directly (no reactive state).\n     * `network` defaults to the client's current network.\n     */\n    getWalletBalance(publicKey: string, network?: StellarNetwork): Promise<WalletBalanceContent>;\n    getEnabledAssetsState(): EnabledAssetsState;\n    onEnabledAssetsStateChange(cb: (state: EnabledAssetsState) => void): () => void;\n    /**\n     * Loads the application's enabled assets paired with the authenticated\n     * wallet's on-chain trustline state - so the SDK knows which trustlines still\n     * need to be added. Wallet and network are resolved server-side from the\n     * session. Drives `enabledAssetsState`; mirrors {@link refreshBalance}.\n     */\n    refreshAssets(): Promise<void>;\n    /**\n     * Establishes (omit `limit`) or removes (`limit: '0'`) a trustline for an asset.\n     *\n     * The app config decides who pays, server-side - the SDK never pre-decides.\n     * Sponsorship is **on by default** (the app covers the 0.5 XLM reserve + fee\n     * when eligible); pass `skipSponsorship` to force the user's own wallet to pay,\n     * mirroring the opt-out on the payment / swap / contract fee-bump surfaces. The\n     * route is by wallet type, and each server endpoint sponsors-or-self-pays:\n     *  - **Embedded** (internal wallet, no adapter) -> one call to\n     *    `/wallet/assets/trustline`: the server signs the way the wallet's signer\n     *    allows. A custodial wallet is sponsored or self-paid and submitted there,\n     *    returning the refreshed asset list; a co-signed one answers with the\n     *    request its device approves, settled like any other co-signed send.\n     *  - **External/adapter** -> `/wallet/assets/trustline/build` returns a\n     *    `changeTrust` XDR (sponsor-signed when covered, or a plain self-pay one\n     *    otherwise); the user's own wallet adds the trustor signature and submits.\n     *  - **`skipSponsorship`** -> a plain self-pay `change_trust` via {@link runTx},\n     *    bypassing the sponsoring endpoints for both wallet types.\n     *\n     * Does not refresh on its own - callers should `refreshAssets()` afterwards.\n     */\n    setTrustline(asset: {\n        code: string;\n        issuer: string;\n    }, opts?: {\n        limit?: string;\n        /**\n         * Force self-pay even when the app would sponsor the trustline - the\n         * opt-out that mirrors `skipSponsorship` on the payment / swap / contract\n         * fee-bump surfaces.\n         */\n        skipSponsorship?: boolean;\n    }): Promise<TrustlineOutcome>;\n    /** A refused trustline call, with the API's code so a UI can say what to do about it. */\n    private _trustlineError;\n    /**\n     * Create this wallet's account on the Stellar network when it doesn't exist\n     * yet. For EXTERNAL wallets (Freighter / client-side Privy) whose key the\n     * platform doesn't hold: the server builds a sponsored `createAccount` (the new\n    intervalMs?: number;\n    timeoutMs?: number;\n    corridorId?: string;\n    cardProviderId?: string;\n}): Promise<KycStatusContent>;\n/**\n * {@link pollKycDecision}, reduced to the status. Resolves `'pending'` when the\n * decision is held for manual review or still being recorded; read\n * {@link pollKycDecision} to tell which.\n */\ndeclare function pollKycStatus(api: PollarApiClient, providerId: string, opts?: {\n    intervalMs?: number;\n    timeoutMs?: number;\n    corridorId?: string;\n    cardProviderId?: string;\n}): Promise<KycStatus>;\n\n/**\n * GET /requirements/forms/{formId}\n * The form a FORM requirement step asks for (the `optionId` of a pending step in\n * the quote's `requirementsRequired`): its fields, the user's previous answers to\n * prefill, and `missing`, the required keys still open.\n */\ndeclare function getRequirementForm(api: PollarApiClient, formId: string): Promise<RequirementForm>;\n/**\n * POST /requirements/forms/{formId}\n * Submit the full set of answers. Invalid answers throw a {@link PollarApiError}\n * with code `KYC_FORM_INVALID_ANSWERS` and `body.errors` listing `{ key, code }`\n * per field. Quote again afterwards.\n */\ndeclare function submitRequirementForm(api: PollarApiClient, formId: string, answers: RequirementFormAnswers): Promise<RequirementFormSubmitted>;\n/**\n * GET /requirements\n * The app's own KYC steps (every one required, in order, each with equivalent\n * options) and where the user stands