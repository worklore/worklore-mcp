{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FYhnssyZYxkwyqunbSn9yk","type":"tool_result","content":"declare const RampChain: Readonly<{\n    readonly STELLAR: \"STELLAR\";\n    readonly POLYGON: \"POLYGON\";\n    readonly SOLANA: \"SOLANA\";\n}>;\ntype RampChain = (typeof RampChain)[keyof typeof RampChain];\ntype RampsGet<P extends '/ramps/routes' | '/ramps/orders' | '/ramps/orders/{id}'> = paths[P]['get']['responses'][200]['content']['application/json']['content'];\ntype RampDirection = NonNullable<paths['/ramps/routes']['get']['parameters']['query']>['direction'];\n/** The fiat and asset pairs the app can ramp between in a direction, each with the legs of its shortest path. */\ntype RampRoutesResponse = RampsGet<'/ramps/routes'>;\ntype RampRoute = RampRoutesResponse['routes'][number];\ntype RampFiat = RampRoute['fiat'];\ntype RampAsset = RampRoute['asset'];\ntype RampLegKind = RampRoute['legs'][number];\ntype RampQuoteRequest = NonNullable<paths['/ramps/quotes']['post']['requestBody']>['content']['application/json'];\ntype RampQuotesResponse = paths['/ramps/quotes']['post']['responses'][200]['content']['application/json']['content'];\n/** One route quoted leg by leg; `quotes` come best first. */\ntype RampQuote = RampQuotesResponse['quotes'][number];\ntype RampQuoteLeg = RampQuote['legs'][number];\n/** A value the user fills in before the order; its answer goes in `payee` under `key`. */\ntype RampField = RampQuoteLeg['requiredFields'][number];\n/** A route that was planned and dropped, with why (`failure.resolutionAction`). */\ntype RampQuoteRejection = RampQuotesResponse['rejected'][number];\n/** The verification step a dropped route waits on: complete it (KYC, form, registry check, registration), then quote again. */\ntype RampQuoteRequirement = NonNullable<RampQuoteRejection['requirement']>;\ntype RampOrderRequest = NonNullable<paths['/ramps/orders']['post']['requestBody']>['content']['application/json'];\n/** An order with every