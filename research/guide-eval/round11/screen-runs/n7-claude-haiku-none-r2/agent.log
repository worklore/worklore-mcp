{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Jf8Y5A37RKBghwrkG7NWAH","type":"tool_result","content":"start=1933\n    \"/ramps/quotes\": {\n        parameters: {\n            query?: never;\n            header?: never;\n            path?: never;\n            cookie?: never;\n        };\n        get?: never;\n        put?: never;\n        /**\n         * Quote a ramp\n         * @description Plans every route between the fiat and the asset and quotes each leg live, exact-in forward or exact-out backward. Every route found is saved as a quote of its own, best first; `rejected` says why\n         */\n        post: operations[\"postRampsQuotes\"];\n        delete?: never;\n        options?: never;\n        head?: never;\n        patch?: never;\n        trace?: never;\n    };\n    \"/ramps/orders\": {\n        parameters: {\n            query?: never;\n            header?: never;\n            path?: never;\n            cookie?: never;\n        };\n        /**\n         * List ramp orders\n         * @description The user's orders, newest first. `pending=true` keeps the ones waiting on the user (a signature, a payment, an approval).\n         */\n        get: operations[\"getRampsOrders\"];\n        put?: never;\n        /**\n         * Create a ramp order\n         * @description Turns a quote into an order and runs its first leg at once, so the answer carries the first `pendingAction` (a QR to pay, a signature). `payee` carries a value for each of the quote's `requiredFie\n         */\n        post: operations[\"postRampsOrders\"];\n        delete?: never;\n        options?: never;\n        head?: never;\n        patch?: never;\n        trace?: never;\n    };\n    \"/ramps/orders/{id}\": {\n        parameters: {\n            query?: never;\n            header?: never;\n            path?: never;\n            cookie?: never;\n        };\n        /**\n         * Read a ramp order\n         * @description The order with every leg (status, planne