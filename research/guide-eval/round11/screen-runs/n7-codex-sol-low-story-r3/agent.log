                         /** @enum {string} */\n                                        chain: \"STELLAR\" | \"POLYGON\" | \"SOLANA\";\n                                    } | {\n                                        /** @constant */\n                                        kind: \"fiat\";\n                                        currency: string;\n                                        /** @enum {string} */\n                                        rail: \"SPEI\" | \"PIX\" | \"PSE\" | \"ACH\" | \"BREB\" | \"QR\" | \"BANK_TRANSFER\" | \"CASH\" | \"CARD\" | \"HOSTED\";\n                                        country: string;\n                                    };\n                                    amountIn: string;\n                                    amountOut: string;\n                                    providerFees: {\n                                        beneficiary: string;\n                                        payer: string;\n                                        settlement: string;\n                                        basis: string;\nsrc/trust.ts:4:/** Lets the wallet hold USDC; the app sponsors the reserve. */\nsrc/trust.ts:6:  const outcome = await client.setTrustline(USDC, { sponsored: true });\n","exit_code":0,"status":"completed"}}
