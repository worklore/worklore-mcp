{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"node --input-type=module <<'EOF'\nimport http from 'node:http'\nimport { spawnSync } from 'node:child_process'\nimport assert from 'node:assert/strict'\nlet mode = 'success', attempts = 0\nconst server = http.createServer((req, res) => {\n  attempts++\n  if (mode === 'retry' && attempts < 4) { res.writeHead(503).end(); return }\n  if (mode === 'failure') { res.writeHead(404).end(); return }\n  res.setHeader('content-type', 'application/json')\n  res.end(mode === 'invalid' ? '{\\\"base\\\":\\\"USD\\\",\\\"date\\\":\\\"today\\\",\\\"rates\\\":{\\\"EUR\\\":\\\"bad\\\"}}' : '{\\\"base\\\":\\\"USD\\\",\\\"date\\\":\\\"today\\\",\\\"rates\\\":{\\\"EUR\\\":0.9214}}')\n})\nawait new Promise(resolve => server.listen(0, '127.0.0.1', resolve))\nconst url = \"'`http://127.0.0.1:${server.address().port}`\n// Spawn asynchronously so the test server can serve requests.\nconst { spawn } = await import('\"'node:child_process')\nasync function run(quote) {\n  return await new Promise(resolve => {\n    const child = spawn('npx', ['tsx', 'src/main.ts', 'USD', quote], { env: { ...process.env, RATES_URL: url } })\n    let stdout = '', stderr = ''\n    child.stdout.on('data', x => stdout += x)\n    child.stderr.on('data', x => stderr += x)\n    child.on('close', code => resolve({ code, stdout: stdout.trim(), stderr: stderr.trim() }))\n  })\n}\nfor (const [m, q, code, line, count] of [\n  ['success', 'EUR', 0, '1 USD = 0.9214 EUR', 1],\n  ['success', 'XYZ', 1, 'unknown currency: XYZ', 1],\n  ['invalid', 'EUR', 2, 'invalid response', 1],\n  ['failure', 'EUR', 3, 'request failed', 1],\n  ['retry', 'EUR', 0, '1 USD = 0.9214 EUR', 4]\n]) {\n  mode = m; attempts = 0\n  const result = await run(q)\n  assert.equal(result.code, code, \"'`${m}: ${JSON.stringify(result)}`)\n  assert.equal(code === 0 ? result.stdout : result.stderr, line)\n  assert.equal(attempts, count)\n  console.log(`${m}/${q}: exit ${code}, ${attempts} request(s)`)\n}\nserver.close()\nEOF'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
