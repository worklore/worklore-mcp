diff --git a/ANSWER.md b/ANSWER.md
new file mode 100644
index 0000000..bd5fe2c
--- /dev/null
+++ b/ANSWER.md
@@ -0,0 +1,5 @@
+# Cause
+
+Vibe 3.1.0 checks for `MISTRAL_API_KEY` during startup even when the configured model uses OpenRouter. The launcher's `env -i` removed that variable, so Vibe tried to read API keys from the macOS Keychain via `/usr/bin/security`. `agent.sb` correctly blocks that command, causing the immediate exit 2 before any run or export.
+
+The launcher now supplies an inert `MISTRAL_API_KEY` placeholder to prevent the Keychain lookup. The OpenRouter provider still uses `OPENROUTER_API_KEY`; the real key is not copied to the Mistral variable. The sandbox's Keychain denial remains in place.
diff --git a/run-vibe.sh b/run-vibe.sh
index c4a5223..efff9cb 100755
--- a/run-vibe.sh
+++ b/run-vibe.sh
@@ -12,7 +12,7 @@ SH=$(mktemp -d /tmp/vhome-XXXXXX); VH=$(mktemp -d /tmp/vibehome-XXXXXX)
 cp "$D/vibe/config.toml" "$VH/config.toml"
 mkdir -p "$D/logs"
 ( cd "$W" && env -i PATH="$PATH" TERM="${TERM:-dumb}" LANG="${LANG:-en_US.UTF-8}" HOME="$SH" VIBE_HOME="$VH" \
-    OPENROUTER_API_KEY="$OPENROUTER_API_KEY" \
+    OPENROUTER_API_KEY="$OPENROUTER_API_KEY" MISTRAL_API_KEY=unused-placeholder \
     sandbox-exec -D HOME="$REAL" -f "$D/agent.sb" \
     "$VIBE" -p "$PROMPT" --model devstral --auto-approve --trust --output streaming --output-dir "$VH/out" \
       --max-price 1.5 --time-limit 1200 < /dev/null > "$D/logs/last-run.out" 2> "$D/logs/last-run.err" )
