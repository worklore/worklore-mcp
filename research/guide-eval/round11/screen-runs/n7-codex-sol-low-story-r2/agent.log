{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc 'for f in src/* README.md tsconfig.json; do echo \"$f\"; cat \"$f\"; done'","aggregated_output":"src/App.tsx\nimport { PollarProvider } from '@pollar/react';\nimport { pollarConfig } from './pollar';\nimport { Wallet } from './Wallet';\n\nexport function App() {\n  return (\n    <PollarProvider client={pollarConfig}>\n      <Wallet />\n    </PollarProvider>\n  );\n}\nsrc/Wallet.tsx\nimport { useEffect, useState } from 'react';\nimport { usePollar } from '@pollar/react';\nimport { balanceLines } from './balances';\nimport { enableUsdc } from './trust';\nimport { bestTopUpRate } from './ramp';\n\nexport function Wallet() {\n  const { isAuthenticated, wallet, login, walletBalance, refreshWalletBalance, getClient } = usePollar();\n  const [rate, setRate] = useState<number | null>(null);\n\n  useEffect(() => {\n    if (wallet) void refreshWalletBalance();\n  }, [wallet, refreshWalletBalance]);\n\n  if (!isAuthenticated) return <button onClick={() => login({ provider: 'google' })}>Sign in to tip</button>;\n  if (!wallet) return <p>Creating your wallet...</p>;\n\n  return (\n    <section>\n      <p>Wallet: {wallet.address}</p>\n      {walletBalance.step === 'loaded' && (\n        <ul>\n          {balanceLines(walletBalance.data.balances).map((line) => (\n            <li key={line}>{line}</li>\n          ))}\n        </ul>\n      )}\n      <button onClick={() => void enableUsdc(getClient())}>Accept USDC</button>\n      <button onClick={async () => setRate(await bestTopUpRate(getClient(), 10_000))}>Add money</button>\n      {rate !== null && <p>1 USDC = {rate} ARS</p>}\n    </section>\n  );\n}\nsrc/balances.ts\nimport type { WalletBalanceRecord } from '@pollar/core';\n\n/** One line per asset for the wallet screen, e.g. \"USDC 12.50\". */\nexport function balanceLines(records: WalletBalanceRecord[]): string[] {\n  return records.map((r) => `${r.type === 'native' ? 'XLM' : r.code} ${parseFloat(r.balance).toFixed(2)}`);\n}\nsrc/kyc.ts\nimport type { PollarClient } from '@pollar/core';\n\n/** Waits for the identity check and returns the line the wallet screen shows. */\nexport async function kycMessage(client: PollarClient, providerId: string): Promise<string> {\n  const status = await client.pollKycStatus(providerId, { intervalMs: 3000, timeoutMs: 120_000 });\n  switch (status) {\n    case 'approved':\n      return 'Verified';\n    case 'rejected':\n      return 'Verification failed';\n    case 'pending':\n      return 'Still being checked';\n    case 'none':\n      return 'Not started';\n  }\n}\nsrc/pollar.ts\nimport type { PollarClientConfig } from '@pollar/core';\n\nexport const pollarConfig: PollarClientConfig = {\n  apiKey: 'pub_testnet_tipjar_demo',\n  stellarNetwork: 'testnet',\n  baseUrl: 'https://sdk.api.pollar.xyz/v1',\n};\n\nexport const USDC = { code: 'USDC', issuer: 'GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5' };\nsrc/ramp.ts\nimport type { PollarClient } from '@pollar/core';\n\n/** \"Add money\": the best rate for topping up the wallet with Argentine pesos, or null if no provider quotes. */\nexport async function bestTopUpRate(client: PollarClient, pesos: number): Promise<number | null> {\n  const res = await client.getRampsQuote({ country: 'AR', currency: 'ARS', amount: pesos, direction: 'onramp' });\n  return res.quotes[0]?.rate ?? null;\n}\nsrc/trust.ts\nimport type { PollarClient } from '@pollar/core';\nimport { USDC } from './pollar';\n\n/** Lets the wallet hold USDC; the app sponsors the reserve. */\nexport async function enableUsdc(client: PollarClient): Promise<boolean> {\n  const outcome = await client.setTrustline(USDC, { sponsored: true });\n  return outcome.status === 'success';\n}\nREADME.md\n# Tip jar\n\nA small web app where fans tip a creator in USDC on Stellar. Wallets, balances, KYC and the\n\"Add money\" quote come from Pollar (https://pollar.xyz).\n\n`npm run typecheck` checks the project. The UI is mounted by the creator's site, so there is\nno dev server here.\ntsconfig.json\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\", \"module\": \"ESNext\", \"moduleResolution\": \"Bundler\",\n    \"jsx\": \"react-jsx\", \"strict\": true, \"noImplicitReturns\": true,\n    \"skipLibCheck\": true, \"noEmit\": true, \"lib\": [\"ES2022\", \"DOM\"]\n  },\n  \"include\": [\"src\"]\n}\n","exit_code":0,"status":"completed"}}
