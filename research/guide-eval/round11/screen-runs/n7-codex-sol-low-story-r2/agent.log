'get']['responses'][200]['content']['application/json']['content'];\ntype RampDirection = NonNullable<paths['/ramps/routes']['get']['parameters']['query']>['direction'];\n/** The fiat and asset pairs the app can ramp between in a direction, each with the legs of its shortest path. */\ntype RampRoutesResponse = RampsGet<'/ramps/routes'>;\ntype RampRoute = RampRoutesResponse['routes'][number];\ntype RampFiat = RampRoute['fiat'];\ntype RampAsset = RampRoute['asset'];\ntype RampLegKind = RampRoute['legs'][number];\ntype RampQuoteRequest = NonNullable<paths['/ramps/quotes']['post']['requestBody']>['content']['application/json'];\ntype RampQuotesResponse = paths['/ramps/quotes']['post']['responses'][200]['content']['application/json']['content'];\n/** One route quoted leg by leg; `quotes` come best first. */\ntype RampQuote = RampQuotesResponse['quotes'][number];\ntype RampQuoteLeg = RampQuote['legs'][number];\n/** A value the user fills in before the order; its answer goes in `payee` under `key`. */\ntype RampField = RampQuoteLeg['requiredFields'][number];\n/** A route that was planned and dropped, with why (`failure.resolutionAction`). */\ntype RampQuoteRejection = RampQuotesResponse['rejected'][number];\n/** The verification step a dropped route waits on: complete it (KYC, form, registry check, registration), then quote again. */\ntype RampQuoteRequirement = NonNullable<RampQuoteRejection['requirement']>;\ntype RampOrderRequest = NonNullable<paths['/ramps/orders']['post']['requestBody']>['content']['application/json'];\n/** An order with every leg, what it waits for (`pendingAction`) and when to read it again (`nextPollAfter`). */\ntype RampOrder = RampsGet<'/ramps/orders/{id}'>;\ntype RampOrderLeg = RampOrder['legs'][number];\ntype RampOrderLegStep = RampOrderLeg['steps'][number];\ntype RampPendingAction = NonNullable<RampOrder['pendingAction']>;\ntype RampSignatureAction = Extract<RampPendingAction, {\n    kind: 'SIGNATURE';\n}>;\n/** How to pay the fiat side: a QR (its code already rendered in `scannable`) or bank coordinates. */\ntype RampFiatInstructions = Extract<RampPendingAction, {\n    kind: 'FIAT_PAYMENT';\n}>['instructions'];\n/**\n * A code to scan, rendered by the server so no QR encoder is needed. A Pollar-made\n * SVG (`image.inlineSafe`) uses `currentColor` and can be injected as markup; a\n     *  - **External/adapter** -> `/wallet/assets/trustline/build` returns a\n     *    `changeTrust` XDR (sponsor-signed when covered, or a plain self-pay one\n     *    otherwise); the user's own wallet adds the trustor signature and submits.\n     *  - **`skipSponsorship`** -> a plain self-pay `change_trust` via {@link runTx},\n     *    bypassing the sponsoring endpoints for both wallet types.\n     *\n     * Does not refresh on its own - callers should `refreshAssets()` afterwards.\n     */\n    setTrustline(asset: {\n        code: string;\n        issuer: string;\n    }, opts?: {\n        limit?: string;\n        /**\n         * Force self-pay even when the app would sponsor the trustline - the\n         * opt-out that mirrors `skipSponsorship` on the payment / swap / contract\n         * fee-bump surfaces.\n         */\n        skipSponsorship?: boolean;\n    }): Promise<TrustlineOutcome>;\n    /** A refused trustline call, with the API's code so a UI can say what to do about it. */\n    private _trustlineError;\n    /**\n     * Create this wallet's account on the Stellar network when it doesn't exist\n     * yet. For EXTERNAL wallets (Freighter / client-side Privy) whose key the\n     * platform doesn't hold: the server builds a sponsored `createAccount` (the new\n11692-                                    /** @constant */\n11693-                                    type: \"credit_alphanum12\";\n11694-                                    code: string;\n11695-                                    issuer: string;\n11696-                                };\n11697:                                amountIn: string;\n11698:         