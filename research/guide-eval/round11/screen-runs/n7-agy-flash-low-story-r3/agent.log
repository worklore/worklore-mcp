bits \u003e= 8) {\\n      out[index++] = (value \u003e\u003e (bits - 8)) \u0026 0xff;\\n      bits -= 8;\\n    }\\n  }\\n  const crc = crc16(out.subarray(0, 33));\\n  if (out[0] !== 6 \u003c\u003c 3 || out[33] !== (crc \u0026 0xff) || out[34] !== crc \u003e\u003e 8) throw new Error('bad Stellar address');\\n  return out.slice(1, 33);\\n}\\n\\nconst sameKey = (a: Uint8Array | null, b: Uint8Array) =\u003e !!a \u0026\u0026 a.length === b.length \u0026\u0026 a.every((byte, i) =\u003e byte === b[i]);\\n\\n/**\\n * Throws unless the Stellar ramp action spends only from `address`: every\\n * operation of a payment or contract call runs as that account (inside a fee\\n * bump the app adds, too). A SEP-10 login (`summary: 'authentication'`) is the\\n * anchor's challenge instead: sequence zero, no fee bump, data entries only, the\\n * first one from `address` and the rest from the anchor. Call it before the\\n * wallet is asked to sign.\\n */\\nexport function assertRampStellarSigner(action: RampSignatureAction, address: string): void {\\n  const fail = () =\u003e new Error('This step is not for the connected Stellar account. Reconnect the wallet it was built for.');\\n  let account: Uint8Array;\\n  let tx: StellarTransactionSources;\\n  try {\\n    account = stellarAccountKey(address);\\n    tx = readStellarTransactionSources(action.payload.value);\\n  } catch {\\n    throw fail();\\n  }\\n  if (action.summary === 'authentication') {\\n    const [first, ...rest] = tx.operations;\\n    if (\\n      tx.feeBump ||\\n      !tx.sequenceIsZero ||\\n      first?.type !== MANAGE_DATA ||\\n      !sameKey(first.source, account) ||\\n      rest.some((op) =\u003e op.type !== MANAGE_DATA || (op.source !== null \u0026\u0026 !sameKey(op.source, tx.source)))\\n    )\\n      throw fail();\\n    return;\\n  }\\n  if (!sameKey(tx.source, account) || tx.operations.some((op) =\u003e !sameKey(op.source ?? tx.source, account))) throw fail();\\n}\\n\",\"// React Native entry point. Always uses `NobleKeyManager` (pure-JS ECDSA via\\n// `@noble/curves`) backed by the injected `Storage` adapter (Keychain /\\n// SecureStore).\\n//\\n// Why not WebCrypto, even when `crypto.subtle` is present? A polyfill like\\n// react-native-quick-crypto exposes `crypto.subtle.generateKey/sign`, but\\n// `WebCryptoKeyManager` persists the keypair in IndexedDB and generates\\n// non-extractable keys - and in React Native there is no IndexedDB AND\\n// non-extractable keys can't be serialized to the Storage adapter. Picking it\\n// here would mean a brand-new DPoP keypair on every app launch: the JWK\\n// thumbprint changes each start, so every sender-constrained access/refresh\\n// token gets rejected - a forced logout loop. Noble persists the 32-byte\\n// private scalar through `Storage`, so the key survives restarts. On RN,\\n// Noble is the only manager that can persist.\\n//\\n// Resolved automatically by Metro and other RN-aware bundlers via the\\n// `\\\"react-native\\\"` condition in `package.json#exports`.\\n\\nimport { _setDefaultKeyManagerFactory } from './keys/factory';\\nimport { NobleKeyManager } from './keys/noble';\\n\\n_setDefaultKeyManagerFactory((storage, apiKey, options) =\u003e {\\n  return new NobleKeyManager(storage, apiKey, options);\\n});\\n\\nexport * from './public';\\nexport { NobleKeyManager } from './keys/noble';\\n\"]}\r\n"}}}
