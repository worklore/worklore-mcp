diff --git a/ANSWER.md b/ANSWER.md
new file mode 100644
index 0000000..308441b
--- /dev/null
+++ b/ANSWER.md
@@ -0,0 +1,6 @@
+# Changes Implemented
+
+Added the `codex-sandboxed` lane to `run.sh`:
+- Created `codex_sandboxed_run()` which runs `codex exec` under macOS `sandbox-exec` using `sandbox/agent.sb` with `-D HOME="$REAL"` and an isolated temporary scratch `HOME` directory (`mktemp -d /tmp/chome-XXXXXX`), matching the execution pattern used by the `kimi` lane.
+- Cleaned up the temporary scratch directory after execution.
+- Added `codex-sandboxed` to the lane selector `case` statement and updated the header usage comments.
diff --git a/run.sh b/run.sh
index c41ad67..b37d7d3 100755
--- a/run.sh
+++ b/run.sh
@@ -1,7 +1,8 @@
 #!/usr/bin/env bash
 # usage: run.sh <task> <lane> [rep]
-# lanes: codex   Codex CLI, unsandboxed
-#        kimi    Kimi Code under sandbox/agent.sb (no reading or writing the real home), scratch HOME
+# lanes: codex             Codex CLI, unsandboxed
+#        codex-sandboxed   Codex CLI under sandbox/agent.sb, scratch HOME
+#        kimi              Kimi Code under sandbox/agent.sb (no reading or writing the real home), scratch HOME
 set -u
 D="$(cd "$(dirname "$0")" && pwd)"
 T=$1; A=$2; REP=${3:-1}
@@ -15,6 +16,14 @@ codex_run() {
       -o "$R/final.txt" "$P" < /dev/null > "$R/agent.log" 2> "$R/agent.err" )
 }
 
+codex_sandboxed_run() {
+  local REAL="$HOME" SH; SH=$(mktemp -d /tmp/chome-XXXXXX)
+  ( cd "$W" && export HOME="$SH" && sandbox-exec -D HOME="$REAL" -f "$D/sandbox/agent.sb" \
+      timeout $TO codex exec --skip-git-repo-check --dangerously-bypass-approvals-and-sandbox -C "$W" --json \
+      -o "$R/final.txt" "$P" < /dev/null > "$R/agent.log" 2> "$R/agent.err" )
+  local rc=$?; rm -rf "$SH"; return $rc
+}
+
 # Kimi's output goes to Moonshot: its shell runs under sandbox/agent.sb with an empty scratch HOME.
 kimi_run() {
   local REAL="$HOME" SH; SH=$(mktemp -d /tmp/khome-XXXXXX)
@@ -26,8 +35,9 @@ kimi_run() {
 
 start=$(date +%s)
 case $A in
-  codex) codex_run;;
-  kimi)  kimi_run;;
+  codex)           codex_run;;
+  codex-sandboxed) codex_sandboxed_run;;
+  kimi)            kimi_run;;
   *) echo "unknown lane $A"; exit 2;;
 esac
 rc=$?
