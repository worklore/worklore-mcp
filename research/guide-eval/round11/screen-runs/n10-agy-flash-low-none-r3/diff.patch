+function hasDefaultExport(ts: typeof TS, sourceFile: TS.SourceFile): boolean {
+  return sourceFile.statements.some(
+    (statement) =>
+      (ts.isExportAssignment(statement) && !statement.isExportEquals) ||
+      (ts.isExportDeclaration(statement) &&
