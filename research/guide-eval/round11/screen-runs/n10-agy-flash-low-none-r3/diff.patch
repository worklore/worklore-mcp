+                  const key = enumKey(namespaceId, name);
+                  if (SQLITE_INTEGER_CODECS.has(codecId)) {
+                    integerEnums.add(key);
+                    return {
+                      ...enumType,
+                      members: members.map((member) =>
+                        isRecord(member) && member['value'] !== undefined
+                          ? { ...member, value: digitText(member['value']) }
+                          : member,
+                      ),
+                    };
+                  }
