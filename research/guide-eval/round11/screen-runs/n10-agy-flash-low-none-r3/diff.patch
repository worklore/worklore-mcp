+      Contracts emitted before the upgrade keep working (`pg/timestamptz@1` still exists).
+    detection:
+      glob: "**/*.{prisma,ts,mts,cts}"
+      regex:
+        - '@db\.Date'
+        - '\sDate(\s|\?|\[|$)'
+      anyMatch: true
+  - id: sql-escape-error-class-removed
+    summary: |
