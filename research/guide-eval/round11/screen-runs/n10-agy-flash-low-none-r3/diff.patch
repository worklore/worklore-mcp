+  const visit = (dir: string): void => {
+    const realDir = realpathSync(dir);
+    if (visited.has(realDir)) return;
+    visited.add(realDir);
+    const entries = readdirSync(dir, { withFileTypes: true }).sort((a, b) =>
+      compareCodeUnits(a.name, b.name),
