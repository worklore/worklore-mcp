+  for (const match of text.matchAll(/DefaultLiteralValue<\s*(['"])sqlite\/datetime@1\1\s*,\s*/g)) {
+    const start = match.index + match[0].length;
+    edits.push(...datetimeEdits(text, start, genericArgumentEnd(text, start)));
