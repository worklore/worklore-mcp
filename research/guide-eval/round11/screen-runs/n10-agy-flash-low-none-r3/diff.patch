+    detection:
+      glob: "**/*.{ts,mts,cts,tsx}"
+      matches:
+        - '\bBuildRefusal\b'
+        - '\bbuildMongoContractFromDefinition\b'
+  - id: mongo-execution-context-checks-contract-requirements
