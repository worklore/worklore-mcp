+      glob: "**/*.{ts,mts,cts,tsx}"
+      matches:
+        - 'import\s*\{[^}]*\bfield\b[^}]*\}\s*from\s*[''"]@(?:prisma/orm-|internal/)postgres/contract-builder[''"]'
+  - id: codecs-check-stored-json
+    summary: |
