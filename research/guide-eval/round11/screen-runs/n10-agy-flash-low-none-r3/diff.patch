+      contract === undefined &&
+      (JSON_FILES_THAT_MUST_PARSE.has(basename(path)) || files.refs.includes(path))
+    ) {
+      stops.push(`${display(path)}: not valid JSON`);
+      continue;
+    }
+    if (
+      !isRecord(contract) ||
+      contract['targetFamily'] !== 'sql' ||
+      typeof contract['target'] !== 'string'
