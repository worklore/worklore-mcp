+      const columns = isRecord(table) ? table['columns'] : undefined;
+      const column =
+        isRecord(columns) && typeof columnName === 'string' ? columns[columnName] : undefined;
+      if (
+        typeof field !== 'string' ||
+        typeof columnName !== 'string' ||
