+    detection:
+      glob: "**/*.prisma"
+      matches:
+        - '@@type\(\s*"mongo/(?:int64|int64Number|date|objectId|decimal128|binary|vector)@1"'
+        - '@@type\(\s*"mongo/double@1"\s*\)[^}]*"(?:NaN|-?Infinity)"'
+  - id: mongo-orm-takes-enum-accessors
