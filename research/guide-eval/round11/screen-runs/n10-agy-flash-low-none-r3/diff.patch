+    schemaVersion: '1',
+    targetFamily: typeof contract['targetFamily'] === 'string' ? contract['targetFamily'] : '',
+    target: typeof contract['target'] === 'string' ? contract['target'] : '',
+    profileHash: '',
+    roots: {},
+    domain: { namespaces: {} },
+    storage: omitNamespaceKinds(withoutHash),
+    extensions: {},
+    capabilities: {},
+    meta: {},
+  };
