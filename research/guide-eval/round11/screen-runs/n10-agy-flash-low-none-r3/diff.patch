+    const char = text[index];
+    if (quote !== undefined) {
+      if (char === '\\') index++;
+      else if (char === quote) quote = undefined;
+      continue;
+    }
+    if (char === "'" || char === '"' || char === '`') quote = char;
+    else if (char === '{' || char === '[' || char === '(' || char === '<') depth++;
+    else if (char === '}' || char === ']' || char === ')') depth--;
+    else if (char === '>') {
+      if (depth === 0) return index;
+      depth--;
+    }
+  }
