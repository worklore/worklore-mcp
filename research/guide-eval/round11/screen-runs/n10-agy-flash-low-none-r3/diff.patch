+function identifiersIn(ts: typeof TS, node: TS.Node): string[] {
+  const names: string[] = [];
+  const visit = (child: TS.Node): void => {
+    if (ts.isIdentifier(child) && isReference(ts, child)) names.push(child.text);
+    ts.forEachChild(child, visit);
+  };
+  visit(node);
+  return names;
+}
+
