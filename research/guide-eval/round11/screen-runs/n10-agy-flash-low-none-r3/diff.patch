+    return {
+      binding: element.name,
+      edit: { start: statement.getStart(sourceFile), end: call.getStart(sourceFile), text: '' },
+    };
+  }
+  const next = pattern.elements[index + 1];
+  const previous = pattern.elements[index - 1];
+  const edit =
+    next !== undefined
