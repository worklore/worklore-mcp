+const APP_SPACE_ID = 'app';
+const HASH = /^[0-9a-f]{64}$/;
+const TEMPORARY_SUFFIX = '.expand-type-aliases-tmp';
+const BYTE_ORDER_MARK = '\uFEFF';
+
