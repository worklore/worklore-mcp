+    if (child !== undefined) {
+      ordered[key] = child;
+      remaining.delete(key);
+    }
+  }
+  for (const key of [...remaining].sort(compareCodeUnits)) {
+    const child = value[key];
+    if (child !== undefined) ordered[key] = child;
