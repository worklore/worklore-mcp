+
+function mapRecord(value: Json, map: (key: string, child: Json) => Json): Json {
+  if (!isRecord(value)) return value;
+  const result: JsonRecord = {};
+  for (const [key, child] of Object.entries(value)) result[key] = map(key, child);
+  return result;
