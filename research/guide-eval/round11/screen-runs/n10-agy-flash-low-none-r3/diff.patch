+    detection:
+      glob: "**/*.{ts,tsx,mts,cts,js,mjs,cjs,sql,env}"
+      matches:
+        - 'new\s+(?:pg\.)?(?:Pool|Client)\s*\('
+        - '\b[Ss][Ee][Tt]\s+(?:[Ss][Ee][Ss][Ss][Ii][Oo][Nn]\s+|[Ll][Oo][Cc][Aa][Ll]\s+)?[Dd][Aa][Tt][Ee][Ss][Tt][Yy][Ll][Ee]\b'
