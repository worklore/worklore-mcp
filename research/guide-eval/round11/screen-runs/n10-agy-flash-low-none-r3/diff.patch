+      glob: "**/*.prisma"
+      matches:
+        - '(?<![\s\S])(?!\s*// *use +(?:prisma-8|prisma-next) *(?!\S))[\s\S]*\n[ \t]*\w+[ \t]+(?:String|Int|BigInt|Float|Decimal|Boolean|DateTime|Json|Bytes)\[\]'
+        - '(?<![\s\S])(?!\s*// *use +(?:prisma-8|prisma-next) *(?!\S))(?=[\s\S]*\benum[ \t]+\w+[ \t]*\{)[\s\S]*\n[ \t]*\w+[ \t]+\w+\[\]'
