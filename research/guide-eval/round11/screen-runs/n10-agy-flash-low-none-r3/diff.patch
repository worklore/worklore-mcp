+    detection:
+      glob: "**/*.{ts,mts,cts,tsx,js,mjs,cjs}"
+      matches:
+        - '[''"]@prisma/orm-(?:target-)?postgres/adapter/control[''"]'
+  - id: parameter-casts-use-base-names
