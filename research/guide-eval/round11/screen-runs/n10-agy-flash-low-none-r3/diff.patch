+      `{ codecId: 'pg/text@1', nativeType: 'text' }`. Code that reads or builds a column of a stored
+      contract uses `dataType` (for example `pg/text`) instead of `nativeType` (`text`).
+    detection:
+      glob: "**/*.{ts,mts,cts,tsx}"
+      matches:
+        - '(?<![\w$])(?<!readonly\s+)nativeType\s*:\s*[''"]'
+        - '\.nativeType\b'
