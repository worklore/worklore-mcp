+  const nextStorage = mapRecord(storage ?? null, (key, storageNamespaces) =>
+    key !== 'namespaces'
+      ? storageNamespaces
+      : mapRecord(storageNamespaces, (namespaceId, namespace) =>
+          mapRecord(namespace, (namespaceKey, entries) =>
