+    detection:
+      glob: "**/contract.json"
+      matches:
+        - '(?<![\s\S])(?=[\s\S]*"(?:sqlite/(?:bigint|bigintnumber|integer)|sql/int|mongo/int64(?:Number)?)@1")[\s\S]*"(?:-0|-?0\d+)"'
+  - id: db-enums-members-hold-read-values
+    summary: |
