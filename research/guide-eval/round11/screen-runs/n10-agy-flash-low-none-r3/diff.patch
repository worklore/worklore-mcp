+        - ':\s*AuthoringEntityContext\s*=\s*\{'
+  - id: mongo-derive-json-schema-takes-lookups
+    summary: |
+      `deriveJsonSchema` and `derivePolymorphicJsonSchema` (from `@internal/mongo-contract-psl`)
