+      glob: "**/*.{ts,mts,cts,tsx,js,mjs,cjs,jsx}"
+      matches:
+        - '(?<![\w$.])createMongoRuntime\s*\('
+        - '(?<![\w$])[\w$]*[cC]ontext\s*\.\s*stack(?![\w$])'
+        - '(?<![\w$])MongoExecutionContext\s*<(?:[^<>]|<(?:[^<>]|<[^<>]*>)*>)*,'
+        - '(?<![\w$])MongoExecutionContext\s*<\s*(?:unknown|\{)'
