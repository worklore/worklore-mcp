+    detection:
+      glob: "**/*.{ts,mts,cts}"
+      matches:
+        - '\bbuildBoundContract\b[^;]*from\s*[''"]@internal/sql-contract-ts/'
+  - id: postgres-codec-registry-takes-data-type-lookup
+    summary: |
