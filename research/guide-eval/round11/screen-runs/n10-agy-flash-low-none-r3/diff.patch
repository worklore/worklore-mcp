+      char storage explicitly in the type position (`Char(36) @default(uuid())`, …), then
+      re-emit.
+    detection:
+      glob: "**/*.{ts,mts,cts,prisma}"
+      contains:
+        - "resolveGeneratedColumnDescriptor"
+        - "resolveBuiltinGeneratedColumnDescriptor"
+        - "baseScalar"
+        - "@default(uuid("
