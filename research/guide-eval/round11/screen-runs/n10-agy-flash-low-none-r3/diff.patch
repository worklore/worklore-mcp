+    contract: enums.contract,
+    changed,
+    unknownCodecs: [...unknownCodecs].sort(compareCodeUnits),
+    defaultRewrites,
+    integerEnums: enums.integerEnums,
+    jsonEnums: enums.jsonEnums,
+    columnCardinalities: columnCardinalities(withLists),
