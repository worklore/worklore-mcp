+    if (isRecord(namespace)) {
+      const { kind: _kind, ...rest } = namespace;
+      stripped[namespaceId] = rest;
+    } else {
+      stripped[namespaceId] = namespace;
+    }
+  }
+  return { ...storage, namespaces: stripped };
