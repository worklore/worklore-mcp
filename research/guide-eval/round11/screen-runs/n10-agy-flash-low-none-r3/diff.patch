+  if (key === 'elementNullable' && path.at(-2) === 'many') return true;
+  if (FRAMEWORK_PRESERVED_EMPTY.some((pattern) => matchesPath(path, pattern))) return true;
+  return isFamilyPreservedEmpty(family, path);
