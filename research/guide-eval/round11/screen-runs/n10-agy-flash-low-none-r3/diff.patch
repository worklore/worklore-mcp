+        - '["'']renameCheckConstraint["'']\s*[!=]==?\s*[\w$.?]*factoryName'
+        - 'case\s+["'']renameCheckConstraint["'']\s*:'
+  - id: control-family-instance-sign-spaces
+    summary: |
+      `ControlFamilyInstance` has a new required method, `signSpaces({ driver, spaces })`, which
