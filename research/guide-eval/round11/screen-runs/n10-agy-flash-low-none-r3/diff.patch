+    if (key === 'generated' && child === false) continue;
+    if ((key === 'onDelete' || key === 'onUpdate') && child === 'noAction') continue;
+    if (isDefaultValue(child) && !isPreservedEmpty(childPath, key)) continue;
+    result[key] = omitDefaults(child, childPath);
