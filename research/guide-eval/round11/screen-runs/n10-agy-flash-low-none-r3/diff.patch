+    ...withoutDefaults,
+    storage: sortTableArrays(withoutDefaults['storage'] ?? {}),
+  };
+  const sorted = sortKeys(withSortedStorage);
+  return isRecord(sorted) ? sha256(JSON.stringify(orderTopLevel(sorted), null, 2)) : '';
