+  const columnCodecs = new Map<string, string>();
+  const storage = contract['storage'];
+  const namespaces = isRecord(storage) ? storage['namespaces'] : undefined;
+  for (const namespace of isRecord(namespaces) ? Object.values(namespaces) : []) {
