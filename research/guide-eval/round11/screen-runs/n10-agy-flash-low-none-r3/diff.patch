+    migrationJson: named((_file, name) => name === 'migration.json'),
+    refs: named((file, name) => name.endsWith('.json') && basename(dirname(file.path)) === 'refs'),
+    migrationTs: named((file, name) => name === 'migration.ts' && file.inMigrationPackage),
