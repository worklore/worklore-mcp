+    detection:
+      glob: "**/*.{prisma,ts,mts,cts}"
+      matches:
+        - 'extension\s+(vector|postgis|pg_search|citext)\s*\{'
+        - 'extension\(\s*[''"](vector|postgis|pg_search|citext)[''"]'
