+
+function isInColumnDefault(block: Block): boolean {
+  for (let ancestor = block.parent; ancestor !== undefined; ancestor = ancestor.parent)
+    if (
+      ancestor.label === 'default' &&
+      ancestor.parent !== undefined &&
+      isColumnBlock(ancestor.parent)
