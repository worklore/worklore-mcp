+  for (const match of text.matchAll(/readonly values: readonly \[/g)) {
+    const valueSet = innermostBlock(blocks, match.index);
+    const kind = valueSet?.parent;
+    const namespace = kind?.parent?.parent;
+    if (
+      valueSet === undefined ||
+      kind?.label !== 'valueSet' ||
+      kind.parent?.label !== 'entries' ||
