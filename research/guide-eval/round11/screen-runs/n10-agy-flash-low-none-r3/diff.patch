+}
+
+function replaceQuotedHashes(text: string, hashes: ReadonlyMap<string, string>): string {
+  return text.replace(/"([0-9a-f]{64})"/g, (match: string, hash: string) => {
+    const next = hashes.get(hash);
+    return next === undefined ? match : `"${next}"`;
+  });
