+  'namespaces',
+  '*',
+  'entries',
+  'table',
+  '*',
+  'columns',
+  '*',
+  'default',
+  'value',
+];
+const MONGO_PRESERVED_EMPTY: readonly (readonly PathSegment[])[] = [
+  ['storage', 'namespaces', '*', 'entries', 'collection'],
+  ['storage', 'namespaces', '*', 'entries', 'collection', '*'],
+];
