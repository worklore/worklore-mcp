+      glob: "**/*.{ts,mts,cts,tsx}"
+      matches:
+        - '(?<![\w$.])field\.generated\('
+        - 'import\s*(?:type\s*)?\{[^}]*(?<![\w$])(?:uuidv4|uuidv7|ulid|nanoid|cuid2|ksuid)(?![\w$])[^}]*\}\s*from\s*[\x27"]@prisma/orm-framework/ids[\x27"]'
