s-api ready\");\r\ndiff --git a/tsconfig.json b/tsconfig.json\r\nnew file mode 100644\r\nindex 0000000..0754d70\r\n--- /dev/null\r\n+++ b/tsconfig.json\r\n@@ -0,0 +1,12 @@\r\n+{\r\n+  \"compilerOptions\": {\r\n+    \"target\": \"ES2023\",\r\n+    \"module\": \"ESNext\",\r\n+    \"moduleResolution\": \"bundler\",\r\n+    \"strict\": true,\r\n+    \"esModuleInterop\": true,\r\n+    \"skipLibCheck\": true,\r\n+    \"resolveJsonModule\": true\r\n+  },\r\n+  \"include\": [\"src\", \"*.ts\"]\r\n+}\r\n"}}}
