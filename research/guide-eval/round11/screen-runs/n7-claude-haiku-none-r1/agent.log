{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011Cgsvj2mHz8qdb4ftMT6qz","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_014HS2TmDoXGhigkb95egY3K","name":"Write","input":{"file_path":"/private/tmp/h-JHDjm1/src/ramp.ts","content":"import { isPollarApiError, type PollarClient, type RampQuote, type RampRoute } from '@pollar/core';\nimport { USDC } from './pollar';\n\n/** The ARS -> USDC on-ramp routes (one per payment rail), e.g. the bank transfer rail. */\nfunction arsToUsdcRoutes(routes: RampRoute[]): RampRoute[] {\n  return routes.filter(\n    (r) =>\n      r.fiat.country === 'AR' &&\n      r.fiat.currency === 'ARS' &&\n      r.asset.code === USDC.code &&\n      r.asset.chain === 'STELLAR' &&\n      r.asset.identifier === USDC.issuer,\n  );\n}\n\n/** ARS paid per USDC received, including the fees in the quote. */\nfunction pesosPerUsdc(quote: RampQuote): number | null {\n  const out = Number(quote.amountOut);\n  return out > 0 ? Number(quote.amountIn) / out : null;\n}\n\n/**\n * \"Add money\": the best rate for topping up the wallet with Argentine pesos, or null if no provider quotes.\n * Quotes every ARS route, then takes the lowest pesos-per-USDC.\n */\nexport async function bestTopUpRate(client: PollarClient, pesos: number): Promise<number | null> {\n  const { routes } = await client.getRampRoutes('ONRAMP');\n  const quotes = await Promise.all(\n    arsToUsdcRoutes(routes).map(async (route) => {\n      try {\n        const res = await client.quoteRamp({\n          direction: 'ONRAMP',\n          fiat: { currency: route.fiat.currency, rail: route.fiat.rail, country: route.fiat.country },\n          asset: { code: route.asset.code, identifier: route.asset.identifier, chain: route.asset.chain },\n          amount: { value: String(pesos), denomination: 'in' },\n        });\n        return res.quotes;\n      } catch (err) {\n        // No route with liquidity answers 422 SDK_RAMPS_NO_ROUTE: that is \"no quote\" for this rail.\n        if (isPollarApiError(err) && err.code === 'SDK_RAMPS_NO_ROUTE') return [];\n        throw err;\n      }\n    }),\n  );\n  const rates = quotes.flat().map(pesosPerUsdc).filter((r): r is number => r !== null);\n  return rates.length > 0 ? Math.min(...rates) : null;\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1699,"cache_read_input_tokens":88561,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1699},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"744e830a-1f76-4ce2-97b8-7e3bec158cf2","uuid":"3f3b35d4-6a28-4fbf-b995-41baaa3b0e68","timestamp":"2026-11-09T19:44:11.973Z","request_id":"req_011Cgsvj2bd3m5sq4ikkpAKr","wire_tool_inputs":{"toolu_014HS2TmDoXGhigkb95egY3K":{"file_path":"/private/tmp/h-JHDjm1/src/ramp.ts","content":"import { isPollarApiError, type PollarClient, type RampQuote, type RampRoute } from '@pollar/core';\nimport { USDC } from './pollar';\n\n/** The ARS -> USDC on-ramp routes (one per payment rail), e.g. the bank transfer rail. */\nfunction arsToUsdcRoutes(routes: RampRoute[]): RampRoute[] {\n  return routes.filter(\n    (r) =>\n      r.fiat.country === 'AR' &&\n      r.fiat.currency === 'ARS' &&\n      r.asset.code === USDC.code &&\n      r.asset.chain === 'STELLAR' &&\n      r.asset.identifier === USDC.issuer,\n  );\n}\n\n/** ARS paid per USDC received, including the fees in the quote. */\nfunction pesosPerUsdc(quote: RampQuote): number | null {\n  const out = Number(quote.amountOut);\n  return out > 0 ? Number(quote.amountIn) / out : null;\n}\n\n/**\n * \"Add money\": the best rate for topping up the wallet with Argentine pesos, or null if no provider quotes.\n * Quotes every ARS route, then takes the lowest pesos-per-USDC.\n */\nexport async function bestTopUpRate(client: PollarClient, pesos: number): Promise<number | null> {\n  const { routes } = await client.getRampRoutes('ONRAMP');\n  const quotes = await Promise.all(\n    arsToUsdcRoutes(routes).map(async (route) => {\n      try {\n        const res = await client.quoteRamp({\n          direction: 'ONRAMP',\n          fiat: { currency: route.fiat.currency, rail: route.fiat.rail, country: route.fiat.country },\n          asset: { code: route.asset.code, identifier: route.asset.identifier, chain: route.asset.chain },\n          amount: { value: String(pesos), denomination: 'in' },\n        });\n        return res.quotes;\n      } catch (err) {\n        // No route with liquidity answers 422 SDK_RAMPS_NO_ROUTE: that is \"no quote\" for this rail.\n        if (isPollarApiError(err) && err.code === 'SDK_RAMPS_NO_ROUTE') return [];\n        throw err;\n      }\n    }),\n  );\n  const rates = quotes.flat().map(pesosPerUsdc).filter((r): r is number => r !== null);\n  return rates.length > 0 ? Math.min(...rates) : null;\n}\n"}}}
