ence zero, no fee bump, data entries only, the\\n * first one from `address` and the rest from the anchor. Call it before the\\n * wallet is asked to sign.\\n */\\nexport function assertRampStellarSigner(action: RampSignatureAction, address: string): void {\\n  const fail = () =\u003e new Error('This step is not for the connected Stellar account. Reconnect the wallet it was built for.');\\n  let account: Uint8Array;\\n  let tx: StellarTransactionSources;\\n  try {\\n    account = stellarAccountKey(address);\\n    tx = readStellarTransactionSources(action.payload.value);\\n  } catch {\\n    throw fail();\\n  }\\n  if (action.summary === 'authentication') {\\n    const [first, ...rest] = tx.operations;\\n    if (\\n      tx.feeBump ||\\n      !tx.sequenceIsZero ||\\n      first?.type !== MANAGE_DATA ||\\n      !sameKey(first.source, account) ||\\n      rest.some((op) =\u003e op.type !== MANAGE_DATA || (op.source !== null \u0026\u0026 !sameKey(op.source, tx.source)))\\n    )\\n      throw fail();\\n    return;\\n  }\\n  if (!sameKey(tx.source, account) || tx.operations.some((op) =\u003e !sameKey(op.source ?? tx.source, account))) throw fail();\\n}\\n\",\"// React Native entry point. Always uses `NobleKeyManager` (pure-JS ECDSA via\\n// `@noble/curves`) backed by the injected `Storage` adapter (Keychain /\\n// SecureStore).\\n//\\n// Why not WebCrypto, even when `crypto.subtle` is present? A polyfill like\\n// react-native-quick-crypto exposes `crypto.subtle.generateKey/sign`, but\\n// `WebCryptoKeyManager` persists the keypair in IndexedDB and generates\\n// non-extractable keys - and in React Native there is no IndexedDB AND\\n// non-extractable keys can't be serialized to the Storage adapter. Picking it\\n// here would mean a brand-new DPoP keypair on every app launch: the JWK\\n// thumbprint changes each start, so every sender-constrained access/refresh\\n// token gets rejected - a forced logout loop. Noble persists the 32-byte\\n// private scalar through `Storage`,