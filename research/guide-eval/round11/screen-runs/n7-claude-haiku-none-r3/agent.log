'content'];\n17682:/** Input to `client.getSwapQuote` - the request body minus wallet/network, which the client fills. */\n17690:type CardKycStatus = 'NOT_STARTED' | 'PENDING' | 'NEEDS_ACTION' | 'IN_REVIEW' | 'APPROVED' | 'DENIED' | 'LOCKED' | 'CANCELED';\n17721:    kycStatus: CardKycStatus;\n18019: * with `setTrustline`; null for any other rejection.\n18025:/** What a refused `setTrustline` tells the user, by the API's code; never the raw detail, which can carry an address. */\n18337:    readonly apiKey: string;\n18349:     * Accessing `apiKeyHash` before `await client.ready()` throws.\n18351:    private _apiKeyHash;\n18357:    get apiKeyHash(): string;\n18460:    private _walletBalanceState;\n18461:    private _walletBalanceStateListeners;\n18473:    private _walletBalanceGen;\n18786:     * for a new user and deploys a sponsored smart-account C-address. Use\n18871:     * `walletBalanceState`. For an arbitrary wallet, use {@link getWalletBalance}.\n18912:     * when eligible); pass `skipSponsorship` to force the user's own wallet to pay,\n18917:     *    allows. A custodial wallet is sponsored or self-paid and submitted there,\n18923:     *  - **`skipSponsorship`** -> a plain self-pay `change_trust` via {@link runTx},\n18928:    setTrustline(asset: {\n18935:         * opt-out that mirrors `skipSponsorship` on the payment / swap / contract\n18938:        skipSponsorship?: boolean;\n18945:     * platform doesn't hold: the server builds a sponsored `createAccount` (the new\n18952:     * accounts. Trustlines are a separate step: see {@link setTrustline}.\n19061:        skipSponsorship?: boolean;\n19277:     * sponsor signature when the token is sponsored. One `idempotencyKey` ties\n19321:    getKycStatus(providerId?: string, corridorId?: string, cardProviderId?: string): Promise<{\n19356:    }): Promise<KycStatusContent>;\n19357:    pollKycStatus(providerId: string, opts?: {\n19362:    }): Promise<KycStatus>;\n19446:    getSwapQuote(params: SwapQuoteParams): Promise<Sw