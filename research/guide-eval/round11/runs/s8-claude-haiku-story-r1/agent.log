{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011CgtPWURfefYgUEgVWW7tR","type":"message","role":"assistant","content":[{"type":"text","text":"Next, a test that checks the properties the fix depends on: the static block is byte-identical across athletes, days and memory writes, and each request has exactly two markers."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1133,"cache_read_input_tokens":41004,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1133},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"41794d17-ecb5-4ef3-8146-010b64f1b684","uuid":"8c064965-4849-40b4-8824-9afb2bec0b55","timestamp":"2026-11-10T01:35:23.627Z","request_id":"req_011CgtPWUG1DeMohUyxA4cbj"}
{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011CgtPWURfefYgUEgVWW7tR","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Ka8wn2y6vMaeJLQrj3XVQp","name":"Write","input":{"file_path":"/private/tmp/h-ztACyV/test_cache_split.py","content":"\"\"\"Checks the prompt-cache layout of bot.build_request without calling the API.\n\nRun: python3 -m unittest test_cache_split -v\n\"\"\"\nimport datetime as dt\nimport unittest\n\nimport bot\n\n\ndef request(athlete, today, text=\"how was my week\"):\n    tools = bot.select_tools(text)\n    return bot.build_request(athlete, [{\"role\": \"user\", \"content\": text}], tools, today)\n\n\nclass CacheLayout(unittest.TestCase):\n    def setUp(self):\n        self.day1 = dt.date(2026, 4, 18)\n        self.day2 = dt.date(2026, 4, 19)\n        self.a = bot.Athlete(user_id=\"42\", name=\"Ana\", facts=[\"Has a knee injury history\"])\n\n    def test_two_markers_on_system_and_none_elsewhere_in_marked_order(self):\n        req = request(self.a, self.day1)\n        blocks = req[\"system\"]\n        self.assertEqual(len(blocks), 2)\n        self.assertTrue(all(b[\"cache_control\"] == {\"type\": \"ephemeral\"} for b in blocks))\n        marked = sum(1 for t in req[\"tools\"] if \"cache_control\" in t)\n        self.assertEqual(marked, 0)\n\n    def test_static_block_is_identical_across_athletes_days_and_facts(self):\n        base = request(self.a, self.day1)[\"system\"][0][\"text\"]\n        other_athlete = bot.Athlete(user_id=\"77\", name=\"Ben\", sport=\"cycling\", goal=\"climb Ventoux\")\n        self.assertEqual(base, request(other_athlete, self.day2)[\"system\"][0][\"text\"])\n        self.a.facts.append(\"Trains on Tuesdays only\")\n        self.assertEqual(base, request(self.a, self.day1)[\"system\"][0][\"text\"])\n\n    def test_static_block_contains_no_volatile_values(self):\n        static = bot.build_system(self.a, self.day1)[0][\"text\"]\n        for volatile in (\"Ana\", \"42\", \"2026\", \"Knee\", \"Trains on\", \"Language:\", \"Today:\"):\n            self.assertNotIn(volatile, static)\n\n    def test_memory_write_changes_only_the_tail(self):\n        before = bot.build_system(self.a, self.day1)\n        self.a.facts.append(\"Owns a road bike\")\n        after = bot.build_system(self.a, self.day1)\n        self.assertEqual(before[0], after[0])\n        self.assertNotEqual(before[1], after[1])\n        self.assertIn(\"Owns a road bike\", after[1][\"text\"])\n\n    def test_tail_carries_profile_date_and_language(self):\n        tail = bot.build_system(self.a, self.day1)[1][\"text\"]\n        self.assertIn(\"2026-04-18\", tail)\n        self.assertIn(\"Athlete: Ana (id 42)\", tail)\n        self.assertIn(\"Language: en\", tail)\n        self.assertIn(\"- Has a knee injury history\", tail)\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1133,"cache_read_input_tokens":41004,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1133},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"41794d17-ecb5-4ef3-8146-010b64f1b684","uuid":"32b28db6-d7dd-402f-b61a-a933a21e4332","timestamp":"2026-11-10T01:35:27.467Z","request_id":"req_011CgtPWUG1DeMohUyxA4cbj","wire_tool_inputs":{"toolu_01Ka8wn2y6vMaeJLQrj3XVQp":{"file_path":"/private/tmp/h-ztACyV/test_cache_split.py","content":"\"\"\"Checks the prompt-cache layout of bot.build_request without calling the API.\n\nRun: python3 -m unittest test_cache_split -v\n\"\"\"\nimport datetime as dt\nimport unittest\n\nimport bot\n\n\ndef request(athlete, today, text=\"how was my week\"):\n    tools = bot.select_tools(text)\n    return bot.build_request(athlete, [{\"role\": \"user\", \"content\": text}], tools, today)\n\n\nclass CacheLayout(unittest.TestCase):\n    def setUp(self):\n        self.day1 = dt.date(2026, 4, 18)\n        self.day2 = dt.date(2026, 4, 19)\n        self.a = bot.Athlete(user_id=\"42\", name=\"Ana\", facts=[\"Has a knee injury history\"])\n\n    def test_two_markers_on_system_and_none_elsewhere_in_marked_order(self):\n        req = request(self.a, self.day1)\n        blocks = req[\"system\"]\n        self.assertEqual(len(blocks), 2)\n        self.assertTrue(all(b[\"cache_control\"] == {\"type\": \"ephemeral\"} for b in blocks))\n        marked = sum(1 for t in req[\"tools\"] if \"cache_control\" in t)\n        self.assertEqual(marked, 0)\n\n    def test_static_block_is_identical_across_athletes_days_and_facts(self):\n        base = request(self.a, self.day1)[\"system\"][0][\"text\"]\n        other_athlete = bot.Athlete(user_id=\"77\", name=\"Ben\", sport=\"cycling\", goal=\"climb Ventoux\")\n        self.assertEqual(base, request(other_athlete, self.day2)[\"system\"][0][\"text\"])\n        self.a.facts.append(\"Trains on Tuesdays only\")\n        self.assertEqual(base, request(self.a, self.day1)[\"system\"][0][\"text\"])\n\n    def test_static_block_contains_no_volatile_values(self):\n        static = bot.build_system(self.a, self.day1)[0][\"text\"]\n        for volatile in (\"Ana\", \"42\", \"2026\", \"Knee\", \"Trains on\", \"Language:\", \"Today:\"):\n            self.assertNotIn(volatile, static)\n\n    def test_memory_write_changes_only_the_tail(self):\n        before = bot.build_system(self.a, self.day1)\n        self.a.facts.append(\"Owns a road bike\")\n        after = bot.build_system(self.a, self.day1)\n        self.assertEqual(before[0], after[0])\n        self.assertNotEqual(before[1], after[1])\n        self.assertIn(\"Owns a road bike\", after[1][\"text\"])\n\n    def test_tail_carries_profile_date_and_language(self):\n        tail = bot.build_system(self.a, self.day1)[1][\"text\"]\n        self.assertIn(\"2026-04-18\", tail)\n        self.assertIn(\"Athlete: Ana (id 42)\", tail)\n        self.assertIn(\"Language: en\", tail)\n        self.assertIn(\"- Has a knee injury history\", tail)\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n"}}}
