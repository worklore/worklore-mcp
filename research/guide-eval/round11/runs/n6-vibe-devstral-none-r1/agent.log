{"id":"effect-c58b115a-bf02-561b-98b9-71e21f6d0aa0","sessionId":"caf2ee29-53b4-b08e-a10f-f9cfecf9cd6e","turnId":"turn-cc2ddccabc899216f7e873abaf6a3066","inputEntryId":"user-turn-cc2ddccabc899216f7e873abaf6a3066-1","createdAt":1794274476455,"updatedAt":1794274476468,"generationStatus":"completed","relatedEntryId":null,"type":"effect","title":"file_system.write_file","detail":{"toolName":"file_system.write_file","display":{"summary":"Writing src/transfer.ts","content":"import { AccountId, Hbar, PrivateKey, TransferTransaction } from \"@hashgraph/sdk\";\nimport * as dotenv from \"dotenv\";\n\ndotenv.config();\n\nconst operatorId = AccountId.fromString(process.env.OPERATOR_ID!);\nconst operatorKey = PrivateKey.fromStringDer(process.env.OPERATOR_KEY!);\nconst recipientId = AccountId.fromString(process.env.RECIPIENT_ID!);\nconst validStart = new Date(Number(process.env.VALID_START) * 1000);\n\nconst tx = new TransferTransaction();\n\n// Set node account IDs\ntx._nodeAccountIds.list.push(AccountId.fromString(\"0.0.3\"));\n\n// Set transaction ID\ntx._transactionIds.set(operatorId, {\n  transactionId: { accountId: operatorId, transactionValidStart: validStart },\n  nonces: new Map(),\n});\n\n// Set memo\ntx._transactionMemo = \"invoice 42\";\n\n// Add hbar transfers\ntx._hbarTransfers.push({ accountId: operatorId, amount: new Hbar(-1) });\ntx._hbarTransfers.push({ accountId: recipientId, amount: new Hbar(1) });\n\n// Sign the transaction\nconst signedTx = await tx.sign(operatorKey);\n\nconsole.log(signedTx.toBytes().toString(\"hex\"));\n","suffix":"","verb":"Creating","message":"src/transfer.ts","settledVerb":"Created","settledMessage":"src/transfer.ts","statusText":"Writing file"},"kind":"file_write","input":{"filePath":"src/transfer.ts","content":"import { AccountId, Hbar, PrivateKey, TransferTransaction } from \"@hashgraph/sdk\";\nimport * as dotenv from \"dotenv\";\n\ndotenv.config();\n\nconst operatorId = AccountId.fromString(process.env.OPERATOR_ID!);\nconst operatorKey = PrivateKey.fromStringDer(process.env.OPERATOR_KEY!);\nconst recipientId = AccountId.fromString(process.env.RECIPIENT_ID!);\nconst validStart = new Date(Number(process.env.VALID_START) * 1000);\n\nconst tx = new TransferTransaction();\n\n// Set node account IDs\ntx._nodeAccountIds.list.push(AccountId.fromString(\"0.0.3\"));\n\n// Set transaction ID\ntx._transactionIds.set(operatorId, {\n  transactionId: { accountId: operatorId, transactionValidStart: validStart },\n  nonces: new Map(),\n});\n\n// Set memo\ntx._transactionMemo = \"invoice 42\";\n\n// Add hbar transfers\ntx._hbarTransfers.push({ accountId: operatorId, amount: new Hbar(-1) });\ntx._hbarTransfers.push({ accountId: recipientId, amount: new Hbar(1) });\n\n// Sign the transaction\nconst signedTx = await tx.sign(operatorKey);\n\nconsole.log(signedTx.toBytes().toString(\"hex\"));\n"}},"state":{"status":"completed","outputText":"","decision":"execute","durationMs":0.0,"approvalSource":"bypass","display":{"success":true,"verb":"Updated","message":"src/transfer.ts","warnings":[],"approvalNote":null,"suffix":""},"output":{"filePath":"/private/tmp/h-SfmCA2/src/transfer.ts","content":"import { AccountId, Hbar, PrivateKey, TransferTransaction } from \"@hashgraph/sdk\";\nimport * as dotenv from \"dotenv\";\n\ndotenv.config();\n\nconst operatorId = AccountId.fromString(process.env.OPERATOR_ID!);\nconst operatorKey = PrivateKey.fromStringDer(process.env.OPERATOR_KEY!);\nconst recipientId = AccountId.fromString(process.env.RECIPIENT_ID!);\nconst validStart = new Date(Number(process.env.VALID_START) * 1000);\n\nconst tx = new TransferTransaction();\n\n// Set node account IDs\ntx._nodeAccountIds.list.push(AccountId.fromString(\"0.0.3\"));\n\n// Set transaction ID\ntx._transactionIds.set(operatorId, {\n  transactionId: { accountId: operatorId, transactionValidStart: validStart },\n  nonces: new Map(),\n});\n\n// Set memo\ntx._transactionMemo = \"invoice 42\";\n\n// Add hbar transfers\ntx._hbarTransfers.push({ accountId: operatorId, amount: new Hbar(-1) });\ntx._hbarTransfers.push({ accountId: recipientId, amount: new Hbar(1) });\n\n// Sign the transaction\nconst signedTx = await tx.sign(operatorKey);\n\nconsole.log(signedTx.toBytes().toString(\"hex\"));\n","fileExisted":true,"previousContent":"import { Client, PrivateKey, AccountId, TransferTransaction, Hbar } from \"@hashgraph/sdk\";\nimport * as dotenv from \"dotenv\";\n\ndotenv.config();\n\nconst operatorId = AccountId.fromString(process.env.OPERATOR_ID!);\nconst operatorKey = PrivateKey.fromStringDer(process.env.OPERATOR_KEY!);\nconst recipientId = AccountId.fromString(process.env.RECIPIENT_ID!);\nconst validStart = new Date(Number(process.env.VALID_START) * 1000);\n\nconst client = Client.forTestnet();\nclient.setOperator(operatorId, operatorKey);\n\nconst tx = new TransferTransaction()\n  .setNodeAccountIds([AccountId.fromString(\"0.0.3\")])\n  .setTransactionId(operatorId, validStart)\n  .addHbarTransfer(operatorId, new Hbar(-1))\n  .addHbarTransfer(recipientId, new Hbar(1))\n  .setMemo(\"invoice 42\");\n\nconst signedTx = await tx.sign(operatorKey);\n\nconsole.log(signedTx.toBytes().toString(\"hex\"));\n"},"approvalType":"always"}}
