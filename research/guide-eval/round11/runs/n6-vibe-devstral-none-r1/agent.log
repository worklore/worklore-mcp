{"id":"effect-8f13ee1b-3199-5517-ad17-88f3570d92d3","sessionId":"caf2ee29-53b4-b08e-a10f-f9cfecf9cd6e","turnId":"turn-cc2ddccabc899216f7e873abaf6a3066","inputEntryId":"user-turn-cc2ddccabc899216f7e873abaf6a3066-1","createdAt":1794274805575,"updatedAt":1794274805585,"generationStatus":"completed","relatedEntryId":null,"type":"effect","title":"file_system.write_file","detail":{"toolName":"file_system.write_file","display":{"summary":"Writing src/transfer.ts","content":"import { AccountId, Hbar, PrivateKey, Timestamp, TransactionId, TransferTransaction } from \"@hashgraph/sdk\";\nimport * as dotenv from \"dotenv\";\n\ndotenv.config();\n\nconst operatorId = AccountId.fromString(process.env.OPERATOR_ID!);\nconst operatorKey = PrivateKey.fromStringDer(process.env.OPERATOR_KEY!);\nconst recipientId = AccountId.fromString(process.env.RECIPIENT_ID!);\nconst validStart = Timestamp.fromDate(new Date(Number(process.env.VALID_START) * 1000));\n\nconst tx: TransferTransaction = new TransferTransaction()\n  .setNodeAccountIds([AccountId.fromString(\"0.0.3\")])\n  .setTransactionId(TransactionId.withValidStart(operatorId, validStart))\n  .setTransactionMemo(\"invoice 42\")\n  .addHbarTransfer(operatorId, new Hbar(-1))\n  .addHbarTransfer(recipientId, new Hbar(1));\n\ntx.freeze();\nconst signedTx = await tx.sign(operatorKey);\n\nconsole.log(signedTx.toBytes().toString(\"hex\"));\n","suffix":"","verb":"Creating","message":"src/transfer.ts","settledVerb":"Created","settledMessage":"src/transfer.ts","statusText":"Writing file"},"kind":"file_write","input":{"filePath":"src/transfer.ts","content":"import { AccountId, Hbar, PrivateKey, Timestamp, TransactionId, TransferTransaction } from \"@hashgraph/sdk\";\nimport * as dotenv from \"dotenv\";\n\ndotenv.config();\n\nconst operatorId = AccountId.fromString(process.env.OPERATOR_ID!);\nconst operatorKey = PrivateKey.fromStringDer(process.env.OPERATOR_KEY!);\nconst recipientId = AccountId.fromString(process.env.RECIPIENT_ID!);\nconst validStart = Timestamp.fromDate(new Date(Number(process.env.VALID_START) * 1000));\n\nconst tx: TransferTransaction = new TransferTransaction()\n  .setNodeAccountIds([AccountId.fromString(\"0.0.3\")])\n  .setTransactionId(TransactionId.withValidStart(operatorId, validStart))\n  .setTransactionMemo(\"invoice 42\")\n  .addHbarTransfer(operatorId, new Hbar(-1))\n  .addHbarTransfer(recipientId, new Hbar(1));\n\ntx.freeze();\nconst signedTx = await tx.sign(operatorKey);\n\nconsole.log(signedTx.toBytes().toString(\"hex\"));\n"}},"state":{"status":"completed","outputText":"","decision":"execute","durationMs":0.0,"approvalSource":"bypass","display":{"success":true,"verb":"Updated","message":"src/transfer.ts","warnings":[],"approvalNote":null,"suffix":""},"output":{"filePath":"/private/tmp/h-SfmCA2/src/transfer.ts","content":"import { AccountId, Hbar, PrivateKey, Timestamp, TransactionId, TransferTransaction } from \"@hashgraph/sdk\";\nimport * as dotenv from \"dotenv\";\n\ndotenv.config();\n\nconst operatorId = AccountId.fromString(process.env.OPERATOR_ID!);\nconst operatorKey = PrivateKey.fromStringDer(process.env.OPERATOR_KEY!);\nconst recipientId = AccountId.fromString(process.env.RECIPIENT_ID!);\nconst validStart = Timestamp.fromDate(new Date(Number(process.env.VALID_START) * 1000));\n\nconst tx: TransferTransaction = new TransferTransaction()\n  .setNodeAccountIds([AccountId.fromString(\"0.0.3\")])\n  .setTransactionId(TransactionId.withValidStart(operatorId, validStart))\n  .setTransactionMemo(\"invoice 42\")\n  .addHbarTransfer(operatorId, new Hbar(-1))\n  .addHbarTransfer(recipientId, new Hbar(1));\n\ntx.freeze();\nconst signedTx = await tx.sign(operatorKey);\n\nconsole.log(signedTx.toBytes().toString(\"hex\"));\n","fileExisted":true,"previousContent":"import { AccountId, Hbar, PrivateKey, Timestamp, TransactionId, TransferTransaction } from \"@hashgraph/sdk\";\nimport * as dotenv from \"dotenv\";\n\ndotenv.config();\n\nconst operatorId = AccountId.fromString(process.env.OPERATOR_ID!);\nconst operatorKey = PrivateKey.fromStringDer(process.env.OPERATOR_KEY!);\nconst recipientId = AccountId.fromString(process.env.RECIPIENT_ID!);\nconst validStart = Timestamp.fromDate(new Date(Number(process.env.VALID_START) * 1000));\n\nconst tx = new TransferTransaction()\n  .setNodeAccountIds([AccountId.fromString(\"0.0.3\")])\n  .setTransactionId(TransactionId.withValidStart(operatorId, validStart))\n  .setTransactionMemo(\"invoice 42\")\n  .addHbarTransfer(operatorId, new Hbar(-1))\n  .addHbarTransfer(recipientId, new Hbar(1));\n\ntx.freeze();\nconst signedTx = await (tx as any).sign(operatorKey);\n\nconsole.log(signedTx.toBytes().toString(\"hex\"));\n"},"approvalType":"always"}}
