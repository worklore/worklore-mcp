 #!/usr/bin/env bash
 # usage: run.sh <task> <lane> [rep]
-# lanes: codex   Codex CLI, unsandboxed
-#        kimi    Kimi Code under sandbox/agent.sb (no reading or writing the real home), scratch HOME
+# lanes: codex          Codex CLI, unsandboxed
+#        codex-sandbox  the same Codex run under sandbox/agent.sb (no reading or writing the real home),
+#                       scratch HOME and scratch CODEX_HOME holding only a copy of the login token
+#        kimi           Kimi Code under sandbox/agent.sb (no reading or writing the real home), scratch HOME
 set -u
 D="$(cd "$(dirname "$0")" && pwd)"
 T=$1; A=$2; REP=${3:-1}
@@ -15,6 +17,19 @@ codex_run() {
       -o "$R/final.txt" "$P" < /dev/null > "$R/agent.log" 2> "$R/agent.err" )
 }
 
+# Same Codex command as codex_run, but the whole process tree (codex and its shell) runs under sandbox/agent.sb
+# with an empty scratch HOME. Codex's state dir is a scratch CODEX_HOME; the only thing copied in from the real
+# ~/.codex is auth.json (the login token), because without it codex cannot reach the model. The token is therefore
+# readable by the agent's shell, and the network is open, so it is not secret from the agent.
+codex_sandbox_run() {
+  local REAL="$HOME" SH CH; SH=$(mktemp -d /tmp/khome-XXXXXX); CH=$(mktemp -d /tmp/codex-home-XXXXXX)
+  install -m 600 "$REAL/.codex/auth.json" "$CH/auth.json" || { rm -rf "$SH" "$CH"; return 1; }
+  ( cd "$W" && export HOME="$SH" CODEX_HOME="$CH" && sandbox-exec -D HOME="$REAL" -f "$D/sandbox/agent.sb" \
+      timeout $TO codex exec --skip-git-repo-check --dangerously-bypass-approvals-and-sandbox -C "$W" --json \
+      -o "$R/final.txt" "$P" < /dev/null > "$R/agent.log" 2> "$R/agent.err" )
+  local rc=$?; rm -rf "$SH" "$CH"; return $rc
+}
+
 # Kimi's output goes to Moonshot: its shell runs under sandbox/agent.sb with an empty scratch HOME.
 kimi_run() {
   local REAL="$HOME" SH; SH=$(mktemp -d /tmp/khome-XXXXXX)
@@ -27,6 +42,7 @@ kimi_run() {
 start=$(date +%s)
 case $A in
   codex) codex_run;;
+  codex-sandbox) codex_sandbox_run;;
   kimi)  kimi_run;;
   *) echo "unknown lane $A"; exit 2;;
 esac
