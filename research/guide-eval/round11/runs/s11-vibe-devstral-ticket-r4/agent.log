\n\nif __name__ == \"__main__\":\n    unittest.main()\n","numLines":28,"startLine":1,"requestedOffset":null,"requestedLimit":2000,"totalLines":null,"wasTruncated":false}}}
{"id":"effect-67d9c053-4f44-579a-8067-e932c808d4f9","sessionId":"70fa3160-86f7-e100-7699-f3146aa18047","turnId":"turn-ad2d2f1657a1f1f7d8b4bc2d04214766","inputEntryId":"user-turn-ad2d2f1657a1f1f7d8b4bc2d04214766-1","createdAt":1794282725566,"updatedAt":1794282725572,"generationStatus":"completed","relatedEntryId":null,"type":"effect","title":"file_system.read_file","detail":{"toolName":"file_system.read_file","display":{"summary":"Reading tests/fake_dynamo.py","content":null,"suffix":"","verb":"Reading","message":"tests/fake_dynamo.py","settledVerb":"Read","settledMessage":"tests/fake_dynamo.py","statusText":"Reading file"},"kind":"file_read","input":{"filePath":"tests/fake_dynamo.py","offset":null,"limit":2000}},"state":{"status":"completed","outputText":"","display":{"success":true,"verb":"Read","message":"42 lines from tests/fake_dynamo.py","warnings":[],"approvalNote":null,"suffix":""},"approvalSource":"bypass","decision":"execute","durationMs":0.0,"approvalType":"always","output":{"filePath":"/private/tmp/h-XJUKci/tests/fake_dynamo.py","content":"\"\"\"In-memory stand-in for a boto3 DynamoDB Table resource.\n\nIt stores items in a dict and validates values the way boto3's TypeSerializer\ndoes, so a test fails on the same inputs a real table would reject.\n\"\"\"\nfrom decimal import Decimal\n\n\ndef _check(value, path=\"Item\"):\n    if isinstance(value, bool) or value is None or isinstance(value, (int, str, bytes, Decimal)):\n        return\n    if isinstance(value, float):\n        raise TypeError(\"Float types are not supported. Use Decimal types instead.\")\n    if isinstance(value, dict):\n        for k, v in value.items():\n            _check(v, f\"{path}.{k}\")\n        return\n    if isinstance(value, (list, tuple, set, frozenset)):\n        for i, v in enumerate(value):\n            _check(v, f\"{path}[{i}]\")\n        return\n    raise TypeError(f\"Unsupported type {type(value)!r} for value at {path}\")\n\n\nclass FakeTable:\n    def __init__(self, key=\"slug\"):\n        self.key = key\n        self.items = {}\n\n    def put_item(self, Item, **kwargs):\n        _check(Item)\n        if self.key not in Item:\n            raise ValueError(f\"item is missing the key attribute {self.key!r}\")\n        self.items[Item[self.key]] = dict(Item)\n        return {\"ResponseMetadata\": {\"HTTPStatusCode\": 200}}\n\n    def get_item(self, Key, **kwargs):\n        item = self.items.get(Key[self.key])\n        return {\"Item\": dict(item)} if item is not None else {}\n\n    def scan(self, **kwargs):\n        return {\"Items\": [dict(v) for v in self.items.values()], \"Count\": len(self.items)}\n","numLines":42,"startLine":1,"requestedOffset":null,"requestedLimit":2000,"totalLines":null,"wasTruncated":false}}}
