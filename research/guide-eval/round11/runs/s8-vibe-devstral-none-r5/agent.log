eation_input_tokens\": 1334, \"cache_read_input_tokens\": 0, \"output_tokens\": 161}\n{\"ts\": \"2026-04-18T08:04:26+00:00\", \"user\": \"42\", \"round\": 1, \"input_tokens\": 23, \"cache_creation_input_tokens\": 0, \"cache_read_input_tokens\": 1090, \"output_tokens\": 79}\n{\"ts\": \"2026-04-18T08:04:56+00:00\", \"user\": \"42\", \"round\": 1, \"input_tokens\": 61, \"cache_creation_input_tokens\": 0, \"cache_read_input_tokens\": 1090, \"output_tokens\": 41, \"tool\": \"save_fact\"}\n{\"ts\": \"2026-04-18T08:05:39+00:00\", \"user\": \"42\", \"round\": 2, \"input_tokens\": 139, \"cache_creation_input_tokens\": 1104, \"cache_read_input_tokens\": 0, \"output_tokens\": 155}\n{\"ts\": \"2026-04-18T08:05:54+00:00\", \"user\": \"42\", \"round\": 1, \"input_tokens\": 26, \"cache_creation_input_tokens\": 0, \"cache_read_input_tokens\": 1104, \"output_tokens\": 93}\n","numLines":30,"startLine":1,"requestedOffset":null,"requestedLimit":2000,"totalLines":null,"wasTruncated":false},"display":{"success":true,"verb":"Read","message":"30 lines from logs/usage.jsonl","warnings":[],"approvalNote":null,"suffix":""},"decision":"execute"}}
{"id":"assistant-277b7ae1-6a76-50b8-8d37-5b01e86fe5ec","sessionId":"31e0a13f-33ae-d5ff-5a35-296c14ef1dec","turnId":"turn-2571d696126a52b8b736c18455fd86f5","inputEntryId":"user-turn-2571d696126a52b8b736c18455fd86f5-1","createdAt":1794285301301,"updatedAt":1794285301301,"generationStatus":"completed","relatedEntryId":null,"type":"message","role":"assistant","content":[{"type":"text","text":"Now I understand the issue. Looking at the usage logs, I can see that:\n\n1. When `save_fact` is called, it modifies the athlete's facts list and saves it\n2. The system prompt is rebuilt on every request via `build_system(a, today)` which includes `athlete_context(a, today)` \n3. The `athlete_context` function includes the athlete's facts: `lines += [f\"- {f}\" for f in a.facts]`\n4. When facts change, the entire system prompt changes, causing cache misses\n\nThe problem is that the system prompt includes the dynamic `athlete_context` which changes when facts are saved. The caching mechanism (via `cache_control: {\"type\": \"ephemeral\"}`) treats the entire system block as ephemeral, but when the content changes (due to new facts), the cache key changes and the full system prompt needs to be reprocessed.\n\nThe fix is to separate the static instructions from the dynamic athlete context in the system prompt, so that:\n- The static `INSTRUCTIONS` can be cached with a stable cache key\n- The dynamic `athlete_context` is passed separately (e.g., as a user message or in a separate system block with ephemeral caching)\n\nLet me check the Anthropic API documentation pattern for this. The typical approach is to use separate system messages or to use the `cache_control` more granularly. However, looking at the code, the system is passed as a single block.\n\nThe solution is to split the system prompt into two parts:\n1. Static instructions (cached with a long-lived cache key)\n2. Dynamic athlete context (cached as ephemeral)\n\nLet me implement this fix:"}],"source":"harness","userDisplayContent":null,"outcome":{"type":"committed"}}
{"id":"effect-a2f9c152-ed55-551d-bc92-77f4afaa8bab","sessionId":"31e0a13f-33ae-d5ff-5a35-296c14ef1dec","turnId":"turn-2571d696126a52b8b736c18455fd86f5","inputEntryId":"user-turn-2571d696126a52b8b736c18455fd86f5-1","createdAt":1794285301305,"updatedAt":1794285301316,"generationStatus":"completed","relatedEntryId":null,"type":"effect","title":"file_system.edit","detail":{"toolName":"file_system.edit","display":{"summary":"Editing bot.py","content":null,"suffix":"","verb":"Editing","message":"bot.py","settledVerb":"Edited","settledMessage":"bot.py","statusText":"Editing file"},"kind":"file_edit","input":{"filePath":"bot.py","oldString":"def build_system(a, today):\n    # One block, cached as a whole: instructions + per-athlete context.\n    text = INSTRUCTIONS + \"\\n\\n\" + athlete_context(a, today)\n    return [{\"type\": \"text\", \"text\": text, \"cache_control\": {\"type\": \"ephemeral\"}}]","newString":"def build_system(a, today):\n    # Split into static instructions (long-lived cache) and dynamic athlete context (ephemeral).\n    # This prevents memory writes (save_fact) from evicting the static instructions from cache.\n    return [\n        {\"type\": \"text\", \"text\": INSTRUCTIONS, \"cache_control\": {\"type\": \"ephemeral\"}},\n        {\"type\": \"text\", \"text\": athlete_context(a, today), \"cache_control\": {\"type\": \"ephemeral\"}},\n    ]","replaceAll":false}},"state":{"status":"completed","outputText":"","approvalType":"always","durationMs":0.0,"approvalSource":"bypass","output":{"file":"/private/tmp/h-tVNOAA/bot.py","oldString":null,"newString":null,"occurrences":[{"startLine":130,"newStartLine":130,"oldText":"def build_system(a, today):\n    # One block, cached as a whole: instructions + per-athlete context.\n    text = INSTRUCTIONS + \"\\n\\n\" + athlete_context(a, today)\n    return [{\"type\": \"text\", \"text\": text, \"cache_control\": {\"type\": \"ephemeral\"}}]","newText":"def build_system(a, today):\n    # Split into static instructions (long-lived cache) and dynamic athlete context (ephemeral).\n    # This prevents memory writes (save_fact) from evicting the static instructions from cache.\n    return [\n        {\"type\": \"text\", \"text\": INSTRUCTIONS, \"cache_control\": {\"type\": \"ephemeral\"}},\n        {\"type\": \"text\", \"text\": athlete_context(a, today), \"cache_control\": {\"type\": \"ephemeral\"}},\n    ]"}],"previousContent":"\"\"\"Coach bot: a stateless endurance-coaching chat on Claude.\n\nEvery incoming message is a fresh request: we rebuild the system prompt from\nthe athlete record, pick the tools the message might need, and run a short\ntool-use loop. Nothing is kept between messages except what is written to\ndata/athletes.json (the athlete's profile and long-term facts).\n\"\"\"\nimport json\nimport os\nimport sys\nimport datetime as dt\nfrom dataclasses import dataclass, field, asdict\n\nMODEL = \"claude-sonnet-4-5\"\nMAX_TOKENS = 700\nMAX_TOOL_ROUNDS = 5\nATHLETES_FILE = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"data\", \"athletes.json\")\nUSAGE_LOG = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"logs\", \"usage.jsonl\")\n\n# --------------------------------------------------------------------------- LLM\ntry:\n    import anthropic\n\n    class LLM:\n        \"\"\"Thin wrapper so the rest of the file reads the same with or without the SDK.\"\"\"\n        def __init__(self):\n            self._client = anthropic.Anthropic(api_key=os.environ[\"COACH_ANTHROPIC_KEY\"])\n\n        def create(self, **kw):\n            return self._client.messages.create(**kw)\nexcept ImportError:  # the code is readable and importable without the SDK\n    class LLM:\n        def __init__(self):\n            raise RuntimeError(\"anthropic SDK not installed: pip install anthropic\")\n\n        def create(self, **kw):\n            raise RuntimeError(\"anthropic SDK not installed\")\n\n# --------------------------------------------------------------------------- athlete record\n@dataclass\nclass Athlete:\n    user_id: str\n    name: str\n    lang: str = \"en\"\n    sport: str = \"running\"\n    goal: str = \"finish a half marathon\"\n    zones: dict = field(default_factory=lambda: {\"Z1\": \"<135\", \"Z2\": \"135-150\", \"Z3\": \"150-162\", \"Z4\": \"162-172\", \"Z5\": \">172\"})\n    facts: list = field(default_factory=list)   # long-term memory, grows via save_fact\n\n\ndef _load_all():\n    try:\n        with open(ATHLETES_FILE) as f:\n            return json.load(f)\n    except FileNotFoundError:\n        return {}\n\n\ndef load_athlete(user_id):\n    raw = _load_all().get(str(user_id))\n    if raw is None:\n        return Athlete(user_id=str(user_id), name=\"athlete\")\n    return Athlete(**raw)\n\n\ndef save_athlete(a):\n    allrec = _load_all()\n    allrec[a.user_id] = asdict(a)\n    os.makedirs(os.path.dirname(ATHLETES_FILE), exist_ok=True)\n    with open(ATHLETES_FILE, \"w\") as f:\n        json.dump(allrec, f, indent=1, ensure_ascii=False)\n\n# --------------------------------------------------------------------------- system prompt\nINSTRUCTIONS = \"\"\"You are Pace, an endurance coach for recreational runners and cyclists.\n\nCoaching rules:\n1. Answer the question that was asked before adding anything else.\n2. Keep replies short: a chat message, not an article. Three paragraphs at most.\n3. Prescribe training by heart-rate zone or RPE, never by pace, unless the athlete asks for pace.\n4. Use the athlete's own zones from the profile below; never invent zone boundaries.\n5. Easy days are easy: anything labelled recovery or Z1/Z2 must stay there.\n6. Never add more than 10% weekly volume over the previous week.\n7. One hard session per week for beginners, two for athletes with 3+ years of training.\n8. A rest day is a session. Do not fill it.\n9. If the athlete reports pain (not soreness) lasting more than two days, stop the plan and say to see a physio.\n10. Do not diagnose injuries or illness. Do not give medication advice.\n11. Fuelling: 30-60 g carbs per hour for sessions over 75 minutes; mention it only when relevant.\n12. Sleep and stress count as training load. Ask about them when the athlete looks flat.\n13. Before a goal race, the last hard session is 7-10 days out. Taper means less volume, same intensity.\n14. Do not change the athlete's goal unless they ask. Mention the goal when a question is clearly off-plan.\n15. When the athlete tells you something durable about themselves (injury history, schedule, preferences,\n    equipment, races booked), call save_fact once with a single sentence. Do not save moods or one-off plans.\n16. Do not save a fact that is already in the list below.\n17. Use the plan_week tool for any weekly structure; do not write a week by hand.\n18. Use log_session when the athlete reports a completed workout, then comment on it.\n19. If asked for numbers you do not have (recent volume, last race), ask one question, do not guess.\n20. Metric units unless the profile says otherwise.\n\nTone:\n- Warm, direct, no exclamation marks.\n- No motivational quotes.\n- Address the athlete by first name at most once per reply.\n- Reply in the athlete's language from the profile below, even if they write in another language.\n\nSafety:\n- Never advise training through chest pain, dizziness or fever.\n- Minors: refer to a coach in person.\n- If someone asks for weight-loss plans below 1500 kcal per day, decline and suggest a dietitian.\n\nFormatting:\n- Plain text. No markdown headings, no tables.\n- Lists only for a session structure (warm-up / main / cool-down).\n- Numbers with units: 45 min, 12 km, 150 bpm.\n\"\"\"\n\n\ndef athlete_context(a, today):\n    lines = [\n        f\"Today: {today.isoformat()} ({today.strftime('%A')})\",\n        f\"Athlete: {a.name} (id {a.user_id}), sport: {a.sport}\",\n        \"Zones: \" + \", \".join(f\"{k} {v}\" for k, v in a.zones.items()),\n        f\"Goal: {a.goal}\",\n        \"Long-term facts:\",\n    ]\n    lines += [f\"- {f}\" for f in a.facts] or [\"- (none yet)\"]\n    lines.append(f\"Language: {a.lang}\")\n    return \"\\n\".join(lines)\n\n\ndef build_system(a, today):\n    # One block, cached as a whole: instructions + per-athlete context.\n    text = INSTRUCTIONS + \"\\n\\n\" + athlete_context(a, today)\n    return [{\"type\": \"text\", \"text\": text, \"cache_control\": {\"type\": \"ephemeral\"}}]\n\n# --------------------------------------------------------------------------- tools\nCORE_TOOLS = [\n    {\"name\": \"save_fact\", \"description\": \"Remember one durable fact about the athlete.\",\n     \"input_schema\": {\"type\": \"object\", \"properties\": {\"fact\": {\"type\": \"string\"}}, \"required\": [\"fact\"]}},\n    {\"name\": \"log_session\", \"description\": \"Record a completed workout.\",\n     \"input_schema\": {\"type\": \"object\", \"properties\": {\"minutes\": {\"type\": \"integer\"}, \"rpe\": {\"type\": \"integer\"},\n                                                       \"note\": {\"type\": \"string\"}}, \"required\": [\"minutes\"]}},\n]\nTOOL_GROUPS = {\n    \"plan\": ((\"plan\", \"week\", \"schedule\", \"taper\", \"build\"), [\n        {\"name\": \"plan_week\", \"description\": \"Draft a week of sessions.\",\n         \"input_schema\": {\"type\": \"object\", \"properties\": {\"hours\": {\"type\": \"number\"}, \"hard_days\": {\"type\": \"integer\"}},\n                          \"required\": [\"hours\"]}}]),\n    \"race\": ((\"race\", \"pace\", \"predict\", \"finish time\"), [\n        {\"name\": \"predict_race\", \"description\": \"Estimate a finish time from a recent effort.\",\n         \"input_schema\": {\"type\": \"object\", \"properties\": {\"distance_km\": {\"type\": \"number\"}, \"recent_minutes\": {\"type\": \"number\"}},\n                          \"required\": [\"distance_km\"]}}]),\n}\n\n\ndef select_tools(text):\n    \"\"\"Core tools always; a group is added only when the message mentions its keywords.\"\"\"\n    tools = list(CORE_TOOLS)\n    low = text.lower()\n    for _, (keys, group) in TOOL_GROUPS.items():\n        if any(k in low for k in keys):\n            tools += group\n    return tools\n\n\ndef run_tool(a, name, args):\n    if name == \"save_fact\":\n        a.facts.append(args[\"fact\"].strip())\n        save_athlete(a)\n        return \"saved\"\n    if name == \"log_session\":\n        return f\"logged {args.get('minutes')} min\"\n    if name == \"plan_week\":\n        return json.dumps({\"hours\": args[\"hours\"], \"hard_days\": args.get(\"hard_days\", 1), \"sessions\": [\"Mon rest\", \"Tue Z2 45 min\", \"...\"]})\n    if name == \"predict_race\":\n        return json.dumps({\"distance_km\": args[\"distance_km\"], \"estimate_min\": round(args.get(\"recent_minutes\", 50) * 2.1)})\n    return f\"unknown tool {name}\"\n\n# --------------------------------------------------------------------------- the per-message loop\ndef log_usage(usage, user_id, round_no, tool=None):\n    rec = {\"ts\": dt.datetime.now(dt.timezone.utc).isoformat(timespec=\"seconds\"), \"user\": user_id, \"round\": round_no,\n           \"input_tokens\": usage.input_tokens, \"cache_creation_input_tokens\": usage.cache_creation_input_tokens,\n           \"cache_read_input_tokens\": usage.cache_read_input_tokens, \"output_tokens\": usage.output_tokens}\n    if tool:\n        rec[\"tool\"] = tool\n    os.makedirs(os.path.dirname(USAGE_LOG), exist_ok=True)\n    with open(USAGE_LOG, \"a\") as f:\n        f.write(json.dumps(rec) + \"\\n\")\n\n\ndef build_request(a, messages, tools, today):\n    return {\"model\": MODEL, \"max_tokens\": MAX_TOKENS, \"system\": build_system(a, today), \"tools\": tools, \"messages\": messages}\n\n\ndef reply(user_id, text, llm=None):\n    llm = llm or LLM()\n    a = load_athlete(user_id)\n    today = dt.date.today()\n    tools = select_tools(text)\n    messages = [{\"role\": \"user\", \"content\": text}]\n    for round_no in range(1, MAX_TOOL_ROUNDS + 1):\n        resp = llm.create(**build_request(a, messages, tools, today))\n        used_tools = [b.name for b in resp.content if b.type == \"tool_use\"]\n        log_usage(resp.usage, a.user_id, round_no, tool=\",\".join(used_tools) or None)\n        if resp.stop_reason != \"tool_use\":\n            return \"\".join(b.text for b in resp.content if b.type == \"text\")\n        messages.append({\"role\": \"assistant\", \"content\": [b.model_dump() for b in resp.content]})\n        results = [{\"type\": \"tool_result\", \"tool_use_id\": b.id, \"content\": run_tool(a, b.name, b.input)}\n                   for b in resp.content if b.type == \"tool_use\"]\n        messages.append({\"role\": \"user\", \"content\": results})\n    return \"Sorry, I lost the thread. Ask me again?\"\n\n\nif __name__ == \"__main__\":\n    # Local chat: python3 bot.py <user_id>; Telegram long-polling lives in telegram.py (not in this repo).\n    uid = sys.argv[1] if len(sys.argv) > 1 else \"42\"\n    for line in sys.stdin:\n        print(reply(uid, line.strip()))\n"},"display":{"success":true,"verb":"Edited","message":"bot.py","warnings":[],"approvalNote":null,"suffix":""},"decision":"execute"}}
{"id":"assistant-146a4418-963c-5593-9e94-e52fad15d4b8","sessionId":"31e0a13f-33ae-d5ff-5a35-296c14ef1dec","turnId":"turn-2571d696126a52b8b736c18455fd86f5","inputEntryId":"user-turn-2571d696126a52b8b736c18455fd86f5-1","createdAt":1794285305038,"updatedAt":1794285305038,"generationStatus":"completed","relatedEntryId":null,"type":"message","role":"assistant","content":[{"type":"text","text":"Wait, that's not quite right. The issue is that both blocks still have `ephemeral` cache control. The static instructions should have a stable cache key. Let me reconsider.\n\nLooking at the Anthropic API, the `cache_control` can be set to control caching behavior. The problem is that when we concatenate INSTRUCTIONS + athlete_context, the entire thing changes when athlete_context changes.\n\nThe better approach is to pass the static instructions as one system message with a stable cache key, and the dynamic context as a separate system message with ephemeral caching. But actually, looking at the API more carefully, we need to think about how the cache key is computed.\n\nActually, the real issue is simpler: we're passing the entire system prompt as a single block. When the athlete context changes (due to save_fact), the entire system prompt changes, causing a cache miss for the static instructions.\n\nThe solution is to separate them into two system messages:\n1. Static INSTRUCTIONS - can be cached with a stable key\n2. Dynamic athlete_context - ephemeral, changes with each request\n\nLet me fix this properly:"}],"source":"harness","userDisplayContent":null,"outcome":{"type":"committed"}}
{"id":"effect-3eba82e2-02c9-5900-a1f5-3d3ebac46032","sessionId":"31e0a13f-33ae-d5ff-5a35-296c14ef1dec","turnId":"turn-2571d696126a52b8b736c18455fd86f5","inputEntryId":"user-turn-2571d696126a52b8b736c18455fd86f5-1","createdAt":1794285305045,"updatedAt":1794285305054,"generationStatus":"completed","relatedEntryId":null,"type":"effect","title":"file_system.edit","detail":{"toolName":"file_system.edit","display":{"summary":"Editing bot.py","content":null,"suffix":"","verb":"Editing","message":"bot.py","settledVerb":"Edited","settledMessage":"bot.py","statusText":"Editing file"},"kind":"file_edit","input":{"filePath":"bot.py","oldString":"def build_system(a, today):\n    # Split into static instructions (long-lived cache) and dynamic athlete context (ephemeral).\n    # This prevents memory writes (save_fact) from evicting the static instructions from cache.\n    return [\n        {\"type\": \"text\", \"text\": INSTRUCTIONS, \"cache_control\": {\"type\": \"ephemeral\"}},\n        {\"type\": \"text\", \"text\": athlete_context(a, today), \"cache_control\": {\"type\": \"ephemeral\"}},\n    ]","newString":"def build_system(a, today):\n    # Split into static instructions (long-lived cache) and dynamic athlete context (ephemeral).\n    # This prevents memory writes (save_fact) from evicting the static instructions from cache.\n    return [\n        {\"type\": \"text\", \"text\": INSTRUCTIONS},\n        {\"type\": \"text\", \"text\": athlete_context(a, today), \"cache_control\": {\"type\": \"ephemeral\"}},\n    ]","replaceAll":false}},"state":{"status":"completed","outputText":"","approvalType":"always","durationMs":0.0,"approvalSource":"bypass","output":{"file":"/private/tmp/h-tVNOAA/bot.py","oldString":null,"newString":null,"occurrences":[{"startLine":130,"newStartLine":130,"oldText":"def build_system(a, today):\n    # Split into static instructions (long-lived cache) and dynamic athlete context (ephemeral).\n    # This prevents memory writes (save_fact) from evicting the static instructions from cache.\n    return [\n        {\"type\": \"text\", \"text\": INSTRUCTIONS, \"cache_control\": {\"type\": \"ephemeral\"}},\n        {\"type\": \"text\", \"text\": athlete_context(a, today), \"cache_control\": {\"type\": \"ephemeral\"}},\n    ]","newText":"def build_system(a, today):\n    # Split into static instructions (long-lived cache) and dynamic athlete context (ephemeral).\n    # This prevents memory writes (save_fact) from evicting the static instructions from cache.\n    return [\n        {\"type\": \"text\", \"text\": INSTRUCTIONS},\n        {\"type\": \"text\", \"text\": athlete_context(a, today), \"cache_control\": {\"type\": \"ephemeral\"}},\n    ]"}],"previousContent":"\"\"\"Coach bot: a stateless endurance-coaching chat on Claude.\n\nEvery incoming message is a fresh request: we rebuild the system prompt from\nthe athlete record, pick the tools the message might need, and run a short\ntool-use loop. Nothing is kept between messages except what is written to\ndata/athletes.json (the athlete's profile and long-term facts).\n\"\"\"\nimport json\nimport os\nimport sys\nimport datetime as dt\nfrom dataclasses import dataclass, field, asdict\n\nMODEL = \"claude-sonnet-4-5\"\nMAX_TOKENS = 700\nMAX_TOOL_ROUNDS = 5\nATHLETES_FILE = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"data\", \"athletes.json\")\nUSAGE_LOG = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"logs\", \"usage.jsonl\")\n\n# --------------------------------------------------------------------------- LLM\ntry:\n    import anthropic\n\n    class LLM:\n        \"\"\"Thin wrapper so the rest of the file reads the same with or without the SDK.\"\"\"\n        def __init__(self):\n            self._client = anthropic.Anthropic(api_key=os.environ[\"COACH_ANTHROPIC_KEY\"])\n\n        def create(self, **kw):\n            return self._client.messages.create(**kw)\nexcept ImportError:  # the code is readable and importable without the SDK\n    class LLM:\n        def __init__(self):\n            raise RuntimeError(\"anthropic SDK not installed: pip install anthropic\")\n\n        def create(self, **kw):\n            raise RuntimeError(\"anthropic SDK not installed\")\n\n# --------------------------------------------------------------------------- athlete record\n@dataclass\nclass Athlete:\n    user_id: str\n    name: str\n    lang: str = \"en\"\n    sport: str = \"running\"\n    goal: str = \"finish a half marathon\"\n    zones: dict = field(default_factory=lambda: {\"Z1\": \"<135\", \"Z2\": \"135-150\", \"Z3\": \"150-162\", \"Z4\": \"162-172\", \"Z5\": \">172\"})\n    facts: list = field(default_factory=list)   # long-term memory, grows via save_fact\n\n\ndef _load_all():\n    try:\n        with open(ATHLETES_FILE) as f:\n            return json.load(f)\n    except FileNotFoundError:\n        return {}\n\n\ndef load_athlete(user_id):\n    raw = _load_all().get(str(user_id))\n    if raw is None:\n        return Athlete(user_id=str(user_id), name=\"athlete\")\n    return Athlete(**raw)\n\n\ndef save_athlete(a):\n    allrec = _load_all()\n    allrec[a.user_id] = asdict(a)\n    os.makedirs(os.path.dirname(ATHLETES_FILE), exist_ok=True)\n    with open(ATHLETES_FILE, \"w\") as f:\n        json.dump(allrec, f, indent=1, ensure_ascii=False)\n\n# --------------------------------------------------------------------------- system prompt\nINSTRUCTIONS = \"\"\"You are Pace, an endurance coach for recreational runners and cyclists.\n\nCoaching rules:\n1. Answer the question that was asked before adding anything else.\n2. Keep replies short: a chat message, not an article. Three paragraphs at most.\n3. Prescribe training by heart-rate zone or RPE, never by pace, unless the athlete asks for pace.\n4. Use the athlete's own zones from the profile below; never invent zone boundaries.\n5. Easy days are easy: anything labelled recovery or Z1/Z2 must stay there.\n6. Never add more than 10% weekly volume over the previous week.\n7. One hard session per week for beginners, two for athletes with 3+ years of training.\n8. A rest day is a session. Do not fill it.\n9. If the athlete reports pain (not soreness) lasting more than two days, stop the plan and say to see a physio.\n10. Do not diagnose injuries or illness. Do not give medication advice.\n11. Fuelling: 30-60 g carbs per hour for sessions over 75 minutes; mention it only when relevant.\n12. Sleep and stress count as training load. Ask about them when the athlete looks flat.\n13. Before a goal race, the last hard session is 7-10 days out. Taper means less volume, same intensity.\n14. Do not change the athlete's goal unless they ask. Mention the goal when a question is clearly off-plan.\n15. When the athlete tells you something durable about themselves (injury history, schedule, preferences,\n    equipment, races booked), call save_fact once with a single sentence. Do not save moods or one-off plans.\n16. Do not save a fact that is already in the list below.\n17. Use the plan_week tool for any weekly structure; do not write a week by hand.\n18. Use log_session when the athlete reports a completed workout, then comment on it.\n19. If asked for numbers you do not have (recent volume, last race), ask one question, do not guess.\n20. Metric units unless the profile says otherwise.\n\nTone:\n- Warm, direct, no exclamation marks.\n- No motivational quotes.\n- Address the athlete by first name at most once per reply.\n- Reply in the athlete's language from the profile below, even if they write in another language.\n\nSafety:\n- Never advise training through chest pain, dizziness or fever.\n- Minors: refer to a coach in person.\n- If someone asks for weight-loss plans below 1500 kcal per day, decline and suggest a dietitian.\n\nFormatting:\n- Plain text. No markdown headings, no tables.\n- Lists only for a session structure (warm-up / main / cool-down).\n- Numbers with units: 45 min, 12 km, 150 bpm.\n\"\"\"\n\n\ndef athlete_context(a, today):\n    lines = [\n        f\"Today: {today.isoformat()} ({today.strftime('%A')})\",\n        f\"Athlete: {a.name} (id {a.user_id}), sport: {a.sport}\",\n        \"Zones: \" + \", \".join(f\"{k} {v}\" for k, v in a.zones.items()),\n        f\"Goal: {a.goal}\",\n        \"Long-term facts:\",\n    ]\n    lines += [f\"- {f}\" for f in a.facts] or [\"- (none yet)\"]\n    lines.append(f\"Language: {a.lang}\")\n    return \"\\n\".join(lines)\n\n\ndef build_system(a, today):\n    # Split into static instructions (long-lived cache) and dynamic athlete context (ephemeral).\n    # This prevents memory writes (save_fact) from evicting the static instructions from cache.\n    return [\n        {\"type\": \"text\", \"text\": INSTRUCTIONS, \"cache_control\": {\"type\": \"ephemeral\"}},\n        {\"type\": \"text\", \"text\": athlete_context(a, today), \"cache_control\": {\"type\": \"ephemeral\"}},\n    ]\n\n# --------------------------------------------------------------------------- tools\nCORE_TOOLS = [\n    {\"name\": \"save_fact\", \"description\": \"Remember one durable fact about the athlete.\",\n     \"input_schema\": {\"type\": \"object\", \"properties\": {\"fact\": {\"type\": \"string\"}}, \"required\": [\"fact\"]}},\n    {\"name\": \"log_session\", \"description\": \"Record a completed workout.\",\n     \"input_schema\": {\"type\": \"object\", \"properties\": {\"minutes\": {\"type\": \"integer\"}, \"rpe\": {\"type\": \"integer\"},\n                                                       \"note\": {\"type\": \"string\"}}, \"required\": [\"minutes\"]}},\n]\nTOOL_GROUPS = {\n    \"plan\": ((\"plan\", \"week\", \"schedule\", \"taper\", \"build\"), [\n        {\"name\": \"plan_week\", \"description\": \"Draft a week of sessions.\",\n         \"input_schema\": {\"type\": \"object\", \"properties\": {\"hours\": {\"type\": \"number\"}, \"hard_days\": {\"type\": \"integer\"}},\n                          \"required\": [\"hours\"]}}]),\n    \"race\": ((\"race\", \"pace\", \"predict\", \"finish time\"), [\n        {\"name\": \"predict_race\", \"description\": \"Estimate a finish time from a recent effort.\",\n         \"input_schema\": {\"type\": \"object\", \"properties\": {\"distance_km\": {\"type\": \"number\"}, \"recent_minutes\": {\"type\": \"number\"}},\n                          \"required\": [\"distance_km\"]}}]),\n}\n\n\ndef select_tools(text):\n    \"\"\"Core tools always; a group is added only when the message mentions its keywords.\"\"\"\n    tools = list(CORE_TOOLS)\n    low = text.lower()\n    for _, (keys, group) in TOOL_GROUPS.items():\n        if any(k in low for k in keys):\n            tools += group\n    return tools\n\n\ndef run_tool(a, name, args):\n    if name == \"save_fact\":\n        a.facts.append(args[\"fact\"].strip())\n        save_athlete(a)\n        return \"saved\"\n    if name == \"log_session\":\n        return f\"logged {args.get('minutes')} min\"\n    if name == \"plan_week\":\n        return json.dumps({\"hours\": args[\"hours\"], \"hard_days\": args.get(\"hard_days\", 1), \"sessions\": [\"Mon rest\", \"Tue Z2 45 min\", \"...\"]})\n    if name == \"predict_race\":\n        return json.dumps({\"distance_km\": args[\"distance_km\"], \"estimate_min\": round(args.get(\"recent_minutes\", 50) * 2.1)})\n    return f\"unknown tool {name}\"\n\n# --------------------------------------------------------------------------- the per-message loop\ndef log_usage(usage, user_id, round_no, tool=None):\n    rec = {\"ts\": dt.datetime.now(dt.timezone.utc).isoformat(timespec=\"seconds\"), \"user\": user_id, \"round\": round_no,\n           \"input_tokens\": usage.input_tokens, \"cache_creation_input_tokens\": usage.cache_creation_input_tokens,\n           \"cache_read_input_tokens\": usage.cache_read_input_tokens, \"output_tokens\": usage.output_tokens}\n    if tool:\n        rec[\"tool\"] = tool\n    os.makedirs(os.path.dirname(USAGE_LOG), exist_ok=True)\n    with open(USAGE_LOG, \"a\") as f:\n        f.write(json.dumps(rec) + \"\\n\")\n\n\ndef build_request(a, messages, tools, today):\n    return {\"model\": MODEL, \"max_tokens\": MAX_TOKENS, \"system\": build_system(a, today), \"tools\": tools, \"messages\": messages}\n\n\ndef reply(user_id, text, llm=None):\n    llm = llm or LLM()\n    a = load_athlete(user_id)\n    today = dt.date.today()\n    tools = select_tools(text)\n    messages = [{\"role\": \"user\", \"content\": text}]\n    for round_no in range(1, MAX_TOOL_ROUNDS + 1):\n        resp = llm.create(**build_request(a, messages, tools, today))\n        used_tools = [b.name for b in resp.content if b.type == \"tool_use\"]\n        log_usage(resp.usage, a.user_id, round_no, tool=\",\".join(used_tools) or None)\n        if resp.stop_reason != \"tool_use\":\n            return \"\".join(b.text for b in resp.content if b.type == \"text\")\n        messages.append({\"role\": \"assistant\", \"content\": [b.model_dump() for b in resp.content]})\n        results = [{\"type\": \"tool_result\", \"tool_use_id\": b.id, \"content\": run_tool(a, b.name, b.input)}\n                   for b in resp.content if b.type == \"tool_use\"]\n        messages.append({\"role\": \"user\", \"content\": results})\n    return \"Sorry, I lost the thread. Ask me again?\"\n\n\nif __name__ == \"__main__\":\n    # Local chat: python3 bot.py <user_id>; Telegram long-polling lives in telegram.py (not in this repo).\n    uid = sys.argv[1] if len(sys.argv) > 1 else \"42\"\n    for line in sys.stdin:\n        print(reply(uid, line.strip()))\n"},"display":{"success":true,"verb":"Edited","message":"bot.py","warnings":[],"approvalNote":null,"suffix":""},"decision":"execute"}}
