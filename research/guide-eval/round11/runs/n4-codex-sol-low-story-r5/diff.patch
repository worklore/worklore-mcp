 ;; OS-level fence for lanes whose output leaves the machine: the agent has a real shell, so the real home must be
-;; unreachable. Only the agent's own install is opened. Network stays open. HOME is passed with -D HOME=<real home>.
+;; unreachable. Only the lane's explicit exception is opened. Network stays open.
+;; HOME is the real home; AGENT_HOME is Kimi's install or Codex's scratch home.
 (version 1)
 (allow default)
 (deny file-read-data (subpath (param "HOME")))
 (deny file-write* (subpath (param "HOME")))
-(allow file-read-data (subpath (string-append (param "HOME") "/.kimi-code")))
-(allow file-write* (subpath (string-append (param "HOME") "/.kimi-code")))
+(allow file-read-data (subpath (param "AGENT_HOME")))
+(allow file-write* (subpath (param "AGENT_HOME")))
 (deny process-exec (literal "/bin/launchctl") (literal "/usr/bin/security") (literal "/usr/bin/osascript"))
