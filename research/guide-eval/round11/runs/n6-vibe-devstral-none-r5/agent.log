{"id":"effect-e7c5025d-f4c4-5509-9988-1d13e9bd06ea","sessionId":"d8e3f4a5-8678-5888-31c7-c495ec0b70ef","turnId":"turn-d1d6b4fe4a6888285284fc92ea02d934","inputEntryId":"user-turn-d1d6b4fe4a6888285284fc92ea02d934-1","createdAt":1794285960108,"updatedAt":1794285960115,"generationStatus":"completed","relatedEntryId":null,"type":"effect","title":"file_system.read_file","detail":{"toolName":"file_system.read_file","display":{"summary":"Reading src/transfer.ts","content":null,"suffix":"","verb":"Reading","message":"src/transfer.ts","settledVerb":"Read","settledMessage":"src/transfer.ts","statusText":"Reading file"},"kind":"file_read","input":{"filePath":"src/transfer.ts","offset":null,"limit":2000}},"state":{"status":"completed","outputText":"","approvalSource":"bypass","decision":"execute","output":{"filePath":"/private/tmp/h-FY2qAE/src/transfer.ts","content":"import { AccountId, PrivateKey, TransactionId, TransferTransaction, Hbar, Timestamp } from \"@hashgraph/sdk\";\nimport * as dotenv from \"dotenv\";\n\nasync function main() {\n  dotenv.config();\n\n  const operatorId = AccountId.fromString(process.env.OPERATOR_ID!);\n  const operatorKey = PrivateKey.fromStringDer(process.env.OPERATOR_KEY!);\n  const recipientId = AccountId.fromString(process.env.RECIPIENT_ID!);\n  const validStartSeconds = parseInt(process.env.VALID_START!, 10);\n\n  const transaction = new TransferTransaction()\n    .setNodeAccountIds([AccountId.fromString(\"0.0.3\")])\n    .setTransactionId(\n      TransactionId.withValidStart(operatorId, Timestamp.fromDate(validStartSeconds * 1000))\n    )\n    .addHbarTransfer(operatorId, new Hbar(-1))\n    .addHbarTransfer(recipientId, new Hbar(1))\n    .setTransactionMemo(\"invoice 42\");\n\n  const frozenTx = await transaction.freeze();\n  const signedTx = await frozenTx.sign(operatorKey);\n\n  const bytes = await signedTx.toBytesAsync();\n  console.log(Buffer.from(bytes).toString(\"hex\"));\n}\n\nmain();\n","numLines":28,"startLine":1,"requestedOffset":null,"requestedLimit":2000,"totalLines":null,"wasTruncated":false},"display":{"success":true,"verb":"Read","message":"28 lines from src/transfer.ts","warnings":[],"approvalNote":null,"suffix":""},"approvalType":"always","durationMs":0.0}}
