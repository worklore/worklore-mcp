{"id":"effect-b37400a6-2e7e-576b-9a8e-8b9182a124bd","sessionId":"d8e3f4a5-8678-5888-31c7-c495ec0b70ef","turnId":"turn-d1d6b4fe4a6888285284fc92ea02d934","inputEntryId":"user-turn-d1d6b4fe4a6888285284fc92ea02d934-1","createdAt":1794285871852,"updatedAt":1794285871859,"generationStatus":"completed","relatedEntryId":null,"type":"effect","title":"file_system.write_file","detail":{"toolName":"file_system.write_file","display":{"summary":"Writing src/transfer.ts","content":"import { AccountId, PrivateKey, TransactionId, TransferTransaction, Hbar } from \"@hashgraph/sdk\";\nimport * as dotenv from \"dotenv\";\n\ndotenv.config();\n\nconst operatorId = AccountId.fromString(process.env.OPERATOR_ID!);\nconst operatorKey = PrivateKey.fromStringDer(process.env.OPERATOR_KEY!);\nconst recipientId = AccountId.fromString(process.env.RECIPIENT_ID!);\nconst validStart = parseInt(process.env.VALID_START!, 10);\n\nconst transaction = new TransferTransaction()\n  .setNodeAccountIds([AccountId.fromString(\"0.0.3\")])\n  .setTransactionId(\n    TransactionId.withValidStart(operatorId, validStart)\n  )\n  .addHbarTransfer(operatorId, new Hbar(-1))\n  .addHbarTransfer(recipientId, new Hbar(1))\n  .setMemo(\"invoice 42\");\n\nconst signedTx = transaction.sign(operatorKey);\n\nconsole.log(signedTx.toBytes().toString(\"hex\"));\n","suffix":"","verb":"Creating","message":"src/transfer.ts","settledVerb":"Created","settledMessage":"src/transfer.ts","statusText":"Writing file"},"kind":"file_write","input":{"filePath":"src/transfer.ts","content":"import { AccountId, PrivateKey, TransactionId, TransferTransaction, Hbar } from \"@hashgraph/sdk\";\nimport * as dotenv from \"dotenv\";\n\ndotenv.config();\n\nconst operatorId = AccountId.fromString(process.env.OPERATOR_ID!);\nconst operatorKey = PrivateKey.fromStringDer(process.env.OPERATOR_KEY!);\nconst recipientId = AccountId.fromString(process.env.RECIPIENT_ID!);\nconst validStart = parseInt(process.env.VALID_START!, 10);\n\nconst transaction = new TransferTransaction()\n  .setNodeAccountIds([AccountId.fromString(\"0.0.3\")])\n  .setTransactionId(\n    TransactionId.withValidStart(operatorId, validStart)\n  )\n  .addHbarTransfer(operatorId, new Hbar(-1))\n  .addHbarTransfer(recipientId, new Hbar(1))\n  .setMemo(\"invoice 42\");\n\nconst signedTx = transaction.sign(operatorKey);\n\nconsole.log(signedTx.toBytes().toString(\"hex\"));\n"}},"state":{"status":"completed","outputText":"","approvalSource":"bypass","decision":"execute","output":{"filePath":"/private/tmp/h-FY2qAE/src/transfer.ts","content":"import { AccountId, PrivateKey, TransactionId, TransferTransaction, Hbar } from \"@hashgraph/sdk\";\nimport * as dotenv from \"dotenv\";\n\ndotenv.config();\n\nconst operatorId = AccountId.fromString(process.env.OPERATOR_ID!);\nconst operatorKey = PrivateKey.fromStringDer(process.env.OPERATOR_KEY!);\nconst recipientId = AccountId.fromString(process.env.RECIPIENT_ID!);\nconst validStart = parseInt(process.env.VALID_START!, 10);\n\nconst transaction = new TransferTransaction()\n  .setNodeAccountIds([AccountId.fromString(\"0.0.3\")])\n  .setTransactionId(\n    TransactionId.withValidStart(operatorId, validStart)\n  )\n  .addHbarTransfer(operatorId, new Hbar(-1))\n  .addHbarTransfer(recipientId, new Hbar(1))\n  .setMemo(\"invoice 42\");\n\nconst signedTx = transaction.sign(operatorKey);\n\nconsole.log(signedTx.toBytes().toString(\"hex\"));\n","fileExisted":false,"previousContent":null},"display":{"success":true,"verb":"Created","message":"src/transfer.ts","warnings":[],"approvalNote":null,"suffix":""},"approvalType":"always","durationMs":0.0}}
