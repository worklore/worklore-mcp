lish_stores_story(self):\n        table = FakeTable()\n        story = {\n            \"slug\": \"why-my-cron-ran-twice\",\n            \"title\": \"Why my cron ran twice\",\n            \"tags\": [\"cron\", \"linux\"],\n            \"body\": \"Two crontabs, one for root and one for me, both had the line.\",\n        }\n        stored = app.publish(table, story)\n        self.assertEqual(stored[\"slug\"], \"why-my-cron-ran-twice\")\n        self.assertEqual(table.get_item(Key={\"slug\": \"why-my-cron-ran-twice\"})[\"Item\"][\"title\"], \"Why my cron ran twice\")\n        self.assertEqual(table.scan()[\"Count\"], 1)\n\n    def test_publish_with_existing_story(self):\n        table = FakeTable()\n        existing = {\n            \"slug\": \"first-story\",\n            \"title\": \"First Story\",\n            \"tags\": [\"python\", \"testing\"],\n            \"body\": \"This is the first story in the library.\",\n            \"published_at\": 1234567890,\n            \"similar\": [],\n        }\n        table.put_item(Item=existing)\n        story = {\n            \"slug\": \"why-my-cron-ran-twice\",\n            \"title\": \"Why my cron ran twice\",\n            \"tags\": [\"cron\", \"linux\"],\n            \"body\": \"Two crontabs, one for root and one for me, both had the line.\",\n        }\n        stored = app.publish(table, story)\n        self.assertEqual(stored[\"slug\"], \"why-my-cron-ran-twice\")\n        self.assertEqual(table.scan()[\"Count\"], 2)\n        self.assertIn(\"similar\", stored)\n        self.assertIsInstance(stored[\"similar\"][0][\"score\"], type(stored[\"similar\"][0][\"score\"]))\n\n\nif __name__ == \"__main__\":\n    unittest.main()","replaceAll":false}},"state":{"status":"completed","outputText":"","durationMs":0.0,"approvalSource":"bypass","approvalType":"always","output":{"file":"/private/tmp/h-hPu2O4/tests/test_publish.py","oldString":null,"newString":null,"occurrences":[{"startLine":1,"newStartLine":1,"oldText":"import os\nimport sys