+    """Construct the system prompt split into static and dynamic parts.
+
+    The coaching *instructions* never change, so they can be cached with
+    {"type": "static"}. The per‑athlete context varies and must be
+    ephemeral. Returning two messages lets the LLM cache the static part
+    while refreshing the dynamic part, avoiding a full‑prompt cache miss after
+    a save_fact call.
+    """
+    static_msg = {
+        "type": "text",
+        "text": INSTRUCTIONS,
+        "cache_control": {"type": "static"},
+    }
+    dynamic_msg = {
+        "type": "text",
+        "text": "\n\n" + athlete_context(a, today),
+        "cache_control": {"type": "ephemeral"},
+    }
+    return [static_msg, dynamic_msg]
 
