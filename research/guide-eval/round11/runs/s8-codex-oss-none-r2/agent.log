c prefix caching: cacheable prefixes end at each\\\\n    cache_control marker; a request reads the longest stored prefix it matches\\\\n    and creates cache from the match point to the last marker.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    def __init__(self):\\\\n        self.entries = set()\\\\n    def account(self, tools, system):\\\\n        parts = [json.dumps(tools, sort_keys=True, separators=(\\\\\\\",\\\\\\\", \\\\\\\":\\\\\\\"))]\\\\n        prefixes = []\\\\n        for blk in system:\\\\n            parts.append(blk[\\\\\\\"text\\\\\\\"])\\\\n            if blk.get(\\\\\\\"cache_control\\\\\\\"):\\\\n                prefixes.append(\\\\\\\"\\\\\\\".join(parts))\\\\n        hit = \\\\\\\"\\\\\\\"\\\\n        for p in prefixes:          # prefixes are nested; keep the longest match\\\\n            if p in self.entries:\\\\n                hit = p\\\\n        full = prefixes[-1]\\\\n        read = approx_tokens(hit)\\\\n        creation = 0 if hit == full else approx_tokens(full[len(hit):])\\\\n        self.entries.update(prefixes)\\\\n        return read, creation\\\\n\\\\nclass Block:\\\\n    def __init__(self, type, **kw):\\\\n        self.type = type\\\\n        self.__dict__.update(kw)\\\\n    def model_dump(self):\\\\n        return dict(self.__dict__)\\\\n\\\\nclass Usage:\\\\n    input_tokens = 60\\\\n    cache_creation_input_tokens = 0\\\\n    cache_read_input_tokens = 0\\\\n    output_tokens = 25\\\\n\\\\nclass Resp:\\\\n    def __init__(self, blocks, stop):\\\\n        self.content = blocks\\\\n        self.stop_reason = stop\\\\n        self.usage = Usage()\\\\n\\\\nclass FakeLLM:\\\\n    def __init__(self, script):\\\\n        self._script = list(script)\\\\n        self.requests = []\\\\n    def create(self, **kw):\\\\n        self.requests.append(kw)\\\\n        blocks, stop = self._script.pop(0)\\\\n        return Resp(blocks, stop)\\\\n\\\\ndef old_build_system(a, today):\\\\n    text = bot.INSTRUCTIONS + \\\\\\\"\\\\\\\\n\\\\\\\\n\\\\\\\" + bot.athlete_context(a, today)\\\\n    return [{\\\\\\\"type\\\\\\\": \\\\\\\"text\\\\\\\", \\\\\\\"text\\\\\\\": text, \\\\\\\"cache_control\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"ephemeral\\\\\\\"}}]\\\\n\\\\nNEW_BUILD_SYSTEM = bot.build_system\\\\nORIG_ATHLETES_FILE, ORIG_LOG_USAGE = bot.ATHLETES_FILE, bot.log_usage\\\\n\\\\ndef run_scenario():\\\\n    tmp = tempfile.mkdtemp(prefix=\\\\\\\".cachetest_\\\\\\\", dir=\\\\\\\".\\\\\\\")\\\\n    try:\\\\n        shutil.copy(os.path.join(\\\\\\\"data\\\\\\\", \\\\\\\"athletes.json\\\\\\\"), os.path.join(tmp, \\\\\\\"athletes.json\\\\\\\"))\\\\n        bot.ATHLETES_FILE = os.path.join(tmp, \\\\\\\"athletes.json\\\\\\\")\\\\n        bot.log_usage = lambda usage, user_id, round_no, tool=None: None\\\\n        save_block = Block(\\\\\\\"tool_use\\\\\\\", id=\\\\\\\"tu_1\\\\\\\", name=\\\\\\\"save_fact\\\\\\\",\\\\n                           input={\\\\\\\"fact\\\\\\\": \\\\\\\"Races parkrun every Saturday\\\\\\\"})\\\\n        llm = FakeLLM([\\\\n            ([save_block], \\\\\\\"tool_use\\\\\\\"),\\\\n            ([Block(\\\\\\\"text\\\\\\\", text=\\\\\\\"Noted, parkrun Saturdays.\\\\\\\")], \\\\\\\"end_turn\\\\\\\"),\\\\n            ([Block(\\\\\\\"text\\\\\\\", text=\\\\\\\"Glad to help.\\\\\\\")], \\\\\\\"end_turn\\\\\\\"),\\\\n            ([Block(\\\\\\\"text\\\\\\\", text=\\\\\\\"Hallo Jonas.\\\\\\\")], \\\\\\\"end_turn\\\\\\\"),\\\\n        ])\\\\n        bot.reply(\\\\\\\"42\\\\\\\", \\\\\\\"I do parkrun every Saturday\\\\\\\", llm=llm)   # no tool-group keywords\\\\n        bot.reply(\\\\\\\"42\\\\\\\", \\\\\\\"thanks\\\\\\\", llm=llm)\\\\n        bot.reply(\\\\\\\"77\\\\\\\", \\\\\\\"hallo\\\\\\\", llm=llm)   # second athlete in the same 5-min window\\\\n        sim = CacheSim()\\\\n        accounting = [sim.account(r[\\\\\\\"tools\\\\\\\"], r[\\\\\\\"system\\\\\\\"]) for r in llm.requests]\\\\n        return llm.requests, accounting\\\\n    finally:\\\\n        shutil.rmtree(tmp)\\\\n        bot.ATHLETES_FILE, bot.log_usage = ORIG_ATHLETES_FILE, ORIG_LOG_USAGE\\\\n\\\\nbot.build_system = old_build_system\\\\nreqs_old, acc_old = run_scenario()\\\\nbot.build_system = NEW_BUILD_SYSTEM\\\\nreqs_new, acc_new = run_scenario()\\\\n\\\\n# ---- structural checks on the new request shape ----\\\\nsys_new = [r[\\\\\\\"system\\\\\\\"] for r in reqs_new]\\\\ncheck(\\\\\\\"new: 4 requests captured\\\\\\\", len(reqs_new) == 4)\\\\ncheck(\\\\\\\"new: system is 2 blocks\\\\\\\", all(len(s) == 2 for s in sys_new))\\\\ncheck(\\\\\\\"new: both blocks carry cache_control ephemeral\\\\\\\",\\\\n      all(b.get(\\\\\\\"cache_control\\\\\\\") == {\\\\\\\"type\\\\\\\": \\\\\\\"ephemeral\\\\\\\"} for s in sys_new for b in s))\\\\ncheck(\\\\\\\"new: block 1 is the raw INSTRUCTIONS constant on every call\\\\\\\",\\\\n      all(s[0][\\\\\\\"text\\\\\\\"] == bot.INSTRUCTIONS for s in sys_new))\\\\ncheck(\\\\\\\"new: tail before save_fact lacks the fact\\\\\\\",\\\\n      \\\\\\\"parkrun\\\\\\\" not in sys_new[0][1][\\\\\\\"text\\\\\\\"])\\\\ncheck(\\\\\\\"new: tail right after save_fact has the fact\\\\\\\",\\\\n      \\\\\\\"parkrun\\\\\\\" in sys_new[1][1][\\\\\\\"text\\\\\\\"])\\\\ncheck(\\\\\\\"new: next message tail identical to post-save tail\\\\\\\",\\\\n      sys_new[1][1][\\\\\\\"text\\\\\\\"] == sys_new[2][1][\\\\\\\"text\\\\\\\"])\\\\ncheck(\\\\\\\"new: second athlete's tail differs, instructions identical\\\\\\\",\\\\n      sys_new[3][1][\\\\\\\"text\\\\\\\"] != sys_new[2][1][\\\\\\\"text\\\\\\\"] and sys_new[3][0][\\\\\\\"text\\\\\\\"] == bot.INSTRUCTIONS)\\\\na_pre = bot.load_athlete(\\\\\\\"42\\\\\\\")   # real file still holds the pre-save record\\\\ncheck(\\\\\\\"new: rendered prompt byte-identical to previous single-block version\\\\\\\",\\\\n      sys_new[0][0][\\\\\\\"text\\\\\\\"] + sys_new[0][1][\\\\\\\"text\\\\\\\"]\\\\n      == bot.INSTRUCTIONS + \\\\\\\"\\\\\\\\n\\\\\\\\n\\\\\\\" + bot.athlete_context(a_pre, dt.date.today()))\\\\ntools_dump = [json.dumps(r[\\\\\\\"tools\\\\\\\"], sort_