{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01J2XXYnoB1KfXHmfnrD3NVv","type":"tool_result","content":"     1\t\"\"\"Story library: the publish handler.\n     2\t\n     3\tEach story is stored in one DynamoDB item together with the three most similar\n     4\tstories already in the library (``similar``), so the reader page can show\n     5\t\"related\" without a query at read time.\n     6\t\"\"\"\n     7\timport json\n     8\timport logging\n     9\timport re\n    10\timport time\n    11\t\n    12\tlog = logging.getLogger(\"stories\")\n    13\t\n    14\tTABLE_NAME = \"stories\"\n    15\tTOP_N = 3\n    16\t\n    17\t_WORD = re.compile(r\"[a-z0-9]+\")\n    18\t\n    19\t\n    20\tdef words(text):\n    21\t    return set(_WORD.findall((text or \"\").lower()))\n    22\t\n    23\t\n    24\tdef similarity(a, b):\n    25\t    \"\"\"Shared-tag ratio (Jaccard), blended with shared words of the two bodies.\"\"\"\n    26\t    ta, tb = set(a.get(\"tags\", [])), set(b.get(\"tags\", []))\n    27\t    tag_score = len(ta & tb) / len(ta | tb) if (ta | tb) else 0\n    28\t    wa, wb = words(a.get(\"body\")), words(b.get(\"body\"))\n    29\t    word_score = len(wa & wb) / len(wa | wb) if (wa | wb) else 0\n    30\t    return round(0.7 * tag_score + 0.3 * word_score, 4)\n    31\t\n    32\t\n    33\tdef related(story, existing):\n    34\t    scored = []\n    35\t    for other in existing:\n    36\t        if other[\"slug\"] == story[\"slug\"]:\n    37\t            continue\n    38\t        scored.append({\"slug\": other[\"slug\"], \"score\": similarity(story, other)})\n    39\t    scored.sort(key=lambda s: s[\"score\"], reverse=True)\n    40\t    return scored[:TOP_N]\n    41\t\n    42\t\n    43\tdef validate(story):\n    44\t    for k in (\"slug\", \"title\", \"body\"):\n    45\t        if not story.get(k):\n    46\t            raise ValueError(f\"missing field: {k}\")\n    47\t    if not re.fullmatch(r\"[a-z0-9-]{3,80}\", story[\"slug\"]):\n    48\t        raise ValueError(\"bad slug\")\n    49\t\n    50\t\n    51\tdef publish(table, story):\n    52\t    \"\"\"Store ``story`` with its related stories. Returns the stored item.\"\"\"\n    53\t    validate(story)\n    54\t    existing = table.scan(TableName=TABLE_NAME).get(\"Items\", [])\n    55\t    item = {\n    56\t        \"slug\": story[\"slug\"],\n    57\t        \"title\": story[\"title\"],\n    58\t        \"tags\": sorted(set(story.get(\"tags\", []))),\n    59\t        \"body\": story[\"body\"],\n    60\t        \"published_at\": int(time.time()),\n    61\t        \"similar\": related(story, existing),\n    62\t    }\n    63\t    table.put_item(Item=item)\n    64\t    log.info(\"publish slug=%s similar=%d stored\", item[\"slug\"], len(item[\"similar\"]))\n    65\t    return item\n    66\t\n    67\t\n    68\tdef handler(event, table):\n    69\t    \"\"\"Lambda-style entry point for POST /stories. Body is the story as JSON.\"\"\"\n    70\t    try:\n    71\t        story = json.loads(event.get(\"body\") or \"{}\")\n    72\t        stored = publish(table, story)\n    73\t        return {\"statusCode\": 201, \"body\": json.dumps({\"slug\": stored[\"slug\"]})}\n    74\t    except ValueError as e:\n    75\t        return {\"statusCode\": 400, \"body\": json.dumps({\"error\": str(e)})}\n    76\t    except Exception:\n    77\t        log.exception(\"publish failed\")\n    78\t        return {\"statusCode\": 500, \"body\": json.dumps({\"error\": \"Internal Server Error\"})}\n---TESTS\n     1\timport os\n     2\timport sys\n     3\timport unittest\n     4\t\n     5\tsys.path.insert(0, os.path.join(os.path.dirname(__file__), \"..\", \"src\"))\n     6\tsys.path.insert(0, os.path.dirname(__file__))\n     7\t\n     8\timport app  # noqa: E402\n     9\tfrom fake_dynamo import FakeTable  # noqa: E402\n    10\t\n    11\t\n    12\tclass PublishTest(unittest.TestCase):\n    13\t    def test_publish_stores_story(self):\n    14\t        table = FakeTable()\n    15\t        story = {\n    16\t            \"slug\": \"why-my-cron-ran-twice\",\n    17\t            \"title\": \"Why my cron ran twice\",\n    18\t            \"tags\": [\"cron\", \"linux\"],\n    19\t            \"body\": \"Two crontabs, one for root and one for me, both had the line.\",\n    20\t        }\n    21\t        stored = app.publish(table, story)\n    22\t        self.assertEqual(stored[\"slug\"], \"why-my-cron-ran-twice\")\n    23\t        self.assertEqual(table.get_item(Key={\"slug\": \"why-my-cron-ran-twice\"})[\"Item\"][\"title\"], \"Why my cron ran twice\")\n    24\t        self.assertEqual(table.scan()[\"Count\"], 1)\n    25\t\n    26\t\n    27\tif __name__ == \"__main__\":\n    28\t    unittest.main()\n---FAKE\n     1\t\"\"\"In-memory stand-in for a boto3 DynamoDB Table resource.\n     2\t\n     3\tIt stores items in a dict and validates values the way boto3's TypeSerializer\n     4\tdoes, so a test fails on the same inputs a real table would reject.\n     5\t\"\"\"\n     6\tfrom decimal import Decimal\n     7\t\n     8\t\n     9\tdef _check(value, path=\"Item\"):\n    10\t    if isinstance(value, bool) or value is None or isinstance(value, (int, str, bytes, Decimal)):\n    11\t        return\n    12\t    if isinstance(value, float):\n    13\t        raise TypeError(\"Float types are not supported. Use Decimal types instead.\")\n    14\t    if isinstance(value, dict):\n    15\t        for k, v in value.items():\n    16\t            _check(v, f\"{path}.{k}\")\n    17\t        return\n    18\t    if isinstance(value, (list, tuple, set, frozenset)):\n    19\t        for i, v in enumerate(value):\n    20\t            _check(v, f\"{path}[{i}]\")\n    21\t        return\n    22\t    raise TypeError(f\"Unsupported type {type(value)!r} for value at {path}\")\n    23\t\n    24\t\n    25\tclass FakeTable:\n    26\t    def __init__(self, key=\"slug\"):\n    27\t        self.key = key\n    28\t        self.items = {}\n    29\t\n    30\t    def put_item(self, Item, **kwargs):\n    31\t        _check(Item)\n    32\t        if self.key not in Item:\n    33\t            raise ValueError(f\"item is missing the key attribute {self.key!r}\")\n    34\t        self.items[Item[self.key]] = dict(Item)\n    35\t        return {\"ResponseMetadata\": {\"HTTPStatusCode\": 200}}\n    36\t\n    37\t    def get_item(self, Key, **kwargs):\n    38\t        item = self.items.get(Key[self.key])\n    39\t        return {\"Item\": dict(item)} if item is not None else {}\n    40\t\n    41\t    def scan(self, **kwargs):\n    42\t        return {\"Items\": [dict(v) for v in self.items.values()], \"Count\": len(self.items)}\n---README\n# stories-api\n\nA small story library behind `POST /stories` (Lambda + DynamoDB table `stories`,\npartition key `slug`). `src/app.py` is the whole service: `handler()` parses\nthe request and `publish()` stores the story together with its three most\nsimilar existing stories (`similar: [{slug, score}]`), so the reader page can\nshow \"related\" without any query at read time. `logs/error.log` is the\nproduction log from the first two publishes after the deploy.\n\nTests use an in-memory table (`tests/fake_dynamo.py`) that validates items the\nway boto3 does, so no AWS account is needed. Run them with\n`python3 -m unittest discover tests` from the repo root.\n---GI\n__pycache__/\n*.pyc\ntotal 8\ndrwx------   8 valentinakoniukhova wheel   256 Nov  9 22:38 .\ndrwxrwxrwt 644 root                wheel 20608 Nov  9 22:38 ..\ndrwxr-xr-x  12 valentinakoniukhova wheel   384 Nov  9 22:38 .git\n-rw-r--r--   1 valentinakoniukhova wheel    19 Nov  9 22:38 .gitignore\n-rw-r--r--   1 valentinakoniukhova wheel   654 Nov  9 22:38 README.md\ndrwxr-xr-x   3 valentinakoniukhova wheel    96 Nov  9 22:38 logs\ndrwxr-xr-x   3 valentinakoniukhova wheel    96 Nov  9 22:38 src\ndrwxr-xr-x   4 valentinakoniukhova wheel   128 Nov  9 22:38 tests","is_error":false}]},"parent_tool_use_id":null,"session_id":"113f0741-14b0-45f4-8f82-d9c103f4f43c","uuid":"37761be9-c1e7-4d80-867f-62d08c0ca3d0","timestamp":"2026-11-10T01:38:37.673Z","tool_use_result":{"stdout":"     1\t\"\"\"Story library: the publish handler.\n     2\t\n     3\tEach story is stored in one DynamoDB item together with the three most similar\n     4\tstories already in the library (``similar``), so the reader page can show\n     5\t\"related\" without a query at read time.\n     6\t\"\"\"\n     7\timport json\n     8\timport logging\n     9\timport re\n    10\timport time\n    11\t\n    12\tlog = logging.getLogger(\"stories\")\n    13\t\n    14\tTABLE_NAME = \"stories\"\n    15\tTOP_N = 3\n    16\t\n    17\t_WORD = re.compile(r\"[a-z0-9]+\")\n    18\t\n    19\t\n    20\tdef words(text):\n    21\t    return set(_WORD.findall((text or \"\").lower()))\n    22\t\n    23\t\n    24\tdef similarity(a, b):\n    25\t    \"\"\"Shared-tag ratio (Jaccard), blended with shared words of the two bodies.\"\"\"\n    26\t    ta, tb = set(a.get(\"tags\", [])), set(b.get(\"tags\", []))\n    27\t    tag_score = len(ta & tb) / len(ta | tb) if (ta | tb) else 0\n    28\t    wa, wb = words(a.get(\"body\")), words(b.get(\"body\"))\n    29\t    word_score = len(wa & wb) / len(wa | wb) if (wa | wb) else 0\n    30\t    return round(0.7 * tag_score + 0.3 * word_score, 4)\n    31\t\n    32\t\n    33\tdef related(story, existing):\n    34\t    scored = []\n    35\t    for other in existing:\n    36\t        if other[\"slug\"] == story[\"slug\"]:\n    37\t            continue\n    38\t        scored.append({\"slug\": other[\"slug\"], \"score\": similarity(story, other)})\n    39\t    scored.sort(key=lambda s: s[\"score\"], reverse=True)\n    40\t    return scored[:TOP_N]\n    41\t\n    42\t\n    43\tdef validate(story):\n    44\t    for k in (\"slug\", \"title\", \"body\"):\n    45\t        if not story.get(k):\n    46\t            raise ValueError(f\"missing field: {k}\")\n    47\t    if not re.fullmatch(r\"[a-z0-9-]{3,80}\", story[\"slug\"]):\n    48\t        raise ValueError(\"bad slug\")\n    49\t\n    50\t\n    51\tdef publish(table, story):\n    52\t    \"\"\"Store ``story`` with its related stories. Returns the stored item.\"\"\"\n    53\t    validate(story)\n    54\t    existing = table.scan(TableName=TABLE_NAME).get(\"Items\", [])\n    55\t    item = {\n    56\t        \"slug\": story[\"slug\"],\n    57\t        \"title\": story[\"title\"],\n    58\t        \"tags\": sorted(set(story.get(\"tags\", []))),\n    59\t        \"body\": story[\"body\"],\n    60\t        \"published_at\": int(time.time()),\n    61\t        \"similar\": related(story, existing),\n    62\t    }\n    63\t    table.put_item(Item=item)\n    64\t    log.info(\"publish slug=%s similar=%d stored\", item[\"slug\"], len(item[\"similar\"]))\n    65\t    return item\n    66\t\n    67\t\n    68\tdef handler(event, table):\n    69\t    \"\"\"Lambda-style entry point for POST /stories. Body is the story as JSON.\"\"\"\n    70\t    try:\n    71\t        story = json.loads(event.get(\"body\") or \"{}\")\n    72\t        stored = publish(table, story)\n    73\t        return {\"statusCode\": 201, \"body\": json.dumps({\"slug\": stored[\"slug\"]})}\n    74\t    except ValueError as e:\n    75\t        return {\"statusCode\": 400, \"body\": json.dumps({\"error\": str(e)})}\n    76\t    except Exception:\n    77\t        log.exception(\"publish failed\")\n    78\t        return {\"statusCode\": 500, \"body\": json.dumps({\"error\": \"Internal Server Error\"})}\n---TESTS\n     1\timport os\n     2\timport sys\n     3\timport unittest\n     4\t\n     5\tsys.path.insert(0, os.path.join(os.path.dirname(__file__), \"..\", \"src\"))\n     6\tsys.path.insert(0, os.path.dirname(__file__))\n     7\t\n     8\timport app  # noqa: E402\n     9\tfrom fake_dynamo import FakeTable  # noqa: E402\n    10\t\n    11\t\n    12\tclass PublishTest(unittest.TestCase):\n    13\t    def test_publish_stores_story(self):\n    14\t        table = FakeTable()\n    15\t        story = {\n    16\t            \"slug\": \"why-my-cron-ran-twice\",\n    17\t            \"title\": \"Why my cron ran twice\",\n    18\t            \"tags\": [\"cron\", \"linux\"],\n    19\t            \"body\": \"Two crontabs, one for root and one for me, both had the line.\",\n    20\t        }\n    21\t        stored = app.publish(table, story)\n    22\t        self.assertEqual(stored[\"slug\"], \"why-my-cron-ran-twice\")\n    23\t        self.assertEqual(table.get_item(Key={\"slug\": \"why-my-cron-ran-twice\"})[\"Item\"][\"title\"], \"Why my cron ran twice\")\n    24\t        self.assertEqual(table.scan()[\"Count\"], 1)\n    25\t\n    26\t\n    27\tif __name__ == \"__main__\":\n    28\t    unittest.main()\n---FAKE\n     1\t\"\"\"In-memory stand-in for a boto3 DynamoDB Table resource.\n     2\t\n     3\tIt stores items in a dict and validates values the way boto3's TypeSerializer\n     4\tdoes, so a test fails on the same inputs a real table would reject.\n     5\t\"\"\"\n     6\tfrom decimal import Decimal\n     7\t\n     8\t\n     9\tdef _check(value, path=\"Item\"):\n    10\t    if isinstance(value, bool) or value is None or isinstance(value, (int, str, bytes, Decimal)):\n    11\t        return\n    12\t    if isinstance(value, float):\n    13\t        raise TypeError(\"Float types are not supported. Use Decimal types instead.\")\n    14\t    if isinstance(value, dict):\n    15\t        for k, v in value.items():\n    16\t            _check(v, f\"{path}.{k}\")\n    17\t        return\n    18\t    if isinstance(value, (list, tuple, set, frozenset)):\n    19\t        for i, v in enumerate(value):\n    20\t            _check(v, f\"{path}[{i}]\")\n    21\t        return\n    22\t    raise TypeError(f\"Unsupported type {type(value)!r} for value at {path}\")\n    23\t\n    24\t\n    25\tclass FakeTable:\n    26\t    def __init__(self, key=\"slug\"):\n    27\t        self.key = key\n    28\t        self.items = {}\n    29\t\n    30\t    def put_item(self, Item, **kwargs):\n    31\t        _check(Item)\n    32\t        if self.key not in Item:\n    33\t            raise ValueError(f\"item is missing the key attribute {self.key!r}\")\n    34\t        self.items[Item[self.key]] = dict(Item)\n    35\t        return {\"ResponseMetadata\": {\"HTTPStatusCode\": 200}}\n    36\t\n    37\t    def get_item(self, Key, **kwargs):\n    38\t        item = self.items.get(Key[self.key])\n    39\t        return {\"Item\": dict(item)} if item is not None else {}\n    40\t\n    41\t    def scan(self, **kwargs):\n    42\t        return {\"Items\": [dict(v) for v in self.items.values()], \"Count\": len(self.items)}\n---README\n# stories-api\n\nA small story library behind `POST /stories` (Lambda + DynamoDB table `stories`,\npartition key `slug`). `src/app.py` is the whole service: `handler()` parses\nthe request and `publish()` stores the story together with its three most\nsimilar existing stories (`similar: [{slug, score}]`), so the reader page can\nshow \"related\" without any query at read time. `logs/error.log` is the\nproduction log from the first two publishes after the deploy.\n\nTests use an in-memory table (`tests/fake_dynamo.py`) that validates items the\nway boto3 does, so no AWS account is needed. Run them with\n`python3 -m unittest discover tests` from the repo root.\n---GI\n__pycache__/\n*.pyc\ntotal 8\ndrwx------   8 valentinakoniukhova wheel   256 Nov  9 22:38 .\ndrwxrwxrwt 644 root                wheel 20608 Nov  9 22:38 ..\ndrwxr-xr-x  12 valentinakoniukhova wheel   384 Nov  9 22:38 .git\n-rw-r--r--   1 valentinakoniukhova wheel    19 Nov  9 22:38 .gitignore\n-rw-r--r--   1 valentinakoniukhova wheel   654 Nov  9 22:38 README.md\ndrwxr-xr-x   3 valentinakoniukhova wheel    96 Nov  9 22:38 logs\ndrwxr-xr-x   3 valentinakoniukhova wheel    96 Nov  9 22:38 src\ndrwxr-xr-x   4 valentinakoniukhova wheel   128 Nov  9 22:38 tests","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01J2XXYnoB1KfXHmfnrD3NVv","permission_decision":{"