+from decimal import Decimal
 
 log = logging.getLogger("stories")
 
@@ -30,6 +31,23 @@ def similarity(a, b):
     return round(0.7 * tag_score + 0.3 * word_score, 4)
 
 
+def to_dynamo(value):
+    """Return ``value`` with every float replaced by a Decimal.
+
+    DynamoDB (boto3) rejects Python floats, and the failure only shows up when a
+    computed float reaches the write. Converting at the single write point covers
+    every path (scores, averages, ratios), not just the ones we remember to fix.
+    Decimal(str(x)) keeps the value as written (0.4 stays 0.4).
+    """
+    if isinstance(value, float):
+        return Decimal(str(value))
+    if isinstance(value, dict):
+        return {k: to_dynamo(v) for k, v in value.items()}
+    if isinstance(value, (list, tuple, set, frozenset)):
+        return [to_dynamo(v) for v in value]
+    return value
+
+
 def related(story, existing):
     scored = []
     for other in existing:
@@ -60,7 +78,7 @@ def publish(table, story):
         "published_at": int(time.time()),
         "similar": related(story, existing),
     }
-    table.put_item(Item=item)
+    table.put_item(Item=to_dynamo(item))
     log.info("publish slug=%s similar=%d stored", item["slug"], len(item["similar"]))
     return item
 
