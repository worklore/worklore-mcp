{"id":"effect-24a9982b-cda3-551e-b7ea-91ab8c8b15c1","sessionId":"56346167-22f2-dec6-ab02-5543827309b4","turnId":"turn-12013c8802186a7359bc4bc3b794772a","inputEntryId":"user-turn-12013c8802186a7359bc4bc3b794772a-1","createdAt":1794279697431,"updatedAt":1794279697450,"generationStatus":"completed","relatedEntryId":null,"type":"effect","title":"file_system.bash","detail":{"toolName":"file_system.bash","display":{"summary":"bash: ls -la logs/","content":null,"suffix":"","verb":"Running","message":"ls -la logs/","settledVerb":"Ran","settledMessage":"ls -la logs/","statusText":"Running command"},"kind":"shell","input":{"command":"ls -la logs/"}},"state":{"status":"completed","outputText":"total 16\ndrwxr-xr-x  3 valentinakoniukhova  wheel    96 Nov 10 00:01 .\ndrwx------  8 valentinakoniukhova  wheel   256 Nov 10 00:01 ..\n-rw-r--r--  1 valentinakoniukhova  wheel  5363 Nov 10 00:01 usage.jsonl\n","display":{"success":true,"verb":"Ran","message":"ls -la logs/","warnings":[],"approvalNote":null,"suffix":""},"approvalType":"always","decision":"execute","approvalSource":"bypass","output":{"stdout":"total 16\ndrwxr-xr-x  3 valentinakoniukhova  wheel    96 Nov 10 00:01 .\ndrwx------  8 valentinakoniukhova  wheel   256 Nov 10 00:01 ..\n-rw-r--r--  1 valentinakoniukhova  wheel  5363 Nov 10 00:01 usage.jsonl\n","stderr":"","output":"","truncated":false},"durationMs":0.0}}
{"id":"effect-c3bb6f5b-55a3-5c61-b05d-d92e0377cabf","sessionId":"56346167-22f2-dec6-ab02-5543827309b4","turnId":"turn-12013c8802186a7359bc4bc3b794772a","inputEntryId":"user-turn-12013c8802186a7359bc4bc3b794772a-1","createdAt":1794279698903,"updatedAt":1794279698919,"generationStatus":"completed","relatedEntryId":null,"type":"effect","title":"file_system.read_file","detail":{"toolName":"file_system.read_file","display":{"summary":"Reading bot.py","content":null,"suffix":"","verb":"Reading","message":"bot.py","settledVerb":"Read","settledMessage":"bot.py","statusText":"Reading file"},"kind":"file_read","input":{"filePath":"bot.py","offset":null,"limit":2000}},"state":{"status":"completed","outputText":"","display":{"success":true,"verb":"Read","message":"217 lines from bot.py","warnings":[],"approvalNote":null,"suffix":""},"approvalType":"always","decision":"execute","approvalSource":"bypass","output":{"filePath":"/private/tmp/h-y8ZX4u/bot.py","content":"\"\"\"Coach bot: a stateless endurance-coaching chat on Claude.\n\nEvery incoming message is a fresh request: we rebuild the system prompt from\nthe athlete record, pick the tools the message might need, and run a short\ntool-use loop. Nothing is kept between messages except what is written to\ndata/athletes.json (the athlete's profile and long-term facts).\n\"\"\"\nimport json\nimport os\nimport sys\nimport datetime as dt\nfrom dataclasses import dataclass, field, asdict\n\nMODEL = \"claude-sonnet-4-5\"\nMAX_TOKENS = 700\nMAX_TOOL_ROUNDS = 5\nATHLETES_FILE = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"data\", \"athletes.json\")\nUSAGE_LOG = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"logs\", \"usage.jsonl\")\n\n# --------------------------------------------------------------------------- LLM\ntry:\n    import anthropic\n\n    class LLM:\n        \"\"\"Thin wrapper so the rest of the file reads the same with or without the SDK.\"\"\"\n        def __init__(self):\n            self._client = anthropic.Anthropic(api_key=os.environ[\"COACH_ANTHROPIC_KEY\"])\n\n        def create(self, **kw):\n            return self._client.messages.create(**kw)\nexcept ImportError:  # the code is readable and importable without the SDK\n    class LLM:\n        def __init__(self):\n            raise RuntimeError(\"anthropic SDK not installed: pip install anthropic\")\n\n        def create(self, **kw):\n            raise RuntimeError(\"anthropic SDK not installed\")\n\n# --------------------------------------------------------------------------- athlete record\n@dataclass\nclass Athlete:\n    user_id: str\n    name: str\n    lang: str = \"en\"\n    sport: str = \"running\"\n    goal: str = \"finish a half marathon\"\n    zones: dict = field(default_factory=lambda: {\"Z1\": \"<135\", \"Z2\": \"135-150\", \"Z3\": \"150-162\", \"Z4\": \"162-172\", \"Z5\": \">172\"})\n    facts: list = field(default_factory=list)   # long-term memory, grows via save_fact\n\n\ndef _load_all():\n    try:\n        with open(ATHLETES_FILE) as f:\n            return json.load(f)\n    except FileNotFoundError:\n        return {}\n\n\ndef load_athlete(user_id):\n    raw = _load_all().get(str(user_id))\n    if raw is None:\n        return Athlete(user_id=str(user_id), name=\"athlete\")\n    return Athlete(**raw)\n\n\ndef save_athlete(a):\n    allrec = _load_all()\n    allrec[a.user_id] = asdict(a)\n    os.makedirs(os.path.dirname(ATHLETES_FILE), exist_ok=True)\n    with open(ATHLETES_FILE, \"w\") as f:\n        json.dump(allrec, f, indent=1, ensure_ascii=False)\n\n# --------------------------------------------------------------------------- system prompt\nINSTRUCTIONS = \"\"\"You are Pace, an endurance coach for recreational runners and cyclists.\n\nCoaching rules:\n1. Answer the question that was asked before adding anything else.\n2. Keep replies short: a chat message, not an article. Three paragraphs at most.\n3. Prescribe training by heart-rate zone or RPE, never by pace, unless the athlete asks for pace.\n4. Use the athlete's own zones from the profile below; never invent zone boundaries.\n5. Easy days are easy: anything labelled recovery or Z1/Z2 must stay there.\n6. Never add more than 10% weekly volume over the previous week.\n7. One hard session per week for beginners, two for athletes with 3+ years of training.\n8. A rest day is a session. Do not fill it.\n9. If the athlete reports pain (not soreness) lasting more than two days, stop the plan and say to see a physio.\n10. Do not diagnose injuries or illness. Do not give medication advice.\n11. Fuelling: 30-60 g carbs per hour for sessions over 75 minutes; mention it only when relevant.\n12. Sleep and stress count as training load. Ask about them when the athlete looks flat.\n13. Before a goal race, the last hard session is 7-10 days out. Taper means less volume, same intensity.\n14. Do not change the athlete's goal unless they ask. Mention the goal when a question is clearly off-plan.\n15. When the athlete tells you something durable about themselves (injury history, schedule, preferences,\n    equipment, races booked), call save_fact once with a single sentence. Do not save moods or one-off plans.\n16. Do not save a fact that is already in the list below.\n17. Use the plan_week tool for any weekly structure; do not write a week by hand.\n18. Use log_session when the athlete reports a completed workout, then comment on it.\n19. If asked for numbers you do not have (recent volume, last race), ask one question, do not guess.\n20. Metric units unless the profile says otherwise.\n\nTone:\n- Warm, direct, no exclamation marks.\n- No motivational quotes.\n- Address the athlete by first name at most once per reply.\n- Reply in the athlete's language from the profile below, even if they write in another language.\n\nSafety:\n- Never advise training through chest pain, dizziness or fever.\n- Minors: refer to a coach in person.\n- If someone asks for weight-loss plans below 1500 kcal per day, decline and suggest a dietitian.\n\nFormatting:\n- Plain text. No markdown headings, no tables.\n- Lists only for a session structure (warm-up / main / cool-down).\n- Numbers with units: 45 min, 12 km, 150 bpm.\n\"\"\"\n\n\ndef athlete_context(a, today):\n    lines = [\n        f\"Today: {today.isoformat()} ({today.strftime('%A')})\",\n        f\"Athlete: {a.name} (id {a.user_id}), sport: {a.sport}\",\n        \"Zones: \" + \", \".join(f\"{k} {v}\" for k, v in a.zones.items()),\n        f\"Goal: {a.goal}\",\n        \"Long-term facts:\",\n    ]\n    lines += [f\"- {f}\" for f in a.facts] or [\"- (none yet)\"]\n    lines.append(f\"Language: {a.lang}\")\n    return \"\\n\".join(lines)\n\n\ndef build_system(a, today):\n    # One block, cached as a whole: instructions + per-athlete context.\n    text = INSTRUCTIONS + \"\\n\\n\" + athlete_context(a, today)\n    return [{\"type\": \"text\", \"text\": text, \"cache_control\": {\"type\": \"ephemeral\"}}]\n\n# --------------------------------------------------------------------------- tools\nCORE_TOOLS = [\n    {\"name\": \"save_fact\", \"description\": \"Remember one durable fact about the athlete.\",\n     \"input_schema\": {\"type\": \"object\", \"properties\": {\"fact\": {\"type\": \"string\"}}, \"required\": [\"fact\"]}},\n    {\"name\": \"log_session\", \"description\": \"Record a completed workout.\",\n     \"input_schema\": {\"type\": \"object\", \"properties\": {\"minutes\": {\"type\": \"integer\"}, \"rpe\": {\"type\": \"integer\"},\n                                                       \"note\": {\"type\": \"string\"}}, \"required\": [\"minutes\"]}},\n]\nTOOL_GROUPS = {\n    \"plan\": ((\"plan\", \"week\", \"schedule\", \"taper\", \"build\"), [\n        {\"name\": \"plan_week\", \"description\": \"Draft a week of sessions.\",\n         \"input_schema\": {\"type\": \"object\", \"properties\": {\"hours\": {\"type\": \"number\"}, \"hard_days\": {\"type\": \"integer\"}},\n                          \"required\": [\"hours\"]}}]),\n    \"race\": ((\"race\", \"pace\", \"predict\", \"finish time\"), [\n        {\"name\": \"predict_race\", \"description\": \"Estimate a finish time from a recent effort.\",\n         \"input_schema\": {\"type\": \"object\", \"properties\": {\"distance_km\": {\"type\": \"number\"}, \"recent_minutes\": {\"type\": \"number\"}},\n                          \"required\": [\"distance_km\"]}}]),\n}\n\n\ndef select_tools(text):\n    \"\"\"Core tools always; a group is added only when the message mentions its keywords.\"\"\"\n    tools = list(CORE_TOOLS)\n    low = text.lower()\n    for _, (keys, group) in TOOL_GROUPS.items():\n        if any(k in low for k in keys):\n            tools += group\n    return tools\n\n\ndef run_tool(a, name, args):\n    if name == \"save_fact\":\n        a.facts.append(args[\"fact\"].strip())\n        save_athlete(a)\n        return \"saved\"\n    if name == \"log_session\":\n        return f\"logged {args.get('minutes')} min\"\n    if name == \"plan_week\":\n        return json.dumps({\"hours\": args[\"hours\"], \"hard_days\": args.get(\"hard_days\", 1), \"sessions\": [\"Mon rest\", \"Tue Z2 45 min\", \"...\"]})\n    if name == \"predict_race\":\n        return json.dumps({\"distance_km\": args[\"distance_km\"], \"estimate_min\": round(args.get(\"recent_minutes\", 50) * 2.1)})\n    return f\"unknown tool {name}\"\n\n# --------------------------------------------------------------------------- the per-message loop\ndef log_usage(usage, user_id, round_no, tool=None):\n    rec = {\"ts\": dt.datetime.now(dt.timezone.utc).isoformat(timespec=\"seconds\"), \"user\": user_id, \"round\": round_no,\n           \"input_tokens\": usage.input_tokens, \"cache_creation_input_tokens\": usage.cache_creation_input_tokens,\n           \"cache_read_input_tokens\": usage.cache_read_input_tokens, \"output_tokens\": usage.output_tokens}\n    if tool:\n        rec[\"tool\"] = tool\n    os.makedirs(os.path.dirname(USAGE_LOG), exist_ok=True)\n    with open(USAGE_LOG, \"a\") as f:\n        f.write(json.dumps(rec) + \"\\n\")\n\n\ndef build_request(a, messages, tools, today):\n    return {\"model\": MODEL, \"max_tokens\": MAX_TOKENS, \"system\": build_system(a, today), \"tools\": tools, \"messages\": messages}\n\n\ndef reply(user_id, text, llm=None):\n    llm = llm or LLM()\n    a = load_athlete(user_id)\n    today = dt.date.today()\n    tools = select_tools(text)\n    messages = [{\"role\": \"user\", \"content\": text}]\n    for round_no in range(1, MAX_TOOL_ROUNDS + 1):\n        resp = llm.create(**build_request(a, messages, tools, today))\n        used_tools = [b.name for b in resp.content if b.type == \"tool_use\"]\n        log_usage(resp.usage, a.user_id, round_no, tool=\",\".join(used_tools) or None)\n        if resp.stop_reason != \"tool_use\":\n            return \"\".join(b.text for b in resp.content if b.type == \"text\")\n        messages.append({\"role\": \"assistant\", \"content\": [b.model_dump() for b in resp.content]})\n        results = [{\"type\": \"tool_result\", \"tool_use_id\": b.id, \"content\": run_tool(a, b.name, b.input)}\n                   for b in resp.content if b.type == \"tool_use\"]\n        messages.append({\"role\": \"user\", \"content\": results})\n    return \"Sorry, I lost the thread. Ask me again?\"\n\n\nif __name__ == \"__main__\":\n    # Local chat: python3 bot.py <user_id>; Telegram long-polling lives in telegram.py (not in this repo).\n    uid = sys.argv[1] if len(sys.argv) > 1 else \"42\"\n    for line in sys.stdin:\n        print(reply(uid, line.strip()))\n","numLines":217,"startLine":1,"requestedOffset":null,"requestedLimit":2000,"totalLines":null,"wasTruncated":false},"durationMs":0.0}}
{"id":"assistant-a1da3c7f-6254-55ba-a897-3738e8fe66b3","sessionId":"56346167-22f2-dec6-ab02-5543827309b4","turnId":"turn-12013c8802186a7359bc4bc3b794772a","inputEntryId":"user-turn-12013c8802186a7359bc4bc3b794772a-1","createdAt":1794279701801,"updatedAt":1794279701801,"generationStatus":"completed","relatedEntryId":null,"type":"message","role":"assistant","content":[{"type":"text","text":"Now I understand the issue. The current code builds the system prompt as a single text block in `build_system()`. When `save_fact` is called, it modifies the athlete's facts, which changes the `athlete_context()` output, and since everything is in one block, the entire system prompt cache is invalidated.\n\nThe colleague's note describes the exact same problem and solution: split the system prompt into two separate text blocks with `cache_control: {\"type\": \"ephemeral\"}`. The first block contains static instructions that never change, and the second block contains the volatile per-user context (facts, date, etc.).\n\nLet me also check the README and NOTES to understand the context better:"}],"source":"harness","userDisplayContent":null,"outcome":{"type":"committed"}}
{"id":"effect-2bfe813d-6387-55dd-9830-39988631dfac","sessionId":"56346167-22f2-dec6-ab02-5543827309b4","turnId":"turn-12013c8802186a7359bc4bc3b794772a","inputEntryId":"user-turn-12013c8802186a7359bc4bc3b794772a-1","createdAt":1794279701811,"updatedAt":1794279701824,"generationStatus":"completed","relatedEntryId":null,"type":"effect","title":"file_system.read_file","detail":{"toolName":"file_system.read_file","display":{"summary":"Reading README.md","content":null,"suffix":"","verb":"Reading","message":"README.md","settledVerb":"Read","settledMessage":"README.md","statusText":"Reading file"},"kind":"file_read","input":{"filePath":"README.md","offset":null,"limit":2000}},"state":{"status":"completed","outputText":"","display":{"success":true,"verb":"Read","message":"16 lines from README.md","warnings":[],"approvalNote":null,"suffix":""},"approvalType":"always","decision":"execute","approvalSource":"bypass","output":{"filePath":"/private/tmp/h-y8ZX4u/README.md","content":"# pace-bot\n\nA coaching chat bot on Claude for a small running/cycling club. It is stateless\nby design: each message rebuilds the system prompt (coaching rules + the athlete's\nprofile, zones, goal and long-term facts from `data/athletes.json`), picks the tools\nthe message might need (`save_fact` and `log_session` always, planning or race tools\nwhen keywords match) and runs a short tool-use loop. `save_fact` is how the bot\nremembers durable things an athlete tells it; the next message sees the fact in\nits system prompt. Every API call appends its `usage` object to `logs/usage.jsonl`.\n\nRun it locally with `COACH_ANTHROPIC_KEY=sk-ant-... python3 bot.py 42` and type\nmessages on stdin (the Telegram long-polling transport, which needs\n`COACH_TELEGRAM_TOKEN`, lives in a separate deploy repo and just calls `reply()`).\nRequires Python 3.11+ and `pip install anthropic`. Prompt caching is on: the system\nprompt carries a `cache_control` marker so the tool-loop rounds and follow-up\nmessages inside the 5-minute window read it from cache.\n","numLines":16,"startLine":1,"requestedOffset":null,"requestedLimit":2000,"totalLines":null,"wasTruncated":false},"durationMs":0.0}}
{"id":"effect-72b7d22a-cfe0-54f5-9715-a758db294259","sessionId":"56346167-22f2-dec6-ab02-5543827309b4","turnId":"turn-12013c8802186a7359bc4bc3b794772a","inputEntryId":"user-turn-12013c8802186a7359bc4bc3b794772a-1","createdAt":1794279703500,"updatedAt":1794279703505,"generationStatus":"completed","relatedEntryId":null,"type":"effect","title":"file_system.read_file","detail":{"toolName":"file_system.read_file","display":{"summary":"Reading NOTES.md","content":null,"suffix":"","verb":"Reading","message":"NOTES.md","settledVerb":"Read","settledMessage":"NOTES.md","statusText":"Reading file"},"kind":"file_read","input":{"filePath":"NOTES.md","offset":null,"limit":2000}},"state":{"status":"completed","outputText":"","display":{"success":true,"verb":"Read","message":"14 lines from NOTES.md","warnings":[],"approvalNote":null,"suffix":""},"approvalType":"always","decision":"execute","approvalSource":"bypass","output":{"filePath":"/private/tmp/h-y8ZX4u/NOTES.md","content":"# Notes\n\n## 2026-04-20 — bill doubled since memory shipped\n\nInput spend roughly doubled in the week after `save_fact` went live (2026-04-13),\nwith the same number of messages per day. `logs/usage.jsonl` shows it: on a normal\nmessage the loop rounds and the next message read ~1000 tokens from cache, but\nevery call right after a `save_fact` has `cache_read_input_tokens: 0` and\n`cache_creation_input_tokens` ~1000 again. Athletes tell the bot things about\nthemselves a lot in their first week, so this happens several times per chat.\n\nTried: shorter facts (no change), capping facts at 20 (no change, the number of\nfacts is not the problem). Tool filtering by keyword is from March and was a clear\nwin (~75% fewer tool tokens on short messages); leave it.\n","numLines":14,"startLine":1,"requestedOffset":null,"requestedLimit":2000,"totalLines":null,"wasTruncated":false},"durationMs":0.0}}
{"id":"assistant-10ad7cea-621d-5abb-9072-502b93e767d2","sessionId":"56346167-22f2-dec6-ab02-5543827309b4","turnId":"turn-12013c8802186a7359bc4bc3b794772a","inputEntryId":"user-turn-12013c8802186a7359bc4bc3b794772a-1","createdAt":1794279706694,"updatedAt":1794279706694,"generationStatus":"completed","relatedEntryId":null,"type":"message","role":"assistant","content":[{"type":"text","text":"Now I have a clear understanding. The issue is in the `build_system()` function which creates a single text block. I need to split it into two blocks:\n1. Static instructions (INSTRUCTIONS) - never changes\n2. Volatile athlete context (date, profile, facts, etc.) - changes with save_fact\n\nLet me create the fix:"}],"source":"harness","userDisplayContent":null,"outcome":{"type":"committed"}}
{"id":"effect-f87f4bc4-2d87-577d-b513-d3a07fbea67a","sessionId":"56346167-22f2-dec6-ab02-5543827309b4","turnId":"turn-12013c8802186a7359bc4bc3b794772a","inputEntryId":"user-turn-12013c8802186a7359bc4bc3b794772a-1","createdAt":1794279706699,"updatedAt":1794279706711,"generationStatus":"completed","relatedEntryId":null,"type":"effect","title":"file_system.edit","detail":{"toolName":"file_system.edit","display":{"summary":"Editing bot.py","content":null,"suffix":"","verb":"Editing","message":"bot.py","settledVerb":"Edited","settledMessage":"bot.py","statusText":"Editing file"},"kind":"file_edit","input":{"filePath":"bot.py","oldString":"def build_system(a, today):\n    # One block, cached as a whole: instructions + per-athlete context.\n    text = INSTRUCTIONS + \"\\n\\n\" + athlete_context(a, today)\n    return [{\"type\": \"text\", \"text\": text, \"cache_control\": {\"type\": \"ephemeral\"}}]","newString":"def build_system(a, today):\n    # Split into two blocks so that save_fact only invalidates the volatile tail.\n    # The static INSTRUCTIONS never change and stay cached across memory writes.\n    # The athlete context (date, profile, facts) is volatile and changes with save_fact.\n    return [\n        {\"type\": \"text\", \"text\": INSTRUCTIONS, \"cache_control\": {\"type\": \"ephemeral\"}},\n        {\"type\": \"text\", \"text\": athlete_context(a, today), \"cache_control\": {\"type\": \"ephemeral\"}},\n    ]","replaceAll":false}},"state":{"status":"completed","outputText":"","display":{"success":true,"verb":"Edited","message":"bot.py","warnings":[],"approvalNote":null,"suffix":""},"approvalType":"always","decision":"execute","approvalSource":"bypass","output":{"file":"/private/tmp/h-y8ZX4u/bot.py","oldString":null,"newString":null,"occurrences":[{"startLine":130,"newStartLine":130,"oldText":"def build_system(a, today):\n    # One block, cached as a whole: instructions + per-athlete context.\n    text = INSTRUCTIONS + \"\\n\\n\" + athlete_context(a, today)\n    return [{\"type\": \"text\", \"text\": text, \"cache_control\": {\"type\": \"ephemeral\"}}]","newText":"def build_system(a, today):\n    # Split into two blocks so that save_fact only invalidates the volatile tail.\n    # The static INSTRUCTIONS never change and stay cached across memory writes.\n    # The athlete context (date, profile, facts) is volatile and changes with save_fact.\n    return [\n        {\"type\": \"text\", \"text\": INSTRUCTIONS, \"cache_control\": {\"type\": \"ephemeral\"}},\n        {\"type\": \"text\", \"text\": athlete_context(a, today), \"cache_control\": {\"type\": \"ephemeral\"}},\n    ]"}],"previousContent":"\"\"\"Coach bot: a stateless endurance-coaching chat on Claude.\n\nEvery incoming message is a fresh request: we rebuild the system prompt from\nthe athlete record, pick the tools the message might need, and run a short\ntool-use loop. Nothing is kept between messages except what is written to\ndata/athletes.json (the athlete's profile and long-term facts).\n\"\"\"\nimport json\nimport os\nimport sys\nimport datetime as dt\nfrom dataclasses import dataclass, field, asdict\n\nMODEL = \"claude-sonnet-4-5\"\nMAX_TOKENS = 700\nMAX_TOOL_ROUNDS = 5\nATHLETES_FILE = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"data\", \"athletes.json\")\nUSAGE_LOG = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"logs\", \"usage.jsonl\")\n\n# --------------------------------------------------------------------------- LLM\ntry:\n    import anthropic\n\n    class LLM:\n        \"\"\"Thin wrapper so the rest of the file reads the same with or without the SDK.\"\"\"\n        def __init__(self):\n            self._client = anthropic.Anthropic(api_key=os.environ[\"COACH_ANTHROPIC_KEY\"])\n\n        def create(self, **kw):\n            return self._client.messages.create(**kw)\nexcept ImportError:  # the code is readable and importable without the SDK\n    class LLM:\n        def __init__(self):\n            raise RuntimeError(\"anthropic SDK not installed: pip install anthropic\")\n\n        def create(self, **kw):\n            raise RuntimeError(\"anthropic SDK not installed\")\n\n# --------------------------------------------------------------------------- athlete record\n@dataclass\nclass Athlete:\n    user_id: str\n    name: str\n    lang: str = \"en\"\n    sport: str = \"running\"\n    goal: str = \"finish a half marathon\"\n    zones: dict = field(default_factory=lambda: {\"Z1\": \"<135\", \"Z2\": \"135-150\", \"Z3\": \"150-162\", \"Z4\": \"162-172\", \"Z5\": \">172\"})\n    facts: list = field(default_factory=list)   # long-term memory, grows via save_fact\n\n\ndef _load_all():\n    try:\n        with open(ATHLETES_FILE) as f:\n            return json.load(f)\n    except FileNotFoundError:\n        return {}\n\n\ndef load_athlete(user_id):\n    raw = _load_all().get(str(user_id))\n    if raw is None:\n        return Athlete(user_id=str(user_id), name=\"athlete\")\n    return Athlete(**raw)\n\n\ndef save_athlete(a):\n    allrec = _load_all()\n    allrec[a.user_id] = asdict(a)\n    os.makedirs(os.path.dirname(ATHLETES_FILE), exist_ok=True)\n    with open(ATHLETES_FILE, \"w\") as f:\n        json.dump(allrec, f, indent=1, ensure_ascii=False)\n\n# --------------------------------------------------------------------------- system prompt\nINSTRUCTIONS = \"\"\"You are Pace, an endurance coach for recreational runners and cyclists.\n\nCoaching rules:\n1. Answer the question that was asked before adding anything else.\n2. Keep replies short: a chat message, not an article. Three paragraphs at most.\n3. Prescribe training by heart-rate zone or RPE, never by pace, unless the athlete asks for pace.\n4. Use the athlete's own zones from the profile below; never invent zone boundaries.\n5. Easy days are easy: anything labelled recovery or Z1/Z2 must stay there.\n6. Never add more than 10% weekly volume over the previous week.\n7. One hard session per week for beginners, two for athletes with 3+ years of training.\n8. A rest day is a session. Do not fill it.\n9. If the athlete reports pain (not soreness) lasting more than two days, stop the plan and say to see a physio.\n10. Do not diagnose injuries or illness. Do not give medication advice.\n11. Fuelling: 30-60 g carbs per hour for sessions over 75 minutes; mention it only when relevant.\n12. Sleep and stress count as training load. Ask about them when the athlete looks flat.\n13. Before a goal race, the last hard session is 7-10 days out. Taper means less volume, same intensity.\n14. Do not change the athlete's goal unless they ask. Mention the goal when a question is clearly off-plan.\n15. When the athlete tells you something durable about themselves (injury history, schedule, preferences,\n    equipment, races booked), call save_fact once with a single sentence. Do not save moods or one-off plans.\n16. Do not save a fact that is already in the list below.\n17. Use the plan_week tool for any weekly structure; do not write a week by hand.\n18. Use log_session when the athlete reports a completed workout, then comment on it.\n19. If asked for numbers you do not have (recent volume, last race), ask one question, do not guess.\n20. Metric units unless the profile says otherwise.\n\nTone:\n- Warm, direct, no exclamation marks.\n- No motivational quotes.\n- Address the athlete by first name at most once per reply.\n- Reply in the athlete's language from the profile below, even if they write in another language.\n\nSafety:\n- Never advise training through chest pain, dizziness or fever.\n- Minors: refer to a coach in person.\n- If someone asks for weight-loss plans below 1500 kcal per day, decline and suggest a dietitian.\n\nFormatting:\n- Plain text. No markdown headings, no tables.\n- Lists only for a session structure (warm-up / main / cool-down).\n- Numbers with units: 45 min, 12 km, 150 bpm.\n\"\"\"\n\n\ndef athlete_context(a, today):\n    lines = [\n        f\"Today: {today.isoformat()} ({today.strftime('%A')})\",\n        f\"Athlete: {a.name} (id {a.user_id}), sport: {a.sport}\",\n        \"Zones: \" + \", \".join(f\"{k} {v}\" for k, v in a.zones.items()),\n        f\"Goal: {a.goal}\",\n        \"Long-term facts:\",\n    ]\n    lines += [f\"- {f}\" for f in a.facts] or [\"- (none yet)\"]\n    lines.append(f\"Language: {a.lang}\")\n    return \"\\n\".join(lines)\n\n\ndef build_system(a, today):\n    # One block, cached as a whole: instructions + per-athlete context.\n    text = INSTRUCTIONS + \"\\n\\n\" + athlete_context(a, today)\n    return [{\"type\": \"text\", \"text\": text, \"cache_control\": {\"type\": \"ephemeral\"}}]\n\n# --------------------------------------------------------------------------- tools\nCORE_TOOLS = [\n    {\"name\": \"save_fact\", \"description\": \"Remember one durable fact about the athlete.\",\n     \"input_schema\": {\"type\": \"object\", \"properties\": {\"fact\": {\"type\": \"string\"}}, \"required\": [\"fact\"]}},\n    {\"name\": \"log_session\", \"description\": \"Record a completed workout.\",\n     \"input_schema\": {\"type\": \"object\", \"properties\": {\"minutes\": {\"type\": \"integer\"}, \"rpe\": {\"type\": \"integer\"},\n                                                       \"note\": {\"type\": \"string\"}}, \"required\": [\"minutes\"]}},\n]\nTOOL_GROUPS = {\n    \"plan\": ((\"plan\", \"week\", \"schedule\", \"taper\", \"build\"), [\n        {\"name\": \"plan_week\", \"description\": \"Draft a week of sessions.\",\n         \"input_schema\": {\"type\": \"object\", \"properties\": {\"hours\": {\"type\": \"number\"}, \"hard_days\": {\"type\": \"integer\"}},\n                          \"required\": [\"hours\"]}}]),\n    \"race\": ((\"race\", \"pace\", \"predict\", \"finish time\"), [\n        {\"name\": \"predict_race\", \"description\": \"Estimate a finish time from a recent effort.\",\n         \"input_schema\": {\"type\": \"object\", \"properties\": {\"distance_km\": {\"type\": \"number\"}, \"recent_minutes\": {\"type\": \"number\"}},\n                          \"required\": [\"distance_km\"]}}]),\n}\n\n\ndef select_tools(text):\n    \"\"\"Core tools always; a group is added only when the message mentions its keywords.\"\"\"\n    tools = list(CORE_TOOLS)\n    low = text.lower()\n    for _, (keys, group) in TOOL_GROUPS.items():\n        if any(k in low for k in keys):\n            tools += group\n    return tools\n\n\ndef run_tool(a, name, args):\n    if name == \"save_fact\":\n        a.facts.append(args[\"fact\"].strip())\n        save_athlete(a)\n        return \"saved\"\n    if name == \"log_session\":\n        return f\"logged {args.get('minutes')} min\"\n    if name == \"plan_week\":\n        return json.dumps({\"hours\": args[\"hours\"], \"hard_days\": args.get(\"hard_days\", 1), \"sessions\": [\"Mon rest\", \"Tue Z2 45 min\", \"...\"]})\n    if name == \"predict_race\":\n        return json.dumps({\"distance_km\": args[\"distance_km\"], \"estimate_min\": round(args.get(\"recent_minutes\", 50) * 2.1)})\n    return f\"unknown tool {name}\"\n\n# --------------------------------------------------------------------------- the per-message loop\ndef log_usage(usage, user_id, round_no, tool=None):\n    rec = {\"ts\": dt.datetime.now(dt.timezone.utc).isoformat(timespec=\"seconds\"), \"user\": user_id, \"round\": round_no,\n           \"input_tokens\": usage.input_tokens, \"cache_creation_input_tokens\": usage.cache_creation_input_tokens,\n           \"cache_read_input_tokens\": usage.cache_read_input_tokens, \"output_tokens\": usage.output_tokens}\n    if tool:\n        rec[\"tool\"] = tool\n    os.makedirs(os.path.dirname(USAGE_LOG), exist_ok=True)\n    with open(USAGE_LOG, \"a\") as f:\n        f.write(json.dumps(rec) + \"\\n\")\n\n\ndef build_request(a, messages, tools, today):\n    return {\"model\": MODEL, \"max_tokens\": MAX_TOKENS, \"system\": build_system(a, today), \"tools\": tools, \"messages\": messages}\n\n\ndef reply(user_id, text, llm=None):\n    llm = llm or LLM()\n    a = load_athlete(user_id)\n    today = dt.date.today()\n    tools = select_tools(text)\n    messages = [{\"role\": \"user\", \"content\": text}]\n    for round_no in range(1, MAX_TOOL_ROUNDS + 1):\n        resp = llm.create(**build_request(a, messages, tools, today))\n        used_tools = [b.name for b in resp.content if b.type == \"tool_use\"]\n        log_usage(resp.usage, a.user_id, round_no, tool=\",\".join(used_tools) or None)\n        if resp.stop_reason != \"tool_use\":\n            return \"\".join(b.text for b in resp.content if b.type == \"text\")\n        messages.append({\"role\": \"assistant\", \"content\": [b.model_dump() for b in resp.content]})\n        results = [{\"type\": \"tool_result\", \"tool_use_id\": b.id, \"content\": run_tool(a, b.name, b.input)}\n                   for b in resp.content if b.type == \"tool_use\"]\n        messages.append({\"role\": \"user\", \"content\": results})\n    return \"Sorry, I lost the thread. Ask me again?\"\n\n\nif __name__ == \"__main__\":\n    # Local chat: python3 bot.py <user_id>; Telegram long-polling lives in telegram.py (not in this repo).\n    uid = sys.argv[1] if len(sys.argv) > 1 else \"42\"\n    for line in sys.stdin:\n        print(reply(uid, line.strip()))\n"},"durationMs":0.0}}
