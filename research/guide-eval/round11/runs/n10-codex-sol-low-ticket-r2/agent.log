{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc 'cat src/prisma/contract.prisma; cat src/prisma/db.ts; cat prisma.config.ts'","aggregated_output":"// use prisma-8\n\nmodel User {\n  id        Int                @id @default(autoincrement())\n  email     String             @unique\n  username  String?\n  name      String?\n  posts     Post[]\n  createdAt DateTime           @default(now()) @onCreate(now())\n  updatedAt temporal.UpdatedAt\n}\n\nmodel Post {\n  id        Int                @id @default(autoincrement())\n  title     String\n  content   String?\n  author    User               @relation(fields: [authorId], references: [id])\n  authorId  Int\n  createdAt DateTime           @default(now()) @onCreate(now())\n  updatedAt temporal.UpdatedAt\n}\nimport 'dotenv/config';\nimport postgres from '@prisma/orm-postgres/runtime';\nimport { contractFromJson } from '@prisma/orm-postgres/static';\nimport type { Contract } from './contract.d';\nimport contractJson from './contract.json' with { type: 'json' };\n\nexport const contract = contractFromJson<Contract>(contractJson);\n\nexport const db = postgres({\n  contract,\n  url: process.env['DATABASE_URL']!,\n});\nimport 'dotenv/config';\nimport { definePrismaConfig } from '@prisma/cli-engine';\nimport { defineConfig as ormConfig } from '@prisma/orm-postgres/config';\n\nexport default definePrismaConfig({\n  orm: ormConfig({\n    contract: \"./src/prisma/contract.prisma\",\n    db: {\n      connection: process.env['DATABASE_URL']!,\n    },\n  }),\n});\n","exit_code":0,"status":"completed"}}
