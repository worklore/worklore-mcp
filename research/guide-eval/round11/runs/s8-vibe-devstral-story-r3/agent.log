kens\": 0, \"output_tokens\": 161}\n{\"ts\": \"2026-04-18T08:04:26+00:00\", \"user\": \"42\", \"round\": 1, \"input_tokens\": 23, \"cache_creation_input_tokens\": 0, \"cache_read_input_tokens\": 1090, \"output_tokens\": 79}\n{\"ts\": \"2026-04-18T08:04:56+00:00\", \"user\": \"42\", \"round\": 1, \"input_tokens\": 61, \"cache_creation_input_tokens\": 0, \"cache_read_input_tokens\": 1090, \"output_tokens\": 41, \"tool\": \"save_fact\"}\n{\"ts\": \"2026-04-18T08:05:39+00:00\", \"user\": \"42\", \"round\": 2, \"input_tokens\": 139, \"cache_creation_input_tokens\": 1104, \"cache_read_input_tokens\": 0, \"output_tokens\": 155}\n{\"ts\": \"2026-04-18T08:05:54+00:00\", \"user\": \"42\", \"round\": 1, \"input_tokens\": 26, \"cache_creation_input_tokens\": 0, \"cache_read_input_tokens\": 1104, \"output_tokens\": 93}\n","numLines":30,"startLine":1,"requestedOffset":null,"requestedLimit":2000,"totalLines":null,"wasTruncated":false},"display":{"success":true,"verb":"Read","message":"30 lines from logs/usage.jsonl","warnings":[],"approvalNote":null,"suffix":""},"approvalSource":"bypass","approvalType":"always","decision":"execute"}}
{"id":"assistant-0c097574-7f11-5efd-a28a-10dfadb86e97","sessionId":"09b651a3-f92e-427e-d2f3-3d48b743c26e","turnId":"turn-be9b7f2ed0553ed6bb0de830ba168f0e","inputEntryId":"user-turn-be9b7f2ed0553ed6bb0de830ba168f0e-1","createdAt":1794279598480,"updatedAt":1794279598480,"generationStatus":"completed","relatedEntryId":null,"type":"message","role":"assistant","content":[{"type":"text","text":"I can see the problem clearly in the usage logs. When `save_fact` is called, the `cache_creation_input_tokens` jumps to the full prompt size (1046, 1061, 1075, etc.) and `cache_read_input_tokens` drops to 0, meaning the entire system prompt is being re-cached instead of just the volatile tail.\n\nLet me explore the codebase to find where the system prompt is assembled."}],"source":"harness","userDisplayContent":null,"outcome":{"type":"committed"}}
{"id":"effect-1662bf11-2b7f-55cf-bf61-2b9936bbca14","sessionId":"09b651a3-f92e-427e-d2f3-3d48b743c26e","turnId":"turn-be9b7f2ed0553ed6bb0de830ba168f0e","inputEntryId":"user-turn-be9b7f2ed0553ed6bb0de830ba168f0e-1","createdAt":1794279598484,"updatedAt":1794279598518,"generationStatus":"completed","relatedEntryId":null,"type":"effect","title":"file_system.bash","detail":{"toolName":"file_system.bash","display":{"summary":"bash: find /private/tmp/h-pqrLNX -type f \\( -name \"*.ts\" -o -name \"*.js\" -o -name \"*.py\" \\) | head -20","content":null,"suffix":"","verb":"Running","message":"find /private/tmp/h-pqrLNX -type f \\( -name \"*.ts\" -o -name \"*.js\" -o -name \"*.py\" \\) | head -20","settledVerb":"Ran","settledMessage":"find /private/tmp/h-pqrLNX -type f \\( -name \"*.ts\" -o -name \"*.js\" -o -name \"*.py\" \\) | head -20","statusText":"Running command"},"kind":"shell","input":{"command":"find /private/tmp/h-pqrLNX -type f \\( -name \"*.ts\" -o -name \"*.js\" -o -name \"*.py\" \\) | head -20"}},"state":{"status":"completed","outputText":"/private/tmp/h-pqrLNX/bot.py\n","durationMs":0.0,"output":{"stdout":"/private/tmp/h-pqrLNX/bot.py\n","stderr":"","output":"","truncated":false},"display":{"success":true,"verb":"Ran","message":"find /private/tmp/h-pqrLNX -type f \\( -name \"*.ts\" -o -name \"*.js\" -o -name \"*.py\" \\) | head -20","warnings":[],"approvalNote":null,"suffix":""},"approvalSource":"bypass","approvalType":"always","decision":"execute"}}
{"id":"effect-ae61444f-bd22-55fd-bcbc-d830ca512553","sessionId":"09b651a3-f92e-427e-d2f3-3d48b743c26e","turnId":"turn-be9b7f2ed0553ed6bb0de830ba168f0e","inputEntryId":"user-turn-be9b7f2ed0553ed6bb0de830ba168f0e-1","createdAt":1794279599975,"updatedAt":1794279599983,"generationStatus":"completed","relatedEntryId":null,"type":"effect","title":"file_system.read_file","detail":{"toolName":"file_system.read_file","display":{"summary":"Reading bot.py","content":null,"suffix":"","verb":"Reading","message":"bot.py","settledVerb":"Read","settledMessage":"bot.py","statusText":"Reading file"},"kind":"file_read","input":{"filePath":"bot.py","offset":null,"limit":2000}},"state":{"status":"completed","outputText":"","durationMs":0.0,"output":{"filePath":"/private/tmp/h-pqrLNX/bot.py","content":"\"\"\"Coach bot: a stateless endurance-coaching chat on Claude.\n\nEvery incoming message is a fresh request: we rebuild the system prompt from\nthe athlete record, pick the tools the message might need, and run a short\ntool-use loop. Nothing is kept between messages except what is written to\ndata/athletes.json (the athlete's profile and long-term facts).\n\"\"\"\nimport json\nimport os\nimport sys\nimport datetime as dt\nfrom dataclasses import dataclass, field, asdict\n\nMODEL = \"claude-sonnet-4-5\"\nMAX_TOKENS = 700\nMAX_TOOL_ROUNDS = 5\nATHLETES_FILE = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"data\", \"athletes.json\")\nUSAGE_LOG = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"logs\", \"usage.jsonl\")\n\n# --------------------------------------------------------------------------- LLM\ntry:\n    import anthropic\n\n    class LLM:\n        \"\"\"Thin wrapper so the rest of the file reads the same with or without the SDK.\"\"\"\n        def __init__(self):\n            self._client = anthropic.Anthropic(api_key=os.environ[\"COACH_ANTHROPIC_KEY\"])\n\n        def create(self, **kw):\n            return self._client.messages.create(**kw)\nexcept ImportError:  # the code is readable and importable without the SDK\n    class LLM:\n        def __init__(self):\n            raise RuntimeError(\"anthropic SDK not installed: pip install anthropic\")\n\n        def create(self, **kw):\n            raise RuntimeError(\"anthropic SDK not installed\")\n\n# --------------------------------------------------------------------------- athlete record\n@dataclass\nclass Athlete:\n    user_id: str\n    name: str\n    lang: str = \"en\"\n    sport: str = \"running\"\n    goal: str = \"finish a half marathon\"\n    zones: dict = field(default_factory=lambda: {\"Z1\": \"<135\", \"Z2\": \"135-150\", \"Z3\": \"150-162\", \"Z4\": \"162-172\", \"Z5\": \">172\"})\n    facts: list = field(default_factory=list)   # long-term memory, grows via save_fact\n\n\ndef _load_all():\n    try:\n        with open(ATHLETES_FILE) as f:\n            return json.load(f)\n    except FileNotFoundError:\n        return {}\n\n\ndef load_athlete(user_id):\n    raw = _load_all().get(str(user_id))\n    if raw is None:\n        return Athlete(user_id=str(user_id), name=\"athlete\")\n    return Athlete(**raw)\n\n\ndef save_athlete(a):\n    allrec = _load_all()\n    allrec[a.user_id] = asdict(a)\n    os.makedirs(os.path.dirname(ATHLETES_FILE), exist_ok=True)\n    with open(ATHLETES_FILE, \"w\") as f:\n        json.dump(allrec, f, indent=1, ensure_ascii=False)\n\n# --------------------------------------------------------------------------- system prompt\nINSTRUCTIONS = \"\"\"You are Pace, an endurance coach for recreational runners and cyclists.\n\nCoaching rules:\n1. Answer the question that was asked before adding anything else.\n2. Keep replies short: a chat message, not an article. Three paragraphs at most.\n3. Prescribe training by heart-rate zone or RPE, never by pace, unless the athlete asks for pace.\n4. Use the athlete's own zones from the profile below; never invent zone boundaries.\n5. Easy days are easy: anything labelled recovery or Z1/Z2 must stay there.\n6. Never add more than 10% weekly volume over the previous week.\n7. One hard session per week for beginners, two for athletes with 3+ years of training.\n8. A rest day is a session. Do not fill it.\n9. If the athlete reports pain (not soreness) lasting more than two days, stop the plan and say to see a physio.\n10. Do not diagnose injuries or illness. Do not give medication advice.\n11. Fuelling: 30-60 g carbs per hour for sessions over 75 minutes; mention it only when relevant.\n12. Sleep and stress count as training load. Ask about them when the athlete looks flat.\n13. Before a goal race, the last hard session is 7-10 days out. Taper means less volume, same intensity.\n14. Do not change the athlete's goal unless they ask. Mention the goal when a question is clearly off-plan.\n15. When the athlete tells you something durable about themselves (injury history, schedule, preferences,\n    equipment, races booked), call save_fact once with a single sentence. Do not save moods or one-off plans.\n16. Do not save a fact that is already in the list below.\n17. Use the plan_week tool for any weekly structure; do not write a week by hand.\n18. Use log_session when the athlete reports a completed workout, then comment on it.\n19. If asked for numbers you do not have (recent volume, last race), ask one question, do not guess.\n20. Metric units unless the profile says otherwise.\n\nTone:\n- Warm, direct, no exclamation marks.\n- No motivational quotes.\n- Address the athlete by first name at most once per reply.\n- Reply in the athlete's language from the profile below, even if they write in another language.\n\nSafety:\n- Never advise training through chest pain, dizziness or fever.\n- Minors: refer to a coach in person.\n- If someone asks for weight-loss plans below 1500 kcal per day, decline and suggest a dietitian.\n\nFormatting:\n- Plain text. No markdown headings, no tables.\n- Lists only for a session structure (warm-up / main / cool-down).\n- Numbers with units: 45 min, 12 km, 150 bpm.\n\"\"\"\n\n\ndef athlete_context(a, today):\n    lines = [\n        f\"Today: {today.isoformat()} ({today.strftime('%A')})\",\n        f\"Athlete: {a.name} (id {a.user_id}), sport: {a.sport}\",\n        \"Zones: \" + \", \".join(f\"{k} {v}\" for k, v in a.zones.items()),\n        f\"Goal: {a.goal}\",\n        \"Long-term facts:\",\n    ]\n    lines += [f\"- {f}\" for f in a.facts] or [\"- (none yet)\"]\n    lines.append(f\"Language: {a.lang}\")\n    return \"\\n\".join(lines)\n\n\ndef build_system(a, today):\n    # One block, cached as a whole: instructions + per-athlete context.\n    text = INSTRUCTIONS + \"\\n\\n\" + athlete_context(a, today)\n    return [{\"type\": \"text\", \"text\": text, \"cache_control\": {\"type\": \"ephemeral\"}}]\n\n# --------------------------------------------------------------------------- tools\nCORE_TOOLS = [\n    {\"name\": \"save_fact\", \"description\": \"Remember one durable fact about the athlete.\",\n     \"input_schema\": {\"type\": \"object\", \"properties\": {\"fact\": {\"type\": \"string\"}}, \"required\": [\"fact\"]}},\n    {\"name\": \"log_session\", \"description\": \"Record a completed workout.\",\n     \"input_schema\": {\"type\": \"object\", \"properties\": {\"minutes\": {\"type\": \"integer\"}, \"rpe\": {\"type\": \"integer\"},\n                                                       \"note\": {\"type\": \"string\"}}, \"required\": [\"minutes\"]}},\n]\nTOOL_GROUPS = {\n    \"plan\": ((\"plan\", \"week\", \"schedule\", \"taper\", \"build\"), [\n        {\"name\": \"plan_week\", \"description\": \"Draft a week of sessions.\",\n         \"input_schema\": {\"type\": \"object\", \"properties\": {\"hours\": {\"type\": \"number\"}, \"hard_days\": {\"type\": \"integer\"}},\n                          \"required\": [\"hours\"]}}]),\n    \"race\": ((\"race\", \"pace\", \"predict\", \"finish time\"), [\n        {\"name\": \"predict_race\", \"description\": \"Estimate a finish time from a recent effort.\",\n         \"input_schema\": {\"type\": \"object\", \"properties\": {\"distance_km\": {\"type\": \"number\"}, \"recent_minutes\": {\"type\": \"number\"}},\n                          \"required\": [\"distance_km\"]}}]),\n}\n\n\ndef select_tools(text):\n    \"\"\"Core tools always; a group is added only when the message mentions its keywords.\"\"\"\n    tools = list(CORE_TOOLS)\n    low = text.lower()\n    for _, (keys, group) in TOOL_GROUPS.items():\n        if any(k in low for k in keys):\n            tools += group\n    return tools\n\n\ndef run_tool(a, name, args):\n    if name == \"save_fact\":\n        a.facts.append(args[\"fact\"].strip())\n        save_athlete(a)\n        return \"saved\"\n    if name == \"log_session\":\n        return f\"logged {args.get('minutes')} min\"\n    if name == \"plan_week\":\n        return json.dumps({\"hours\": args[\"hours\"], \"hard_days\": args.get(\"hard_days\", 1), \"sessions\": [\"Mon rest\", \"Tue Z2 45 min\", \"...\"]})\n    if name == \"predict_race\":\n        return json.dumps({\"distance_km\": args[\"distance_km\"], \"estimate_min\": round(args.get(\"recent_minutes\", 50) * 2.1)})\n    return f\"unknown tool {name}\"\n\n# --------------------------------------------------------------------------- the per-message loop\ndef log_usage(usage, user_id, round_no, tool=None):\n    rec = {\"ts\": dt.datetime.now(dt.timezone.utc).isoformat(timespec=\"seconds\"), \"user\": user_id, \"round\": round_no,\n           \"input_tokens\": usage.input_tokens, \"cache_creation_input_tokens\": usage.cache_creation_input_tokens,\n           \"cache_read_input_tokens\": usage.cache_read_input_tokens, \"output_tokens\": usage.output_tokens}\n    if tool:\n        rec[\"tool\"] = tool\n    os.makedirs(os.path.dirname(USAGE_LOG), exist_ok=True)\n    with open(USAGE_LOG, \"a\") as f:\n        f.write(json.dumps(rec) + \"\\n\")\n\n\ndef build_request(a, messages, tools, today):\n    return {\"model\": MODEL, \"max_tokens\": MAX_TOKENS, \"system\": build_system(a, today), \"tools\": tools, \"messages\": messages}\n\n\ndef reply(user_id, text, llm=None):\n    llm = llm or LLM()\n    a = load_athlete(user_id)\n    today = dt.date.today()\n    tools = select_tools(text)\n    messages = [{\"role\": \"user\", \"content\": text}]\n    for round_no in range(1, MAX_TOOL_ROUNDS + 1):\n        resp = llm.create(**build_request(a, messages, tools, today))\n        used_tools = [b.name for b in resp.content if b.type == \"tool_use\"]\n        log_usage(resp.usage, a.user_id, round_no, tool=\",\".join(used_tools) or None)\n        if resp.stop_reason != \"tool_use\":\n            return \"\".join(b.text for b in resp.content if b.type == \"text\")\n        messages.append({\"role\": \"assistant\", \"content\": [b.model_dump() for b in resp.content]})\n        results = [{\"type\": \"tool_result\", \"tool_use_id\": b.id, \"content\": run_tool(a, b.name, b.input)}\n                   for b in resp.content if b.type == \"tool_use\"]\n        messages.append({\"role\": \"user\", \"content\": results})\n    return \"Sorry, I lost the thread. Ask me again?\"\n\n\nif __name__ == \"__main__\":\n    # Local chat: python3 bot.py <user_id>; Telegram long-polling lives in telegram.py (not in this repo).\n    uid = sys.argv[1] if len(sys.argv) > 1 else \"42\"\n    for line in sys.stdin:\n        print(reply(uid, line.strip()))\n","numLines":217,"startLine":1,"requestedOffset":null,"requestedLimit":2000,"totalLines":null,"wasTruncated":false},"display":{"success":true,"verb":"Read","message":"217 lines from bot.py","warnings":[],"approvalNote":null,"suffix":""},"approvalSource":"bypass","approvalType":"always","decision":"execute"}}
{"id":"assistant-44b62f68-f8d1-5a63-a41e-ec2aa4641656","sessionId":"09b651a3-f92e-427e-d2f3-3d48b743c26e","turnId":"turn-be9b7f2ed0553ed6bb0de830ba168f0e","inputEntryId":"user-turn-be9b7f2ed0553ed6bb0de830ba168f0e-1","createdAt":1794279602711,"updatedAt":1794279602711,"generationStatus":"completed","relatedEntryId":null,"type":"message","role":"assistant","content":[{"type":"text","text":"Now I can see the issue clearly. The `build_system` function creates a single text block with `cache_control: ephemeral` that combines both the static `INSTRUCTIONS` and the volatile `athlete_context(a, today)`. When `save_fact` modifies the athlete's facts, the entire system prompt changes, invalidating the entire cache.\n\nThe fix is to split this into two separate cache-controlled blocks as described in the colleague's note. Let me also check the data file to understand the structure better:"}],"source":"harness","userDisplayContent":null,"outcome":{"type":"committed"}}
{"id":"effect-82ac0c50-8c23-5930-8e22-24fbb5b8a479","sessionId":"09b651a3-f92e-427e-d2f3-3d48b743c26e","turnId":"turn-be9b7f2ed0553ed6bb0de830ba168f0e","inputEntryId":"user-turn-be9b7f2ed0553ed6bb0de830ba168f0e-1","createdAt":1794279602724,"updatedAt":1794279602744,"generationStatus":"completed","relatedEntryId":null,"type":"effect","title":"file_system.read_file","detail":{"toolName":"file_system.read_file","display":{"summary":"Reading data/athletes.json","content":null,"suffix":"","verb":"Reading","message":"data/athletes.json","settledVerb":"Read","settledMessage":"data/athletes.json","statusText":"Reading file"},"kind":"file_read","input":{"filePath":"data/athletes.json","offset":null,"limit":2000}},"state":{"status":"completed","outputText":"","durationMs":0.0,"output":{"filePath":"/private/tmp/h-pqrLNX/data/athletes.json","content":"{\n \"42\": {\"user_id\": \"42\", \"name\": \"Marta\", \"lang\": \"en\", \"sport\": \"running\", \"goal\": \"sub-1:55 half marathon in June\",\n        \"zones\": {\"Z1\": \"<138\", \"Z2\": \"138-152\", \"Z3\": \"152-164\", \"Z4\": \"164-174\", \"Z5\": \">174\"},\n        \"facts\": [\"Runs before work, 06:30, Mon/Wed/Fri\", \"Left achilles tendinopathy in 2024, fully recovered\", \"Owns a Garmin 255\"]},\n \"77\": {\"user_id\": \"77\", \"name\": \"Jonas\", \"lang\": \"de\", \"sport\": \"cycling\", \"goal\": \"finish a 160 km gran fondo in September\",\n        \"zones\": {\"Z1\": \"<130\", \"Z2\": \"130-146\", \"Z3\": \"146-158\", \"Z4\": \"158-168\", \"Z5\": \">168\"},\n        \"facts\": [\"Commutes by bike 2x15 km daily\", \"Has a smart trainer at home\"]}\n}\n","numLines":8,"startLine":1,"requestedOffset":null,"requestedLimit":2000,"totalLines":null,"wasTruncated":false},"display":{"success":true,"verb":"Read","message":"8 lines from data/athletes.json","warnings":[],"approvalNote":null,"suffix":""},"approvalSource":"bypass","approvalType":"always","decision":"execute"}}
{"id":"assistant-2e2b13ca-3464-587b-ba65-b9293f4ddd03","sessionId":"09b651a3-f92e-427e-d2f3-3d48b743c26e","turnId":"turn-be9b7f2ed0553ed6bb0de830ba168f0e","inputEntryId":"user-turn-be9b7f2ed0553ed6bb0de830ba168f0e-1","createdAt":1794279609259,"updatedAt":1794279609259,"generationStatus":"completed","relatedEntryId":null,"type":"message","role":"assistant","content":[{"type":"text","text":"Perfect. Now I understand the complete picture. The issue is in the `build_system` function which creates a single cache block. I need to split it into two separate cache-controlled blocks:\n\n1. **Static block**: The `INSTRUCTIONS` which never changes\n2. **Volatile block**: The `athlete_context(a, today)` which includes facts that change with `save_fact`\n\nLet me implement the fix:"}],"source":"harness","userDisplayContent":null,"outcome":{"type":"committed"}}
{"id":"effect-5f6cf678-1dbc-532d-ad33-546ff87c0634","sessionId":"09b651a3-f92e-427e-d2f3-3d48b743c26e","turnId":"turn-be9b7f2ed0553ed6bb0de830ba168f0e","inputEntryId":"user-turn-be9b7f2ed0553ed6bb0de830ba168f0e-1","createdAt":1794279609264,"updatedAt":1794279609278,"generationStatus":"completed","relatedEntryId":null,"type":"effect","title":"file_system.edit","detail":{"toolName":"file_system.edit","display":{"summary":"Editing bot.py","content":null,"suffix":"","verb":"Editing","message":"bot.py","settledVerb":"Edited","settledMessage":"bot.py","statusText":"Editing file"},"kind":"file_edit","input":{"filePath":"bot.py","oldString":"def build_system(a, today):\n    # One block, cached as a whole: instructions + per-athlete context.\n    text = INSTRUCTIONS + \"\\n\\n\" + athlete_context(a, today)\n    return [{\"type\": \"text\", \"text\": text, \"cache_control\": {\"type\": \"ephemeral\"}}]","newString":"def build_system(a, today):\n    # Two cache-controlled blocks so memory writes don't evict the static instructions.\n    # Block 1: static instructions (byte-identical across users and days).\n    # Block 2: per-user volatile data (date, profile, zones, goal, facts, language).\n    return [\n        {\"type\": \"text\", \"text\": INSTRUCTIONS, \"cache_control\": {\"type\": \"ephemeral\"}},\n        {\"type\": \"text\", \"text\": athlete_context(a, today), \"cache_control\": {\"type\": \"ephemeral\"}},\n    ]","replaceAll":false}},"state":{"status":"completed","outputText":"","durationMs":0.0,"output":{"file":"/private/tmp/h-pqrLNX/bot.py","oldString":null,"newString":null,"occurrences":[{"startLine":130,"newStartLine":130,"oldText":"def build_system(a, today):\n    # One block, cached as a whole: instructions + per-athlete context.\n    text = INSTRUCTIONS + \"\\n\\n\" + athlete_context(a, today)\n    return [{\"type\": \"text\", \"text\": text, \"cache_control\": {\"type\": \"ephemeral\"}}]","newText":"def build_system(a, today):\n    # Two cache-controlled blocks so memory writes don't evict the static instructions.\n    # Block 1: static instructions (byte-identical across users and days).\n    # Block 2: per-user volatile data (date, profile, zones, goal, facts, language).\n    return [\n        {\"type\": \"text\", \"text\": INSTRUCTIONS, \"cache_control\": {\"type\": \"ephemeral\"}},\n        {\"type\": \"text\", \"text\": athlete_context(a, today), \"cache_control\": {\"type\": \"ephemeral\"}},\n    ]"}],"previousContent":"\"\"\"Coach bot: a stateless endurance-coaching chat on Claude.\n\nEvery incoming message is a fresh request: we rebuild the system prompt from\nthe athlete record, pick the tools the message might need, and run a short\ntool-use loop. Nothing is kept between messages except what is written to\ndata/athletes.json (the athlete's profile and long-term facts).\n\"\"\"\nimport json\nimport os\nimport sys\nimport datetime as dt\nfrom dataclasses import dataclass, field, asdict\n\nMODEL = \"claude-sonnet-4-5\"\nMAX_TOKENS = 700\nMAX_TOOL_ROUNDS = 5\nATHLETES_FILE = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"data\", \"athletes.json\")\nUSAGE_LOG = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"logs\", \"usage.jsonl\")\n\n# --------------------------------------------------------------------------- LLM\ntry:\n    import anthropic\n\n    class LLM:\n        \"\"\"Thin wrapper so the rest of the file reads the same with or without the SDK.\"\"\"\n        def __init__(self):\n            self._client = anthropic.Anthropic(api_key=os.environ[\"COACH_ANTHROPIC_KEY\"])\n\n        def create(self, **kw):\n            return self._client.messages.create(**kw)\nexcept ImportError:  # the code is readable and importable without the SDK\n    class LLM:\n        def __init__(self):\n            raise RuntimeError(\"anthropic SDK not installed: pip install anthropic\")\n\n        def create(self, **kw):\n            raise RuntimeError(\"anthropic SDK not installed\")\n\n# --------------------------------------------------------------------------- athlete record\n@dataclass\nclass Athlete:\n    user_id: str\n    name: str\n    lang: str = \"en\"\n    sport: str = \"running\"\n    goal: str = \"finish a half marathon\"\n    zones: dict = field(default_factory=lambda: {\"Z1\": \"<135\", \"Z2\": \"135-150\", \"Z3\": \"150-162\", \"Z4\": \"162-172\", \"Z5\": \">172\"})\n    facts: list = field(default_factory=list)   # long-term memory, grows via save_fact\n\n\ndef _load_all():\n    try:\n        with open(ATHLETES_FILE) as f:\n            return json.load(f)\n    except FileNotFoundError:\n        return {}\n\n\ndef load_athlete(user_id):\n    raw = _load_all().get(str(user_id))\n    if raw is None:\n        return Athlete(user_id=str(user_id), name=\"athlete\")\n    return Athlete(**raw)\n\n\ndef save_athlete(a):\n    allrec = _load_all()\n    allrec[a.user_id] = asdict(a)\n    os.makedirs(os.path.dirname(ATHLETES_FILE), exist_ok=True)\n    with open(ATHLETES_FILE, \"w\") as f:\n        json.dump(allrec, f, indent=1, ensure_ascii=False)\n\n# --------------------------------------------------------------------------- system prompt\nINSTRUCTIONS = \"\"\"You are Pace, an endurance coach for recreational runners and cyclists.\n\nCoaching rules:\n1. Answer the question that was asked before adding anything else.\n2. Keep replies short: a chat message, not an article. Three paragraphs at most.\n3. Prescribe training by heart-rate zone or RPE, never by pace, unless the athlete asks for pace.\n4. Use the athlete's own zones from the profile below; never invent zone boundaries.\n5. Easy days are easy: anything labelled recovery or Z1/Z2 must stay there.\n6. Never add more than 10% weekly volume over the previous week.\n7. One hard session per week for beginners, two for athletes with 3+ years of training.\n8. A rest day is a session. Do not fill it.\n9. If the athlete reports pain (not soreness) lasting more than two days, stop the plan and say to see a physio.\n10. Do not diagnose injuries or illness. Do not give medication advice.\n11. Fuelling: 30-60 g carbs per hour for sessions over 75 minutes; mention it only when relevant.\n12. Sleep and stress count as training load. Ask about them when the athlete looks flat.\n13. Before a goal race, the last hard session is 7-10 days out. Taper means less volume, same intensity.\n14. Do not change the athlete's goal unless they ask. Mention the goal when a question is clearly off-plan.\n15. When the athlete tells you something durable about themselves (injury history, schedule, preferences,\n    equipment, races booked), call save_fact once with a single sentence. Do not save moods or one-off plans.\n16. Do not save a fact that is already in the list below.\n17. Use the plan_week tool for any weekly structure; do not write a week by hand.\n18. Use log_session when the athlete reports a completed workout, then comment on it.\n19. If asked for numbers you do not have (recent volume, last race), ask one question, do not guess.\n20. Metric units unless the profile says otherwise.\n\nTone:\n- Warm, direct, no exclamation marks.\n- No motivational quotes.\n- Address the athlete by first name at most once per reply.\n- Reply in the athlete's language from the profile below, even if they write in another language.\n\nSafety:\n- Never advise training through chest pain, dizziness or fever.\n- Minors: refer to a coach in person.\n- If someone asks for weight-loss plans below 1500 kcal per day, decline and suggest a dietitian.\n\nFormatting:\n- Plain text. No markdown headings, no tables.\n- Lists only for a session structure (warm-up / main / cool-down).\n- Numbers with units: 45 min, 12 km, 150 bpm.\n\"\"\"\n\n\ndef athlete_context(a, today):\n    lines = [\n        f\"Today: {today.isoformat()} ({today.strftime('%A')})\",\n        f\"Athlete: {a.name} (id {a.user_id}), sport: {a.sport}\",\n        \"Zones: \" + \", \".join(f\"{k} {v}\" for k, v in a.zones.items()),\n        f\"Goal: {a.goal}\",\n        \"Long-term facts:\",\n    ]\n    lines += [f\"- {f}\" for f in a.facts] or [\"- (none yet)\"]\n    lines.append(f\"Language: {a.lang}\")\n    return \"\\n\".join(lines)\n\n\ndef build_system(a, today):\n    # One block, cached as a whole: instructions + per-athlete context.\n    text = INSTRUCTIONS + \"\\n\\n\" + athlete_context(a, today)\n    return [{\"type\": \"text\", \"text\": text, \"cache_control\": {\"type\": \"ephemeral\"}}]\n\n# --------------------------------------------------------------------------- tools\nCORE_TOOLS = [\n    {\"name\": \"save_fact\", \"description\": \"Remember one durable fact about the athlete.\",\n     \"input_schema\": {\"type\": \"object\", \"properties\": {\"fact\": {\"type\": \"string\"}}, \"required\": [\"fact\"]}},\n    {\"name\": \"log_session\", \"description\": \"Record a completed workout.\",\n     \"input_schema\": {\"type\": \"object\", \"properties\": {\"minutes\": {\"type\": \"integer\"}, \"rpe\": {\"type\": \"integer\"},\n                                                       \"note\": {\"type\": \"string\"}}, \"required\": [\"minutes\"]}},\n]\nTOOL_GROUPS = {\n    \"plan\": ((\"plan\", \"week\", \"schedule\", \"taper\", \"build\"), [\n        {\"name\": \"plan_week\", \"description\": \"Draft a week of sessions.\",\n         \"input_schema\": {\"type\": \"object\", \"properties\": {\"hours\": {\"type\": \"number\"}, \"hard_days\": {\"type\": \"integer\"}},\n                          \"required\": [\"hours\"]}}]),\n    \"race\": ((\"race\", \"pace\", \"predict\", \"finish time\"), [\n        {\"name\": \"predict_race\", \"description\": \"Estimate a finish time from a recent effort.\",\n         \"input_schema\": {\"type\": \"object\", \"properties\": {\"distance_km\": {\"type\": \"number\"}, \"recent_minutes\": {\"type\": \"number\"}},\n                          \"required\": [\"distance_km\"]}}]),\n}\n\n\ndef select_tools(text):\n    \"\"\"Core tools always; a group is added only when the message mentions its keywords.\"\"\"\n    tools = list(CORE_TOOLS)\n    low = text.lower()\n    for _, (keys, group) in TOOL_GROUPS.items():\n        if any(k in low for k in keys):\n            tools += group\n    return tools\n\n\ndef run_tool(a, name, args):\n    if name == \"save_fact\":\n        a.facts.append(args[\"fact\"].strip())\n        save_athlete(a)\n        return \"saved\"\n    if name == \"log_session\":\n        return f\"logged {args.get('minutes')} min\"\n    if name == \"plan_week\":\n        return json.dumps({\"hours\": args[\"hours\"], \"hard_days\": args.get(\"hard_days\", 1), \"sessions\": [\"Mon rest\", \"Tue Z2 45 min\", \"...\"]})\n    if name == \"predict_race\":\n        return json.dumps({\"distance_km\": args[\"distance_km\"], \"estimate_min\": round(args.get(\"recent_minutes\", 50) * 2.1)})\n    return f\"unknown tool {name}\"\n\n# --------------------------------------------------------------------------- the per-message loop\ndef log_usage(usage, user_id, round_no, tool=None):\n    rec = {\"ts\": dt.datetime.now(dt.timezone.utc).isoformat(timespec=\"seconds\"), \"user\": user_id, \"round\": round_no,\n           \"input_tokens\": usage.input_tokens, \"cache_creation_input_tokens\": usage.cache_creation_input_tokens,\n           \"cache_read_input_tokens\": usage.cache_read_input_tokens, \"output_tokens\": usage.output_tokens}\n    if tool:\n        rec[\"tool\"] = tool\n    os.makedirs(os.path.dirname(USAGE_LOG), exist_ok=True)\n    with open(USAGE_LOG, \"a\") as f:\n        f.write(json.dumps(rec) + \"\\n\")\n\n\ndef build_request(a, messages, tools, today):\n    return {\"model\": MODEL, \"max_tokens\": MAX_TOKENS, \"system\": build_system(a, today), \"tools\": tools, \"messages\": messages}\n\n\ndef reply(user_id, text, llm=None):\n    llm = llm or LLM()\n    a = load_athlete(user_id)\n    today = dt.date.today()\n    tools = select_tools(text)\n    messages = [{\"role\": \"user\", \"content\": text}]\n    for round_no in range(1, MAX_TOOL_ROUNDS + 1):\n        resp = llm.create(**build_request(a, messages, tools, today))\n        used_tools = [b.name for b in resp.content if b.type == \"tool_use\"]\n        log_usage(resp.usage, a.user_id, round_no, tool=\",\".join(used_tools) or None)\n        if resp.stop_reason != \"tool_use\":\n            return \"\".join(b.text for b in resp.content if b.type == \"text\")\n        messages.append({\"role\": \"assistant\", \"content\": [b.model_dump() for b in resp.content]})\n        results = [{\"type\": \"tool_result\", \"tool_use_id\": b.id, \"content\": run_tool(a, b.name, b.input)}\n                   for b in resp.content if b.type == \"tool_use\"]\n        messages.append({\"role\": \"user\", \"content\": results})\n    return \"Sorry, I lost the thread. Ask me again?\"\n\n\nif __name__ == \"__main__\":\n    # Local chat: python3 bot.py <user_id>; Telegram long-polling lives in telegram.py (not in this repo).\n    uid = sys.argv[1] if len(sys.argv) > 1 else \"42\"\n    for line in sys.stdin:\n        print(reply(uid, line.strip()))\n"},"display":{"success":true,"verb":"Edited","message":"bot.py","warnings":[],"approvalNote":null,"suffix":""},"approvalSource":"bypass","approvalType":"always","decision":"execute"}}
