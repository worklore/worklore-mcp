UCTIONS which never change\n    between requests. The second block holds the per‑athlete, per‑day context\n    (date, profile, zones, goal, facts, language). Both blocks are marked\n    ephemeral so the Anthropic cache can keep the static prefix hot while\n    only the volatile tail is regenerated on memory writes.\n    \"\"\"\n    # Block 1: immutable instructions – stays byte‑identical across users and\n    # calls, enabling cache reuse.\n    instructions_block = {\"type\": \"text\", \"text\": INSTRUCTIONS, \"cache_control\": {\"type\": \"ephemeral\"}}\n\n    # Block 2: volatile athlete context – changes with date, profile updates,\n    # or newly saved facts.\n    context_text = athlete_context(a, today)\n    context_block = {\"type\": \"text\", \"text\": context_text, \"cache_control\": {\"type\": \"ephemeral\"}}\n\n    return [instructions_block, context_block]\n\n# --------------------------------------------------------------------------- tools\nCORE_TOOLS = [\n    {\"name\": \"save_fact\", \"description\": \"Remember one durable fact about the athlete.\",\n     \"input_schema\": {\"type\": \"object\", \"properties\": {\"fact\": {\"type\": \"string\"}}, \"required\": [\"fact\"]}},\n    {\"name\": \"log_session\", \"description\": \"Record a completed workout.\",\n     \"input_schema\": {\"type\": \"object\", \"properties\": {\"minutes\": {\"type\": \"integer\"}, \"rpe\": {\"type\": \"integer\"},\n                                                       \"note\": {\"type\": \"string\"}}, \"required\": [\"minutes\"]}},\n]\nTOOL_GROUPS = {\n    \"plan\": ((\"plan\", \"week\", \"schedule\", \"taper\", \"build\"), [\n        {\"name\": \"plan_week\", \"description\": \"Draft a week of sessions.\",\n         \"input_schema\": {\"type\": \"object\", \"properties\": {\"hours\": {\"type\": \"number\"}, \"hard_days\": {\"type\": \"integer\"}},\n                          \"required\": [\"hours\"]}}]),\n    \"race\": ((\"race\", \"pace\", \"predict\", \"finish time\"), [\n