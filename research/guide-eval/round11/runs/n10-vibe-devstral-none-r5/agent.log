 main() {\n  // Create a user with two posts\n  const user = await prisma.user.create({\n    data: {\n      email: 'user@example.com',\n      name: 'Test User',\n      posts: {\n        create: [\n          {\n            title: 'First Post',\n            content: 'This is my first post',\n            published: false,\n          },\n          {\n            title: 'Second Post',\n            content: 'This is my second post',\n            published: true,\n          },\n        ],\n      },\n    },\n  });\n\n  console.log('Created user with posts:');\n  console.log('User:', {\n    id: user.id,\n    email: user.email,\n    name: user.name,\n  });\n\n  // Fetch all users with their posts\n  const usersWithPosts = await prisma.user.findMany({\n    include: {\n      posts: true,\n    },\n  });\n\n  console.log('\\nAll users with their posts:');\n  for (const user of usersWithPosts) {\n    console.log(`\\nUser ${user.id}: ${user.email} (${user.name || 'no name'})`);\n    console.log('Posts:');\n    for (const post of user.posts) {\n      console.log(`  - ${post.title} (published: ${post.published})`);\n      if (post.content) {\n        console.log(`    Content: ${post.content}`);\n      }\n    }\n  }\n}\n\nmain()\n  .catch((e) => {\n    console.error(e);\n    process.exit(1);\n  })\n  .finally(async () => {\n    await prisma.$disconnect();\n  });\n","fileExisted":true,"previousContent":"import 'dotenv/config';\nimport { db } from './src/prisma/db';\n\nasync function main() {\n  // Create a user with two posts\n  const user = await db.User.create({\n    input: {\n      email: 'user@example.com',\n      name: 'Test User',\n      posts: {\n        create: [\n          {\n            title: 'First Post',\n            content: 'This is my first post',\n            published: false,\n          },\n          {\n            title: 'Second Post',\n            content: 'This is my second post',\n            published: true,\n          },\n        ],\n      },\n    },\n  });\n\n  console.log('Created user with posts:');\n  console.log('User:', {\n    id: user.id,\n    email: user.email,\n    name: user.name,\n  });\n\n  // Fetch all users with their posts\n  const usersWithPosts = await db.User.findMany({\n    include: {\n      posts: true,\n    },\n  });\n\n  console.log('\\nAll users with their posts:');\n  for (const user of usersWithPosts) {\n    console.log(`\\nUser ${user.id}: ${user.email} (${user.name || 'no name'})`);\n    console.log('Posts:');\n    for (const post of user.posts) {\n      console.log(`  - ${post.title} (published: ${post.published})`);\n      if (post.content) {\n        console.log(`    Content: ${post.content}`);\n      }\n    }\n  }\n}\n\nmain()\n  .catch((e) => {\n    console.error(e);\n    process.exit(1);\n  })\n  .finally(async () => {\n    await db.$disconnect();\n  });\n"},"decision":"execute"}}
