{"id":"effect-9444f149-0b36-5915-b57d-ee927da349cc","sessionId":"1f301001-7141-a224-dc0d-9d00ab16f86d","turnId":"turn-32db8538d15390da193f82e2b687b23e","inputEntryId":"user-turn-32db8538d15390da193f82e2b687b23e-1","createdAt":1794279083933,"updatedAt":1794279083955,"generationStatus":"completed","relatedEntryId":null,"type":"effect","title":"file_system.write_file","detail":{"toolName":"file_system.write_file","display":{"summary":"Writing script.ts","content":"import { PrismaClient } from '@prisma/client';\n\nconst prisma = new PrismaClient();\n\nasync function main() {\n  // Create a user with two posts\n  const user = await prisma.user.create({\n    data: {\n      email: 'alice@example.com',\n      name: 'Alice',\n      posts: {\n        create: [\n          {\n            title: 'First Post',\n            content: 'This is my first post',\n            published: false,\n          },\n          {\n            title: 'Second Post',\n            content: 'This is my second post',\n            published: true,\n          },\n        ],\n      },\n    },\n    include: {\n      posts: true,\n    },\n  });\n\n  console.log('Created user with posts:');\n  console.log(JSON.stringify(user, null, 2));\n\n  // Print every user together with their posts\n  const allUsers = await prisma.user.findMany({\n    include: {\n      posts: true,\n    },\n  });\n\n  console.log('\\nAll users with their posts:');\n  console.log(JSON.stringify(allUsers, null, 2));\n}\n\nmain()\n  .catch((e) => {\n    console.error(e);\n    process.exit(1);\n  })\n  .finally(async () => {\n    await prisma.$disconnect();\n  });\n","suffix":"","verb":"Creating","message":"script.ts","settledVerb":"Created","settledMessage":"script.ts","statusText":"Writing file"},"kind":"file_write","input":{"filePath":"script.ts","content":"import { PrismaClient } from '@prisma/client';\n\nconst prisma = new PrismaClient();\n\nasync function main() {\n  // Create a user with two posts\n  const user = await prisma.user.cr