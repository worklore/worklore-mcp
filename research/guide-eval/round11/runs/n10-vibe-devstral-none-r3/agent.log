{"id":"effect-201db104-2aae-51b4-92bf-a4e62694dbef","sessionId":"1f301001-7141-a224-dc0d-9d00ab16f86d","turnId":"turn-32db8538d15390da193f82e2b687b23e","inputEntryId":"user-turn-32db8538d15390da193f82e2b687b23e-1","createdAt":1794278993093,"updatedAt":1794278994370,"generationStatus":"completed","relatedEntryId":null,"type":"effect","title":"file_system.bash","detail":{"toolName":"file_system.bash","display":{"summary":"bash: cd /private/tmp/h-sedfbH && npx prisma orm init --help 2>&1","content":null,"suffix":"","verb":"Running","message":"cd /private/tmp/h-sedfbH && npx prisma orm init --help 2>&1","settledVerb":"Ran","settledMessage":"cd /private/tmp/h-sedfbH && npx prisma orm init --help 2>&1","statusText":"Running command"},"kind":"shell","input":{"command":"cd /private/tmp/h-sedfbH && npx prisma orm init --help 2>&1"}},"state":{"status":"completed","outputText":"prisma orm init → Initialize a new Prisma ORM project\n\n│  Usage\n│    $ prisma orm init [options]\n│\n│  Scaffolds config, schema, and runtime files, installs dependencies,\n│  and emits the contract. Gets you from zero to typed queries in one step.\n│\n│  Run it interactively for a guided setup, or supply --target and --authoring\n│  for a fully scriptable run (CI, AI coding agents, automation).\n│\n│  In a Prisma 7 project, pass --from-prisma7-schema (or answer yes when asked)\n│  to use the existing schema.prisma as the contract source.\n│\n│  In a Prisma 6 MongoDB project, init changes nothing: it prints how to\n│  install\n│  Prisma 8 beside Prisma 6 and read schema.prisma through prisma6Schema in\n│  prisma.config.ts, keeping the Prisma 6 CLI as an alias with its own config.\n│  Passing --target and --authoring sets up a starter in the same project\n│  instead,\n│  which breaks the Prisma 6 CLI.\n│\n│  Options\n│      --target <db>                 Database target: postgres or mongodb\n│      --authoring <style>           Schema authoring style: psl or typescript\n│      --schema-path <path>          Where to write the starter schema\n│      --write-env                   Write a .env file from .env.example (gitignored)\n│      --probe-db                    Connect to DATABASE_URL once and check the server version\n│      --strict-probe                Treat a failed --probe-db as fatal\n│      --skip-install                Skip dependency installation and contract emission\n│      --keep-previous-facade        Keep the previous target package in package.json when switching targets\n│      --from-prisma7-schema <path>  Use an existing Prisma 7 schema.prisma as the contract source\n│\n│  Global options also apply: --format, --json, --log-level, --verbose,\n│  --quiet, --yes, --confirm, --interactive, --color, --config. Run 'prisma\n│  --help' for details.\n│\n│  Examples\n│    $ prisma orm init\n│    $ prisma orm init --target postgres --authoring psl\n│    $ prisma orm init --target mongodb --authoring typescript --json\n│    $ prisma orm init --skip-install\n│    $ prisma orm init --target postgres --keep-previous-facade\n│    $ prisma orm init --from-prisma7-schema prisma/schema.prisma --confirm my-app\n│\n│  Docs  https://docs.prisma.io/docs/orm/v8/reference/error-reference/\n\n","durationMs":0.0,"decision":"execute","approvalSource":"bypass","output":{"stdout":"prisma orm init → Initialize a new Prisma ORM project\n\n│  Usage\n│    $ prisma orm init [options]\n│\n│  Scaffolds config, schema, and runtime files, installs dependencies,\n│  and emits the contract. Gets you from zero to typed queries in one step.\n│\n│  Run it interactively for a guided setup, or supply --target and --authoring\n│  for a fully scriptable run (CI, AI coding agents, automation).\n│\n│  In a Prisma 7 project, pass --from-prisma7-schema (or answer yes when asked)\n│  to use the existing schema.prisma as the contract source.\n│\n│  In a Prisma 6 MongoDB project, init changes nothing: it prints how to\n│  install\n│  Prisma 8 beside Prisma 6 and read schema.prisma through prisma6Schema in\n│  prisma.config.ts, keeping the Prisma 6 CLI as an alias with its own config.\n│  Passing --target and --authoring sets up a starter in the same project\n│  instead,\n│  which breaks the Prisma 6 CLI.\n│\n│  Options\n│      --target <db>                 Database target: postgres or mongodb\n│      --authoring <style>           Schema authoring style: psl or typescript\n│      --schema-path <path>          Where to write the starter schema\n│      --write-env                   Write a .env file from .env.example (gitignored)\n│      --probe-db                    Connect to DATABASE_URL once and check the server version\n│      --strict-probe                Treat a failed --probe-db as fatal\n│      --skip-install                Skip dependency installation and contract emission\n│      --keep-previous-facade        Keep the previous target package in package.json when switching targets\n│      --from-prisma7-schema <path>  Use an existing Prisma 7 schema.prisma as the contract source\n│\n│  Global options also apply: --format, --json, --log-level, --verbose,\n│  --quiet, --yes, --confirm, --interactive, --color, --config. Run 'prisma\n│  --help' for details.\n│\n│  Examples\n│    $ prisma orm init\n│    $ prisma orm init --target postgres --authoring psl\n│    $ prisma orm init --target mongodb --authoring typescript --json\n│    $ prisma orm init --skip-install\n│    $ prisma orm init --target postgres --keep-previous-facade\n│    $ prisma orm init --from-prisma7-schema prisma/schema.prisma --confirm my-app\n│\n│  Docs  https://docs.prisma.io/docs/orm/v8/reference/error-reference/\n\n","stderr":"","output":"","truncated":false},"display":{"success":true,"verb":"Ran","message":"cd /private/tmp/h-sedfbH && npx prisma orm init --help 2>&1","warnings":[],"approvalNote":null,"suffix":""},"approvalType":"always"}}
