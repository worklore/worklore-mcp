14 @@ def athlete_context(a, today):\n \n \n def build_system(a, today):\n-    # One block, cached as a whole: instructions + per-athlete context.\n-    text = INSTRUCTIONS + \"\\n\\n\" + athlete_context(a, today)\n-    return [{\"type\": \"text\", \"text\": text, \"cache_control\": {\"type\": \"ephemeral\"}}]\n+    # Split into two blocks so that static instructions stay cached when only\n+    # the per-athlete context changes (e.g. on save_fact).\n+    # Each block has its own cache marker; changing the tail invalidates only\n+    # the tail, while the static prefix stays hot.\n+    return [\n+        {\"type\": \"text\", \"text\": INSTRUCTIONS, \"cache_control\": {\"type\": \"ephemeral\"}},\n+        {\"type\": \"text\", \"text\": athlete_context(a, today), \"cache_control\": {\"type\": \"ephemeral\"}},\n+    ]\n \n # --------------------------------------------------------------------------- tools\n CORE_TOOLS = [\n","stderr":"","output":"","truncated":false},"approvalType":"always","durationMs":0.0,"approvalSource":"bypass","display":{"success":true,"verb":"Ran","message":"cd /private/tmp/h-bx5OYC && git diff bot.py","warnings":[],"approvalNote":null,"suffix":""}}}
