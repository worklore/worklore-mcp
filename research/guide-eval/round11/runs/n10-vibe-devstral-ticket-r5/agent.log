{"id":"effect-fab44d0d-c4a0-56c1-a3aa-e715bf7aa2f5","sessionId":"f71793d4-b2d7-5fa2-29d7-fe117b9d09bd","turnId":"turn-5510bfa9188b397ff3ea3b91f85760b7","inputEntryId":"user-turn-5510bfa9188b397ff3ea3b91f85760b7-1","createdAt":1794285211651,"updatedAt":1794285211658,"generationStatus":"completed","relatedEntryId":null,"type":"effect","title":"file_system.write_file","detail":{"toolName":"file_system.write_file","display":{"summary":"Writing script.ts","content":"import { db } from './src/prisma/db';\n\nasync function main() {\n  // Clean up existing data to ensure a clean run\n  await db.orm.public.Post.all().delete();\n  await db.orm.public.User.all().delete();\n\n  // Create a user first\n  const user = await db.orm.public.User.create({\n    email: 'user@example.com',\n    name: 'Test User',\n  });\n\n  console.log('Created user:', user);\n\n  // Create two posts for this user\n  const post1 = await db.orm.public.Post.create({\n    title: 'First Post',\n    content: 'This is my first post',\n    published: false,\n    authorId: user.id,\n  });\n\n  const post2 = await db.orm.public.Post.create({\n    title: 'Second Post',\n    content: 'This is my second post',\n    published: true,\n    authorId: user.id,\n  });\n\n  console.log('Created post 1:', post1);\n  console.log('Created post 2:', post2);\n\n  // Fetch all users with their posts\n  const usersWithPosts = await db.orm.public.User.include('posts').all();\n\n  console.log('\\nAll users with their posts:');\n  for (const user of usersWithPosts) {\n    console.log(`\\nUser: ${user.name || 'Unnamed'} (${user.email})`);\n    console.log('Posts:');\n    for (const post of user.posts) {\n      console.log(`  - ${post.title} (published: ${post.published})`);\n      if (post.content) {\n        console.log(`    Content: ${post.content}`);\n      }\n    }\n  }\n\n  await db.close();\n}\n\nmain().catch((e) => {\n  console.error(e);\n  process.exit(1);\n});\n","suffix":"","verb":"Creating","message":"script.ts","settled