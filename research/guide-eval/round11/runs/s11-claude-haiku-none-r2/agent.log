)\n        self.assertEqual(second[\"statusCode\"], 201)\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":968,"cache_read_input_tokens":26631,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":968},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2d544d59-674d-4b7e-a17a-bc266ac78d37","uuid":"ecc594a2-e91a-497c-949b-804387764b96","timestamp":"2026-11-10T01:37:29.488Z","request_id":"req_011CgtPfUoFMLUjNnkS5qeAW","wire_tool_inputs":{"toolu_01DmU3N1zMn7Hv3aM97C5B7D":{"file_path":"/private/tmp/h-638wKw/tests/test_publish.py","old_string":"        self.assertEqual(table.scan()[\"Count\"], 1)\n","new_string":"        self.assertEqual(table.scan()[\"Count\"], 1)\n\n    def test_second_publish_with_related_stories_is_stored(self):\n        # Regression: the first publish has no neighbours, so the similarity\n        # score (stored inside the item) is only computed from the second one on.\n        table = FakeTable()\n        app.publish(table, {\n            \"slug\": \"why-my-cron-ran-twice\",\n            \"title\": \"Why my cron ran twice\",\n            \"tags\": [\"cron\", \"linux\"],\n            \"body\": \"Two crontabs, one for root and one for me, both had the line.\",\n        })\n        stored = app.publish(table, {\n            \"slug\": \"cron-and-systemd-timers\",\n            \"title\": \"Cron and systemd timers\",\n            \"tags\": [\"cron\", \"systemd\"],\n            \"body\": \"When a cron job runs twice, check the crontab and the timers.\",\n        })\n        self.assertEqual(len(stored[\"similar\"]), 1)\n        self.assertEqual(stored[\"similar\"][0][\"slug\"], \"why-my-cron-ran-twice\")\n        self.assertIsInstance(stored[\"similar\"][0][\"score\"], Decimal)\n        self.assertEqual(table.scan()[\"Count\"], 2)\n\n    def test_handler_second_publish_returns_201(self):\n        table = FakeTable()\n        first = app.handler({\"body\": json.dumps({\"slug\": \"first-story\", \"title\": \"A\", \"tags\": [\"cron\"], \"body\": \"cron ran twice\"})}, table)\n        second = app.handler({\"body\": json.dumps({\"slug\": \"second-story\", \"title\": \"B\", \"tags\": [\"cron\"], \"body\": \"cron twice again\"})}, table)\n        self.assertEqual(first[\"statusCode\"], 201)\n        self.assertEqual(second[\"statusCode\"], 201)\n"}}}
