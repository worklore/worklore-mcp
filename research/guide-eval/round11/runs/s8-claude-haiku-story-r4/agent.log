hanged by memory write:\", s1[1]['text'] != s2[1]['text'])\nprint(\"block2 contains new fact:\", 'Moved to Berlin in May' in s2[1]['text'])\nprint(\"block1 has no date/name:\", 'Today' not in s1[0]['text'] and 'Marta' not in s1[0]['text'])\nprint(\"tools identical across rounds:\", r1['tools'] == r2['tools'])\n\n# Day-to-day: same athlete, later date -> only block 2 should differ.\nimport datetime\norig = bot.dt.date\nclass FakeDate(datetime.date):\n    @classmethod\n    def today(cls): return cls(2026, 11, 10)\nbot.dt.date = FakeDate\nbot.build_system(bot.load_athlete('42'), FakeDate(2026,11,9))\na = bot.load_athlete('42')\nprint(\"block1 same across days:\", bot.build_system(a, datetime.date(2026,11,9))[0]['text'] == bot.build_system(a, datetime.date(2026,11,10))[0]['text'])\nbot.dt.date = orig\nEOF\necho \"exit=$?\"; cd /private/tmp/h-ZFEkAw && git status --short && git diff --stat","description":"Offline test of request layout across a memory write"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2034,"cache_read_input_tokens":39937,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2034},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"3e1d9c37-1452-4282-b2bd-663698ffde37","uuid":"a7f5e2e9-941e-44fa-a8a5-dae190119643","timestamp":"2026-11-10T02:48:34.749Z","request_id":"req_011CgtV5tdTJGispL4neXXEi","wire_tool_inputs":{"toolu_014V3dc1x53kwioemb9vBhdF":{"command":"D=$(mktemp -d) && cd /private/tmp/h-ZFEkAw && python3 -I - \"$D\" <<'EOF'\nimport sys, os, json, shutil, datetime as dt\nfrom types import SimpleNamespace as NS\nsys.path.insert(0, '.')\ntmp = sys.argv[1]\nimport bot\nshutil.copy('data/athletes.json', os.path.join(tmp, 'athletes.json'))\nbot.ATHLETES_FILE = os.path.join(tmp, 'athletes.json')\nbot.USAGE_LOG = os.path.join(tmp, 'usage.jsonl')\n\ndef usage(cr=0, cc=0, inp=20, out=10):\n    return NS(input_tokens=inp, cache_creation_input_tokens=cc, cache_read_input_tokens=cr, output_tokens=out)\n\nclass FakeLLM:\n    def __init__(self, script): self.script = list(script); self.requests = []\n    def create(self, **kw):\n        self.requests.append(json.loads(json.dumps(kw)))  # snapshot\n        return self.script.pop(0)\n\ndef text(t): return NS(content=[NS(type='text', text=t)], stop_reason='end_turn', usage=usage())\ndef save(fact):\n    tu = NS(type='tool_use', id='t1', name='save_fact', input={'fact': fact})\n    b = NS(type='tool_use', id='t1', name='save_fact', input={'fact': fact})\n    b.model_dump = lambda: {'type': 'tool_use', 'id': 't1', 'name': 'save_fact', 'input': {'fact': fact}}\n    return NS(content=[b], stop_reason='tool_use', usage=usage())\n\n# Message 1: model saves a fact mid-loop, then answers.\nllm = FakeLLM([save(\"Moved to Berlin in May\"), text(\"Noted.\")])\nbot.reply('42', 'I moved to Berlin in May', llm=llm)\nr1, r2 = llm.requests  # round 1 (before save) and round 2 (after save)\n\ndef blocks(r): return r['system']\ns1, s2 = blocks(r1), blocks(r2)\nprint(\"markers per request:\", sum('cache_control' in b for b in s1), sum('cache_control' in b for b in s2))\nprint(\"block1 byte-identical across memory write:\", s1[0]['text'] == s2[0]['text'])\nprint(\"block2 changed by memory write:\", s1[1]['text'] != s2[1]['text'])\nprint(\"block2 contains new fact:\", 'Moved to Berlin in May' in s2[1]['text'])\nprint(\"block1 has no date/name:\", 'Today' not in s1[0]['text'] and 'Marta' not in s1[0]['text'])\nprint(\"tools identical across rounds:\", r1['tools'] == r2['tools'])\n\n# Day-to-day: same athlete, later date -> only block 2 should differ.\nimport datetime\norig = bot.dt.date\nclass FakeDate(datetime.date):\n    @classmethod\n    def today(cls): return cls(2026, 11, 10)\nbot.dt.date = FakeDate\nbot.build_system(bot.load_athlete('42'), FakeDate(2026,11,9))\na = bot.load_athlete('42')\nprint(\"block1 same across days:\", bot.build_system(a, datetime.date(2026,11,9))[0]['text'] == bot.build_system(a, datetime.date(2026,11,10))[0]['text'])\nbot.dt.date = orig\nEOF\necho \"exit=$?\"; cd /private/tmp/h-ZFEkAw && git status --short && git diff --stat","description":"Offline test of request layout across a memory write"}}}
