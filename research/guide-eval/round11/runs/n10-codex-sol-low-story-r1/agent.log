s/@prisma/orm-postgres/skills/prisma-8/references/queries.md:116:  await db.orm.public.User.create(u);\nnode_modules/@prisma/orm-postgres/skills/prisma-8/references/queries.md:194:type UserResponse = Shape<Models.public_User, { '-': 'email'; posts: { '+': 'id' | 'title' | 'tags' } }>;\nnode_modules/@prisma/orm-postgres/skills/prisma-8/references/queries.md:211:Coming from Prisma 7: `Prisma.User` → `Models.public_User` (note: now carries relations; the scalars-only row is `Scalars<Models.public_User>`); `Prisma.UserGetPayload<{ include: { posts: true } }>` → `Shape<Models.public_User, { '+': 'posts' }>`; `Prisma.UserGetPayload<{ select: { id: true; posts: { select: { title: true } } } }>` → `Shape<Models.public_User, { '+': 'id'; posts: { '+': 'title' } }>`; `Prisma.UserCreateInput` → `CreateInput<Contract, 'User'>`; `Awaited<ReturnType<typeof fn>>` → `ResultType<typeof query>`.\nnode_modules/@prisma/orm-postgres/skills/prisma-8/references/quickstart.md:88:await db.orm.public.User.create({ email: 'alice@example.com' });\nnode_modules/@prisma/orm-postgres/skills/prisma-8/upgrading/extension/upgrades/8.0.0-rc.20-to-8.0.0-rc.21/instructions.md:484:    return postgresDriverDescriptor.create({ cursor }, sessionSettings);\nnode_modules/@prisma/orm-postgres/skills/prisma-8/upgrading/app/upgrades/8.0.0-rc.18-to-8.0.0-rc.19/instructions.md:1026:await db.orm.public.Post.create({ title: 'Hello', publishedAt: new Date() as unknown as string });\nnode_modules/@prisma/orm-postgres/skills/prisma-8/upgrading/app/upgrades/8.0.0-rc.18-to-8.0.0-rc.19/instructions.md:1029:await db.orm.public.Post.create({ title: 'Hello', publishedAt: new Date().toISOString() });\nnode_modules/@prisma/orm-postgres/skills/prisma-8/upgrading/app/upgrades/8.0.0-rc.18-to-8.0.0-rc.19/instructions.md:1426:- await db.orm.User.create({ id: '123e4567-e89b-12d3-a456-426614174000' as Char<36>, email });\nnode_modules/@prisma/orm-postgres/skills/prisma-8/upgrading/app/upgrades/8.0.0-rc.18-to-8.0.0-rc.19/instructions.md:1428:+ await db.orm.User.create({ id: '123e4567-e89b-12d3-a456-426614174000', email });\nnode_modules/@prisma/orm-postgres/skills/prisma-8/upgrading/app/upgrades/8.0.0-rc.18-to-8.0.0-rc.19/instructions.md:1550:const user = await db.orm.users.create({ name: 'Alice' });\nnode_modules/@prisma/orm-postgres/skills/prisma-8/upgrading/app/upgrades/8.0.0-rc.18-to-8.0.0-rc.19/instructions.md:1555:const user = await db.orm.users.create({ name: 'Alice' });\nnode_modules/@prisma/orm-postgres/skills/prisma-8/upgrading/app/upgrades/8.0.0-rc.11-to-8.0.0-rc.12/instructions.md:558:const inserted = await db.orm.User.createAll(rows, { onConflict: 'skip' });\nnode_modules/@prisma/orm-postgres/skills/prisma-8/upgrading/app/upgrades/8.0.0-rc.11-to-8.0.0-rc.12/instructions.md:559:const added = await db.orm.User.createAndCount(rows, {\n","exit_code":0,"status":"completed"}}
