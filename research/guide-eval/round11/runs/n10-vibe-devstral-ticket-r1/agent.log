r: ${u.email} (${u.name || 'no name'})`);\n    console.log(`  Posts (${u.posts.length}):`);\n    for (const post of u.posts) {\n      console.log(`    - ${post.title} (published: ${post.published})`);\n    }\n  }\n\n  await db.close();\n}\n\nmain().catch((e) => {\n  console.error(e);\n  process.exit(1);\n});\n","numLines":51,"startLine":1,"requestedOffset":null,"requestedLimit":2000,"totalLines":null,"wasTruncated":false},"approvalSource":"bypass"}}
