)}, table)\n        self.assertEqual(first[\"statusCode\"], 201)\n        self.assertEqual(second[\"statusCode\"], 201)\n\n    def test_to_dynamo_converts_floats_at_any_depth(self):\n        value = {\"a\": 0.5, \"b\": [{\"c\": 0.25}], \"d\": 3, \"e\": \"x\", \"f\": None, \"g\": True}\n        converted = app.to_dynamo(value)\n        self.assertEqual(converted, {\"a\": Decimal(\"0.5\"), \"b\": [{\"c\": Decimal(\"0.25\")}], \"d\": 3, \"e\": \"x\", \"f\": None, \"g\": True})\n        self.assertIsInstance(converted[\"a\"], Decimal)\n        self.assertIsInstance(converted[\"b\"][0][\"c\"], Decimal)\n\n\nif __name__ == \"__main__\":"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2508,"cache_read_input_tokens":26840,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2508},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d1e3f52c-6d29-4a1e-93df-a0822b250fba","uuid":"94403b8d-b8c3-4efe-955a-f44b7bcbc6b9","timestamp":"2026-11-10T01:09:56.140Z","request_id":"req_011CgtMZfcy8t3XxD84HRjgW","wire_tool_inputs":{"toolu_01TreeGyYKoHGMayaH9RwJZT":{"file_path":"/private/tmp/h-LUNK4h/tests/test_publish.py","old_string":"        self.assertEqual(table.scan()[\"Count\"], 1)\n\n\nif __name__ == \"__main__\":","new_string":"        self.assertEqual(table.scan()[\"Count\"], 1)\n\n    def test_second_publish_with_related_story_is_stored(self):\n        # The populated path: a second story finds a match, so its item carries a\n        # similarity score. Seeding the table first is what exercises that path.\n        table = FakeTable()\n        app.publish(table, {\n            \"slug\": \"first-story\",\n            \"title\": \"First\",\n            \"tags\": [\"cron\", \"linux\"],\n            \"b