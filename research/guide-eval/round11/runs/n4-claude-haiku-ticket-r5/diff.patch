 #!/usr/bin/env bash
 # usage: run.sh <task> <lane> [rep]
-# lanes: codex   Codex CLI, unsandboxed
-#        kimi    Kimi Code under sandbox/agent.sb (no reading or writing the real home), scratch HOME
+# lanes: codex            Codex CLI, unsandboxed
+#        codex-sandboxed  same Codex run, under sandbox/agent.sb (no reading or writing the real home), scratch HOME
+#        kimi             Kimi Code under sandbox/agent.sb (no reading or writing the real home), scratch HOME
 set -u
 D="$(cd "$(dirname "$0")" && pwd)"
 T=$1; A=$2; REP=${3:-1}
@@ -15,6 +16,24 @@ codex_run() {
       -o "$R/final.txt" "$P" < /dev/null > "$R/agent.log" 2> "$R/agent.err" )
 }
 
+# Same Codex run, with its shell under sandbox/agent.sb. Codex's -o write happens inside the sandbox, and the profile
+# denies writes under the real home, so codex writes its last message to a scratch folder in /tmp (outside every denied
+# path) and the lane copies it into the run folder afterwards. Codex can exit 0 without writing that file, so the lane
+# checks for it. Codex's state is a scratch CODEX_HOME seeded with the login and config from the real ~/.codex, read
+# before the sandbox starts.
+codex_sandboxed_run() {
+  local REAL="$HOME" SH OUT rc
+  SH=$(mktemp -d /tmp/chome-XXXXXX); OUT=$(mktemp -d /tmp/cout-XXXXXX)
+  mkdir -p "$SH/.codex"; cp "$REAL/.codex/auth.json" "$REAL/.codex/config.toml" "$SH/.codex/"
+  ( cd "$W" && export HOME="$SH" CODEX_HOME="$SH/.codex" && timeout $TO sandbox-exec -D HOME="$REAL" -f "$D/sandbox/agent.sb" \
+      codex exec --skip-git-repo-check --dangerously-bypass-approvals-and-sandbox -C "$W" --json \
+      -o "$OUT/final.txt" "$P" < /dev/null > "$R/agent.log" 2> "$R/agent.err" )
+  rc=$?
+  if [ -f "$OUT/final.txt" ]; then cp "$OUT/final.txt" "$R/final.txt"
+  else echo "run.sh: last-message file was not written (expected $OUT/final.txt)" >> "$R/agent.err"; [ $rc -eq 0 ] && rc=1; fi
+  rm -rf "$SH" "$OUT"; return $rc
+}
+
 # Kimi's output goes to Moonshot: its shell runs under sandbox/agent.sb with an empty scratch HOME.
 kimi_run() {
   local REAL="$HOME" SH; SH=$(mktemp -d /tmp/khome-XXXXXX)
@@ -27,6 +46,7 @@ kimi_run() {
 start=$(date +%s)
 case $A in
   codex) codex_run;;
+  codex-sandboxed) codex_sandboxed_run;;
   kimi)  kimi_run;;
   *) echo "unknown lane $A"; exit 2;;
 esac
