 T=$1; A=$2; REP=${3:-1}
@@ -15,6 +16,26 @@ codex_run() {
       -o "$R/final.txt" "$P" < /dev/null > "$R/agent.log" 2> "$R/agent.err" )
 }
 
+# Codex run inside the same sandbox used for the kimi lane. The sandbox profile denies
+# read/write access to the real HOME, so we give the agent a temporary HOME and write
+# the final answer to a scratch directory inside /tmp. After sandbox‑exec returns we
+# copy the result into the run folder.
+codex_sandboxed_run() {
+  local REAL="$HOME" SH SCRATCH
+  SH=$(mktemp -d /tmp/khome-XXXXXX)
+  SCRATCH=$(mktemp -d /tmp/codex-sb-XXXXXX)
+  ( cd "$W" && export HOME="$SH" && sandbox-exec -D HOME="$REAL" -f "$D/sandbox/agent.sb" \
+      timeout $TO codex exec --skip-git-repo-check --dangerously-bypass-approvals-and-sandbox -C "$W" --json \
+      -o "$SCRATCH/final.txt" "$P" < /dev/null > "$R/agent.log" 2> "$R/agent.err" )
+  local rc=$?
+  # copy final answer out of the sandbox if it exists
+  if [ -f "$SCRATCH/final.txt" ]; then
+    cp "$SCRATCH/final.txt" "$R/final.txt"
+  fi
+  rm -rf "$SH" "$SCRATCH"
+  return $rc
+}
+
 # Kimi's output goes to Moonshot: its shell runs under sandbox/agent.sb with an empty scratch HOME.
 kimi_run() {
   local REAL="$HOME" SH; SH=$(mktemp -d /tmp/khome-XXXXXX)
@@ -27,6 +48,7 @@ kimi_run() {
 start=$(date +%s)
 case $A in
   codex) codex_run;;
+  codex-sandboxed) codex_sandboxed_run;;
   kimi)  kimi_run;;
   *) echo "unknown lane $A"; exit 2;;
 esac
