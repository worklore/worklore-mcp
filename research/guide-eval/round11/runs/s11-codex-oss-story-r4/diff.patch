 def similarity(a, b):
-    """Shared-tag ratio (Jaccard), blended with shared words of the two bodies."""
+    """Shared‑tag ratio (Jaccard) blended with shared words.
+
+    The original implementation returned a ``float`` which DynamoDB cannot store
+    directly. The first publish succeeded because the ``similar`` list was empty
+    (no existing stories), but on subsequent writes a float value was inserted
+    into the ``similar`` attribute, causing ``TypeError: Float types are not
+    supported``.
+
+    To avoid the DynamoDB limitation we convert the similarity score to an
+    integer percentage (0‑100). This preserves the relative ordering while using a
+    DynamoDB‑compatible type.
+    """
     ta, tb = set(a.get("tags", [])), set(b.get("tags", []))
     tag_score = len(ta & tb) / len(ta | tb) if (ta | tb) else 0
     wa, wb = words(a.get("body")), words(b.get("body"))
     word_score = len(wa & wb) / len(wa | wb) if (wa | wb) else 0
-    return round(0.7 * tag_score + 0.3 * word_score, 4)
+    # Compute a float in the range [0, 1] then convert to an int percentage.
+    raw_score = 0.7 * tag_score + 0.3 * word_score
+    return int(round(raw_score * 100))
 
 
