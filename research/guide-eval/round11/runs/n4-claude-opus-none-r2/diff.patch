 #!/usr/bin/env bash
 # usage: run.sh <task> <lane> [rep]
 # lanes: codex   Codex CLI, unsandboxed
+#        codex-sandboxed  same Codex run, under sandbox/agent.sb (no reading or writing the real home), scratch HOME
 #        kimi    Kimi Code under sandbox/agent.sb (no reading or writing the real home), scratch HOME
 set -u
 D="$(cd "$(dirname "$0")" && pwd)"
@@ -15,6 +16,19 @@ codex_run() {
       -o "$R/final.txt" "$P" < /dev/null > "$R/agent.log" 2> "$R/agent.err" )
 }
 
+# Same Codex invocation as codex_run, but fenced like kimi_run: the whole codex process tree (and so the agent's
+# shell) runs under sandbox/agent.sb with an empty scratch HOME. CODEX_HOME points into the scratch HOME, so Codex
+# never needs ~/.codex (it logs in with CODEX_API_KEY from the environment). Codex's own sandbox stays bypassed:
+# seatbelt profiles can't nest, and agent.sb is the fence here. The run folder may sit under the real home
+# (~/evals/agent-evals), where the sandboxed codex can't write, so -o goes to the scratch dir and is copied out.
+codex_sandboxed_run() {
+  local REAL="$HOME" SH; SH=$(mktemp -d /tmp/chome-XXXXXX); mkdir -p "$SH/.codex"
+  ( cd "$W" && export HOME="$SH" CODEX_HOME="$SH/.codex" && sandbox-exec -D HOME="$REAL" -f "$D/sandbox/agent.sb" \
+      timeout $TO codex exec --skip-git-repo-check --dangerously-bypass-approvals-and-sandbox -C "$W" --json \
+      -o "$SH/final.txt" "$P" < /dev/null > "$R/agent.log" 2> "$R/agent.err" )
+  local rc=$?; [ -f "$SH/final.txt" ] && cp "$SH/final.txt" "$R/final.txt"; rm -rf "$SH"; return $rc
+}
+
 # Kimi's output goes to Moonshot: its shell runs under sandbox/agent.sb with an empty scratch HOME.
 kimi_run() {
   local REAL="$HOME" SH; SH=$(mktemp -d /tmp/khome-XXXXXX)
@@ -27,6 +41,7 @@ kimi_run() {
 start=$(date +%s)
 case $A in
   codex) codex_run;;
+  codex-sandboxed) codex_sandboxed_run;;
   kimi)  kimi_run;;
   *) echo "unknown lane $A"; exit 2;;
 esac
