,\n      new Timestamp(validStartSeconds, 0),\n    ),\n  )\n  .setNodeAccountIds([nodeId])\n  .freezeWith(null);\n\nawait transaction.sign(operatorKey);\n\nconst bytes = transaction.toBytes();\nconsole.log(Buffer.from(bytes).toString(\"hex\"));\n","structuredPatch":[{"oldStart":30,"oldLines":8,"newStart":30,"newLines":8,"lines":[" // Offline: no Client is used. Node and transaction ID are set explicitly,"," // and freezeWith(null) avoids any network lookup."," const transaction = new TransferTransaction()","-  .addHbarTransfer(operatorId, Hbar.from(-1))","-  .addHbarTransfer(recipientId, Hbar.from(1))","+  .addHbarTransfer(operatorId, Hbar.from(-1, HbarUnit.Hbar))","+  .addHbarTransfer(recipientId, Hbar.from(1, HbarUnit.Hbar))","   .setTransactionMemo(\"invoice 42\")","   .setTransactionId(","     TransactionId.withValidStart("]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_018FfGk2HxGDNcK4fJwtLWVu","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
