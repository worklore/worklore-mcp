hon\", \"testing\"],\n            \"body\": \"This is the first story.\",\n        }\n        app.publish(table, first_story)\n        second_story = {\n            \"slug\": \"second-story\",\n            \"title\": \"Second Story\",\n            \"tags\": [\"python\", \"aws\"],\n            \"body\": \"This is the second story.\",\n        }\n        stored = app.publish(table, second_story)\n        self.assertEqual(stored[\"slug\"], \"second-story\")\n        self.assertEqual(table.scan()[\"Count\"], 2)\n        self.assertIn(\"similar\", stored)\n        self.assertEqual(len(stored[\"similar\"]), 1)\n        from decimal import Decimal\n        self.assertIsInstance(stored[\"similar\"][0][\"score\"], Decimal)"}],"previousContent":"import os\nimport sys\nimport unittest\n\nsys.path.insert(0, os.path.join(os.path.dirname(__file__), \"..\", \"src\"))\nsys.path.insert(0, os.path.dirname(__file__))\n\nimport app  # noqa: E402\nfrom fake_dynamo import FakeTable  # noqa: E402\n\n\nclass PublishTest(unittest.TestCase):\n    def test_publish_stores_story(self):\n        table = FakeTable()\n        story = {\n            \"slug\": \"why-my-cron-ran-twice\",\n            \"title\": \"Why my cron ran twice\",\n            \"tags\": [\"cron\", \"linux\"],\n            \"body\": \"Two crontabs, one for root and one for me, both had the line.\",\n        }\n        stored = app.publish(table, story)\n        self.assertEqual(stored[\"slug\"], \"why-my-cron-ran-twice\")\n        self.assertEqual(table.get_item(Key={\"slug\": \"why-my-cron-ran-twice\"})[\"Item\"][\"title\"], \"Why my cron ran twice\")\n        self.assertEqual(table.scan()[\"Count\"], 1)\n\n    def test_publish_with_existing_story(self):\n        table = FakeTable()\n        first_story = {\n            \"slug\": \"first-story\",\n            \"title\": \"First Story\",\n            \"tags\": [\"python\", \"testing\"],\n            \"body\": \"This is the first story.\",\n        }\n        app.publish(table, first_story)\n        second_story = {\n            \"slug\": \"second-story\",\n            \"title\": \"Second Story\",\n            \"tags\": [\"python\", \"aws\"],\n            \"body\": \"This is the second story.\",\n        }\n        stored = app.publish(table, second_story)\n        self.assertEqual(stored[\"slug\"], \"second-story\")\n        self.assertEqual(table.scan()[\"Count\"], 2)\n        self.assertIn(\"similar\", stored)\n        self.assertEqual(len(stored[\"similar\"]), 1)\n        self.assertIsInstance(stored[\"similar\"][0][\"score\"], type(stored[\"similar\"][0][\"score\"]).__class__)\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n"},"approvalSource":"bypass","decision":"execute","display":{"success":true,"verb":"Edited","message":"tests/test_publish.py","warnings":[],"approvalNote":null,"suffix":""},"approvalType":"always"}}
