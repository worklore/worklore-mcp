{"id":"effect-f47c9490-7dd2-5f2a-a551-05d7b5b9cce8","sessionId":"6f664129-934d-23f7-d463-c8d4162b1eee","turnId":"turn-c853639fc1d2ee66855ead929ac29ab5","inputEntryId":"user-turn-c853639fc1d2ee66855ead929ac29ab5-1","createdAt":1794282703321,"updatedAt":1794282703329,"generationStatus":"completed","relatedEntryId":null,"type":"effect","title":"file_system.read_file","detail":{"toolName":"file_system.read_file","display":{"summary":"Reading src/app.py","content":null,"suffix":"","verb":"Reading","message":"src/app.py","settledVerb":"Read","settledMessage":"src/app.py","statusText":"Reading file"},"kind":"file_read","input":{"filePath":"src/app.py","offset":null,"limit":2000}},"state":{"status":"completed","outputText":"","durationMs":0.0,"output":{"filePath":"/private/tmp/h-LDli7h/src/app.py","content":"\"\"\"Story library: the publish handler.\n\nEach story is stored in one DynamoDB item together with the three most similar\nstories already in the library (``similar``), so the reader page can show\n\"related\" without a query at read time.\n\"\"\"\nimport json\nimport logging\nimport re\nimport time\nfrom decimal import Decimal\n\nlog = logging.getLogger(\"stories\")\n\nTABLE_NAME = \"stories\"\nTOP_N = 3\n\n_WORD = re.compile(r\"[a-z0-9]+\")\n\n\ndef words(text):\n    return set(_WORD.findall((text or \"\").lower()))\n\n\ndef similarity(a, b):\n    \"\"\"Shared-tag ratio (Jaccard), blended with shared words of the two bodies.\"\"\"\n    ta, tb = set(a.get(\"tags\", [])), set(b.get(\"tags\", []))\n    tag_score = len(ta & tb) / len(ta | tb) if (ta | tb) else 0\n    wa, wb = words(a.get(\"body\")), words(b.get(\"body\"))\n    word_score = len(wa & wb) / len(wa | wb) if (wa | wb) else 0\n    return Decimal(str(round(0.7 * tag_score + 0.3 * word_score, 4)))\n\n\ndef related(story, existing):\n    scored = []\n    for other in existing:\n        if other[\"slug\"] == story[\"slug\"]:\n            continue\n        scored.append({\"slug\": other[\"slug\"], \"score\": similarity(story, other)})\n    scored.sort(key=lambda s: s[\"score\"], reverse=True)\n    return scored[:TOP_N]\n\n\ndef validate(story):\n    for k in (\"slug\", \"title\", \"body\"):\n        if not story.get(k):\n            raise ValueError(f\"missing field: {k}\")\n    if not re.fullmatch(r\"[a-z0-9-]{3,80}\", story[\"slug\"]):\n        raise ValueError(\"bad slug\")\n\n\ndef publish(table, story):\n    \"\"\"Store ``story`` with its related stories. Returns the stored item.\"\"\"\n    validate(story)\n    existing = table.scan(TableName=TABLE_NAME).get(\"Items\", [])\n    item = {\n        \"slug\": story[\"slug\"],\n        \"title\": story[\"title\"],\n        \"tags\": sorted(set(story.get(\"tags\", []))),\n        \"body\": story[\"body\"],\n        \"published_at\": int(time.time()),\n        \"similar\": related(story, existing),\n    }\n    table.put_item(Item=item)\n    log.info(\"publish slug=%s similar=%d stored\", item[\"slug\"], len(item[\"similar\"]))\n    return item\n\n\ndef handler(event, table):\n    \"\"\"Lambda-style entry point for POST /stories. Body is the story as JSON.\"\"\"\n    try:\n        story = json.loads(event.get(\"body\") or \"{}\")\n        stored = publish(table, story)\n        return {\"statusCode\": 201, \"body\": json.dumps({\"slug\": stored[\"slug\"]})}\n    except ValueError as e:\n        return {\"statusCode\": 400, \"body\": json.dumps({\"error\": str(e)})}\n    except Exception:\n        log.exception(\"publish failed\")\n        return {\"statusCode\": 500, \"body\": json.dumps({\"error\": \"Internal Server Error\"})}\n","numLines":79,"startLine":1,"requestedOffset":null,"requestedLimit":2000,"totalLines":null,"wasTruncated":false},"approvalSource":"bypass","decision":"execute","display":{"success":true,"verb":"Read","message":"79 lines from src/app.py","warnings":[],"approvalNote":null,"suffix":""},"approvalType":"always"}}
{"id":"effect-5a57d4c9-dce3-5381-aab1-ed407063658a","sessionId":"6f664129-934d-23f7-d463-c8d4162b1eee","turnId":"turn-c853639fc1d2ee66855ead929ac29ab5","inputEntryId":"user-turn-c853639fc1d2ee66855ead929ac29ab5-1","createdAt":1794282705118,"updatedAt":1794282705124,"generationStatus":"completed","relatedEntryId":null,"type":"effect","title":"file_system.read_file","detail":{"toolName":"file_system.read_file","display":{"summary":"Reading tests/test_publish.py","content":null,"suffix":"","verb":"Reading","message":"tests/test_publish.py","settledVerb":"Read","settledMessage":"tests/test_publish.py","statusText":"Reading file"},"kind":"file_read","input":{"filePath":"tests/test_publish.py","offset":null,"limit":2000}},"state":{"status":"completed","outputText":"","durationMs":0.0,"output":{"filePath":"/private/tmp/h-LDli7h/tests/test_publish.py","content":"import os\nimport sys\nimport unittest\n\nsys.path.insert(0, os.path.join(os.path.dirname(__file__), \"..\", \"src\"))\nsys.path.insert(0, os.path.dirname(__file__))\n\nimport app  # noqa: E402\nfrom fake_dynamo import FakeTable  # noqa: E402\n\n\nclass PublishTest(unittest.TestCase):\n    def test_publish_stores_story(self):\n        table = FakeTable()\n        story = {\n            \"slug\": \"why-my-cron-ran-twice\",\n            \"title\": \"Why my cron ran twice\",\n            \"tags\": [\"cron\", \"linux\"],\n            \"body\": \"Two crontabs, one for root and one for me, both had the line.\",\n        }\n        stored = app.publish(table, story)\n        self.assertEqual(stored[\"slug\"], \"why-my-cron-ran-twice\")\n        self.assertEqual(table.get_item(Key={\"slug\": \"why-my-cron-ran-twice\"})[\"Item\"][\"title\"], \"Why my cron ran twice\")\n        self.assertEqual(table.scan()[\"Count\"], 1)\n\n    def test_publish_with_existing_story(self):\n        table = FakeTable()\n        first_story = {\n            \"slug\": \"first-story\",\n            \"title\": \"First Story\",\n            \"tags\": [\"python\", \"testing\"],\n            \"body\": \"This is the first story.\",\n        }\n        app.publish(table, first_story)\n        second_story = {\n            \"slug\": \"second-story\",\n            \"title\": \"Second Story\",\n            \"tags\": [\"python\", \"aws\"],\n            \"body\": \"This is the second story.\",\n        }\n        stored = app.publish(table, second_story)\n        self.assertEqual(stored[\"slug\"], \"second-story\")\n        self.assertEqual(table.scan()[\"Count\"], 2)\n        self.assertIn(\"similar\", stored)\n        self.assertEqual(len(stored[\"similar\"]), 1)\n        from decimal import Decimal\n        self.assertIsInstance(stored[\"similar\"][0][\"score\"], Decimal)\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n","numLines":51,"startLine":1,"requestedOffset":null,"requestedLimit":2000,"totalLines":null,"wasTruncated":false},"approvalSource":"bypass","decision":"execute","display":{"success":true,"verb":"Read","message":"51 lines from tests/test_publish.py","warnings":[],"approvalNote":null,"suffix":""},"approvalType":"always"}}
