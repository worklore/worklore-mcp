+++ b/src/app.py
@@ -8,6 +8,7 @@ import json
 import logging
 import re
 import time
+from decimal import Decimal
 
 log = logging.getLogger("stories")
 
@@ -35,7 +36,9 @@ def related(story, existing):
     for other in existing:
         if other["slug"] == story["slug"]:
             continue
-        scored.append({"slug": other["slug"], "score": similarity(story, other)})
+        # DynamoDB rejects Python floats; store the score as Decimal.
+        score = Decimal(str(similarity(story, other)))
+        scored.append({"slug": other["slug"], "score": score})
     scored.sort(key=lambda s: s["score"], reverse=True)
     return scored[:TOP_N]
 
@@ -48,18 +51,29 @@ def validate(story):
         raise ValueError("bad slug")
 
 
+def to_dynamo(value):
+    """Recursively convert floats to Decimal; boto3's DynamoDB serializer rejects floats."""
+    if isinstance(value, float):
+        return Decimal(str(value))
+    if isinstance(value, dict):
+        return {k: to_dynamo(v) for k, v in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [to_dynamo(v) for v in value]
+    return value
+
+
 def publish(table, story):
     """Store ``story`` with its related stories. Returns the stored item."""
     validate(story)
     existing = table.scan(TableName=TABLE_NAME).get("Items", [])
-    item = {
+    item = to_dynamo({
         "slug": story["slug"],
         "title": story["title"],
         "tags": sorted(set(story.get("tags", []))),
         "body": story["body"],
         "published_at": int(time.time()),
         "similar": related(story, existing),
-    }
+    })
     table.put_item(Item=item)
     log.info("publish slug=%s similar=%d stored", item["slug"], len(item["similar"]))
     return item
