{"id":"effect-c92ba352-b502-547c-b646-af65fb431ff9","sessionId":"21b66e44-0f41-e46e-2131-781d071fcbe9","turnId":"turn-0f8591487075a2a0c3ed4d8a78c9f4ef","inputEntryId":"user-turn-0f8591487075a2a0c3ed4d8a78c9f4ef-1","createdAt":1794280440802,"updatedAt":1794280440814,"generationStatus":"completed","relatedEntryId":null,"type":"effect","title":"file_system.write_file","detail":{"toolName":"file_system.write_file","display":{"summary":"Writing src/transfer.ts","content":"import { Client, PrivateKey, AccountId, TransferTransaction, Hbar, Timestamp, TransactionId, PublicKey } from \"@hashgraph/sdk\";\nimport * as dotenv from \"dotenv\";\n\ndotenv.config();\n\nconst operatorId = AccountId.fromString(process.env.OPERATOR_ID!);\nconst operatorKey = PrivateKey.fromStringED25519(process.env.OPERATOR_KEY!);\nconst recipientId = AccountId.fromString(process.env.RECIPIENT_ID!);\nconst validStart = Timestamp.fromDate(Number(process.env.VALID_START!) * 1000);\n\nconst client = Client.forTestnet();\nclient.setOperator(operatorId, operatorKey);\n\nconst txId = new TransactionId(operatorId, validStart, false, 0);\n\nconst tx = new TransferTransaction()\n  .setNodeAccountIds([AccountId.fromString(\"0.0.3\")])\n  .setTransactionId(txId)\n  .addHbarTransfer(operatorId, new Hbar(-1))\n  .addHbarTransfer(recipientId, new Hbar(1))\n  .setTransactionMemo(\"invoice 42\");\n\ntx.freezeWith(client);\nconst publicKey: PublicKey = operatorKey.publicKey;\nconst signedTx = await tx.signWith(publicKey, (message) => Promise.resolve(operatorKey.sign(message)));\n\nconsole.log(signedTx.toBytes().toString(\"hex\"));\n","suffix":"","verb":"Creating","message":"src/transfer.ts","settledVerb":"Created","settledMessage":"src/transfer.ts","statusText":"Writing file"},"kind":"file_write","input":{"filePath":"src/transfer.ts","content":"import { Client, PrivateKey, AccountId, TransferTransaction, Hbar, Timestamp, TransactionId, PublicKey } from \"@hashgraph/sdk\";\nimport * as dotenv from \"dotenv\";\n\ndotenv.config();\n\nconst operatorId = AccountId.fromString(process.env.OPERATOR_ID!);\nconst operatorKey = PrivateKey.fromStringED25519(process.env.OPERATOR_KEY!);\nconst recipientId = AccountId.fromString(process.env.RECIPIENT_ID!);\nconst validStart = Timestamp.fromDate(Number(process.env.VALID_START!) * 1000);\n\nconst client = Client.forTestnet();\nclient.setOperator(operatorId, operatorKey);\n\nconst txId = new TransactionId(operatorId, validStart, false, 0);\n\nconst tx = new TransferTransaction()\n  .setNodeAccountIds([AccountId.fromString(\"0.0.3\")])\n  .setTransactionId(txId)\n  .addHbarTransfer(operatorId, new Hbar(-1))\n  .addHbarTransfer(recipientId, new Hbar(1))\n  .setTransactionMemo(\"invoice 42\");\n\ntx.freezeWith(client);\nconst publicKey: PublicKey = operatorKey.publicKey;\nconst signedTx = await tx.signWith(publicKey, (message) => Promise.resolve(operatorKey.sign(message)));\n\nconsole.log(signedTx.toBytes().toString(\"hex\"));\n"}},"state":{"status":"completed","outputText":"","approvalType":"always","display":{"success":true,"verb":"Updated","message":"src/transfer.ts","warnings":[],"approvalNote":null,"suffix":""},"decision":"execute","output":{"filePath":"/private/tmp/h-OwqfEU/src/transfer.ts","content":"import { Client, PrivateKey, AccountId, TransferTransaction, Hbar, Timestamp, TransactionId, PublicKey } from \"@hashgraph/sdk\";\nimport * as dotenv from \"dotenv\";\n\ndotenv.config();\n\nconst operatorId = AccountId.fromString(process.env.OPERATOR_ID!);\nconst operatorKey = PrivateKey.fromStringED25519(process.env.OPERATOR_KEY!);\nconst recipientId = AccountId.fromString(process.env.RECIPIENT_ID!);\nconst validStart = Timestamp.fromDate(Number(process.env.VALID_START!) * 1000);\n\nconst client = Client.forTestnet();\nclient.setOperator(operatorId, operatorKey);\n\nconst txId = new TransactionId(operatorId, validStart, false, 0);\n\nconst tx = new TransferTransaction()\n  .setNodeAccountIds([AccountId.fromString(\"0.0.3\")])\n  .setTransactionId(txId)\n  .addHbarTransfer(operatorId, new Hbar(-1))\n  .addHbarTransfer(recipientId, new Hbar(1))\n  .setTransactionMemo(\"invoice 42\");\n\ntx.freezeWith(client);\nconst publicKey: PublicKey = operatorKey.publicKey;\nconst signedTx = await tx.signWith(publicKey, (message) => Promise.resolve(operatorKey.sign(message)));\n\nconsole.log(signedTx.toBytes().toString(\"hex\"));\n","fileExisted":true,"previousContent":"import { Client, PrivateKey, AccountId, TransferTransaction, Hbar, Timestamp, TransactionId } from \"@hashgraph/sdk\";\nimport * as dotenv from \"dotenv\";\n\ndotenv.config();\n\nconst operatorId = AccountId.fromString(process.env.OPERATOR_ID!);\nconst operatorKey = PrivateKey.fromStringED25519(process.env.OPERATOR_KEY!);\nconst recipientId = AccountId.fromString(process.env.RECIPIENT_ID!);\nconst validStart = Timestamp.fromDate(Number(process.env.VALID_START!) * 1000);\n\nconst client = Client.forTestnet();\nclient.setOperator(operatorId, operatorKey);\n\nconst txId = new TransactionId(operatorId, validStart, false, 0);\n\nconst tx = new TransferTransaction()\n  .setNodeAccountIds([AccountId.fromString(\"0.0.3\")])\n  .setTransactionId(txId)\n  .addHbarTransfer(operatorId, new Hbar(-1))\n  .addHbarTransfer(recipientId, new Hbar(1))\n  .setTransactionMemo(\"invoice 42\");\n\ntx.freezeWith(client);\nconst signedTx = await tx.signWith(operatorKey.publicKey, (message) => Promise.resolve(operatorKey.sign(message)));\n\nconsole.log(signedTx.toBytes().toString(\"hex\"));\n"},"approvalSource":"bypass","durationMs":0.0}}
