{"id":"effect-3f64e9b7-b097-50a9-b648-9e8eb94f61dc","sessionId":"21b66e44-0f41-e46e-2131-781d071fcbe9","turnId":"turn-0f8591487075a2a0c3ed4d8a78c9f4ef","inputEntryId":"user-turn-0f8591487075a2a0c3ed4d8a78c9f4ef-1","createdAt":1794280110359,"updatedAt":1794280110370,"generationStatus":"completed","relatedEntryId":null,"type":"effect","title":"file_system.write_file","detail":{"toolName":"file_system.write_file","display":{"summary":"Writing src/transfer.ts","content":"import { Client, PrivateKey, AccountId, TransferTransaction, Hbar } from \"@hashgraph/sdk\";\nimport * as dotenv from \"dotenv\";\n\ndotenv.config();\n\nconst operatorId = AccountId.fromString(process.env.OPERATOR_ID!);\nconst operatorKey = PrivateKey.fromStringED25519(process.env.OPERATOR_KEY!);\nconst recipientId = AccountId.fromString(process.env.RECIPIENT_ID!);\nconst validStart = new Date(Number(process.env.VALID_START!) * 1000);\n\nconst client = Client.forTestnet();\nclient.operator = { accountId: operatorId, privateKey: operatorKey };\n\nconst tx = new TransferTransaction()\n  .setNodeAccountIds([AccountId.fromString(\"0.0.3\")])\n  .setTransactionId({ accountId: operatorId, validStart, nonces: new Uint8Array(0) })\n  .addHbarTransfer(operatorId, new Hbar(-1))\n  .addHbarTransfer(recipientId, new Hbar(1))\n  .setMemo(\"invoice 42\");\n\nconst signedTx = tx.sign(operatorKey);\n\nconsole.log(signedTx.toBytes().toString(\"hex\"));\n","suffix":"","verb":"Creating","message":"src/transfer.ts","settledVerb":"Created","settledMessage":"src/transfer.ts","statusText":"Writing file"},"kind":"file_write","input":{"filePath":"src/transfer.ts","content":"import { Client, PrivateKey, AccountId, TransferTransaction, Hbar } from \"@hashgraph/sdk\";\nimport * as dotenv from \"dotenv\";\n\ndotenv.config();\n\nconst operatorId = AccountId.fromString(process.env.OPERATOR_ID!);\nconst operatorKey = PrivateKey.fromStringED25519(process.env.OPERATOR_KEY!);\nconst recipientId = AccountId.fromString(process.env.RECIPIENT_ID!);\nconst validStart = new Date(Number(process.env.VALID_START!) * 1000);\n\nconst client = Client.forTestnet();\nclient.operator = { accountId: operatorId, privateKey: operatorKey };\n\nconst tx = new TransferTransaction()\n  .setNodeAccountIds([AccountId.fromString(\"0.0.3\")])\n  .setTransactionId({ accountId: operatorId, validStart, nonces: new Uint8Array(0) })\n  .addHbarTransfer(operatorId, new Hbar(-1))\n  .addHbarTransfer(recipientId, new Hbar(1))\n  .setMemo(\"invoice 42\");\n\nconst signedTx = tx.sign(operatorKey);\n\nconsole.log(signedTx.toBytes().toString(\"hex\"));\n"}},"state":{"status":"completed","outputText":"","approvalType":"always","display":{"success":true,"verb":"Created","message":"src/transfer.ts","warnings":[],"approvalNote":null,"suffix":""},"decision":"execute","output":{"filePath":"/private/tmp/h-OwqfEU/src/transfer.ts","content":"import { Client, PrivateKey, AccountId, TransferTransaction, Hbar } from \"@hashgraph/sdk\";\nimport * as dotenv from \"dotenv\";\n\ndotenv.config();\n\nconst operatorId = AccountId.fromString(process.env.OPERATOR_ID!);\nconst operatorKey = PrivateKey.fromStringED25519(process.env.OPERATOR_KEY!);\nconst recipientId = AccountId.fromString(process.env.RECIPIENT_ID!);\nconst validStart = new Date(Number(process.env.VALID_START!) * 1000);\n\nconst client = Client.forTestnet();\nclient.operator = { accountId: operatorId, privateKey: operatorKey };\n\nconst tx = new TransferTransaction()\n  .setNodeAccountIds([AccountId.fromString(\"0.0.3\")])\n  .setTransactionId({ accountId: operatorId, validStart, nonces: new Uint8Array(0) })\n  .addHbarTransfer(operatorId, new Hbar(-1))\n  .addHbarTransfer(recipientId, new Hbar(1))\n  .setMemo(\"invoice 42\");\n\nconst signedTx = tx.sign(operatorKey);\n\nconsole.log(signedTx.toBytes().toString(\"hex\"));\n","fileExisted":false,"previousContent":null},"approvalSource":"bypass","durationMs":0.0}}
