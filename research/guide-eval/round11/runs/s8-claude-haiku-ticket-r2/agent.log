"text\"] != s[1][\"text\"], \"block 2 should reflect the new fact\"\ns3 = bot.build_system(a, dt.date(2026, 4, 19))\nassert s3[0][\"text\"] == s[0][\"text\"], \"block 1 changed across days\"\nprint(\"ok block 1 stable across save_fact and day change\")\n\n# 3. another athlete gets a different block 1 (per-athlete cache, expected)\nb = bot.Athlete(user_id=\"77\", name=\"Jonas\", lang=\"de\", sport=\"cycling\")\nassert bot.build_system(b, TODAY)[0][\"text\"] != s[0][\"text\"]\nprint(\"ok per-athlete block 1\")\n\n# 4. full tool loop: round 1 calls save_fact, round 2 must send the same block 1 bytes\nclass FakeLLM:\n    def __init__(self): self.reqs = []; self.n = 0\n    def create(self, **kw):\n        self.reqs.append(json.loads(json.dumps(kw, default=str)))\n        self.n += 1\n        usage = NS(input_tokens=1, cache_creation_input_tokens=0, cache_read_input_tokens=0, output_tokens=1)\n        if self.n == 1:\n            content = [NS(type=\"tool_use\", name=\"save_fact\", id=\"t1\", input={\"fact\": \"Runs Mon/Wed/Fri\"})]\n            return NS(content=content, stop_reason=\"tool_use\", usage=usage)\n        return NS(content=[NS(type=\"text\", text=\"Noted.\")], stop_reason=\"end_turn\", usage=usage)\n\nllm = FakeLLM()\nout = bot.reply(\"42\", \"I can only run Mon/Wed/Fri\", llm=llm)\nassert out == \"Noted.\", out\nr1, r2 = llm.reqs\nassert r1[\"system\"][0] == r2[\"system\"][0], \"round 2 block 1 differs from round 1\"\nassert r1[\"system\"][1] != r2[\"system\"][1], \"round 2 should see the saved fact in block 2\"\nassert \"Runs Mon/Wed/Fri\" in r2[\"system\"][1][\"text\"]\nassert \"Runs Mon/Wed/Fri\" not in r2[\"system\"][0][\"text\"]\nprint(\"ok tool loop: block 1 identical across rounds, fact lands in block 2\")\n\n# 5. repo data was not touched by the test\nassert not os.path.exists(os.path.join(REPO, \"data\", \"athletes.json.tmp\"))\nprint(\"all checks passed\")\nEOF\ncd /tmp && python3 -I /tmp/h-WV7PJh-test/test_cache.py && cd /private/tmp/h-WV7PJh && 