{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HUFRcksFGp38gTL6AxSyoe","type":"tool_result","content":"1\t\"\"\"In-memory stand-in for a boto3 DynamoDB Table resource.\n2\t\n3\tIt stores items in a dict and validates values the way boto3's TypeSerializer\n4\tdoes, so a test fails on the same inputs a real table would reject.\n5\t\"\"\"\n6\tfrom decimal import Decimal\n7\t\n8\t\n9\tdef _check(value, path=\"Item\"):\n10\t    if isinstance(value, bool) or value is None or isinstance(value, (int, str, bytes, Decimal)):\n11\t        return\n12\t    if isinstance(value, float):\n13\t        raise TypeError(\"Float types are not supported. Use Decimal types instead.\")\n14\t    if isinstance(value, dict):\n15\t        for k, v in value.items():\n16\t            _check(v, f\"{path}.{k}\")\n17\t        return\n18\t    if isinstance(value, (list, tuple, set, frozenset)):\n19\t        for i, v in enumerate(value):\n20\t            _check(v, f\"{path}[{i}]\")\n21\t        return\n22\t    raise TypeError(f\"Unsupported type {type(value)!r} for value at {path}\")\n23\t\n24\t\n25\tclass FakeTable:\n26\t    def __init__(self, key=\"slug\"):\n27\t        self.key = key\n28\t        self.items = {}\n29\t\n30\t    def put_item(self, Item, **kwargs):\n31\t        _check(Item)\n32\t        if self.key not in Item:\n33\t            raise ValueError(f\"item is missing the key attribute {self.key!r}\")\n34\t        self.items[Item[self.key]] = dict(Item)\n35\t        return {\"ResponseMetadata\": {\"HTTPStatusCode\": 200}}\n36\t\n37\t    def get_item(self, Key, **kwargs):\n38\t        item = self.items.get(Key[self.key])\n39\t        return {\"Item\": dict(item)} if item is not None else {}\n40\t\n41\t    def scan(self, **kwargs):\n42\t        return {\"Items\": [dict(v) for v in self.items.values()], \"Count\": len(self.items)}\n43\t"}]},"parent_tool_use_id":null,"session_id":"7b19092b-54f6-48a9-a4ea-7ac93342ee4d","uuid":"5d735bbf-ed06-4db5-a6dd-367cb1d27c51","timestamp":"2026-11-10T02:05:47.116Z","tool_use_result":{"type":"text","file":{"filePath":"/private/tmp/h-dwo9ju/tests/fake_dynamo.py","content":"\"\"\"In-memory stand-in for a boto3 DynamoDB Table resource.\n\nIt stores items in a dict and validates values the way boto3's TypeSerializer\ndoes, so a test fails on the same inputs a real table would reject.\n\"\"\"\nfrom decimal import Decimal\n\n\ndef _check(value, path=\"Item\"):\n    if isinstance(value, bool) or value is None or isinstance(value, (int, str, bytes, Decimal)):\n        return\n    if isinstance(value, float):\n        raise TypeError(\"Float types are not supported. Use Decimal types instead.\")\n    if isinstance(value, dict):\n        for k, v in value.items():\n            _check(v, f\"{path}.{k}\")\n        return\n    if isinstance(value, (list, tuple, set, frozenset)):\n        for i, v in enumerate(value):\n            _check(v, f\"{path}[{i}]\")\n        return\n    raise TypeError(f\"Unsupported type {type(value)!r} for value at {path}\")\n\n\nclass FakeTable:\n    def __init__(self, key=\"slug\"):\n        self.key = key\n        self.items = {}\n\n    def put_item(self, Item, **kwargs):\n        _check(Item)\n        if self.key not in Item:\n            raise ValueError(f\"item is missing the key attribute {self.key!r}\")\n        self.items[Item[self.key]] = dict(Item)\n        return {\"ResponseMetadata\": {\"HTTPStatusCode\": 200}}\n\n    def get_item(self, Key, **kwargs):\n        item = self.items.get(Key[self.key])\n        return {\"Item\": dict(item)} if item is not None else {}\n\n    def scan(self, **kwargs):\n        return {\"Items\": [dict(v) for v in self.items.values()], \"Count\": len(self.items)}\n","numLines":43,"startLine":1,"totalLines":43}},"tool_result_meta":[{"id":"toolu_01HUFRcksFGp38gTL6AxSyoe","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
