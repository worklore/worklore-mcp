@@ -8,6 +8,7 @@ import json
 import logging
 import re
 import time
+from decimal import Decimal
 
 log = logging.getLogger("stories")
 
@@ -17,6 +18,23 @@ TOP_N = 3
 _WORD = re.compile(r"[a-z0-9]+")
 
 
+def to_dynamo(value):
+    """Return ``value`` with every float replaced by a ``Decimal``.
+
+    DynamoDB rejects Python floats. Converting via ``str`` keeps the decimal
+    digits (``0.4286`` stays ``Decimal("0.4286")``). Applied to the whole item
+    before every write, so a computed float cannot reach ``put_item`` no matter
+    which code path produced it.
+    """
+    if isinstance(value, float):
+        return Decimal(str(value))
+    if isinstance(value, dict):
+        return {k: to_dynamo(v) for k, v in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [to_dynamo(v) for v in value]
+    return value
+
+
 def words(text):
     return set(_WORD.findall((text or "").lower()))
 
@@ -60,7 +78,7 @@ def publish(table, story):
         "published_at": int(time.time()),
         "similar": related(story, existing),
     }
-    table.put_item(Item=item)
+    table.put_item(Item=to_dynamo(item))
     log.info("publish slug=%s similar=%d stored", item["slug"], len(item["similar"]))
     return item
 
