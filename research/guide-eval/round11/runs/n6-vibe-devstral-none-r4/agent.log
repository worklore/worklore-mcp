{"id":"effect-4d31cc43-6648-58b9-a6e2-950e826dcd41","sessionId":"45fd6183-9d81-56a7-6592-6e3d7b2ca3eb","turnId":"turn-f283686d8f55999f69b954823e9b4ea6","inputEntryId":"user-turn-f283686d8f55999f69b954823e9b4ea6-1","createdAt":1794283032811,"updatedAt":1794283032821,"generationStatus":"completed","relatedEntryId":null,"type":"effect","title":"file_system.write_file","detail":{"toolName":"file_system.write_file","display":{"summary":"Writing src/transfer.ts","content":"import { Client, PrivateKey, AccountId, TransferTransaction, Hbar } from \"@hashgraph/sdk\";\nimport * as dotenv from \"dotenv\";\n\ndotenv.config();\n\nconst OPERATOR_ID = process.env.OPERATOR_ID!;\nconst OPERATOR_KEY = process.env.OPERATOR_KEY!;\nconst RECIPIENT_ID = process.env.RECIPIENT_ID!;\nconst VALID_START = parseInt(process.env.VALID_START!, 10);\n\nconst operatorKey = PrivateKey.fromBytes(Buffer.from(OPERATOR_KEY, \"hex\"));\nconst operatorId = AccountId.fromString(OPERATOR_ID);\nconst recipientId = AccountId.fromString(RECIPIENT_ID);\n\nconst client = Client.forTestnet();\nclient.setOperator(operatorId, operatorKey);\n\nconst transaction = new TransferTransaction()\n  .addHbarTransfer(operatorId, new Hbar(-1))\n  .addHbarTransfer(recipientId, new Hbar(1))\n  .setTransactionMemo(\"invoice 42\")\n  .setNodeAccountIds([AccountId.fromString(\"0.0.3\")])\n  .setTransactionId(operatorId, VALID_START);\n\nconst signedTransaction = await transaction.sign(operatorKey);\n\nconsole.log(signedTransaction.toBytes().toString(\"hex\"));\n","suffix":"","verb":"Creating","message":"src/transfer.ts","settledVerb":"Created","settledMessage":"src/transfer.ts","statusText":"Writing file"},"kind":"file_write","input":{"filePath":"src/transfer.ts","content":"import { Client, PrivateKey, AccountId, TransferTransaction, Hbar } from \"@hashgraph/sdk\";\nimport * as dotenv from \"dotenv\";\n\ndotenv.config();\n\nconst OPERATOR_ID = process.env.OPERATOR_ID!;\nconst OPERATOR_KEY = process.env.OPERATOR_KEY!;\nconst RECIPIENT_ID = process.env.RECIPIENT_ID!;\nconst VALID_START = parseInt(process.env.VALID_START!, 10);\n\nconst operatorKey = PrivateKey.fromBytes(Buffer.from(OPERATOR_KEY, \"hex\"));\nconst operatorId = AccountId.fromString(OPERATOR_ID);\nconst recipientId = AccountId.fromString(RECIPIENT_ID);\n\nconst client = Client.forTestnet();\nclient.setOperator(operatorId, operatorKey);\n\nconst transaction = new TransferTransaction()\n  .addHbarTransfer(operatorId, new Hbar(-1))\n  .addHbarTransfer(recipientId, new Hbar(1))\n  .setTransactionMemo(\"invoice 42\")\n  .setNodeAccountIds([AccountId.fromString(\"0.0.3\")])\n  .setTransactionId(operatorId, VALID_START);\n\nconst signedTransaction = await transaction.sign(operatorKey);\n\nconsole.log(signedTransaction.toBytes().toString(\"hex\"));\n"}},"state":{"status":"completed","outputText":"","approvalType":"always","approvalSource":"bypass","display":{"success":true,"verb":"Created","message":"src/transfer.ts","warnings":[],"approvalNote":null,"suffix":""},"durationMs":0.0,"output":{"filePath":"/private/tmp/h-cLQ3eE/src/transfer.ts","content":"import { Client, PrivateKey, AccountId, TransferTransaction, Hbar } from \"@hashgraph/sdk\";\nimport * as dotenv from \"dotenv\";\n\ndotenv.config();\n\nconst OPERATOR_ID = process.env.OPERATOR_ID!;\nconst OPERATOR_KEY = process.env.OPERATOR_KEY!;\nconst RECIPIENT_ID = process.env.RECIPIENT_ID!;\nconst VALID_START = parseInt(process.env.VALID_START!, 10);\n\nconst operatorKey = PrivateKey.fromBytes(Buffer.from(OPERATOR_KEY, \"hex\"));\nconst operatorId = AccountId.fromString(OPERATOR_ID);\nconst recipientId = AccountId.fromString(RECIPIENT_ID);\n\nconst client = Client.forTestnet();\nclient.setOperator(operatorId, operatorKey);\n\nconst transaction = new TransferTransaction()\n  .addHbarTransfer(operatorId, new Hbar(-1))\n  .addHbarTransfer(recipientId, new Hbar(1))\n  .setTransactionMemo(\"invoice 42\")\n  .setNodeAccountIds([AccountId.fromString(\"0.0.3\")])\n  .setTransactionId(operatorId, VALID_START);\n\nconst signedTransaction = await transaction.sign(operatorKey);\n\nconsole.log(signedTransaction.toBytes().toString(\"hex\"));\n","fileExisted":false,"previousContent":null},"decision":"execute"}}
