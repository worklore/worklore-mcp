 #!/usr/bin/env bash
 # usage: run.sh <task> <lane> [rep]
-# lanes: codex   Codex CLI, unsandboxed
-#        kimi    Kimi Code under sandbox/agent.sb (no reading or writing the real home), scratch HOME
+# lanes: codex            Codex CLI, unsandboxed
+#        codex-sandboxed  same Codex run under sandbox/agent.sb (no reading or writing the real home), scratch HOME
+#        kimi             Kimi Code under sandbox/agent.sb (no reading or writing the real home), scratch HOME
 set -u
 D="$(cd "$(dirname "$0")" && pwd)"
 T=$1; A=$2; REP=${3:-1}
@@ -15,6 +16,20 @@ codex_run() {
       -o "$R/final.txt" "$P" < /dev/null > "$R/agent.log" 2> "$R/agent.err" )
 }
 
+# The codex lane's run, inside the same fence as kimi. Codex keeps its login (auth.json) and config.toml in
+# $CODEX_HOME, so it gets a scratch CODEX_HOME with copies of those files; the real ~/.codex stays closed to the
+# sandbox, and the agent's shell (a child of codex) inherits the same profile.
+codex_sandboxed_run() {
+  local REAL="$HOME" SH CH f; SH=$(mktemp -d /tmp/khome-XXXXXX); CH="$SH/.codex"; mkdir -p "$CH"
+  for f in auth.json config.toml installation_id; do
+    [ -f "$REAL/.codex/$f" ] && cp "$REAL/.codex/$f" "$CH/$f"
+  done
+  ( cd "$W" && export HOME="$SH" CODEX_HOME="$CH" && sandbox-exec -D HOME="$REAL" -f "$D/sandbox/agent.sb" \
+      timeout $TO codex exec --skip-git-repo-check --dangerously-bypass-approvals-and-sandbox -C "$W" --json \
+      -o "$R/final.txt" "$P" < /dev/null > "$R/agent.log" 2> "$R/agent.err" )
+  local rc=$?; rm -rf "$SH"; return $rc
+}
+
 # Kimi's output goes to Moonshot: its shell runs under sandbox/agent.sb with an empty scratch HOME.
 kimi_run() {
   local REAL="$HOME" SH; SH=$(mktemp -d /tmp/khome-XXXXXX)
@@ -27,6 +42,7 @@ kimi_run() {
 start=$(date +%s)
 case $A in
   codex) codex_run;;
+  codex-sandboxed) codex_sandboxed_run;;
   kimi)  kimi_run;;
   *) echo "unknown lane $A"; exit 2;;
 esac
