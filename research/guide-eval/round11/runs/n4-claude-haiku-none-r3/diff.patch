@@ -1,7 +1,9 @@
 #!/usr/bin/env bash
 # usage: run.sh <task> <lane> [rep]
-# lanes: codex   Codex CLI, unsandboxed
-#        kimi    Kimi Code under sandbox/agent.sb (no reading or writing the real home), scratch HOME
+# lanes: codex            Codex CLI, unsandboxed
+#        codex-sandboxed  the same Codex run, inside sandbox/agent.sb (no reading or writing the real home),
+#                         scratch HOME; needs CODEX_API_KEY or CODEX_ACCESS_TOKEN in the environment
+#        kimi             Kimi Code under sandbox/agent.sb (no reading or writing the real home), scratch HOME
 set -u
 D="$(cd "$(dirname "$0")" && pwd)"
 T=$1; A=$2; REP=${3:-1}
@@ -9,10 +11,24 @@ R="$D/runs/$T-$A-r$REP"; rm -rf "$R"; mkdir -p "$R"
 W=$(mktemp -d /tmp/h-XXXXXX); cp -R "$D/tasks/$T/." "$W/"
 P="$(cat "$D/tasks/$T.prompt")"; printf '%s\n' "$P" > "$R/prompt.txt"
 TO=1200
+CODEX_CMD=(codex exec --skip-git-repo-check --dangerously-bypass-approvals-and-sandbox -C "$W" --json -o "$R/final.txt" "$P")
 
 codex_run() {
-  ( cd "$W" && timeout $TO codex exec --skip-git-repo-check --dangerously-bypass-approvals-and-sandbox -C "$W" --json \
-      -o "$R/final.txt" "$P" < /dev/null > "$R/agent.log" 2> "$R/agent.err" )
+  ( cd "$W" && timeout $TO "${CODEX_CMD[@]}" < /dev/null > "$R/agent.log" 2> "$R/agent.err" )
+}
+
+# Same Codex run, but its shell runs under sandbox/agent.sb with an empty scratch HOME (CODEX_HOME inside it).
+# Codex's own login (~/.codex/auth.json) sits in the real home, so it is out of reach here: the credential
+# must come from the environment.
+codex_sandboxed_run() {
+  if [ -z "${CODEX_API_KEY:-}${CODEX_ACCESS_TOKEN:-}" ]; then
+    echo "codex-sandboxed needs CODEX_API_KEY or CODEX_ACCESS_TOKEN in the environment" >&2; return 2
+  fi
+  local REAL="$HOME" SH; SH=$(mktemp -d /tmp/chome-XXXXXX); mkdir -p "$SH/.codex"
+  ( cd "$W" && export HOME="$SH" && sandbox-exec -D HOME="$REAL" -f "$D/sandbox/agent.sb" \
+      env CODEX_HOME="$SH/.codex" timeout $TO "${CODEX_CMD[@]}" \
+      < /dev/null > "$R/agent.log" 2> "$R/agent.err" )
+  local rc=$?; rm -rf "$SH"; return $rc
 }
 
 # Kimi's output goes to Moonshot: its shell runs under sandbox/agent.sb with an empty scratch HOME.
@@ -27,6 +43,7 @@ kimi_run() {
 start=$(date +%s)
 case $A in
   codex) codex_run;;
+  codex-sandboxed) codex_sandboxed_run;;
   kimi)  kimi_run;;
   *) echo "unknown lane $A"; exit 2;;
 esac
