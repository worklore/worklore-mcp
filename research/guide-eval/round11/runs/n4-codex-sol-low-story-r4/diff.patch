+++ b/run.sh
@@ -1,6 +1,7 @@
 #!/usr/bin/env bash
 # usage: run.sh <task> <lane> [rep]
 # lanes: codex   Codex CLI, unsandboxed
+#        codex-sandboxed   Codex CLI under sandbox/agent.sb, scratch HOME
 #        kimi    Kimi Code under sandbox/agent.sb (no reading or writing the real home), scratch HOME
 set -u
 D="$(cd "$(dirname "$0")" && pwd)"
@@ -15,10 +16,27 @@ codex_run() {
       -o "$R/final.txt" "$P" < /dev/null > "$R/agent.log" 2> "$R/agent.err" )
 }
 
+codex_sandboxed_run() {
+  local REAL="$HOME" SH rc
+  SH=$(mktemp -d /tmp/chome-XXXXXX)
+  ( cd "$W" && export HOME="$SH" && sandbox-exec -D HOME="$REAL" -D KIMI_HOME="$SH/kimi-code" -f "$D/sandbox/agent.sb" \
+      timeout $TO codex exec --skip-git-repo-check --dangerously-bypass-approvals-and-sandbox -C "$W" --json \
+      -o "$SH/final.txt" "$P" < /dev/null > "$R/agent.log" 2> "$R/agent.err" )
+  rc=$?
+  if [ -s "$SH/final.txt" ]; then
+    cp "$SH/final.txt" "$R/final.txt" || rc=1
+  else
+    printf '%s\n' 'Codex did not write a non-empty final.txt' >> "$R/agent.err"
+    rc=1
+  fi
+  rm -rf "$SH"
+  return "$rc"
+}
+
 # Kimi's output goes to Moonshot: its shell runs under sandbox/agent.sb with an empty scratch HOME.
 kimi_run() {
   local REAL="$HOME" SH; SH=$(mktemp -d /tmp/khome-XXXXXX)
-  ( cd "$W" && export HOME="$SH" && sandbox-exec -D HOME="$REAL" -f "$D/sandbox/agent.sb" \
+  ( cd "$W" && export HOME="$SH" && sandbox-exec -D HOME="$REAL" -D KIMI_HOME="$REAL/.kimi-code" -f "$D/sandbox/agent.sb" \
       env KIMI_CODE_HOME="$REAL/.kimi-code" timeout $TO "$REAL/.kimi-code/bin/kimi" -p "$P" --output-format stream-json \
       < /dev/null > "$R/agent.log" 2> "$R/agent.err" )
   local rc=$?; rm -rf "$SH"; return $rc
@@ -27,6 +45,7 @@ kimi_run() {
 start=$(date +%s)
 case $A in
   codex) codex_run;;
+  codex-sandboxed) codex_sandboxed_run;;
   kimi)  kimi_run;;
   *) echo "unknown lane $A"; exit 2;;
 esac
diff --git a/sandbox/agent.sb b/sandbox/agent.sb
index 3a517dd..aee4515 100644
--- a/sandbox/agent.sb
+++ b/sandbox/agent.sb
@@ -1,9 +1,10 @@
 ;; OS-level fence for lanes whose output leaves the machine: the agent has a real shell, so the real home must be
-;; unreachable. Only the agent's own install is opened. Network stays open. HOME is passed with -D HOME=<real home>.
+;; unreachable. Kimi's install is opened only for its lane. Network stays open.
+;; HOME and KIMI_HOME are passed with -D.
 (version 1)
 (allow default)
 (deny file-read-data (subpath (param "HOME")))
 (deny file-write* (subpath (param "HOME")))
-(allow file-read-data (subpath (string-append (param "HOME") "/.kimi-code")))
-(allow file-write* (subpath (string-append (param "HOME") "/.kimi-code")))
+(allow file-read-data (subpath (param "KIMI_HOME")))
+(allow file-write* (subpath (param "KIMI_HOME")))
 (deny process-exec (literal "/bin/launchctl") (literal "/usr/bin/security") (literal "/usr/bin/osascript"))
