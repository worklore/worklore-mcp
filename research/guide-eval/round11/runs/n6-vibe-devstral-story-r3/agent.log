{"id":"effect-f2f0b7bc-c017-5cd3-bbee-cd57649a390d","sessionId":"4390568b-7c27-6a77-dd8a-dfb9eb77de08","turnId":"turn-e2b64bf3224b8daf9aec9e8b9e72285c","inputEntryId":"user-turn-e2b64bf3224b8daf9aec9e8b9e72285c-1","createdAt":1794280978653,"updatedAt":1794280978660,"generationStatus":"completed","relatedEntryId":null,"type":"effect","title":"file_system.write_file","detail":{"toolName":"file_system.write_file","display":{"summary":"Writing src/transfer.ts","content":"import dotenv from 'dotenv';\nimport {\n  TransferTransaction,\n  PrivateKey,\n  TransactionId,\n  AccountId,\n  Hbar,\n} from '@hiero-ledger/sdk';\n\ndotenv.config();\n\nconst operatorId = AccountId.fromString(process.env.OPERATOR_ID!);\nconst operatorKey = PrivateKey.fromStringDer(process.env.OPERATOR_KEY!);\nconst recipientId = AccountId.fromString(process.env.RECIPIENT_ID!);\nconst validStart = new Date(Number(process.env.VALID_START!) * 1000);\n\nconst transaction = new TransferTransaction()\n  .setNodeAccountIds([AccountId.fromString('0.0.3')])\n  .setTransactionId(\n    TransactionId.withValidStart(operatorId, validStart)\n  )\n  .addHbarTransfer(operatorId, new Hbar(-1))\n  .addHbarTransfer(recipientId, new Hbar(1))\n  .setMemo('invoice 42');\n\nconst signed = transaction.sign(operatorKey);\n\nconsole.log(signed.toBytes().toString('hex'));\n","suffix":"","verb":"Creating","message":"src/transfer.ts","settledVerb":"Created","settledMessage":"src/transfer.ts","statusText":"Writing file"},"kind":"file_write","input":{"filePath":"src/transfer.ts","content":"import dotenv from 'dotenv';\nimport {\n  TransferTransaction,\n  PrivateKey,\n  TransactionId,\n  AccountId,\n  Hbar,\n} from '@hiero-ledger/sdk';\n\ndotenv.config();\n\nconst operatorId = AccountId.fromString(process.env.OPERATOR_ID!);\nconst operatorKey = PrivateKey.fromStringDer(process.env.OPERATOR_KEY!);\nconst recipientId = AccountId.fromString(process.env.RECIPIENT_ID!);\nconst validStart = new Date(Number(process.env.VALID_START!) * 1000);\n\nconst transaction = new TransferTransaction()\n  .setNodeAccountIds([AccountId.fromString('0.0.3')])\n  .setTransactionId(\n    TransactionId.withValidStart(operatorId, validStart)\n  )\n  .addHbarTransfer(operatorId, new Hbar(-1))\n  .addHbarTransfer(recipientId, new Hbar(1))\n  .setMemo('invoice 42');\n\nconst signed = transaction.sign(operatorKey);\n\nconsole.log(signed.toBytes().toString('hex'));\n"}},"state":{"status":"completed","outputText":"","approvalSource":"bypass","approvalType":"always","display":{"success":true,"verb":"Created","message":"src/transfer.ts","warnings":[],"approvalNote":null,"suffix":""},"decision":"execute","durationMs":0.0,"output":{"filePath":"/private/tmp/h-B2q9Wu/src/transfer.ts","content":"import dotenv from 'dotenv';\nimport {\n  TransferTransaction,\n  PrivateKey,\n  TransactionId,\n  AccountId,\n  Hbar,\n} from '@hiero-ledger/sdk';\n\ndotenv.config();\n\nconst operatorId = AccountId.fromString(process.env.OPERATOR_ID!);\nconst operatorKey = PrivateKey.fromStringDer(process.env.OPERATOR_KEY!);\nconst recipientId = AccountId.fromString(process.env.RECIPIENT_ID!);\nconst validStart = new Date(Number(process.env.VALID_START!) * 1000);\n\nconst transaction = new TransferTransaction()\n  .setNodeAccountIds([AccountId.fromString('0.0.3')])\n  .setTransactionId(\n    TransactionId.withValidStart(operatorId, validStart)\n  )\n  .addHbarTransfer(operatorId, new Hbar(-1))\n  .addHbarTransfer(recipientId, new Hbar(1))\n  .setMemo('invoice 42');\n\nconst signed = transaction.sign(operatorKey);\n\nconsole.log(signed.toBytes().toString('hex'));\n","fileExisted":false,"previousContent":null}}}
