{"id":"effect-5007d786-d7ce-589a-8973-1c264d315f67","sessionId":"15c663ee-8270-876f-bcef-07959d3aba3d","turnId":"turn-2462993a4504c5012198995a17087423","inputEntryId":"user-turn-2462993a4504c5012198995a17087423-1","createdAt":1794276743601,"updatedAt":1794276743614,"generationStatus":"completed","relatedEntryId":null,"type":"effect","title":"file_system.read_file","detail":{"toolName":"file_system.read_file","display":{"summary":"Reading .","content":null,"suffix":"","verb":"Reading","message":".","settledVerb":"Read","settledMessage":".","statusText":"Reading file"},"kind":"file_read","input":{"filePath":".","offset":null,"limit":2000}},"state":{"status":"completed","outputText":"","durationMs":0.0,"approvalType":"always","decision":"execute","approvalSource":"bypass","output":{"filePath":"/private/tmp/h-mdo2mt","content":".git/\nNOTES.md\nREADME.md\nbot.py\ndata/\nlogs/\n","numLines":6,"startLine":1,"requestedOffset":null,"requestedLimit":2000,"totalLines":null,"wasTruncated":false},"display":{"success":true,"verb":"Read","message":"6 lines from h-mdo2mt","warnings":[],"approvalNote":null,"suffix":""}}}
{"id":"effect-ee288603-2c3c-5f95-9edb-9b711ff3ffcd","sessionId":"15c663ee-8270-876f-bcef-07959d3aba3d","turnId":"turn-2462993a4504c5012198995a17087423","inputEntryId":"user-turn-2462993a4504c5012198995a17087423-1","createdAt":1794276746233,"updatedAt":1794276746245,"generationStatus":"completed","relatedEntryId":null,"type":"effect","title":"file_system.read_file","detail":{"toolName":"file_system.read_file","display":{"summary":"Reading bot.py","content":null,"suffix":"","verb":"Reading","message":"bot.py","settledVerb":"Read","settledMessage":"bot.py","statusText":"Reading file"},"kind":"file_read","input":{"filePath":"bot.py","offset":null,"limit":2000}},"state":{"status":"completed","outputText":"","durationMs":0.0,"approvalType":"always","decision":"execute","approvalSource":"bypass","output":{"filePath":"/private/tmp/h-mdo2mt/bot.py","content":"\"\"\"Coach bot: a stateless endurance-coaching chat on Claude.\n\nEvery incoming message is a fresh request: we rebuild the system prompt from\nthe athlete record, pick the tools the message might need, and run a short\ntool-use loop. Nothing is kept between messages except what is written to\ndata/athletes.json (the athlete's profile and long-term facts).\n\"\"\"\nimport json\nimport os\nimport sys\nimport datetime as dt\nfrom dataclasses import dataclass, field, asdict\n\nMODEL = \"claude-sonnet-4-5\"\nMAX_TOKENS = 700\nMAX_TOOL_ROUNDS = 5\nATHLETES_FILE = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"data\", \"athletes.json\")\nUSAGE_LOG = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"logs\", \"usage.jsonl\")\n\n# --------------------------------------------------------------------------- LLM\ntry:\n    import anthropic\n\n    class LLM:\n        \"\"\"Thin wrapper so the rest of the file reads the same with or without the SDK.\"\"\"\n        def __init__(self):\n            self._client = anthropic.Anthropic(api_key=os.environ[\"COACH_ANTHROPIC_KEY\"])\n\n        def create(self, **kw):\n            return self._client.messages.create(**kw)\nexcept ImportError:  # the code is readable and importable without the SDK\n    class LLM:\n        def __init__(self):\n            raise RuntimeError(\"anthropic SDK not installed: pip install anthropic\")\n\n        def create(self, **kw):\n            raise RuntimeError(\"anthropic SDK not installed\")\n\n# --------------------------------------------------------------------------- athlete record\n@dataclass\nclass Athlete:\n    user_id: str\n    name: str\n    lang: str = \"en\"\n    sport: str = \"running\"\n    goal: str = \"finish a half marathon\"\n    zones: dict = field(default_factory=lambda: {\"Z1\": \"<135\", \"Z2\": \"135-150\", \"Z3\": \"150-162\", \"Z4\": \"162-172\", \"Z5\": \">172\"})\n    facts: list = field(default_factory=list)   # long-term memory, grows via save_fact\n\n\ndef _load_all():\n    try:\n        with open(ATHLETES_FILE) as f:\n            return json.load(f)\n    except FileNotFoundError:\n        return {}\n\n\ndef load_athlete(user_id):\n    raw = _load_all().get(str(user_id))\n    if raw is None:\n        return Athlete(user_id=str(user_id), name=\"athlete\")\n    return Athlete(**raw)\n\n\ndef save_athlete(a):\n    allrec = _load_all()\n    allrec[a.user_id] = asdict(a)\n    os.makedirs(os.path.dirname(ATHLETES_FILE), exist_ok=True)\n    with open(ATHLETES_FILE, \"w\") as f:\n        json.dump(allrec, f, indent=1, ensure_ascii=False)\n\n# --------------------------------------------------------------------------- system prompt\nINSTRUCTIONS = \"\"\"You are Pace, an endurance coach for recreational runners and cyclists.\n\nCoaching rules:\n1. Answer the question that was asked before adding anything else.\n2. Keep replies short: a chat message, not an article. Three paragraphs at most.\n3. Prescribe training by heart-rate zone or RPE, never by pace, unless the athlete asks for pace.\n4. Use the athlete's own zones from the profile below; never invent zone boundaries.\n5. Easy days are easy: anything labelled recovery or Z1/Z2 must stay there.\n6. Never add more than 10% weekly volume over the previous week.\n7. One hard session per week for beginners, two for athletes with 3+ years of training.\n8. A rest day is a session. Do not fill it.\n9. If the athlete reports pain (not soreness) lasting more than two days, stop the plan and say to see a physio.\n10. Do not diagnose injuries or illness. Do not give medication advice.\n11. Fuelling: 30-60 g carbs per hour for sessions over 75 minutes; mention it only when relevant.\n12. Sleep and stress count as training load. Ask about them when the athlete looks flat.\n13. Before a goal race, the last hard session is 7-10 days out. Taper means less volume, same intensity.\n14. Do not change the athlete's goal unless they ask. Mention the goal when a question is clearly off-plan.\n15. When the athlete tells you something durable about themselves (injury history, schedule, preferences,\n    equipment, races booked), call save_fact once with a single sentence. Do not save moods or one-off plans.\n16. Do not save a fact that is already in the list below.\n17. Use the plan_week tool for any weekly structure; do not write a week by hand.\n18. Use log_session when the athlete reports a completed workout, then comment on it.\n19. If asked for numbers you do not have (recent volume, last race), ask one question, do not guess.\n20. Metric units unless the profile says otherwise.\n\nTone:\n- Warm, direct, no exclamation marks.\n- No motivational quotes.\n- Address the athlete by first name at most once per reply.\n- Reply in the athlete's language from the profile below, even if they write in another language.\n\nSafety:\n- Never advise training through chest pain, dizziness or fever.\n- Minors: refer to a coach in person.\n- If someone asks for weight-loss plans below 1500 kcal per day, decline and suggest a dietitian.\n\nFormatting:\n- Plain text. No markdown headings, no tables.\n- Lists only for a session structure (warm-up / main / cool-down).\n- Numbers with units: 45 min, 12 km, 150 bpm.\n\"\"\"\n\n\ndef athlete_context(a, today):\n    lines = [\n        f\"Today: {today.isoformat()} ({today.strftime('%A')})\",\n        f\"Athlete: {a.name} (id {a.user_id}), sport: {a.sport}\",\n        \"Zones: \" + \", \".join(f\"{k} {v}\" for k, v in a.zones.items()),\n        f\"Goal: {a.goal}\",\n        \"Long-term facts:\",\n    ]\n    lines += [f\"- {f}\" for f in a.facts] or [\"- (none yet)\"]\n    lines.append(f\"Language: {a.lang}\")\n    return \"\\n\".join(lines)\n\n\ndef build_system(a, today):\n    # One block, cached as a whole: instructions + per-athlete context.\n    text = INSTRUCTIONS + \"\\n\\n\" + athlete_context(a, today)\n    return [{\"type\": \"text\", \"text\": text, \"cache_control\": {\"type\": \"ephemeral\"}}]\n\n# --------------------------------------------------------------------------- tools\nCORE_TOOLS = [\n    {\"name\": \"save_fact\", \"description\": \"Remember one durable fact about the athlete.\",\n     \"input_schema\": {\"type\": \"object\", \"properties\": {\"fact\": {\"type\": \"string\"}}, \"required\": [\"fact\"]}},\n    {\"name\": \"log_session\", \"description\": \"Record a completed workout.\",\n     \"input_schema\": {\"type\": \"object\", \"properties\": {\"minutes\": {\"type\": \"integer\"}, \"rpe\": {\"type\": \"integer\"},\n                                                       \"note\": {\"type\": \"string\"}}, \"required\": [\"minutes\"]}},\n]\nTOOL_GROUPS = {\n    \"plan\": ((\"plan\", \"week\", \"schedule\", \"taper\", \"build\"), [\n        {\"name\": \"plan_week\", \"description\": \"Draft a week of sessions.\",\n         \"input_schema\": {\"type\": \"object\", \"properties\": {\"hours\": {\"type\": \"number\"}, \"hard_days\": {\"type\": \"integer\"}},\n                          \"required\": [\"hours\"]}}]),\n    \"race\": ((\"race\", \"pace\", \"predict\", \"finish time\"), [\n        {\"name\": \"predict_race\", \"description\": \"Estimate a finish time from a recent effort.\",\n         \"input_schema\": {\"type\": \"object\", \"properties\": {\"distance_km\": {\"type\": \"number\"}, \"recent_minutes\": {\"type\": \"number\"}},\n                          \"required\": [\"distance_km\"]}}]),\n}\n\n\ndef select_tools(text):\n    \"\"\"Core tools always; a group is added only when the message mentions its keywords.\"\"\"\n    tools = list(CORE_TOOLS)\n    low = text.lower()\n    for _, (keys, group) in TOOL_GROUPS.items():\n        if any(k in low for k in keys):\n            tools += group\n    return tools\n\n\ndef run_tool(a, name, args):\n    if name == \"save_fact\":\n        a.facts.append(args[\"fact\"].strip())\n        save_athlete(a)\n        return \"saved\"\n    if name == \"log_session\":\n        return f\"logged {args.get('minutes')} min\"\n    if name == \"plan_week\":\n        return json.dumps({\"hours\": args[\"hours\"], \"hard_days\": args.get(\"hard_days\", 1), \"sessions\": [\"Mon rest\", \"Tue Z2 45 min\", \"...\"]})\n    if name == \"predict_race\":\n        return json.dumps({\"distance_km\": args[\"distance_km\"], \"estimate_min\": round(args.get(\"recent_minutes\", 50) * 2.1)})\n    return f\"unknown tool {name}\"\n\n# --------------------------------------------------------------------------- the per-message loop\ndef log_usage(usage, user_id, round_no, tool=None):\n    rec = {\"ts\": dt.datetime.now(dt.timezone.utc).isoformat(timespec=\"seconds\"), \"user\": user_id, \"round\": round_no,\n           \"input_tokens\": usage.input_tokens, \"cache_creation_input_tokens\": usage.cache_creation_input_tokens,\n           \"cache_read_input_tokens\": usage.cache_read_input_tokens, \"output_tokens\": usage.output_tokens}\n    if tool:\n        rec[\"tool\"] = tool\n    os.makedirs(os.path.dirname(USAGE_LOG), exist_ok=True)\n    with open(USAGE_LOG, \"a\") as f:\n        f.write(json.dumps(rec) + \"\\n\")\n\n\ndef build_request(a, messages, tools, today):\n    return {\"model\": MODEL, \"max_tokens\": MAX_TOKENS, \"system\": build_system(a, today), \"tools\": tools, \"messages\": messages}\n\n\ndef reply(user_id, text, llm=None):\n    llm = llm or LLM()\n    a = load_athlete(user_id)\n    today = dt.date.today()\n    tools = select_tools(text)\n    messages = [{\"role\": \"user\", \"content\": text}]\n    for round_no in range(1, MAX_TOOL_ROUNDS + 1):\n        resp = llm.create(**build_request(a, messages, tools, today))\n        used_tools = [b.name for b in resp.content if b.type == \"tool_use\"]\n        log_usage(resp.usage, a.user_id, round_no, tool=\",\".join(used_tools) or None)\n        if resp.stop_reason != \"tool_use\":\n            return \"\".join(b.text for b in resp.content if b.type == \"text\")\n        messages.append({\"role\": \"assistant\", \"content\": [b.model_dump() for b in resp.content]})\n        results = [{\"type\": \"tool_result\", \"tool_use_id\": b.id, \"content\": run_tool(a, b.name, b.input)}\n                   for b in resp.content if b.type == \"tool_use\"]\n        messages.append({\"role\": \"user\", \"content\": results})\n    return \"Sorry, I lost the thread. Ask me again?\"\n\n\nif __name__ == \"__main__\":\n    # Local chat: python3 bot.py <user_id>; Telegram long-polling lives in telegram.py (not in this repo).\n    uid = sys.argv[1] if len(sys.argv) > 1 else \"42\"\n    for line in sys.stdin:\n        print(reply(uid, line.strip()))\n","numLines":217,"startLine":1,"requestedOffset":null,"requestedLimit":2000,"totalLines":null,"wasTruncated":false},"display":{"success":true,"verb":"Read","message":"217 lines from bot.py","warnings":[],"approvalNote":null,"suffix":""}}}
{"id":"assistant-a4ccc30a-1856-564f-b3e0-888a6d803fce","sessionId":"15c663ee-8270-876f-bcef-07959d3aba3d","turnId":"turn-2462993a4504c5012198995a17087423","inputEntryId":"user-turn-2462993a4504c5012198995a17087423-1","createdAt":1794276748564,"updatedAt":1794276748564,"generationStatus":"completed","relatedEntryId":null,"type":"message","role":"assistant","content":[{"type":"text","text":"Now I can see the issue. The `build_system` function creates a single cache block that combines both the static `INSTRUCTIONS` and the volatile `athlete_context`. According to the colleague's note, we need to split this into two separate cache blocks so that memory writes (which change the athlete context) don't evict the static instructions from the cache.\n\nLet me also check the README and NOTES to understand the context better:"}],"source":"harness","userDisplayContent":null,"outcome":{"type":"committed"}}
{"id":"effect-0505986c-7ce3-535b-96ea-e74f1e8d52bc","sessionId":"15c663ee-8270-876f-bcef-07959d3aba3d","turnId":"turn-2462993a4504c5012198995a17087423","inputEntryId":"user-turn-2462993a4504c5012198995a17087423-1","createdAt":1794276748568,"updatedAt":1794276748577,"generationStatus":"completed","relatedEntryId":null,"type":"effect","title":"file_system.read_file","detail":{"toolName":"file_system.read_file","display":{"summary":"Reading README.md","content":null,"suffix":"","verb":"Reading","message":"README.md","settledVerb":"Read","settledMessage":"README.md","statusText":"Reading file"},"kind":"file_read","input":{"filePath":"README.md","offset":null,"limit":2000}},"state":{"status":"completed","outputText":"","durationMs":0.0,"approvalType":"always","decision":"execute","approvalSource":"bypass","output":{"filePath":"/private/tmp/h-mdo2mt/README.md","content":"# pace-bot\n\nA coaching chat bot on Claude for a small running/cycling club. It is stateless\nby design: each message rebuilds the system prompt (coaching rules + the athlete's\nprofile, zones, goal and long-term facts from `data/athletes.json`), picks the tools\nthe message might need (`save_fact` and `log_session` always, planning or race tools\nwhen keywords match) and runs a short tool-use loop. `save_fact` is how the bot\nremembers durable things an athlete tells it; the next message sees the fact in\nits system prompt. Every API call appends its `usage` object to `logs/usage.jsonl`.\n\nRun it locally with `COACH_ANTHROPIC_KEY=sk-ant-... python3 bot.py 42` and type\nmessages on stdin (the Telegram long-polling transport, which needs\n`COACH_TELEGRAM_TOKEN`, lives in a separate deploy repo and just calls `reply()`).\nRequires Python 3.11+ and `pip install anthropic`. Prompt caching is on: the system\nprompt carries a `cache_control` marker so the tool-loop rounds and follow-up\nmessages inside the 5-minute window read it from cache.\n","numLines":16,"startLine":1,"requestedOffset":null,"requestedLimit":2000,"totalLines":null,"wasTruncated":false},"display":{"success":true,"verb":"Read","message":"16 lines from README.md","warnings":[],"approvalNote":null,"suffix":""}}}
{"id":"effect-745117d8-79bd-5cc7-820e-45a85f498a6e","sessionId":"15c663ee-8270-876f-bcef-07959d3aba3d","turnId":"turn-2462993a4504c5012198995a17087423","inputEntryId":"user-turn-2462993a4504c5012198995a17087423-1","createdAt":1794276749952,"updatedAt":1794276749969,"generationStatus":"completed","relatedEntryId":null,"type":"effect","title":"file_system.read_file","detail":{"toolName":"file_system.read_file","display":{"summary":"Reading NOTES.md","content":null,"suffix":"","verb":"Reading","message":"NOTES.md","settledVerb":"Read","settledMessage":"NOTES.md","statusText":"Reading file"},"kind":"file_read","input":{"filePath":"NOTES.md","offset":null,"limit":2000}},"state":{"status":"completed","outputText":"","durationMs":0.0,"approvalType":"always","decision":"execute","approvalSource":"bypass","output":{"filePath":"/private/tmp/h-mdo2mt/NOTES.md","content":"# Notes\n\n## 2026-04-20 — bill doubled since memory shipped\n\nInput spend roughly doubled in the week after `save_fact` went live (2026-04-13),\nwith the same number of messages per day. `logs/usage.jsonl` shows it: on a normal\nmessage the loop rounds and the next message read ~1000 tokens from cache, but\nevery call right after a `save_fact` has `cache_read_input_tokens: 0` and\n`cache_creation_input_tokens` ~1000 again. Athletes tell the bot things about\nthemselves a lot in their first week, so this happens several times per chat.\n\nTried: shorter facts (no change), capping facts at 20 (no change, the number of\nfacts is not the problem). Tool filtering by keyword is from March and was a clear\nwin (~75% fewer tool tokens on short messages); leave it.\n","numLines":14,"startLine":1,"requestedOffset":null,"requestedLimit":2000,"totalLines":null,"wasTruncated":false},"display":{"success":true,"verb":"Read","message":"14 lines from NOTES.md","warnings":[],"approvalNote":null,"suffix":""}}}
{"id":"assistant-c5cd6430-c707-5cf6-a36e-3348fa377958","sessionId":"15c663ee-8270-876f-bcef-07959d3aba3d","turnId":"turn-2462993a4504c5012198995a17087423","inputEntryId":"user-turn-2462993a4504c5012198995a17087423-1","createdAt":1794276753441,"updatedAt":1794276753441,"generationStatus":"completed","relatedEntryId":null,"type":"message","role":"assistant","content":[{"type":"text","text":"Now I understand the problem clearly. The issue is in the `build_system` function in `bot.py`. Currently, it creates a single cache block that combines both static instructions and volatile athlete context. When `save_fact` is called, it modifies the athlete's facts, which changes the athlete context, which in turn changes the entire cached block, evicting the static instructions from the cache.\n\nThe fix is to split the system prompt into two separate cache blocks:\n1. Static instructions (never changes)\n2. Volatile athlete context (changes with memory writes)\n\nLet me implement this fix:"}],"source":"harness","userDisplayContent":null,"outcome":{"type":"committed"}}
{"id":"effect-44e7412b-c315-5810-86b6-77fd4f48a16a","sessionId":"15c663ee-8270-876f-bcef-07959d3aba3d","turnId":"turn-2462993a4504c5012198995a17087423","inputEntryId":"user-turn-2462993a4504c5012198995a17087423-1","createdAt":1794276753467,"updatedAt":1794276753493,"generationStatus":"completed","relatedEntryId":null,"type":"effect","title":"file_system.edit","detail":{"toolName":"file_system.edit","display":{"summary":"Editing bot.py","content":null,"suffix":"","verb":"Editing","message":"bot.py","settledVerb":"Edited","settledMessage":"bot.py","statusText":"Editing file"},"kind":"file_edit","input":{"filePath":"bot.py","oldString":"def build_system(a, today):\n    # One block, cached as a whole: instructions + per-athlete context.\n    text = INSTRUCTIONS + \"\\n\\n\" + athlete_context(a, today)\n    return [{\"type\": \"text\", \"text\": text, \"cache_control\": {\"type\": \"ephemeral\"}}]","newString":"def build_system(a, today):\n    # Two cache blocks: static instructions (byte-stable) and volatile athlete context.\n    # This way, a memory write (save_fact) only invalidates the tail, not the static prefix.\n    return [\n        {\"type\": \"text\", \"text\": INSTRUCTIONS, \"cache_control\": {\"type\": \"ephemeral\"}},\n        {\"type\": \"text\", \"text\": athlete_context(a, today), \"cache_control\": {\"type\": \"ephemeral\"}},\n    ]","replaceAll":false}},"state":{"status":"completed","outputText":"","durationMs":0.0,"approvalType":"always","decision":"execute","approvalSource":"bypass","output":{"file":"/private/tmp/h-mdo2mt/bot.py","oldString":null,"newString":null,"occurrences":[{"startLine":130,"newStartLine":130,"oldText":"def build_system(a, today):\n    # One block, cached as a whole: instructions + per-athlete context.\n    text = INSTRUCTIONS + \"\\n\\n\" + athlete_context(a, today)\n    return [{\"type\": \"text\", \"text\": text, \"cache_control\": {\"type\": \"ephemeral\"}}]","newText":"def build_system(a, today):\n    # Two cache blocks: static instructions (byte-stable) and volatile athlete context.\n    # This way, a memory write (save_fact) only invalidates the tail, not the static prefix.\n    return [\n        {\"type\": \"text\", \"text\": INSTRUCTIONS, \"cache_control\": {\"type\": \"ephemeral\"}},\n        {\"type\": \"text\", \"text\": athlete_context(a, today), \"cache_control\": {\"type\": \"ephemeral\"}},\n    ]"}],"previousContent":"\"\"\"Coach bot: a stateless endurance-coaching chat on Claude.\n\nEvery incoming message is a fresh request: we rebuild the system prompt from\nthe athlete record, pick the tools the message might need, and run a short\ntool-use loop. Nothing is kept between messages except what is written to\ndata/athletes.json (the athlete's profile and long-term facts).\n\"\"\"\nimport json\nimport os\nimport sys\nimport datetime as dt\nfrom dataclasses import dataclass, field, asdict\n\nMODEL = \"claude-sonnet-4-5\"\nMAX_TOKENS = 700\nMAX_TOOL_ROUNDS = 5\nATHLETES_FILE = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"data\", \"athletes.json\")\nUSAGE_LOG = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"logs\", \"usage.jsonl\")\n\n# --------------------------------------------------------------------------- LLM\ntry:\n    import anthropic\n\n    class LLM:\n        \"\"\"Thin wrapper so the rest of the file reads the same with or without the SDK.\"\"\"\n        def __init__(self):\n            self._client = anthropic.Anthropic(api_key=os.environ[\"COACH_ANTHROPIC_KEY\"])\n\n        def create(self, **kw):\n            return self._client.messages.create(**kw)\nexcept ImportError:  # the code is readable and importable without the SDK\n    class LLM:\n        def __init__(self):\n            raise RuntimeError(\"anthropic SDK not installed: pip install anthropic\")\n\n        def create(self, **kw):\n            raise RuntimeError(\"anthropic SDK not installed\")\n\n# --------------------------------------------------------------------------- athlete record\n@dataclass\nclass Athlete:\n    user_id: str\n    name: str\n    lang: str = \"en\"\n    sport: str = \"running\"\n    goal: str = \"finish a half marathon\"\n    zones: dict = field(default_factory=lambda: {\"Z1\": \"<135\", \"Z2\": \"135-150\", \"Z3\": \"150-162\", \"Z4\": \"162-172\", \"Z5\": \">172\"})\n    facts: list = field(default_factory=list)   # long-term memory, grows via save_fact\n\n\ndef _load_all():\n    try:\n        with open(ATHLETES_FILE) as f:\n            return json.load(f)\n    except FileNotFoundError:\n        return {}\n\n\ndef load_athlete(user_id):\n    raw = _load_all().get(str(user_id))\n    if raw is None:\n        return Athlete(user_id=str(user_id), name=\"athlete\")\n    return Athlete(**raw)\n\n\ndef save_athlete(a):\n    allrec = _load_all()\n    allrec[a.user_id] = asdict(a)\n    os.makedirs(os.path.dirname(ATHLETES_FILE), exist_ok=True)\n    with open(ATHLETES_FILE, \"w\") as f:\n        json.dump(allrec, f, indent=1, ensure_ascii=False)\n\n# --------------------------------------------------------------------------- system prompt\nINSTRUCTIONS = \"\"\"You are Pace, an endurance coach for recreational runners and cyclists.\n\nCoaching rules:\n1. Answer the question that was asked before adding anything else.\n2. Keep replies short: a chat message, not an article. Three paragraphs at most.\n3. Prescribe training by heart-rate zone or RPE, never by pace, unless the athlete asks for pace.\n4. Use the athlete's own zones from the profile below; never invent zone boundaries.\n5. Easy days are easy: anything labelled recovery or Z1/Z2 must stay there.\n6. Never add more than 10% weekly volume over the previous week.\n7. One hard session per week for beginners, two for athletes with 3+ years of training.\n8. A rest day is a session. Do not fill it.\n9. If the athlete reports pain (not soreness) lasting more than two days, stop the plan and say to see a physio.\n10. Do not diagnose injuries or illness. Do not give medication advice.\n11. Fuelling: 30-60 g carbs per hour for sessions over 75 minutes; mention it only when relevant.\n12. Sleep and stress count as training load. Ask about them when the athlete looks flat.\n13. Before a goal race, the last hard session is 7-10 days out. Taper means less volume, same intensity.\n14. Do not change the athlete's goal unless they ask. Mention the goal when a question is clearly off-plan.\n15. When the athlete tells you something durable about themselves (injury history, schedule, preferences,\n    equipment, races booked), call save_fact once with a single sentence. Do not save moods or one-off plans.\n16. Do not save a fact that is already in the list below.\n17. Use the plan_week tool for any weekly structure; do not write a week by hand.\n18. Use log_session when the athlete reports a completed workout, then comment on it.\n19. If asked for numbers you do not have (recent volume, last race), ask one question, do not guess.\n20. Metric units unless the profile says otherwise.\n\nTone:\n- Warm, direct, no exclamation marks.\n- No motivational quotes.\n- Address the athlete by first name at most once per reply.\n- Reply in the athlete's language from the profile below, even if they write in another language.\n\nSafety:\n- Never advise training through chest pain, dizziness or fever.\n- Minors: refer to a coach in person.\n- If someone asks for weight-loss plans below 1500 kcal per day, decline and suggest a dietitian.\n\nFormatting:\n- Plain text. No markdown headings, no tables.\n- Lists only for a session structure (warm-up / main / cool-down).\n- Numbers with units: 45 min, 12 km, 150 bpm.\n\"\"\"\n\n\ndef athlete_context(a, today):\n    lines = [\n        f\"Today: {today.isoformat()} ({today.strftime('%A')})\",\n        f\"Athlete: {a.name} (id {a.user_id}), sport: {a.sport}\",\n        \"Zones: \" + \", \".join(f\"{k} {v}\" for k, v in a.zones.items()),\n        f\"Goal: {a.goal}\",\n        \"Long-term facts:\",\n    ]\n    lines += [f\"- {f}\" for f in a.facts] or [\"- (none yet)\"]\n    lines.append(f\"Language: {a.lang}\")\n    return \"\\n\".join(lines)\n\n\ndef build_system(a, today):\n    # One block, cached as a whole: instructions + per-athlete context.\n    text = INSTRUCTIONS + \"\\n\\n\" + athlete_context(a, today)\n    return [{\"type\": \"text\", \"text\": text, \"cache_control\": {\"type\": \"ephemeral\"}}]\n\n# --------------------------------------------------------------------------- tools\nCORE_TOOLS = [\n    {\"name\": \"save_fact\", \"description\": \"Remember one durable fact about the athlete.\",\n     \"input_schema\": {\"type\": \"object\", \"properties\": {\"fact\": {\"type\": \"string\"}}, \"required\": [\"fact\"]}},\n    {\"name\": \"log_session\", \"description\": \"Record a completed workout.\",\n     \"input_schema\": {\"type\": \"object\", \"properties\": {\"minutes\": {\"type\": \"integer\"}, \"rpe\": {\"type\": \"integer\"},\n                                                       \"note\": {\"type\": \"string\"}}, \"required\": [\"minutes\"]}},\n]\nTOOL_GROUPS = {\n    \"plan\": ((\"plan\", \"week\", \"schedule\", \"taper\", \"build\"), [\n        {\"name\": \"plan_week\", \"description\": \"Draft a week of sessions.\",\n         \"input_schema\": {\"type\": \"object\", \"properties\": {\"hours\": {\"type\": \"number\"}, \"hard_days\": {\"type\": \"integer\"}},\n                          \"required\": [\"hours\"]}}]),\n    \"race\": ((\"race\", \"pace\", \"predict\", \"finish time\"), [\n        {\"name\": \"predict_race\", \"description\": \"Estimate a finish time from a recent effort.\",\n         \"input_schema\": {\"type\": \"object\", \"properties\": {\"distance_km\": {\"type\": \"number\"}, \"recent_minutes\": {\"type\": \"number\"}},\n                          \"required\": [\"distance_km\"]}}]),\n}\n\n\ndef select_tools(text):\n    \"\"\"Core tools always; a group is added only when the message mentions its keywords.\"\"\"\n    tools = list(CORE_TOOLS)\n    low = text.lower()\n    for _, (keys, group) in TOOL_GROUPS.items():\n        if any(k in low for k in keys):\n            tools += group\n    return tools\n\n\ndef run_tool(a, name, args):\n    if name == \"save_fact\":\n        a.facts.append(args[\"fact\"].strip())\n        save_athlete(a)\n        return \"saved\"\n    if name == \"log_session\":\n        return f\"logged {args.get('minutes')} min\"\n    if name == \"plan_week\":\n        return json.dumps({\"hours\": args[\"hours\"], \"hard_days\": args.get(\"hard_days\", 1), \"sessions\": [\"Mon rest\", \"Tue Z2 45 min\", \"...\"]})\n    if name == \"predict_race\":\n        return json.dumps({\"distance_km\": args[\"distance_km\"], \"estimate_min\": round(args.get(\"recent_minutes\", 50) * 2.1)})\n    return f\"unknown tool {name}\"\n\n# --------------------------------------------------------------------------- the per-message loop\ndef log_usage(usage, user_id, round_no, tool=None):\n    rec = {\"ts\": dt.datetime.now(dt.timezone.utc).isoformat(timespec=\"seconds\"), \"user\": user_id, \"round\": round_no,\n           \"input_tokens\": usage.input_tokens, \"cache_creation_input_tokens\": usage.cache_creation_input_tokens,\n           \"cache_read_input_tokens\": usage.cache_read_input_tokens, \"output_tokens\": usage.output_tokens}\n    if tool:\n        rec[\"tool\"] = tool\n    os.makedirs(os.path.dirname(USAGE_LOG), exist_ok=True)\n    with open(USAGE_LOG, \"a\") as f:\n        f.write(json.dumps(rec) + \"\\n\")\n\n\ndef build_request(a, messages, tools, today):\n    return {\"model\": MODEL, \"max_tokens\": MAX_TOKENS, \"system\": build_system(a, today), \"tools\": tools, \"messages\": messages}\n\n\ndef reply(user_id, text, llm=None):\n    llm = llm or LLM()\n    a = load_athlete(user_id)\n    today = dt.date.today()\n    tools = select_tools(text)\n    messages = [{\"role\": \"user\", \"content\": text}]\n    for round_no in range(1, MAX_TOOL_ROUNDS + 1):\n        resp = llm.create(**build_request(a, messages, tools, today))\n        used_tools = [b.name for b in resp.content if b.type == \"tool_use\"]\n        log_usage(resp.usage, a.user_id, round_no, tool=\",\".join(used_tools) or None)\n        if resp.stop_reason != \"tool_use\":\n            return \"\".join(b.text for b in resp.content if b.type == \"text\")\n        messages.append({\"role\": \"assistant\", \"content\": [b.model_dump() for b in resp.content]})\n        results = [{\"type\": \"tool_result\", \"tool_use_id\": b.id, \"content\": run_tool(a, b.name, b.input)}\n                   for b in resp.content if b.type == \"tool_use\"]\n        messages.append({\"role\": \"user\", \"content\": results})\n    return \"Sorry, I lost the thread. Ask me again?\"\n\n\nif __name__ == \"__main__\":\n    # Local chat: python3 bot.py <user_id>; Telegram long-polling lives in telegram.py (not in this repo).\n    uid = sys.argv[1] if len(sys.argv) > 1 else \"42\"\n    for line in sys.stdin:\n        print(reply(uid, line.strip()))\n"},"display":{"success":true,"verb":"Edited","message":"bot.py","warnings":[],"approvalNote":null,"suffix":""}}}
