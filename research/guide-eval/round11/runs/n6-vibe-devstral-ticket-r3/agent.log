s.env.VALID_START!, 10);\n\nconst transaction = new TransferTransaction()\n  .setNodeAccountIds([AccountId.fromString(\"0.0.3\")])\n  .addHbarTransfer(operatorId, new Hbar(-1))\n  .addHbarTransfer(recipientId, new Hbar(1))\n  .setTransactionId(\n    TransactionId.withValidStart(\n      operatorId,\n      validStart\n    )\n  )\n  .setTransactionMemo(\"invoice 42\");\n\nconst signedTransaction = transaction.sign(operatorKey);\n\nconsole.log(signedTransaction.toBytes().toString(\"hex\"));\n"}},"state":{"status":"completed","outputText":"","display":{"success":true,"verb":"Created","message":"src/transfer.ts","warnings":[],"approvalNote":null,"suffix":""},"durationMs":0.0,"decision":"execute","approvalSource":"bypass","approvalType":"always","output":{"filePath":"/private/tmp/h-eOGj3f/src/transfer.ts","content":"import { AccountId, Hbar, PrivateKey, TransactionId, TransferTransaction } from \"@hiero-ledger/sdk\";\nimport * as dotenv from \"dotenv\";\n\ndotenv.config();\n\nconst operatorId = AccountId.fromString(process.env.OPERATOR_ID!);\nconst operatorKey = PrivateKey.fromStringDer(process.env.OPERATOR_KEY!);\nconst recipientId = AccountId.fromString(process.env.RECIPIENT_ID!);\nconst validStart = parseInt(process.env.VALID_START!, 10);\n\nconst transaction = new TransferTransaction()\n  .setNodeAccountIds([AccountId.fromString(\"0.0.3\")])\n  .addHbarTransfer(operatorId, new Hbar(-1))\n  .addHbarTransfer(recipientId, new Hbar(1))\n  .setTransactionId(\n    TransactionId.withValidStart(\n      operatorId,\n      validStart\n    )\n  )\n  .setTransactionMemo(\"invoice 42\");\n\nconst signedTransaction = transaction.sign(operatorKey);\n\nconsole.log(signedTransaction.toBytes().toString(\"hex\"));\n","fileExisted":false,"previousContent":null}}}
