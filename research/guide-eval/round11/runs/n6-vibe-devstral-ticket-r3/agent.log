tion = transaction;\n\ntransaction.freeze();\nconst signedTransaction = await transaction.sign(operatorKey);\n\nconsole.log(signedTransaction.toBytes().toString(\"hex\"));\n","fileExisted":true,"previousContent":"import { AccountId, Hbar, PrivateKey, Timestamp, TransactionId, TransferTransaction } from \"@hiero-ledger/sdk\";\nimport * as dotenv from \"dotenv\";\n\ndotenv.config();\n\nconst operatorId = AccountId.fromString(process.env.OPERATOR_ID!);\nconst operatorKey = PrivateKey.fromStringDer(process.env.OPERATOR_KEY!);\nconst recipientId = AccountId.fromString(process.env.RECIPIENT_ID!);\nconst validStart = parseInt(process.env.VALID_START!, 10);\n\nconst transaction: TransferTransaction = new TransferTransaction()\n  .setNodeAccountIds([AccountId.fromString(\"0.0.3\")])\n  .addHbarTransfer(operatorId, new Hbar(-1))\n  .addHbarTransfer(recipientId, new Hbar(1))\n  .setTransactionId(\n    TransactionId.withValidStart(\n      operatorId,\n      new Timestamp(validStart, 0)\n    )\n  )\n  .setTransactionMemo(\"invoice 42\");\n\ntransaction.freeze();\nconst signedTransaction = await transaction.sign(operatorKey);\n\nconsole.log(signedTransaction.toBytes().toString(\"hex\"));\n"}}}
