nsole.log(\"    (no posts)\");\n    }\n    for (const p of u.posts) {\n      console.log(\n        `    - [${p.id}] \"${p.title}\" published=${p.published}${p.content ? ` content=\"${p.content}\"` : \"\"}`,\n      );\n    }\n  }\n}\n\nmain()\n  .catch((err) => {\n    console.error(err);\n    process.exitCode = 1;\n  })\n  .finally(() => prisma.$disconnect());\n"}}}
