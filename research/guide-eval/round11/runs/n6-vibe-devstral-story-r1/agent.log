on = (transaction as any)._signedTransactions.get(0);\nconst signedBytes = (HieroProto as any).default.proto.SignedTransaction.encode(signedTransaction).finish();\nconsole.log(signedBytes.toString(\"hex\"));\n","numLines":32,"startLine":1,"requestedOffset":null,"requestedLimit":2000,"totalLines":null,"wasTruncated":false}}}
