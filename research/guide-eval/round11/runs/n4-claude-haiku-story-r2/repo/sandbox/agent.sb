;; OS-level fence for lanes whose output leaves the machine: the agent has a real shell, so the real home must be
;; unreachable. The one exception is the lane's own state dir, passed as -D STATE=<dir> (kimi: ~/.kimi-code,
;; codex: ~/.codex); each lane opens only its own. Network stays open. HOME is passed with -D HOME=<real home>.
(version 1)
(allow default)
(deny file-read-data (subpath (param "HOME")))
(deny file-write* (subpath (param "HOME")))
(allow file-read-data (subpath (param "STATE")))
(allow file-write* (subpath (param "STATE")))
(deny process-exec (literal "/bin/launchctl") (literal "/usr/bin/security") (literal "/usr/bin/osascript"))
