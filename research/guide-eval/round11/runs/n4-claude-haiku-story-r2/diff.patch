@@ -1,7 +1,8 @@
 #!/usr/bin/env bash
 # usage: run.sh <task> <lane> [rep]
-# lanes: codex   Codex CLI, unsandboxed
-#        kimi    Kimi Code under sandbox/agent.sb (no reading or writing the real home), scratch HOME
+# lanes: codex           Codex CLI, unsandboxed
+#        codex-sandboxed Codex CLI under sandbox/agent.sb (no reading or writing the real home except ~/.codex), scratch HOME
+#        kimi            Kimi Code under sandbox/agent.sb (no reading or writing the real home except ~/.kimi-code), scratch HOME
 set -u
 D="$(cd "$(dirname "$0")" && pwd)"
 T=$1; A=$2; REP=${3:-1}
@@ -18,15 +19,31 @@ codex_run() {
 # Kimi's output goes to Moonshot: its shell runs under sandbox/agent.sb with an empty scratch HOME.
 kimi_run() {
   local REAL="$HOME" SH; SH=$(mktemp -d /tmp/khome-XXXXXX)
-  ( cd "$W" && export HOME="$SH" && sandbox-exec -D HOME="$REAL" -f "$D/sandbox/agent.sb" \
+  ( cd "$W" && export HOME="$SH" && sandbox-exec -D HOME="$REAL" -D STATE="$REAL/.kimi-code" -f "$D/sandbox/agent.sb" \
       env KIMI_CODE_HOME="$REAL/.kimi-code" timeout $TO "$REAL/.kimi-code/bin/kimi" -p "$P" --output-format stream-json \
       < /dev/null > "$R/agent.log" 2> "$R/agent.err" )
   local rc=$?; rm -rf "$SH"; return $rc
 }
 
+# Codex's output goes to OpenAI, so it runs under the same fence as kimi, with CODEX_HOME at the real ~/.codex (the
+# same config and login as the codex lane). -o writes to a scratch folder in /tmp, not the run folder: the profile
+# denies writes under the home, and the run folder can sit there (the eval Mac keeps the repo in ~/evals). Codex
+# exits 0 even when that write is denied, so the file is copied out after sandbox-exec returns.
+codex_sandboxed_run() {
+  local REAL="$HOME" SH SCR; SH=$(mktemp -d /tmp/chome-XXXXXX); SCR=$(mktemp -d /tmp/cout-XXXXXX)
+  ( cd "$W" && export HOME="$SH" CODEX_HOME="$REAL/.codex" && sandbox-exec -D HOME="$REAL" -D STATE="$REAL/.codex" -f "$D/sandbox/agent.sb" \
+      timeout $TO codex exec --skip-git-repo-check --dangerously-bypass-approvals-and-sandbox -C "$W" --json \
+      -o "$SCR/final.txt" "$P" < /dev/null > "$R/agent.log" 2> "$R/agent.err" )
+  local rc=$?
+  [ -f "$SCR/final.txt" ] && cp "$SCR/final.txt" "$R/final.txt"
+  grep -q "Operation not permitted" "$R/agent.err" && echo "warning: sandbox denied a write, see $R/agent.err" >&2
+  rm -rf "$SH" "$SCR"; return $rc
+}
+
 start=$(date +%s)
 case $A in
   codex) codex_run;;
+  codex-sandboxed) codex_sandboxed_run;;
   kimi)  kimi_run;;
   *) echo "unknown lane $A"; exit 2;;
 esac
