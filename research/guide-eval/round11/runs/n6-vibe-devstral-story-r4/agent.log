{"id":"effect-7e07dd6b-281c-52fe-b293-3a716514efd5","sessionId":"815057ef-ea75-3c75-b9f1-03dc869af6e0","turnId":"turn-20f6692bf20a51db9dd9b8c1512f6382","inputEntryId":"user-turn-20f6692bf20a51db9dd9b8c1512f6382-1","createdAt":1794283743657,"updatedAt":1794283743664,"generationStatus":"completed","relatedEntryId":null,"type":"effect","title":"file_system.write_file","detail":{"toolName":"file_system.write_file","display":{"summary":"Writing src/transfer.ts","content":"import dotenv from 'dotenv';\nimport {\n  AccountId,\n  Hbar,\n  PrivateKey,\n  TransactionId,\n  TransferTransaction,\n} from '@hiero-ledger/sdk';\n\ndotenv.config();\n\nconst operatorId = AccountId.fromString(process.env.OPERATOR_ID!);\nconst operatorKey = PrivateKey.fromStringDer(process.env.OPERATOR_KEY!);\nconst recipientId = AccountId.fromString(process.env.RECIPIENT_ID!);\nconst validStart = new Date(Number(process.env.VALID_START!) * 1000);\n\nconst transaction = new TransferTransaction()\n  .setNodeAccountIds([AccountId.fromString('0.0.3')])\n  .setTransactionId(\n    TransactionId.withValidStart(operatorId, validStart)\n  )\n  .addHbarTransfer(operatorId, new Hbar(-1))\n  .addHbarTransfer(recipientId, new Hbar(1))\n  .setMemo('invoice 42')\n  .freezeWithSigner(operatorKey);\n\nconst signedTransaction = transaction.sign(operatorKey);\n\nconsole.log(signedTransaction.toBytes().toString('hex'));\n","suffix":"","verb":"Creating","message":"src/transfer.ts","settledVerb":"Created","settledMessage":"src/transfer.ts","statusText":"Writing file"},"kind":"file_write","input":{"filePath":"src/transfer.ts","content":"import dotenv from 'dotenv';\nimport {\n  AccountId,\n  Hbar,\n  PrivateKey,\n  TransactionId,\n  TransferTransaction,\n} from '@hiero-ledger/sdk';\n\ndotenv.config();\n\nconst operatorId = AccountId.fromString(process.env.OPERATOR_ID!);\nconst operatorKey = PrivateKey.fromStringDer(process.env.OPERATOR_KEY!);\nconst recipientId = AccountId.fromString(process.env.RECIPIENT_ID!);\nconst validStart = new Date(Number(process.env.VALID_START!) * 1000);\n\nconst transaction = new TransferTransaction()\n  .setNodeAccountIds([AccountId.fromString('0.0.3')])\n  .setTransactionId(\n    TransactionId.withValidStart(operatorId, validStart)\n  )\n  .addHbarTransfer(operatorId, new Hbar(-1))\n  .addHbarTransfer(recipientId, new Hbar(1))\n  .setMemo('invoice 42')\n  .freezeWithSigner(operatorKey);\n\nconst signedTransaction = transaction.sign(operatorKey);\n\nconsole.log(signedTransaction.toBytes().toString('hex'));\n"}},"state":{"status":"completed","outputText":"","output":{"filePath":"/private/tmp/h-u3fY5N/src/transfer.ts","content":"import dotenv from 'dotenv';\nimport {\n  AccountId,\n  Hbar,\n  PrivateKey,\n  TransactionId,\n  TransferTransaction,\n} from '@hiero-ledger/sdk';\n\ndotenv.config();\n\nconst operatorId = AccountId.fromString(process.env.OPERATOR_ID!);\nconst operatorKey = PrivateKey.fromStringDer(process.env.OPERATOR_KEY!);\nconst recipientId = AccountId.fromString(process.env.RECIPIENT_ID!);\nconst validStart = new Date(Number(process.env.VALID_START!) * 1000);\n\nconst transaction = new TransferTransaction()\n  .setNodeAccountIds([AccountId.fromString('0.0.3')])\n  .setTransactionId(\n    TransactionId.withValidStart(operatorId, validStart)\n  )\n  .addHbarTransfer(operatorId, new Hbar(-1))\n  .addHbarTransfer(recipientId, new Hbar(1))\n  .setMemo('invoice 42')\n  .freezeWithSigner(operatorKey);\n\nconst signedTransaction = transaction.sign(operatorKey);\n\nconsole.log(signedTransaction.toBytes().toString('hex'));\n","fileExisted":false,"previousContent":null},"durationMs":0.0,"display":{"success":true,"verb":"Created","message":"src/transfer.ts","warnings":[],"approvalNote":null,"suffix":""},"approvalType":"always","approvalSource":"bypass","decision":"execute"}}
