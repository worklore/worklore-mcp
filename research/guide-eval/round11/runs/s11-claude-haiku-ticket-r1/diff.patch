+++ b/src/app.py
@@ -8,6 +8,7 @@ import json
 import logging
 import re
 import time
+from decimal import Decimal
 
 log = logging.getLogger("stories")
 
@@ -40,6 +41,22 @@ def related(story, existing):
     return scored[:TOP_N]
 
 
+def to_dynamo(value):
+    """Return ``value`` with every float replaced by a Decimal, recursively.
+
+    boto3's DynamoDB serializer rejects Python floats. Converting at the write
+    boundary covers every path that can produce one (scores, averages, ratios),
+    not just the ones that run on a particular table state.
+    """
+    if isinstance(value, float):
+        return Decimal(str(value))
+    if isinstance(value, dict):
+        return {k: to_dynamo(v) for k, v in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [to_dynamo(v) for v in value]
+    return value
+
+
 def validate(story):
