 def build_system(a, today):
-    # One block, cached as a whole: instructions + per-athlete context.
-    text = INSTRUCTIONS + "\n\n" + athlete_context(a, today)
-    return [{"type": "text", "text": text, "cache_control": {"type": "ephemeral"}}]
+    """Construct the system prompt in two cacheable blocks.
+
+    * The first block contains the static ``INSTRUCTIONS``. It never changes
+      between calls (no interpolated dates, user‑specific data, or counters),
+      so it can stay hot in Claude's prefix‑hash cache.
+    * The second block holds the volatile per‑athlete context generated by
+      :func:`athlete_context`. This includes the current date, athlete profile,
+      and long‑term facts, which may be updated via ``save_fact``.
+
+    Both blocks are marked with ``cache_control: {"type": "ephemeral"}`` –
+    Anthropic allows up to four such markers per request, and using two
+    isolates memory writes to the tail block, preventing eviction of the
+    static instruction block.
+    """
+    # Block 1 – static instructions (byte‑stable).
+    instr_block = {"type": "text", "text": INSTRUCTIONS, "cache_control": {"type": "ephemeral"}}
+    # Block 2 – per‑athlete volatile context.
+    context_block = {
+        "type": "text",
+        "text": athlete_context(a, today),
+        "cache_control": {"type": "ephemeral"},
+    }
+    return [instr_block, context_block]
 
