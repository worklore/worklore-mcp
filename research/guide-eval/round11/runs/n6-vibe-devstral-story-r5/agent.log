!, 10);\n\nconst transaction = new TransferTransaction()\n  .addHbarTransfer(operatorId, new Hbar(-1))\n  .addHbarTransfer(recipientId, new Hbar(1))\n  .setTransactionId(\n    TransactionId.withValidStart(operatorId, validStart).setNode(0, 0, 3)\n  )\n  .setMemo('invoice 42')\n  .freezeWithSigner(operatorKey);\n\nconst signedTransaction = transaction.sign(operatorKey);\n\nprocess.stdout.write(signedTransaction.toBytes().toString('hex'));\n"}},"state":{"status":"completed","outputText":"","decision":"execute","output":{"filePath":"/private/tmp/h-sqNvxH/src/transfer.ts","content":"import dotenv from 'dotenv';\nimport {\n  AccountId,\n  PrivateKey,\n  TransferTransaction,\n  TransactionId,\n  Hbar,\n} from '@hiero-ledger/sdk';\n\ndotenv.config();\n\nconst operatorId = AccountId.fromString(process.env.OPERATOR_ID!);\nconst operatorKey = PrivateKey.fromStringDer(process.env.OPERATOR_KEY!);\nconst recipientId = AccountId.fromString(process.env.RECIPIENT_ID!);\nconst validStart = parseInt(process.env.VALID_START!, 10);\n\nconst transaction = new TransferTransaction()\n  .addHbarTransfer(operatorId, new Hbar(-1))\n  .addHbarTransfer(recipientId, new Hbar(1))\n  .setTransactionId(\n    TransactionId.withValidStart(operatorId, validStart).setNode(0, 0, 3)\n  )\n  .setMemo('invoice 42')\n  .freezeWithSigner(operatorKey);\n\nconst signedTransaction = transaction.sign(operatorKey);\n\nprocess.stdout.write(signedTransaction.toBytes().toString('hex'));\n","fileExisted":false,"previousContent":null},"approvalSource":"bypass","durationMs":0.0,"approvalType":"always","display":{"success":true,"verb":"Created","message":"src/transfer.ts","warnings":[],"approvalNote":null,"suffix":""}}}
