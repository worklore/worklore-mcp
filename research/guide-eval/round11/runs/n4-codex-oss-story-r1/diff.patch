diff --git a/run.sh b/run.sh
index c41ad67..86e53f3 100755
--- a/run.sh
+++ b/run.sh
@@ -1,7 +1,8 @@
 #!/usr/bin/env bash
 # usage: run.sh <task> <lane> [rep]
-# lanes: codex   Codex CLI, unsandboxed
-#        kimi    Kimi Code under sandbox/agent.sb (no reading or writing the real home), scratch HOME
+# lanes: codex            Codex CLI, unsandboxed
+#        kimi             Kimi Code under sandbox/agent.sb (no reading or writing the real home), scratch HOME
+#        codex-sandboxed  Codex CLI run inside sandbox/agent.sb similar to kimi lane; uses a temporary scratch HOME and writes output to a temporary folder which is then copied back to the run folder.
 set -u
 D="$(cd "$(dirname "$0")" && pwd)"
 T=$1; A=$2; REP=${3:-1}
@@ -15,6 +16,26 @@ codex_run() {
       -o "$R/final.txt" "$P" < /dev/null > "$R/agent.log" 2> "$R/agent.err" )
 }
 
+# Codex run inside the same sandbox used for the kimi lane. The sandbox denies
+# writes to the real HOME and the run folder, so we write the final answer to a
+# temporary scratch directory and copy it back after the sandbox exits.
+codex_sandboxed_run() {
+  local REAL_HOME="$HOME"
+  local SCRATCH=$(mktemp -d /tmp/codex-sb-XXXXXX)
+  # Run codex with HOME overridden to a scratch directory. The sandbox profile
+  # receives the real home via -D HOME="$REAL_HOME".
+  ( cd "$W" && export HOME="$SCRATCH" && sandbox-exec -D HOME="$REAL_HOME" -f "$D/sandbox/agent.sb" \
+      timeout $TO codex exec --skip-git-repo-check --dangerously-bypass-approvals-and-sandbox -C "$W" --json \
+      -o "$SCRATCH/final.txt" "$P" < /dev/null > "$R/agent.log" 2> "$R/agent.err" )
+  local rc=$?
+  # Copy the generated final answer back into the run folder if it exists.
+  if [ -f "$SCRATCH/final.txt" ]; then
+    cp -f "$SCRATCH/final.txt" "$R/final.txt"
+  fi
+  rm -rf "$SCRATCH"
+  return $rc
+}
+
 # Kimi's output goes to Moonshot: its shell runs under sandbox/agent.sb with an empty scratch HOME.
 kimi_run() {
   local REAL="$HOME" SH; SH=$(mktemp -d /tmp/khome-XXXXXX)
@@ -27,6 +48,7 @@ kimi_run() {
 start=$(date +%s)
 case $A in
   codex) codex_run;;
+  codex-sandboxed) codex_sandboxed_run;;
   kimi)  kimi_run;;
   *) echo "unknown lane $A"; exit 2;;
 esac
