_floats(self):\n        out = app.to_dynamo({\"a\": 0.5, \"b\": [{\"c\": 1.25}], \"d\": 3, \"e\": \"x\"})\n        self.assertEqual(out, {\"a\": Decimal(\"0.5\"), \"b\": [{\"c\": Decimal(\"1.25\")}], \"d\": 3, \"e\": \"x\"})\n        self.assertIsInstance(out[\"a\"], Decimal)\n\n\nif __name__ == \"__main__\":"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2007,"cache_read_input_tokens":26278,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2007},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"e23c7b4f-b025-4b9d-9732-a0838449be40","uuid":"fae8621d-5b08-49a2-a2c6-0f1f9eb97d89","timestamp":"2026-11-09T05:41:02.767Z","request_id":"req_011CgrpRhJqL7FqEYXUvmSvt","wire_tool_inputs":{"toolu_014isgRtPdJTSTMtvJrMpK1x":{"file_path":"/private/tmp/h-xzzHZm/tests/test_publish.py","old_string":"        self.assertEqual(table.scan()[\"Count\"], 1)\n\n\nif __name__ == \"__main__\":","new_string":"        self.assertEqual(table.scan()[\"Count\"], 1)\n\n    def test_second_publish_into_populated_table(self):\n        # The empty-table path has no similar stories, so it never produces a\n        # score. Seed one story first so the scoring path actually runs.\n        table = FakeTable()\n        app.publish(table, {\n            \"slug\": \"first-story\",\n            \"title\": \"First\",\n            \"tags\": [\"cron\"],\n            \"body\": \"cron runs twice\",\n        })\n        stored = app.publish(table, {\n            \"slug\": \"second-story\",\n            \"title\": \"Second\",\n            \"tags\": [\"cron\", \"linux\"],\n            \"body\": \"cron twice again\",\n        })\n        self.assertEqual(len(stored[\"similar\"]), 1)\n        self.assertEqual(stored[\"similar\"][0][\"slug\"], \"first-story\")\n        saved = table.get_item(Key={\"slug\": \"second-story\"})[\"Item\"]\n        self.assertEqual(saved[\"similar\"][0][\"score\"], Decimal(\"0.4286\"))\n\n    def test_handler_returns_201_when_table_is_populated(self):\n        table = FakeTable()\n        seed = {\"slug\": \"first-story\", \"title\": \"First\", \"tags\": [\"cron\"], \"body\": \"cron runs twice\"}\n        self.assertEqual(app.handler({\"body\": json.dumps(seed)}, table)[\"statusCode\"], 201)\n        second = {\"slug\": \"second-story\", \"title\": \"Second\", \"tags\": [\"cron\", \"linux\"], \"body\": \"cron twice again\"}\n        self.assertEqual(app.handler({\"body\": json.dumps(second)}, table)[\"statusCode\"], 201)\n\n    def test_to_dynamo_converts_nested_floats(self):\n        out = app.to_dynamo({\"a\": 0.5, \"b\": [{\"c\": 1.25}], \"d\": 3, \"e\": \"x\"})\n        self.assertEqual(out, {\"a\": Decimal(\"0.5\"), \"b\": [{\"c\": Decimal(\"1.25\")}], \"d\": 3, \"e\": \"x\"})\n        self.assertIsInstance(out[\"a\"], Decimal)\n\n\nif __name__ == \"__main__\":"}}}
