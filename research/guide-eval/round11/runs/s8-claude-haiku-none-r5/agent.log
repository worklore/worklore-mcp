{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011CgtWiznvvFvRXTMFxJ61V","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01T7yHBtAkqSbPCnL9D927bZ","name":"Write","input":{"file_path":"/private/tmp/h-ftHYe5/test_prompt_cache.py","content":"\"\"\"Checks that a memory write does not change the cached part of the system prompt.\n\nRun: python3 -m unittest test_prompt_cache -v\nNo API calls: build_system() is pure and is what reply() sends.\n\"\"\"\nimport copy\nimport datetime as dt\nimport unittest\n\nimport bot\n\n\ndef athlete():\n    return bot.Athlete(user_id=\"42\", name=\"Marta\", facts=[\"Runs before work, 06:30, Mon/Wed/Fri\"])\n\n\nclass PromptCacheLayout(unittest.TestCase):\n    def test_only_first_block_is_cached(self):\n        blocks = bot.build_system(athlete(), dt.date(2026, 4, 18))\n        self.assertEqual(len(blocks), 2)\n        self.assertEqual(blocks[0][\"cache_control\"], {\"type\": \"ephemeral\"})\n        self.assertNotIn(\"cache_control\", blocks[1])\n\n    def test_facts_and_date_are_after_the_breakpoint(self):\n        blocks = bot.build_system(athlete(), dt.date(2026, 4, 18))\n        self.assertNotIn(\"Long-term facts\", blocks[0][\"text\"])\n        self.assertNotIn(\"Today:\", blocks[0][\"text\"])\n        self.assertIn(\"Runs before work\", blocks[1][\"text\"])\n        self.assertIn(\"Today: 2026-04-18\", blocks[1][\"text\"])\n\n    def test_save_fact_does_not_change_cached_block(self):\n        a = athlete()\n        day = dt.date(2026, 4, 18)\n        before = bot.build_system(a, day)[0][\"text\"]\n        a.facts.append(\"Owns a Garmin 255\")\n        after = bot.build_system(a, day)\n        self.assertEqual(before, after[0][\"text\"])\n        self.assertIn(\"Owns a Garmin 255\", after[1][\"text\"])\n\n    def test_new_day_does_not_change_cached_block(self):\n        a = athlete()\n        self.assertEqual(\n            bot.build_system(a, dt.date(2026, 4, 18))[0][\"text\"],\n            bot.build_system(a, dt.date(2026, 4, 19))[0][\"text\"],\n        )\n\n    def test_profile_change_still_changes_cached_block(self):\n        a = athlete()\n        before = bot.build_system(a, dt.date(2026, 4, 18))[0][\"text\"]\n        a2 = copy.deepcopy(a)\n        a2.goal = \"sub-1:50 half marathon\"\n        self.assertNotEqual(before, bot.build_system(a2, dt.date(2026, 4, 18))[0][\"text\"])\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3788,"cache_read_input_tokens":31232,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3788},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c844f66b-7d49-4f5c-9839-d41f54baf4e9","uuid":"89deee94-d73a-43a8-82bb-93d7aaeec872","timestamp":"2026-11-10T03:10:03.283Z","request_id":"req_011CgtWizTLzLeq1iPPAr1ar","wire_tool_inputs":{"toolu_01T7yHBtAkqSbPCnL9D927bZ":{"file_path":"/private/tmp/h-ftHYe5/test_prompt_cache.py","content":"\"\"\"Checks that a memory write does not change the cached part of the system prompt.\n\nRun: python3 -m unittest test_prompt_cache -v\nNo API calls: build_system() is pure and is what reply() sends.\n\"\"\"\nimport copy\nimport datetime as dt\nimport unittest\n\nimport bot\n\n\ndef athlete():\n    return bot.Athlete(user_id=\"42\", name=\"Marta\", facts=[\"Runs before work, 06:30, Mon/Wed/Fri\"])\n\n\nclass PromptCacheLayout(unittest.TestCase):\n    def test_only_first_block_is_cached(self):\n        blocks = bot.build_system(athlete(), dt.date(2026, 4, 18))\n        self.assertEqual(len(blocks), 2)\n        self.assertEqual(blocks[0][\"cache_control\"], {\"type\": \"ephemeral\"})\n        self.assertNotIn(\"cache_control\", blocks[1])\n\n    def test_facts_and_date_are_after_the_breakpoint(self):\n        blocks = bot.build_system(athlete(), dt.date(2026, 4, 18))\n        self.assertNotIn(\"Long-term facts\", blocks[0][\"text\"])\n        self.assertNotIn(\"Today:\", blocks[0][\"text\"])\n        self.assertIn(\"Runs before work\", blocks[1][\"text\"])\n        self.assertIn(\"Today: 2026-04-18\", blocks[1][\"text\"])\n\n    def test_save_fact_does_not_change_cached_block(self):\n        a = athlete()\n        day = dt.date(2026, 4, 18)\n        before = bot.build_system(a, day)[0][\"text\"]\n        a.facts.append(\"Owns a Garmin 255\")\n        after = bot.build_system(a, day)\n        self.assertEqual(before, after[0][\"text\"])\n        self.assertIn(\"Owns a Garmin 255\", after[1][\"text\"])\n\n    def test_new_day_does_not_change_cached_block(self):\n        a = athlete()\n        self.assertEqual(\n            bot.build_system(a, dt.date(2026, 4, 18))[0][\"text\"],\n            bot.build_system(a, dt.date(2026, 4, 19))[0][\"text\"],\n        )\n\n    def test_profile_change_still_changes_cached_block(self):\n        a = athlete()\n        before = bot.build_system(a, dt.date(2026, 4, 18))[0][\"text\"]\n        a2 = copy.deepcopy(a)\n        a2.goal = \"sub-1:50 half marathon\"\n        self.assertNotEqual(before, bot.build_system(a2, dt.date(2026, 4, 18))[0][\"text\"])\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n"}}}
