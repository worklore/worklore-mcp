il: 'alice@example.com',\n    name: 'Alice',\n  });\n\n  console.log('Created user:', user);\n\n  // Create two posts for the user\n  const post1 = await db.orm.public.Post.create({\n    title: 'First Post',\n    content: 'This is my first post',\n    published: false,\n    authorId: user.id,\n  });\n\n  const post2 = await db.orm.public.Post.create({\n    title: 'Second Post',\n    content: 'This is my second post',\n    published: true,\n    authorId: user.id,\n  });\n\n  console.log('Created posts:', post1, post2);\n\n  // Print every user together with their posts\n  const usersWithPosts = await db.orm.public.User.include('posts').all();\n  \n  console.log('\\nAll users with their posts:');\n  for (const user of usersWithPosts) {\n    console.log(`\\nUser: ${user.name || 'Anonymous'} (${user.email})`);\n    console.log(`  Posts (${user.posts.length}):`);\n    for (const post of user.posts) {\n      console.log(`    - ${post.title} (published: ${post.published})`);\n      if (post.content) {\n        console.log(`      Content: ${post.content}`);\n      }\n    }\n  }\n\n  await db.close();\n}\n\nmain().catch((e) => {\n  console.error(e);\n  process.exit(1);\n});","replaceAll":false}},"state":{"status":"completed","outputText":"","output":{"file":"/private/tmp/h-OhqbeB/script.ts","oldString":null,"newString":null,"occurrences":[{"startLine":1,"newStartLine":1,"oldText":"import 'dotenv/config';\nimport { db } from './src/prisma/db';\n\nasync function main() {\n  // Create a user with two posts\n  const user = await db.orm.public.User.create({\n    email: 'alice@example.com',\n    name: 'Alice',\n    posts: {\n      create: [\n        { title: 'First Post', content: 'This is my first post', published: false },\n        { title: 'Second Post', content: 'This is my second post', published: true },\n      ],\n    },\n  });\n\n  console.log('Created user:', user);\n\n  // Print every user together with their posts\n  const usersWithPosts = await db.orm.public.User.inclu