in() {\n  // Clean up existing data to ensure idempotency\n  await db.orm.public.Post.deleteMany();\n  await db.orm.public.User.deleteMany();\n\n  // Create a user\n  const user = await db.orm.public.User.create({\n    email: 'alice@example.com',\n    name: 'Alice',\n  });\n\n  console.log('Created user:', user);\n\n  // Create two posts for the user\n  const post1 = await db.orm.public.Post.create({\n    title: 'First Post',\n    content: 'This is my first post',\n    published: false,\n    authorId: user.id,\n  });\n\n  const post2 = await db.orm.public.Post.create({\n    title: 'Second Post',\n    content: 'This is my second post',\n    published: true,\n    authorId: user.id,\n  });\n\n  console.log('Created posts:', post1, post2);\n\n  // Print every user together with their posts\n  const usersWithPosts = await db.orm.public.User.include('posts').all();\n\n  console.log('\\nAll users with their posts:');\n  for (const u of usersWithPosts) {\n    console.log(`\\nUser ${u.id}: ${u.email}${u.name ? ` (${u.name})` : ''}`);\n    console.log('  Posts:');\n    for (const post of u.posts) {\n      console.log(`    - ${post.title}${post.content ? `: ${post.content}` : ''} (published: ${post.published})`);\n    }\n  }\n\n  await db.close();\n}\n\nmain().catch((e) => {\n  console.error(e);\n  process.exit(1);\n});","replaceAll":false}},"state":{"status":"completed","outputText":"","decision":"execute","approvalType":"always","approvalSource":"bypass","output":{"file":"/private/tmp/h-x5w8sL/script.ts","oldString":null,"newString":null,"occurrences":[{"startLine":1,"newStartLine":1,"oldText":"import { db } from './src/prisma/db';\n\nasync function main() {\n  // Create a user\n  const user = await db.orm.public.User.create({\n    email: 'alice@example.com',\n    name: 'Alice',\n  });\n\n  console.log('Created user:', user);\n\n  // Create two posts for the user\n  const post1 = await db.orm.public.Post.create({\n    title: 'First Post',\n    content: 'This is my first post