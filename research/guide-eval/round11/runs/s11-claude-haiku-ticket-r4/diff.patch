@@ -8,6 +8,7 @@ import json
 import logging
 import re
 import time
+from decimal import Decimal
 
 log = logging.getLogger("stories")
 
@@ -17,6 +18,22 @@ TOP_N = 3
 _WORD = re.compile(r"[a-z0-9]+")
 
 
+def to_dynamo(value):
+    """Return ``value`` with every float replaced by a Decimal.
+
+    DynamoDB rejects Python floats; Decimal(str(f)) keeps the value as written
+    (0.4667 stays 0.4667). Applied to the whole item right before the write, so
+    a float computed anywhere upstream cannot reach put_item.
+    """
+    if isinstance(value, float):
+        return Decimal(str(value))
+    if isinstance(value, dict):
+        return {k: to_dynamo(v) for k, v in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [to_dynamo(v) for v in value]
+    return value
+
+
 def words(text):
     return set(_WORD.findall((text or "").lower()))
 
@@ -60,7 +77,7 @@ def publish(table, story):
         "published_at": int(time.time()),
         "similar": related(story, existing),
     }
-    table.put_item(Item=item)
+    table.put_item(Item=to_dynamo(item))
     log.info("publish slug=%s similar=%d stored", item["slug"], len(item["similar"]))
     return item
 
