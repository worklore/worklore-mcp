@@ -15,6 +16,27 @@ codex_run() {
       -o "$R/final.txt" "$P" < /dev/null > "$R/agent.log" 2> "$R/agent.err" )
 }
 
+# Codex under the same fence as kimi. Its shell runs under sandbox/agent.sb with an empty scratch HOME and CODEX_HOME,
+# so ~/.codex (which holds the login) stays unreadable. Login comes from CODEX_API_KEY, passed in the environment;
+# ~/.codex/auth.json is not copied in, because the sandboxed shell has network access.
+# The profile denies writes to the real home, and the -o file can sit under the eval repo in the real home, so Codex
+# writes its last message to a scratch folder in /tmp and the lane copies it into the run folder after sandbox-exec returns.
+# Codex can exit 0 without writing that file (it did so inside the sandbox), so a missing final.txt is a failure here.
+codex_sandboxed_run() {
+  [ -n "${CODEX_API_KEY:-}" ] || { echo "codex-sandboxed: CODEX_API_KEY is not set" >&2; return 2; }
+  local REAL="$HOME" SH OUT rc
+  SH=$(mktemp -d /tmp/chome-XXXXXX); OUT=$(mktemp -d /tmp/cout-XXXXXX)
+  ( cd "$W" && export HOME="$SH" && sandbox-exec -D HOME="$REAL" -f "$D/sandbox/agent.sb" \
+      env CODEX_HOME="$SH/.codex" timeout $TO codex exec --skip-git-repo-check --dangerously-bypass-approvals-and-sandbox -C "$W" --json \
+      -o "$OUT/final.txt" "$P" < /dev/null > "$R/agent.log" 2> "$R/agent.err" )
+  rc=$?
+  if cp "$OUT/final.txt" "$R/final.txt" 2>/dev/null; then :; else
+    echo "codex-sandboxed: no final.txt written (exit $rc)" >> "$R/agent.err"; [ $rc -eq 0 ] && rc=1
+  fi
+  grep -q "Operation not permitted" "$R/agent.err" && echo "codex-sandboxed: 'Operation not permitted' in agent.err" >&2
+  rm -rf "$SH" "$OUT"; return $rc
+}
+
 # Kimi's output goes to Moonshot: its shell runs under sandbox/agent.sb with an empty scratch HOME.
 kimi_run() {
   local REAL="$HOME" SH; SH=$(mktemp -d /tmp/khome-XXXXXX)
@@ -27,6 +49,7 @@ kimi_run() {
 start=$(date +%s)
 case $A in
   codex) codex_run;;
+  codex-sandboxed) codex_sandboxed_run;;
   kimi)  kimi_run;;
   *) echo "unknown lane $A"; exit 2;;
 esac
