{"id":"effect-f048ace0-fc9e-5b4a-967a-351e4dc060e8","sessionId":"9be0035b-44dd-415c-95ec-9b8ff04b1264","turnId":"turn-adf85c6e1198251bcee4e6a770e54423","inputEntryId":"user-turn-adf85c6e1198251bcee4e6a770e54423-1","createdAt":1794286447356,"updatedAt":1794286447363,"generationStatus":"completed","relatedEntryId":null,"type":"effect","title":"file_system.write_file","detail":{"toolName":"file_system.write_file","display":{"summary":"Writing src/transfer.ts","content":"import { AccountId, Hbar, PrivateKey, TransactionId, TransferTransaction } from \"@hiero-ledger/sdk\";\nimport * as dotenv from \"dotenv\";\n\ndotenv.config();\n\nconst operatorId = AccountId.fromString(process.env.OPERATOR_ID!);\nconst operatorKey = PrivateKey.fromStringDer(process.env.OPERATOR_KEY!);\nconst recipientId = AccountId.fromString(process.env.RECIPIENT_ID!);\nconst validStart = parseInt(process.env.VALID_START!, 10);\n\nconst txId = TransactionId.withValidStart(\n  operatorId,\n  new Date(validStart * 1000),\n  process.env.NODE_ID || \"0.0.3\"\n);\n\nconst transfer = new TransferTransaction()\n  .setTransactionId(txId)\n  .setNodeAccountIds([AccountId.fromString(\"0.0.3\")])\n  .addHbarTransfer(operatorId, new Hbar(-1))\n  .addHbarTransfer(recipientId, new Hbar(1))\n  .setMemo(\"invoice 42\");\n\nconst signed = transfer.sign(operatorKey);\n\nconsole.log(signed.toBytes().toString(\"hex\"));\n","suffix":"","verb":"Creating","message":"src/transfer.ts","settledVerb":"Created","settledMessage":"src/transfer.ts","statusText":"Writing file"},"kind":"file_write","input":{"filePath":"src/transfer.ts","content":"import { AccountId, Hbar, PrivateKey, TransactionId, TransferTransaction } from \"@hiero-ledger/sdk\";\nimport * as dotenv from \"dotenv\";\n\ndotenv.config();\n\nconst operatorId = AccountId.fromString(process.env.OPERATOR_ID!);\nconst operatorKey = PrivateKey.fromStringDer(process.env.OPERATOR_KEY!);\nconst recipientId = AccountId.fromString(process.env.RECIPIENT_ID!);\nconst validStart = parseInt(process.env.VALID_START!, 10);\n\nconst txId = TransactionId.withValidStart(\n  operatorId,\n  new Date(validStart * 1000),\n  process.env.NODE_ID || \"0.0.3\"\n);\n\nconst transfer = new TransferTransaction()\n  .setTransactionId(txId)\n  .setNodeAccountIds([AccountId.fromString(\"0.0.3\")])\n  .addHbarTransfer(operatorId, new Hbar(-1))\n  .addHbarTransfer(recipientId, new Hbar(1))\n  .setMemo(\"invoice 42\");\n\nconst signed = transfer.sign(operatorKey);\n\nconsole.log(signed.toBytes().toString(\"hex\"));\n"}},"state":{"status":"completed","outputText":"","durationMs":0.0,"approvalType":"always","approvalSource":"bypass","decision":"execute","display":{"success":true,"verb":"Created","message":"src/transfer.ts","warnings":[],"approvalNote":null,"suffix":""},"output":{"filePath":"/private/tmp/h-EfPjdz/src/transfer.ts","content":"import { AccountId, Hbar, PrivateKey, TransactionId, TransferTransaction } from \"@hiero-ledger/sdk\";\nimport * as dotenv from \"dotenv\";\n\ndotenv.config();\n\nconst operatorId = AccountId.fromString(process.env.OPERATOR_ID!);\nconst operatorKey = PrivateKey.fromStringDer(process.env.OPERATOR_KEY!);\nconst recipientId = AccountId.fromString(process.env.RECIPIENT_ID!);\nconst validStart = parseInt(process.env.VALID_START!, 10);\n\nconst txId = TransactionId.withValidStart(\n  operatorId,\n  new Date(validStart * 1000),\n  process.env.NODE_ID || \"0.0.3\"\n);\n\nconst transfer = new TransferTransaction()\n  .setTransactionId(txId)\n  .setNodeAccountIds([AccountId.fromString(\"0.0.3\")])\n  .addHbarTransfer(operatorId, new Hbar(-1))\n  .addHbarTransfer(recipientId, new Hbar(1))\n  .setMemo(\"invoice 42\");\n\nconst signed = transfer.sign(operatorKey);\n\nconsole.log(signed.toBytes().toString(\"hex\"));\n","fileExisted":false,"previousContent":null}}}
