+# lanes: codex           Codex CLI, unsandboxed
+#        codex-sandboxed  Codex CLI under sandbox/agent.sb (no reading or writing the real home), scratch HOME
+#        kimi             Kimi Code under sandbox/agent.sb (no reading or writing the real home), scratch HOME
 set -u
 D="$(cd "$(dirname "$0")" && pwd)"
 T=$1; A=$2; REP=${3:-1}
@@ -15,6 +16,19 @@ codex_run() {
       -o "$R/final.txt" "$P" < /dev/null > "$R/agent.log" 2> "$R/agent.err" )
 }
 
+# Codex under sandbox/agent.sb: shell cannot read or write the real home.
+# Output file goes to a scratch folder in /tmp, then copied back to the run folder.
+codex_sandboxed_run() {
+  local REAL="$HOME" SH SCRATCH_OUT; SH=$(mktemp -d /tmp/chome-XXXXXX); SCRATCH_OUT=$(mktemp -d /tmp/co-XXXXXX)
+  ( cd "$W" && export HOME="$SH" && sandbox-exec -D HOME="$REAL" -f "$D/sandbox/agent.sb" \
+      timeout $TO codex exec --skip-git-repo-check --dangerously-bypass-approvals-and-sandbox -C "$W" --json \
+      -o "$SCRATCH_OUT/final.txt" "$P" < /dev/null > "$R/agent.log" 2> "$R/agent.err" )
+  local rc=$?
+  if [ -f "$SCRATCH_OUT/final.txt" ]; then cp "$SCRATCH_OUT/final.txt" "$R/final.txt"; fi
+  rm -rf "$SH" "$SCRATCH_OUT"
+  return $rc
+}
+
