+(allow file-read-data (subpath (param "AGENT_INSTALL")))
+(allow file-write* (subpath (param "AGENT_INSTALL")))
 (deny process-exec (literal "/bin/launchctl") (literal "/usr/bin/security") (literal "/usr/bin/osascript"))
