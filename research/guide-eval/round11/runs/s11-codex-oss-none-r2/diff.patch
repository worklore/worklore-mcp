 def related(story, existing):
+    """Return the top ``TOP_N`` related stories.
+
+    DynamoDB does not support native ``float`` values – they must be stored
+    as ``Decimal`` objects.  The original implementation returned a list of
+    dictionaries with a ``score`` field that was a ``float`` produced by
+    ``similarity``.  When ``publish`` attempted to write this list to the
+    table, boto3 raised ``TypeError: Float types are not supported`` on the
+    second publish (the first succeeded because the ``similar`` list was
+    empty).  Converting the scores to ``Decimal`` ensures the item can be
+    stored repeatedly.
+    """
     scored = []
     for other in existing:
         if other["slug"] == story["slug"]:
             continue
-        scored.append({"slug": other["slug"], "score": similarity(story, other)})
+        # Convert the similarity score to Decimal for DynamoDB compatibility
+        score = Decimal(str(similarity(story, other)))
+        scored.append({"slug": other["slug"], "score": score})
     scored.sort(key=lambda s: s["score"], reverse=True)
     return scored[:TOP_N]
 
