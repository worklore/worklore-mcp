diff --git a/ANSWER.md b/ANSWER.md
new file mode 100644
index 0000000..2dcfc8d
--- /dev/null
+++ b/ANSWER.md
@@ -0,0 +1,7 @@
+# Codex sandboxed lane
+
+Added `codex-sandboxed` to `run.sh`. It runs the same Codex command and writes the same run artifacts as `codex`, but launches Codex through `sandbox/agent.sb` with scratch `HOME` and `CODEX_HOME` directories. The scratch home is removed after the run.
+
+Updated `sandbox/agent.sb` so its home-directory exception is selected per lane: Kimi retains access to its own install, while the Codex lane's exception points only to its scratch home. This prevents Codex's shell from reading or writing the real home.
+
+Verified shell syntax with `bash -n run.sh`, compiled and launched the sandbox profile with `/usr/bin/true`, and checked the diff with `git diff --check`. I did not run a Codex task because that would contact an external service.
diff --git a/run.sh b/run.sh
index c41ad67..2c7a8a2 100755
--- a/run.sh
+++ b/run.sh
@@ -1,6 +1,7 @@
 #!/usr/bin/env bash
 # usage: run.sh <task> <lane> [rep]
 # lanes: codex   Codex CLI, unsandboxed
+#        codex-sandboxed   Codex CLI under sandbox/agent.sb, scratch HOME
 #        kimi    Kimi Code under sandbox/agent.sb (no reading or writing the real home), scratch HOME
 set -u
 D="$(cd "$(dirname "$0")" && pwd)"
@@ -15,10 +16,21 @@ codex_run() {
       -o "$R/final.txt" "$P" < /dev/null > "$R/agent.log" 2> "$R/agent.err" )
 }
 
+codex_sandboxed_run() {
+  local REAL="$HOME" SH CODEX_BIN rc
+  SH=$(mktemp -d /tmp/chome-XXXXXX)
+  CODEX_BIN=$(command -v codex)
+  ( cd "$W" && export HOME="$SH" CODEX_HOME="$SH/.codex" &&
+      sandbox-exec -D HOME="$REAL" -D AGENT_HOME="$SH/.codex" -f "$D/sandbox/agent.sb" \
+      timeout $TO "$CODEX_BIN" exec --skip-git-repo-check --dangerously-bypass-approvals-and-sandbox -C "$W" --json \
+      -o "$R/final.txt" "$P" < /dev/null > "$R/agent.log" 2> "$R/agent.err" )
+  rc=$?; rm -rf "$SH"; return $rc
+}
+
 # Kimi's output goes to Moonshot: its shell runs under sandbox/agent.sb with an empty scratch HOME.
 kimi_run() {
   local REAL="$HOME" SH; SH=$(mktemp -d /tmp/khome-XXXXXX)
-  ( cd "$W" && export HOME="$SH" && sandbox-exec -D HOME="$REAL" -f "$D/sandbox/agent.sb" \
+  ( cd "$W" && export HOME="$SH" && sandbox-exec -D HOME="$REAL" -D AGENT_HOME="$REAL/.kimi-code" -f "$D/sandbox/agent.sb" \
       env KIMI_CODE_HOME="$REAL/.kimi-code" timeout $TO "$REAL/.kimi-code/bin/kimi" -p "$P" --output-format stream-json \
       < /dev/null > "$R/agent.log" 2> "$R/agent.err" )
   local rc=$?; rm -rf "$SH"; return $rc
@@ -27,6 +39,7 @@ kimi_run() {
 start=$(date +%s)
 case $A in
   codex) codex_run;;
+  codex-sandboxed) codex_sandboxed_run;;
   kimi)  kimi_run;;
   *) echo "unknown lane $A"; exit 2;;
 esac
diff --git a/sandbox/agent.sb b/sandbox/agent.sb
index 3a517dd..6f27fdc 100644
--- a/sandbox/agent.sb
+++ b/sandbox/agent.sb
@@ -1,9 +1,10 @@
 ;; OS-level fence for lanes whose output leaves the machine: the agent has a real shell, so the real home must be
-;; unreachable. Only the agent's own install is opened. Network stays open. HOME is passed with -D HOME=<real home>.
+;; unreachable. Only the lane's selected install is opened. Network stays open.
+;; HOME is the real home; AGENT_HOME is the lane-specific exception path.
 (version 1)
 (allow default)
 (deny file-read-data (subpath (param "HOME")))
 (deny file-write* (subpath (param "HOME")))
-(allow file-read-data (subpath (string-append (param "HOME") "/.kimi-code")))
-(allow file-write* (subpath (string-append (param "HOME") "/.kimi-code")))
+(allow file-read-data (subpath (param "AGENT_HOME")))
+(allow file-write* (subpath (param "AGENT_HOME")))
 (deny process-exec (literal "/bin/launchctl") (literal "/usr/bin/security") (literal "/usr/bin/osascript"))
