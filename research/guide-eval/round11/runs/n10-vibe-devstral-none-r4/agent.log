          published: true,\n          },\n        ],\n      },\n    },\n  });\n\n  console.log('Created user:', user);\n\n  // Query all users with their posts\n  const usersWithPosts = await db.user.findMany({\n    include: {\n      posts: true,\n    },\n  });\n\n  console.log('\\nAll users with their posts:');\n  for (const user of usersWithPosts) {\n    console.log(`\\nUser: ${user.name || 'Unnamed'} (${user.email})`);\n    console.log('Posts:');\n    for (const post of user.posts) {\n      console.log(`  - ${post.title} (published: ${post.published})`);\n      if (post.content) {\n        console.log(`    Content: ${post.content}`);\n      }\n    }\n  }\n}\n\nmain()\n  .catch((e) => {\n    console.error(e);\n    process.exit(1);\n  })\n  .finally(async () => {\n    await db.$disconnect();\n  });\n","fileExisted":false,"previousContent":null},"approvalSource":"bypass","display":{"success":true,"verb":"Created","message":"script.ts","warnings":[],"approvalNote":null,"suffix":""}}}
