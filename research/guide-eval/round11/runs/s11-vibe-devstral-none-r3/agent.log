{"id":"effect-ae6a4130-17c2-5e81-8abb-0c5fc3625f67","sessionId":"cb1b579b-a4ed-295c-9696-f1030ea14b38","turnId":"turn-8bd04679712c34ce8e7fb14ef01d9362","inputEntryId":"user-turn-8bd04679712c34ce8e7fb14ef01d9362-1","createdAt":1794279791675,"updatedAt":1794279791695,"generationStatus":"completed","relatedEntryId":null,"type":"effect","title":"file_system.edit","detail":{"toolName":"file_system.edit","display":{"summary":"Editing src/app.py","content":null,"suffix":"","verb":"Editing","message":"src/app.py","settledVerb":"Edited","settledMessage":"src/app.py","statusText":"Editing file"},"kind":"file_edit","input":{"filePath":"src/app.py","oldString":"\"\"\"Story library: the publish handler.\n\nEach story is stored in one DynamoDB item together with the three most similar\nstories already in the library (``similar``), so the reader page can show\n\"related\" without a query at read time.\n\"\"\"\nimport json\nimport logging\nimport re\nimport time","newString":"\"\"\"Story library: the publish handler.\n\nEach story is stored in one DynamoDB item together with the three most similar\nstories already in the library (``similar``), so the reader page can show\n\"related\" without a query at read time.\n\"\"\"\nimport json\nimport logging\nimport re\nimport time\nfrom decimal import Decimal","replaceAll":false}},"state":{"status":"completed","outputText":"","output":{"file":"/private/tmp/h-MZ7H8q/src/app.py","oldString":null,"newString":null,"occurrences":[{"startLine":1,"newStartLine":1,"oldText":"\"\"\"Story library: the publish handler.\n\nEach story is stored in one DynamoDB item together with the three most similar\nstories already in the library (``similar``), so the reader page can show\n\"related\" without a query at read time.\n\"\"\"\nimport json\nimport logging\nimport re\nimport time","newText":"\"\"\"Story library: the publish handler.\n\nEach story is stored in one DynamoDB item together with the three most similar\nstories already in the library (``similar``), so the reader page can show\n\"related\" without a query at read time.\n\"\"\"\nimport json\nimport logging\nimport re\nimport time\nfrom decimal import Decimal"}],"previousContent":"\"\"\"Story library: the publish handler.\n\nEach story is stored in one DynamoDB item together with the three most similar\nstories already in the library (``similar``), so the reader page can show\n\"related\" without a query at read time.\n\"\"\"\nimport json\nimport logging\nimport re\nimport time\n\nlog = logging.getLogger(\"stories\")\n\nTABLE_NAME = \"stories\"\nTOP_N = 3\n\n_WORD = re.compile(r\"[a-z0-9]+\")\n\n\ndef words(text):\n    return set(_WORD.findall((text or \"\").lower()))\n\n\ndef similarity(a, b):\n    \"\"\"Shared-tag ratio (Jaccard), blended with shared words of the two bodies.\"\"\"\n    ta, tb = set(a.get(\"tags\", [])), set(b.get(\"tags\", []))\n    tag_score = len(ta & tb) / len(ta | tb) if (ta | tb) else 0\n    wa, wb = words(a.get(\"body\")), words(b.get(\"body\"))\n    word_score = len(wa & wb) / len(wa | wb) if (wa | wb) else 0\n    return round(0.7 * tag_score + 0.3 * word_score, 4)\n\n\ndef related(story, existing):\n    scored = []\n    for other in existing:\n        if other[\"slug\"] == story[\"slug\"]:\n            continue\n        scored.append({\"slug\": other[\"slug\"], \"score\": similarity(story, other)})\n    scored.sort(key=lambda s: s[\"score\"], reverse=True)\n    return scored[:TOP_N]\n\n\ndef validate(story):\n    for k in (\"slug\", \"title\", \"body\"):\n        if not story.get(k):\n            raise ValueError(f\"missing field: {k}\")\n    if not re.fullmatch(r\"[a-z0-9-]{3,80}\", story[\"slug\"]):\n        raise ValueError(\"bad slug\")\n\n\ndef publish(table, story):\n    \"\"\"Store ``story`` with its related stories. Returns the stored item.\"\"\"\n    validate(story)\n    existing = table.scan(TableName=TABLE_NAME).get(\"Items\", [])\n    item = {\n        \"slug\": story[\"slug\"],\n        \"title\": story[\"title\"],\n        \"tags\": sorted(set(story.get(\"tags\", []))),\n        \"body\": story[\"body\"],\n        \"published_at\": int(time.time()),\n        \"similar\": related(story, existing),\n    }\n    table.put_item(Item=item)\n    log.info(\"publish slug=%s similar=%d stored\", item[\"slug\"], len(item[\"similar\"]))\n    return item\n\n\ndef handler(event, table):\n    \"\"\"Lambda-style entry point for POST /stories. Body is the story as JSON.\"\"\"\n    try:\n        story = json.loads(event.get(\"body\") or \"{}\")\n        stored = publish(table, story)\n        return {\"statusCode\": 201, \"body\": json.dumps({\"slug\": stored[\"slug\"]})}\n    except ValueError as e:\n        return {\"statusCode\": 400, \"body\": json.dumps({\"error\": str(e)})}\n    except Exception:\n        log.exception(\"publish failed\")\n        return {\"statusCode\": 500, \"body\": json.dumps({\"error\": \"Internal Server Error\"})}\n"},"approvalSource":"bypass","display":{"success":true,"verb":"Edited","message":"src/app.py","warnings":[],"approvalNote":null,"suffix":""},"durationMs":0.0,"decision":"execute","approvalType":"always"}}
