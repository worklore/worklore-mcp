@@ -128,9 +128,19 @@ def athlete_context(a, today):
 
 
 def build_system(a, today):
-    # One block, cached as a whole: instructions + per-athlete context.
-    text = INSTRUCTIONS + "\n\n" + athlete_context(a, today)
-    return [{"type": "text", "text": text, "cache_control": {"type": "ephemeral"}}]
+    """Construct the system prompt split into two cacheable blocks.
+
+    * The first block contains the static *INSTRUCTIONS* that never change
+      across users, dates, or fact updates. It is marked with
+      cache_control": {"type": "ephemeral"} so the provider can keep it
+      hot in the cache.
+    * The second block holds the volatile per‑athlete context (date, profile,
+      zones, goal, and long‑term facts). Changing a fact via save_fact now
+      only rewrites this tail block, leaving the static prefix cached.
+    """
+    static_block = {"type": "text", "text": INSTRUCTIONS, "cache_control": {"type": "ephemeral"}}
+    volatile_block = {"type": "text", "text": athlete_context(a, today)}
+    return [static_block, volatile_block]
 
