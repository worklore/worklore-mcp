{"id":"effect-c65d4845-f497-5ad9-a94e-4f3bbae5df10","sessionId":"f10cdddc-13d7-11ad-dd47-7c956e0fee8a","turnId":"turn-a4602183e669c84dc34bfbcc141a6364","inputEntryId":"user-turn-a4602183e669c84dc34bfbcc141a6364-1","createdAt":1794277197370,"updatedAt":1794277197395,"generationStatus":"completed","relatedEntryId":null,"type":"effect","title":"file_system.write_file","detail":{"toolName":"file_system.write_file","display":{"summary":"Writing src/transfer.ts","content":"import { Client, PrivateKey, AccountId, TransferTransaction, Hbar } from \"@hashgraph/sdk\";\nimport * as dotenv from \"dotenv\";\n\ndotenv.config();\n\nconst operatorId = AccountId.fromString(process.env.OPERATOR_ID!);\nconst operatorKey = PrivateKey.fromStringDer(process.env.OPERATOR_KEY!);\nconst recipientId = AccountId.fromString(process.env.RECIPIENT_ID!);\nconst validStart = new Date(Number(process.env.VALID_START) * 1000);\n\nconst client = Client.forName(\"testnet\");\nclient.operator = { accountId: operatorId, privateKey: operatorKey };\n\nconst tx = new TransferTransaction()\n  .setNodeAccountIds([AccountId.fromString(\"0.0.3\")])\n  .setTransactionId({ accountId: operatorId, validStart })\n  .addHbarTransfer(operatorId, new Hbar(-1))\n  .addHbarTransfer(recipientId, new Hbar(1))\n  .setMemo(\"invoice 42\");\n\nconst signedTx = await tx.sign(operatorKey);\n\nconsole.log(signedTx.toBytes().toString(\"hex\"));\n","suffix":"","verb":"Creating","message":"src/transfer.ts","settledVerb":"Created","settledMessage":"src/transfer.ts","statusText":"Writing file"},"kind":"file_write","input":{"filePath":"src/transfer.ts","content":"import { Client, PrivateKey, AccountId, TransferTransaction, Hbar } from \"@hashgraph/sdk\";\nimport * as dotenv from \"dotenv\";\n\ndotenv.config();\n\nconst operatorId = AccountId.fromString(process.env.OPERATOR_ID!);\nconst operatorKey = PrivateKey.fromStringDer(process.env.OPERATOR_KEY!);\nconst recipientId = AccountId.fromString(process.env.RECIPIENT_ID!);\nconst validStart = new Date(Number(process.env.VALID_START) * 1000);\n\nconst client = Client.forName(\"testnet\");\nclient.operator = { accountId: operatorId, privateKey: operatorKey };\n\nconst tx = new TransferTransaction()\n  .setNodeAccountIds([AccountId.fromString(\"0.0.3\")])\n  .setTransactionId({ accountId: operatorId, validStart })\n  .addHbarTransfer(operatorId, new Hbar(-1))\n  .addHbarTransfer(recipientId, new Hbar(1))\n  .setMemo(\"invoice 42\");\n\nconst signedTx = await tx.sign(operatorKey);\n\nconsole.log(signedTx.toBytes().toString(\"hex\"));\n"}},"state":{"status":"completed","outputText":"","approvalType":"always","approvalSource":"bypass","display":{"success":true,"verb":"Created","message":"src/transfer.ts","warnings":[],"approvalNote":null,"suffix":""},"output":{"filePath":"/private/tmp/h-PAiFyI/src/transfer.ts","content":"import { Client, PrivateKey, AccountId, TransferTransaction, Hbar } from \"@hashgraph/sdk\";\nimport * as dotenv from \"dotenv\";\n\ndotenv.config();\n\nconst operatorId = AccountId.fromString(process.env.OPERATOR_ID!);\nconst operatorKey = PrivateKey.fromStringDer(process.env.OPERATOR_KEY!);\nconst recipientId = AccountId.fromString(process.env.RECIPIENT_ID!);\nconst validStart = new Date(Number(process.env.VALID_START) * 1000);\n\nconst client = Client.forName(\"testnet\");\nclient.operator = { accountId: operatorId, privateKey: operatorKey };\n\nconst tx = new TransferTransaction()\n  .setNodeAccountIds([AccountId.fromString(\"0.0.3\")])\n  .setTransactionId({ accountId: operatorId, validStart })\n  .addHbarTransfer(operatorId, new Hbar(-1))\n  .addHbarTransfer(recipientId, new Hbar(1))\n  .setMemo(\"invoice 42\");\n\nconst signedTx = await tx.sign(operatorKey);\n\nconsole.log(signedTx.toBytes().toString(\"hex\"));\n","fileExisted":false,"previousContent":null},"decision":"execute","durationMs":0.0}}
