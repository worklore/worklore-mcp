nreachable. Only the agent's own install is opened. Network stays open. HOME is passed with -D HOME=<real home>.\n(version 1)\n(allow default)\n(deny file-read-data (subpath (param \"HOME\")))\n(deny file-write* (subpath (param \"HOME\")))\n(allow file-read-data (subpath (string-append (param \"HOME\") \"/.kimi-code\")))\n(allow file-write* (subpath (string-append (param \"HOME\") \"/.kimi-code\")))\n(deny process-exec (literal \"/bin/launchctl\") (literal \"/usr/bin/security\") (literal \"/usr/bin/osascript\"))","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_0178H5YDBENeLfLpLp2r8CRs","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
