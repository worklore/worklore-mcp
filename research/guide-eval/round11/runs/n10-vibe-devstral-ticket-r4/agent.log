    published: false,\n    authorId: user.id,\n  });\n\n  const post2 = await db.orm.public.Post.create({\n    title: 'Second Post',\n    content: 'This is my second post',\n    published: true,\n    authorId: user.id,\n  });\n\n  console.log('Created posts:', post1, post2);\n\n  // Print every user together with their posts\n  const usersWithPosts = await db.orm.public.User.include('posts').all();\n  \n  console.log('\\nAll users with their posts:');\n  for (const u of usersWithPosts) {\n    console.log(`\\nUser: ${u.email} (${u.name || 'no name'})`);\n    console.log('Posts:');\n    for (const post of u.posts) {\n      console.log(`  - ${post.title} (published: ${post.published})`);\n      if (post.content) {\n        console.log(`    Content: ${post.content}`);\n      }\n    }\n  }\n\n  await db.close();\n}\n\nmain().catch((e) => {\n  console.error(e);\n  process.exit(1);\n});\n"},"display":{"success":true,"verb":"Edited","message":"script.ts","warnings":[],"approvalNote":null,"suffix":""},"approvalType":"always","durationMs":0.0,"approvalSource":"bypass"}}
