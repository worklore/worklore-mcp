TOR_ID!);\n  const operatorKey = PrivateKey.fromStringDer(process.env.OPERATOR_KEY!);\n  const recipientId = AccountId.fromString(process.env.RECIPIENT_ID!);\n  const validStart = parseInt(process.env.VALID_START!, 10);\n\n  const transaction = new TransferTransaction()\n    .setNodeAccountIds([AccountId.fromString(\"0.0.3\")])\n    .setTransactionId(\n      TransactionId.withValidStart(\n        operatorId,\n        new Timestamp(validStart, 0),\n      ),\n    )\n    .addHbarTransfer(operatorId, new Hbar(-1))\n    .addHbarTransfer(recipientId, new Hbar(1))\n    .setTransactionMemo(\"invoice 42\");\n\n  const signedTransaction = await transaction.signWith(\n    operatorKey.publicKey,\n    (message) => Promise.resolve(operatorKey.sign(message)),\n  );\n\n  console.log(signedTransaction.toBytes().toString(\"hex\"));\n}\n\nmain();","replaceAll":false}},"state":{"status":"completed","outputText":"","output":{"file":"/private/tmp/h-yZ9dJG/src/transfer.ts","oldString":null,"newString":null,"occurrences":[{"startLine":1,"newStartLine":1,"oldText":"import dotenv from \"dotenv\";\nimport {\n  TransferTransaction,\n  PrivateKey,\n  TransactionId,\n  AccountId,\n  Hbar,\n  Timestamp,\n} from \"@hiero-ledger/sdk\";\n\ndotenv.config();\n\nasync function main() {\n  const operatorId = AccountId.fromString(process.env.OPERATOR_ID!);\n  const operatorKey = PrivateKey.fromStringDer(process.env.OPERATOR_KEY!);\n  const recipientId = AccountId.fromString(process.env.RECIPIENT_ID!);\n  const validStart = parseInt(process.env.VALID_START!, 10);\n\n  const transaction = new TransferTransaction()\n    .setNodeAccountIds([AccountId.fromString(\"0.0.3\")])\n    .setTransactionId(\n      TransactionId.withValidStart(\n        operatorId,\n        new Timestamp(validStart, 0),\n      ),\n    )\n    .addHbarTransfer(operatorId, new Hbar(-1))\n    .addHbarTransfer(recipientId, new Hbar(1))\n    .setTransactionMemo(\"invoice 42\");\n\n  const signedTransaction = await (transaction as any).sign(operatorKey);\n\n  console.log(signedTransaction.toBytes().toString(\"hex\"));\n}\n\nmain();","newText":"import dotenv from \"dotenv\";\nimport {\n  TransferTransaction,\n  PrivateKey,\n  TransactionId,\n  AccountId,\n  Hbar,\n  Timestamp,\n} from \"@hiero-ledger/sdk\";\n\ndotenv.config();\n\nasync function main() {\n  const operatorId = AccountId.fromString(process.env.OPERATOR_ID!);\n  const operatorKey = PrivateKey.fromStringDer(process.env.OPERATOR_KEY!);\n  const recipientId = AccountId.fromString(process.env.RECIPIENT_ID!);\n  const validStart = parseInt(process.env.VALID_START!, 10);\n\n  const transaction = new TransferTransaction()\n    .setNodeAccountIds([AccountId.fromString(\"0.0.3\")])\n    .setTransactionId(\n      TransactionId.withValidStart(\n        operatorId,\n        new Timestamp(validStart, 0),\n      ),\n    )\n    .addHbarTransfer(operatorId, new Hbar(-1))\n    .addHbarTransfer(recipientId, new Hbar(1))\n    .setTransactionMemo(\"invoice 42\");\n\n  const signedTransaction = await transaction.signWith(\n    operatorKey.publicKey,\n    (message) => Promise.resolve(operatorKey.sign(message)),\n  );\n\n  console.log(signedTransaction.toBytes().toString(\"hex\"));\n}\n\nmain();"}],"previousContent":"import dotenv from \"dotenv\";\nimport {\n  TransferTransaction,\n  PrivateKey,\n  TransactionId,\n  AccountId,\n  Hbar,\n  Timestamp,\n} from \"@hiero-ledger/sdk\";\n\ndotenv.config();\n\nasync function main() {\n  const operatorId = AccountId.fromString(process.env.OPERATOR_ID!);\n  const operatorKey = PrivateKey.fromStringDer(process.env.OPERATOR_KEY!);\n  const recipientId = AccountId.fromString(process.env.RECIPIENT_ID!);\n  const validStart = parseInt(process.env.VALID_START!, 10);\n\n  const transaction = new TransferTransaction()\n    .setNodeAccountIds([AccountId.fromString(\"0.0.3\")])\n    .setTransactionId(\n      TransactionId.withValidStart(\n        operatorId,\n        new Timestamp(validStart, 0),\n      ),\n    )\n    .addHbarTransfe