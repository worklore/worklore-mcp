{"id":"effect-c8c946b7-b5ee-5ba6-b074-729c7785f04e","sessionId":"b66d6af1-9a4b-35a2-729b-10fec552eab8","turnId":"turn-05b2c357439c933f8998cc2a56bdbe88","inputEntryId":"user-turn-05b2c357439c933f8998cc2a56bdbe88-1","createdAt":1794284572168,"updatedAt":1794284572177,"generationStatus":"completed","relatedEntryId":null,"type":"effect","title":"file_system.read_file","detail":{"toolName":"file_system.read_file","display":{"summary":"Reading src/transfer.ts","content":null,"suffix":"","verb":"Reading","message":"src/transfer.ts","settledVerb":"Read","settledMessage":"src/transfer.ts","statusText":"Reading file"},"kind":"file_read","input":{"filePath":"src/transfer.ts","offset":null,"limit":2000}},"state":{"status":"completed","outputText":"","output":{"filePath":"/private/tmp/h-yZ9dJG/src/transfer.ts","content":"import dotenv from \"dotenv\";\nimport {\n  TransferTransaction,\n  PrivateKey,\n  TransactionId,\n  AccountId,\n  Hbar,\n  Timestamp,\n} from \"@hiero-ledger/sdk\";\n\ndotenv.config();\n\nasync function main() {\n  const operatorId = AccountId.fromString(process.env.OPERATOR_ID!);\n  const operatorKey = PrivateKey.fromStringDer(process.env.OPERATOR_KEY!);\n  const recipientId = AccountId.fromString(process.env.RECIPIENT_ID!);\n  const validStart = parseInt(process.env.VALID_START!, 10);\n\n  const transaction = new TransferTransaction()\n    .setNodeAccountIds([AccountId.fromString(\"0.0.3\")])\n    .setTransactionId(\n      TransactionId.withValidStart(\n        operatorId,\n        new Timestamp(validStart, 0),\n      ),\n    )\n    .addHbarTransfer(operatorId, new Hbar(-1))\n    .addHbarTransfer(recipientId, new Hbar(1))\n    .setTransactionMemo(\"invoice 42\");\n\n  const frozenTransaction = transaction.freeze();\n  const signedTransaction = await frozenTransaction.signWith(\n    operatorKey.publicKey,\n    (message) => Promise.resolve(operatorKey.sign(message)),\n  );\n\n  const bytes = signedTransaction.toBytes();\n  console.log(Buffer.from(bytes).toString(\"hex\"));\n}\n\nmain();\n","numLines":41,"startLine":1,"requestedOffset":null,"requestedLimit":2000,"totalLines":null,"wasTruncated":false},"approvalSource":"bypass","durationMs":0.0,"display":{"success":true,"verb":"Read","message":"41 lines from src/transfer.ts","warnings":[],"approvalNote":null,"suffix":""},"approvalType":"always","decision":"execute"}}
