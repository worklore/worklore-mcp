 def build_system(a, today):
-    # One block, cached as a whole: instructions + per-athlete context.
-    text = INSTRUCTIONS + "\n\n" + athlete_context(a, today)
-    return [{"type": "text", "text": text, "cache_control": {"type": "ephemeral"}}]
+    """Construct the system prompt split into a static and a dynamic block.
+
+    The original implementation returned a single block marked as ``ephemeral``
+    which caused the entire system prompt to be evicted from the cache after a
+    memory‑write (e.g., ``save_fact``). The static instructions never change, so
+    they should be cached with ``type": "static"`. By separating the static
+    instructions from the per‑athlete context we keep the immutable part cached
+    while still allowing the dynamic context to be recomputed each request.
+    """
+    # Static block – constant for all athletes.
+    static_block = {
+        "type": "text",
+        "text": INSTRUCTIONS,
+        "cache_control": {"type": "static"},
+    }
+
+    # Dynamic block – varies per athlete and date.
+    dynamic_block = {
+        "type": "text",
+        "text": athlete_context(a, today),
+        # No cache_control means default (ephemeral).
+    }
+
+    return [static_block, dynamic_block]
 
