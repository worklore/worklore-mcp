 T=$1; A=$2; REP=${3:-1}
@@ -15,6 +16,23 @@ codex_run() {
       -o "$R/final.txt" "$P" < /dev/null > "$R/agent.log" 2> "$R/agent.err" )
 }
 
+# Codex run inside sandbox/agent.sb. Mirrors `codex_run` but writes the
+# result file to a temporary HOME directory that the sandbox profile allows,
+# then copies it back into the run folder after the sandbox exits.
+codex_sandboxed_run() {
+  local REAL="$HOME" SH; SH=$(mktemp -d /tmp/codex-sb-XXXXXX)
+  ( cd "$W" && export HOME="$SH" && sandbox-exec -D HOME="$REAL" -f "$D/sandbox/agent.sb" \
+      timeout $TO codex exec --skip-git-repo-check --dangerously-bypass-approvals-and-sandbox -C "$W" --json \
+      -o "$SH/final.txt" "$P" < /dev/null > "$R/agent.log" 2> "$R/agent.err" )
+  local rc=$?
+  # Copy the final answer out of the sandbox‑restricted home.
+  if [ -f "$SH/final.txt" ]; then
+    cp "$SH/final.txt" "$R/final.txt"
+  fi
+  rm -rf "$SH"
+  return $rc
+}
+
