 #!/usr/bin/env bash
 # usage: run.sh <task> <lane> [rep]
-# lanes: codex   Codex CLI, unsandboxed
-#        kimi    Kimi Code under sandbox/agent.sb (no reading or writing the real home), scratch HOME
+# lanes: codex            Codex CLI, unsandboxed
+#        codex-sandboxed  the same Codex run under sandbox/agent.sb (no reading or writing the real home), scratch HOME
+#        kimi             Kimi Code under sandbox/agent.sb (no reading or writing the real home), scratch HOME
 set -u
 D="$(cd "$(dirname "$0")" && pwd)"
 T=$1; A=$2; REP=${3:-1}
@@ -15,6 +16,21 @@ codex_run() {
       -o "$R/final.txt" "$P" < /dev/null > "$R/agent.log" 2> "$R/agent.err" )
 }
 
+# Codex under sandbox/agent.sb. Codex writes its last message from inside the sandbox, and the profile denies writes
+# under the real home, which includes the run folder. Codex does not fail on that: it prints a warning and exits 0.
+# So -o points at a scratch folder in /tmp, and the lane copies the file into the run folder after sandbox-exec returns.
+# Scratch HOME and CODEX_HOME mean the agent does not see the real ~/.codex (its login); the key comes from CODEX_API_KEY.
+codex_sandboxed_run() {
+  local REAL="$HOME" SH SCR rc; SH=$(mktemp -d /tmp/chome-XXXXXX); mkdir -p "$SH/.codex"; SCR=$(mktemp -d /tmp/cout-XXXXXX)
+  ( cd "$W" && export HOME="$SH" CODEX_HOME="$SH/.codex" && sandbox-exec -D HOME="$REAL" -f "$D/sandbox/agent.sb" \
+      timeout $TO codex exec --skip-git-repo-check --dangerously-bypass-approvals-and-sandbox -C "$W" --json \
+      -o "$SCR/final.txt" "$P" < /dev/null > "$R/agent.log" 2> "$R/agent.err" )
+  rc=$?
+  if [ -s "$SCR/final.txt" ]; then cp "$SCR/final.txt" "$R/final.txt"
+  else echo "run.sh: no last message was written (exit $rc); final.txt is missing" >> "$R/agent.err"; fi
+  rm -rf "$SH" "$SCR"; return $rc
+}
+
 # Kimi's output goes to Moonshot: its shell runs under sandbox/agent.sb with an empty scratch HOME.
 kimi_run() {
   local REAL="$HOME" SH; SH=$(mktemp -d /tmp/khome-XXXXXX)
@@ -27,6 +43,7 @@ kimi_run() {
 start=$(date +%s)
 case $A in
   codex) codex_run;;
+  codex-sandboxed) codex_sandboxed_run;;
   kimi)  kimi_run;;
   *) echo "unknown lane $A"; exit 2;;
 esac
