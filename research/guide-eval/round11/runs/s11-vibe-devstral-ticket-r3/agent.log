 def test_publish_with_existing_story(self):\n        table = FakeTable()\n        existing = {\n            \"slug\": \"existing-story\",\n            \"title\": \"Existing\",\n            \"tags\": [\"cron\", \"linux\"],\n            \"body\": \"Some existing content.\",\n        }\n        app.publish(table, existing)\n        story = {\n            \"slug\": \"why-my-cron-ran-twice\",\n            \"title\": \"Why my cron ran twice\",\n            \"tags\": [\"cron\", \"linux\"],\n            \"body\": \"Two crontabs, one for root and one for me, both had the line.\",\n        }\n        stored = app.publish(table, story)\n        self.assertEqual(stored[\"slug\"], \"why-my-cron-ran-twice\")\n        self.assertEqual(table.scan()[\"Count\"], 2)\n        self.assertIn(\"similar\", stored)\n        self.assertIsInstance(stored[\"similar\"][0][\"score\"], int)","replaceAll":false}},"state":{"status":"completed","outputText":"","decision":"execute","output":{"file":"/private/tmp/h-Lntqpi/tests/test_publish.py","oldString":null,"newString":null,"occurrences":[{"startLine":13,"newStartLine":13,"oldText":"    def test_publish_stores_story(self):\n        table = FakeTable()\n        story = {\n            \"slug\": \"why-my-cron-ran-twice\",\n            \"title\": \"Why my cron ran twice\",\n            \"tags\": [\"cron\", \"linux\"],\n            \"body\": \"Two crontabs, one for root and one for me, both had the line.\",\n        }\n        stored = app.publish(table, story)\n        self.assertEqual(stored[\"slug\"], \"why-my-cron-ran-twice\")\n        self.assertEqual(table.get_item(Key={\"slug\": \"why-my-cron-ran-twice\"})[\"Item\"][\"title\"], \"Why my cron ran twice\")\n        self.assertEqual(table.scan()[\"Count\"], 1)","newText":"    def test_publish_stores_story(self):\n        table = FakeTable()\n        story = {\n            \"slug\": \"why-my-cron-ran-twice\",\n            \"title\": \"Why my cron ran twice\",\n            \"tags\": [\"cron\", \"linux\"],\n            \"body\": \"Two crontabs, one for root and one for me, both had the line.\",\n        }\n        stored = app.publish(table, story)\n        self.assertEqual(stored[\"slug\"], \"why-my-cron-ran-twice\")\n        self.assertEqual(table.get_item(Key={\"slug\": \"why-my-cron-ran-twice\"})[\"Item\"][\"title\"], \"Why my cron ran twice\")\n        self.assertEqual(table.scan()[\"Count\"], 1)\n\n    def test_publish_with_existing_story(self):\n        table = FakeTable()\n        existing = {\n            \"slug\": \"existing-story\",\n            \"title\": \"Existing\",\n            \"tags\": [\"cron\", \"linux\"],\n            \"body\": \"Some existing content.\",\n        }\n        app.publish(table, existing)\n        story = {\n            \"slug\": \"why-my-cron-ran-twice\",\n            \"title\": \"Why my cron ran twice\",\n            \"tags\": [\"cron\", \"linux\"],\n            \"body\": \"Two crontabs, one for root and one for me, both had the line.\",\n        }\n        stored = app.publish(table, story)\n        self.assertEqual(stored[\"slug\"], \"why-my-cron-ran-twice\")\n        self.assertEqual(table.scan()[\"Count\"], 2)\n        self.assertIn(\"similar\", stored)\n        self.assertIsInstance(stored[\"similar\"][0][\"score\"], int)"}],"previousContent":"import os\nimport sys\nimport unittest\n\nsys.path.insert(0, os.path.join(os.path.dirname(__file__), \"..\", \"src\"))\nsys.path.insert(0, os.path.dirname(__file__))\n\nimport app  # noqa: E402\nfrom fake_dynamo import FakeTable  # noqa: E402\n\n\nclass PublishTest(unittest.TestCase):\n    def test_publish_stores_story(self):\n        table = FakeTable()\n        story = {\n            \"slug\": \"why-my-cron-ran-twice\",\n            \"title\": \"Why my cron ran twice\",\n            \"tags\": [\"cron\", \"linux\"],\n            \"body\": \"Two crontabs, one for root and one for me, both had the line.\",\n        }\n        stored = app.publish(table, story)\n        self.assertEqual(stored[\"slug\"], \"why-my-cron-ran-twice\")\n        self.assertEqual(table.get_item(Key={\"slug\": \"why-my-cron-ran-twice\"})[\"Item\"][\"title\"], \"Why my cron ran twice\")\n        self.assertEqual(table.scan()[\"Count\"], 1)\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n"},"approvalSource":"bypass","durationMs":0.0,"approvalType":"always","display":{"success":true,"verb":"Edited","message":"tests/test_publish.py","warnings":[],"approvalNote":null,"suffix":""}}}
