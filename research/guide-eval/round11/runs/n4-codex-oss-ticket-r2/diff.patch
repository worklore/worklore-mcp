--- a/run.sh
+++ b/run.sh
@@ -1,7 +1,11 @@
 #!/usr/bin/env bash
 # usage: run.sh <task> <lane> [rep]
-# lanes: codex   Codex CLI, unsandboxed
-#        kimi    Kimi Code under sandbox/agent.sb (no reading or writing the real home), scratch HOME
+# lanes: codex           Codex CLI, unsandboxed
+#        codex-sandboxed Codex CLI executed inside sandbox/agent.sb so the agent
+#                         cannot read/write the real HOME directory (uses a
+#                         temporary scratch folder for output files).
+#        kimi            Kimi Code under sandbox/agent.sb (no reading or writing
+#                         the real home), scratch HOME
 set -u
 D="$(cd "$(dirname "$0")" && pwd)"
 T=$1; A=$2; REP=${3:-1}
@@ -15,6 +19,23 @@ codex_run() {
       -o "$R/final.txt" "$P" < /dev/null > "$R/agent.log" 2> "$R/agent.err" )
 }
 
+# Codex run inside sandbox/agent.sb, mirroring the "kimi" lane. The agent's
+# HOME is redirected to a temporary scratch directory, and the output file is
+# written there first (because the sandbox denies writes to the real HOME).
+# After the sandbox exits we move the result back into the run folder.
+codex_sandboxed_run() {
+  local REAL="$HOME" SCRATCH; SCRATCH=$(mktemp -d /tmp/codex-XXXXXX)
+  ( cd "$W" && export HOME="$SCRATCH" && sandbox-exec -D HOME="$REAL" -f "$D/sandbox/agent.sb" \
+      timeout $TO codex exec --skip-git-repo-check --dangerously-bypass-approvals-and-sandbox -C "$W" --json \
+      -o "$SCRATCH/final.txt" "$P" < /dev/null > "$R/agent.log" 2> "$R/agent.err" )
+  local rc=$?
+  if [ -f "$SCRATCH/final.txt" ]; then
+    mv "$SCRATCH/final.txt" "$R/final.txt"
+  fi
+  rm -rf "$SCRATCH"
+  return $rc
+}
+
 # Kimi's output goes to Moonshot: its shell runs under sandbox/agent.sb with an empty scratch HOME.
 kimi_run() {
   local REAL="$HOME" SH; SH=$(mktemp -d /tmp/khome-XXXXXX)
@@ -27,6 +48,7 @@ kimi_run() {
 start=$(date +%s)
 case $A in
   codex) codex_run;;
+  codex-sandboxed) codex_sandboxed_run;;
   kimi)  kimi_run;;
   *) echo "unknown lane $A"; exit 2;;
 esac
