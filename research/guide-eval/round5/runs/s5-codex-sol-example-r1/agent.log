{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"node <<'NODE'\nconst fs = require('fs');\nconst rules = fs.readFileSync('site/robots.txt', 'utf8').split('\\\\n')\n  .map(line => line.match(/\"'^(Allow|Disallow):'\"\\\\s*(\\\\S+)/))\n  .filter(Boolean).map(([, type, rule]) => ({type, rule}));\nconst cases = [\n  ['/v1/notes?limit=50', true],\n  ['/v1/notes/drip-line-pressure', true],\n  ['/v1/notes/drip-line-pressure/reactions', false],\n  ['/v1/me', false],\n  ['/v1/me/drafts', false],\n  ['/v1/auth/token', false],\n  ['/admin/', false],\n  ['/n/drip-line-pressure', true],\n];\nlet failed = false;\nfor (const [path, expected] of cases) {\n  const matches = rules.filter(({rule}) => new RegExp('\"'^'\"' + rule.split('*').map(s => s.replace(/[.*+?\"'^${}()|['\"\\\\]\\\\\\\\]/g, '\\\\\\\\\"'$&'\"')).join('.*')).test(path));\n  matches.sort((a, b) => b.rule.replace(/\\\\*/g, '').length - a.rule.replace(/\\\\*/g, '').length || (a.type === 'Allow' ? -1 : 1));\n  const allowed = \"'!matches.length || matches[0].type === '\"'Allow';\n  if (allowed \"'!== expected) failed = true;\n  process.stdout.write(`${allowed ? '\"'ALLOW' : 'BLOCK'} \"'${path}${allowed === expected ? '\"'' : ' FAIL'}\\\\n\"'`);\n}\nif (failed) process.exitCode = 1;\nNODE'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
