diff --git a/bin/nightly-review.zsh b/bin/nightly-review.zsh
index e0b986f..fedc574 100755
--- a/bin/nightly-review.zsh
+++ b/bin/nightly-review.zsh
@@ -13,14 +13,24 @@ For each commit: one line on what it changes and whether anything looks risky
 End with a three-line summary I can read on my phone.
 Do not modify any file."
 
+started=$(date +%s)
+
 cd "$REPO" || { "$NOTIFY" "nightly review: repo missing"; exit 1; }
 
-claude -p "$PROMPT" --output-format text > "$OUT"
-status=$?
+# `status` is a read-only special parameter in zsh (it is $?), so use rc.
+# < /dev/null: claude -p must not wait on stdin under launchd.
+claude -p "$PROMPT" --output-format text < /dev/null > "$OUT"
+rc=$?
+elapsed=$(( $(date +%s) - started ))
+
+if [ $rc -ne 0 ]; then
+  "$NOTIFY" "nightly review FAILED (exit $rc after ${elapsed}s), see $OUT and ~/Library/Logs/nightly-review.err"
+  exit $rc
+fi
 
-if [ $status -ne 0 ]; then
-  "$NOTIFY" "nightly review FAILED (exit $status), see $OUT"
-  exit $status
+if [ ! -s "$OUT" ]; then
+  "$NOTIFY" "nightly review FAILED (empty output after ${elapsed}s), see $OUT"
+  exit 1
 fi
 
-"$NOTIFY" "nightly review done: $(head -c 300 "$OUT")"
+"$NOTIFY" "nightly review done in ${elapsed}s: $(head -c 300 "$OUT")"
