{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport json, os, socket, subprocess, sys, time, urllib.request, urllib.error\ns=socket.socket(); s.bind(('127.0.0.1',0)); port=s.getsockname()[1]; s.close()\nenv=dict(os.environ,PORT=str(port))\np=subprocess.Popen([sys.executable,'server.py'],env=env,stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True)\nbase=f'http://127.0.0.1:{port}/mcp'\nfor _ in range(50):\n try:\n  socket.create_connection(('127.0.0.1',port),0.1).close(); break\n except OSError: time.sleep(.05)\ndef call(label, method, params=None, session=None, version='2025-06-18', auth=False):\n req={'jsonrpc':'2.0','id':label,'method':method}\n if params is not None: req['params']=params\n headers={'Content-Type':'application/json','Accept':'application/json, text/event-stream'}\n if session: headers['Mcp-Session-Id']=session\n if version: headers['MCP-Protocol-Version']=version\n if auth: headers['Authorization']='Bearer '+os.environ.get('NOTES_TOKEN','dev-token-123')\n try:\n  response=urllib.request.urlopen(urllib.request.Request(base,json.dumps(req).encode(),headers),timeout=3)\n except urllib.error.HTTPError as e: response=e\n try: body=response.read().decode()\n except Exception as e: body=f'<read error {type(e).__name__}>'\n try: obj=json.loads(body) if body else None\n except Exception: obj=body\n print(label,response.status,'session='+str(bool(response.headers.get('Mcp-Session-Id'))),json.dumps(obj,ensure_ascii=False)[:500])\n return response.status,obj,response.headers.get('Mcp-Session-Id')\ntry:\n call('discover','server/discover',version=None)\n _,init,sess=call('init','initialize',{'protocolVersion':'2025-06-18','capabilities':{},'clientInfo':{'name':'checkup','version':'1'}},version=None)\n call('initialized','notifications/initialized',session=sess)\n _,listed,_=call('list','tools/list',session=sess)\n call('resources','resources/list',session=sess)\n call('templates','resources/templates/list',session=sess)\n call('prompts','prompts/list',session=sess)\n call('missing','tools/call',{'name':'get_note','arguments':{'id':'n-999999'}},sess)\n call('absent','tools/call',{'name':'get_note','arguments':{}},sess)\n call('validget','tools/call',{'name':'get_note','arguments':{'id':'n-1'}},sess)\n call('validsearch','tools/call',{'name':'search_notes','arguments':{'query':'soil'}},sess)\n call('banana','initialize',{'protocolVersion':'banana','capabilities':{},'clientInfo':{'name':'checkup','version':'1'}},sess,version=None)\n call('auth_resources','resources/list',session=sess,auth=True)\n call('bad_resource','resources/read',{'uri':'notes://missing'},sess,auth=True)\nfinally:\n p.terminate()\n try: _,err=p.communicate(timeout=3)\n except subprocess.TimeoutExpired: p.kill(); _,err=p.communicate()\n print('LOG_LINES',len([x for x in err.splitlines() if x.startswith('{')]))\n for line in err.splitlines():\n  if line.startswith('{'): print('LOG',line)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
