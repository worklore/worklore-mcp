{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017FHEnukVVNBt7rB9TiyVuL","type":"tool_result","content":"diff --git a/site/app.js b/site/app.js\nindex 18cc3f0..a98d99d 100644\n--- a/site/app.js\n+++ b/site/app.js\n@@ -5,17 +5,25 @@\n   try {\n     if (m) {\n       const r = await fetch(`/v1/notes/${m[1]}`);\n+      if (r.status === 404) return notFound();\n       if (!r.ok) throw new Error(`HTTP ${r.status}`);\n       const note = await r.json();\n       document.title = `${note.title} · Field notes`;\n       app.innerHTML = `<article><h1>${esc(note.title)}</h1><p class=\"meta\">${esc(note.date)}</p>${note.html}</article>`;\n     } else {\n       const r = await fetch(\"/v1/notes?limit=50\");\n+      if (r.status === 404) return notFound();\n       if (!r.ok) throw new Error(`HTTP ${r.status}`);\n       const notes = await r.json();\n       app.innerHTML = \"<ul>\" + notes.map(n => `<li><a href=\"/n/${n.slug}\">${esc(n.title)}</a></li>`).join(\"\") + \"</ul>\";\n     }\n   } catch (e) {\n+    // A failed fetch is not a missing note: don't tell users (or crawlers) it doesn't exist.\n+    app.innerHTML = `<section class=\"error\"><h1>Couldn't load this page</h1><p>Please try again in a moment.</p><p><a href=\"/\">Back to all notes</a></p></section>`;\n+  }\n+  function notFound() {\n+    const robots = document.querySelector('meta[name=\"robots\"]');\n+    if (robots) robots.content = \"noindex\";\n     app.innerHTML = `<section class=\"notfound\"><h1>NOT FOUND</h1><p>No note lives at this address.</p><p><a href=\"/\">Back to all notes</a></p></section>`;\n   }\n   function esc(s) { return String(s).replace(/[&<>\"]/g, c => ({\"&\":\"&amp;\",\"<\":\"&lt;\",\">\":\"&gt;\",'\"':\"&quot;\"}[c])); }","is_error":false}]},"parent_tool_use_id":null,"session_id":"d5125156-b32d-47d6-9b90-7651cb1e4ca4","uuid":"b7f8bb6f-4e27-4942-8273-af0d985158b5","timestamp":"2026-10-19T02:41:05.016Z","tool_use_result":{"stdout":"diff --git a/site/app.js b/site/app.js