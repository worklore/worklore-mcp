{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport json, urllib.request, urllib.error\nurl='http://127.0.0.1:55632/mcp'\nsession=None\ndef call(label, method, params=None, version='2025-06-18', new=False, notification=False):\n    global session\n    obj={'jsonrpc':'2.0','method':method}\n    if not notification: obj['id']=label\n    if params is not None: obj['params']=params\n    if method=='initialize': obj['params']={'protocolVersion':version,'capabilities':{},'clientInfo':{'name':'checkup','version':'1'}}\n    h={'Content-Type':'application/json','Accept':'application/json, text/event-stream'}\n    if session and not new: h['Mcp-Session-Id']=session\n    request=urllib.request.Request(url,data=json.dumps(obj).encode(),headers=h,method='POST')\n    try: response=urllib.request.urlopen(request,timeout=5)\n    except urllib.error.HTTPError as e: response=e\n    raw=response.read().decode(); sid=response.headers.get('Mcp-Session-Id')\n    if sid: session=sid\n    if raw.startswith('data:'): raw=''.join(line[5:].strip() for line in raw.splitlines() if line.startswith('data:'))\n    try: body=json.loads(raw) if raw else None\n    except json.JSONDecodeError: body={'UNPARSEABLE':raw[:200]}\n    print(json.dumps({'label':label,'status':response.status,'session_header':bool(sid),'body':body},ensure_ascii=False))\ncall('init','initialize')\ncall('initialized','notifications/initialized',notification=True)\ncall('discover','server/discover')\ncall('tools','tools/list')\ncall('resources','resources/list')\ncall('templates','resources/templates/list')\ncall('prompts','prompts/list')\ncall('notfound','tools/call',{'name':'get_note','arguments':{'id':'n-999999'}})\ncall('missing','tools/call',{'name':'get_note','arguments':{}})\ncall('after_error','tools/call',{'name':'get_note','arguments':{'id':'n-1'}})\ncall('search','tools/call',{'name':'search_notes','arguments':{'query':'compost'}})\ncall('banana','initialize',version='banana',new=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
