d = false;\n    40\t\n    41\t  bool _sampleRequestedDuringCapture = false;\n    42\t\n    43\t  /// Whether a substitute source (bridge or placeholder) owns the current\n    44\t  /// episode. Not the same as \"occluded\": with the bridge off, occlusion is\n    45\t  /// ignored and Flutter capture keeps running.\n    46\t  bool _suppressFlutterCapture = false;\n    47\t\n    48\t  @visibleForTesting\n    49\t  bool get debugFlutterCaptureSuppressed => _suppressFlutterCapture;\n    50\t\n    51\t  void _setSuppressFlutterCapture(bool value) {\n    52\t    _suppressFlutterCapture = value;\n    53\t    _changeDetector?.suppressForcedFrames = value;\n    54\t  }\n    55\t\n    56\t  @override\n    57\t  void initState() {\n    58\t    super.initState();\n    59\t\n    60\t    final config = Posthog().config;\n    61\t    if (config == null) {\n    62\t      if (!kIsWeb) {\n    63\t        debugPrint(\n    64\t          '[PostHog] PostHogWidget mounted before Posthog().setup(). '\n    65\t          'If you intend to use mobile session replay, call setup() before runApp(), '\n    66\t          'or remount PostHogWidget after setup(). '\n    67\t          'Otherwise, you can ignore this message.',\n    68\t        );\n    69\t      }\n    70\t      return;\n    71\t    }\n    72\t\n    73\t    if (_capturesSnapshots && config.sessionReplay) {\n    74\t      _initComponents(config);\n    75\t      _changeDetector?.start();\n    76\t    }\n    77\t\n    78\t    PostHogInternalEvents.sessionRecordingActive.addListener(\n    79\t      _onSessionRecordingChanged,\n    80\t    );\n    81\t    PostHogInternalEvents.nativeOcclusionEvent.addListener(\n    82\t      _onNativeOcclusionChanged,\n    83\t    );\n    84\t    PostHogInternalEvents.forceReplaySessionReset.addListener(\n    85\t      _onForcedReplaySessionReset,\n    86\t    );\n    87\t  }\n    88\t\n    89\t  /// How many poll ticks keep forcing a frame after [_ensureSampleLands], if no\n    90\t  /// frame has been delivered yet. Each is a throttleDelay apart, so at the\n    91\t  /// default 1 s cadence this covers windows measured in milliseconds.\n    92\t  static const _sampleRetryTicks = 3;\n    93\t\n    94\t  /// Drops the per-session state directly, rather than waiting for a tick to\n    95\t  /// read the new id. See [PostHogInternalEvents.forceReplaySessionReset].\n    96\t  void _onForcedReplaySessionReset() {\n    97\t    _screenshotCapturer?.resetSessionStateIfNeeded(null, force: true);\n    98\t    // No sample this turn, only the retry budget: at an identity or project\n    99\t    // boundary the host is usually about to replace the screen, and a frame\n   100\t    // forced now would record the pre-boundary UI into the session that\n   101\t    // replaces it. A repaint within the next tick delivers the new session's\n   102\t    // first frame instead; the budget covers a screen that never repaints.\n   103\t    _changeDetector?.forceNextTicks(_sampleRetryTicks);\n   104\t  }\n   105\t\n   106\t  /// The single way to sample out of band, for callers that need the next frame\n   107\t  /// recorded and cannot wait for the screen to change on its own.\n   108\t  ///\n   109\t  /// Two things swallow such a request and every caller needs cover for both: a\n   110\t  /// capture already in flight, and a platform briefly not recording when the\n   111\t  /// sample lands. Hence deferring past the in-flight capture *and* a retry\n   112\t  /// budget, which delivery cancels.\n   113\t  void _ensureSampleLands() {\n   114\t    if (_isCapturing) {\n   115\t      _sampleRequestedDuringCapture = true;\n   116\t    } else {\n   117\t      _changeDetector?.requestImmediateSample();\n   118\t    }\n   119\t    _changeDetector?.forceNextTicks(_sampleRetryTicks);\n   120\t  }\n---\n## 5.41.1\n\n### Patch Changes\n\n- 696ab7f: Warn when PostHogWidget mounts before Posthog().setup() on mobile, explaining that session replay requires setup before mounting or remounting the widge