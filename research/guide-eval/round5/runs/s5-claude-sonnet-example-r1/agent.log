cd /private/tmp/h-vF5sRk && cat > site/robots.txt <<'E'\nUser-agent: *\nDisallow: /v1/\nDisallow: /admin/\n# Public read endpoints the note pages render from (longest match wins)\nAllow: /v1/notes\n# POST-only / per-user paths stay blocked (longer rules beat Allow: /v1/notes)\nDisallow: /v1/notes/*/reactions\n\nSitemap: https://fieldnotes.example/sitemap.xml\nE\ncat > /tmp/rt.py <<'E'\nimport re,sys\nrules=[]\nfor l in open(sys.argv[1]):\n    m=re.match(r'(Allow|Disallow):\\s*(\\S+)',l)\n    if m: rules.append((m[1],m[2]))\ndef rx(p): return re.compile(re.escape(p).replace(r'\\*','.*').replace(r'\\$','$'))\ndef ok(path):\n    best=(-1,True)\n    for k,p in rules:\n        if rx(p).match(path):\n            c=(len(p),k=='Allow')\n            if c>best[:2] or best[0]==-1: best=(len(p),k=='Allow')\n    return best[1]\nfor p in ['/v1/notes/drip-line-pressure','/v1/notes?limit=50','/v1/notes/x/reactions','/v1/me','/v1/me/drafts','/v1/auth/token','/admin/x','/n/drip-line-pressure']:\n    print(p,'ALLOW' if ok(p) else 'BLOCK')\nE\npython3 -I /tmp/rt.py site/robots.txt"}},"wire_ingest_context":{"toolu_01XZBwnAgKenoKwnSxSQoJ4n":{"cwd":"/private/tmp/h-vF5sRk"}}}
