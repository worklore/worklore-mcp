{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport json, subprocess, sys, time, urllib.request, urllib.error\np=subprocess.Popen([sys.executable,'server.py'],stdout=subprocess.DEVNULL,stderr=subprocess.PIPE,text=True)\nurl='http://127.0.0.1:52028/mcp'\nfor _ in range(50):\n try:\n  urllib.request.urlopen(urllib.request.Request(url,data=b'{}',headers={'Content-Type':'application/json'}),timeout=.3)\n  break\n except Exception: time.sleep(.05)\nsession=None\ndef call(label,method,params=None,version=None):\n global session\n req={'jsonrpc':'2.0','id':label,'method':method}\n if params is not None: req['params']=params\n if method=='initialize': req['params']={'protocolVersion':version or '2025-06-18','capabilities':{},'clientInfo':{'name':'checkup','version':'1'}}\n headers={'Content-Type':'application/json','Accept':'application/json, text/event-stream'}\n if session: headers['Mcp-Session-Id']=session\n try:\n  r=urllib.request.urlopen(urllib.request.Request(url,data=json.dumps(req).encode(),headers=headers),timeout=3)\n except urllib.error.HTTPError as e: r=e\n body=r.read().decode()\n if r.headers.get('Mcp-Session-Id'): session=r.headers['Mcp-Session-Id']\n print(label,method,r.status,'session='+str(bool(r.headers.get('Mcp-Session-Id'))),body[:1200])\n return json.loads(body) if body else None\ntry:\n call('discover','server/discover')\n call('init','initialize')\n call('initialized','notifications/initialized')\n tools=call('tools','tools/list')\n call('resources','resources/list')\n call('templates','resources/templates/list')\n call('prompts','prompts/list')\n call('missingid','tools/call',{'name':'get_note','arguments':{'id':'n-999999'}})\n call('missingarg','tools/call',{'name':'get_note','arguments':{}})\n call('validnote','tools/call',{'name':'get_note','arguments':{'id':'n-1'}})\n call('validsearch','tools/call',{'name':'search_notes','arguments':{'query':'soil'}})\n call('banana','initialize',version='banana')\nfinally:\n p.terminate()\n try: _,err=p.communicate(timeout=3)\n except subprocess.TimeoutExpired: p.kill(); _,err=p.communicate()\n print('LOGS',err)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
