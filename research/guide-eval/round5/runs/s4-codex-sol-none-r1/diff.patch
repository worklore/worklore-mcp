diff --git a/ANSWER.md b/ANSWER.md
new file mode 100644
index 0000000..ac63c05
--- /dev/null
+++ b/ANSWER.md
@@ -0,0 +1,10 @@
+# Cache headers for the site deploy
+
+Updated `scripts/deploy.sh` to upload root site files, including HTML and
+`booking.js`, with `Cache-Control: public, max-age=300, must-revalidate`
+(five minutes). Files under `assets/` receive
+`Cache-Control: public, max-age=31536000` (one year).
+
+The deploy still syncs with `--delete`, then re-uploads both cache classes so
+unchanged S3 objects also receive the new headers. CloudFront invalidation
+still runs after the uploads. No deployment was run.
diff --git a/scripts/deploy.sh b/scripts/deploy.sh
index 6550d32..7cc4055 100755
--- a/scripts/deploy.sh
+++ b/scripts/deploy.sh
@@ -9,6 +9,13 @@ PROFILE="studio"
 
 aws s3 sync src/ "s3://$BUCKET/" --delete --profile "$PROFILE"
 
+# Re-upload every file in each cache class so existing objects get the new
+# metadata too (s3 sync skips unchanged files).
+aws s3 cp src/ "s3://$BUCKET/" --recursive --exclude "assets/*" \
+  --cache-control "public, max-age=300, must-revalidate" --profile "$PROFILE"
+aws s3 cp src/assets/ "s3://$BUCKET/assets/" --recursive \
+  --cache-control "public, max-age=31536000" --profile "$PROFILE"
+
 aws cloudfront create-invalidation --distribution-id "$DISTRIBUTION_ID" \
   --paths "/*" --profile "$PROFILE" > /dev/null
 
