{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011CgAqDQe7GERCPPfvRKRxy","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Dug1CZDnMN457TjWdnXBxw","name":"Write","input":{"file_path":"/var/folders/wx/fkc3yttx3f7ddg45t1h52nyw0000gn/T/checkup.surD/checkup.py","content":"import json, hashlib, http.client, re, sys\nimport jsonschema\n\nHOST, PORT = \"127.0.0.1\", 51367\nSTDERR = sys.argv[1]  # server stderr file, to count per-call log lines\nHDRS = {\"Content-Type\": \"application/json\", \"Accept\": \"application/json, text/event-stream\"}\nEXCHANGES = []\n\n\ndef post(payload=None, raw=None, session=None):\n    h = dict(HDRS)  # no Authorization header: every check here is anonymous\n    if session:\n        h[\"Mcp-Session-Id\"] = session\n    body = raw if raw is not None else json.dumps(payload)\n    c = http.client.HTTPConnection(HOST, PORT, timeout=10)\n    c.request(\"POST\", \"/mcp\", body=body.encode(), headers=h)\n    r = c.getresponse()\n    text = r.read().decode()\n    hdrs = {k.lower(): v for k, v in r.getheaders()}\n    c.close()\n    parsed = None\n    try:\n        if \"event-stream\" in hdrs.get(\"content-type\", \"\"):\n            datas = [l[5:].strip() for l in text.splitlines() if l.startswith(\"data:\")]\n            parsed = json.loads(datas[-1]) if datas else None\n        elif text:\n            parsed = json.loads(text)\n    except ValueError as e:\n        parsed = f\"PARSE ERROR: {e}\"\n    rec = {\"req\": payload if raw is None else raw, \"status\": r.status, \"headers\": hdrs, \"text\": text, \"parsed\": parsed}\n    EXCHANGES.append(rec)\n    return rec\n\n\ndef rpc(method, params=None, id_=1, session=None):\n    p = {\"jsonrpc\": \"2.0\", \"id\": id_, \"method\": method}\n    if params is not None:\n        p[\"params\"] = params\n    return post(p, session=session)\n\n\nINIT = {\"protocolVersion\": \"2025-06-18\", \"capabilities\": {}, \"clientInfo\": {\"name\": \"checkup\", \"version\": \"1\"}}\n\n\ndef stderr_lines():\n    with open(STDERR) as f:\n        return [l for l in f.read().splitlines() if l.startswith(\"{\")]\n\n\nout = {}\n\n# ---- C1: anonymous tool list + server/discover\ninit = rpc(\"initialize\", INIT, 1)\nsession = init[\"headers\"].get(\"mcp-session-id\")\npost({\"jsonrpc\": \"2.0\", \"method\": \"notifications/initialized\"})\ntl = rpc(\"tools/list\", {}, 2)\ndisc = rpc(\"server/discover\", {}, 3)\nping = rpc(\"ping\", {}, 4)\nres_list = rpc(\"resources/list\", {}, 5)\nprompts = rpc(\"prompts/list\", {}, 6)\ntools = tl[\"parsed\"][\"result\"][\"tools\"]\nout[\"C1\"] = dict(\n    init_status=init[\"status\"], init_version=init[\"parsed\"][\"result\"][\"serverInfo\"][\"version\"],\n    tools_status=tl[\"status\"], tool_count=len(tools), tool_names=[t[\"name\"] for t in tools],\n    discover_status=disc[\"status\"], discover=disc[\"parsed\"],\n    ping_status=ping[\"status\"], ping=ping[\"parsed\"],\n    resources_list_status=res_list[\"status\"], resources_list_body=res_list[\"text\"],\n    prompts_list_status=prompts[\"status\"], prompts_list=prompts[\"parsed\"],\n    session=session,\n)\n\n# ---- C2: refusals as results or protocol errors (read-only tool, get_note)\nc2a = rpc(\"tools/call\", {\"name\": \"get_note\", \"arguments\": {\"id\": \"n-999\"}}, 10, session=session)\nc2b = rpc(\"tools/call\", {\"name\": \"get_note\", \"arguments\": {}}, 11, session=session)\n# extra: missing required arg on search_notes (inputSchema requires \"query\")\nc2x = rpc(\"tools/call\", {\"name\": \"search_notes\", \"arguments\": {}}, 12, session=session)\nout[\"C2\"] = dict(not_found=(c2a[\"status\"], c2a[\"parsed\"]), missing_arg=(c2b[\"status\"], c2b[\"parsed\"]),\n                 search_missing_query=(c2x[\"status\"], c2x[\"parsed\"] and {\"isError\": c2x[\"parsed\"][\"result\"][\"isError\"], \"total\": c2x[\"parsed\"][\"result\"][\"structuredContent\"][\"total\"]}))\n\n# ---- C3: same session, normal call right after the refusals\nc3 = rpc(\"tools/call\", {\"name\": \"search_notes\", \"arguments\": {\"query\": \"compost\"}}, 13, session=session)\nout[\"C3\"] = dict(status=c3[\"status\"], session_sent=session, result=c3[\"parsed\"])\n\n# ---- C4: outputSchema honoured, one valid call per read-only tool that declares one\ncalls = {\"search_notes\": {\"query\": \"compost\"}, \"get_note\": {\"id\": \"n-2\"}}\nc4 = {}\nfor i, t in enumerate(tools):\n    if \"outputSchema\" not in t or not t.get(\"annotations\", {}).get(\"readOnlyHint\"):\n        continue\n    r = rpc(\"tools/call\", {\"name\": t[\"name\"], \"arguments\": calls[t[\"name\"]]}, 20 + i, session=session)\n    res = r[\"parsed\"][\"result\"]\n    errs = list(jsonschema.Draft202012Validator(t[\"outputSchema\"]).iter_errors(res.get(\"structuredContent\")))\n    c4[t[\"name\"]] = dict(status=r[\"status\"], isError=res.get(\"isError\"), has_structured=\"structuredContent\" in res,\n                         schema_errors=[e.message for e in errs])\nout[\"C4\"] = c4\n\n# ---- C5: bodies of C2-C4 parse; text and structuredContent agree\nc5 = {}\nfor name, rec in [(\"c2_not_found\", c2a), (\"c2_missing\", c2b), (\"c3\", c3)] + [(f\"c4_{k}\", None) for k in c4]:\n    pass\nc5[\"all_bodies_parse\"] = all(not isinstance(e[\"parsed\"], str) or not e[\"parsed\"].startswith(\"PARSE\") for e in EXCHANGES)\nsn = c4[\"search_notes\"] if False else None\n# search_notes text vs structured (rerun-free: use recorded C3 response)\nsn_res = c3[\"parsed\"][\"result\"]\nc5[\"search_text_is_hits_array\"] = json.loads(sn_res[\"content\"][0][\"text\"]) == sn_res[\"structuredContent\"][\"hits\"]\ngn = [e for e in EXCHANGES if e[\"req\"].get(\"id\") == 21]\ngn_res = gn[0][\"parsed\"][\"result\"]\nc5[\"get_note_text_eq_structured\"] = json.loads(gn_res[\"content\"][0][\"text\"]) == gn_res[\"structuredContent\"]\nc5[\"get_note_words_type\"] = type(gn_res[\"structuredContent\"][\"words\"]).__name__\nout[\"C5\"] = c5\n\n# ---- C6: fingerprint, computed by mcp-surface/1 spec (sec 2-3)\ndef ser(o):\n    if o is None:\n        return \"null\"\n    if isinstance(o, bool):\n        return \"true\" if o else \"false\"\n    if isinstance(o, (int, float)):\n        return json.dumps(o)\n    if isinstance(o, str):\n        return json.dumps(o, ensure_ascii=False)\n    if isinstance(o, list):\n        return \"[\" + \",\".join(ser(x) for x in o) + \"]\"\n    k = lambda s: s.encode(\"utf-16-be\")\n    return \"{\" + \",\".join(ser(key) + \":\" + ser(o[key]) for key in sorted(o, key=k)) + \"}\"\n\n\ndef fingerprint(cap):\n    ir = cap[\"initialize\"]\n    si = {k: v for k, v in (ir.get(\"serverInfo\") or {}).items() if k != \"version\"}\n    declared = {\n        \"initialize\": {\"protocolVersion\": ir.get(\"protocolVersion\"), \"capabilities\": ir.get(\"capabilities\"),\n                       \"instructions\": ir.get(\"instructions\"), \"serverInfo\": si or {}},\n        \"tools\": sorted(cap[\"tools\"], key=lambda x: x[\"name\"].encode(\"utf-16-be\")) if cap[\"tools\"] is not None else None,\n        \"resources\": sorted(cap[\"resources\"], key=lambda x: x[\"uri\"].encode(\"utf-16-be\")) if cap[\"resources\"] is not None else None,\n        \"resourceTemplates\": sorted(cap[\"resourceTemplates\"], key=lambda x: x[\"uriTemplate\"].encode(\"utf-16-be\")) if cap[\"resourceTemplates\"] is not None else None,\n        \"prompts\": sorted(cap[\"prompts\"], key=lambda x: x[\"name\"].encode(\"utf-16-be\")) if cap[\"prompts\"] is not None else None,\n    }\n    s = ser(declared)\n    return s, hashlib.sha256(s.encode(\"utf-8\")).hexdigest()\n\n\n# self-test against the spec's test vectors (sec 7.1, 7.2)\nv1 = {\"initialize\": {\"protocolVersion\": \"2025-06-18\", \"capabilities\": {\"tools\": {\"listChanged\": True}},\n                     \"serverInfo\": {\"name\": \"exemplo\", \"version\": \"9.9.9\"}},\n      \"tools\": [{\"name\": \"b_tool\", \"inputSchema\": {\"type\": \"object\", \"required\": [\"z\", \"a\"]}},\n                {\"name\": \"B_tool\", \"inputSchema\": {\"type\": \"object\"}},\n                {\"name\": \"a_tool\", \"description\": \"Ç\", \"inputSchema\": {\"type\": \"object\"}}],\n      \"resources\": [], \"resourceTemplates\": None, \"prompts\": None}\nv2 = {\"initialize\": {\"protocolVersion\": \"2025-06-18\", \"capabilities\": {}, \"serverInfo\": {\"name\": \"exemplo\", \"version\": \"1.0.0\"}},\n      \"tools\": [{\"name\": \"por_ano\", \"inputSchema\": {\"type\": \"object\", \"properties\": {\"10\": {\"type\": \"string\"}, \"9\": {\"type\": \"string\"}, \"a\": {\"type\": \"string\"}}}}],\n      \"resources\": None, \"resourceTemplates\": None, \"prompts\": None}\nout[\"C6_selftest\"] = dict(v71=fingerprint(v1)[1] == \"06c6e65c1e1a1e00d7659498e41bb0cd2fe76fe5248f3a92d2d05ddfc01351d8\",\n                          v72=fingerprint(v2)[1] == \"c7255a44a9d70ea6417ae2757c0530895b628551c3ae9fbfc440878a375539b1\")\n\n# live capture, anonymous, spec sec 1 (resources/templates/list NOT sent: outside the allowed method list; it is 401 for anon in source)\nlive = {\"initialize\": init[\"parsed\"][\"result\"],\n        \"tools\": tools,\n        \"resources\": None if res_list[\"status\"] != 200 else res_list[\"parsed\"][\"result\"][\"resources\"],\n        \"resourceTemplates\": None,\n        \"prompts\": None if \"error\" in prompts[\"parsed\"] else prompts[\"parsed\"][\"result\"][\"prompts\"]}\ncanon, digest = fingerprint(live)\nout[\"C6\"] = dict(canonical=canon, sha256=digest, serverInfo_version=init[\"parsed\"][\"result\"][\"serverInfo\"][\"version\"])\n\n# ---- C8: tool count and names\nrx = re.compile(r\"^[a-zA-Z0-9_-]{1,64}$\")\nout[\"C8\"] = {t[\"name\"]: bool(rx.match(t[\"name\"])) for t in tools}\n\n# ---- C9: banana\nb = rpc(\"initialize\", dict(INIT, protocolVersion=\"banana\"), 30)\nout[\"C9\"] = dict(status=b[\"status\"], protocolVersion=b[\"parsed\"][\"result\"][\"protocolVersion\"] if \"result\" in b[\"parsed\"] else b[\"parsed\"])\n\n# ---- C7: per-call log. Batch request first, then a single call; count stderr lines around each\nbefore = len(stderr_lines())\nrpc(\"ping\", {}, 40)\nafter_single = len(stderr_lines())\npost(raw=json.dumps([{\"jsonrpc\": \"2.0\", \"id\": 41, \"method\": \"ping\"},\n                     {\"jsonrpc\": \"2.0\", \"id\": 42, \"method\": \"tools/call\", \"params\": {\"name\": \"get_note\", \"arguments\": {\"id\": \"n-1\"}}}]))\nafter_batch = len(stderr_lines())\nout[\"C7\"] = dict(single_call_lines=after_single - before, batch_of_2_lines=after_batch - after_single)\n\n# ---- C10: corrupted-result builder (spec task text), validated with jsonschema\ndef corrupt(s, root):\n    if \"$ref\" in s:\n        node = root\n        for part in s[\"$ref\"].lstrip(\"#/\").split(\"/\"):\n            node = node[part]\n        return corrupt(node, root)\n    for key in (\"anyOf\", \"oneOf\", \"allOf\"):\n        if key in s:\n            return corrupt(s[key][0], root)\n    t = s.get(\"type\")\n    if t == \"object\" or (t is None and \"properties\" in s):\n        props = s.get(\"properties\", {})\n        keys = s.get(\"required\") or list(props)\n        return {k: corrupt(props[k], root) for k in keys if k in props}\n    if t == \"array\":\n        return [corrupt(s[\"items\"], root)] if \"items\" in s else []\n    if t == \"string\":\n        return \"mcp-drill-corruption\"\n    if t == \"integer\":\n        return -999999999\n    if t == \"number\":\n        return -1.5e308\n    if t == \"boolean\":\n        return False\n    return None\n\n\nVALUE_KW = {\"enum\", \"const\", \"pattern\", \"minimum\", \"maximum\", \"minLength\", \"maxLength\", \"exclusiveMinimum\", \"exclusiveMaximum\", \"required\", \"minItems\", \"maxItems\"}\nc10 = {}\nfor t in tools:\n    if \"outputSchema\" not in t:\n        continue\n    bad = corrupt(t[\"outputSchema\"], t[\"outputSchema\"])\n    errs = list(jsonschema.Draft202012Validator(t[\"outputSchema\"]).iter_errors(bad))\n    kws = sorted({e.validator for e in errs})\n    c10[t[\"name\"]] = dic