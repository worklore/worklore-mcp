s:\n    if \"outputSchema\" not in t:\n        continue\n    bad = corrupt(t[\"outputSchema\"], t[\"outputSchema\"])\n    errs = list(jsonschema.Draft202012Validator(t[\"outputSchema\"]).iter_errors(bad))\n    kws = sorted({e.validator for e in errs})\n    c10[t[\"name\"]] = dict(corrupted=bad, rejected=bool(errs), keywords=kws, accepted=not errs,\n                          value_or_required=bool(errs) and all(e.validator in VALUE_KW for e in errs))\nout[\"C10\"] = c10\n\nwith open(sys.argv[2], \"w\") as f:\n    json.dump(out, f, indent=1, ensure_ascii=False, default=str)\nwith open(sys.argv[3], \"w\") as f:\n    for e in EXCHANGES:\n        f.write(json.dumps({k: e[k] for k in (\"req\", \"status\", \"text\")}, ensure_ascii=False) + \"\\n\")\nprint(\"ok\")\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01Dug1CZDnMN457TjWdnXBxw","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
