ontent-Type: application/json\r\nContent-Length: 106\r\n\r\n{\"jsonrpc\": \"2.0\", \"id\": 17, \"error\": {\"code\": -32601, \"message\": \"method not found: tools/list_changed\"}}\n\n=== log tail\n{\"t\": \"2026-10-18T23:25:26\", \"method\": \"tools/call\", \"tool\": \"add_note\", \"ok\": true, \"ms\": 0.0, \"who\": \"dev\"}\n{\"t\": \"2026-10-18T23:25:26\", \"method\": \"resources/list\", \"tool\": null, \"ok\": true, \"ms\": 0.0, \"who\": \"dev\"}\n{\"t\": \"2026-10-18T23:25:26\", \"method\": \"tools/call\", \"tool\": \"get_note\", \"ok\": false, \"ms\": 0.0, \"who\": \"anon\"}\n{\"t\": \"2026-10-18T23:25:26\", \"method\": \"tools/call\", \"tool\": null, \"ok\": false, \"ms\": 0.0, \"who\": \"anon\"}\n{\"t\": \"2026-10-18T23:25:26\", \"method\": \"tools/list\", \"tool\": null, \"ok\": true, \"ms\": 0.0, \"who\": \"anon\"}\n{\"t\": \"2026-10-18T23:25:26\", \"method\": \"tools/list\", \"tool\": null, \"ok\": true, \"ms\": 0.0, \"who\": \"anon\"}\n{\"t\": \"2026-10-18T23:25:26\", \"method\": \"tools/call\", \"tool\": \"search_notes\", \"ok\": true, \"ms\": 0.0, \"who\": \"anon\"}\n{\"t\": \"2026-10-18T23:25:26\", \"method\": \"tools/list_changed\", \"tool\": null, \"ok\": false, \"ms\": 0.0, \"who\": \"anon\"}\nalive: 200","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01VC5qsUyq3YVCtzandUSjxc","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
