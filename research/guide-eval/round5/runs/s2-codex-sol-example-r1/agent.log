able recording appears in PostHog Session Replay. This checkout has no iOS or Android project, so it cannot perform that device check here.\n\nReference: [PostHog Flutter session replay installation](https://posthog.com/docs/session-replay/installation/flutter).\n/// The redesigned shell (default since 2.3.0).\nclass NewApp extends StatelessWidget {\n  const NewApp({super.key});\n\n  @override\n  Widget build(BuildContext context) {\n    // Session replay captures frames through this wrapper around the app.\n    return PostHogWidget(\n      child: MaterialApp.router(\n        title: 'Loanly',\n        theme: ThemeData(colorSchemeSeed: Colors.indigo, useMaterial3: true),\n        routerConfig: _router,\n      ),\n    );\n  }\n}\n","exit_code":0,"status":"completed"}}
