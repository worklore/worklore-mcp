{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc 'bash -n scripts/deploy.sh && git diff --check && git diff -- scripts/deploy.sh && git status --short'","aggregated_output":"diff --git a/scripts/deploy.sh b/scripts/deploy.sh\nindex 6550d32..3ecf085 100755\n--- a/scripts/deploy.sh\n+++ b/scripts/deploy.sh\n@@ -9,6 +9,30 @@ PROFILE=\"studio\"\n \n aws s3 sync src/ \"s3://$BUCKET/\" --delete --profile \"$PROFILE\"\n \n+# Upload every file, including unchanged ones, so existing objects get the headers.\n+# Explicit content types avoid losing the browser-readable type during metadata updates.\n+while IFS= read -r -d '' file; do\n+  key=\"${file#src/}\"\n+  case \"$key\" in\n+    *.html) content_type=\"text/html\" ;;\n+    *.js) content_type=\"application/javascript\" ;;\n+    *.css) content_type=\"text/css\" ;;\n+    assets/*.png) content_type=\"image/png\" ;;\n+    assets/*.svg) content_type=\"image/svg+xml\" ;;\n+    *) echo \"Unknown content type: $key\" >&2; exit 1 ;;\n+  esac\n+\n+  if [[ \"$key\" == assets/* ]]; then\n+    cache_control=\"public, max-age=31536000\"\n+  else\n+    cache_control=\"public, max-age=300\"\n+  fi\n+\n+  aws s3 cp \"$file\" \"s3://$BUCKET/$key\" \\\n+    --content-type \"$content_type\" --cache-control \"$cache_control\" \\\n+    --profile \"$PROFILE\" --only-show-errors\n+done < <(find src -type f -print0)\n+\n aws cloudfront create-invalidation --distribution-id \"$DISTRIBUTION_ID\" \\\n   --paths \"/*\" --profile \"$PROFILE\" > /dev/null\n \n M scripts/deploy.sh\n?? ANSWER.md\n","exit_code":0,"status":"completed"}}
