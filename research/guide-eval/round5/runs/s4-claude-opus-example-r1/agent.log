x","+RULES=(","+  \"html:text/html; charset=utf-8:SHORT:\"","+  \"js:application/javascript; charset=utf-8:SHORT:\"","+  \"css:text/css; charset=utf-8:SHORT:\"","+  \"png:image/png:LONG:assets/\"","+  \"svg:image/svg+xml:LONG:assets/\"","+)","+","+# Refuse to deploy files that no rule covers: they would go up with no","+# Cache-Control (or a guessed type), which is the bug this script fixes.","+known=()","+for rule in \"${RULES[@]}\"; do","+  IFS=: read -r ext _ _ prefix <<<\"$rule\"","+  known+=(-not -path \"src/${prefix}*.${ext}\")","+done","+unknown=$(find src -type f \"${known[@]}\")","+if [[ -n \"$unknown\" ]]; then","+  echo \"deploy: no content-type/cache rule for:\" >&2","+  echo \"$unknown\" >&2","+  exit 1","+fi","+","+# cp (not sync) so every object is re-uploaded with its headers each deploy,","+# including files whose bytes did not change. The site is small.","+for rule in \"${RULES[@]}\"; do","+  IFS=: read -r ext ct policy prefix <<<\"$rule\"","+  aws s3 cp src/ \"s3://$BUCKET/\" --recursive \\","+    --exclude \"*\" --include \"${prefix}*.${ext}\" \\","+    --content-type \"$ct\" --cache-control \"${!policy}\" \\","+    --only-show-errors --profile \"$PROFILE\"","+done","+","+# Remove objects that no longer exist in src/. --size-only: everything was","+# just uploaded above, so this pass should only delete, never re-upload","+# (a re-upload here would drop the headers).","+aws s3 sync src/ \"s3://$BUCKET/\" --delete --size-only \\","+  --only-show-errors --profile \"$PROFILE\"","+"," aws cloudfront create-invalidation --distribution-id \"$DISTRIBUTION_ID\" \\","   --paths \"/*\" --profile \"$PROFILE\" > /dev/null"," "," echo \"deployed\"","+echo \"check: curl -sI https://<site>/booking.js | grep -iE 'content-type|cache-control'\""]}],"originalFile":"#!/usr/bin/env bash\n# Upload src/ to the bucket and invalidate CloudFront.\nset -euo pipefail\ncd \"$(dirname \"$0\")/..\"\n\nBUCKET=\"ruta-ceramica-site-7f3a\"\nDISTRIBUTION_ID=\"E2QX9ZK1DEMO01\"\nPROFILE=\"studio\"\n\naws s3 sync src/ \"s3://$BUCKET/\" --delete --profile \"$PROFILE\"\n\naws cloudfront create-invalidation --distribution-id \"$DISTRIBUTION_ID\" \\\n  --paths \"/*\" --profile \"$PROFILE\" > /dev/null\n\necho \"deployed\"\n","userModified":false},"tool_result_meta":[{"id":"toolu_015bFiMognpsWBT8HA7gyQob","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
