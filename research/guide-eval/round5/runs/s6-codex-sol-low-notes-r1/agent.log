id\": {\"type\": \"string\", \"pattern\": \"^n-[0-9]+$\"}},\n43:            \"required\": [\"id\"],\n44:        },\n45:        \"outputSchema\": {\n46:            \"type\": \"object\",\n47:            \"required\": [\"id\", \"title\", \"body\", \"words\"],\n48:            \"properties\": {\n49:                \"id\": {\"type\": \"string\", \"pattern\": \"^n-[0-9]+$\"},\n50:                \"title\": {\"type\": \"string\", \"minLength\": 1},\n51:                \"body\": {\"type\": \"string\"},\n52:                \"words\": {\"type\": \"integer\", \"minimum\": 0},\n53:                \"tags\": {\"type\": \"array\", \"items\": {\"type\": \"string\", \"minLength\": 1}},\n54:            },\n55:        },\n56:        \"annotations\": {\"readOnlyHint\": True},\n57:    },\n58:    {\n59:        \"name\": \"add_note\",\n60:        \"description\": \"Create a note. Needs a signed-in session.\",\n61:        \"inputSchema\": {\n62:            \"type\": \"object\",\n63:            \"properties\": {\"title\": {\"type\": \"string\", \"minLength\": 1}, \"body\": {\"type\": \"string\"}},\n64:            \"required\": [\"title\", \"body\"],\n65:        },\n66:        \"outputSchema\": {\n67:            \"type\": \"object\",\n68:            \"required\": [\"id\"],\n69:            \"properties\": {\"id\": {\"type\": \"string\", \"pattern\": \"^n-[0-9]+$\"}},\n70:        },\n71:        \"annotations\": {\"readOnlyHint\": False, \"destructiveHint\": False},\n72:    },\n73:]\n74:\n75:RESOURCES = [\n76:    {\"uri\": \"notes://guide\", \"name\": \"guide\", \"mimeType\": \"text/markdown\", \"description\": \"How to use this server\"},\n77:]\n78:\n79:\n80:def log(method, tool=None, ok=True, ms=0, who=\"anon\"):\n81:    rec = {\"t\": time.strftime(\"%Y-%m-%dT%H:%M:%S\"), \"method\": method, \"tool\": tool, \"ok\": ok, \"ms\": round(ms, 1), \"who\": who}\n82:    sys.stderr.write(json.dumps(rec) + \"\\n\")\n83:    sys.stderr.flush()\n84:\n85:\n86:def rpc_result(id_, result):\n87:    return 200, {\"jsonrpc\": \"2.0\", \"id\": id_, \"result\": result}\n88:\n89:\n90:def rpc_error(id_, code, message):\n91:    return 200, {\"jsonrpc\": \"2.0\", \"id\": id_, \"error\": {\"code\": code, \"message\": message}}\n92:\n93:\n94:def tool_result(text, structured=None, is_error=False):\n95:    r = {\"content\": [{\"type\": \"text\", \"text\": text}], \"isError\": is_error}\n96:    if structured is not None:\n97:        r[\"structuredContent\"] = structured\n98:    return r\n99:\n100:\n101:def call_tool(name, args, who):\n102:    if name == \"search_notes\":\n103:        q = str(args.get(\"query\", \"\")).lower()\n104:        limit = int(args.get(\"limit\", 10))\n105:        hits = []\n106:        for n in NOTES.values():\n107:            text = (n[\"title\"] + \" \" + n[\"body\"]).lower()\n108:            if q in text:\n109:                i = text.find(q)\n110:                hits.append({\"id\": n[\"id\"], \"title\": n[\"title\"], \"snippet\": n[\"body\"][max(0, i - 30): i + 50]})\n111:        hits = hits[:limit]\n112:        return tool_result(json.dumps(hits), {\"hits\": hits, \"total\": len(hits)})\n113:    if name == \"get_note\":\n114:        nid = args.get(\"id\")\n115:        if nid is None:\n116:            raise ValueError(\"missing required argument: id\")\n117:        n = NOTES.get(nid)\n118:        if n is None:\n119:            raise ValueError(f\"note not found: {nid}\")\n120:        out = {\"id\": n[\"id\"], \"title\": n[\"title\"], \"body\": n[\"body\"], \"words\": len(n[\"body\"].split()), \"tags\": n.get(\"tags\", [])}\n121:        return tool_result(json.dumps(out), out)\n122:    if name == \"add_note\":\n123:        if who == \"anon\":\n124:            return None  # caller turns this into a 401\n125:        nid = f\"n-{max(int(k[2:]) for k in NOTES) + 1}\"\n126:        NOTES[nid] = {\"id\": nid, \"title\": args[\"title\"], \"body\": args[\"body\"], \"tags\": []}\n127:        return tool_result(json.dumps({\"id\": nid}), {\"id\": nid})\n128:    return None\n129:\n130:\n131:def handle(req, who):\n132:    method = req.get(\"method\")\n133:    id_ = req.get(\"id\")\n134:    params = req.get(\"params\") or {}\n135:    if method == \"initialize\":\n136:        return rpc_result(id_, {\n137:            \"protocolVersion\": PROTOCOL,\n138:            \"capabilities\": {\"tools\": {\"listChanged\": False}, \"resources\": {\"subscribe\": False, \"listChanged\": False}},\n139:            \"serverInfo\": {\"name\": \"notes-mcp\", \"version\": \"0.3.1\"},\n140:            \"instructions\": \"Search and read notes. add_note needs a signed-in session.\",\n141:        })\n142:    if method == \"notifications/initialized\":\n143:        return 202, None\n144:    if method == \"ping\":\n145:        return rpc_result(id_, {})\n146:    if method == \"tools/list\":\n147:        return rpc_result(id_, {\"tools\": TOOLS})\n148:    if method in (\"resources/list\", \"resources/read\", \"resources/templates/list\"):\n149:        if who == \"anon\":\n150:            return 401, {\"error\": \"unauthorized\"}\n151:        if method == \"resources/list\":\n152:            return rpc_result(id_, {\"resources\": RESOURCES})\n153:        if method == \"resources/templates/list\":\n154:            return rpc_result(id_, {\"resourceTemplates\": []})\n155:        return rpc_result(id_, {\"contents\": [{\"uri\": \"notes://guide\", \"mimeType\": \"text/markdown\", \"text\": \"# notes-mcp\\nsearch_notes, get_note, add_note.\"}]})\n156:    if method == \"tools/call\":\n157:        name = params.get(\"name\")\n158:        args = params.get(\"arguments\") or {}\n159:        if not any(t[\"name\"] == name for t in TOOLS):\n160:            return rpc_error(id_, -32601, f\"unknown tool: {name}\")\n161:        try:\n162:            res = call_tool(name, args, who)\n163:        except ValueError as e:\n164:            return rpc_error(id_, -32602, str(e))\n165:        if res is None:\n166:            return 401, {\"error\": \"sign in required\"}\n167:        return rpc_result(id_, res)\n168:    return rpc_error(id_, -32601, f\"method not found: {method}\")\n169:\n170:\n171:class Handler(BaseHTTPRequestHandler):\n172:    server_version = \"notes-mcp/0.3.1\"\n173:\n174:    def _send(self, status, body, session=None):\n175:        data = b\"\" if body is None else json.dumps(body).encode()\n176:        self.send_response(status)\n177:        if data:\n178:            self.send_header(\"Content-Type\", \"application/json\")\n179:        self.send_header(\"Content-Length\", str(len(data)))\n180:        if session:\n181:            self.send_header(\"Mcp-Session-Id\", session)\n182:        self.end_headers()\n183:        if data:\n184:            self.wfile.write(data)\n185:\n186:    def do_GET(self):\n187:        self._send(405, {\"error\": \"use POST\"})\n188:\n189:    def do_DELETE(self):\n190:        self._send(204, None)\n191:\n192:    def do_POST(self):\n193:        if self.path.rstrip(\"/\") != \"/mcp\":\n194:            return self._send(404, {\"error\": \"not found\"})\n195:        n = int(self.headers.get(\"Content-Length\") or 0)\n196:        raw = self.rfile.read(n)\n197:        try:\n198:            req = json.loads(raw or b\"{}\")\n199:        except json.JSONDecodeError:\n200:            return self._send(400, {\"jsonrpc\": \"2.0\", \"id\": None, \"error\": {\"code\": -32700, \"message\": \"parse error\"}})\n201:        auth = self.headers.get(\"Authorization\", \"\")\n202:        who = \"dev\" if auth == f\"Bearer {TOKEN}\" else \"anon\"\n203:        session = self.headers.get(\"Mcp-Session-Id\")\n204:        t0 = time.time()\n205:        if isinstance(req, list):\n206:            out = []\n207:            for r in req:\n208:                _, b = handle(r, who)\n209:                if b is not None:\n210:                    out.append(b)\n211:            return self._send(200, out, session)\n212:        status, body = handle(req, who)\n213:        if req.get(\"method\") == \"initialize\" and not session:\n214:            session = uuid.uuid4().hex\n215:        ok = status < 400 and not (isinstance(body, dict) and \"error\" in body)\n216:        log(req.get(\"method\"), (req.get(\"params\") or {}).get(\"name\"), ok, (time.time() - t0) * 1000, who)\n217:        self._send(status, body, session)\n218:\n219:    def log_message(self, *a):\n220:        pass\n221:\n222:\n223:if __name__ == \"__main__\":\n224:    srv = ThreadingHTTPServer((\"127.0.0.1\", PORT), Handler)\n225:    sys.stderr.write(f\"notes-mcp listening on http://127.0.0.1:{PORT}/mcp\\n\")\n226:    sys.stderr.flush()\n227:    try:\n228:        srv.serve_forever()\n229:    except KeyboardInterrupt:\n230:        pass\n","exit_code":0,"status":"completed"}}
