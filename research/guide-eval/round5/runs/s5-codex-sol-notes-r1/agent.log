{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport re\nrules = []\nfor line in Path('site/robots.txt').read_text().splitlines():\n    if ':' not in line:\n        continue\n    directive, path = (part.strip() for part in line.split(':', 1))\n    if directive.lower() in ('allow', 'disallow'):\n        rules.append((directive.lower(), path))\n\ndef allowed(url):\n    matches = []\n    for directive, pattern in rules:\n        regex = re.escape(pattern).replace(r'\\\\*', '.*')\n        if re.match(regex, url):\n            matches.append((len(pattern.replace('*', '')), directive == 'allow', pattern))\n    return max(matches, default=(0, True, ''))[1]\n\ncases = {\n    '/v1/notes?limit=50': True,\n    '/v1/notes/drip-line-pressure': True,\n    '/v1/notes/drip-line-pressure/reactions': False,\n    '/v1/me': False,\n    '/v1/me/drafts': False,\n    '/v1/auth/token': False,\n    '/admin/': False,\n}\nfor path, expected in cases.items():\n    actual = allowed(path)\n    print(f'{path}: {\\\"allowed\\\" if actual else \\\"blocked\\\"}')\n    assert actual == expected, path\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
