+def description_step(step):
+    """Render a step in Intervals' workout text grammar."""
+    line = f'- {step["label"]} {step["minutes"]}m'
+    if "hr_pct" in step:
+        lo, hi = step["hr_pct"]
+        line += f" {lo}-{hi}% LTHR"
+    return line
+
+
+def build_description(plan):
+    blocks = []
+    for block in plan["steps"]:
+        if "repeat" in block:
+            lines = [f'{block["repeat"]}x']
+            lines.extend(description_step(step) for step in block["steps"])
+            blocks.append("\n".join(lines))
+        else:
+            blocks.append(description_step(block))
+    return "\n\n".join(blocks)
 
 
