r)\nlib/main.dart:3:import 'analytics.dart';\nlib/main.dart:12:  runApp(useNewUi ? const NewApp() : const LegacyApp());\nlib/legacy_app.dart:2:import 'package:posthog_flutter/posthog_flutter.dart';\nlib/legacy_app.dart:8:class LegacyApp extends StatelessWidget {\nlib/legacy_app.dart:9:  const LegacyApp({super.key});\nlib/legacy_app.dart:13:    return PostHogWidget(\nlib/legacy_app.dart:17:        navigatorObservers: [PosthogObserver()],\nlib/screens/application_screen.dart:3:import '../analytics.dart';\nlib/screens/calculator_screen.dart:3:import '../analytics.dart';\n","exit_code":0,"status":"completed"}}
