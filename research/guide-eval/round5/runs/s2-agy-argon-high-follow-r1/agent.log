erial.dart';\r\n+\r\n+import 'analytics.dart';\r\n+import 'legacy_app.dart';\r\n+import 'new_app.dart';\r\n+\r\n+const bool useNewUi = bool.fromEnvironment('NEW_UI', defaultValue: true);\r\n+\r\n+Future\u003cvoid\u003e main() async {\r\n+  WidgetsFlutterBinding.ensureInitialized();\r\n+  await Analytics.init();\r\n+  runApp(useNewUi ? const NewApp() : const LegacyApp());\r\n+}\r\ndiff --git a/lib/new_app.dart b/lib/new_app.dart\r\nnew file mode 100644\r\nindex 0000000..92e4ff9\r\n--- /dev/null\r\n+++ b/lib/new_app.dart\r\n@@ -0,0 +1,33 @@\r\n+import 'package:flutter/material.dart';\r\n+import 'package:go_router/go_router.dart';\r\n+import 'package:posthog_flutter/posthog_flutter.dart';\r\n+\r\n+import 'screens/calculator_screen.dart';\r\n+import 'screens/application_screen.dart';\r\n+import 'screens/offers_screen.dart';\r\n+\r\n+final _router = GoRouter(\r\n+  observers: [PosthogObserver()],\r\n+  routes: [\r\n+    GoRoute(path: '/', builder: (_, __) =\u003e const CalculatorScreen()),\r\n+    GoRoute(path: '/apply', builder: (_, __) =\u003e const ApplicationScreen()),\r\n+    GoRoute(path: '/offers', builder: (_, __) =\u003e const OffersScreen()),\r\n+  ],\r\n+);\r\n+\r\n+/// The redesigned shell (default since 2.3.0).\r\n+class NewApp extends StatelessWidget {\r\n+  const NewApp({super.key});\r\n+\r\n+  @override\r\n+  Widget build(BuildContext context) {\r\n+    return MaterialApp.router(\r\n+      title: 'Loanly',\r\n+      theme: ThemeData(\r\n+        colorSchemeSeed: Colors.indigo,\r\n+        useMaterial3: true,\r\n+      ),\r\n+      routerConfig: _router,\r\n+    );\r\n+  }\r\n+}\r\ndiff --git a/lib/screens/application_screen.dart b/lib/screens/application_screen.dart\r\nnew file mode 100644\r\nindex 0000000..3d06d36\r\n--- /dev/null\r\n+++ b/lib/screens/application_screen.dart\r\n@@ -0,0 +1,48 @@\r\n+import 'package:flutter/material.dart';\r\n+\r\n+import '../analytics.dart';\r\n+\r\n+class ApplicationScreen extends StatefulWidget {\r\n+  const ApplicationScreen({super.key});\r\n+\r\n+  @override\r\n+  State\u003cApplicationScreen\u003e createState() =\u003e _ApplicationScreenState();\r\n+}\r\r\n+\r\n+class _ApplicationScreenState extends State\u003cApplicationScreen\u003e {\r\n+  final _email = TextEditingController();\r\n+  bool _emailInputFired = false;\r\n+\r\n+  @override\r\n+  Widget build(BuildContext context) {\r\n+    return Scaffold(\r\n+      appBar: AppBar(title: const Text('Apply')),\r\n+      body: Padding(\r\n+        padding: const EdgeInsets.all(16),\r\n+        child: Column(\r\n+          children: [\r\n+            TextField(\r\n+              controller: _email,\r\n+              decoration: const InputDecoration(labelText: 'Email'),\r\n+              onChanged: (_) {\r\n+                if (!_emailInputFired) {\r\n+                  _emailInputFired = true;\r\n+                  Analytics.track('email_input');\r\n+                }\r\n+              },\r\n+            ),\r\n+            const SizedBox(height: 16),\r\n+            FilledButton(\r\n+              onPressed: () {\r\n+                Analytics.track('application_submitted');\r\n+                ScaffoldMessenger.of(context).showSnackBar(\r\n+                    const SnackBar(content: Text('Thanks, we will be in touch.')));\r\n+              },\r\n+              child: const Text('Submit'),\r\n+            ),\r\n+          ],\r\n+        ),\r\n+      ),\r\n+    );\r\n+  }\r\n+}\r\ndiff --git a/lib/screens/calculator_screen.dart b/lib/screens/calculator_screen.dart\r\nnew file mode 100644\r\nindex 0000000..8db1dad\r\n--- /dev/null\r\n+++ b/lib/screens/calculator_screen.dart\r\n@@ -0,0 +1,61 @@\r\n+import 'package:flutter/material.dart';\r\n+\r\n+import '../analytics.dart';\r\n+\r\n+class CalculatorScreen extends StatefulWidget {\r\n+  const CalculatorScreen({super.key});\r\n+\r\n+  @override\r\n+  State\u003cCalculatorScreen\u003e createState() =\u003e _CalculatorScreenState();\r\n+}\r\n+\r\n+class _CalculatorScreenState extends State\u003cCalculatorScreen\u003e {\r\n+  double _amount = 5000;\r\n+  int _months = 12;\r\n+\r\n+  @override\r\n+  Widget build(BuildContext context) {\r\n+    final monthly = _amount * (1 + 0.012 * _months) / _months;\r\n+    return Scaffold(\r\n+      appBar: AppBar(title: const Text('Loan calculator')),\r\n+      body: Padding(\r\n+        padding: const EdgeInsets.all(16),\r\n+        child: Column(\r\n+          crossAxisAlignment: CrossAxisAlignment.stretch,\r\n+          children: [\r\n+            Text('Amount: ${_amount.round()}'),\r\n+            Slider(\r\n+              min: 1000,\r\n+              max: 50000,\r\n+              value: _amount,\r\n+              onChanged: (v) =\u003e setState(() =\u003e _amount = v),\r\n+              onChangeEnd: (v) =\u003e\r\n+                  Analytics.track('loan_amount_changed', {'amount': v.round()}),\r\n+            ),\r\n+            Text('Months: $_months'),\r\n+            Slider(\r\n+              min: 3,\r\n+              max: 60,\r\n+              divisions: 57,\r\n+              value: _months.toDouble(),\r\n+              onChanged: (v) =\u003e setState(() =\u003e _months = v.round()),\r\n+              onChangeEnd: (v) =\u003e\r\n+                  Analytics.track('loan_term_changed', {'months': v.round()}),\r\n+            ),\r\n+            const SizedBox(height: 24),\r\n+            Text('Monthly: ${monthly.toStringAsFixed(2)}',\r\n+                style: Theme.of(context).textTheme.headlineSmall),\r\n+            const Spacer(),\r\n+            FilledButton(\r\n+              onPressed: () {\r\n+                Analytics.track('apply_tapped');\r\n+                Navigator.of(context).pushNamed('/apply');\r\n+              },\r\n+              child: const Text('Apply'),\r\n+            ),\r\n+          ],\r\n+        ),\r\n+      ),\r\n+    );\r\n+  }\r\n+}\r\ndiff --git a/lib/screens/offers_screen.dart b/lib/screens/offers_screen.dart\r\nnew file mode 100644\r\nindex 0000000..271cd66\r\n--- /dev/null