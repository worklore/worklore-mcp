exit $rc), see $OUT\"","+  exit $rc"," fi"," "," \"$NOTIFY\" \"nightly review done: $(head -c 300 \"$OUT\")\""]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"tool_result_meta":[{"id":"toolu_017W2kuw9L2egL9hxgb8crw9","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
