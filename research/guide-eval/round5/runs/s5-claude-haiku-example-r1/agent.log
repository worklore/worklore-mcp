ass=\"notfound\"><h1>NOT FOUND</h1><p>No note lives at this address.</p><p><a href=\"/\">Back to all notes</a></p></section>`;\n  }\n  function esc(s) { return String(s).replace(/[&<>\"]/g, c => ({\"&\":\"&amp;\",\"<\":\"&lt;\",\">\":\"&gt;\",'\"':\"&quot;\"}[c])); }\n})();\n=== index ===\n<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<title>Field notes</title>\n<meta name=\"robots\" content=\"index,follow\">\n<link rel=\"stylesheet\" href=\"/styles.css\">\n</head>\n<body>\n<header><a href=\"/\">Field notes</a></header>\n<main id=\"app\"><p class=\"loading\">Loading…</p></main>\n<script src=\"/app.js\"></script>\n</body>\n</html>\n=== sitemap ===\n<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n  <url><loc>https://fieldnotes.example/</loc></url>\n  <url><loc>https://fieldnotes.example/n/soil-ph-kit-review</loc><lastmod>2026-10-11</lastmod></url>\n  <url><loc>https://fieldnotes.example/n/compost-thermometer-week-3</loc><lastmod>2026-10-09</lastmod></url>\n  <url><loc>https://fieldnotes.example/n/drip-line-pressure</loc><lastmod>2026-09-30</lastmod></url>\n  <url><loc>https://fieldnotes.example/n/first-frost-dates</loc><lastmod>2026-08-20</lastmod></url>\n  <!-- 53 more -->\n</urlset>\napi:\ntotal 4\ndrwxr-xr-x 3 valentinakoniukhova wheel  96 Oct 18 23:30 .\ndrwx------ 8 valentinakoniukhova wheel 256 Oct 18 23:30 ..\n-rw-r--r-- 1 valentinakoniukhova wheel 734 Oct 18 23:30 routes.md\n\nsearch-console:\ntotal 8\ndrwxr-xr-x 4 valentinakoniukhova wheel 128 Oct 18 23:30 .\ndrwx------ 8 valentinakoniukhova wheel 256 Oct 18 23:30 ..\n-rw-r--r-- 1 valentinakoniukhova wheel 736 Oct 18 23:30 pages-2026-10-16.csv\n-rw-r--r-- 1 valentinakoniukhova wheel 350 Oct 18 23:30 url-inspection-drip-line-pressure.txt\n\nsite:\ntotal 20\ndrwxr-xr-x 7 valentinakoniukhova wheel  224 Oct 18 23:30 .\ndrwx------ 8 valentinakoniukhova wheel  256 Oct 18 23:30 ..\n-rw-r--r-- 1 valentinakoniukhova wheel 1105 Oct 18 