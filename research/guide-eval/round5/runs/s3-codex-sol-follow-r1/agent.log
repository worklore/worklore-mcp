{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport os\nimport subprocess\nimport tempfile\n\nroot = Path.cwd()\nscript = root / \\\"bin/nightly-review.zsh\\\"\nwith tempfile.TemporaryDirectory(prefix=\\\".nightly-test.\\\", dir=root) as temp:\n    fixture = Path(temp)\n    (fixture / \\\"repo\\\").mkdir()\n    mocks = fixture / \\\"mock\\\"\n    mocks.mkdir()\n    claude = mocks / \\\"claude\\\"\n    claude.write_text(\\\"\\\"\\\"#\"'!/bin/sh\ncat > \"$TEST_PROMPT\"\ncase \"$TEST_MODE\" in\n  success) printf '\"'Reviewed commits: all clear\\\\\\\\n'; exit 0 ;;\n  failure) printf 'mock agent failure\\\\\\\\n' >&2; exit 7 ;;\n  empty) exit 0 ;;\nesac\n\\\"\\\"\\\")\n    claude.chmod(0o755)\n    notify = fixture / \\\"notify\\\"\n    notify.write_text(\\\"\\\"\\\"#\"'!/bin/sh\nprintf '\"'%s\\\\\\\\n' \\\"\"'$1\" > \"$TEST_NOTE\"\n\"\"\")\n    notify.chmod(0o755)\n    for mode, expected_rc, expected_message in [\n        (\"success\", 0, \"nightly review done\"),\n        (\"failure\", 7, \"nightly review FAILED\"),\n        (\"empty\", 1, \"empty review\"),\n        (\"missing_repo\", 1, \"repo missing\"),\n    ]:\n        note = fixture / \"note\"\n        out = fixture / \"review.md\"\n        note.unlink(missing_ok=True)\n        out.unlink(missing_ok=True)\n        env = os.environ.copy()\n        env.update({\n            \"PATH\": f\"{mocks}:{env['\"'PATH']}\\\",\n            \\\"TEST_PROMPT\\\": str(fixture / \\\"prompt\\\"),\n            \\\"TEST_MODE\\\": mode,\n            \\\"TEST_NOTE\\\": str(note),\n            \\\"NIGHTLY_REPO\\\": str(fixture / (\\\"missing\\\" if mode == \\\"missing_repo\\\" else \\\"repo\\\")),\n            \\\"NIGHTLY_OUT\\\": str(out),\n            \\\"NIGHTLY_NOTIFY\\\": str(notify),\n        })\n        result = subprocess.run([\\\"/bin/zsh\\\", str(script)], env=env, text=True, capture_output=True)\n        message = note.read_text().strip()\n        assert result.returncode == expected_rc, (mode, result.returncode, result.stderr)\n        assert expected_message in message, (mode, message)\n        assert \\\"nightly review duration:\\\" in result.stderr, (mode, result.stderr)\n        if mode \"'!= \"missing_repo\":\n            assert \"Review the commits\" in (fixture / \"prompt\").read_text()\n        if mode == \"success\":\n            assert out.stat().st_size > 0\n        print(f\"{mode}: exit={result.returncode}, notification={message}\")\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
