{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc 'nl -ba server.py'","aggregated_output":"     1\t#!/usr/bin/env python3\n     2\t\"\"\"notes-mcp: a small remote MCP server (Streamable HTTP, JSON responses).\n     3\t\n     4\t    python3 server.py            # listens on http://127.0.0.1:54075/mcp\n     5\t    PORT=9000 python3 server.py\n     6\t\n     7\tReads are open. Writes and the resources endpoints need\n     8\t`Authorization: Bearer <token>`; the dev token is in TOKEN below.\n     9\t\"\"\"\n    10\timport json\n    11\timport os\n    12\timport sys\n    13\timport time\n    14\timport uuid\n    15\tfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\n    16\t\n    17\tPORT = int(os.environ.get(\"PORT\", \"54075\"))\n    18\tTOKEN = os.environ.get(\"NOTES_TOKEN\", \"dev-token-123\")\n    19\tPROTOCOL = \"2025-06-18\"\n    20\tHERE = os.path.dirname(os.path.abspath(__file__))\n    21\t\n    22\twith open(os.path.join(HERE, \"notes.json\")) as f:\n    23\t    NOTES = {n[\"id\"]: n for n in json.load(f)}\n    24\t\n    25\tTOOLS = [\n    26\t    {\n    27\t        \"name\": \"search_notes\",\n    28\t        \"description\": \"Full-text search over the notes. Returns id, title and a snippet per hit.\",\n    29\t        \"inputSchema\": {\n    30\t            \"type\": \"object\",\n    31\t            \"properties\": {\"query\": {\"type\": \"string\"}, \"limit\": {\"type\": \"integer\", \"minimum\": 1, \"maximum\": 50}},\n    32\t            \"required\": [\"query\"],\n    33\t        },\n    34\t        \"outputSchema\": {\"type\": \"object\"},\n    35\t        \"annotations\": {\"readOnlyHint\": True},\n    36\t    },\n    37\t    {\n    38\t        \"name\": \"get_note\",\n    39\t        \"description\": \"One note in full by id (ids look like n-12).\",\n    40\t        \"inputSchema\": {\n    41\t            \"type\": \"object\",\n    42\t            \"properties\": {\"id\": {\"type\": \"string\", \"pattern\": \"^n-[0-9]+$\"}},\n    43\t            \"required\": [\"id\"],\n    44\t        },\n    45\t        \"outputSchema\": {\n    46\t            \"type\": \"object\",\n    47\t            \"required\": [\"id\", \"title\", \"body\", \"words\"],\n    48\t            \"properties\": {\n    49\t                \"id\": {\"type\": \"string\", \"pattern\": \"^n-[0-9]+$\"},\n    50\t                \"title\": {\"type\": \"string\", \"minLength\": 1},\n    51\t                \"body\": {\"type\": \"string\"},\n    52\t                \"words\": {\"type\": \"integer\", \"minimum\": 0},\n    53\t                \"tags\": {\"type\": \"array\", \"items\": {\"type\": \"string\", \"minLength\": 1}},\n    54\t            },\n    55\t        },\n    56\t        \"annotations\": {\"readOnlyHint\": True},\n    57\t    },\n    58\t    {\n    59\t        \"name\": \"add_note\",\n    60\t        \"description\": \"Create a note. Needs a signed-in session.\",\n    61\t        \"inputSchema\": {\n    62\t            \"type\": \"object\",\n    63\t            \"properties\": {\"title\": {\"type\": \"string\", \"minLength\": 1}, \"body\": {\"type\": \"string\"}},\n    64\t            \"required\": [\"title\", \"body\"],\n    65\t        },\n    66\t        \"outputSchema\": {\n    67\t            \"type\": \"object\",\n    68\t            \"required\": [\"id\"],\n    69\t            \"properties\": {\"id\": {\"type\": \"string\", \"pattern\": \"^n-[0-9]+$\"}},\n    70\t        },\n    71\t        \"annotations\": {\"readOnlyHint\": False, \"destructiveHint\": False},\n    72\t    },\n    73\t]\n    74\t\n    75\tRESOURCES = [\n    76\t    {\"uri\": \"notes://guide\", \"name\": \"guide\", \"mimeType\": \"text/markdown\", \"description\": \"How to use this server\"},\n    77\t]\n    78\t\n    79\t\n    80\tdef log(method, tool=None, ok=True, ms=0, who=\"anon\"):\n    81\t    rec = {\"t\": time.strftime(\"%Y-%m-%dT%H:%M:%S\"), \"method\": method, \"tool\": tool, \"ok\": ok, \"ms\": round(ms, 1), \"who\": who}\n    82\t    sys.stderr.write(json.dumps(rec) + \"\\n\")\n    83\t    sys.stderr.flush()\n    84\t\n    85\t\n    86\tdef rpc_result(id_, result):\n    87\t    return 200, {\"jsonrpc\": \"2.0\", \"id\": id_, \"result\": result}\n    88\t\n    89\t\n    90\tdef rpc_error(id_, code, message):\n    91\t    return 200, {\"jsonrpc\": \"2.0\", \"id\": id_, \"error\": {\"code\": code, \"message\": message}}\n    92\t\n    93\t\n    94\tdef tool_result(text, structured=None, is_error=False):\n    95\t    r = {\"content\": [{\"type\": \"text\", \"text\": text}], \"isError\": is_error}\n    96\t    if structured is not None:\n    97\t        r[\"structuredContent\"] = structured\n    98\t    return r\n    99\t\n   100\t\n   101\tdef call_tool(name, args, who):\n   102\t    if name == \"search_notes\":\n   103\t        q = str(args.get(\"query\", \"\")).lower()\n   104\t        limit = int(args.get(\"limit\", 10))\n   105\t        hits = []\n   106\t        for n in NOTES.values():\n   107\t            text = (n[\"title\"] + \" \" + n[\"body\"]).lower()\n   108\t            if q in text:\n   109\t                i = text.find(q)\n   110\t                hits.append({\"id\": n[\"id\"], \"title\": n[\"title\"], \"snippet\": n[\"body\"][max(0, i - 30): i + 50]})\n   111\t        hits = hits[:limit]\n   112\t        return tool_result(json.dumps(hits), {\"hits\": hits, \"total\": len(hits)})\n   113\t    if name == \"get_note\":\n   114\t        nid = args.get(\"id\")\n   115\t        if nid is None:\n   116\t            raise ValueError(\"missing required argument: id\")\n   117\t        n = NOTES.get(nid)\n   118\t        if n is None:\n   119\t            raise ValueError(f\"note not found: {nid}\")\n   120\t        out = {\"id\": n[\"id\"], \"title\": n[\"title\"], \"body\": n[\"body\"], \"words\": len(n[\"body\"].split()), \"tags\": n.get(\"tags\", [])}\n   121\t        return tool_result(json.dumps(out), out)\n   122\t    if name == \"add_note\":\n   123\t        if who == \"anon\":\n   124\t            return None  # caller turns this into a 401\n   125\t        nid = f\"n-{max(int(k[2:]) for k in NOTES) + 1}\"\n   126\t        NOTES[nid] = {\"id\": nid, \"title\": args[\"title\"], \"body\": args[\"body\"], \"tags\": []}\n   127\t        return tool_result(json.dumps({\"id\": nid}), {\"id\": nid})\n   128\t    return None\n   129\t\n   130\t\n   131\tdef handle(req, who):\n   132\t    method = req.get(\"method\")\n   133\t    id_ = req.get(\"id\")\n   134\t    params = req.get(\"params\") or {}\n   135\t    if method == \"initialize\":\n   136\t        return rpc_result(id_, {\n   137\t            \"protocolVersion\": PROTOCOL,\n   138\t            \"capabilities\": {\"tools\": {\"listChanged\": False}, \"resources\": {\"subscribe\": False, \"listChanged\": False}},\n   139\t            \"serverInfo\": {\"name\": \"notes-mcp\", \"version\": \"0.3.1\"},\n   140\t            \"instructions\": \"Search and read notes. add_note needs a signed-in session.\",\n   141\t        })\n   142\t    if method == \"notifications/initialized\":\n   143\t        return 202, None\n   144\t    if method == \"ping\":\n   145\t        return rpc_result(id_, {})\n   146\t    if method == \"tools/list\":\n   147\t        return rpc_result(id_, {\"tools\": TOOLS})\n   148\t    if method in (\"resources/list\", \"resources/read\", \"resources/templates/list\"):\n   149\t        if who == \"anon\":\n   150\t            return 401, {\"error\": \"unauthorized\"}\n   151\t        if method == \"resources/list\":\n   152\t            return rpc_result(id_, {\"resources\": RESOURCES})\n   153\t        if method == \"resources/templates/list\":\n   154\t            return rpc_result(id_, {\"resourceTemplates\": []})\n   155\t        return rpc_result(id_, {\"contents\": [{\"uri\": \"notes://guide\", \"mimeType\": \"text/markdown\", \"text\": \"# notes-mcp\\nsearch_notes, get_note, add_note.\"}]})\n   156\t    if method == \"tools/call\":\n   157\t        name = params.get(\"name\")\n   158\t        args = params.get(\"arguments\") or {}\n   159\t        if not any(t[\"name\"] == name for t in TOOLS):\n   160\t            return rpc_error(id_, -32601, f\"unknown tool: {name}\")\n   161\t        try:\n   162\t            res = call_tool(name, args, who)\n   163\t        except ValueError as e:\n   164\t            return rpc_error(id_, -32602, str(e))\n   165\t        if res is None:\n   166\t            return 401, {\"error\": \"sign in required\"}\n   167\t        return rpc_result(id_, res)\n   168\t    return rpc_error(id_, -32601, f\"method not found: {method}\")\n   169\t\n   170\t\n   171\tclass Handler(BaseHTTPRequestHandler):\n   172\t    server_version = \"notes-mcp/0.3.1\"\n   173\t\n   174\t    def _send(self, status, body, session=None):\n   175\t        data = b\"\" if body is None else json.dumps(body).encode()\n   176\t        self.send_response(status)\n   177\t        if data:\n   178\t            self.send_header(\"Content-Type\", \"application/json\")\n   179\t        self.send_header(\"Content-Length\", str(len(data)))\n   180\t        if session:\n   181\t            self.send_header(\"Mcp-Session-Id\", session)\n   182\t        self.end_headers()\n   183\t        if data:\n   184\t            self.wfile.write(data)\n   185\t\n   186\t    def do_GET(self):\n   187\t        self._send(405, {\"error\": \"use POST\"})\n   188\t\n   189\t    def do_DELETE(self):\n   190\t        self._send(204, None)\n   191\t\n   192\t    def do_POST(self):\n   193\t        if self.path.rstrip(\"/\") != \"/mcp\":\n   194\t            return self._send(404, {\"error\": \"not found\"})\n   195\t        n = int(self.headers.get(\"Content-Length\") or 0)\n   196\t        raw = self.rfile.read(n)\n   197\t        try:\n   198\t            req = json.loads(raw or b\"{}\")\n   199\t        except json.JSONDecodeError:\n   200\t            return self._send(400, {\"jsonrpc\": \"2.0\", \"id\": None, \"error\": {\"code\": -32700, \"message\": \"parse error\"}})\n   201\t        auth = self.headers.get(\"Authorization\", \"\")\n   202\t        who = \"dev\" if auth == f\"Bearer {TOKEN}\" else \"anon\"\n   203\t        session = self.headers.get(\"Mcp-Session-Id\")\n   204\t        t0 = time.time()\n   205\t        if isinstance(req, list):\n   206\t            out = []\n   207\t            for r in req:\n   208\t                _, b = handle(r, who)\n   209\t                if b is not None:\n   210\t                    out.append(b)\n   211\t            return self._send(200, out, session)\n   212\t        status, body = handle(req, who)\n   213\t        if req.get(\"method\") == \"initialize\" and not session:\n   214\t            session = uuid.uuid4().hex\n   215\t        ok = status < 400 and not (isinstance(body, dict) and \"error\" in body)\n   216\t        log(req.get(\"method\"), (req.get(\"params\") or {}).get(\"name\"), ok, (time.time() - t0) * 1000, who)\n   217\t        self._send(status, body, session)\n   218\t\n   219\t    def log_message(self, *a):\n   220\t        pass\n   221\t\n   222\t\n   223\tif __name__ == \"__main__\":\n   224\t    srv = ThreadingHTTPServer((\"127.0.0.1\", PORT), Handler)\n   225\t    sys.stderr.write(f\"notes-mcp listening on http://127.0.0.1:{PORT}/mcp\\n\")\n   226\t    sys.stderr.flush()\n   227\t    try:\n   228\t        srv.serve_forever()\n   229\t    except KeyboardInterrupt:\n   230\t        pass\n","exit_code":0,"status":"completed"}}
