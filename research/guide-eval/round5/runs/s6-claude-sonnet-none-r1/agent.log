ta = b\"\" if body is None else json.dumps(body).encode()\n        self.send_response(status)\n        if data:\n            self.send_header(\"Content-Type\", \"application/json\")\n        self.send_header(\"Content-Length\", str(len(data)))\n        if session:\n            self.send_header(\"Mcp-Session-Id\", session)\n        self.end_headers()\n        if data:\n            self.wfile.write(data)\n\n    def do_GET(self):\n        self._send(405, {\"error\": \"use POST\"})\n\n    def do_DELETE(self):\n        self._send(204, None)\n\n    def do_POST(self):\n        if self.path.rstrip(\"/\") != \"/mcp\":\n            return self._send(404, {\"error\": \"not found\"})\n        n = int(self.headers.get(\"Content-Length\") or 0)\n        raw = self.rfile.read(n)\n        try:\n            req = json.loads(raw or b\"{}\")\n        except json.JSONDecodeError:\n            return self._send(400, {\"jsonrpc\": \"2.0\", \"id\": None, \"error\": {\"code\": -32700, \"message\": \"parse error\"}})\n        auth = self.headers.get(\"Authorization\", \"\")\n        who = \"dev\" if auth == f\"Bearer {TOKEN}\" else \"anon\"\n        session = self.headers.get(\"Mcp-Session-Id\")\n        t0 = time.time()\n        if isinstance(req, list):\n            out = []\n            for r in req:\n                _, b = handle(r, who)\n                if b is not None:\n                    out.append(b)\n            return self._send(200, out, session)\n        status, body = handle(req, who)\n        if req.get(\"method\") == \"initialize\" and not session:\n            session = uuid.uuid4().hex\n        ok = status < 400 and not (isinstance(body, dict) and \"error\" in body)\n        log(req.get(\"method\"), (req.get(\"params\") or {}).get(\"name\"), ok, (time.time() - t0) * 1000, who)\n        self._send(status, body, session)\n\n    def log_message(self, *a):\n        pass\n\n\nif __name__ == \"__main__\":\n    srv = ThreadingHTTPServer((\"127.0.0.1\", PORT), Handler)\n    sys.stderr.write(f\"notes-mcp listening on http://127.0.0.1:{PORT}/mcp\\n\")\n    sys.stderr.flush()\n    try:\n        srv.serve_forever()\n    except KeyboardInterrupt:\n        pass","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01Td63S7SpaPKCDrViT3VF8D","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
