{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc \"node <<'NODE'\nconst fs = require('node:fs');\nconst vm = require('node:vm');\nconst assert = require('node:assert/strict');\nconst script = fs.readFileSync('site/app.js', 'utf8');\nconst robots = fs.readFileSync('site/robots.txt', 'utf8');\nassert(\"'!robots.includes('\"'Disallow: /v1/\\\\n'));\nassert(robots.includes('Disallow: /v1/me'));\nassert(robots.includes('Disallow: /v1/auth/'));\nasync function render(fetch) {\n  const app = { innerHTML: '' };\n  const document = { title: 'Field notes', getElementById: () => app };\n  const context = { document, location: { pathname: '/n/drip-line-pressure' }, fetch };\n  await vm.runInNewContext(script, context);\n  await new Promise(resolve => setImmediate(resolve));\n  return { html: app.innerHTML, title: document.title };\n}\n(async () => {\n  const live = await render(async url => {\n    assert.equal(url, '/v1/notes/drip-line-pressure');\n    return { ok: true, status: 200, json: async () => ({ title: 'Drip line pressure', date: '2026-09-30', html: '<p>Note content</p>' }) };\n  });\n  assert.match(live.html, /Note content/);\n  assert.equal(live.title, 'Drip line pressure · Field notes');\n  const missing = await render(async () => ({ ok: false, status: 404 }));\n  assert.match(missing.html, /NOT FOUND/);\n  const failure = await render(async () => ({ ok: false, status: 503 }));\n  assert.match(failure.html, /Temporarily unavailable/);\n  assert.doesNotMatch(failure.html, /NOT FOUND/);\n  const network = await render(async () => { throw new Error('network'); });\n  assert.match(network.html, /Temporarily unavailable/);\n  console.log('Local checks passed: public API robots access; live, missing, HTTP failure, and network failure rendering.');\n})().catch(error => { console.error(error); process.exitCode = 1; });\nNODE\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
