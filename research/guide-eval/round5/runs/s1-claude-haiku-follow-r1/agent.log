ck))\n    return {\"steps\": steps}\n\n\ndef build_event(plan):\n    return {\n        \"category\": \"WORKOUT\",\n        \"type\": plan[\"sport\"],\n        \"name\": plan[\"name\"],\n        \"start_date_local\": plan[\"date\"] + \"T00:00:00\",\n        \"workout_doc\": build_doc(plan),\n    }\n\n\nif __name__ == \"__main__\":\n    with open(sys.argv[1]) as f:\n        plan = json.load(f)\n    json.dump(build_event(plan), sys.stdout, indent=2)\n    print()\n","structuredPatch":[{"oldStart":8,"oldLines":9,"newStart":8,"newLines":14,"lines":[" "," "," def hr_target(step):","-    \"\"\"HR corridor for a step, as a percentage of the athlete's LTHR.\"\"\"","+    \"\"\"HR corridor for a step, as a percentage of the athlete's LTHR.","+","+    The lower bound must be keyed \"start\", not \"value\": Intervals exports","+    {value, end} as a lap-HR target that the watch maps onto its own zones,","+    and {start, end} as an instant-HR corridor shown as the raw bpm range.","+    \"\"\"","     lo, hi = step[\"hr_pct\"]","-    return {\"units\": \"%lthr\", \"value\": lo, \"end\": hi}","+    return {\"units\": \"%lthr\", \"start\": lo, \"end\": hi}"," "," "," def build_step(step):"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"tool_result_meta":[{"id":"toolu_018BjL2qkGKfyXPPHNyt3dsn","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
