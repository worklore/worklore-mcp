{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc 'bash -n scripts/deploy.sh && git diff --check && git diff -- scripts/deploy.sh && find src -type f | sort'","aggregated_output":"diff --git a/scripts/deploy.sh b/scripts/deploy.sh\nindex 6550d32..e58c02a 100755\n--- a/scripts/deploy.sh\n+++ b/scripts/deploy.sh\n@@ -9,6 +9,26 @@ PROFILE=\"studio\"\n \n aws s3 sync src/ \"s3://$BUCKET/\" --delete --profile \"$PROFILE\"\n \n+# Upload with explicit content types so cache metadata cannot make pages or\n+# scripts download as binary files. Re-upload even unchanged files: sync does\n+# not update metadata on objects whose content has not changed.\n+for spec in \\\n+  \"html:text/html:300\" \\\n+  \"js:application/javascript:300\" \\\n+  \"css:text/css:300\" \\\n+  \"png:image/png:86400\" \\\n+  \"svg:image/svg+xml:86400\"; do\n+  ext=\"${spec%%:*}\"\n+  rest=\"${spec#*:}\"\n+  content_type=\"${rest%%:*}\"\n+  max_age=\"${rest#*:}\"\n+  aws s3 cp src/ \"s3://$BUCKET/\" --recursive \\\n+    --exclude \"*\" --include \"*.$ext\" \\\n+    --content-type \"$content_type\" \\\n+    --cache-control \"public, max-age=$max_age\" \\\n+    --only-show-errors --profile \"$PROFILE\"\n+done\n+\n aws cloudfront create-invalidation --distribution-id \"$DISTRIBUTION_ID\" \\\n   --paths \"/*\" --profile \"$PROFILE\" > /dev/null\n \nsrc/assets/logo.png\nsrc/assets/mark.svg\nsrc/booking.js\nsrc/clases.html\nsrc/index.html\nsrc/styles.css\n","exit_code":0,"status":"completed"}}
