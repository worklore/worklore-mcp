new file mode 100644
index 0000000..d71619a
--- /dev/null
+++ b/ANSWER.md
@@ -0,0 +1,7 @@
+# Cache headers for deploys
+
+Updated `scripts/deploy.sh` to upload HTML, JavaScript, and CSS with `Cache-Control: public, max-age=300` (5 minutes). Files currently in `assets/` (`.png` and `.svg`) receive `public, max-age=86400` (1 day).
+
+Each upload also sets its correct `Content-Type`. The script uploads these files on every deploy so unchanged objects receive the new metadata, then invalidates CloudFront as before. This prevents a metadata update from turning pages or scripts into binary downloads.
+
+Checked shell syntax with `bash -n scripts/deploy.sh` and whitespace with `git diff --check`. No deploy was run.
diff --git a/scripts/deploy.sh b/scripts/deploy.sh
index 6550d32..e58c02a 100755
--- a/scripts/deploy.sh
+++ b/scripts/deploy.sh
@@ -9,6 +9,26 @@ PROFILE="studio"
 
 aws s3 sync src/ "s3://$BUCKET/" --delete --profile "$PROFILE"
 
+# Upload with explicit content types so cache metadata cannot make pages or
+# scripts download as binary files. Re-upload even unchanged files: sync does
+# not update metadata on objects whose content has not changed.
+for spec in \
+  "html:text/html:300" \
+  "js:application/javascript:300" \
+  "css:text/css:300" \
+  "png:image/png:86400" \
+  "svg:image/svg+xml:86400"; do
+  ext="${spec%%:*}"
+  rest="${spec#*:}"
+  content_type="${rest%%:*}"
+  max_age="${rest#*:}"
+  aws s3 cp src/ "s3://$BUCKET/" --recursive \
+    --exclude "*" --include "*.$ext" \
+    --content-type "$content_type" \
+    --cache-control "public, max-age=$max_age" \
+    --only-show-errors --profile "$PROFILE"
+done
+
 aws cloudfront create-invalidation --distribution-id "$DISTRIBUTION_ID" \
   --paths "/*" --profile "$PROFILE" > /dev/null
 
