{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc 'bash -n scripts/deploy.sh && git diff --check && git diff -- scripts/deploy.sh'","aggregated_output":"diff --git a/scripts/deploy.sh b/scripts/deploy.sh\nindex 6550d32..2d5b07b 100755\n--- a/scripts/deploy.sh\n+++ b/scripts/deploy.sh\n@@ -7,7 +7,28 @@ BUCKET=\"ruta-ceramica-site-7f3a\"\n DISTRIBUTION_ID=\"E2QX9ZK1DEMO01\"\n PROFILE=\"studio\"\n \n-aws s3 sync src/ \"s3://$BUCKET/\" --delete --profile \"$PROFILE\"\n+# Sync removes deleted files. The copies below also refresh metadata on files\n+# whose contents have not changed, since sync skips those objects.\n+aws s3 sync src/ \"s3://$BUCKET/\" --delete \\\n+  --cache-control \"public, max-age=300\" --profile \"$PROFILE\"\n+\n+for file_type in \\\n+  \"html:text/html\" \\\n+  \"js:application/javascript\" \\\n+  \"css:text/css\"; do\n+  extension=\"${file_type%%:*}\"\n+  content_type=\"${file_type#*:}\"\n+  aws s3 cp src/ \"s3://$BUCKET/\" --recursive \\\n+    --exclude \"*\" --include \"*.${extension}\" --exclude \"assets/*\" \\\n+    --content-type \"$content_type\" \\\n+    --cache-control \"public, max-age=300\" \\\n+    --only-show-errors --profile \"$PROFILE\"\n+done\n+\n+# Copy from local files so the CLI detects each asset's MIME type.\n+aws s3 cp src/assets/ \"s3://$BUCKET/assets/\" --recursive \\\n+  --cache-control \"public, max-age=86400\" \\\n+  --only-show-errors --profile \"$PROFILE\"\n \n aws cloudfront create-invalidation --distribution-id \"$DISTRIBUTION_ID\" \\\n   --paths \"/*\" --profile \"$PROFILE\" > /dev/null\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport os, pathlib, subprocess, tempfile\nroot = pathlib.Path.cwd()\nwith tempfile.TemporaryDirectory(dir=root) as temp:\n    fake_aws = pathlib.Path(temp) / 'aws'\n    fake_aws.write_text('#\"'!/usr/bin/env python3'\"\\\\nimport json, os, sys\\\\nwith open(os.environ[\\\"AWS_CALL_LOG\\\"], \\\"a\\\") as out: out.write(json.dumps(sys.argv[1:]) + \\\"\\\\\\\\n\\\")\\\\n')\n    fake_aws.chmod(0o755)\n    log = pathlib.Path(temp) / 'calls.jsonl'\n    env = os.environ.copy()\n    env['PATH'] = temp + os.pathsep + env['PATH']\n    env['AWS_CALL_LOG'] = str(log)\n    result = subprocess.run(['bash', 'scripts/deploy.sh'], cwd=root, env=env, capture_output=True, text=True, check=True)\n    import json\n    calls = [json.loads(line) for line in log.read_text().splitlines()]\n    assert len(calls) == 6, calls\n    assert calls[0][:2] == ['s3', 'sync'] and '--delete' in calls[0]\n    for ext, mime, call in zip(('html', 'js', 'css'), ('text/html', 'application/javascript', 'text/css'), calls[1:4]):\n        assert call[:2] == ['s3', 'cp'] and f'*.{ext}' in call\n        assert call[call.index('--content-type') + 1] == mime\n        assert call[call.index('--cache-control') + 1] == 'public, max-age=300'\n    assert calls[4][:3] == ['s3', 'cp', 'src/assets/']\n    assert calls[4][calls[4].index('--cache-control') + 1] == 'public, max-age=86400'\n    assert calls[5][:2] == ['cloudfront', 'create-invalidation']\n    print('Mock deploy passed: short HTML/JS/CSS, long assets, then invalidation; no AWS calls made.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport os, pathlib, subprocess, tempfile\nroot = pathlib.Path.cwd()\nwith tempfile.TemporaryDirectory(dir=root) as temp:\n    fake_aws = pathlib.Path(temp) / 'aws'\n    fake_aws.write_text('#\"'!/usr/bin/env python3'\"\\\\nimport json, os, sys\\\\nwith open(os.environ[\\\"AWS_CALL_LOG\\\"], \\\"a\\\") as out: out.write(json.dumps(sys.argv[1:]) + \\\"\\\\\\\\n\\\")\\\\n')\n    fake_aws.chmod(0o755)\n    log = pathlib.Path(temp) / 'calls.jsonl'\n    env = os.environ.copy()\n    env['PATH'] = temp + os.pathsep + env['PATH']\n    env['AWS_CALL_LOG'] = str(log)\n    result = subprocess.run(['bash', 'scripts/deploy.sh'], cwd=root, env=env, capture_output=True, text=True, check=True)\n    import json\n    calls = [json.loads(line) for line in log.read_text().splitlines()]\n    assert len(calls) == 6, calls\n    assert calls[0][:2] == ['s3', 'sync'] and '--delete' in calls[0]\n    for ext, mime, call in zip(('html', 'js', 'css'), ('text/html', 'application/javascript', 'text/css'), calls[1:4]):\n        assert call[:2] == ['s3', 'cp'] and f'*.{ext}' in call\n        assert call[call.index('--content-type') + 1] == mime\n        assert call[call.index('--cache-control') + 1] == 'public, max-age=300'\n    assert calls[4][:3] == ['s3', 'cp', 'src/assets/']\n    assert calls[4][calls[4].index('--cache-control') + 1] == 'public, max-age=86400'\n    assert calls[5][:2] == ['cloudfront', 'create-invalidation']\n    print('Mock deploy passed: short HTML/JS/CSS, long assets, then invalidation; no AWS calls made.')\nPY\"","aggregated_output":"Mock deploy passed: short HTML/JS/CSS, long assets, then invalidation; no AWS calls made.\n","exit_code":0,"status":"completed"}}
