otes\"),(\"D\",\"/v1/notes/*/reactions\"),(\"D\",\"/admin/\")]\ndef m(p,path): return re.match(re.escape(p).replace(r\"\\*\",\".*\"),path)\nfor path in [\"/v1/notes\",\"/v1/notes?limit=50\",\"/v1/notes/drip-line-pressure\",\"/v1/notes/x/reactions\",\"/v1/me\",\"/v1/me/drafts\",\"/v1/auth/token\",\"/admin/x\",\"/n/x\"]:\n    hit=[(len(p),t==\"A\",t) for t,p in rules if m(p,path)]\n    print(path, \"allow\" if not hit or max(hit)[2]==\"A\" else \"BLOCK\")\nE\npython3 -I /tmp/rt.py"}}}
