{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KhopG77Sjojkxa6Jrw4ZJa","type":"tool_result","content":"=== lib/analytics.dart\n     1\timport 'package:posthog_flutter/posthog_flutter.dart';\n     2\t\n     3\tclass Analytics {\n     4\t  static Future<void> init() async {\n     5\t    final config = PostHogConfig('phc_REPLACE_ME_IN_CI');\n     6\t    config.host = 'https://eu.i.posthog.com';\n     7\t    config.captureApplicationLifecycleEvents = true;\n     8\t    config.sessionReplay = true;\n     9\t    config.sessionReplayConfig.maskAllTexts = true;\n    10\t    config.sessionReplayConfig.maskAllImages = false;\n    11\t    await Posthog().setup(config);\n    12\t  }\n    13\t\n    14\t  static Future<void> track(String event, [Map<String, Object>? props]) =>\n    15\t      Posthog().capture(eventName: event, properties: props);\n    16\t}\n=== lib/main.dart\n     1\timport 'package:flutter/material.dart';\n     2\t\n     3\timport 'analytics.dart';\n     4\timport 'legacy_app.dart';\n     5\timport 'new_app.dart';\n     6\t\n     7\tconst bool useNewUi = bool.fromEnvironment('NEW_UI', defaultValue: true);\n     8\t\n     9\tFuture<void> main() async {\n    10\t  WidgetsFlutterBinding.ensureInitialized();\n    11\t  await Analytics.init();\n    12\t  runApp(useNewUi ? const NewApp() : const LegacyApp());\n    13\t}\n=== lib/legacy_app.dart\n     1\timport 'package:flutter/material.dart';\n     2\timport 'package:posthog_flutter/posthog_flutter.dart';\n     3\t\n     4\timport 'screens/calculator_screen.dart';\n     5\timport 'screens/application_screen.dart';\n     6\t\n     7\t/// The old shell. Kept for the A/B group until the redesign is fully rolled out.\n     8\tclass LegacyApp extends StatelessWidget {\n     9\t  const LegacyApp({super.key});\n    10\t\n    11\t  @override\n    12\t  Widget build(BuildContext context) {\n    13\t    return PostHogWidget(\n    14\t      child: MaterialApp(\n    15\t        title: 'Loanly',\n    1