{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"node <<'NODE'\nconst fs = require('fs');\nconst rules = fs.readFileSync('site/robots.txt','utf8').split('\\\\n').map(line => line.match(/\"'^(Allow|Disallow):'\"\\\\s*(\\\\S+)/)).filter(Boolean).map(([,type,path]) => ({type,path,score:path.replaceAll('*','').length,regex:new RegExp('\"'^'\"'+path.split('*').map(s=>s.replace(/[.*+?\"'^${}()|['\"\\\\]\\\\\\\\]/g,'\\\\\\\\\"'$&'\"')).join('.*'))}));\nfor (const [path,expected] of [['/v1/notes','Allow'],['/v1/notes?limit=50','Allow'],['/v1/notes/drip-line-pressure','Allow'],['/v1/notes/drip-line-pressure/reactions','Disallow'],['/v1/me','Disallow'],['/v1/auth/token','Disallow'],['/v1/other','Disallow'],['/admin/','Disallow']]) {\n  const actual = rules.filter(r=>r.regex.test(path)).sort((a,b)=>b.score-a.score || (a.type==='Allow'?-1:1))[0]?.type;\n  if(actual\"'!==expected) throw new Error(`${path}: ${actual}, expected ${expected}`);\n  console.log(`${path}: ${actual}`);\n}\nNODE'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
