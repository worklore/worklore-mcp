{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc 'cat lib/new_app.dart lib/legacy_app.dart lib/main.dart lib/analytics.dart README.md pubspec.yaml && git status --short'","aggregated_output":"import 'package:flutter/material.dart';\nimport 'package:go_router/go_router.dart';\nimport 'package:posthog_flutter/posthog_flutter.dart';\n\nimport 'screens/calculator_screen.dart';\nimport 'screens/application_screen.dart';\nimport 'screens/offers_screen.dart';\n\nfinal _router = GoRouter(\n  observers: [PosthogObserver()],\n  routes: [\n    GoRoute(path: '/', builder: (_, __) => const CalculatorScreen()),\n    GoRoute(path: '/apply', builder: (_, __) => const ApplicationScreen()),\n    GoRoute(path: '/offers', builder: (_, __) => const OffersScreen()),\n  ],\n);\n\n/// The redesigned shell (default since 2.3.0).\nclass NewApp extends StatelessWidget {\n  const NewApp({super.key});\n\n  @override\n  Widget build(BuildContext context) {\n    return MaterialApp.router(\n      title: 'Loanly',\n      theme: ThemeData(\n        colorSchemeSeed: Colors.indigo,\n        useMaterial3: true,\n      ),\n      routerConfig: _router,\n    );\n  }\n}\nimport 'package:flutter/material.dart';\nimport 'package:posthog_flutter/posthog_flutter.dart';\n\nimport 'screens/calculator_screen.dart';\nimport 'screens/application_screen.dart';\n\n/// The old shell. Kept for the A/B group until the redesign is fully rolled out.\nclass LegacyApp extends StatelessWidget {\n  const LegacyApp({super.key});\n\n  @override\n  Widget build(BuildContext context) {\n    return PostHogWidget(\n      child: MaterialApp(\n        title: 'Loanly',\n        theme: ThemeData(colorSchemeSeed: Colors.teal),\n        navigatorObservers: [PosthogObserver()],\n        routes: {\n          '/': (_) => const CalculatorScreen(),\n          '/apply': (_) => const ApplicationScreen(),\n        },\n      ),\n    );\n  }\n}\nimport 'package:flutter/material.dart';\n\nimport 'analytics.dart';\nimport 'legacy_app.dart';\nimport 'new_app.dart';\n\nconst bool useNewUi = bool.fromEnvironment('NEW_UI', defaultValue: true);\n\nFuture<void> main() async {\n  WidgetsFlutterBinding.ensureInitialized();\n  await Analytics.init();\n  runApp(useNewUi ? const NewApp() : const LegacyApp());\n}\nimport 'package:posthog_flutter/posthog_flutter.dart';\n\nclass Analytics {\n  static Future<void> init() async {\n    final config = PostHogConfig('phc_REPLACE_ME_IN_CI');\n    config.host = 'https://eu.i.posthog.com';\n    config.captureApplicationLifecycleEvents = true;\n    config.sessionReplay = true;\n    config.sessionReplayConfig.maskAllTexts = true;\n    config.sessionReplayConfig.maskAllImages = false;\n    await Posthog().setup(config);\n  }\n\n  static Future<void> track(String event, [Map<String, Object>? props]) =>\n      Posthog().capture(eventName: event, properties: props);\n}\n# loanly\n\nFlutter app (iOS + Android). Two UI shells ship at the moment:\n\n- `lib/legacy_app.dart` — the old UI, still used by ~30% of users\n  (`--dart-define=NEW_UI=false` in the release pipeline for the A/B group).\n- `lib/new_app.dart` — the redesigned UI with go_router (default).\n\nAnalytics: PostHog (`posthog_flutter`). Events, screen tracking and session\nreplay are enabled in `lib/analytics.dart`; \"Record user sessions\" is on in\nthe PostHog project settings, sampling 100%.\n\n```\nflutter run --dart-define=NEW_UI=true\nflutter run --dart-define=NEW_UI=false\n```\nname: loanly\ndescription: Loan calculator and application flow.\npublish_to: \"none\"\nversion: 2.4.0+61\n\nenvironment:\n  sdk: ^3.5.0\n\ndependencies:\n  flutter:\n    sdk: flutter\n  go_router: ^14.6.2\n  posthog_flutter: ^5.36.0\n\ndev_dependencies:\n  flutter_test:\n    sdk: flutter\n  flutter_lints: ^5.0.0\n\nflutter:\n  uses-material-design: true\n","exit_code":0,"status":"completed"}}
