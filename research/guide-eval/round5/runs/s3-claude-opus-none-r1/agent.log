of $?); use rc.","+rc=$?"," ","-if [ $status -ne 0 ]; then","-  \"$NOTIFY\" \"nightly review FAILED (exit $status), see $OUT\"","-  exit $status","+if [ $rc -ne 0 ]; then","+  \"$NOTIFY\" \"nightly review FAILED (exit $rc): $(head -c 300 \"$OUT.err\") — see $OUT.err\"","+  exit $rc"," fi"," ","-\"$NOTIFY\" \"nightly review done: $(head -c 300 \"$OUT\")\"","+# The phone summary is at the end of the output, so send the tail.","+\"$NOTIFY\" \"nightly review done: $(tail -n 3 \"$OUT\")\""]}]}],"moreFiles":0,"changedFiles":["/private/tmp/h-NaWQci/bin/nightly-review.zsh"]}},"tool_result_meta":[{"id":"toolu_014DazfTTuuLtb8kswnNtjfq","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
