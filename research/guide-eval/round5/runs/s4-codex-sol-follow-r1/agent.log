{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"bash -n scripts/deploy.sh && python3 - <<'PY'\nimport json, os, pathlib, subprocess, tempfile\nwith tempfile.TemporaryDirectory(dir='.') as temp:\n    fake = pathlib.Path(temp) / 'aws'\n    log = pathlib.Path(temp) / 'calls.jsonl'\n    fake.write_text('#\"'!/usr/bin/env python3'\"\\\\nimport json, os, sys\\\\nwith open(os.environ[\\\"AWS_MOCK_LOG\\\"], \\\"a\\\") as out: out.write(json.dumps(sys.argv[1:]) + \\\"\\\\\\\\n\\\")\\\\n')\n    fake.chmod(0o755)\n    env = dict(os.environ, PATH=f'{temp}:{os.environ[\\\"PATH\\\"]}', AWS_MOCK_LOG=str(log.resolve()))\n    subprocess.run(['bash', 'scripts/deploy.sh'], check=True, env=env, capture_output=True, text=True)\n    calls = [json.loads(line) for line in log.read_text().splitlines()]\n    uploads = {call[3]: call for call in calls if call[:2] == ['s3', 'cp']}\n    expected = {\n        'src/index.html': ('text/html', '300'),\n        'src/clases.html': ('text/html', '300'),\n        'src/booking.js': ('application/javascript', '300'),\n        'src/styles.css': ('text/css', '300'),\n        'src/assets/logo.png': ('image/png', '86400'),\n        'src/assets/mark.svg': ('image/svg+xml', '86400'),\n    }\n    assert set(uploads) == set(expected), uploads\n    for path, (mime, ttl) in expected.items():\n        call = uploads[path]\n        assert call[call.index('--content-type') + 1] == mime, call\n        assert call[call.index('--cache-control') + 1] == f'public, max-age={ttl}', call\n    assert calls[-2][:2] == ['s3', 'sync'], calls[-2]\n    assert '--delete' in calls[-2], calls[-2]\n    assert calls[-1][:2] == ['cloudfront', 'create-invalidation'], calls[-1]\n    print('Local deploy simulation passed: six typed uploads, cache headers, deletion sync, then invalidation.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
