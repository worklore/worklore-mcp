{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc 'cat scripts/deploy.sh && bash -n scripts/deploy.sh && git diff --check'","aggregated_output":"#!/usr/bin/env bash\n# Upload src/ to the bucket and invalidate CloudFront.\nset -euo pipefail\ncd \"$(dirname \"$0\")/..\"\n\nBUCKET=\"ruta-ceramica-site-7f3a\"\nDISTRIBUTION_ID=\"E2QX9ZK1DEMO01\"\nPROFILE=\"studio\"\n\n# Sync removes files deleted from src/. Its cache policy also covers new file\n# types until the copies below apply the policy for their path.\naws s3 sync src/ \"s3://$BUCKET/\" --delete \\\n  --cache-control \"public, max-age=300\" --profile \"$PROFILE\"\n\n# Sync skips unchanged files, including objects uploaded before cache headers\n# were added. Copy every local file so each deploy refreshes its S3 metadata.\n# These are local-to-S3 copies: no metadata replacement or MIME loss.\nwhile IFS= read -r -d '' file; do\n  path=\"${file#src/}\"\n  cache_control=\"public, max-age=300\"\n  case \"$path\" in\n    assets/*) cache_control=\"public, max-age=86400\" ;;\n  esac\n\n  content_type=()\n  case \"$path\" in\n    *.html) content_type=(--content-type \"text/html\") ;;\n    *.js)   content_type=(--content-type \"application/javascript\") ;;\n    *.css)  content_type=(--content-type \"text/css\") ;;\n    *.png)  content_type=(--content-type \"image/png\") ;;\n    *.svg)  content_type=(--content-type \"image/svg+xml\") ;;\n  esac\n\n  aws s3 cp \"$file\" \"s3://$BUCKET/$path\" \\\n    --cache-control \"$cache_control\" \"${content_type[@]}\" \\\n    --profile \"$PROFILE\" --only-show-errors\ndone < <(find src -type f -print0)\n\naws cloudfront create-invalidation --distribution-id \"$DISTRIBUTION_ID\" \\\n  --paths \"/*\" --profile \"$PROFILE\" > /dev/null\n\necho \"deployed\"\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport json, os, pathlib, subprocess, tempfile\nroot = pathlib.Path.cwd()\nwith tempfile.TemporaryDirectory(prefix='.deploy-test-', dir=root) as tmp:\n    tmp = pathlib.Path(tmp)\n    mock = tmp / 'aws'\n    mock.write_text('#\"'!/usr/bin/env python3'\"\\\\nimport json, os, sys\\\\nwith open(os.environ[\\\"AWS_LOG\\\"], \\\"a\\\") as f:\\\\n    f.write(json.dumps(sys.argv[1:]) + \\\"\\\\\\\\n\\\")\\\\n')\n    mock.chmod(0o755)\n    log = tmp / 'calls.jsonl'\n    env = dict(os.environ, PATH=f'{tmp}:{os.environ[\\\"PATH\\\"]}', AWS_LOG=str(log))\n    subprocess.run(['bash', 'scripts/deploy.sh'], env=env, check=True, capture_output=True, text=True)\n    calls = [json.loads(line) for line in log.read_text().splitlines()]\n    assert calls[0][:2] == ['s3', 'sync'] and '--delete' in calls[0]\n    assert calls[-1][:2] == ['cloudfront', 'create-invalidation']\n    copies = calls[1:-1]\n    expected = {'index.html': ('public, max-age=300', 'text/html'), 'clases.html': ('public, max-age=300', 'text/html'), 'booking.js': ('public, max-age=300', 'application/javascript'), 'styles.css': ('public, max-age=300', 'text/css'), 'assets/logo.png': ('public, max-age=86400', 'image/png'), 'assets/mark.svg': ('public, max-age=86400', 'image/svg+xml')}\n    assert len(copies) == len(expected), copies\n    for call in copies:\n        path = call[2].removeprefix('src/')\n        ttl, mime = expected.pop(path)\n        assert call[:2] == ['s3', 'cp']\n        assert call[call.index('--cache-control') + 1] == ttl\n        assert call[call.index('--content-type') + 1] == mime\n        assert '--metadata-directive' not in call\n    assert not expected, expected\n    print('Mock deploy passed: deletion sync, six typed/cache-controlled uploads, then invalidation.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
