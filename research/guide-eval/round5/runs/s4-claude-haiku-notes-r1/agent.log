+  case \"$key\" in","+    assets/*) cache=\"$LONG_CACHE\" ;;","+    *)        cache=\"$SHORT_CACHE\" ;;","+  esac","+  aws s3 cp \"$file\" \"s3://$BUCKET/$key\" \\","+    --content-type \"$(content_type_for \"$file\")\" \\","+    --cache-control \"$cache\" \\","+    --profile \"$PROFILE\" --only-show-errors","+done < <(find src -type f -print0)","+"," aws cloudfront create-invalidation --distribution-id \"$DISTRIBUTION_ID\" \\","   --paths \"/*\" --profile \"$PROFILE\" > /dev/null"," "]}],"originalFile":"#!/usr/bin/env bash\n# Upload src/ to the bucket and invalidate CloudFront.\nset -euo pipefail\ncd \"$(dirname \"$0\")/..\"\n\nBUCKET=\"ruta-ceramica-site-7f3a\"\nDISTRIBUTION_ID=\"E2QX9ZK1DEMO01\"\nPROFILE=\"studio\"\n\naws s3 sync src/ \"s3://$BUCKET/\" --delete --profile \"$PROFILE\"\n\naws cloudfront create-invalidation --distribution-id \"$DISTRIBUTION_ID\" \\\n  --paths \"/*\" --profile \"$PROFILE\" > /dev/null\n\necho \"deployed\"\n","userModified":false},"tool_result_meta":[{"id":"toolu_019yfN4pbq1Ra5yjQx6ff3aG","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
