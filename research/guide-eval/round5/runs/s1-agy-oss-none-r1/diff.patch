 import json
 import sys
 
+# Default Lactate Threshold Heart Rate (LTHR) in BPM used for HR calculations.
+LTHR = 172
 
-def hr_target(step):
-    """HR corridor for a step, as a percentage of the athlete's LTHR."""
+
+def hr_target(step, lthr=None):
+    """HR corridor for a step.
+    If `lthr` is provided, returns absolute BPM values; otherwise returns percentage of LTHR.
+    """
     lo, hi = step["hr_pct"]
-    return {"units": "%lthr", "value": lo, "end": hi}
+    if lthr:
+        # Convert percentages to absolute BPM values
+        return {"units": "bpm", "value": round(lo * lthr / 100), "end": round(hi * lthr / 100)}
+    else:
+        return {"units": "%lthr", "value": lo, "end": hi}
 
 
 def build_step(step):
     out = {"duration": step["minutes"] * 60}
     if "hr_pct" in step:
-        out["hr"] = hr_target(step)
+        out["hr"] = hr_target(step, LTHR)
     if "label" in step:
         out["text"] = step["label"]
     return out
