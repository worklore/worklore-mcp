return [build(schema[\"items\"], root)] if \"items\" in schema else []\n    if t == \"string\":\n        return CORRUPT\n    if t == \"integer\":\n        return -999999999\n    if t == \"number\":\n        return -1.5e308\n    if t == \"boolean\":\n        return False\n    return None\n\n\ndef rpc(method, params, rid, session=None):\n    st, sid, raw = post({\"jsonrpc\": \"2.0\", \"id\": rid, \"method\": method, \"params\": params}, session)\n    return st, sid, raw\n\n\ndef main():\n    out = {}\n    st, sid, raw = post({\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"initialize\",\n                         \"params\": {\"protocolVersion\": \"2025-06-18\", \"capabilities\": {},\n                                    \"clientInfo\": {\"name\": \"checkup\", \"version\": \"1\"}}})\n    out[\"init\"] = (st, raw[:200])\n    post({\"jsonrpc\": \"2.0\", \"method\": \"notifications/initialized\"}, sid)\n    st, _, raw = post({\"jsonrpc\": \"2.0\", \"id\": 2, \"method\": \"tools/list\"}, sid)\n    tools = json.loads(raw)[\"result\"][\"tools\"]\n    out[\"tools_status\"] = st\n    out[\"tool_names\"] = [t[\"name\"] for t in tools]\n    out[\"tool_count\"] = len(tools)\n    ro = {t[\"name\"]: t for t in tools if t.get(\"annotations\", {}).get(\"readOnlyHint\") is True}\n    print(json.dumps({\"tools_status\": st, \"names\": out[\"tool_names\"], \"readonly\": sorted(ro)}, indent=1))\n\n    # C4: valid calls on read-only tools with outputSchema, validate structuredContent\n    valid_args = {\"search_notes\": {\"query\": \"frost\"}, \"get_note\": {\"id\": \"n-2\"}}\n    rid = 100\n    for name, args in valid_args.items():\n        rid += 1\n        st, _, raw = rpc(\"tools/call\", {\"name\": name, \"arguments\": args}, rid, sid)\n        body = json.loads(raw)\n        res = body.get(\"result\", {})\n        verdict = \"PASS\"\n        detail = \"\"\n        if st != 200 or \"error\" in body or res.get(\"isError\"):\n            verdict, detail = \"FAIL\", \"isError or error\"\n        elif \"structuredContent\" not in res:\n            verdict, detail = \"FAIL\", \"no structuredContent\"\n        else:\n            try:\n                jsonschema.validate(res[\"structuredContent\"], ro[name][\"outputSchema\"])\n            except jsonschema.ValidationError as e:\n                verdict, detail = \"FAIL\", e.message\n            text_ok = json.loads(res[\"content\"][0][\"text\"]) == res[\"structuredContent\"] or \\\n                json.loads(res[\"content\"][0][\"text\"]) == res[\"structuredContent\"].get(\"hits\", res[\"structuredContent\"])\n            if not text_ok:\n                verdict, detail = \"FAIL\", \"content text and structuredContent disagree\"\n        print(f\"C4 {name} valid -> HTTP {st} {verdict} {detail}\")\n        print(\"   raw:\", raw[:160])\n\n    # C10: corrupted instance per outputSchema, validated locally (no call made)\n    for t in tools:\n        schema = t.get(\"outputSchema\")\n        if schema is None:\n            print(f\"C10 {t['name']}: no outputSchema (NOT CHECKED)\")\n            continue\n        inst = build(schema, schema)\n        try:\n            jsonschema.validate(inst, schema)\n            print(f\"C10 {t['name']}: ACCEPTED corrupted {json.dumps(inst)} -> FAIL\")\n        except jsonschema.ValidationError as e:\n            print(f\"C10 {t['name']}: rejected corrupted {json.dumps(inst)} -> PASS ({e.validator}: {e.message[:90]})\")\n\n    # C5/C2 bodies re-parse check is in shell; here: C6 fingerprint inputs\n    print(\"C6 initialize result (no serverInfo.version):\")\n    _, _, raw = post({\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"initialize\",\n                      \"params\": {\"protocolVersion\": \"2025-06-18\", \"capabilities\": {},\n                                 \"clientInfo\": {\"name\": \"checkup\", \"version\": \"1\"}}})\n    res = json.loads(raw)[\"result\"]\n    print(json.dumps(res, sort_keys=True))\n    _, _, raw = post({\"jsonrpc\": \"2.0\", \"id\": 3, \"method\"