{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015ytiPXNzikiTqoRayAdMGp","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"notes-mcp: a small remote MCP server (Streamable HTTP, JSON responses).\n3\t\n4\t    python3 server.py            # listens on http://127.0.0.1:49514/mcp\n5\t    PORT=9000 python3 server.py\n6\t\n7\tReads are open. Writes and the resources endpoints need\n8\t`Authorization: Bearer <token>`; the dev token is in TOKEN below.\n9\t\"\"\"\n10\timport json\n11\timport os\n12\timport sys\n13\timport time\n14\timport uuid\n15\tfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\n16\t\n17\tPORT = int(os.environ.get(\"PORT\", \"49514\"))\n18\tTOKEN = os.environ.get(\"NOTES_TOKEN\", \"dev-token-123\")\n19\tPROTOCOL = \"2025-06-18\"\n20\tHERE = os.path.dirname(os.path.abspath(__file__))\n21\t\n22\twith open(os.path.join(HERE, \"notes.json\")) as f:\n23\t    NOTES = {n[\"id\"]: n for n in json.load(f)}\n24\t\n25\tTOOLS = [\n26\t    {\n27\t        \"name\": \"search_notes\",\n28\t        \"description\": \"Full-text search over the notes. Returns id, title and a snippet per hit.\",\n29\t        \"inputSchema\": {\n30\t            \"type\": \"object\",\n31\t            \"properties\": {\"query\": {\"type\": \"string\"}, \"limit\": {\"type\": \"integer\", \"minimum\": 1, \"maximum\": 50}},\n32\t            \"required\": [\"query\"],\n33\t        },\n34\t        \"outputSchema\": {\"type\": \"object\"},\n35\t        \"annotations\": {\"readOnlyHint\": True},\n36\t    },\n37\t    {\n38\t        \"name\": \"get_note\",\n39\t        \"description\": \"One note in full by id (ids look like n-12).\",\n40\t        \"inputSchema\": {\n41\t            \"type\": \"object\",\n42\t            \"properties\": {\"id\": {\"type\": \"string\", \"pattern\": \"^n-[0-9]+$\"}},\n43\t            \"required\": [\"id\"],\n44\t        },\n45\t        \"outputSchema\": {\n46\t            \"type\": \"object\",\n47\t            \"required\": [\"id\", \"title\", \"body\", \"words\"],\n48\t            \"properties\": {\n49\t                \"id\": {\"type\": \"string\", \"pattern\": \"^n-[0-9]+$\"},\n50\t                \"title\": {\"type\": \"string\", \"minLength\": 1},\n51\t                \"body\": {\"type\": \"string\"},\n52\t                \"words\": {\"type\": \"integer\", \"minimum\": 0},\n53\t                \"tags\": {\"type\": \"array\", \"items\": {\"type\": \"string\", \"minLength\": 1}},\n54\t            },\n55\t        },\n56\t        \"annotations\": {\"readOnlyHint\": True},\n57\t    },\n58\t    {\n59\t        \"name\": \"add_note\",\n60\t        \"description\": \"Create a note. Needs a signed-in session.\",\n61\t        \"inputSchema\": {\n62\t            \"type\": \"object\",\n63\t            \"properties\": {\"title\": {\"type\": \"string\", \"minLength\": 1}, \"body\": {\"type\": \"string\"}},\n64\t            \"required\": [\"title\", \"body\"],\n65\t        },\n66\t        \"outputSchema\": {\n67\t            \"type\": \"object\",\n68\t            \"required\": [\"id\"],\n69\t            \"properties\": {\"id\": {\"type\": \"string\", \"pattern\": \"^n-[0-9]+$\"}},\n70\t        },\n71\t        \"annotations\": {\"readOnlyHint\": False, \"destructiveHint\": False},\n72\t    },\n73\t]\n74\t\n75\tRESOURCES = [\n76\t    {\"uri\": \"notes://guide\", \"name\": \"guide\", \"mimeType\": \"text/markdown\", \"description\": \"How to use this server\"},\n77\t]\n78\t\n79\t\n80\tdef log(method, tool=None, ok=True, ms=0, who=\"anon\"):\n81\t    rec = {\"t\": time.strftime(\"%Y-%m-%dT%H:%M:%S\"), \"method\": method, \"tool\": tool, \"ok\": ok, \"ms\": round(ms, 1), \"who\": who}\n82\t    sys.stderr.write(json.dumps(rec) + \"\\n\")\n83\t    sys.stderr.flush()\n84\t\n85\t\n86\tdef rpc_result(id_, result):\n87\t    return 200, {\"jsonrpc\": \"2.0\", \"id\": id_, \"result\": result}\n88\t\n89\t\n90\tdef rpc_error(id_, code, message):\n91\t    return 200, {\"jsonrpc\": \"2.0\", \"id\": id_, \"error\": {\"code\": code, \"message\": message}}\n92\t\n93\t\n94\tdef tool_result(text, structured=None, is_error=False):\n95\t    r = {\"content\": [{\"type\": \"text\", \"text\": text}], \"isError\": is_error}\n96\t    if structured is not None:\n97\t        r[\"structuredContent\"] = structured\n98\t    return r\n99\t\n100\t\n101\tdef call_tool(name, args, who):\n102\t    if name == \"search_notes\":\n103\t        q = str(args.get(\"query\", \"\")).lower()\n104\t        limit = int(args.get(\"limit\", 10))\n105\t        hits = []\n106\t        for n in NOTES.values():\n107\t            text = (n[\"title\"] + \" \" + n[\"body\"]).lower()\n108\t            if q in text:\n109\t                i = text.find(q)\n110\t                hits.append({\"id\": n[\"id\"], \"title\": n[\"title\"], \"snippet\": n[\"body\"][max(0, i - 30): i + 50]})\n111\t        hits = hits[:limit]\n112\t        return tool_result(json.dumps(hits), {\"hits\": hits, \"total\": len(hits)})\n113\t    if name == \"get_note\":\n114\t        nid = args.get(\"id\")\n115\t        if nid is None:\n116\t            raise ValueError(\"missing required argument: id\")\n117\t        n = NOTES.get(nid)\n118\t        if n is None:\n119\t            raise ValueError(f\"note not found: {nid}\")\n120\t        out = {\"id\": n[\"id\"], \"title\": n[\"title\"], \"body\": n[\"body\"], \"words\": len(n[\"body\"].split()), \"tags\": n.get(\"tags\", [])}\n121\t        return tool_result(json.dumps(out), out)\n122\t    if name == \"add_note\":\n123\t        if who == \"anon\":\n124\t            return None  # caller turns this into a 401\n125\t        nid = f\"n-{max(int(k[2:]) for k in NOTES) + 1}\"\n126\t        NOTES[nid] = {\"id\": nid, \"title\": args[\"title\"], \"body\": args[\"body\"], \"tags\": []}\n127\t        return tool_result(json.dumps({\"id\": nid}), {\"id\": nid})\n128\t    return None\n129\t\n130\t\n131\tdef handle(req, who):\n132\t    method = req.get(\"method\")\n133\t    id_ = req.get(\"id\")\n134\t    params = req.get(\"params\") or {}\n135\t    if method == \"initialize\":\n136\t        return rpc_result(id_, {\n137\t            \"protocolVersion\": PROTOCOL,\n138\t            \"capabilities\": {\"tools\": {\"listChanged\": False}, \"resources\": {\"subscribe\": False, \"listChanged\": False}},\n139\t            \"serverInfo\": {\"name\": \"notes-mcp\", \"version\": \"0.3.1\"},\n140\t            \"instructions\": \"Search and read notes. add_note needs a signed-in session.\",\n141\t        })\n142\t    if method == \"notifications/initialized\":\n143\t        return 202, None\n144\t    if method == \"ping\":\n145\t        return rpc_result(id_, {})\n146\t    if method == \"tools/list\":\n147\t        return rpc_result(id_, {\"tools\": TOOLS})\n148\t    if method in (\"resources/list\", \"resources/read\", \"resources/templates/list\"):\n149\t        if who == \"anon\":\n150\t            return 401, {\"error\": \"unauthorized\"}\n151\t        if method == \"resources/list\":\n152\t            return rpc_result(id_, {\"resources\": RESOURCES})\n153\t        if method == \"resources/templates/list\":\n154\t            return rpc_result(id_, {\"resourceTemplates\": []})\n155\t        return rpc_result(id_, {\"contents\": [{\"uri\": \"notes://guide\", \"mimeType\": \"text/markdown\", \"text\": \"# notes-mcp\\nsearch_notes, get_note, add_note.\"}]})\n156\t    if method == \"tools/call\":\n157\t        name = params.get(\"name\")\n158\t        args = params.get(\"arguments\") or {}\n159\t        if not any(t[\"name\"] == name for t in TOOLS):\n160\t            return rpc_error(id_, -32601, f\"unknown tool: {name}\")\n161\t        try:\n162\t            res = call_tool(name, args, who)\n163\t        except ValueError as e:\n164\t            return rpc_error(id_, -32602, str(e))\n165\t        if res is None:\n166\t            return 401, {\"error\": \"sign in required\"}\n167\t        return rpc_result(id_, res)\n168\t    return rpc_error(id_, -32601, f\"method not found: {method}\")\n169\t\n170\t\n171\tclass Handler(BaseHTTPRequestHandler):\n172\t    server_version = \"notes-mcp/0.3.1\"\n173\t\n174\t    def _send(self, status, body, session=None):\n175\t        data = b\"\" if body is None else json.dumps(body).encode()\n176\t        self.send_response(status)\n177\t        if data:\n178\t            self.send_header(\"Content-Type\", \"application/json\")\n179\t        self.send_header(\"Content-Length\", str(len(data)))\n180\t        if session:\n181\t            self.send_header(\"Mcp-Session-Id\", session)\n182\t        self.end_headers()\n183\t        if data:\n184\t            self.wfile.write(data)\n185\t\n186\t    def do_GET(self):\n187\t        self._send(405, {\"error\": \"use POST\"})\n188\t\n189\t    def do_DELETE(self):\n190\t        self._send(204, None)\n191\t\n192\t    def do_POST(self):\n193\t        if self.path.rstrip(\"/\") != \"/mcp\":\n194\t            return self._send(404, {\"error\": \"not found\"})\n195\t        n = int(self.headers.get(\"Content-Length\") or 0)\n196\t        raw = self.rfile.read(n)\n197\t        try:\n198\t            req = json.loads(raw or b\"{}\")\n199\t        except json.JSONDecodeError:\n200\t            return self._send(400, {\"jsonrpc\": \"2.0\", \"id\": None, \"error\": {\"code\": -32700, \"message\": \"parse error\"}})\n201\t        auth = self.headers.get(\"Authorization\", \"\")\n202\t        who = \"dev\" if auth == f\"Bearer {TOKEN}\" else \"anon\"\n203\t        session = self.headers.get(\"Mcp-Session-Id\")\n204\t        t0 = time.time()\n205\t        if isinstance(req, list):\n206\t            out = []\n207\t            for r in req:\n208\t                _, b = handle(r, who)\n209\t                if b is not None:\n210\t                    out.append(b)\n211\t            return self._send(200, out, session)\n212\t        status, body = handle(req, who)\n213\t        if req.get(\"method\") == \"initialize\" and not session:\n214\t            session = uuid.uuid4().hex\n215\t        ok = status < 400 and not (isinstance(body, dict) and \"error\" in body)\n216\t        log(req.get(\"method\"), (req.get(\"params\") or {}).get(\"name\"), ok, (time.time() - t0) * 1000, who)\n217\t        self._send(status, body, session)\n218\t\n219\t    def log_message(self, *a):\n220\t        pass\n221\t\n222\t\n223\tif __name__ == \"__main__\":\n224\t    srv = ThreadingHTTPServer((\"127.0.0.1\", PORT), Handler)\n225\t    sys.stderr.write(f\"notes-mcp listening on http://127.0.0.1:{PORT}/mcp\\n\")\n226\t    sys.stderr.flush()\n227\t    try:\n228\t        srv.serve_forever()\n229\t    except KeyboardInterrupt:\n230\t        pass\n231\t"}]},"parent_tool_use_id":null,"session_id":"4ee5663e-c735-49bb-83d7-86e0bd889062","uuid":"bd7294a8-c9fb-4938-8e6e-7709e4023b73","timestamp":"2026-10-19T02:35:36.162Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/h-1rI969/server.py","content":"#!/usr/bin/env python3\n\"\"\"notes-mcp: a small remote MCP server (Streamable HTTP, JSON responses).\n\n    python3 server.py            # listens on http://127.0.0.1:49514/mcp\n    PORT=9000 python3 server.py\n\nReads are open. Writes and the resources endpoints need\n`Authorization: Bearer <token>`; the dev token is in TOKEN below.\n\"\"\"\nimport json\nimport os\nimport sys\nimport time\nimport uuid\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\n\nPORT = int(os.environ.get(\"PORT\", \"49514\"))\nTOKEN = os.environ.get(\"NOTES_TOKEN\", \"dev-token-123\")\nPROTOCOL = \"2025-06-18\"\nHERE = os.path.dirname(os.path.abspath(__file__))\n\nwith open(os.path.join(HERE, \"notes.json\")) as f:\n    NOTES = {n[\"id\"]: n for n in json.load(f)}\n\nTOOLS = [\n    {\n        \"name\": \"search_notes\",\n        \"description\": \"Full-text search over the notes. Returns id, title and a snippet per hit.\",\n        \"inputSchema\": {\n            \"type\": \"object\",\n            \"properties\": {\"query\": {\"type\": \"string\"}, \"limit\": {\"type\": \"integer\", \"minimum\": 1, \"maximum\": 50}},\n            \"required\": [\"query\"],\n        },\n        \"outputSchema\": {\"type\": \"object\"},\n        \"annotations\": {\"readOnlyHint\": True},\n    },\n    {\n        \"name\": \"get_note\",\n        \"description\": \"One note in full by id (ids look like n-12).\",\n        \"inputSchema\": {\n            \"type\": \"object\",\n            \"properties\": {\"id\": {\"type\": \"string\", \"pattern\": \"^n-[0-9]+$\"}},\n            \"required\": [\"id\"],\n        },\n        \"outputSchema\": {\n            \"type\": \"object\",\n            \"required\": [\"id\", \"title\", \"body\", \"words\"],\n            \"properties\": {\n                \"id\": {\"type\": \"string\", \"pattern\": \"^n-[0-9]+$\"},\n                \"title\": {\"type\": \"string\", \"minLength\": 1},\n                \"body\": {\"type\": \"string\"},\n                \"words\": {\"type\": \"integer\", \"minimum\": 0},\n                \"tags\": {\"type\": \"array\", \"items\": {\"type\": \"string\", \"minLength\": 1}},\n            },\n        },\n        \"annotations\": {\"readOnlyHint\": True},\n    },\n    {\n        \"name\": \"add_note\",\n        \"description\": \"Create a note. Needs a signed-in session.\",\n        \"inputSchema\": {\n            \"type\": \"object\",\n            \"properties\": {\"title\": {\"type\": \"string\", \"minLength\": 1}, \"body\": {\"type\": \"string\"}},\n            \"required\": [\"title\", \"body\"],\n        },\n        \"outputSchema\": {\n            \"type\": \"object\",\n            \"required\": [\"id\"],\n            \"properties\": {\"id\": {\"type\": \"string\", \"pattern\": \"^n-[0-9]+$\"}},\n        },\n        \"annotations\": {\"readOnlyHint\": False, \"destructiveHint\": False},\n    },\n]\n\nRESOURCES = [\n    {\"uri\": \"notes://guide\", \"name\": \"guide\", \"mimeType\": \"text/markdown\", \"description\": \"How to use this server\"},\n]\n\n\ndef log(method, tool=None, ok=True, ms=0, who=\"anon\"):\n    rec = {\"t\": time.strftime(\"%Y-%m-%dT%H:%M:%S\"), \"method\": method, \"tool\": tool, \"ok\": ok, \"ms\": round(ms, 1), \"who\": who}\n    sys.stderr.write(json.dumps(rec) + \"\\n\")\n    sys.stderr.flush()\n\n\ndef rpc_result(id_, result):\n    return 200, {\"jsonrpc\": \"2.0\", \"id\": id_, \"result\": result}\n\n\ndef rpc_error(id_, code, message):\n    return 200, {\"jsonrpc\": \"2.0\", \"id\": id_, \"error\": {\"code\": code, \"message\": message}}\n\n\ndef tool_result(text, structured=None, is_error=False):\n    r = {\"content\": [{\"type\": \"text\", \"text\": text}], \"isError\": is_error}\n    if structured is not None:\n        r[\"structuredContent\"] = structured\n    return r\n\n\ndef call_tool(name, args, who):\n    if name == \"search_notes\":\n        q = str(args.get(\"query\", \"\")).lower()\n        limit = int(args.get(\"limit\", 10))\n        hits = []\n        for n in NOTES.values():\n            text = (n[\"title\"] + \" \" + n[\"body\"]).lower()\n            if q in text:\n                i = text.find(q)\n                hits.append({\"id\": n[\"id\"], \"title\": n[\"title\"], \"snippet\": n[\"body\"][max(0, i - 30): i + 50]})\n        hits = hits[:limit]\n        return tool_result(json.dumps(hits), {\"hits\": hits, \"total\": len(hits)})\n    if name == \"get_note\":\n        nid = args.get(\"id\")\n        if nid is None:\n            raise ValueError(\"missing required argument: id\")\n        n = NOTES.get(nid)\n        if n is None:\n            raise ValueError(f\"note not found: {nid}\")\n        out = {\"id\": n[\"id\"], \"title\": n[\"title\"], \"body\": n[\"body\"], \"words\": len(n[\"body\"].split()), \"tags\": n.get(\"tags\", [])}\n        return tool_result(json.dumps(out), out)\n    if name == \"add_note\":\n        if who == \"anon\":\n            return None  # caller turns this into a 401\n        nid = f\"n-{max(int(k[2:]) for k in NOTES) + 1}\"\n        NOTES[nid] = {\"id\": nid, \"title\": args[\"title\"], \"body\": args[\"body\"], \"tags\": []}\n        return tool_result(json.dumps({\"id\": nid}), {\"id\": nid})\n    return None\n\n\ndef handle(req, who):\n    method = req.get(\"method\")\n    id_ = req.get(\"id\")\n    params = req.get(\"params\") or {}\n    if method == \"initialize\":\n        return rpc_result(id_, {\n            \"protocolVersion\": PROTOCOL,\n            \"capabilities\": {\"tools\": {\"listChanged\": False}, \"resources\": {\"subscribe\": False, \"listChanged\": False}},\n            \"serverInfo\": {\"name\": \"notes-mcp\", \"version\": \"0.3.1\"},\n            \"instructions\": \"Search and read notes. add_note needs a signed-in session.\",\n        })\n    if method == \"notifications/initialized\":\n        return 202, None\n    if method == \"ping\":\n        return rpc_result(id_, {})\n    if method == \"tools/list\":\n        return rpc_result(id_, {\"tools\": TOOLS})\n    if method in (\"resources/list\", \"resources/read\", \"resources/templates/list\"):\n        if who == \"anon\":\n            return 401, {\"error\": \"unauthorized\"}\n        if method == \"resources/list\":\n            return rpc_result(id_, {\"resources\": RESOURCES})\n        if method == \"resources/templates/list\":\n            return rpc_result(id_, {\"resourceTemplates\": []})\n        return rpc_result(id_, {\"contents\": [{\"uri\": \"notes://guide\", \"mimeType\": \"text/markdown\", \"text\": \"# notes-mcp\\nsearch_notes, get_note, add_note.\"}]})\n    if method == \"tools/call\":\n        name = params.get(\"name\")\n        args = params.get(\"arguments\") or {}\n        if not any(t[\"name\"] == name for t in TOOLS):\n            return rpc_error(id_, -32601, f\"unknown tool: {name}\")\n        try:\n            res = call_tool(name, args, who)\n        except ValueError as e:\n            return rpc_error(id_, -32602, str(e))\n        if res is None:\n            return 401, {\"error\": \"sign in required\"}\n        return rpc_result(id_, res)\n    return rpc_error(id_, -32601, f\"method not found: {method}\")\n\n\nclass Handler(BaseHTTPRequestHandler):\n    server_version = \"notes-mcp/0.3.1\"\n\n    def _send(self, status, body, session=None):\n        data = b\"\" if body is None else json.dumps(body).encode()\n        self.send_response(status)\n        if data:\n            self.send_header(\"Content-Type\", \"application/json\")\n        self.send_header(\"Content-Length\", str(len(data)))\n        if session:\n            self.send_header(\"Mcp-Session-Id\", session)\n        self.end_headers()\n        if data:\n            self.wfile.write(data)\n\n    def do_GET(self):\n        self._send(405, {\"error\": \"use POST\"})\n\n    def do_DELETE(self):\n        self._send(204, None)\n\n    def do_POST(self):\n        if self.path.rstrip(\"/\") != \"/mcp\":\n            return self._send(404, {\"error\": \"not found\"})\n        n = int(self.headers.get(\"Content-Length\") or 0)\n        raw = self.rfile.read(n)\n        try:\n            req = json.loads(raw or b\"{}\")\n        except json.JSONDecodeError:\n            return self._send(400, {\"jsonrpc\": \"2.0\", \"id\": None, \"error\": {\"code\": -32700, \"message\": \"parse error\"}})\n        auth = self.headers.get(\"Authorization\", \"\")\n        who = \"dev\" if auth == f\"Bearer {TOKEN}\" else \"anon\"\n        session = self.headers.get(\"Mcp-Session-Id\")\n        t0 = time.time()\n        if isinstance(req, list):\n            out = []\n            for r in req:\n                _, b = handle(r, who)\n                if b is not None:\n                    out.append(b)\n            return self._send(200, out, session)\n        status, body = handle(req, who)\n        if req.get(\"method\") == \"initialize\" and not session:\n            session = uuid.uuid4().hex\n        ok = status < 400 and not (isinstance(body, dict) and \"error\" in body)\n        log(req.get(\"method\"), (req.get(\"params\") or {}).get(\"name\"), ok, (time.time() - t0) * 1000, who)\n        self._send(status, body, session)\n\n    def log_message(self, *a):\n        pass\n\n\nif __name__ == \"__main__\":\n    srv = ThreadingHTTPServer((\"127.0.0.1\", PORT), Handler)\n    sys.stderr.write(f\"notes-mcp listening on http://127.0.0.1:{PORT}/mcp\\n\")\n    sys.stderr.flush()\n    try:\n        srv.serve_forever()\n    except KeyboardInterrupt:\n        pass\n","numLines":231,"startLine":1,"totalLines":231}},"tool_result_meta":[{"id":"toolu_015ytiPXNzikiTqoRayAdMGp","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
