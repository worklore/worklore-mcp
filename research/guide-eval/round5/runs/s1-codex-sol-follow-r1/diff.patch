+def description_step(step):
+    """Render a step in Intervals' workout text grammar."""
+    label = " ".join(step.get("label", "Step").split()) or "Step"
+    if label[0].isdigit():
+        label = "Step " + label
+    label = re.sub(r"\bZ(\d+)\b", r"Zone \1", label)
+    line = f"- {label} {step['minutes']}m"
+    if "hr_pct" in step:
+        lo, hi = step["hr_pct"]
+        line += f" {lo}-{hi}% LTHR"
+    return line
+
+
+def build_description(plan):
+    blocks = []
+    for block in plan["steps"]:
+        if "repeat" in block:
+            lines = [f"{block['repeat']}x"]
+            lines.extend(description_step(s) for s in block["steps"])
+            blocks.append("\n".join(lines))
+        else:
+            blocks.append(description_step(block))
+    return "\n\n".join(blocks)
 
 
