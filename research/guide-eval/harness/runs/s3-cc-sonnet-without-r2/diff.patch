+    def test_publish_date_uses_author_tz_west(self):
+        # Author in Hawaii (UTC-10, no DST) posts at 23:30 local (09:30 UTC next day).
+        # Stored date must be the author's local date, not the UTC date.
+        p = journal.publish({"author": "sam", "title": "t", "body": "b"}, "Pacific/Honolulu",
+                            now=at("2026-03-11T09:30:00"))  # 23:30 March 10 in Honolulu
+        self.assertEqual(p["date"], "2026-03-10")
+
+    def test_publish_date_uses_author_tz_east(self):
+        # Author in Tokyo (UTC+9, no DST) posts at 00:30 local (15:30 UTC previous day).
+        p = journal.publish({"author": "yuki", "title": "t", "body": "b"}, "Asia/Tokyo",
+                            now=at("2026-03-10T15:30:00"))  # 00:30 March 11 in Tokyo
+        self.assertEqual(p["date"], "2026-03-11")
+
+    def test_display_date_ignores_viewer_tz(self):
+        # The displayed date is always the author's date, regardless of viewer timezone.
+        p = journal.publish({"author": "sam", "title": "t", "body": "b"}, "Pacific/Honolulu",
+                            now=at("2026-03-11T09:30:00"))  # 23:30 March 10 in Honolulu
+        self.assertEqual(journal.display_date(p, "UTC"), "2026-03-10")
+        self.assertEqual(journal.display_date(p, "Asia/Tokyo"), "2026-03-10")
+
