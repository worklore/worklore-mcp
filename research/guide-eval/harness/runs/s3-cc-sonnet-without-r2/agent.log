26-03-10T12:00:00\"))\n        self.assertEqual(journal.display_date(p, \"UTC\"), \"2026-03-10\")\n\n    def test_display_date_berlin_midday(self):\n        p = journal.publish({\"author\": \"lena\", \"title\": \"t\", \"body\": \"b\"}, \"Europe/Berlin\",\n                            now=at(\"2026-03-10T09:00:00\"))\n        self.assertEqual(journal.display_date(p, \"Europe/Berlin\"), \"2026-03-10\")\n\n    def test_publish_date_uses_author_tz_west(self):\n        # Author in UTC-5 posts at 23:30 local (04:30 UTC next day).\n        # The stored date must be the author's local date, not the UTC date.\n        p = journal.publish({\"author\": \"sam\", \"title\": \"t\", \"body\": \"b\"}, \"America/New_York\",\n                            now=at(\"2026-03-11T04:30:00\"))  # 23:30 March 10 in NYC\n        self.assertEqual(p[\"date\"], \"2026-03-10\")\n\n    def test_publish_date_uses_author_tz_east(self):\n        # Author in UTC+9 posts at 00:30 local (15:30 UTC previous day).\n        p = journal.publish({\"author\": \"yuki\", \"title\": \"t\", \"body\": \"b\"}, \"Asia/Tokyo\",\n                            now=at(\"2026-03-10T15:30:00\"))  # 00:30 March 11 in Tokyo\n        self.assertEqual(p[\"date\"], \"2026-03-11\")\n\n    def test_display_date_ignores_viewer_tz(self):\n        # The displayed date is always the author's date, regardless of viewer timezone.\n        p = journal.publish({\"author\": \"sam\", \"title\": \"t\", \"body\": \"b\"}, \"America/New_York\",\n                            now=at(\"2026-03-11T04:30:00\"))  # 23:30 March 10 in NYC\n        self.assertEqual(journal.display_date(p, \"UTC\"), \"2026-03-10\")\n        self.assertEqual(journal.display_date(p, \"Asia/Tokyo\"), \"2026-03-10\")\n\n    def test_feed_newest_first(self):\n        journal.publish({\"author\": \"kim\", \"title\": \"old\", \"body\": \"\"}, \"UTC\",\n                        now=at(\"2026-03-09T12:00:00\"))\n        journal.publish({\"author\": \"kim\", \"title\": \"new\", \"body\": \"\"}, \"UTC\",\n                        now=at(\"2026-03-10T12:00:00\"))\n        self.assertEqual([p[\"title\"] for p in journal.feed()], [\"new\", \"old\"])\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n","structuredPatch":[{"oldStart":29,"oldLines":22,"newStart":29,"newLines":22,"lines":["         self.assertEqual(journal.display_date(p, \"Europe/Berlin\"), \"2026-03-10\")"," ","     def test_publish_date_uses_author_tz_west(self):","-        # Author in UTC-5 posts at 23:30 local (04:30 UTC next day).","-        # The stored date must be the author's local date, not the UTC date.","-        p = journal.publish({\"author\": \"sam\", \"title\": \"t\", \"body\": \"b\"}, \"America/New_York\",","-                            now=at(\"2026-03-11T04:30:00\"))  # 23:30 March 10 in NYC","+        # Author in Hawaii (UTC-10, no DST) posts at 23:30 local (09:30 UTC next day).","+        # Stored date must be the author's local date, not the UTC date.","+        p = journal.publish({\"author\": \"sam\", \"title\": \"t\", \"body\": \"b\"}, \"Pacific/Honolulu\",","+                            now=at(\"2026-03-11T09:30:00\"))  # 23:30 March 10 in Honolulu","         self.assertEqual(p[\"date\"], \"2026-03-10\")"," ","     def test_publish_date_uses_author_tz_east(self):","-        # Author in UTC+9 posts at 00:30 local (15:30 UTC previous day).","+        # Author in Tokyo (UTC+9, no DST) posts at 00:30 local (15:30 UTC previous day).","         p = journal.publish({\"author\": \"yuki\", \"title\": \"t\", \"body\": \"b\"}, \"Asia/Tokyo\",","                             now=at(\"2026-03-10T15:30:00\"))  # 00:30 March 11 in Tokyo","         self.assertEqual(p[\"date\"], \"2026-03-11\")"," ","     def test_display_date_ignores_viewer_tz(self):","         # The displayed date is always the author's date, regardless of viewer timezone.","-        p = journal.publish({\"author\": \"sam\", \"title\": \"t\", \"body\": \"b\"}, \"America/New_York\",","-                    