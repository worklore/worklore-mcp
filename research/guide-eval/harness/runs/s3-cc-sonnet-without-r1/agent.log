ual(p[\"date\"], \"2026-03-10\")\n\n    def test_display_date_utc_viewer(self):\n        p = journal.publish({\"author\": \"kim\", \"title\": \"t\", \"body\": \"b\"}, \"UTC\",\n                            now=at(\"2026-03-10T12:00:00\"))\n        self.assertEqual(journal.display_date(p, \"UTC\"), \"2026-03-10\")\n\n    def test_display_date_berlin_midday(self):\n        p = journal.publish({\"author\": \"lena\", \"title\": \"t\", \"body\": \"b\"}, \"Europe/Berlin\",\n                            now=at(\"2026-03-10T09:00:00\"))\n        self.assertEqual(journal.display_date(p, \"Europe/Berlin\"), \"2026-03-10\")\n\n    def test_feed_newest_first(self):\n        journal.publish({\"author\": \"kim\", \"title\": \"old\", \"body\": \"\"}, \"UTC\",\n                        now=at(\"2026-03-09T12:00:00\"))\n        journal.publish({\"author\": \"kim\", \"title\": \"new\", \"body\": \"\"}, \"UTC\",\n                        now=at(\"2026-03-10T12:00:00\"))\n        self.assertEqual([p[\"title\"] for p in journal.feed()], [\"new\", \"old\"])\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n","structuredPatch":[{"oldStart":28,"oldLines":6,"newStart":28,"newLines":19,"lines":["                             now=at(\"2026-03-10T09:00:00\"))","         self.assertEqual(journal.display_date(p, \"Europe/Berlin\"), \"2026-03-10\")"," ","+    def test_publish_date_uses_author_tz(self):","+        # 1am Tokyo time on March 11th = 4pm UTC March 10th","+        p = journal.publish({\"author\": \"hiro\", \"title\": \"t\", \"body\": \"b\"}, \"Asia/Tokyo\",","+                            now=at(\"2026-03-10T16:00:00\"))","+        self.assertEqual(p[\"date\"], \"2026-03-11\")","+","+    def test_display_date_same_for_all_viewers(self):","+        # Author in Sydney, viewers in UTC and New York all see the author's date","+        p = journal.publish({\"author\": \"ada\", \"title\": \"t\", \"body\": \"b\"}, \"Australia/Sydney\",","+                            now=at(\"2026-03-10T13:00: