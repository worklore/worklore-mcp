day.\n    \"\"\"\n    noon = datetime.fromisoformat(post[\"date\"] + \"T12:00:00+00:00\")\n    return noon.astimezone(ZoneInfo(viewer_tz)).date().isoformat()\n\n\ndef feed():\n    \"\"\"Home feed, newest first.\"\"\"\n    return sorted(_POSTS, key=lambda p: (p[\"date\"], p[\"author\"]), reverse=True)\n","structuredPatch":[{"oldStart":24,"oldLines":8,"newStart":24,"newLines":7,"lines":["     post = dict(entry)","     post[\"client_tz\"] = client_tz","     post[\"created_at\"] = now.astimezone(timezone.utc).isoformat()","-    # Dates are always generated on the server, in UTC, so they are consistent.","-    post[\"date\"] = now.astimezone(timezone.utc).date().isoformat()","+    post[\"date\"] = now.astimezone(ZoneInfo(client_tz)).date().isoformat()","     _POSTS.append(post)","     return post"," "]}],"userModified":false,"replaceAll":false}}
