@@ -18,27 +18,47 @@ def publish(entry, client_tz, now=None):
 
     entry: {"author": str, "title": str, "body": str}
     client_tz: IANA zone reported by the author's browser, e.g. "Europe/Berlin".
+              May be None/empty for legacy callers; falls back to UTC.
     now: server clock override (aware datetime), used by tests.
+
+    The calendar date ("date") is the author's local date — captured in the
+    author's timezone and treated as an opaque string from this point on; it
+    is never re-converted on display.
+
+    "received_at" is a UTC ISO-8601 instant used only for feed ordering.
     """
     now = now or _utcnow()
+    utc_now = now.astimezone(timezone.utc)
     post = dict(entry)
     post["client_tz"] = client_tz
-    post["created_at"] = now.astimezone(timezone.utc).isoformat()
-    # Dates are always generated on the server, in UTC, so they are consistent.
-    post["date"] = now.astimezone(timezone.utc).date().isoformat()
+    # Ordering metadata — UTC instant, never displayed.
+    post["received_at"] = utc_now.isoformat()
+    # Content date — author's local calendar date, never converted after this.
+    tz = ZoneInfo(client_tz) if client_tz else timezone.utc
+    post["date"] = utc_now.astimezone(tz).date().isoformat()
     _POSTS.append(post)
     return post
 
 
 def display_date(post, viewer_tz):
-    """Date shown on a post card, converted to the viewer's zone.
+    """Date shown on a post card.
 
-    Anchored at noon UTC so the conversion can never flip the calendar day.
+    The date is the author's local calendar date and is returned exactly as
+    stored — no timezone conversion is applied.  viewer_tz is accepted for
+    API compatibility but intentionally ignored.
     """
-    noon = datetime.fromisoformat(post["date"] + "T12:00:00+00:00")
-    return noon.astimezone(ZoneInfo(viewer_tz)).date().isoformat()
+    return post["date"]
 
 
 def feed():
-    """Home feed, newest first."""
-    return sorted(_POSTS, key=lambda p: (p["date"], p["author"]), reverse=True)
+    """Home feed, newest first.
+
+    Ordered by received_at (UTC submission instant) so the feed reflects true
+    submission order regardless of each author's local date.  Falls back to
+    the stored date string for posts that pre-date the received_at field.
+    """
+    return sorted(
+        _POSTS,
+        key=lambda p: (p.get("received_at") or p["date"]),
+        reverse=True,
+    )
