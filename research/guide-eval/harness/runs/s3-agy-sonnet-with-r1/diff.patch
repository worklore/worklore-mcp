+def display_date(post, viewer_tz=None):
+    """Date shown on a post card.
 
-    Anchored at noon UTC so the conversion can never flip the calendar day.
+    The date is the author's local calendar date and is treated as an opaque
+    string — it is never converted to the viewer's timezone.  viewer_tz is
+    accepted for backwards compatibility but is intentionally ignored.
     """
-    noon = datetime.fromisoformat(post["date"] + "T12:00:00+00:00")
-    return noon.astimezone(ZoneInfo(viewer_tz)).date().isoformat()
+    return post["date"]
 
 
 def feed():
-    """Home feed, newest first."""
-    return sorted(_POSTS, key=lambda p: (p["date"], p["author"]), reverse=True)
+    """Home feed, newest first (by UTC received_at, with date as fallback)."""
+    return sorted(
+        _POSTS,
+        key=lambda p: (p["received_at"], p["date"]),
