+def publish(entry, client_tz=None, now=None):
     """Store a new post.
 
     entry: {"author": str, "title": str, "body": str}
     client_tz: IANA zone reported by the author's browser, e.g. "Europe/Berlin".
+               When provided the author's local calendar date is derived from it
+               and stored verbatim — no conversion ever happens on display.
+               When absent, the author's local date is derived from UTC (legacy
+               callers remain working).
     now: server clock override (aware datetime), used by tests.
     """
     now = now or _utcnow()
+    utc_now = now.astimezone(timezone.utc)
+
     post = dict(entry)
     post["client_tz"] = client_tz
-    post["created_at"] = now.astimezone(timezone.utc).isoformat()
-    # Dates are always generated on the server, in UTC, so they are consistent.
-    post["date"] = now.astimezone(timezone.utc).date().isoformat()
+
+    # received_at is a UTC instant used only for feed ordering.
+    post["received_at"] = utc_now.isoformat()
+
+    # date is the author's local calendar date — captured once, never converted.
+    if client_tz:
+        author_local = utc_now.astimezone(ZoneInfo(client_tz))
+    else:
+        # Legacy callers that don't send a timezone: fall back to UTC date so
+        # existing behaviour is preserved (UTC is still an author-local date for
+        # a caller that never specified otherwise).
+        author_local = utc_now
+    post["date"] = author_local.date().isoformat()
+
     _POSTS.append(post)
     return post
 
 
